#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьБезопасно(Запрос, ИмяОбработчика)
	Попытка
		Если ИмяОбработчика = "MeGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.СведенияОТекущемПользователе());
		ИначеЕсли ИмяОбработчика = "DialogsGet" Тогда
			Возврат ОтветJSON(200, Новый Структура("dialogs", ИИА_АгентHTTP.СписокДиалогов(ПараметрЗапроса(Запрос, "limit"))));
		ИначеЕсли ИмяОбработчика = "DialogsPost" Тогда
			Тело = ИИА_АгентHTTP.ПрочитатьТелоJSON(Запрос.ПолучитьТелоКакСтроку());
			Возврат ОтветJSON(201, ИИА_АгентHTTP.СоздатьДиалог(ЗначениеПоля(Тело, "type", "")));
		ИначеЕсли ИмяОбработчика = "DialogGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьСостояниеДиалога(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit")));
		ИначеЕсли ИмяОбработчика = "DialogLogGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьЛогДиалога(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit"), ПараметрЗапроса(Запрос, "offset")));
		ИначеЕсли ИмяОбработчика = "DialogSendPost" Тогда
			Тело = ИИА_АгентHTTP.ПрочитатьТелоJSON(Запрос.ПолучитьТелоКакСтроку());
			Возврат ОтветJSON(202, ИИА_АгентHTTP.ОтправитьИЗапустить(ИдентификаторДиалога(Запрос), ЗначениеПоля(Тело, "text", ""), ЗначениеПоля(Тело, "type", "")));
		ИначеЕсли ИмяОбработчика = "DialogConfirmPost" Тогда
			Тело = ИИА_АгентHTTP.ПрочитатьТелоJSON(Запрос.ПолучитьТелоКакСтроку());
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПодтвердитьДействие(ИдентификаторДиалога(Запрос), ЗначениеПоля(Тело, "action", "")));
		ИначеЕсли ИмяОбработчика = "DialogStopPost" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ОстановитьДиалог(ИдентификаторДиалога(Запрос)));
		ИначеЕсли ИмяОбработчика = "DialogAttachmentsGet" Тогда
			Возврат ОтветJSON(200, Новый Структура("attachments", ИИА_АгентHTTP.СписокВложенийДиалога(ИдентификаторДиалога(Запрос))));
		ИначеЕсли ИмяОбработчика = "DialogAttachmentsPost" Тогда
			Тело = ИИА_АгентHTTP.ПрочитатьТелоJSON(Запрос.ПолучитьТелоКакСтроку());
			Возврат ОтветJSON(201, ИИА_АгентHTTP.ДобавитьВложениеДиалога(ИдентификаторДиалога(Запрос), ЗначениеПоля(Тело, "file_name", ""), ЗначениеПоля(Тело, "content_base64", "")));
		ИначеЕсли ИмяОбработчика = "EventLogGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПрочитатьЖурналРегистрацииАгента(ПараметрЗапроса(Запрос, "minutes"), ПараметрЗапроса(Запрос, "limit"), ПараметрЗапроса(Запрос, "level")));
		ИначеЕсли ИмяОбработчика = "DialogWhyStoppedGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПочемуОстановился(ИдентификаторДиалога(Запрос)));
		ИначеЕсли ИмяОбработчика = "DialogMetricsGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьМетрикиДиалога(ИдентификаторДиалога(Запрос)));
		ИначеЕсли ИмяОбработчика = "DialogTraceGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьТрассировкуДиалога(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit")));
		ИначеЕсли ИмяОбработчика = "DialogTimelineGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьЛентуРешений(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit")));
		ИначеЕсли ИмяОбработчика = "DialogFailuresGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьЦепочкиСбоев(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit")));
		ИначеЕсли ИмяОбработчика = "DialogCheckpointsGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьЧекпоинтыДиалога(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit")));
		ИначеЕсли ИмяОбработчика = "DialogCheckpointDiffGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьDiffЧекпоинтовДиалога(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "from"), ПараметрЗапроса(Запрос, "to")));
		ИначеЕсли ИмяОбработчика = "DialogResumePost" Тогда
			Тело = ИИА_АгентHTTP.ПрочитатьТелоJSON(Запрос.ПолучитьТелоКакСтроку());
			Возврат ОтветJSON(202, ИИА_АгентHTTP.ВозобновитьДиалог(ИдентификаторДиалога(Запрос), ЗначениеПоля(Тело, "checkpoint_index", -1), ЗначениеПоля(Тело, "auto_start", Истина)));
		ИначеЕсли ИмяОбработчика = "DialogObjectsGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьОбъектыДиалога(ИдентификаторДиалога(Запрос)));
		ИначеЕсли ИмяОбработчика = "DialogQueryResultGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьРезультатЗапросаДиалога(ИдентификаторДиалога(Запрос), ПараметрЗапроса(Запрос, "limit")));
		ИначеЕсли ИмяОбработчика = "RagStatusGet" Тогда
			Возврат ОтветJSON(200, ИИА_АгентHTTP.ПолучитьСтатусRAG());
		Иначе
			ВызватьИсключение "Неизвестный обработчик HTTP API: " + ИмяОбработчика;
		КонецЕсли;
	Исключение
		Возврат ОтветОшибки(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ИдентификаторДиалога(Запрос)
	Возврат СокрЛП(Строка(Запрос.ПараметрыURL.Получить("id")));
КонецФункции

Функция ПараметрЗапроса(Запрос, ИмяПараметра)
	Если Запрос.ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Запрос.ПараметрыЗапроса.Получить(ИмяПараметра);
КонецФункции

Функция ЗначениеПоля(Данные, ИмяПоля, ЗначениеПоУмолчанию)
	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Значение = Неопределено;
	Если Данные.Свойство(ИмяПоля, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ОтветJSON(КодСостояния, Данные)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ИИА_АгентHTTP.ЗаписатьJSONСтроку(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибки(ТекстОшибки)
	КодСостояния = 500;
	ТекстВРег = ВРег(Строка(ТекстОшибки));
	Если СтрНайти(ТекстВРег, "ТРЕБУЕТСЯ АУТЕНТИФИКАЦИЯ") > 0 Тогда
		КодСостояния = 401;
	ИначеЕсли СтрНайти(ТекстВРег, "НЕТ ДОСТУПА") > 0 Тогда
		КодСостояния = 403;
	ИначеЕсли СтрНайти(ТекстВРег, "НЕ НАЙДЕН") > 0 Тогда
		КодСостояния = 404;
	ИначеЕсли СтрНайти(ТекстВРег, "ПУСТ") > 0
		ИЛИ СтрНайти(ТекстВРег, "НЕ УКАЗАН") > 0
		ИЛИ СтрНайти(ТекстВРег, "НЕКОРРЕКТН") > 0
		ИЛИ СтрНайти(ТекстВРег, "НЕИЗВЕСТН") > 0
		ИЛИ СтрНайти(ТекстВРег, "ДОЛЖНО БЫТЬ") > 0
		ИЛИ СтрНайти(ТекстВРег, "ДЛИННЕЕ") > 0
		ИЛИ СтрНайти(ТекстВРег, "БОЛЬШЕ") > 0 Тогда
		КодСостояния = 400;
	КонецЕсли;
	Тело = Новый Структура;
	Тело.Вставить("error", Строка(ТекстОшибки));
	Возврат ОтветJSON(КодСостояния, Тело);
КонецФункции

#КонецОбласти
