Процедура ПериодическоеОбновлениеСсылокНаОбъекты()
	// Оставлено как no-op для совместимости с уже открытыми формами старой версии.
	Возврат;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеИзмененныхОбъектовТекущегоДиалогаНаСервере()
	Результат = Новый Структура("Представления,НавигационныеСсылки", Новый Массив, Новый Массив);
	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Представления = ИИА_Сервер.ПолучитьПредставленияИзмененныхОбъектовДиалога(ТекущийДиалог);
	Результат.НавигационныеСсылки = ИИА_Сервер.ПолучитьНавигационныеСсылкиИзмененныхОбъектовДиалога(ТекущийДиалог);
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбновитьСсылкиНаОбъектыИзТекущегоДиалогаНаСервере()
	МассивСсылокНаОбъекты = ИИА_Сервер.ПолучитьИзмененныеОбъектыДиалога(ТекущийДиалог);
	ЭтотОбъект.ИзмененныеОбъекты.Очистить();
	Для Каждого СсылкаНаОбъект Из МассивСсылокНаОбъекты Цикл
		Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			НоваяСтрока = ЭтотОбъект.ИзмененныеОбъекты.Добавить();
			НоваяСтрока.СсылкаНаОбъект = СсылкаНаОбъект;
		КонецЕсли;
	КонецЦикла;
	ОбновитьСсылкиНаОбъектыНаФорме(МассивСсылокНаОбъекты);
КонецПроцедуры

&НаКлиенте
// Оркестратор процесса выполнения задачи с использованием планирования
Процедура СпланироватьСледующиеШаги()
	// Оркестрация перенесена на сервер, здесь шаги не выполняются
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ПриПриемеСообщения(ДанныеСообщения, ДополнительныеПараметры = Неопределено) Экспорт

	// Проверяем, что уведомление относится к нашему диалогу
	Если ДанныеСообщения.Свойство("Диалог")
		И ЗначениеЗаполнено(ДанныеСообщения.Диалог)
		И (ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() ИЛИ ОркестраторРаботает) Тогда
		ТекущийДиалог = ДанныеСообщения.Диалог;
	КонецЕсли;
	Если ДанныеСообщения.Свойство("Диалог") И ДанныеСообщения.Диалог = ТекущийДиалог Тогда
		ТекущийТекстДоОбновления = ТекущийТекст;
		ТипСобытия = "";
		Если ДанныеСообщения.Свойство("ТипСобытия") Тогда
			ТипСобытия = ДанныеСообщения.ТипСобытия;
		КонецЕсли;

		Если ДанныеСообщения.Свойство("ВерсияДиалога") Тогда
			ЭтотОбъект.ПоследняяВерсияДиалога = Строка(ДанныеСообщения.ВерсияДиалога);
		КонецЕсли;

		// 1. Обновляем чат: из payload по УИД. Полная перезагрузка только как fallback
		// для старых уведомлений НовоеСообщение без payload.
		ЕстьСообщениеВPayload = ДанныеСообщения.Свойство("Сообщение") И ТипЗнч(ДанныеСообщения.Сообщение) = Тип("Структура")
			И ДанныеСообщения.Сообщение.Свойство("УИД") И НЕ ПустаяСтрока(Строка(ДанныеСообщения.Сообщение.УИД));
		Если ЕстьСообщениеВPayload Тогда
			ДобавитьСообщениеВЧатИзPayload(ДанныеСообщения.Сообщение);
			Если ДанныеСообщения.Сообщение.Свойство("Текст") Тогда
				Попытка
					ЗаполнитьСсылкиНаОбъектыИзТекстаSummary(Строка(ДанныеСообщения.Сообщение.Текст));
				Исключение
					ТекстОшибкиВосстановленияСсылок = ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли ТипСобытия = "НовоеСообщение" Тогда
			ОбновитьОтображениеДиалога();
		КонецЕсли;

		// 2. Обновляем план
		ОбновитьОтображениеПлана();

		// 3. Обновляем реквизиты
		ОбновитьОтображениеРеквизитов();

		// Обработка завершения или остановки
		Если НЕ ПустаяСтрока(ТипСобытия) Тогда

			СсылкиИзPayloadЗаполнены = Ложь;
			Если ДанныеСообщения.Свойство("ИзмененныеОбъектыПредставления") Тогда
				МассивНавигационныхСсылок = Неопределено;
				Если ДанныеСообщения.Свойство("ИзмененныеОбъектыНавигационныеСсылки") Тогда
					МассивНавигационныхСсылок = ДанныеСообщения.ИзмененныеОбъектыНавигационныеСсылки;
				КонецЕсли;
				ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениямНаКлиенте(ДанныеСообщения.ИзмененныеОбъектыПредставления, МассивНавигационныхСсылок);
				Попытка
					СсылкиИзPayloadЗаполнены = ДанныеСообщения.ИзмененныеОбъектыПредставления.Количество() > 0;
				Исключение
					СсылкиИзPayloadЗаполнены = Ложь;
				КонецПопытки;
			КонецЕсли;
			Если НЕ СсылкиИзPayloadЗаполнены И ДанныеСообщения.Свойство("ИзмененныеОбъектыТекст") Тогда
				ЗаполнитьСтатическиеСсылкиНаОбъектыИзТекстаНаКлиенте(Строка(ДанныеСообщения.ИзмененныеОбъектыТекст));
			КонецЕсли;

			Если ТипСобытия = "ЗадачаЗавершена" ИЛИ ТипСобытия = "ОстановленПользователем"
				ИЛИ ТипСобытия = "ОшибкаПлана" ИЛИ ТипСобытия = "ПревышенЛимитТокенов" Тогда

				ОстановитьОркестратор();
				Если НЕ ЕстьСообщениеВPayload Тогда
					ОбновитьОтображениеДиалогаПолностью();
				КонецЕсли;

				ТекстСобытия = "Событие";
				Если ТипСобытия = "ЗадачаЗавершена" Тогда
					ТекстСобытия = ?(ДанныеСообщения.Свойство("Успех") И ДанныеСообщения.Успех, "Задача выполнена успешно", "Задача завершена с ошибкой");
				ИначеЕсли ТипСобытия = "ОстановленПользователем" Тогда
					ТекстСобытия = "Оркестратор остановлен";
				ИначеЕсли ТипСобытия = "ОшибкаПлана" Тогда
					ТекстСобытия = "Ошибка создания плана";
				ИначеЕсли ТипСобытия = "ПревышенЛимитТокенов" Тогда
					ТекстСобытия = "Превышен лимит токенов на запуск";
				КонецЕсли;

				СтрокаСтатуса = ТекстСобытия;
				Состояние("ИИ Агент: " + ТекстСобытия,, ТекстСобытия);

			Иначе

				// Оповещаем пользователя о прогрессе (опционально)
				ТекстПрогресса = "";
				Если ТипСобытия = "ОжидаетПодтверждения" Тогда
					СтрокаСтатуса = "Ожидает подтверждения";
					ОстановитьОркестратор("Ожидает подтверждения");
					ОбработатьЗапросПодтверждения(ДанныеСообщения);
				ИначеЕсли ТипСобытия = "РезюмеДобавлено" ИЛИ ТипСобытия = "ИзмененныеОбъектыОбновлены" Тогда
					// Данные уже пришли в payload уведомления.
					ТекстПрогресса = "";
				ИначеЕсли ТипСобытия = "ПланИнициализирован" Тогда
					ТекстПрогресса = "План создан";
				ИначеЕсли ТипСобытия = "ШагВыполнен" Тогда
					ТекстПрогресса = "Шаг выполнен";
				ИначеЕсли ТипСобытия = "ЗапросПринят" Тогда
					ТекстПрогресса = "Запрос принят";
				ИначеЕсли ТипСобытия = "Прогресс" Тогда
					Если ДанныеСообщения.Свойство("Текст") Тогда
						ТекстПрогресса = Строка(ДанныеСообщения.Текст);
					Иначе
						ТекстПрогресса = "Выполняю задачу";
					КонецЕсли;
				КонецЕсли;

				Если НЕ ПустаяСтрока(ТекстПрогресса) Тогда
					СтрокаСтатуса = ТекстПрогресса + "...";
					Состояние("ИИ Агент: " + ТекстПрогресса,, ТекстПрогресса);
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

		Если ТипСобытия = "ЗадачаЗавершена"
			ИЛИ ТипСобытия = "РезюмеДобавлено"
			ИЛИ ТипСобытия = "ИзмененныеОбъектыОбновлены" Тогда
			СсылкиИзPayloadЗаполнены = Ложь;
			Если ДанныеСообщения.Свойство("ИзмененныеОбъектыПредставления") Тогда
				МассивНавигационныхСсылок = Неопределено;
				Если ДанныеСообщения.Свойство("ИзмененныеОбъектыНавигационныеСсылки") Тогда
					МассивНавигационныхСсылок = ДанныеСообщения.ИзмененныеОбъектыНавигационныеСсылки;
				КонецЕсли;
				ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениямНаКлиенте(ДанныеСообщения.ИзмененныеОбъектыПредставления, МассивНавигационныхСсылок);
				Попытка
					СсылкиИзPayloadЗаполнены = ДанныеСообщения.ИзмененныеОбъектыПредставления.Количество() > 0;
				Исключение
					СсылкиИзPayloadЗаполнены = Ложь;
				КонецПопытки;
			КонецЕсли;
			Если НЕ СсылкиИзPayloadЗаполнены И ДанныеСообщения.Свойство("ИзмененныеОбъектыТекст") Тогда
				ЗаполнитьСтатическиеСсылкиНаОбъектыИзТекстаНаКлиенте(Строка(ДанныеСообщения.ИзмененныеОбъектыТекст));
				СсылкиИзPayloadЗаполнены = Истина;
			КонецЕсли;
			Если НЕ СсылкиИзPayloadЗаполнены Тогда
				БезопасноОбновитьСсылкиНаОбъектыИзТекущегоДиалога();
			КонецЕсли;
		КонецЕсли;

		// Если в процессе был выполнен RunQuery - покажем ТабличныйДокумент
		ПопытатьсяПоказатьТабличныйДокумент();
		Если ПустаяСтрока(ТекущийТекст) И НЕ ПустаяСтрока(ТекущийТекстДоОбновления) Тогда
			ТекущийТекст = ТекущийТекстДоОбновления;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

