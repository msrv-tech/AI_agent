&НаКлиенте
Процедура ОбновитьСсылкиНаОбъектыИзТекущегоДиалога()
	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ТекущийТекстДоОбновления = ТекущийТекст;
	ДанныеСсылок = ПолучитьДанныеИзмененныхОбъектовТекущегоДиалогаНаСервере();
	Если ДанныеСсылок = Неопределено Тогда
		Если ПустаяСтрока(ТекущийТекст) И НЕ ПустаяСтрока(ТекущийТекстДоОбновления) Тогда
			ТекущийТекст = ТекущийТекстДоОбновления;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	МассивНавигационныхСсылок = Неопределено;
	Если ДанныеСсылок.Свойство("НавигационныеСсылки") Тогда
		МассивНавигационныхСсылок = ДанныеСсылок.НавигационныеСсылки;
	КонецЕсли;
	Если ДанныеСсылок.Свойство("Представления") Тогда
		ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениямНаКлиенте(ДанныеСсылок.Представления, МассивНавигационныхСсылок);
	КонецЕсли;
	Если ПустаяСтрока(ТекущийТекст) И НЕ ПустаяСтрока(ТекущийТекстДоОбновления) Тогда
		ТекущийТекст = ТекущийТекстДоОбновления;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура БезопасноОбновитьСсылкиНаОбъектыИзТекущегоДиалога()
	Попытка
		ОбновитьСсылкиНаОбъектыИзТекущегоДиалога();
	Исключение
		ТекстОшибкиОбновленияСсылок = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

