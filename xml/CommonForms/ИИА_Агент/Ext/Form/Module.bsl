Перем ОтрисованныеУИД;
Перем УИДТекущегоДиалогаДляЧата;

&НаКлиенте
Функция ПолучитьИмяФайлаИзОписанияПомещения(ОписаниеФайла)
	ИмяФайла = "";
	Попытка
		ИмяФайла = ОписаниеФайла.СсылкаНаФайл.ПолноеИмя;
	Исключение
		ИмяФайла = "";
	КонецПопытки;
	Если НЕ ПустаяСтрока(ИмяФайла) Тогда
		ФайлПоПути = Новый Файл(ИмяФайла);
		Возврат ФайлПоПути.Имя;
	КонецЕсли;
	Попытка
		ИмяФайла = ОписаниеФайла.СсылкаНаФайл.Имя;
	Исключение
		ИмяФайла = "";
	КонецПопытки;
	Если НЕ ПустаяСтрока(ИмяФайла) Тогда
		Возврат ИмяФайла;
	КонецЕсли;
	Расширение = "";
	Попытка
		Расширение = ОписаниеФайла.СсылкаНаФайл.Расширение;
	Исключение
		Расширение = "";
	КонецПопытки;
	Если НЕ ПустаяСтрока(Расширение) Тогда
		Возврат "upload." + Расширение;
	КонецЕсли;
	Возврат "upload.bin";
КонецФункции

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Устанавливаем начальные значения
	ТекущийТипДиалога = Перечисления.ИИА_ТипДиалога.Агент;
	СтрокаСтатуса = "Готов к работе";
	Заголовок = "Агент ИИ";
	ОркестраторРаботает = Ложь;
	Элементы.Отправить.Заголовок = "Отправить";
	Элементы.Отправить.ЦветФона = WebЦвета.СветлоЗеленый;
	ЛогСсылка = "Лог";
	СсылкаПрикрепитьФайл = "Прикрепить файл";
	ТекстПодтверждения = "Подтверждение действия";
	СсылкаОтклонитьДействие = "Отклонить";
	СсылкаБезПодтверждения = "Без подтверждений";
	ОтрисованныеУИД = Новый Соответствие;
	УИДТекущегоДиалогаДляЧата = "";
	ЭтотОбъект.ПоследняяВерсияДиалога = "";
	ЭтотОбъект.ПоследнийКлючПодтверждения = "";
	DecisionTimeline = "";
	СсылкаТабличногоДокумента = "";
	ФинальныйРезультат = "";

КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизации()
	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ОбновитьОтображениеДиалогаПолностью();
	БезопасноОбновитьСсылкиНаОбъектыИзТекущегоДиалога();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Проверяем наличие настроек
	Если НЕ ЕстьНастройкиНаСервере() Тогда
		// Если настроек нет, открываем форму регистрации
		ОткрытьФорму("ОбщаяФорма.ИИА_РегистрацияGitsell");
		// Закрываем текущую форму агента, так как без настроек работать нельзя
		ЭтаФорма.Закрыть();
		Возврат;
	КонецЕсли;

	// Проверяем, что расширение подключено без флага «Безопасный режим» (иначе нет доступа в интернет)
	Если РасширениеВБезопасномРежимеНаСервере() Тогда
		ПоказатьОповещениеПользователя("Расширение подключено в безопасном режиме",
			"Снимите флаг «Безопасный режим» для расширения (Все функции → Расширения конфигурации). Без этого доступ в интернет недоступен.",
			"РасширениеИИАгент");
	КонецЕсли;

	// Получаем или создаем диалог текущего пользователя
	ТекущийДиалог = ИИА_Клиент.НайтиИлиСоздатьДиалогПользователя();
	СинхронизироватьТипДиалогаСТекущим();
	ЭтотОбъект.ПоследняяВерсияДиалога = "";
	ЭтотОбъект.ПоследнийКлючПодтверждения = "";
	СброситьСостояниеЧатаНаСервере();

	// Синхронизируем состояние оркестратора с регистром (на случай переоткрытия формы)
	ОбновитьСостояниеОркестратораНаСервере();

	// Обновляем все элементы интерфейса
	ОбновитьОтображениеДиалога();
	ОбновитьОтображениеПлана();
	ОбновитьОтображениеРеквизитов();

	// Подключаем обработчик уведомлений (1С 8.3.26+)
	Обработчик = Новый ОписаниеОповещения("ПриПриемеСообщения", ЭтотОбъект);
	УведомленияКлиента.ПодключитьОбработчик("СообщениеПереписки", Обработчик);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	// Отключаем обработчик уведомлений
	УведомленияКлиента.ОтключитьОбработчик("СообщениеПереписки");

КонецПроцедуры

&НаСервере
Функция ЕстьНастройкиНаСервере()
	Возврат ИИА_GitsellСервер.ЕстьНастройкиПользователя();
КонецФункции

&НаСервере
Функция РасширениеВБезопасномРежимеНаСервере()
	Результат = ИИА_GitsellСервер.РасширениеВБезопасномРежиме();
	Возврат Результат.БезопасныйРежимВключен;
КонецФункции

&НаСервере
Процедура ОбновитьСостояниеОркестратораНаСервере()

	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		ОркестраторРаботает = Ложь;
		Возврат;
	КонецЕсли;

	ОркестраторРаботает = ИИА_ВызовСервера.ОркестраторВключенДляДиалога(ТекущийДиалог);

КонецПроцедуры

&НаКлиенте
Процедура СинхронизироватьТипДиалогаСТекущим()

	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Возврат;
	КонецЕсли;

	ТипДиалога = ПолучитьТипДиалогаНаСервере(ТекущийДиалог);
	Если ТипДиалога <> Неопределено Тогда
		ТекущийТипДиалога = ТипДиалога;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьТипДиалогаНаСервере(СсылкаДиалога)

	Если СсылкаДиалога = Неопределено ИЛИ СсылкаДиалога.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СсылкаДиалога.ТипДиалога;

КонецФункции

&НаСервере
Процедура УстановитьТипДиалогаНаСервере(СсылкаДиалога, ТипДиалога)

	Если СсылкаДиалога = Неопределено ИЛИ СсылкаДиалога.Пустая()
		ИЛИ ТипДиалога = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если СсылкаДиалога.ТипДиалога = ТипДиалога Тогда
		Возврат;
	КонецЕсли;
	Диалог = СсылкаДиалога.ПолучитьОбъект();
	Диалог.ТипДиалога = ТипДиалога;
	Диалог.Записать();

КонецПроцедуры

#КонецОбласти
&НаКлиенте
Процедура ЛогСсылкаНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Сообщить("Диалог не выбран.");
		Возврат;
	КонецЕсли;

	// Принудительно загружаем актуальный лог из справочника
	ТекстЛога = ИИА_ВызовСервера.ПолучитьЛогДиалога(ТекущийДиалог);

	// Если лог пустой, проверим, может это новый диалог без лога или ошибка
	Если ПустаяСтрока(ТекстЛога) Тогда
		ОписаниеДиалога = ИИА_ВызовСервера.ПолучитьОписаниеДиалога(ТекущийДиалог);
		Сообщить("Лог диалога пуст. Текущий диалог: " + Строка(ТекущийДиалог.УникальныйИдентификатор()) + " | " + ОписаниеДиалога);
		Возврат;
	КонецЕсли;

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстЛога);
	ТекстовыйДокумент.Показать("Лог диалога: " + Строка(ТекущийДиалог));

КонецПроцедуры

&НаКлиенте
Процедура СсылкаТабличногоДокументаНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Сообщить("Диалог не выбран.");
		Возврат;
	КонецЕсли;

	Если ИИА_ВызовСервера.ЭтоДиалогЗапрос1С(ТекущийДиалог) Тогда
		ОткрытьФормуЗапроса1С();
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеДляТаблицы = ИИА_ВызовСервера.ПолучитьПоследниеДанныеЗапроса(ТекущийДиалог);
		Если ДанныеДляТаблицы = Неопределено ИЛИ ТипЗнч(ДанныеДляТаблицы) <> Тип("Массив") ИЛИ ДанныеДляТаблицы.Количество() = 0 Тогда
			Сообщить("Табличный документ еще не сформирован.");
			Возврат;
		КонецЕсли;
		ТабличныйДокумент = ИИА_ВызовСервера.СоздатьТабличныйДокументИзДанных(ДанныеДляТаблицы);
		Если ТабличныйДокумент = Неопределено Тогда
			Сообщить("Не удалось создать табличный документ.");
			Возврат;
		КонецЕсли;
		ТабличныйДокумент.Показать("Таблица результатов");
		ВернутьФокусНаФормуАгента();
	Исключение
		Сообщить("Не удалось открыть табличный документ: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СкрытьСсылкуНаТабличныйДокумент()
	СсылкаТабличногоДокумента = "";
	Если Элементы.Найти("СсылкаТабличногоДокумента") <> Неопределено Тогда
		Элементы.СсылкаТабличногоДокумента.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ГруппаСсылкиНаОбъекты") <> Неопределено Тогда
		Элементы.ГруппаСсылкиНаОбъекты.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекущийДиалогПриИзменении(Элемент)

	// Если диалог пустой, очищаем все
	Если ТекущийДиалог.Пустая() Тогда
		СтрокаСтатуса = "Выберите диалог";
		ЭтотОбъект.ПоследняяВерсияДиалога = "";
		СкрытьСсылкуНаТабличныйДокумент();
		СброситьСостояниеЧатаНаСервере();
		// Обновляем с пустым диалогом (очистит чат)
		ОбновитьОтображениеДиалога();
		ОбновитьОтображениеПлана();
		ОбновитьОтображениеРеквизитов();
		Возврат;
	КонецЕсли;

	// Останавливаем оркестратор при смене диалога, чтобы не смешивать контексты
	Если ОркестраторРаботает Тогда
		ОстановитьОркестратор();
	КонецЕсли;

	// Синхронизируем состояние оркестратора с регистром для выбранного диалога
	СинхронизироватьТипДиалогаСТекущим();
	ОбновитьСостояниеОркестратораНаСервере();
	ЭтотОбъект.ПоследняяВерсияДиалога = "";
	ЭтотОбъект.ПоследнийКлючПодтверждения = "";
	СкрытьСсылкуНаТабличныйДокумент();
	СброситьСостояниеЧатаНаСервере();

	// Обновляем все элементы интерфейса
	ОбновитьОтображениеДиалога();
	ОбновитьОтображениеПлана();
	ОбновитьОтображениеРеквизитов();

	СтрокаСтатуса = "Диалог загружен";

КонецПроцедуры

&НаКлиенте
Процедура СсылкаПрикрепитьФайлНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПрикрепитьФайл(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СсылкаОтклонитьДействиеНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОтклонитьДействие(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СсылкаБезПодтвержденияНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	БезПодтверждения(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ТекущийТипСообщенияПриИзменении(Элемент)
	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Возврат;
	КонецЕсли;
	УстановитьТипДиалогаНаСервере(ТекущийДиалог, ТекущийТипДиалога);
	ЭтотОбъект.ПоследняяВерсияДиалога = "";
	СтрокаСтатуса = "Режим диалога изменен";
	ОбновитьОтображениеПлана();
	ОбновитьОтображениеРеквизитов();
КонецПроцедуры


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОтправить(Команда)

	// Если оркестратор работает, останавливаем его
	Если ОркестраторРаботает Тогда
		Если ЗначениеЗаполнено(ТекущийДиалог) Тогда
			ИИА_ВызовСервера.ОркестраторОстановить(ТекущийДиалог);
		КонецЕсли;
		ОстановитьОркестратор();
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекущийТекст) Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийДиалог = Неопределено Тогда
		Сообщить("Диалог не создан. Попробуйте перезапустить форму.");
		Возврат;
	КонецЕсли;
	УстановитьТипДиалогаНаСервере(ТекущийДиалог, ТекущийТипДиалога);

	// Запускаем оркестратор
	ЗапуститьОркестратор();

	// Устанавливаем статус "Отправка..."
	СтрокаСтатуса = "Отправка сообщения...";

	Попытка
		// Отправляем сообщение и запускаем оркестратор на сервере
		ИИА_ВызовСервера.ОркестраторОтправитьИЗапустить(
			ТекущийДиалог,
			ТекущийТекст,
			ТекущийТипДиалога
		);

		// Обновляем интерфейс
		ОбновитьОтображениеДиалога();
		ОбновитьОтображениеРеквизитов();

		// Очищаем поле ввода
		ТекущийТекст = "";

	Исключение

		ТекстОшибки = "Ошибка: " + ОписаниеОшибки();
		ОстановитьОркестратор(ТекстОшибки);
		Сообщить(ТекстОшибки);

	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайл(Команда)
	Если ТекущийДиалог = Неопределено Тогда
		Сообщить("Диалог не создан. Попробуйте перезапустить форму.");
		Возврат;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите файл";
	ПараметрыДиалога.МножественныйВыбор = Ложь;
	ЗавершениеОбратныйВызов = Новый ОписаниеОповещения("ПослеВыбораФайлаДляВложения", ЭтотОбъект);
	ПрогрессОбратныйВызов = Новый ОписаниеОповещения("ПрогрессПомещенияФайлаДляВложения", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(ЗавершениеОбратныйВызов, ПрогрессОбратныйВызов, , , ПараметрыДиалога, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаДляВложения(ОписаниеФайла, ДополнительныеПараметры = Неопределено) Экспорт
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ИмяФайлаВложения = ПолучитьИмяФайлаИзОписанияПомещения(ОписаниеФайла);
		ДобавитьВложениеПоАдресуВременногоХранилища(ИмяФайлаВложения, ОписаниеФайла.Адрес);
	Исключение
		Сообщить("Ошибка при добавлении вложения: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПрогрессПомещенияФайлаДляВложения(ПомещаемыйФайл = Неопределено, ЗначениеПрогресса = Неопределено, ДополнительныеПараметры = Неопределено, Отказ = Ложь) Экспорт
	Если ЗначениеПрогресса = Неопределено И ПомещаемыйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаСтатуса = "Загрузка файла...";
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлПоПутиДляТеста(ПутьКФайлу = "", ДополнительныйПараметр1 = Неопределено, ДополнительныйПараметр2 = Неопределено, ДополнительныйПараметр3 = Неопределено) Экспорт
	ДобавитьВложениеИзЛокальногоФайла(ПутьКФайлу);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДиалогСодержитТекстДляТеста(ИскомыйТекст = "", ДополнительныйПараметр1 = Неопределено, ДополнительныйПараметр2 = Неопределено, ДополнительныйПараметр3 = Неопределено) Экспорт
	ИскомыйТекст = СокрЛП(Строка(ИскомыйТекст));
	Если ПустаяСтрока(ИскомыйТекст) Тогда
		ВызватьИсключение "Не указан текст для проверки в диалоге.";
	КонецЕсли;
	Если ТекущийДиалог = Неопределено Тогда
		ВызватьИсключение "Диалог не создан. Попробуйте перезапустить форму.";
	КонецЕсли;

	СообщенияДиалога = ИИА_ВызовСервера.ПолучитьСообщенияДиалога(ТекущийДиалог, 0);
	Для Каждого СтрокаСообщения Из СообщенияДиалога Цикл
		Если СтрокаСообщения.Свойство("Текст") И СтрНайти(Строка(СтрокаСообщения.Текст), ИскомыйТекст) > 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В диалоге не найден текст: " + ИскомыйТекст;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДиалогНеСодержитТекстДляТеста(ИскомыйТекст = "", ДополнительныйПараметр1 = Неопределено, ДополнительныйПараметр2 = Неопределено, ДополнительныйПараметр3 = Неопределено) Экспорт
	ИскомыйТекст = СокрЛП(Строка(ИскомыйТекст));
	Если ПустаяСтрока(ИскомыйТекст) Тогда
		ВызватьИсключение "Не указан текст для негативной проверки в диалоге.";
	КонецЕсли;
	Если ТекущийДиалог = Неопределено Тогда
		ВызватьИсключение "Диалог не создан. Попробуйте перезапустить форму.";
	КонецЕсли;

	СообщенияДиалога = ИИА_ВызовСервера.ПолучитьСообщенияДиалога(ТекущийДиалог, 0);
	Для Каждого СтрокаСообщения Из СообщенияДиалога Цикл
		Если СтрокаСообщения.Свойство("Текст") И СтрНайти(Строка(СтрокаСообщения.Текст), ИскомыйТекст) > 0 Тогда
			ВызватьИсключение "В диалоге найден запрещенный текст: " + ИскомыйТекст;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЖдатьПокаДиалогСодержитТекстДляТеста(ИскомыйТекст = "", ТаймаутСекунд = 60, ДополнительныйПараметр2 = Неопределено, ДополнительныйПараметр3 = Неопределено) Экспорт
	ИскомыйТекст = СокрЛП(Строка(ИскомыйТекст));
	Если ПустаяСтрока(ИскомыйТекст) Тогда
		ВызватьИсключение "Не указан текст для ожидания в диалоге.";
	КонецЕсли;
	Если ТекущийДиалог = Неопределено Тогда
		ВызватьИсключение "Диалог не создан. Попробуйте перезапустить форму.";
	КонецЕсли;

	КоличествоПопыток = 60;
	Попытка
		КоличествоПопыток = Макс(1, Число(ТаймаутСекунд) * 80);
	Исключение
		КоличествоПопыток = 60;
	КонецПопытки;

	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		СообщенияДиалога = ИИА_ВызовСервера.ПолучитьСообщенияДиалога(ТекущийДиалог, 0);
		Для Каждого СтрокаСообщения Из СообщенияДиалога Цикл
			Если СтрокаСообщения.Свойство("Текст") И СтрНайти(Строка(СтрокаСообщения.Текст), ИскомыйТекст) > 0 Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ВызватьИсключение "В диалоге не найден текст за " + Строка(ТаймаутСекунд) + " сек.: " + ИскомыйТекст;
КонецПроцедуры

&НаКлиенте
Процедура НовыйДиалог(Команда)

	// Создаем новый диалог
	ТекущийДиалог = ИИА_Клиент.СоздатьНовыйДиалог(ТекущийТипДиалога);
	СкрытьСсылкуНаТабличныйДокумент();
	ЭтотОбъект.ПоследняяВерсияДиалога = "";
	ЭтотОбъект.ПоследнийКлючПодтверждения = "";
	СброситьСостояниеЧатаНаСервере();

	// Очищаем форму
	ТекущийТекст = "";

	// Обновляем интерфейс
	ОбновитьОтображениеДиалога();
	ОбновитьОтображениеПлана();

	// Устанавливаем начальные значения
	СтрокаСтатуса = "Создан новый диалог. Готов к работе";
	ОркестраторРаботает = Ложь;
	ОбновитьОтображениеРеквизитов();

КонецПроцедуры
#КонецОбласти

#Область ПроцедурыИФункцииКлиентскогоМодуля

&НаКлиенте
// Запускает оркестратор и обновляет интерфейс
Процедура ЗапуститьОркестратор()

	ОркестраторРаботает = Истина;
	ОбновитьОтображениеРеквизитов();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложениеИзЛокальногоФайла(ПутьКФайлу)
	Если ТекущийДиалог = Неопределено Тогда
		ВызватьИсключение "Диалог не создан. Попробуйте перезапустить форму.";
	КонецЕсли;

	ПутьКФайлу = СокрЛП(Строка(ПутьКФайлу));
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		ВызватьИсключение "Путь к файлу не указан.";
	КонецЕсли;

	ФайлВложения = Новый Файл(ПутьКФайлу);
	Если НЕ ФайлВложения.Существует() Тогда
		ВызватьИсключение "Файл не найден: " + ПутьКФайлу;
	КонецЕсли;

	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор());
	ДобавитьВложениеПоАдресуВременногоХранилища(ФайлВложения.Имя, АдресВременногоХранилища);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложениеПоАдресуВременногоХранилища(ИмяФайлаВложения, АдресВременногоХранилища)
	Если ТекущийДиалог = Неопределено Тогда
		ВызватьИсключение "Диалог не создан. Попробуйте перезапустить форму.";
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Строка(АдресВременногоХранилища))) Тогда
		ВызватьИсключение "Адрес временного хранилища не указан.";
	КонецЕсли;
	ИИА_ВызовСервера.ДобавитьВложениеИзВременногоХранилища(ТекущийДиалог, ИмяФайлаВложения, АдресВременногоХранилища);
	СтрокаСтатуса = "Вложение добавлено";
	ОбновитьОтображениеДиалога();
	ОбновитьОтображениеРеквизитов();
КонецПроцедуры

&НаКлиенте
// Останавливает оркестратор и обновляет интерфейс
Процедура ОстановитьОркестратор(ТекстСтатуса = "")

	ОркестраторРаботает = Ложь;
	Если ПустаяСтрока(ТекстСтатуса) Тогда
		СтрокаСтатуса = "Оркестратор остановлен";
	Иначе
		СтрокаСтатуса = ТекстСтатуса;
	КонецЕсли;
	ОбновитьОтображениеРеквизитов();

КонецПроцедуры

