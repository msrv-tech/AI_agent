&НаКлиенте
Процедура ПопытатьсяПоказатьФинальныйРезультатИзТекстаНаКлиенте(ТекстСообщения)
	Если НЕ СтрНачинаетсяС(СокрЛП(ТекстСообщения), "=== РЕЗЮМЕ") Тогда
		Возврат;
	КонецЕсли;

	ФинальныйРезультат = ИзвлечьSummaryИзТекстаНаКлиенте(ТекстСообщения);
	СтрокаСтатуса = ФинальныйРезультат;
	Если НЕ ПустаяСтрока(ФинальныйРезультат) И Элементы.Найти("ФинальныйРезультатПоле") <> Неопределено Тогда
		Элементы.ФинальныйРезультатПоле.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФинальныйРезультатИзPayloadНаКлиенте(ДанныеСообщения)
	Если НЕ ПустаяСтрока(ФинальныйРезультат) Тогда
		Возврат;
	КонецЕсли;

	ТекстРезультата = "Задача выполнена успешно. Задача: " + Заголовок;
	Если ДанныеСообщения.Свойство("Успех") И НЕ ДанныеСообщения.Успех Тогда
		ТекстРезультата = "Задача завершена с ошибкой. Задача: " + Заголовок;
	КонецЕсли;

	Если ДанныеСообщения.Свойство("ИзмененныеОбъектыПредставления") Тогда
		ТекстОбъектов = "";
		Попытка
			Для Каждого ПредставлениеОбъекта Из ДанныеСообщения.ИзмененныеОбъектыПредставления Цикл
				Если НЕ ПустаяСтрока(Строка(ПредставлениеОбъекта)) Тогда
					ТекстОбъектов = ТекстОбъектов + Символы.ПС + "- " + Строка(ПредставлениеОбъекта);
				КонецЕсли;
			КонецЦикла;
		Исключение
			ТекстОбъектов = "";
		КонецПопытки;
		Если НЕ ПустаяСтрока(ТекстОбъектов) Тогда
			ТекстРезультата = ТекстРезультата + Символы.ПС + Символы.ПС
				+ "Созданные/измененные объекты:" + ТекстОбъектов;
		КонецЕсли;
	КонецЕсли;

	ФинальныйРезультат = ТекстРезультата;
	СтрокаСтатуса = ТекстРезультата;
	Если Элементы.Найти("ФинальныйРезультатПоле") <> Неопределено Тогда
		Элементы.ФинальныйРезультатПоле.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ИзвлечьSummaryИзТекстаНаКлиенте(ИсходныйТекст)
	Текст = Строка(ИсходныйТекст);
	Если НЕ СтрНачинаетсяС(СокрЛП(Текст), "=== РЕЗЮМЕ") Тогда
		Возврат Текст;
	КонецЕсли;

	ПозицияПервогоПеревода = СтрНайти(Текст, Символы.ПС);
	Если ПозицияПервогоПеревода = 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = СокрЛП(Сред(Текст, ПозицияПервогоПеревода + 1));
	Пока СтрНачинаетсяС(Результат, Символы.ПС) Цикл
		Результат = СокрЛП(Сред(Результат, 2));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбновитьФинальныйРезультатНаСервере()
	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		ФинальныйРезультат = "";
		Если Элементы.Найти("ФинальныйРезультатПоле") <> Неопределено Тогда
			Элементы.ФинальныйРезультатПоле.Видимость = Ложь;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	НовыйФинальныйРезультат = "";
	Попытка
		Диалог = ТекущийДиалог.ПолучитьОбъект();
		Индекс = Диалог.Сообщения.Количество() - 1;
		Пока Индекс >= 0 Цикл
			СтрокаСообщения = Диалог.Сообщения[Индекс];
			ТекстСообщения = Строка(СтрокаСообщения.Текст);
			Если СтрНачинаетсяС(СокрЛП(ТекстСообщения), "=== РЕЗЮМЕ") Тогда
				НовыйФинальныйРезультат = ИИА_Summary.ИзвлечьSummaryИзТекста(ТекстСообщения);
				Прервать;
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		МассивСсылокНаОбъекты = Новый Массив;
		Для Каждого СтрокаИзмененных Из Диалог.ИзмененныеОбъекты Цикл
			Если ЗначениеЗаполнено(СтрокаИзмененных.СсылкаНаОбъект)
				И МассивСсылокНаОбъекты.Найти(СтрокаИзмененных.СсылкаНаОбъект) = Неопределено Тогда
				МассивСсылокНаОбъекты.Добавить(СтрокаИзмененных.СсылкаНаОбъект);
			КонецЕсли;
		КонецЦикла;
		Если МассивСсылокНаОбъекты.Количество() > 0 Тогда
			ОбновитьСсылкиНаОбъектыНаФорме(МассивСсылокНаОбъекты);
		КонецЕсли;
	Исключение
		НовыйФинальныйРезультат = "";
	КонецПопытки;

	Если НЕ ПустаяСтрока(НовыйФинальныйРезультат) Тогда
		ФинальныйРезультат = НовыйФинальныйРезультат;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ФинальныйРезультат) И Элементы.Найти("ФинальныйРезультатПоле") <> Неопределено Тогда
		Элементы.ФинальныйРезультатПоле.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеПлана()
	ОбновитьПланНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеРеквизитов()

	ОбновитьПотреченоТокеновНаФорме();
	ОбновитьПанельПодтверждения();
	ОбновитьСсылкуНаТабличныйДокументНаФорме();

	Если ОркестраторРаботает Тогда
		Элементы.Отправить.Заголовок = "Остановить";
		Элементы.Отправить.ЦветФона = WebЦвета.Коралловый;
		Элементы.ДекорацияДлительнаяОперация.Видимость = Истина;
	Иначе
		Элементы.Отправить.Заголовок = "Отправить";
		Элементы.Отправить.ЦветФона = WebЦвета.СветлоЗеленый;
		Элементы.ДекорацияДлительнаяОперация.Видимость = Ложь;
	КонецЕсли;

	Элементы.Отправить.Доступность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСсылкуНаТабличныйДокументНаФорме()
	Если Элементы.Найти("СсылкаТабличногоДокумента") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущийДиалог = Неопределено Или ТекущийДиалог.Пустая() Тогда
		СсылкаТабличногоДокумента = "";
		Элементы.СсылкаТабличногоДокумента.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Попытка
		Если ИИА_ВызовСервера.ЭтоДиалогЗапрос1С(ТекущийДиалог) Тогда
			СсылкаТабличногоДокумента = "Открыть форму запроса 1С";
			Элементы.СсылкаТабличногоДокумента.Видимость = Истина;
			Возврат;
		КонецЕсли;

		ДанныеДляТаблицы = ИИА_ВызовСервера.ПолучитьПоследниеДанныеЗапроса(ТекущийДиалог);
	Исключение
		ДанныеДляТаблицы = Неопределено;
	КонецПопытки;

	Если ДанныеДляТаблицы <> Неопределено
		И ТипЗнч(ДанныеДляТаблицы) = Тип("Массив")
		И ДанныеДляТаблицы.Количество() > 0 Тогда
		СсылкаТабличногоДокумента = "Открыть таблицу результатов";
		Элементы.СсылкаТабличногоДокумента.Видимость = Истина;
	Иначе
		СсылкаТабличногоДокумента = "";
		Элементы.СсылкаТабличногоДокумента.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьDecisionTimelineНаФорме()
	Если ТекущийДиалог = Неопределено Или ТекущийДиалог.Пустая() Тогда
		ЭтотОбъект.DecisionTimeline = "";
		Возврат;
	КонецЕсли;
	Попытка
		ЭтотОбъект.DecisionTimeline = ИИА_ВызовСервера.ПолучитьDecisionTimeline(ТекущийДиалог, 20);
	Исключение
		ЭтотОбъект.DecisionTimeline = "Ошибка чтения decision timeline: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПанельПодтверждения()
	Если ТекущийДиалог = Неопределено Или ТекущийДиалог.Пустая() Тогда
		Элементы.ГруппаПодтверждения.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	СостояниеПодтверждения = ИИА_ВызовСервера.ПолучитьСостояниеПодтверждения(ТекущийДиалог);
	ЕстьPending = СостояниеПодтверждения <> Неопределено
		И СостояниеПодтверждения.Свойство("status")
		И ВРег(Строка(СостояниеПодтверждения.status)) = "PENDING";

	Элементы.ГруппаПодтверждения.Видимость = ЕстьPending;
	Если ЕстьPending Тогда
		ТекстПодтверждения = "Ожидает решения в отдельном окне.";
		Попытка
			Элементы.ТекстПодтверждения.Высота = 3;
			Элементы.ПодтвердитьДействие.Заголовок = "Открыть подтверждение";
		Исключение
		КонецПопытки;
		Элементы.ПодтвердитьДействие.Доступность = Истина;
		КлючПодтверждения = ПолучитьКлючСостоянияПодтверждения(СостояниеПодтверждения);
		Если ЭтотОбъект.ПоследнийКлючПодтверждения <> КлючПодтверждения Тогда
			ЭтотОбъект.ПоследнийКлючПодтверждения = КлючПодтверждения;
			ОткрытьОкноПодтвержденияДействия();
		КонецЕсли;
	Иначе
		ТекстПодтверждения = "Подтверждение действия";
		Попытка
			Элементы.ПодтвердитьДействие.Заголовок = "Подтвердить";
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКлючСостоянияПодтверждения(СостояниеПодтверждения)
	Если СостояниеПодтверждения <> Неопределено
		И СостояниеПодтверждения.Свойство("requested_at")
		И СостояниеПодтверждения.requested_at <> Неопределено Тогда
		Возврат Формат(СостояниеПодтверждения.requested_at, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Если ТекущийДиалог <> Неопределено И НЕ ТекущийДиалог.Пустая() Тогда
		Возврат Строка(ТекущийДиалог.УникальныйИдентификатор());
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервере
Функция СформироватьPreviewПодтвержденияНаСервере(DSLСценарий)
	ОценкаРиска = ИИА_ApprovalPolicy.ОценитьРискDSLДляПодтверждения(DSLСценарий);
	Возврат ИИА_ApprovalPolicy.СформироватьPreviewПодтверждения(DSLСценарий, ОценкаРиска);
КонецФункции

&НаКлиенте
Процедура ОбновитьПланНаФорме()
	ОбновитьПланНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПланНаСервере()

	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		ЭтотОбъект.ПланЗадач.Очистить();
		ЭтотОбъект.ИзмененныеОбъекты.Очистить();
		ОчиститьСсылкиНаОбъекты();
		Возврат;
	КонецЕсли;

	ПланДанные = ИИА_TypedPlan.ПолучитьПланДиалога(ТекущийДиалог);

	ЭтотОбъект.ПланЗадач.Очистить();
	Для Каждого СтрокаПлана Из ПланДанные Цикл
		НоваяСтрока = ЭтотОбъект.ПланЗадач.Добавить();
		НоваяСтрока.Задача = "";
		НоваяСтрока.Выполнена = Ложь;
		НоваяСтрока.Результат = "";

		Если ТипЗнч(СтрокаПлана) = Тип("Структура") Тогда
			Если СтрокаПлана.Свойство("title") Тогда
				НоваяСтрока.Задача = Строка(СтрокаПлана.title);
			ИначеЕсли СтрокаПлана.Свойство("Задача") Тогда
				НоваяСтрока.Задача = Строка(СтрокаПлана.Задача);
			КонецЕсли;

			Если СтрокаПлана.Свойство("result_summary") Тогда
				НоваяСтрока.Результат = Строка(СтрокаПлана.result_summary);
			ИначеЕсли СтрокаПлана.Свойство("Результат") Тогда
				НоваяСтрока.Результат = Строка(СтрокаПлана.Результат);
			КонецЕсли;

			Если СтрокаПлана.Свойство("status") Тогда
				СтатусШага = ВРег(Строка(СтрокаПлана.status));
				НоваяСтрока.Выполнена = СтатусШага = "DONE" ИЛИ СтатусШага = "SKIPPED";
			ИначеЕсли СтрокаПлана.Свойство("Выполнена") Тогда
				НоваяСтрока.Выполнена = СтрокаПлана.Выполнена;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Загружаем ИзмененныеОбъекты из диалога
	Диалог = ТекущийДиалог.ПолучитьОбъект();
	Если Диалог <> Неопределено Тогда
		ЭтотОбъект.ИзмененныеОбъекты.Очистить();
		МассивСсылокНаОбъекты = Новый Массив;
		Для Каждого СтрокаИзмененных Из Диалог.ИзмененныеОбъекты Цикл
			Если ЗначениеЗаполнено(СтрокаИзмененных.СсылкаНаОбъект) Тогда
				НоваяСтрока = ЭтотОбъект.ИзмененныеОбъекты.Добавить();
				НоваяСтрока.СсылкаНаОбъект = СтрокаИзмененных.СсылкаНаОбъект;
				Если МассивСсылокНаОбъекты.Найти(СтрокаИзмененных.СсылкаНаОбъект) = Неопределено Тогда
					МассивСсылокНаОбъекты.Добавить(СтрокаИзмененных.СсылкаНаОбъект);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ОбновитьСсылкиНаОбъектыНаФорме(МассивСсылокНаОбъекты);
	Иначе
		ОчиститьСсылкиНаОбъекты();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьСсылкиНаОбъекты()
	Если Элементы.Найти("ГруппаСсылкиНаОбъекты") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ГруппаСсылки = Элементы.ГруппаСсылкиНаОбъекты;
	МассивДляУдаления = Новый Массив;
	Для Каждого ПодчиненныйЭлемент Из ГруппаСсылки.ПодчиненныеЭлементы Цикл
		Если СтрНачинаетсяС(ПодчиненныйЭлемент.Имя, "дин_obj_") Тогда
			МассивДляУдаления.Добавить(ПодчиненныйЭлемент);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЭлементУдаления Из МассивДляУдаления Цикл
		Элементы.Удалить(ЭлементУдаления);
	КонецЦикла;

	МассивУдаляемыхРеквизитов = Новый Массив;
	Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
		Если СтрНачинаетсяС(Реквизит.Имя, "дин_obj_") Тогда
			МассивУдаляемыхРеквизитов.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Если МассивУдаляемыхРеквизитов.Количество() > 0 Тогда
		ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
	КонецЕсли;

	ИзмененныеОбъектыТекст = "";
	Если Элементы.Найти("ИзмененныеОбъектыТекстПоле") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыТекстПоле.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыСписок") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыСписок.Видимость = Ложь;
	КонецЕсли;
	ГруппаСсылки.Видимость = ЗначениеЗаполнено(СсылкаТабличногоДокумента);
КонецПроцедуры

&НаСервере
Функция ПолучитьПрефиксСсылкиНаОбъект(СсылкаНаОбъект)
	УИДСсылки = Строка(СсылкаНаОбъект.УникальныйИдентификатор());
	УИДСсылки = СтрЗаменить(УИДСсылки, "-", "_");
	УИДСсылки = СтрЗаменить(УИДСсылки, "{", "");
	УИДСсылки = СтрЗаменить(УИДСсылки, "}", "");
	Возврат "дин_obj_" + УИДСсылки;
КонецФункции

&НаСервере
Процедура ОбновитьСсылкиНаОбъектыНаФорме(МассивСсылокНаОбъекты)
	ОчиститьСтатическиеСсылкиНаОбъекты();

	Если МассивСсылокНаОбъекты = Неопределено ИЛИ МассивСсылокНаОбъекты.Количество() = 0 Тогда
		ИзмененныеОбъектыТекст = "";
		Возврат;
	КонецЕсли;

	ТекстИзмененныхОбъектов = "";
	Для Каждого СсылкаНаОбъект Из МассивСсылокНаОбъекты Цикл
		Если НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ТекстИзмененныхОбъектов) Тогда
			ТекстИзмененныхОбъектов = ТекстИзмененныхОбъектов + Символы.ПС;
		КонецЕсли;
		ТекстИзмененныхОбъектов = ТекстИзмененныхОбъектов + Строка(СсылкаНаОбъект);
	КонецЦикла;
	ИзмененныеОбъектыТекст = ТекстИзмененныхОбъектов;
	Если Элементы.Найти("ИзмененныеОбъектыТекстПоле") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыТекстПоле.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыСписок") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыСписок.Видимость = Ложь;
	КонецЕсли;
	ЗаполнитьСтатическиеСсылкиНаОбъекты(МассивСсылокНаОбъекты);
КонецПроцедуры

&НаСервере
Процедура ОчиститьСтатическиеСсылкиНаОбъекты()
	Для НомерСсылки = 1 По 5 Цикл
		ИмяРеквизитаТекста = "ИзмененныйОбъектТекст" + Строка(НомерСсылки);
		ИмяРеквизитаНавигации = "ИзмененныйОбъектНав" + Строка(НомерСсылки);
		ЭтотОбъект[ИмяРеквизитаТекста] = "";
		ЭтотОбъект[ИмяРеквизитаНавигации] = "";
		ЭлементСсылки = Элементы.Найти(ИмяРеквизитаТекста);
		Если ЭлементСсылки <> Неопределено Тогда
			ЭлементСсылки.Заголовок = "";
			ЭлементСсылки.Видимость = Ложь;
		КонецЕсли;
		ЭлементСсылкиПравая = Элементы.Найти("ИзмененныйОбъектСсылкаПравая" + Строка(НомерСсылки));
		Если ЭлементСсылкиПравая <> Неопределено Тогда
			ЭлементСсылкиПравая.Заголовок = "";
			ЭлементСсылкиПравая.Видимость = Ложь;
		КонецЕсли;
		ЭлементСсылкиФинальная = Элементы.Найти("ФинальныйИзмененныйОбъектСсылка" + Строка(НомерСсылки));
		Если ЭлементСсылкиФинальная <> Неопределено Тогда
			ЭлементСсылкиФинальная.Заголовок = "";
			ЭлементСсылкиФинальная.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатическиеСсылкиНаОбъекты(МассивСсылокНаОбъекты)
	Если Элементы.Найти("ГруппаСсылкиНаОбъекты") <> Неопределено Тогда
		Элементы.ГруппаСсылкиНаОбъекты.Видимость = Истина;
	КонецЕсли;
	НомерСсылки = 1;
	Для Каждого СсылкаНаОбъект Из МассивСсылокНаОбъекты Цикл
		Если НомерСсылки > 5 Тогда
			Прервать;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			Продолжить;
		КонецЕсли;
		ИмяРеквизитаТекста = "ИзмененныйОбъектТекст" + Строка(НомерСсылки);
		ИмяРеквизитаНавигации = "ИзмененныйОбъектНав" + Строка(НомерСсылки);
		ЭтотОбъект[ИмяРеквизитаТекста] = Строка(СсылкаНаОбъект);
		Попытка
			ЭтотОбъект[ИмяРеквизитаНавигации] = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект);
		Исключение
			ЭтотОбъект[ИмяРеквизитаНавигации] = "";
		КонецПопытки;
		ЭлементСсылки = Элементы.Найти(ИмяРеквизитаТекста);
		Если ЭлементСсылки <> Неопределено Тогда
			ЭлементСсылки.Заголовок = Строка(СсылкаНаОбъект);
			ЭлементСсылки.Видимость = Ложь;
		КонецЕсли;
		ЭлементСсылкиПравая = Элементы.Найти("ИзмененныйОбъектСсылкаПравая" + Строка(НомерСсылки));
		Если ЭлементСсылкиПравая <> Неопределено Тогда
			ЭлементСсылкиПравая.Заголовок = Строка(СсылкаНаОбъект);
			ЭлементСсылкиПравая.Видимость = Истина;
		КонецЕсли;
		ЭлементСсылкиФинальная = Элементы.Найти("ФинальныйИзмененныйОбъектСсылка" + Строка(НомерСсылки));
		Если ЭлементСсылкиФинальная <> Неопределено Тогда
			ЭлементСсылкиФинальная.Заголовок = Строка(СсылкаНаОбъект);
			ЭлементСсылкиФинальная.Видимость = Ложь;
		КонецЕсли;
		НомерСсылки = НомерСсылки + 1;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениям(МассивПредставлений)
	ОчиститьСтатическиеСсылкиНаОбъекты();
	Если Элементы.Найти("ГруппаСсылкиНаОбъекты") <> Неопределено Тогда
		Элементы.ГруппаСсылкиНаОбъекты.Видимость = Истина;
	КонецЕсли;
	НомерСсылки = 1;
	Для Каждого ПредставлениеОбъекта Из МассивПредставлений Цикл
		Если НомерСсылки > 5 Тогда
			Прервать;
		КонецЕсли;
		Если ПустаяСтрока(Строка(ПредставлениеОбъекта)) Тогда
			Продолжить;
		КонецЕсли;
		ИмяРеквизитаТекста = "ИзмененныйОбъектТекст" + Строка(НомерСсылки);
		ЭтотОбъект[ИмяРеквизитаТекста] = Строка(ПредставлениеОбъекта);
		ЭлементСсылки = Элементы.Найти(ИмяРеквизитаТекста);
		Если ЭлементСсылки <> Неопределено Тогда
			ЭлементСсылки.Заголовок = Строка(ПредставлениеОбъекта);
			ЭлементСсылки.Видимость = Ложь;
		КонецЕсли;
		ЭлементСсылкиПравая = Элементы.Найти("ИзмененныйОбъектСсылкаПравая" + Строка(НомерСсылки));
		Если ЭлементСсылкиПравая <> Неопределено Тогда
			ЭлементСсылкиПравая.Заголовок = Строка(ПредставлениеОбъекта);
			ЭлементСсылкиПравая.Видимость = Истина;
		КонецЕсли;
		ЭлементСсылкиФинальная = Элементы.Найти("ФинальныйИзмененныйОбъектСсылка" + Строка(НомерСсылки));
		Если ЭлементСсылкиФинальная <> Неопределено Тогда
			ЭлементСсылкиФинальная.Заголовок = Строка(ПредставлениеОбъекта);
			ЭлементСсылкиФинальная.Видимость = Ложь;
		КонецЕсли;
		НомерСсылки = НомерСсылки + 1;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениямНаКлиенте(МассивПредставлений, МассивНавигационныхСсылок = Неопределено)
	ИзмененныйОбъектТекст1 = "";
	ИзмененныйОбъектТекст2 = "";
	ИзмененныйОбъектТекст3 = "";
	ИзмененныйОбъектТекст4 = "";
	ИзмененныйОбъектТекст5 = "";
	ИзмененныеОбъектыТекст = "";
	ИзмененныйОбъектНав1 = "";
	ИзмененныйОбъектНав2 = "";
	ИзмененныйОбъектНав3 = "";
	ИзмененныйОбъектНав4 = "";
	ИзмененныйОбъектНав5 = "";
	СкрытьКнопкиИзмененныхОбъектов();
	Если Элементы.Найти("ГруппаСсылкиНаОбъекты") <> Неопределено Тогда
		Элементы.ГруппаСсылкиНаОбъекты.Видимость = Истина;
	КонецЕсли;

	Если МассивПредставлений = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерСсылки = 1;
	Для Каждого ПредставлениеОбъекта Из МассивПредставлений Цикл
		Если НомерСсылки > 5 Тогда
			Прервать;
		КонецЕсли;
		Если ПустаяСтрока(Строка(ПредставлениеОбъекта)) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИзмененныеОбъектыТекст) Тогда
			ИзмененныеОбъектыТекст = ИзмененныеОбъектыТекст + Символы.ПС;
		КонецЕсли;
		ИзмененныеОбъектыТекст = ИзмененныеОбъектыТекст + Строка(ПредставлениеОбъекта);
		НавигационнаяСсылка = "";
		Если МассивНавигационныхСсылок <> Неопределено И НомерСсылки <= МассивНавигационныхСсылок.Количество() Тогда
			НавигационнаяСсылка = Строка(МассивНавигационныхСсылок[НомерСсылки - 1]);
		КонецЕсли;
		Если НомерСсылки = 1 Тогда
			ИзмененныйОбъектТекст1 = Строка(ПредставлениеОбъекта);
			ИзмененныйОбъектНав1 = НавигационнаяСсылка;
			НастроитьГиперссылкуИзмененногоОбъекта("ИзмененныйОбъектТекст1", ИзмененныйОбъектТекст1);
		ИначеЕсли НомерСсылки = 2 Тогда
			ИзмененныйОбъектТекст2 = Строка(ПредставлениеОбъекта);
			ИзмененныйОбъектНав2 = НавигационнаяСсылка;
			НастроитьГиперссылкуИзмененногоОбъекта("ИзмененныйОбъектТекст2", ИзмененныйОбъектТекст2);
		ИначеЕсли НомерСсылки = 3 Тогда
			ИзмененныйОбъектТекст3 = Строка(ПредставлениеОбъекта);
			ИзмененныйОбъектНав3 = НавигационнаяСсылка;
			НастроитьГиперссылкуИзмененногоОбъекта("ИзмененныйОбъектТекст3", ИзмененныйОбъектТекст3);
		ИначеЕсли НомерСсылки = 4 Тогда
			ИзмененныйОбъектТекст4 = Строка(ПредставлениеОбъекта);
			ИзмененныйОбъектНав4 = НавигационнаяСсылка;
			НастроитьГиперссылкуИзмененногоОбъекта("ИзмененныйОбъектТекст4", ИзмененныйОбъектТекст4);
		ИначеЕсли НомерСсылки = 5 Тогда
			ИзмененныйОбъектТекст5 = Строка(ПредставлениеОбъекта);
			ИзмененныйОбъектНав5 = НавигационнаяСсылка;
			НастроитьГиперссылкуИзмененногоОбъекта("ИзмененныйОбъектТекст5", ИзмененныйОбъектТекст5);
		КонецЕсли;
		НомерСсылки = НомерСсылки + 1;
	КонецЦикла;
	Если Элементы.Найти("ИзмененныеОбъектыТекстПоле") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыТекстПоле.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыСписок") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыСписок.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтатическиеСсылкиНаОбъектыИзТекстаНаКлиенте(ТекстИзмененныхОбъектов)
	МассивПредставлений = Новый Массив;
	Если НЕ ПустаяСтрока(ТекстИзмененныхОбъектов) Тогда
		Для Каждого СтрокаОбъекта Из СтрРазделить(ТекстИзмененныхОбъектов, Символы.ПС) Цикл
			ПредставлениеОбъекта = СокрЛП(СтрокаОбъекта);
			Если НЕ ПустаяСтрока(ПредставлениеОбъекта) Тогда
				МассивПредставлений.Добавить(ПредставлениеОбъекта);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениямНаКлиенте(МассивПредставлений);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСсылкиНаОбъектыИзТекстаSummary(ТекстСообщения)
	Попытка
		Если ПустаяСтрока(ТекстСообщения) Тогда
			Возврат;
		КонецЕсли;
		Если СтрНайти(ТекстСообщения, "Созданные/измененные объекты:") = 0 Тогда
			Возврат;
		КонецЕсли;

		МассивПредставлений = Новый Массив;
		СтрокиСообщения = СтрРазделить(ТекстСообщения, Символы.ПС);
		ВнутриБлока = Ложь;
		Для Каждого СтрокаСообщения Из СтрокиСообщения Цикл
			ТекущаяСтрока = СокрЛП(СтрокаСообщения);
			Если СтрНайти(ТекущаяСтрока, "Созданные/измененные объекты:") > 0 Тогда
				ВнутриБлока = Истина;
				Продолжить;
			КонецЕсли;
			Если НЕ ВнутриБлока Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(ТекущаяСтрока)
				ИЛИ Лев(ТекущаяСтрока, 9) = "Проверка:"
				ИЛИ Лев(ТекущаяСтрока, 3) = "===" Тогда
				Прервать;
			КонецЕсли;
			Если Лев(ТекущаяСтрока, 1) = "-" Тогда
				ТекущаяСтрока = СокрЛП(Сред(ТекущаяСтрока, 2));
			КонецЕсли;
			Если НЕ ПустаяСтрока(ТекущаяСтрока) Тогда
				МассивПредставлений.Добавить(ТекущаяСтрока);
			КонецЕсли;
		КонецЦикла;

		Если МассивПредставлений.Количество() > 0 Тогда
			ЗаполнитьСтатическиеСсылкиНаОбъектыПоПредставлениямНаКлиенте(МассивПредставлений);
		КонецЕсли;
	Исключение
		ТекстОшибкиРазбораSummary = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СкрытьКнопкиИзмененныхОбъектов()
	Для НомерСсылки = 1 По 5 Цикл
		ЭлементСсылки = Элементы.Найти("ИзмененныйОбъектТекст" + Строка(НомерСсылки));
		Если ЭлементСсылки <> Неопределено Тогда
			ЭлементСсылки.Видимость = Ложь;
		КонецЕсли;
		ЭлементСсылкиПравая = Элементы.Найти("ИзмененныйОбъектСсылкаПравая" + Строка(НомерСсылки));
		Если ЭлементСсылкиПравая <> Неопределено Тогда
			ЭлементСсылкиПравая.Видимость = Ложь;
		КонецЕсли;
		ЭлементСсылкиФинальная = Элементы.Найти("ФинальныйИзмененныйОбъектСсылка" + Строка(НомерСсылки));
		Если ЭлементСсылкиФинальная <> Неопределено Тогда
			ЭлементСсылкиФинальная.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если Элементы.Найти("ЗаголовокСсылкиНаОбъектыПравая") <> Неопределено Тогда
		Элементы.ЗаголовокСсылкиНаОбъектыПравая.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыТекстПоле") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыТекстПоле.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыСписок") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыСписок.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьГиперссылкуИзмененногоОбъекта(ИмяСсылки, ЗаголовокСсылки)
	Если Элементы.Найти("ГруппаСсылкиНаОбъекты") <> Неопределено Тогда
		Элементы.ГруппаСсылкиНаОбъекты.Видимость = Истина;
	КонецЕсли;
	Если Элементы.Найти("ЗаголовокСсылкиНаОбъектыПравая") <> Неопределено Тогда
		Элементы.ЗаголовокСсылкиНаОбъектыПравая.Видимость = Истина;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыТекстПоле") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыТекстПоле.Видимость = Ложь;
	КонецЕсли;
	Если Элементы.Найти("ИзмененныеОбъектыСписок") <> Неопределено Тогда
		Элементы.ИзмененныеОбъектыСписок.Видимость = Ложь;
	КонецЕсли;
	ЭлементСсылки = Элементы.Найти(ИмяСсылки);
	Если ЭлементСсылки = Неопределено Тогда
		ЭлементСсылки = Элементы.Найти(СтрЗаменить(ИмяСсылки, "ИзмененныйОбъектТекст", "ИзмененныйОбъектСсылкаПравая"));
	КонецЕсли;
	Если ЭлементСсылки <> Неопределено Тогда
		ЭлементСсылки.Заголовок = ЗаголовокСсылки;
		ЭлементСсылки.Видимость = Ложь;
	КонецЕсли;
	ЭлементСсылкиПравая = Элементы.Найти(СтрЗаменить(ИмяСсылки, "ИзмененныйОбъектТекст", "ИзмененныйОбъектСсылкаПравая"));
	Если ЭлементСсылкиПравая <> Неопределено Тогда
		ЭлементСсылкиПравая.Заголовок = ЗаголовокСсылки;
		ЭлементСсылкиПравая.Видимость = Истина;
	КонецЕсли;
	Для НомерСсылки = 1 По 5 Цикл
		Если ИмяСсылки = "ИзмененныйОбъектТекст" + Строка(НомерСсылки) Тогда
			ЭлементСсылкиФинальная = Элементы.Найти("ФинальныйИзмененныйОбъектСсылка" + Строка(НомерСсылки));
			Если ЭлементСсылкиФинальная <> Неопределено Тогда
				ЭлементСсылкиФинальная.Заголовок = ЗаголовокСсылки;
				ЭлементСсылкиФинальная.Видимость = Ложь;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьИзмененныйОбъектДиалогаПоНомеру(НомерСсылки)
	Если ТекущийДиалог = Неопределено ИЛИ ТекущийДиалог.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	МассивСсылок = ИИА_Сервер.ПолучитьИзмененныеОбъектыДиалога(ТекущийДиалог);
	Если НомерСсылки < 1 ИЛИ НомерСсылки > МассивСсылок.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат МассивСсылок[НомерСсылки - 1];
КонецФункции

&НаСервере
Функция ПолучитьНавигационнуюСсылкуИзмененногоОбъектаДиалогаПоНомеру(НомерСсылки)
	СсылкаНаОбъект = ПолучитьИзмененныйОбъектДиалогаПоНомеру(НомерСсылки);
	Если НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат "";
	КонецЕсли;

	НавигационнаяСсылка = "";
	Попытка
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект);
	Исключение
		НавигационнаяСсылка = "";
	КонецПопытки;
	Возврат НавигационнаяСсылка;
КонецФункции

&НаСервере
Функция ПолучитьНавигационнуюСсылкуОбъектаНаСервере(СсылкаНаОбъект)
	Если НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ПолучитьНавигационнуюСсылку(СсылкаНаОбъект);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ИзмененныеОбъектыСписокПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;

	НавигационнаяСсылка = ПолучитьНавигационнуюСсылкуОбъектаНаСервере(ТекущиеДанные.СсылкаНаОбъект);
	Если НЕ ПустаяСтрока(НавигационнаяСсылка) Тогда
		ПерейтиПоНавигационнойСсылке(НавигационнаяСсылка);
	Иначе
		СтрокаСтатуса = "Не удалось открыть объект";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзмененныйОбъектНажатие(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерСсылки = 0;
	Если ИмяЭлемента = "ИзмененныйОбъектТекст1" ИЛИ ИмяЭлемента = "ИзмененныйОбъектСсылкаПравая1" ИЛИ ИмяЭлемента = "ФинальныйИзмененныйОбъектСсылка1" Тогда
		НомерСсылки = 1;
	ИначеЕсли ИмяЭлемента = "ИзмененныйОбъектТекст2" ИЛИ ИмяЭлемента = "ИзмененныйОбъектСсылкаПравая2" ИЛИ ИмяЭлемента = "ФинальныйИзмененныйОбъектСсылка2" Тогда
		НомерСсылки = 2;
	ИначеЕсли ИмяЭлемента = "ИзмененныйОбъектТекст3" ИЛИ ИмяЭлемента = "ИзмененныйОбъектСсылкаПравая3" ИЛИ ИмяЭлемента = "ФинальныйИзмененныйОбъектСсылка3" Тогда
		НомерСсылки = 3;
	ИначеЕсли ИмяЭлемента = "ИзмененныйОбъектТекст4" ИЛИ ИмяЭлемента = "ИзмененныйОбъектСсылкаПравая4" ИЛИ ИмяЭлемента = "ФинальныйИзмененныйОбъектСсылка4" Тогда
		НомерСсылки = 4;
	ИначеЕсли ИмяЭлемента = "ИзмененныйОбъектТекст5" ИЛИ ИмяЭлемента = "ИзмененныйОбъектСсылкаПравая5" ИЛИ ИмяЭлемента = "ФинальныйИзмененныйОбъектСсылка5" Тогда
		НомерСсылки = 5;
	КонецЕсли;

	Если НомерСсылки = 0 Тогда
		Возврат;
	КонецЕсли;

	ОткрытьИзмененныйОбъектПоНомеру(НомерСсылки);
КонецПроцедуры

