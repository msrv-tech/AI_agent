&НаКлиенте
Процедура ПопытатьсяПоказатьТабличныйДокумент(ЛогироватьПропуск = Ложь)

	Если ТекущийДиалог = Неопределено Или ТекущийДиалог.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Если ИИА_ВызовСервера.ЭтоДиалогЗапрос1С(ТекущийДиалог) Тогда
		ОбновитьСсылкуНаТабличныйДокументНаФорме();
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеДляТаблицы = ИИА_ВызовСервера.ПолучитьНепоказанныеДанныеЗапроса(ТекущийДиалог);
		Если ДанныеДляТаблицы = Неопределено Тогда
			Возврат;
		КонецЕсли;

		СоздатьИОткрытьТабличныйДокумент(ДанныеДляТаблицы);
	Исключение
		// Не скрываем ошибку: выводим пользователю
		Сообщить("Ошибка при получении данных запроса для ТабличногоДокумента: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗапросПодтверждения(ДанныеСообщения)
	СостояниеПодтверждения = Неопределено;
	Если ДанныеСообщения.Свойство("ApprovalState") И ТипЗнч(ДанныеСообщения.ApprovalState) = Тип("Структура") Тогда
		СостояниеПодтверждения = ДанныеСообщения.ApprovalState;
	Иначе
		СостояниеПодтверждения = ИИА_ВызовСервера.ПолучитьСостояниеПодтверждения(ТекущийДиалог);
	КонецЕсли;

	Если СостояниеПодтверждения = Неопределено
		ИЛИ НЕ СостояниеПодтверждения.Свойство("status")
		ИЛИ ВРег(Строка(СостояниеПодтверждения.status)) <> "PENDING" Тогда
		Возврат;
	КонецЕсли;

	КлючПодтверждения = "";
	Если СостояниеПодтверждения.Свойство("requested_at") И СостояниеПодтверждения.requested_at <> Неопределено Тогда
		КлючПодтверждения = Формат(СостояниеПодтверждения.requested_at, "ДФ=yyyyMMddHHmmss");
	Иначе
		КлючПодтверждения = Строка(ТекущийДиалог.УникальныйИдентификатор());
	КонецЕсли;
	Если ЭтотОбъект.ПоследнийКлючПодтверждения = КлючПодтверждения Тогда
		ОбновитьПанельПодтверждения();
		Возврат;
	КонецЕсли;
	ЭтотОбъект.ПоследнийКлючПодтверждения = КлючПодтверждения;
	ОбновитьПанельПодтверждения();
	СтрокаСтатуса = "Требуется подтверждение действия";
	ОбновитьОтображениеРеквизитов();
	ОткрытьОкноПодтвержденияДействия();
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьДействие(Команда)
	Если ТекущийДиалог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьОкноПодтвержденияДействия();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОкноПодтвержденияДействия()
	ТекстОкна = ПолучитьПолныйТекстПодтвержденияДляОкна();
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстПодтверждения", ТекстОкна);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОкнаПодтвержденияДействия", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ИИА_ПодтверждениеДействия", ПараметрыФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПодтвержденияДействия(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьПодтверждениеДействия();
	Иначе
		СтрокаСтатуса = "Подтверждение не выполнено";
		ОбновитьОтображениеРеквизитов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОкнаПодтвержденияДействия(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если РезультатЗакрытия = "approve" Тогда
		ВыполнитьПодтверждениеДействия();
	ИначеЕсли РезультатЗакрытия = "reject" Тогда
		ОтклонитьДействие(Неопределено);
	ИначеЕсли РезультатЗакрытия = "approve_without_confirmation" Тогда
		БезПодтверждения(Неопределено);
	Иначе
		СтрокаСтатуса = "Подтверждение не выполнено";
		ОбновитьОтображениеРеквизитов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПодтверждениеДействия()
	Если ТекущийДиалог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ИИА_ВызовСервера.ОркестраторПодтвердитьОжидающееДействие(ТекущийДиалог) Тогда
		ЗапуститьОркестратор();
		СтрокаСтатуса = "Подтверждено, продолжаю выполнение...";
		ЭтотОбъект.ПоследнийКлючПодтверждения = "";
	Иначе
		СтрокаСтатуса = "Не удалось подтвердить выполнение";
	КонецЕсли;
	ОбновитьПанельПодтверждения();
	ОбновитьОтображениеРеквизитов();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПолныйТекстПодтвержденияДляОкна()
	ТекстОкна = ТекстПодтверждения;
	Попытка
		СостояниеПодтверждения = ИИА_ВызовСервера.ПолучитьСостояниеПодтверждения(ТекущийДиалог);
		Если СостояниеПодтверждения <> Неопределено Тогда
			Если СостояниеПодтверждения.Свойство("preview") И НЕ ПустаяСтрока(Строка(СостояниеПодтверждения.preview)) Тогда
				ТекстОкна = Строка(СостояниеПодтверждения.preview);
			КонецЕсли;
			Если СтрНайти(ТекстОкна, "DSL preview:") > 0
				И СостояниеПодтверждения.Свойство("planned_dsl")
				И НЕ ПустаяСтрока(Строка(СостояниеПодтверждения.planned_dsl)) Тогда
				ТекстОкна = СформироватьPreviewПодтвержденияНаСервере(Строка(СостояниеПодтверждения.planned_dsl));
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если ПустаяСтрока(СокрЛП(ТекстОкна)) Тогда
		ТекстОкна = "Подтвердите выполнение действий.";
	КонецЕсли;
	Возврат Лев(ТекстОкна, 4000);
КонецФункции

&НаКлиенте
