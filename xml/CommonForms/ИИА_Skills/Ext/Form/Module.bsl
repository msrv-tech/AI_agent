&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьСписокНаСервере();
	НовыйНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокНаСервере()
	
	Скилы.Загрузить(ИИА_Skills.ПолучитьСписокСкиловДляФормы());
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьСкилВСпискеНаСервере(ИмяСкила)

	Если ПустаяСтрока(ИмяСкила) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаСкила Из Скилы Цикл
		Если СтрокаСкила.Имя = ИмяСкила Тогда
			Элементы.Скилы.ТекущаяСтрока = СтрокаСкила.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура НовыйНаСервере()
	
	ЗагрузитьКарточкуВФорму(ИИА_Skills.НоваяКарточкаСкила());
	ОписаниеЗадачи = "";
	ТестовыйЗапрос = "";
	РезультатТеста = "";
	
КонецПроцедуры

&НаСервере
Функция НовыйJSONСкилаНаСервере()

	Возврат ИИА_Skills.КарточкаВJSON(ИИА_Skills.НоваяКарточкаСкила());

КонецФункции

&НаСервере
Процедура ЗагрузитьКарточкуНаСервере(ИмяСкила)
	
	Карточка = ИИА_Skills.ПолучитьКарточкуСкила(ИмяСкила);
	ЗагрузитьКарточкуВФорму(Карточка);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКарточкуВФорму(Карточка)
	
	Имя = Карточка.Имя;
	Заголовок = Карточка.Заголовок;
	Описание = Карточка.Описание;
	Владелец = Карточка.Владелец;
	ОбластьВидимости = Карточка.ОбластьВидимости;
	Активен = Карточка.Активен;
	Версия = Карточка.Версия;
	Триггеры = Карточка.Триггеры;
	ТипыДиалогов = Карточка.ТипыДиалогов;
	ЦелевойОбъектТип = Карточка.ЦелевойОбъектТип;
	ЦелевойОбъектИмя = Карточка.ЦелевойОбъектИмя;
	Инструкция = Карточка.Инструкция;
	WorkflowJSON = Карточка.WorkflowJSON;
	PolicyJSON = Карточка.PolicyJSON;
	Enforcement = Карточка.Enforcement;
	Риск = Карточка.Риск;
	ТребоватьПодтверждение = Карточка.ТребоватьПодтверждение;
	SkillJSON = ИИА_Skills.КарточкаВJSON(Карточка);
	РезультатТеста = "";
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКарточкуИзФормы()
	
	Если НЕ ПустаяСтрока(SkillJSON) Тогда
		Возврат ИИА_Skills.КарточкаИзJSON(SkillJSON);
	КонецЕсли;
	
	Карточка = Новый Структура;
	Карточка.Вставить("Имя", Имя);
	Карточка.Вставить("Заголовок", Заголовок);
	Карточка.Вставить("Описание", Описание);
	Карточка.Вставить("Владелец", Владелец);
	Карточка.Вставить("ОбластьВидимости", ОбластьВидимости);
	Карточка.Вставить("Активен", Активен);
	Карточка.Вставить("Версия", Версия);
	Карточка.Вставить("Триггеры", Триггеры);
	Карточка.Вставить("ТипыДиалогов", ТипыДиалогов);
	Карточка.Вставить("ЦелевойОбъектТип", ЦелевойОбъектТип);
	Карточка.Вставить("ЦелевойОбъектИмя", ЦелевойОбъектИмя);
	Карточка.Вставить("Инструкция", Инструкция);
	Карточка.Вставить("WorkflowJSON", WorkflowJSON);
	Карточка.Вставить("PolicyJSON", PolicyJSON);
	Карточка.Вставить("Enforcement", Enforcement);
	Карточка.Вставить("Риск", Риск);
	Карточка.Вставить("ТребоватьПодтверждение", ТребоватьПодтверждение);
	Возврат Карточка;
	
КонецФункции

&НаСервере
Функция СохранитьНаСервере()
	
	Карточка = ПолучитьКарточкуИзФормы();
	ИИА_Skills.СохранитьПользовательскийСкил(Карточка);
	СохраненноеИмя = Карточка.Имя;
	ОбновитьСписокНаСервере();
	Если НЕ ПустаяСтрока(СохраненноеИмя) Тогда
		ВыбратьСкилВСпискеНаСервере(СохраненноеИмя);
		ЗагрузитьКарточкуНаСервере(СохраненноеИмя);
	КонецЕсли;
	Возврат Новый Структура("Имя,JSON", СохраненноеИмя, SkillJSON);
	
КонецФункции

&НаСервере
Процедура УдалитьНаСервере()
	
	Карточка = ПолучитьКарточкуИзФормы();
	Если Карточка.Владелец = "system" Тогда
		ВызватьИсключение "Системный skill нельзя удалить.";
	КонецЕсли;
	ИИА_Skills.УдалитьПользовательскийСкил(Карточка.Имя);
	ОбновитьСписокНаСервере();
	НовыйНаСервере();
	
КонецПроцедуры

&НаСервере
Функция СгенерироватьJSONНаСервере(ТекстОписания)
	
	Если ПустаяСтрока(ТекстОписания) Тогда
		ВызватьИсключение "Опишите задачу для генерации skill.";
	КонецЕсли;
	
	Карточка = ИИА_Skills.СформироватьЧерновикСкилаИзОписания(ТекстОписания);
	Возврат ИИА_Skills.КарточкаВJSON(Карточка);
	
КонецФункции

&НаСервере
Процедура ЗапуститьТестНаСервере()
	
	Результат = ИИА_Skills.ПротестироватьJSONСкила(SkillJSON, ТестовыйЗапрос);
	РезультатТеста = "matched: " + ?(Результат.matched, "true", "false") + Символы.ПС
		+ "score: " + Строка(Результат.score) + Символы.ПС
		+ "name: " + Результат.name + Символы.ПС
		+ "title: " + Результат.title + Символы.ПС
		+ "has_dsl_template: " + ?(Результат.has_dsl_template, "true", "false") + Символы.ПС
		+ "dsl_template_mode: " + Результат.dsl_template_mode;
	
КонецПроцедуры

&НаКлиенте
Процедура СкилыПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьКарточкуНаСервере(ТекущиеДанные.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйСкилОбработка(Команда)

	SkillJSON = НовыйJSONСкилаНаСервере();
	ОписаниеЗадачи = "";
	ТестовыйЗапрос = "";
	РезультатТеста = "";

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОбработка(Команда)
	
	ОбновитьСписокНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеЗадачиПриИзменении(Элемент)
	
	// Нужен веб-клиенту 1С, чтобы зафиксировать длинный текст перед серверной генерацией.
	
КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьJSONОбработка(Команда)
	
	Попытка
		SkillJSON = СгенерироватьJSONНаСервере(ОписаниеЗадачи);
		РезультатТеста = "";
		Сообщить("JSON skill сгенерирован.");
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьТестОбработка(Команда)
	
	Попытка
		ЗапуститьТестНаСервере();
		Если НЕ ПустаяСтрока(РезультатТеста) Тогда
			Сообщить("Skill test: " + СтрЗаменить(РезультатТеста, Символы.ПС, "; "));
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОбработка(Команда)
	
	Попытка
		РезультатСохранения = СохранитьНаСервере();
		SkillJSON = РезультатСохранения.JSON;
		Сообщить("Skill сохранен.");
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбработка(Команда)
	
	Попытка
		УдалитьНаСервере();
		Сообщить("Skill удален.");
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
