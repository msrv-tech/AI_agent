#Область ПрограммныйИнтерфейс

Функция ВыполнитьCreateReference(Шаг, КонтекстВыполнения) Экспорт
	Результат = СоздатьБазовыйРезультатШага("CreateReference", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("CreateReference"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	ИмяСправочника = ИИА_DSLQuerySafety.РазрешитьИмяСправочника(Шаг.object_name, КонтекстВыполнения);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Результат.Сообщение = "Справочник '" + Шаг.object_name + "' не найден";
		УстановитьТипизированнуюОшибку(Результат, "object_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("object_type,object_name", "Справочник", Шаг.object_name));
		Возврат Результат;
	КонецЕсли;
	МенеджерСправочника = Справочники[ИмяСправочника];
	Если МенеджерСправочника = Неопределено Тогда
		Результат.Сообщение = "Не удалось получить менеджер справочника '" + ИмяСправочника + "'";
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_getmetadata", Новый Структура("object_type,object_name", "Справочник", ИмяСправочника));
		Возврат Результат;
	КонецЕсли;
	Если Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") Тогда
		СуществующаяСсылкаПоДанным = НайтиСуществующуюСсылкуСправочникаПоДанным(ИмяСправочника, Шаг.data);
		Если ЗначениеЗаполнено(СуществующаяСсылкаПоДанным) Тогда
			СуществующийОбъект = СуществующаяСсылкаПоДанным.ПолучитьОбъект();
			КонтекстВыполнения.Вставить("ТекущийОбъект", СуществующийОбъект);
			КонтекстВыполнения.Вставить("ТипОбъекта", "Справочник");
			КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяСправочника);
			УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Справочник", ИмяСправочника, СуществующийОбъект);
			Результат.Успех = Истина;
			Результат.Сообщение = "Элемент справочника '" + ИмяСправочника + "' уже существует, дубль не создавался";
			Результат.Данные = СуществующаяСсылкаПоДанным;
			КонтекстВыполнения.Вставить("СсылкаОбъекта", СуществующаяСсылкаПоДанным);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	НаименованиеДляПоиска = "";
	Если Шаг.Свойство("name") Тогда
		НаименованиеДляПоиска = СокрЛП(Строка(Шаг.name));
	КонецЕсли;
	Если ПустаяСтрока(НаименованиеДляПоиска) И Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") И Шаг.data.Свойство("Наименование") Тогда
		НаименованиеДляПоиска = СокрЛП(Строка(Шаг.data.Наименование));
	КонецЕсли;
	Если НЕ ПустаяСтрока(НаименованиеДляПоиска) Тогда
		СуществующаяСсылка = МенеджерСправочника.НайтиПоНаименованию(НаименованиеДляПоиска);
		Если ЗначениеЗаполнено(СуществующаяСсылка) Тогда
			СуществующийОбъект = СуществующаяСсылка.ПолучитьОбъект();
			КонтекстВыполнения.Вставить("ТекущийОбъект", СуществующийОбъект);
			КонтекстВыполнения.Вставить("ТипОбъекта", "Справочник");
			КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяСправочника);
			УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Справочник", ИмяСправочника, СуществующийОбъект);
			Результат.Успех = Истина;
			Результат.Сообщение = "Элемент справочника '" + ИмяСправочника + "' уже существует, дубль не создавался";
			Результат.Данные = СуществующаяСсылка;
			КонтекстВыполнения.Вставить("СсылкаОбъекта", СуществующаяСсылка);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	НовыйЭлемент = МенеджерСправочника.СоздатьЭлемент();
	КонтекстВыполнения.Вставить("ТекущийОбъект", НовыйЭлемент);
	КонтекстВыполнения.Вставить("ТипОбъекта", "Справочник");
	КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяСправочника);
	УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Справочник", ИмяСправочника, НовыйЭлемент);
	Если Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") Тогда
		Для Каждого ПараКлючЗначение Из Шаг.data Цикл
			Если НЕ ИИА_Метаданные.СуществуетРеквизитСправочника(ИмяСправочника, ПараКлючЗначение.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ЗначениеДляУстановки = ПодготовитьЗначениеДляУстановкиРеквизита(КонтекстВыполнения, ПараКлючЗначение.Ключ, ПараКлючЗначение.Значение);
				УстановитьЗначениеРеквизита(НовыйЭлемент, ПараКлючЗначение.Ключ, ЗначениеДляУстановки);
				ПроверитьЧтоСсылочныйРеквизитЗаполнен(НовыйЭлемент, КонтекстВыполнения, ПараКлючЗначение.Ключ, ЗначениеДляУстановки);
				ДобавитьИзмененноеПоле(КонтекстВыполнения, ПараКлючЗначение.Ключ, ЗначениеДляУстановки);
			Исключение
				Результат.Сообщение = "Ошибка установки поля '" + ПараКлючЗначение.Ключ + "': " + ОписаниеОшибки();
				УстановитьТипизированнуюОшибку(Результат, "field_write_error", "validation", Истина, "run_getobjectfields", Новый Структура("object_name,field", ИмяСправочника, ПараКлючЗначение.Ключ));
				Возврат Результат;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Сообщение = "Создан элемент справочника '" + ИмяСправочника + "'";
	Результат.Данные = НовыйЭлемент.Ссылка;
	КонтекстВыполнения.Вставить("СсылкаОбъекта", НовыйЭлемент.Ссылка);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "draft_created", "CreateReference", OperationId);
	Возврат Результат;
КонецФункции

Функция ПодобратьДокументПоступленияПоКонтекстуЗадачи(ИмяДокумента, КонтекстВыполнения)
	Имя = СокрЛП(Строка(ИмяДокумента));
	Если КонтекстВыполнения = Неопределено Или ТипЗнч(КонтекстВыполнения) <> Тип("Структура") Тогда
		Возврат Имя;
	КонецЕсли;
	Если НЕ КонтекстВыполнения.Свойство("СсылкаДиалога") Или НЕ ЗначениеЗаполнено(КонтекстВыполнения.СсылкаДиалога) Тогда
		Возврат Имя;
	КонецЕсли;
	ПоследняяЗадача = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(КонтекстВыполнения.СсылкаДиалога);
	Если ПоследняяЗадача = Неопределено Или НЕ ПоследняяЗадача.Свойство("Найдено") Или НЕ ПоследняяЗадача.Найдено Тогда
		Возврат Имя;
	КонецЕсли;
	ТекстЗадачи = ВРег(Строка(ПоследняяЗадача.Текст));
	Если СтрНайти(ТекстЗадачи, "ПРИХОДН") = 0 И СтрНайти(ТекстЗадачи, "ПОСТУПЛЕН") = 0 Тогда
		Возврат Имя;
	КонецЕсли;
	ИмяВРег = ВРег(Имя);
	ЭтоЧужойДокумент = СтрНайти(ИмяВРег, "ЗАКАЗ") > 0
		Или СтрНайти(ИмяВРег, "РЕАЛИЗАЦ") > 0
		Или СтрНайти(ИмяВРег, "РАСХОДН") > 0
		Или ПустаяСтрока(Имя);
	Если НЕ ЭтоЧужойДокумент Тогда
		Возврат Имя;
	КонецЕсли;
	Канон = ИИА_DSLПостроитель.НайтиДокументПоступленияТоваров();
	Если ПустаяСтрока(Канон) Тогда
		Возврат Имя;
	КонецЕсли;
	ПозТочки = СтрНайти(Канон, ".");
	Если ПозТочки > 0 Тогда
		Возврат Сред(Канон, ПозТочки + 1);
	КонецЕсли;
	Возврат Канон;
КонецФункции

Функция ВыполнитьCreateDocument(Шаг, КонтекстВыполнения) Экспорт
	Результат = СоздатьБазовыйРезультатШага("CreateDocument", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("CreateDocument"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	ИмяДокументаИсходное = "";
	Если Шаг.Свойство("object_name") Тогда
		ИмяДокументаИсходное = Строка(Шаг.object_name);
	КонецЕсли;
	Если ПустаяСтрока(ИмяДокументаИсходное) И Шаг.Свойство("object") Тогда
		ИмяДокументаИсходное = Строка(Шаг.object);
	КонецЕсли;
	ИмяДокументаИсходное = ПодобратьДокументПоступленияПоКонтекстуЗадачи(ИмяДокументаИсходное, КонтекстВыполнения);
	ИмяДокумента = ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(ИмяДокументаИсходное, "Документ");
	МенеджерДокумента = Документы[ИмяДокумента];
	Если МенеджерДокумента = Неопределено Тогда
		Результат.Сообщение = "Не удалось получить менеджер документа '" + ИмяДокумента + "'";
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_getmetadata", Новый Структура("object_type,object_name", "Документ", ИмяДокумента));
		Возврат Результат;
	КонецЕсли;
	НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
	КонтекстВыполнения.Вставить("ТекущийОбъект", НовыйДокумент);
	КонтекстВыполнения.Вставить("ТипОбъекта", "Документ");
	КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяДокумента);
	УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Документ", ИмяДокумента, НовыйДокумент);
	ДанныеДляУстановки = Новый Структура;
	Если Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") Тогда
		Для Каждого ПараКлючЗначение Из Шаг.data Цикл
			ДанныеДляУстановки.Вставить(ПараКлючЗначение.Ключ, ПараКлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ДанныеДляУстановки.Свойство("ДокументОснование")
		И ИИА_Метаданные.СуществуетРеквизитДокумента(ИмяДокумента, "ДокументОснование") Тогда
		Попытка
			ЗначениеОснования = ПодготовитьЗначениеДляУстановкиРеквизита(КонтекстВыполнения, "ДокументОснование", ДанныеДляУстановки.ДокументОснование);
			Если ЗначениеЗаполнено(ЗначениеОснования) Тогда
				НовыйДокумент.Заполнить(ЗначениеОснования);
			КонецЕсли;
		Исключение
			// Не все документы поддерживают заполнение по основанию; ниже попробуем обычную установку реквизита.
		КонецПопытки;
	КонецЕсли;
	Попытка
		Если НЕ ЗначениеЗаполнено(НовыйДокумент.Дата) Тогда
			НовыйДокумент.Дата = ТекущаяДата();
		КонецЕсли;
	Исключение
		// Стандартный реквизит Дата есть у документов; если его нет — пропускаем.
	КонецПопытки;
	Если НЕ ДанныеДляУстановки.Свойство("Дата") Тогда
		ДанныеДляУстановки.Вставить("Дата", ТекущаяДата());
	КонецЕсли;
	Если ДанныеДляУстановки.Количество() > 0 Тогда
		Для Каждого ПараКлючЗначение Из ДанныеДляУстановки Цикл
			Если НЕ ИИА_Метаданные.СуществуетРеквизитДокумента(ИмяДокумента, ПараКлючЗначение.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Если НужноОтложитьАвтозаполнениеОрганизацииДоЗаписи(КонтекстВыполнения, ПараКлючЗначение.Ключ, ПараКлючЗначение.Значение) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ЗначениеДляУстановки = ПодготовитьЗначениеДляУстановкиРеквизита(КонтекстВыполнения, ПараКлючЗначение.Ключ, ПараКлючЗначение.Значение);
				УстановитьЗначениеРеквизита(НовыйДокумент, ПараКлючЗначение.Ключ, ЗначениеДляУстановки);
				Если ЭтоНезаполненныйСсылочныйРеквизит(НовыйДокумент, КонтекстВыполнения, ПараКлючЗначение.Ключ) Тогда
					Продолжить;
				КонецЕсли;
				ПроверитьЧтоСсылочныйРеквизитЗаполнен(НовыйДокумент, КонтекстВыполнения, ПараКлючЗначение.Ключ, ЗначениеДляУстановки);
				ДобавитьИзмененноеПоле(КонтекстВыполнения, ПараКлючЗначение.Ключ, ЗначениеДляУстановки);
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Сообщение = "Создан документ '" + ИмяДокумента + "'";
	Результат.Данные = НовыйДокумент.Ссылка;
	КонтекстВыполнения.Вставить("СсылкаОбъекта", НовыйДокумент.Ссылка);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "draft_created", "CreateDocument", OperationId);
	Возврат Результат;
КонецФункции

Функция ВыполнитьSetField(Шаг, КонтекстВыполнения) Экспорт
	Результат = СоздатьБазовыйРезультатШага("SetField", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("SetField"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	Если НЕ КонтекстВыполнения.Свойство("ТекущийОбъект") Тогда
		Результат.Сообщение = "Нет текущего объекта для установки поля. Используйте CreateReference, CreateDocument или FindReferenceByName перед SetField";
		УстановитьТипизированнуюОшибку(Результат, "missing_object_context", "validation", Ложь, "select_or_create_object_first", Новый Структура("action", "SetField"));
		Возврат Результат;
	КонецЕсли;
	ТекущийОбъект = КонтекстВыполнения.ТекущийОбъект;
	ТипОбъекта = КонтекстВыполнения.ТипОбъекта;
	ИмяОбъекта = КонтекстВыполнения.ИмяОбъекта;
	Если Шаг.Свойство("field") Тогда
		ИмяПоля = Шаг.field;
	ИначеЕсли Шаг.Свойство("field_name") Тогда
		ИмяПоля = Шаг.field_name;
	Иначе
		Результат.Сообщение = "Поле field или field_name не указано";
		Результат.missing_parameters.Добавить("field");
		УстановитьТипизированнуюОшибку(Результат, "parameter_missing", "validation", Ложь, "provide_field_name", Новый Структура("action", "SetField"));
		Возврат Результат;
	КонецЕсли;
	Если ИмяПоля = "ПометкаНаУдаление" Тогда
		ИмяПоля = "ПометкаУдаления";
	ИначеЕсли ИмяПоля = "Description" Тогда
		ИмяПоля = "Наименование";
	КонецЕсли;
	ИмяПоля = ПодобратьИмяРеквизитаОбъекта(ТипОбъекта, ИмяОбъекта, ИмяПоля);
	Если ПустаяСтрока(ИмяПоля) Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = "Реквизит отсутствует в объекте '" + ИмяОбъекта + "', поле пропущено";
		Возврат Результат;
	КонецЕсли;
	Попытка
		ЗначениеДляУстановки = ПодготовитьЗначениеДляУстановкиРеквизита(КонтекстВыполнения, ИмяПоля, Шаг.value);
		Если ЗначениеДляУстановки = Неопределено Тогда
			Результат.Успех = Истина;
			Результат.Сообщение = "Реквизит '" + ИмяПоля + "' пропущен: значение не разрешено";
			Возврат Результат;
		КонецЕсли;
		УстановитьЗначениеРеквизита(ТекущийОбъект, ИмяПоля, ЗначениеДляУстановки);
		Если СтрНайти(ВРег(ИмяПоля), "НАИМЕНОВАН") > 0 И ВРег(ИмяПоля) <> "НАИМЕНОВАНИЕ" Тогда
			Попытка
				Если ПустаяСтрока(СокрЛП(Строка(ТекущийОбъект.Наименование))) Тогда
					УстановитьЗначениеРеквизита(ТекущийОбъект, "Наименование", ЗначениеДляУстановки);
					ДобавитьИзмененноеПоле(КонтекстВыполнения, "Наименование", ЗначениеДляУстановки);
				КонецЕсли;
			Исключение
				// У объекта может не быть стандартного реквизита Наименование.
			КонецПопытки;
		КонецЕсли;
		Если ЭтоНезаполненныйСсылочныйРеквизит(ТекущийОбъект, КонтекстВыполнения, ИмяПоля) Тогда
			Результат.Успех = Истина;
			Результат.Сообщение = "Реквизит '" + ИмяПоля + "' пропущен: ссылочное значение не заполнено";
			Возврат Результат;
		КонецЕсли;
		ПроверитьЧтоСсылочныйРеквизитЗаполнен(ТекущийОбъект, КонтекстВыполнения, ИмяПоля, ЗначениеДляУстановки);
		ДобавитьИзмененноеПоле(КонтекстВыполнения, ИмяПоля, ЗначениеДляУстановки);
	Исключение
		Результат.Успех = Истина;
		Результат.Сообщение = "Реквизит '" + ИмяПоля + "' пропущен: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Сообщение = "Установлено значение поля '" + ИмяПоля + "'";
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "field_set", "SetField", OperationId);
	Возврат Результат;
КонецФункции

Функция ВыполнитьAddTableRow(Шаг, КонтекстВыполнения) Экспорт
	Результат = СоздатьБазовыйРезультатШага("AddTableRow", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("AddTableRow"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	Если НЕ КонтекстВыполнения.Свойство("ТекущийОбъект") Тогда
		Результат.Сообщение = "Нет текущего объекта для добавления строки табличной части. Используйте CreateDocument перед AddTableRow";
		УстановитьТипизированнуюОшибку(Результат, "missing_object_context", "validation", Ложь, "create_document_first", Новый Структура("action", "AddTableRow"));
		Возврат Результат;
	КонецЕсли;
	Если НЕ КонтекстВыполнения.Свойство("ТипОбъекта") ИЛИ КонтекстВыполнения.ТипОбъекта <> "Документ" Тогда
		Результат.Сообщение = "AddTableRow поддерживает только документы";
		УстановитьТипизированнуюОшибку(Результат, "unsupported_object_type", "validation", Ложь, "use_document_context", Новый Структура("action", "AddTableRow"));
		Возврат Результат;
	КонецЕсли;
	ИмяТабличнойЧасти = "";
	Если Шаг.Свойство("table") Тогда
		ИмяТабличнойЧасти = Строка(Шаг.table);
	ИначеЕсли Шаг.Свойство("table_name") Тогда
		ИмяТабличнойЧасти = Строка(Шаг.table_name);
	КонецЕсли;
	ИмяТабличнойЧасти = НормализоватьИмяТабличнойЧастиДокумента(КонтекстВыполнения.ИмяОбъекта, ИмяТабличнойЧасти);
	Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
		Результат.Сообщение = "Табличная часть не найдена в документе '" + КонтекстВыполнения.ИмяОбъекта + "'";
		УстановитьТипизированнуюОшибку(Результат, "table_part_not_found", "metadata", Истина, "run_getobjectfields", Новый Структура("object_name", КонтекстВыполнения.ИмяОбъекта));
		Возврат Результат;
	КонецЕсли;
	Если НЕ Шаг.Свойство("data") ИЛИ ТипЗнч(Шаг.data) <> Тип("Структура") Тогда
		Результат.Сообщение = "AddTableRow требует data как JSON-объект";
		УстановитьТипизированнуюОшибку(Результат, "parameter_missing", "validation", Ложь, "provide_data_object", Новый Структура("action", "AddTableRow"));
		Возврат Результат;
	КонецЕсли;
	Попытка
		НоваяСтрока = КонтекстВыполнения.ТекущийОбъект[ИмяТабличнойЧасти].Добавить();
		ЗаполненоПолей = 0;
		Для Каждого ПараКлючЗначение Из Шаг.data Цикл
			ИмяКолонки = НормализоватьИмяКолонкиТабличнойЧасти(КонтекстВыполнения.ИмяОбъекта, ИмяТабличнойЧасти, Строка(ПараКлючЗначение.Ключ));
			Если ПустаяСтрока(ИмяКолонки) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ТипКолонки = ПолучитьТипКолонкиТабличнойЧасти(КонтекстВыполнения.ИмяОбъекта, ИмяТабличнойЧасти, ИмяКолонки);
				ЗначениеКолонки = ПодготовитьЗначениеДляУстановкиКолонкиТЧ(ТипКолонки, ПараКлючЗначение.Значение);
				НоваяСтрока[ИмяКолонки] = ЗначениеКолонки;
				ЗаполненоПолей = ЗаполненоПолей + 1;
			Исключение
				// Для распознанных документов не срываем строку из-за одной неподходящей колонки.
			КонецПопытки;
		КонецЦикла;
	Исключение
		Результат.Сообщение = "Ошибка добавления строки табличной части '" + ИмяТабличнойЧасти + "': " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "table_row_write_error", "validation", Истина, "run_getobjectfields", Новый Структура("object_name,table", КонтекстВыполнения.ИмяОбъекта, ИмяТабличнойЧасти));
		Возврат Результат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Сообщение = "Добавлена строка табличной части '" + ИмяТабличнойЧасти + "', заполнено полей: " + Строка(ЗаполненоПолей);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "table_row_added", "AddTableRow", OperationId);
	Возврат Результат;
КонецФункции

Функция ВыполнитьWrite(Шаг, КонтекстВыполнения) Экспорт
	Результат = СоздатьБазовыйРезультатШага("Write", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("Write"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	Если НЕ КонтекстВыполнения.Свойство("ТекущийОбъект") Тогда
		Если НЕ ПустаяСтрока(OperationId)
			И КонтекстВыполнения.Свойство("СсылкаДиалога")
			И ЗначениеЗаполнено(КонтекстВыполнения.СсылкаДиалога) Тогда
			ПоследнийЭффект = ИИА_ReplayPolicy.НайтиПоследнийSideEffectПоOperationId(КонтекстВыполнения.СсылкаДиалога, OperationId);
			Если ИИА_ReplayPolicy.ЭтоКоммитящийSideEffect(ПоследнийЭффект) Тогда
				Результат.Успех = Истина;
				Результат.Сообщение = "Повтор Write пропущен: объект уже был записан ранее для operation_id " + OperationId;
				Результат.Вставить("deduplicated_retry", Истина);
				Результат.next_step_guidance = "Write уже зафиксирован ранее; повторная запись не требуется.";
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Результат.Сообщение = "Нет текущего объекта для записи. Используйте CreateReference, CreateDocument или FindReferenceByName перед Write";
		УстановитьТипизированнуюОшибку(Результат, "missing_object_context", "validation", Ложь, "select_or_create_object_first", Новый Структура("action", "Write"));
		Возврат Результат;
	КонецЕсли;
	Если КонтекстВыполнения.Свойство("ТипОбъекта")
		И КонтекстВыполнения.ТипОбъекта = "Справочник"
		И КонтекстВыполнения.Свойство("DSL_НовыйОбъект")
		И КонтекстВыполнения.DSL_НовыйОбъект Тогда
		НаименованиеОбъекта = "";
		Попытка
			НаименованиеОбъекта = СокрЛП(Строка(КонтекстВыполнения.ТекущийОбъект.Наименование));
		Исключение
			НаименованиеОбъекта = "";
		КонецПопытки;
		Если ПустаяСтрока(НаименованиеОбъекта) Тогда
			Попытка
				НаименованиеПолное = СокрЛП(Строка(КонтекстВыполнения.ТекущийОбъект.НаименованиеПолное));
				Если НЕ ПустаяСтрока(НаименованиеПолное) Тогда
					КонтекстВыполнения.ТекущийОбъект.Наименование = НаименованиеПолное;
					НаименованиеОбъекта = НаименованиеПолное;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ПустаяСтрока(НаименованиеОбъекта) Тогда
			Результат.Успех = Истина;
			Результат.Сообщение = "Запись справочника пропущена: пустое наименование, дубль не создавался";
			Результат.Вставить("skipped_empty_reference_name", Истина);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Если КонтекстВыполнения.Свойство("ТипОбъекта")
		И КонтекстВыполнения.ТипОбъекта = "Справочник"
		И КонтекстВыполнения.Свойство("DSL_НовыйОбъект")
		И НЕ КонтекстВыполнения.DSL_НовыйОбъект
		И КонтекстВыполнения.Свойство("DSL_ИзмененныеПоля")
		И КонтекстВыполнения.DSL_ИзмененныеПоля.Количество() = 0 Тогда
		Результат.Успех = Истина;
		Результат.Сообщение = "Запись пропущена: существующий элемент справочника не изменялся";
		Результат.Вставить("skipped_unchanged_reference", Истина);
		Результат.next_step_guidance = "Существующий элемент справочника использован как ссылка; запись не требуется.";
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьОрганизациюПоУмолчаниюПередЗаписью(КонтекстВыполнения);
	ЗаполнитьДатуПоУмолчаниюПередЗаписью(КонтекстВыполнения);
	Попытка
		КонтекстВыполнения.ТекущийОбъект.Записать();
	Исключение
		Результат.Сообщение = "Ошибка записи объекта: " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "write_failed", "runtime", Истина, "retry_write_with_same_operation_id", Новый Структура("action", "Write"));
		Возврат Результат;
	КонецПопытки;
	Результат.Успех = Истина;
	Результат.Сообщение = "Объект успешно записан";
	Результат.Данные = КонтекстВыполнения.ТекущийОбъект.Ссылка;
	КонтекстВыполнения.Вставить("СсылкаОбъекта", КонтекстВыполнения.ТекущийОбъект.Ссылка);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "object_written", "Write", OperationId);
	Возврат Результат;
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПодобратьИмяРеквизитаОбъекта(ТипОбъекта, ИмяОбъекта, ИмяПоля)
	Имя = СокрЛП(Строка(ИмяПоля));
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Если РеквизитОбъектаСуществует(ТипОбъекта, ИмяОбъекта, Имя) Тогда
		Возврат Имя;
	КонецЕсли;
	Кандидаты = Новый Массив;
	ИмяВРег = ВРег(Имя);
	Если СтрНайти(ИмяВРег, "КОНТРАГЕНТ") > 0
		Или СтрНайти(ИмяВРег, "ПОСТАВЩИК") > 0
		Или СтрНайти(ИмяВРег, "ПОКУПАТЕЛ") > 0
		Или СтрНайти(ИмяВРег, "КЛИЕНТ") > 0 Тогда
		Кандидаты.Добавить("Контрагент");
		Кандидаты.Добавить("Поставщик");
		Кандидаты.Добавить("Покупатель");
		Кандидаты.Добавить("Клиент");
	КонецЕсли;
	Если СтрНайти(ИмяВРег, "ОСНОВАНИ") > 0
		Или СтрНайти(ИмяВРег, "ДОКУМЕНТПОСТУПЛЕН") > 0
		Или СтрНайти(ИмяВРег, "СЧЕТНАОПЛАТ") > 0
		Или ИмяВРег = "СЧЕТ" Тогда
		Кандидаты.Добавить("ДокументОснование");
		Кандидаты.Добавить("ДокументПоступления");
		Кандидаты.Добавить("СчетНаОплату");
		Кандидаты.Добавить("СчетНаОплатуПоставщика");
		Кандидаты.Добавить("Основание");
	КонецЕсли;
	Если СтрНайти(ИмяВРег, "НОМЕНКЛАТУР") > 0 Или СтрНайти(ИмяВРег, "ТОВАР") > 0 Тогда
		Кандидаты.Добавить("Номенклатура");
		Кандидаты.Добавить("Товар");
	КонецЕсли;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если РеквизитОбъектаСуществует(ТипОбъекта, ИмяОбъекта, Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция РеквизитОбъектаСуществует(ТипОбъекта, ИмяОбъекта, ИмяРеквизита)
	Если ТипОбъекта = "Справочник" Тогда
		Возврат ИИА_Метаданные.СуществуетРеквизитСправочника(ИмяОбъекта, ИмяРеквизита);
	КонецЕсли;
	Если ТипОбъекта = "Документ" Тогда
		Возврат ИИА_Метаданные.СуществуетРеквизитДокумента(ИмяОбъекта, ИмяРеквизита);
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура УстановитьТипизированнуюОшибку(Результат, КодОшибки, Категория, Retryable, SuggestedAction, Контекст = Неопределено)
	Результат.Вставить("error_code", КодОшибки);
	Результат.Вставить("error_category", Категория);
	Результат.Вставить("retryable", Retryable);
	Результат.Вставить("suggested_action", SuggestedAction);
	Результат.Вставить("recommendation", SuggestedAction);
	Результат.Вставить("error_context", Контекст);
КонецПроцедуры

Функция СоздатьБазовыйРезультатШага(Действие = "", Контракт = Неопределено)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("error_code", "");
	Результат.Вставить("error_category", "");
	Результат.Вставить("retryable", Ложь);
	Результат.Вставить("suggested_action", "");
	Результат.Вставить("recommendation", "");
	Результат.Вставить("error_context", Неопределено);
	Результат.Вставить("missing_parameters", Новый Массив);
	Результат.Вставить("partial_failure", Ложь);
	Результат.Вставить("next_step_guidance", "");
	Результат.Вставить("operation_id", "");
	Результат.Вставить("idempotent", Ложь);
	Результат.Вставить("supports_safe_retries", Истина);
	Результат.Вставить("retry_strategy", "retry_same_call");
	Результат.Вставить("requires_write", Ложь);
	Результат.Вставить("action", Действие);
	Если Контракт <> Неопределено Тогда
		Если Контракт.Свойство("idempotent") Тогда
			Результат.idempotent = Контракт.idempotent;
		КонецЕсли;
		Если Контракт.Свойство("requires_write") Тогда
			Результат.requires_write = Контракт.requires_write;
		КонецЕсли;
		Если Контракт.Свойство("supports_safe_retries") Тогда
			Результат.supports_safe_retries = Контракт.supports_safe_retries;
		КонецЕсли;
		Если Контракт.Свойство("retry_strategy") Тогда
			Результат.retry_strategy = Контракт.retry_strategy;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, ТипОбъекта, ИмяОбъекта, ТекущийОбъект, ЭтоНовый = Неопределено)
	КонтекстВыполнения.Вставить("DSL_ТипОбъекта", ТипОбъекта);
	КонтекстВыполнения.Вставить("DSL_ИмяОбъекта", ИмяОбъекта);
	КонтекстВыполнения.Вставить("DSL_ТекущийОбъект", ТекущийОбъект);
	КонтекстВыполнения.Вставить("DSL_ИзмененныеПоля", Новый Структура);
	Если ЭтоНовый = Неопределено Тогда
		Попытка
			ЭтоНовый = НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка);
		Исключение
			ЭтоНовый = Истина;
		КонецПопытки;
	КонецЕсли;
	КонтекстВыполнения.Вставить("DSL_НовыйОбъект", ЭтоНовый);
КонецПроцедуры

Процедура ДобавитьИзмененноеПоле(КонтекстВыполнения, ИмяПоля, Значение)
	Если НЕ КонтекстВыполнения.Свойство("DSL_ИзмененныеПоля") Тогда
		КонтекстВыполнения.Вставить("DSL_ИзмененныеПоля", Новый Структура);
	КонецЕсли;
	КонтекстВыполнения.DSL_ИзмененныеПоля.Вставить(ИмяПоля, Значение);
КонецПроцедуры

Функция ПодготовитьЗначениеДляУстановкиРеквизита(КонтекстВыполнения, ИмяРеквизита, Значение)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		СсылкаИзСтруктуры = ИзвлечьСсылкуИзЗначенияРезультата(Значение);
		Если СсылкаИзСтруктуры <> Неопределено Тогда
			Возврат СсылкаИзСтруктуры;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	ТекстЗначения = СокрЛП(Значение);
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат Значение;
	КонецЕсли;
	Если Лев(ВРег(ТекстЗначения), 5) = "STEP_" Тогда
		РазрешенноеЗначение = РазрешитьЗначениеИзРезультатаШагаПланаДляWrite(КонтекстВыполнения, ТекстЗначения);
		Если РазрешенноеЗначение <> Неопределено Тогда
			СсылкаИзРезультатаШага = ИзвлечьСсылкуИзЗначенияРезультата(РазрешенноеЗначение);
			Если СсылкаИзРезультатаШага <> Неопределено Тогда
				Возврат СсылкаИзРезультатаШага;
			КонецЕсли;
			Если ТипЗнч(РазрешенноеЗначение) <> Тип("Строка") Тогда
				Возврат РазрешенноеЗначение;
			КонецЕсли;
			ТекстЗначения = СокрЛП(Строка(РазрешенноеЗначение));
		КонецЕсли;
	КонецЕсли;
	Если Лев(ВРег(ТекстЗначения), 5) = "STEP_" Тогда
		ВызватьИсключение "Не удалось разрешить ссылку на результат шага плана: " + ТекстЗначения;
	КонецЕсли;
	Если НЕ КонтекстВыполнения.Свойство("ТипОбъекта") ИЛИ НЕ КонтекстВыполнения.Свойство("ИмяОбъекта") Тогда
		Возврат Значение;
	КонецЕсли;
	ТипРеквизита = ПолучитьТипРеквизитаОбъекта(КонтекстВыполнения.ТипОбъекта, КонтекстВыполнения.ИмяОбъекта, ИмяРеквизита);
	Если ПустаяСтрока(ТипРеквизита) Тогда
		Возврат Значение;
	КонецЕсли;
	Если СтрНайти(ВРег(ТипРеквизита), "ДАТА") > 0 Тогда
		Возврат ПодготовитьДатуИзСтроки(ТекстЗначения, Значение);
	КонецЕсли;
	Если СтрНайти(ВРег(ТипРеквизита), "ЧИСЛО") > 0 Тогда
		Возврат ПодготовитьЧисловоеЗначениеИзСтроки(ТекстЗначения, Значение);
	КонецЕсли;
	Если СтрНайти(ВРег(ТипРеквизита), "БУЛЕВО") > 0 Тогда
		Возврат ПодготовитьБулевоИзСтроки(ТекстЗначения, Значение);
	КонецЕсли;
	ИмяПеречисления = РазрешитьИмяОбъектаСсылочногоТипа(ТипРеквизита, "Перечисление");
	Если НЕ ПустаяСтрока(ИмяПеречисления) И Метаданные.Перечисления.Найти(ИмяПеречисления) <> Неопределено Тогда
		Возврат ПодготовитьЗначениеПеречисленияИзСтроки(ИмяПеречисления, ТекстЗначения);
	КонецЕсли;
	Если Лев(ВРег(ТипРеквизита), 17) = "СПРАВОЧНИКССЫЛКА." Тогда
		ИмяСправочника = Сред(ТипРеквизита, 18);
		ИмяСправочника = НормализоватьИмяСправочникаДляЗаписи(ИмяСправочника);
		НайденнаяСсылка = НайтиСсылкуСправочникаПоСтроке(ИмяСправочника, ТекстЗначения);
		Если НайденнаяСсылка = Неопределено Тогда
			НайденнаяСсылка = ПолучитьСсылкуПоУмолчаниюДляСсылочногоРеквизита(КонтекстВыполнения, ИмяРеквизита, ИмяСправочника);
		КонецЕсли;
		Возврат НайденнаяСсылка;
	ИначеЕсли Лев(ВРег(ТипРеквизита), 14) = "ДОКУМЕНТССЫЛКА." Тогда
		ИмяДокумента = Сред(ТипРеквизита, 15);
		Возврат НайтиСсылкуДокументаПоНомеру(ИмяДокумента, ТекстЗначения);
	КонецЕсли;
	ИмяСправочника = РазрешитьИмяОбъектаСсылочногоТипа(ТипРеквизита, "Справочник");
	ИмяСправочника = НормализоватьИмяСправочникаДляЗаписи(ИмяСправочника);
	Если НЕ ПустаяСтрока(ИмяСправочника) И Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		НайденнаяСсылка = НайтиСсылкуСправочникаПоСтроке(ИмяСправочника, ТекстЗначения);
		Если НайденнаяСсылка = Неопределено Тогда
			НайденнаяСсылка = ПолучитьСсылкуПоУмолчаниюДляСсылочногоРеквизита(КонтекстВыполнения, ИмяРеквизита, ИмяСправочника);
		КонецЕсли;
		Возврат НайденнаяСсылка;
	КонецЕсли;
	ИмяДокумента = РазрешитьИмяОбъектаСсылочногоТипа(ТипРеквизита, "Документ");
	Если НЕ ПустаяСтрока(ИмяДокумента) И Метаданные.Документы.Найти(ИмяДокумента) <> Неопределено Тогда
		Возврат НайтиСсылкуДокументаПоНомеру(ИмяДокумента, ТекстЗначения);
	КонецЕсли;
	Если ЭтоРеквизитОрганизацииДляАвтозаполнения(ИмяРеквизита, "Организации") Тогда
		НайденнаяСсылка = НайтиСсылкуСправочникаПоСтроке("Организации", ТекстЗначения);
		Если НайденнаяСсылка = Неопределено Тогда
			НайденнаяСсылка = ПолучитьСсылкуПоУмолчаниюДляСсылочногоРеквизита(КонтекстВыполнения, ИмяРеквизита, "Организации");
		КонецЕсли;
		Если НайденнаяСсылка <> Неопределено Тогда
			Возврат НайденнаяСсылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция НужноОтложитьАвтозаполнениеОрганизацииДоЗаписи(КонтекстВыполнения, ИмяРеквизита, Значение)
	Если НЕ КонтекстВыполнения.Свойство("ТипОбъекта")
		ИЛИ НЕ КонтекстВыполнения.Свойство("ИмяОбъекта")
		ИЛИ КонтекстВыполнения.ТипОбъекта <> "Документ" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЭтоРеквизитОрганизацииДляАвтозаполнения(ИмяРеквизита, "Организации") Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстЗначения = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НайтиСсылкуСправочникаПоСтроке("Организации", ТекстЗначения) = Неопределено;
КонецФункции

Функция ПодготовитьДатуИзСтроки(Значение, ЗначениеПоУмолчанию)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "/", ".");
	Если СтрНайти(Текст, "-") > 0 Тогда
		Части = СтрРазделить(Текст, "-", Ложь);
		Если Части.Количество() >= 3 Тогда
			Попытка
				Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
			Исключение
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли СтрНайти(Текст, ".") > 0 Тогда
		Части = СтрРазделить(Текст, ".", Ложь);
		Если Части.Количество() >= 3 Тогда
			Попытка
				Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Попытка
		Возврат Дата(Текст);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

Функция РазрешитьЗначениеИзРезультатаШагаПланаДляWrite(КонтекстВыполнения, ИсходноеЗначение)
	Если ТипЗнч(ИсходноеЗначение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ КонтекстВыполнения.Свойство("СсылкаДиалога") ИЛИ НЕ ЗначениеЗаполнено(КонтекстВыполнения.СсылкаДиалога) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выражение = СокрЛП(ИсходноеЗначение);
	Если ПустаяСтрока(Выражение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВыражениеВРег = ВРег(Выражение);
	Если Лев(ВыражениеВРег, 5) <> "STEP_" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПозТочки = СтрНайти(Выражение, ".");
	Если ПозТочки = 0 Тогда
		StepId = Выражение;
		Хвост = "";
	Иначе
		StepId = Лев(Выражение, ПозТочки - 1);
		Хвост = Сред(Выражение, ПозТочки + 1);
	КонецЕсли;
	
	ИмяПоля = "";
	ХвостВРег = ВРег(Хвост);
	Если ПустаяСтрока(Хвост) Или ХвостВРег = "RESULT" Тогда
		ИмяПоля = "";
	ИначеЕсли Лев(ХвостВРег, 9) = "RESULT[0]" Тогда
		ПозПоля = СтрНайти(Хвост, "].");
		Если ПозПоля > 0 Тогда
			ИмяПоля = Сред(Хвост, ПозПоля + 2);
		КонецЕсли;
	ИначеЕсли Лев(ХвостВРег, 7) = "RESULT." Тогда
		ИмяПоля = Сред(Хвост, 8);
	Иначе
		ИмяПоля = Хвост;
	КонецЕсли;
	
	ШагПлана = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(КонтекстВыполнения.СсылкаДиалога, StepId);
	Если ШагПлана = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	РезультатШага = ПолучитьСвойствоПланаЛокально(ШагПлана, "result_data", Неопределено);
	Если РезультатШага = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = ИзвлечьДанныеИзРезультатаШагаПланаДляWrite(РезультатШага);
	ПерваяСтрока = ПолучитьПервыйЭлементМассиваЛокально(Данные);
	Если ПерваяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ПустаяСтрока(ИмяПоля) Тогда
		СсылкаЗначение = ИзвлечьСсылкуИзЗначенияРезультата(ПерваяСтрока);
		Если СсылкаЗначение <> Неопределено Тогда
			Возврат СсылкаЗначение;
		КонецЕсли;
		Возврат ПерваяСтрока;
	КонецЕсли;
	Возврат ПолучитьСвойствоПланаЛокально(ПерваяСтрока, ИмяПоля, Неопределено);
КонецФункции

Функция ИзвлечьСсылкуИзЗначенияРезультата(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Тогда
		Если Значение.Свойство("Ссылка") Тогда
			Возврат Значение.Ссылка;
		КонецЕсли;
		Если Значение.Свойство("guid") И ЗначениеЗаполнено(Значение.guid) Тогда
			СсылкаПоУИД = НайтиСсылкуПоУИДЛокально(Строка(Значение.guid));
			Если СсылкаПоУИД <> Неопределено Тогда
				Возврат СсылкаПоУИД;
			КонецЕсли;
		КонецЕсли;
		Для Каждого Пара Из Значение Цикл
			Кандидат = ИзвлечьСсылкуИзЗначенияРезультата(Пара.Значение);
			Если Кандидат <> Неопределено Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Кандидат = ИзвлечьСсылкуИзЗначенияРезультата(Элемент);
			Если Кандидат <> Неопределено Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗначения <> Тип("Строка")
		И ТипЗначения <> Тип("Число")
		И ТипЗначения <> Тип("Булево")
		И ТипЗначения <> Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ИзвлечьДанныеИзРезультатаШагаПланаДляWrite(РезультатШага)
	RunQueryДанные = ПолучитьСвойствоПланаЛокально(РезультатШага, "run_query", Неопределено);
	Если ТипЗнч(RunQueryДанные) = Тип("Массив") И RunQueryДанные.Количество() > 0 Тогда
		ПервыйRunQuery = RunQueryДанные[0];
		Если ПервыйRunQuery <> Неопределено Тогда
			Данные = ПолучитьСвойствоПланаЛокально(ПервыйRunQuery, "rows", Неопределено);
			Если Данные <> Неопределено Тогда
				Возврат Данные;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Результаты = ПолучитьСвойствоПланаЛокально(РезультатШага, "Результаты", Неопределено);
	Если ТипЗнч(Результаты) = Тип("Массив") Тогда
		Для Каждого ЭлементРезультата Из Результаты Цикл
			Если ЭлементРезультата = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДанныеЭлемента = ПолучитьСвойствоПланаЛокально(ЭлементРезультата, "Данные", Неопределено);
			Если ДанныеЭлемента = Неопределено Тогда
				ДанныеЭлемента = ПолучитьСвойствоПланаЛокально(ЭлементРезультата, "data", Неопределено);
			КонецЕсли;
			Если ДанныеЭлемента = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДанныеЗапроса = ПолучитьСвойствоПланаЛокально(ДанныеЭлемента, "ДанныеЗапроса", Неопределено);
			Если ДанныеЗапроса = Неопределено Тогда
				ДанныеЗапроса = ПолучитьСвойствоПланаЛокально(ДанныеЭлемента, "ДанныеЗапросаДляТаблицы", Неопределено);
			КонецЕсли;
			Если ДанныеЗапроса = Неопределено Тогда
				ДанныеЗапроса = ПолучитьСвойствоПланаЛокально(ДанныеЭлемента, "rows", Неопределено);
			КонецЕсли;
			Если ДанныеЗапроса <> Неопределено Тогда
				Возврат ДанныеЗапроса;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьПервыйЭлементМассиваЛокально(Данные)
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Если Данные.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Данные[0];
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ПолучитьСвойствоПланаЛокально(Значение, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Если Значение.Свойство(ИмяСвойства) Тогда
			Возврат Значение[ИмяСвойства];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		ЛокЗначение = Значение.Получить(ИмяСвойства);
		Если ЛокЗначение <> Неопределено Тогда
			Возврат ЛокЗначение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция НайтиСсылкуПоУИДЛокально(знач УИД)
	Если ПустаяСтрока(СокрЛП(Строка(УИД))) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МассивМетаданных = Новый Массив;
	МассивМетаданных.Добавить(Справочники);
	МассивМетаданных.Добавить(Документы);
	МассивМетаданных.Добавить(ПланыВидовХарактеристик);
	МассивТипов = Новый Массив;
	Для Каждого СтрМетаданные Из МассивМетаданных Цикл
		Для Каждого Стр Из СтрМетаданные.ТипВсеСсылки().Типы() Цикл
			МассивТипов.Добавить(Стр);
		КонецЦикла;
	КонецЦикла;
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("УИД", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(36)));
	ТаблицаСсылок.Колонки.Добавить("Ссылка", Новый ОписаниеТипов(МассивТипов));
	Для Каждого СтрМетаданные Из МассивМетаданных Цикл
		Для Каждого Менеджер Из СтрМетаданные Цикл
			Попытка
				НовСтр = ТаблицаСсылок.Добавить();
				НовСтр.Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(УИД)));
				НовСтр.УИД = Строка(УИД);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|   ТаблицаСсылок.Ссылка КАК Ссылка,
		|   ТаблицаСсылок.УИД КАК УИД
		|ИЗ
		|   &ТаблицаСсылок КАК ТаблицаСсылок
		|ГДЕ
		|   НЕ ТаблицаСсылок.Ссылка.ПометкаУдаления ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ТаблицаСсылок", ТаблицаСсылок);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

Функция ПолучитьТипРеквизитаОбъекта(ТипОбъекта, ИмяОбъекта, ИмяРеквизита)
	Если ТипОбъекта = "Справочник" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыСправочника(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыДокумента(ИмяОбъекта);
	Иначе
		Возврат "";
	КонецЕсли;
	Если ИнформацияОбОбъекте = Неопределено ИЛИ НЕ ИнформацияОбОбъекте.Найден Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Реквизит Из ИнформацияОбОбъекте.Реквизиты Цикл
		Если ТипЗнч(Реквизит) = Тип("Структура")
			И Реквизит.Свойство("Имя")
			И ВРег(Строка(Реквизит.Имя)) = ВРег(ИмяРеквизита) Тогда
			Возврат Строка(?(Реквизит.Свойство("Тип"), Реквизит.Тип, ""));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НормализоватьИмяТабличнойЧастиДокумента(ИмяДокумента, ИмяТабличнойЧасти)
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Искомое = НормализоватьСтрокуСопоставления(ИмяТабличнойЧасти);
	Если ПустаяСтрока(Искомое) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Если НормализоватьСтрокуСопоставления(ТабличнаяЧасть.Имя) = Искомое
			ИЛИ НормализоватьСтрокуСопоставления(ТабличнаяЧасть.Синоним) = Искомое Тогда
			Возврат ТабличнаяЧасть.Имя;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		ИмяНорм = НормализоватьСтрокуСопоставления(ТабличнаяЧасть.Имя);
		СинонимНорм = НормализоватьСтрокуСопоставления(ТабличнаяЧасть.Синоним);
		Если СтрНайти(ИмяНорм, Искомое) > 0
			ИЛИ СтрНайти(Искомое, ИмяНорм) > 0
			ИЛИ (НЕ ПустаяСтрока(СинонимНорм) И (СтрНайти(СинонимНорм, Искомое) > 0 ИЛИ СтрНайти(Искомое, СинонимНорм) > 0)) Тогда
			Возврат ТабличнаяЧасть.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НормализоватьИмяКолонкиТабличнойЧасти(ИмяДокумента, ИмяТабличнойЧасти, ИмяКолонки)
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Искомое = НормализоватьСтрокуСопоставления(ИмяКолонки);
	Если ПустаяСтрока(Искомое) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
		Если НормализоватьСтрокуСопоставления(Реквизит.Имя) = Искомое
			ИЛИ НормализоватьСтрокуСопоставления(Реквизит.Синоним) = Искомое Тогда
			Возврат Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ПолучитьТипКолонкиТабличнойЧасти(ИмяДокумента, ИмяТабличнойЧасти, ИмяКолонки)
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Реквизит = ТабличнаяЧасть.Реквизиты.Найти(ИмяКолонки);
	Если Реквизит = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Реквизит.Тип);
КонецФункции

Функция ПодготовитьЗначениеДляУстановкиКолонкиТЧ(ТипКолонки, Значение)
	Если СтрНайти(ВРег(ТипКолонки), "ЧИСЛО") > 0 Тогда
		Возврат ПодготовитьЧисловоеЗначениеИзСтроки(Значение, Значение);
	КонецЕсли;
	Если СтрНайти(ВРег(ТипКолонки), "БУЛЕВО") > 0 Тогда
		Возврат ПодготовитьБулевоИзСтроки(Значение, Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	ТекстЗначения = СокрЛП(Значение);
	Если ПустаяСтрока(ТекстЗначения) Тогда
		Возврат Значение;
	КонецЕсли;
	ИмяПеречисления = РазрешитьИмяОбъектаСсылочногоТипа(ТипКолонки, "Перечисление");
	Если НЕ ПустаяСтрока(ИмяПеречисления) И Метаданные.Перечисления.Найти(ИмяПеречисления) <> Неопределено Тогда
		ЗначениеПеречисления = ПодготовитьЗначениеПеречисленияИзСтроки(ИмяПеречисления, ТекстЗначения);
		Если ЗначениеПеречисления <> Неопределено Тогда
			Возврат ЗначениеПеречисления;
		КонецЕсли;
	КонецЕсли;
	ИмяСправочника = РазрешитьИмяОбъектаСсылочногоТипа(ТипКолонки, "Справочник");
	Если НЕ ПустаяСтрока(ИмяСправочника) И Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		НайденнаяСсылка = НайтиСсылкуСправочникаПоСтроке(ИмяСправочника, ТекстЗначения);
		Если НайденнаяСсылка <> Неопределено Тогда
			Возврат НайденнаяСсылка;
		КонецЕсли;
	КонецЕсли;
	ИмяДокумента = РазрешитьИмяОбъектаСсылочногоТипа(ТипКолонки, "Документ");
	Если НЕ ПустаяСтрока(ИмяДокумента) И Метаданные.Документы.Найти(ИмяДокумента) <> Неопределено Тогда
		НайденнаяСсылка = НайтиСсылкуДокументаПоНомеру(ИмяДокумента, ТекстЗначения);
		Если НайденнаяСсылка <> Неопределено Тогда
			Возврат НайденнаяСсылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ПодготовитьЧисловоеЗначениеИзСтроки(Значение, ЗначениеПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ".", ",");
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция ПодготовитьБулевоИзСтроки(Значение, ЗначениеПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Текст) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если Текст = "TRUE" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "ДА" ИЛИ Текст = "YES" ИЛИ Текст = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Текст = "FALSE" ИЛИ Текст = "ЛОЖЬ" ИЛИ Текст = "НЕТ" ИЛИ Текст = "NO" ИЛИ Текст = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ПодготовитьЗначениеПеречисленияИзСтроки(ИмяПеречисления, Значение)
	МетаданныеПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаданныеПеречисления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	НормЗначение = НормализоватьСтрокуСопоставления(Значение);
	Если ПустаяСтрока(НормЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЛучшееИмя = "";
	Для Каждого ЗначениеМетаданных Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
		НормИмя = НормализоватьСтрокуСопоставления(ЗначениеМетаданных.Имя);
		НормСиноним = НормализоватьСтрокуСопоставления(ЗначениеМетаданных.Синоним);
		Если НормЗначение = НормИмя ИЛИ НормЗначение = НормСиноним Тогда
			ЛучшееИмя = ЗначениеМетаданных.Имя;
			Прервать;
		КонецЕсли;
		Если ПустаяСтрока(ЛучшееИмя)
			И НЕ ПустаяСтрока(НормСиноним)
			И (СтрНайти(НормСиноним, НормЗначение) > 0 ИЛИ СтрНайти(НормЗначение, НормСиноним) > 0) Тогда
			ЛучшееИмя = ЗначениеМетаданных.Имя;
		ИначеЕсли ПустаяСтрока(ЛучшееИмя)
			И НЕ ПустаяСтрока(НормИмя)
			И (СтрНайти(НормИмя, НормЗначение) > 0 ИЛИ СтрНайти(НормЗначение, НормИмя) > 0) Тогда
			ЛучшееИмя = ЗначениеМетаданных.Имя;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ЛучшееИмя) Тогда
		ЛучшееИмя = ПодобратьСтавкуНДСПохожимТекстом(МетаданныеПеречисления, Значение);
	КонецЕсли;
	Если ПустаяСтрока(ЛучшееИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат ПредопределенноеЗначение("Перечисление." + ИмяПеречисления + "." + ЛучшееИмя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ПодобратьСтавкуНДСПохожимТекстом(МетаданныеПеречисления, Значение)
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(Текст, "БЕЗ") > 0 И СтрНайти(Текст, "НДС") > 0 Тогда
		Кандидаты = СтрРазделить("БЕЗНДС,НДСНЕОБЛАГАЕТСЯ,НЕОБЛАГАЕТСЯНДС", ",", Ложь);
	ИначеЕсли СтрНайти(Текст, "20") > 0 Тогда
		Кандидаты = СтрРазделить("НДС20,НДС20_120,НДС20ПРОЦЕНТОВ,СТАВКА20", ",", Ложь);
	ИначеЕсли СтрНайти(Текст, "10") > 0 Тогда
		Кандидаты = СтрРазделить("НДС10,НДС10_110,НДС10ПРОЦЕНТОВ,СТАВКА10", ",", Ложь);
	ИначеЕсли СтрНайти(Текст, "0") > 0 Тогда
		Кандидаты = СтрРазделить("НДС0,СТАВКА0,НОЛЬ", ",", Ложь);
	Иначе
		Возврат "";
	КонецЕсли;
	Для Каждого ЗначениеМетаданных Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
		НормИмя = НормализоватьСтрокуСопоставления(ЗначениеМетаданных.Имя);
		НормСиноним = НормализоватьСтрокуСопоставления(ЗначениеМетаданных.Синоним);
		Для Каждого Кандидат Из Кандидаты Цикл
			Если СтрНайти(НормИмя, Кандидат) > 0 ИЛИ СтрНайти(НормСиноним, Кандидат) > 0 Тогда
				Возврат ЗначениеМетаданных.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция РазрешитьИмяОбъектаСсылочногоТипа(ПодсказкаТипа, ОжидаемыйТип)
	Если ПустаяСтрока(ПодсказкаТипа) Тогда
		Возврат "";
	КонецЕсли;
	ИмяОбъекта = ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(ПодсказкаТипа, ОжидаемыйТип);
	Если ОжидаемыйТип = "Справочник" И НЕ ПустаяСтрока(ИмяОбъекта) И Метаданные.Справочники.Найти(ИмяОбъекта) <> Неопределено Тогда
		Возврат ИмяОбъекта;
	ИначеЕсли ОжидаемыйТип = "Документ" И НЕ ПустаяСтрока(ИмяОбъекта) И Метаданные.Документы.Найти(ИмяОбъекта) <> Неопределено Тогда
		Возврат ИмяОбъекта;
	ИначеЕсли ОжидаемыйТип = "Перечисление" И НЕ ПустаяСтрока(ИмяОбъекта) И Метаданные.Перечисления.Найти(ИмяОбъекта) <> Неопределено Тогда
		Возврат ИмяОбъекта;
	КонецЕсли;
	Возврат НайтиИмяОбъектаМетаданныхПоПодсказке(ПодсказкаТипа, ОжидаемыйТип);
КонецФункции

Функция НайтиИмяОбъектаМетаданныхПоПодсказке(ПодсказкаТипа, ОжидаемыйТип)
	НормПодсказка = НормализоватьСтрокуСопоставления(ПодсказкаТипа);
	Если ПустаяСтрока(НормПодсказка) Тогда
		Возврат "";
	КонецЕсли;
	ОсноваПодсказки = НормализоватьОсновуСтрокиСопоставления(НормПодсказка);
	ЛучшееИмя = "";
	ЛучшееИмяПоНачалу = "";
	ЛучшаяДлинаПоНачалу = 999999;
	Если ОжидаемыйТип = "Справочник" Тогда
		КоллекцияМетаданных = Метаданные.Справочники;
	ИначеЕсли ОжидаемыйТип = "Документ" Тогда
		КоллекцияМетаданных = Метаданные.Документы;
	ИначеЕсли ОжидаемыйТип = "Перечисление" Тогда
		КоллекцияМетаданных = Метаданные.Перечисления;
	Иначе
		Возврат "";
	КонецЕсли;
	Для Каждого ЭлементМетаданных Из КоллекцияМетаданных Цикл
		НормИмя = НормализоватьСтрокуСопоставления(ЭлементМетаданных.Имя);
		НормСиноним = НормализоватьСтрокуСопоставления(ЭлементМетаданных.Синоним);
		ОсноваИмени = НормализоватьОсновуСтрокиСопоставления(НормИмя);
		ОсноваСинонима = НормализоватьОсновуСтрокиСопоставления(НормСиноним);
		Если НормПодсказка = НормИмя ИЛИ НормПодсказка = НормСиноним Тогда
			Возврат ЭлементМетаданных.Имя;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ОсноваПодсказки) И (ОсноваПодсказки = ОсноваИмени ИЛИ ОсноваПодсказки = ОсноваСинонима) Тогда
			Возврат ЭлементМетаданных.Имя;
		КонецЕсли;
		Если НЕ ПустаяСтрока(НормИмя)
			И (СтрНайти(НормИмя, НормПодсказка) = 1 ИЛИ СтрНайти(НормПодсказка, НормИмя) = 1)
			И СтрДлина(НормИмя) < ЛучшаяДлинаПоНачалу Тогда
			ЛучшееИмяПоНачалу = ЭлементМетаданных.Имя;
			ЛучшаяДлинаПоНачалу = СтрДлина(НормИмя);
		КонецЕсли;
		Если НЕ ПустаяСтрока(НормСиноним)
			И (СтрНайти(НормСиноним, НормПодсказка) = 1 ИЛИ СтрНайти(НормПодсказка, НормСиноним) = 1)
			И СтрДлина(НормСиноним) < ЛучшаяДлинаПоНачалу Тогда
			ЛучшееИмяПоНачалу = ЭлементМетаданных.Имя;
			ЛучшаяДлинаПоНачалу = СтрДлина(НормСиноним);
		КонецЕсли;
		Если ПустаяСтрока(ЛучшееИмя) Тогда
			Если НЕ ПустаяСтрока(НормСиноним) И (СтрНайти(НормСиноним, НормПодсказка) > 0 ИЛИ СтрНайти(НормПодсказка, НормСиноним) > 0) Тогда
				ЛучшееИмя = ЭлементМетаданных.Имя;
			ИначеЕсли НЕ ПустаяСтрока(НормИмя) И (СтрНайти(НормИмя, НормПодсказка) > 0 ИЛИ СтрНайти(НормПодсказка, НормИмя) > 0) Тогда
				ЛучшееИмя = ЭлементМетаданных.Имя;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(ЛучшееИмяПоНачалу) Тогда
		Возврат ЛучшееИмяПоНачалу;
	КонецЕсли;
	Возврат ЛучшееИмя;
КонецФункции

Функция НормализоватьСтрокуСопоставления(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Результат = ВРег(СокрЛП(Строка(Значение)));
	СимволыДляУдаления = Новый Массив;
	СимволыДляУдаления.Добавить(" ");
	СимволыДляУдаления.Добавить(".");
	СимволыДляУдаления.Добавить(",");
	СимволыДляУдаления.Добавить(";");
	СимволыДляУдаления.Добавить(":");
	СимволыДляУдаления.Добавить("-");
	СимволыДляУдаления.Добавить("_");
	СимволыДляУдаления.Добавить("'");
	СимволыДляУдаления.Добавить("""");
	СимволыДляУдаления.Добавить("(");
	СимволыДляУдаления.Добавить(")");
	СимволыДляУдаления.Добавить("[");
	СимволыДляУдаления.Добавить("]");
	СимволыДляУдаления.Добавить("{");
	СимволыДляУдаления.Добавить("}");
	СимволыДляУдаления.Добавить("/");
	СимволыДляУдаления.Добавить("\");
	СимволыДляУдаления.Добавить("«");
	СимволыДляУдаления.Добавить("»");
	Для Каждого Символ Из СимволыДляУдаления Цикл
		Результат = СтрЗаменить(Результат, Символ, "");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НормализоватьОсновуСтрокиСопоставления(Значение)
	Результат = НормализоватьСтрокуСопоставления(Значение);
	Если СтрДлина(Результат) > 4 Тогда
		Окончания = Новый Массив;
		Окончания.Добавить("ами");
		Окончания.Добавить("ями");
		Окончания.Добавить("ов");
		Окончания.Добавить("ев");
		Окончания.Добавить("ом");
		Окончания.Добавить("ем");
		Окончания.Добавить("ой");
		Окончания.Добавить("ий");
		Окончания.Добавить("ый");
		Окончания.Добавить("ая");
		Окончания.Добавить("яя");
		Окончания.Добавить("ы");
		Окончания.Добавить("и");
		Окончания.Добавить("а");
		Окончания.Добавить("я");
		Окончания.Добавить("ь");
		Для Каждого Окончание Из Окончания Цикл
			Если Прав(Результат, СтрДлина(Окончание)) = Окончание Тогда
				Результат = Лев(Результат, СтрДлина(Результат) - СтрДлина(Окончание));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоСсылочныйТипРеквизита(ТипРеквизита)
	Если ПустаяСтрока(ТипРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипВРег = ВРег(ТипРеквизита);
	Если Лев(ТипВРег, 17) = "СПРАВОЧНИКССЫЛКА." ИЛИ Лев(ТипВРег, 14) = "ДОКУМЕНТССЫЛКА." Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат НЕ ПустаяСтрока(РазрешитьИмяОбъектаСсылочногоТипа(ТипРеквизита, "Справочник"))
		ИЛИ НЕ ПустаяСтрока(РазрешитьИмяОбъектаСсылочногоТипа(ТипРеквизита, "Документ"));
КонецФункции

Процедура ПроверитьЧтоСсылочныйРеквизитЗаполнен(Объект, КонтекстВыполнения, ИмяРеквизита, ЗначениеДляУстановки)
	Если ЭтоНезаполненныйСсылочныйРеквизит(Объект, КонтекстВыполнения, ИмяРеквизита) Тогда
		ВызватьИсключение "Ссылочный реквизит '" + ИмяРеквизита + "' не был заполнен значением '" + Строка(ЗначениеДляУстановки) + "'";
	КонецЕсли;
КонецПроцедуры

Функция ЭтоНезаполненныйСсылочныйРеквизит(Объект, КонтекстВыполнения, ИмяРеквизита)
	Если НЕ КонтекстВыполнения.Свойство("ТипОбъекта") ИЛИ НЕ КонтекстВыполнения.Свойство("ИмяОбъекта") Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипРеквизита = ПолучитьТипРеквизитаОбъекта(КонтекстВыполнения.ТипОбъекта, КонтекстВыполнения.ИмяОбъекта, ИмяРеквизита);
	Если НЕ ЭтоСсылочныйТипРеквизита(ТипРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат НЕ ЗначениеЗаполнено(Объект[ИмяРеквизита]);
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Процедура ЗаполнитьДатуПоУмолчаниюПередЗаписью(КонтекстВыполнения)
	Если КонтекстВыполнения = Неопределено
		ИЛИ НЕ КонтекстВыполнения.Свойство("ТипОбъекта")
		ИЛИ НЕ КонтекстВыполнения.Свойство("ТекущийОбъект")
		ИЛИ КонтекстВыполнения.ТипОбъекта <> "Документ" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(КонтекстВыполнения.ТекущийОбъект.Дата) Тогда
			Возврат;
		КонецЕсли;
		КонтекстВыполнения.ТекущийОбъект.Дата = ТекущаяДата();
		ДобавитьИзмененноеПоле(КонтекстВыполнения, "Дата", КонтекстВыполнения.ТекущийОбъект.Дата);
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

Процедура ЗаполнитьОрганизациюПоУмолчаниюПередЗаписью(КонтекстВыполнения)
	Если КонтекстВыполнения = Неопределено
		ИЛИ НЕ КонтекстВыполнения.Свойство("ТипОбъекта")
		ИЛИ НЕ КонтекстВыполнения.Свойство("ИмяОбъекта")
		ИЛИ НЕ КонтекстВыполнения.Свойство("ТекущийОбъект")
		ИЛИ КонтекстВыполнения.ТипОбъекта <> "Документ" Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ИИА_Метаданные.СуществуетРеквизитДокумента(КонтекстВыполнения.ИмяОбъекта, "Организация") Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(КонтекстВыполнения.ТекущийОбъект["Организация"]) Тогда
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	ТипРеквизита = ПолучитьТипРеквизитаОбъекта("Документ", КонтекстВыполнения.ИмяОбъекта, "Организация");
	ИмяСправочника = РазрешитьИмяОбъектаСсылочногоТипа(ТипРеквизита, "Справочник");
	Если ПустаяСтрока(ИмяСправочника) Тогда
		ИмяСправочника = "Организации";
	КонецЕсли;
	СсылкаОрганизации = ПолучитьСсылкуПоУмолчаниюДляСсылочногоРеквизита(КонтекстВыполнения, "Организация", ИмяСправочника);
	Если НЕ ЗначениеЗаполнено(СсылкаОрганизации) Тогда
		Возврат;
	КонецЕсли;
	КонтекстВыполнения.ТекущийОбъект["Организация"] = СсылкаОрганизации;
	ДобавитьИзмененноеПоле(КонтекстВыполнения, "Организация", СсылкаОрганизации);
КонецПроцедуры

Функция НайтиСуществующуюСсылкуСправочникаПоДанным(ИмяСправочника, ДанныеПоиска)
	Если ПустаяСтрока(ИмяСправочника) ИЛИ ТипЗнч(ДанныеПоиска) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоляПриоритета = СтрРазделить("ИНН,Артикул,Штрихкод,Код,Наименование", ",", Ложь);
	Для Каждого ИмяПоля Из ПоляПриоритета Цикл
		Если НЕ ДанныеПоиска.Свойство(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеПоля = СокрЛП(Строка(ДанныеПоиска[ИмяПоля]));
		Если ПустаяСтрока(ЗначениеПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ИИА_Метаданные.СуществуетРеквизитСправочника(ИмяСправочника, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		НайденнаяСсылка = НайтиСсылкуСправочникаПоПолю(ИмяСправочника, ИмяПоля, ЗначениеПоля);
		Если НайденнаяСсылка <> Неопределено Тогда
			Возврат НайденнаяСсылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиСсылкуСправочникаПоПолю(ИмяСправочника, ИмяПоля, ЗначениеПоиска)
	Если ПустаяСтрока(ИмяСправочника) Или ПустаяСтрока(ИмяПоля) Или ПустаяСтрока(ЗначениеПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЭтоКорректныйИдентификатор1С(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Элементы.Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Элементы
	|ГДЕ
	|	НЕ Элементы.ПометкаУдаления
	|	И Элементы." + ИмяПоля + " = &Значение";
	Запрос.УстановитьПараметр("Значение", ЗначениеПоиска);
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

Функция НайтиСсылкуСправочникаПоСтроке(ИмяСправочника, ЗначениеПоиска)
	Если ПустаяСтрока(ИмяСправочника) Или ПустаяСтрока(ЗначениеПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МенеджерСправочника = Справочники[ИмяСправочника];
	Если МенеджерСправочника <> Неопределено Тогда
		Попытка
			СсылкаПоНаименованию = МенеджерСправочника.НайтиПоНаименованию(ЗначениеПоиска);
			Если ЗначениеЗаполнено(СсылкаПоНаименованию)
				И НЕ СсылкаПоНаименованию.ПометкаУдаления Тогда
				Возврат СсылкаПоНаименованию;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	ПоляПоиска = ПолучитьПоляПоискаСправочникаПоСтроке(ИмяСправочника);
	Если ПоляПоиска.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Условия = Новый Массив;
	Для Каждого ИмяПоля Из ПоляПоиска Цикл
		Если НЕ ЭтоКорректныйИдентификатор1С(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Условия.Добавить("Элементы." + ИмяПоля + " = &Значение");
	КонецЦикла;
	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ИмяПоля Из ПоляПоиска Цикл
		НайденнаяСсылка = НайтиСсылкуСправочникаПоПолю(ИмяСправочника, ИмяПоля, ЗначениеПоиска);
		Если НайденнаяСсылка <> Неопределено Тогда
			Возврат НайденнаяСсылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьСсылкуПоУмолчаниюДляСсылочногоРеквизита(КонтекстВыполнения, ИмяРеквизита, ИмяСправочника)
	ИмяСправочника = НормализоватьИмяСправочникаДляЗаписи(ИмяСправочника);
	Если НЕ ЭтоРеквизитОрганизацииДляАвтозаполнения(ИмяРеквизита, ИмяСправочника) Тогда
		Возврат Неопределено;
	КонецЕсли;
	СсылкаИзДокументов = ПолучитьПоследнююОрганизациюДокумента(КонтекстВыполнения, ИмяРеквизита, ИмяСправочника);
	Если ЗначениеЗаполнено(СсылкаИзДокументов) Тогда
		Возврат СсылкаИзДокументов;
	КонецЕсли;
	Возврат ПолучитьПервуюСсылкуСправочника(ИмяСправочника);
КонецФункции

Функция НормализоватьИмяСправочникаДляЗаписи(ИмяСправочника)
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Возврат "";
	КонецЕсли;
	Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
		Возврат ИмяСправочника;
	КонецЕсли;
	Если ВРег(ИмяСправочника) = "ОРГАНИЗАЦИЯ" И Метаданные.Справочники.Найти("Организации") <> Неопределено Тогда
		Возврат "Организации";
	КонецЕсли;
	Возврат ИмяСправочника;
КонецФункции

Функция ЭтоРеквизитОрганизацииДляАвтозаполнения(ИмяРеквизита, ИмяСправочника)
	Если ПустаяСтрока(ИмяСправочника) ИЛИ ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(ИмяСправочника) <> "ОРГАНИЗАЦИИ" И ВРег(ИмяСправочника) <> "ОРГАНИЗАЦИЯ" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ВРег(ИмяРеквизита), "ОРГАНИЗАЦ") > 0;
КонецФункции

Функция ПолучитьПоследнююОрганизациюДокумента(КонтекстВыполнения, ИмяРеквизита, ИмяСправочника)
	Если КонтекстВыполнения = Неопределено
		ИЛИ НЕ КонтекстВыполнения.Свойство("ТипОбъекта")
		ИЛИ НЕ КонтекстВыполнения.Свойство("ИмяОбъекта")
		ИЛИ КонтекстВыполнения.ТипОбъекта <> "Документ" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЭтоКорректныйИдентификатор1С(КонтекстВыполнения.ИмяОбъекта)
		ИЛИ НЕ ЭтоКорректныйИдентификатор1С(ИмяРеквизита)
		ИЛИ НЕ ЭтоКорректныйИдентификатор1С(ИмяСправочника) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Документы." + ИмяРеквизита + " КАК Ссылка
		|ИЗ
		|	Документ." + КонтекстВыполнения.ИмяОбъекта + " КАК Документы
		|ГДЕ
		|	НЕ Документы.ПометкаУдаления
		|	И Документы." + ИмяРеквизита + " <> ЗНАЧЕНИЕ(Справочник." + ИмяСправочника + ".ПустаяСсылка)
		|УПОРЯДОЧИТЬ ПО
		|	Документы.Дата УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьПервуюСсылкуСправочника(ИмяСправочника)
	Если ПустаяСтрока(ИмяСправочника) ИЛИ НЕ ЭтоКорректныйИдентификатор1С(ИмяСправочника) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Элементы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Элементы
		|ГДЕ
		|	НЕ Элементы.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Элементы.Наименование";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьПоляПоискаСправочникаПоСтроке(ИмяСправочника)
	Результат = Новый Массив;
	Информация = ИИА_Метаданные.ПолучитьРеквизитыСправочника(ИмяСправочника);
	Если Информация = Неопределено ИЛИ ТипЗнч(Информация) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	Реквизиты = Неопределено;
	Если Информация.Свойство("Реквизиты") Тогда
		Реквизиты = Информация.Реквизиты;
	КонецЕсли;
	Если ТипЗнч(Реквизиты) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Реквизит Из Реквизиты Цикл
		Если ТипЗнч(Реквизит) <> Тип("Структура") И ТипЗнч(Реквизит) <> Тип("ФиксированнаяСтруктура") Тогда
			Продолжить;
		КонецЕсли;
		ИмяПоля = "";
		Если Реквизит.Свойство("Имя") Тогда
			ИмяПоля = СокрЛП(Строка(Реквизит.Имя));
		КонецЕсли;
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоКорректныйИдентификатор1С(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ИмяПоляВРег = ВРег(ИмяПоля);
		Если ИмяПоляВРег = "НАИМЕНОВАНИЕПОЛНОЕ"
			ИЛИ ИмяПоляВРег = "ПОЛНОЕНАИМЕНОВАНИЕ"
			ИЛИ ИмяПоляВРег = "НАИМЕНОВАНИЕ"
			ИЛИ ИмяПоляВРег = "DESCRIPTION" Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяПоляВРег = "КОД"
			ИЛИ ИмяПоляВРег = "ИНН"
			ИЛИ ИмяПоляВРег = "АРТИКУЛ"
			ИЛИ ИмяПоляВРег = "ШТРИХКОД"
			ИЛИ СтрНайти(ИмяПоляВРег, "ШТРИХКОД") > 0
			ИЛИ СтрНайти(ИмяПоляВРег, "НАИМЕНОВАН") > 0 Тогда
			Если Результат.Найти(ИмяПоля) = Неопределено Тогда
				Результат.Добавить(ИмяПоля);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Результат.Найти("Код") = Неопределено Тогда
		Результат.Добавить("Код");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоКорректныйИдентификатор1С(ИмяПоля)
	ИмяПоля = СокрЛП(Строка(ИмяПоля));
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(ИмяПоля) Цикл
		Символ = Сред(ИмяПоля, Позиция, 1);
		КодСимвола = КодСимвола(Символ);
		ЭтоЛатиница = (КодСимвола >= 65 И КодСимвола <= 90) ИЛИ (КодСимвола >= 97 И КодСимвола <= 122);
		ЭтоКириллица = (КодСимвола >= 1040 И КодСимвола <= 1103) ИЛИ КодСимвола = 1025 ИЛИ КодСимвола = 1105;
		ЭтоЦифра = КодСимвола >= 48 И КодСимвола <= 57;
		Если НЕ (ЭтоЛатиница ИЛИ ЭтоКириллица ИЛИ ЭтоЦифра ИЛИ Символ = "_") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Позиция = 1 И ЭтоЦифра Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция НайтиСсылкуДокументаПоНомеру(ИмяДокумента, НомерДокумента)
	Если ПустаяСтрока(ИмяДокумента) Или ПустаяСтрока(НомерДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Документы.Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Документы
	|ГДЕ
	|	Документы.Номер = &Номер";
	Запрос.УстановитьПараметр("Номер", НомерДокумента);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

Процедура УстановитьЗначениеРеквизита(Объект, ИмяРеквизита, Значение)
	ТипОбъекта = ТипЗнч(Объект);
	СтрокаТипа = Строка(ТипОбъекта);
	Если СтрНайти(СтрокаТипа, "Справочник объект") > 0 ИЛИ СтрНайти(СтрокаТипа, "Документ объект") > 0 Тогда
		Объект[ИмяРеквизита] = Значение;
	Иначе
		ВызватьИсключение "Неподдерживаемый тип объекта для установки реквизита: " + СтрокаТипа;
	КонецЕсли;
КонецПроцедуры

