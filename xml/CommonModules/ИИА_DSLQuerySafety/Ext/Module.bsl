#Область ПрограммныйИнтерфейс

Функция ИзвлечьПоляИзТекстаЗапроса(ТекстЗапроса) Экспорт
	Результат = Новый Массив;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПутиПолей = ИзвлечьПутиПолейИзТекстаЗапроса(ТекстЗапроса);
	Для Каждого ПутьПоля Из ПутиПолей Цикл
		ПоследнееПоле = Строка(ПутьПоля);
		ПозицияТочки = СтрНайти(ПоследнееПоле, ".");
		Пока ПозицияТочки > 0 Цикл
			ПоследнееПоле = Сред(ПоследнееПоле, ПозицияТочки + 1);
			ПозицияТочки = СтрНайти(ПоследнееПоле, ".");
		КонецЦикла;
		ПоследнееПоле = СокрЛП(ПоследнееПоле);
		Если НЕ ПустаяСтрока(ПоследнееПоле) И Результат.Найти(ПоследнееПоле) = Неопределено Тогда
			Результат.Добавить(ПоследнееПоле);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ИзвлечьПутиПолейИзТекстаЗапроса(ТекстЗапроса) Экспорт
	Результат = Новый Массив;
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НормТекст = ТекстЗапроса;
	НормТекст = СтрЗаменить(НормТекст, Символы.ПС, " ");
	НормТекст = СтрЗаменить(НормТекст, Символы.ВК, " ");
	НормТекст = СтрЗаменить(НормТекст, ",", " ");
	НормТекст = СтрЗаменить(НормТекст, ";", " ");
	НормТекст = СтрЗаменить(НормТекст, "(", " ");
	НормТекст = СтрЗаменить(НормТекст, ")", " ");
	НормТекст = СтрЗаменить(НормТекст, """", " ");
	НормТекст = СтрЗаменить(НормТекст, "'", " ");
	Части = СтрРазделить(НормТекст, " ", Ложь);
	
	Для Каждого Часть Из Части Цикл
		Токен = СокрЛП(Часть);
		Если ПустаяСтрока(Токен) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Токен, ".") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Сегменты = СтрРазделить(Токен, ".", Ложь);
		Префикс = ВРег(СокрЛП(Сегменты[0]));
		Если Префикс = "ДОКУМЕНТ"
			ИЛИ Префикс = "СПРАВОЧНИК"
			ИЛИ Префикс = "РЕГИСТРНАКОПЛЕНИЯ"
			ИЛИ Префикс = "РЕГИСТРСВЕДЕНИЙ"
			ИЛИ Префикс = "РЕГИСТРБУХГАЛТЕРИИ" Тогда
			Продолжить;
		КонецЕсли;
		
		НормПуть = Токен;
		Если Сегменты.Количество() > 2 Тогда
			НормПуть = "";
			Для ИндексСегмента = 1 По Сегменты.Количество() - 1 Цикл
				Если ПустаяСтрока(НормПуть) Тогда
					НормПуть = Сегменты[ИндексСегмента];
				Иначе
					НормПуть = НормПуть + "." + Сегменты[ИндексСегмента];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		НормПуть = СокрЛП(НормПуть);
		Если НЕ ПустаяСтрока(НормПуть) И Результат.Найти(НормПуть) = Неопределено Тогда
			Результат.Добавить(НормПуть);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ПроверитьQuerySafetyGate(ТекстЗапроса, КонтекстВыполнения) Экспорт
	Результат = Новый Структура("Успех,КодОшибки,Сообщение,Контекст", Истина, "", "", Неопределено);
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Пустой текст запроса";
		Результат.Контекст = Новый Структура("reason", "empty_query");
		Возврат Результат;
	КонецЕсли;
	
	Если СтрДлина(ТекстЗапроса) > 5000 Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Запрос слишком длинный, превышает лимит безопасности.";
		Результат.Контекст = Новый Структура("reason,limit", "query_too_long", 5000);
		Возврат Результат;
	КонецЕсли;
	
	ПроверкаЗапрета = ПроверитьЗапрещенныеКонструкцииЗапроса(ТекстЗапроса);
	Если НЕ ПроверкаЗапрета.Успех Тогда
		Возврат ПроверкаЗапрета;
	КонецЕсли;
	
	Если КонтекстВыполнения.Свойство("DSL_РазрешенныеПоляОбъекта") И ТипЗнч(КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта) = Тип("Массив") Тогда
		Разрешенные = КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта;
		Если Разрешенные.Количество() > 0 Тогда
			ПоляЗапроса = ИзвлечьПоляИзТекстаЗапроса(ТекстЗапроса);
			ПутиЗапроса = ИзвлечьПутиПолейИзТекстаЗапроса(ТекстЗапроса);
			РазрешенныеПути = Новый Массив;
			Если КонтекстВыполнения.Свойство("DSL_РазрешенныеПутиПолейОбъекта")
				И ТипЗнч(КонтекстВыполнения.DSL_РазрешенныеПутиПолейОбъекта) = Тип("Массив") Тогда
				РазрешенныеПути = КонтекстВыполнения.DSL_РазрешенныеПутиПолейОбъекта;
			КонецЕсли;
			
			Неизвестные = Новый Массив;
			Для Каждого ПолеЗапроса Из ПоляЗапроса Цикл
				Найдено = Ложь;
				Для Каждого ПолеРазрешенное Из Разрешенные Цикл
					Если ВРег(Строка(ПолеРазрешенное)) = ВРег(Строка(ПолеЗапроса)) Тогда
						Найдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ Найдено Тогда
					Для Каждого ПутьЗапросаИзПоля Из ПутиЗапроса Цикл
						ДлинаПоля = СтрДлина(Строка(ПолеЗапроса));
						ПутьВРег = ВРег(Строка(ПутьЗапросаИзПоля));
						ПолеВРег = ВРег(Строка(ПолеЗапроса));
						Если СтрДлина(ПутьВРег) <= ДлинаПоля + 1 Тогда
							Продолжить;
						КонецЕсли;
						Если Прав(ПутьВРег, ДлинаПоля + 1) <> "." + ПолеВРег Тогда
							Продолжить;
						КонецЕсли;
						Для Каждого ПутьРазрешенный Из РазрешенныеПути Цикл
							Если ВРег(Строка(ПутьРазрешенный)) = ПутьВРег Тогда
								Найдено = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если Найдено Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ Найдено И ВРег(Строка(ПолеЗапроса)) = "НАИМЕНОВАНИЕ" Тогда
					Для Каждого ПутьЗапросаИзПоля Из ПутиЗапроса Цикл
						Если ПолучитьПоследнийСегментПути(ПутьЗапросаИзПоля) <> "Наименование" Тогда
							Продолжить;
						КонецЕсли;
						БазовоеПолеПути = ПолучитьПервыйСегментПути(ПутьЗапросаИзПоля);
						Для Каждого ПолеРазрешенное Из Разрешенные Цикл
							Если ВРег(Строка(ПолеРазрешенное)) = ВРег(БазовоеПолеПути) Тогда
								Найдено = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если Найдено Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ Найдено Тогда
					Неизвестные.Добавить(ПолеЗапроса);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ПутьЗапроса Из ПутиЗапроса Цикл
				Если СтрНайти(Строка(ПутьЗапроса), ".") = 0 Тогда
					Продолжить;
				КонецЕсли;
				НайденоПуть = Ложь;
				ПоследнееПолеПути = ПолучитьПоследнийСегментПути(ПутьЗапроса);
				Для Каждого ПолеРазрешенное Из Разрешенные Цикл
					Если ВРег(Строка(ПолеРазрешенное)) = ВРег(ПоследнееПолеПути) Тогда
						НайденоПуть = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Для Каждого ПутьРазрешенный Из РазрешенныеПути Цикл
					Если ВРег(Строка(ПутьРазрешенный)) = ВРег(Строка(ПутьЗапроса)) Тогда
						НайденоПуть = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ НайденоПуть И ПолучитьПоследнийСегментПути(ПутьЗапроса) = "Наименование" Тогда
					БазовоеПолеПути = ПолучитьПервыйСегментПути(ПутьЗапроса);
					Для Каждого ПолеРазрешенное Из Разрешенные Цикл
						Если ВРег(Строка(ПолеРазрешенное)) = ВРег(БазовоеПолеПути) Тогда
							НайденоПуть = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ НайденоПуть Тогда
					Неизвестные.Добавить(ПутьЗапроса);
				КонецЕсли;
			КонецЦикла;
			
			Если Неизвестные.Количество() > 0 Тогда
				Результат.Успех = Ложь;
				Результат.КодОшибки = "query_safety_violation";
				Результат.Сообщение = "Query Safety Gate: обнаружены поля вне whitelist GetObjectFields: " + СтрСоединить(Неизвестные, ", ");
				Результат.Контекст = Новый Структура("reason,unknown_fields", "field_whitelist_violation", СтрСоединить(Неизвестные, ","));
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьСоединениеБезУсловия(ТекстЗапроса) Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Query Safety Gate: соединение без условия ПО запрещено.";
		Результат.Контекст = Новый Структура("reason", "cartesian_join");
		Возврат Результат;
	КонецЕсли;
	
	Если ЕстьТавтологическоеСоединение(ТекстЗапроса) Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Query Safety Gate: соединение с тавтологическим условием ПО запрещено.";
		Результат.Контекст = Новый Структура("reason", "cartesian_join_tautology");
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЭтоНеограниченныйРежимЗапроса(КонтекстВыполнения) И ЕстьВыборкаВерхнегоУровняБезПервые(ТекстЗапроса) Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Query Safety Gate: у выборки верхнего уровня нет ограничения ПЕРВЫЕ.";
		Результат.Контекст = Новый Структура("reason,limit", "missing_top", МаксимумСтрокРезультатаЗапроса());
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция МаксимумСтрокРезультатаЗапроса() Экспорт
	Возврат 500;
КонецФункции

Функция ЭтоНеограниченныйРежимЗапроса(КонтекстВыполнения) Экспорт
	Если КонтекстВыполнения = Неопределено Или ТипЗнч(КонтекстВыполнения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если КонтекстВыполнения.Свойство("DSL_НеограниченныеЗапросы") Тогда
		Возврат КонтекстВыполнения.DSL_НеограниченныеЗапросы = Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ШагЗапрашиваетНеограниченныйРежим(Шаг) Экспорт
	Если Шаг = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Имена = СтрРазделить("unlimited,no_row_limit,unlimited_rows,без_лимита", ",", Ложь);
	Для Каждого ИмяФлага Из Имена Цикл
		Если ЗначениеФлагаНеограниченногоРежима(ПолучитьСвойствоШагаЗапроса(Шаг, СокрЛП(ИмяФлага))) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ПрименитьФлагНеограниченногоРежимаККонтексту(Шаг, КонтекстВыполнения) Экспорт
	Если НЕ ШагЗапрашиваетНеограниченныйРежим(Шаг) Тогда
		Возврат;
	КонецЕсли;
	Если КонтекстВыполнения = Неопределено Или ТипЗнч(КонтекстВыполнения) <> Тип("Структура") Тогда
		ВызватьИсключение "Нельзя включить unlimited для RunQuery: контекст выполнения не задан.";
	КонецЕсли;
	КонтекстВыполнения.Вставить("DSL_НеограниченныеЗапросы", Истина);
КонецПроцедуры

Функция ОписаниеРисковНеограниченныхЗапросов() Экспорт
	Возврат "unlimited=true снимает ПЕРВЫЕ (обычно 100, не больше 500) и усечение выгрузки. Риски: долгий запрос, нагрузка на СУБД, нехватка памяти сеанса. По-прежнему запрещены DML, JOIN без ПО и ПО 1=1.";
КонецФункции

Функция ПолучитьСвойствоШагаЗапроса(Шаг, ИмяСвойства)
	Если ТипЗнч(Шаг) = Тип("Структура") Тогда
		Если Шаг.Свойство(ИмяСвойства) Тогда
			Возврат Шаг[ИмяСвойства];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Шаг) = Тип("Соответствие") Тогда
		Возврат Шаг.Получить(ИмяСвойства);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗначениеФлагаНеограниченногоРежима(Значение)
	Если Значение = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Возврат Текст = "TRUE" Или Текст = "ИСТИНА" Или Текст = "1" Или Текст = "YES" Или Текст = "ДА";
КонецФункции

Функция ПроверитьЗапрещенныеКонструкцииЗапроса(ТекстЗапроса) Экспорт
	Результат = Новый Структура("Успех,КодОшибки,Сообщение,Контекст", Истина, "", "", Неопределено);
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ТекстБезПробелов = СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстВРег, " ", ""), Символы.ПС, ""), Символы.Таб, "");
	Если СтрНайти(ТекстБезПробелов, "СТРНАЙТИ(") > 0
		Или СтрНайти(ТекстБезПробелов, "STRFIND(") > 0
		Или СтрНайти(ТекстБезПробелов, "СТРНАЧИНАЕТСЯС(") > 0
		Или СтрНайти(ТекстБезПробелов, "STRSTARTSWITH(") > 0
		Или СтрНайти(ТекстБезПробелов, "ПОДОБИЕ(") > 0
		Или СтрНайти(ТекстБезПробелов, "SIMILARITY(") > 0
		Или СтрНайти(ТекстБезПробелов, "НАЙТИ(") > 0 Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Query Safety Gate: недопустимая функция в запросе. В языке запросов 1С для поиска строк используйте только ПОДОБНО.";
		Результат.Контекст = Новый Структура("reason", "forbidden_functions");
		Возврат Результат;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "ИЗМЕНИТЬ") > 0
		Или СтрНайти(ТекстВРег, "УДАЛИТЬ") > 0
		Или СтрНайти(ТекстВРег, "ВСТАВИТЬ") > 0
		Или СтрНайти(ТекстВРег, "ОБНОВИТЬ") > 0 Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "query_safety_violation";
		Результат.Сообщение = "Query Safety Gate: операции изменения данных в RunQuery запрещены.";
		Результат.Контекст = Новый Структура("reason", "mutating_operations");
		Возврат Результат;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЕстьСоединениеБезУсловия(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Маркеры = СтрРазделить("ЛЕВОЕ СОЕДИНЕНИЕ,ПРАВОЕ СОЕДИНЕНИЕ,ВНУТРЕННЕЕ СОЕДИНЕНИЕ,ПОЛНОЕ СОЕДИНЕНИЕ,СОЕДИНЕНИЕ", ",");
	Для Каждого Маркер Из Маркеры Цикл
		Поз = 1;
		Пока Истина Цикл
			Хвост = Сред(ТекстВРег, Поз);
			Смещение = СтрНайти(Хвост, Маркер);
			Если Смещение = 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = Поз + Смещение - 1;
			Если Маркер = "СОЕДИНЕНИЕ" Тогда
				Префикс = "";
				Если Поз > 1 Тогда
					Префикс = Сред(ТекстВРег, Макс(1, Поз - 8), Мин(8, Поз - 1));
				КонецЕсли;
				Если СтрЗаканчиваетсяНа(СокрЛП(Префикс), "ЛЕВОЕ")
					Или СтрЗаканчиваетсяНа(СокрЛП(Префикс), "ПРАВОЕ")
					Или СтрЗаканчиваетсяНа(СокрЛП(Префикс), "ВНУТРЕННЕЕ")
					Или СтрЗаканчиваетсяНа(СокрЛП(Префикс), "ПОЛНОЕ") Тогда
					Поз = Поз + СтрДлина(Маркер);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			НачалоПослеМаркера = Поз + СтрДлина(Маркер);
			ПозПо = НайтиКлючевоеСловоПослеСоединения(ТекстВРег, "ПО", НачалоПослеМаркера);
			ПозСлед = БлижайшаяГраницаПослеСоединения(ТекстВРег, НачалоПослеМаркера);
			Если ПозПо = 0 Или (ПозСлед > 0 И ПозПо > ПозСлед) Тогда
				Возврат Истина;
			КонецЕсли;
			Поз = НачалоПослеМаркера;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЕстьТавтологическоеСоединение(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Маркеры = СтрРазделить("ЛЕВОЕ СОЕДИНЕНИЕ,ПРАВОЕ СОЕДИНЕНИЕ,ВНУТРЕННЕЕ СОЕДИНЕНИЕ,ПОЛНОЕ СОЕДИНЕНИЕ,СОЕДИНЕНИЕ", ",");
	Для Каждого Маркер Из Маркеры Цикл
		Поз = 1;
		Пока Истина Цикл
			Смещение = СтрНайти(Сред(ТекстВРег, Поз), Маркер);
			Если Смещение = 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = Поз + Смещение - 1;
			НачалоПослеМаркера = Поз + СтрДлина(Маркер);
			ПозПо = НайтиКлючевоеСловоПослеСоединения(ТекстВРег, "ПО", НачалоПослеМаркера);
			Если ПозПо = 0 Тогда
				Поз = НачалоПослеМаркера;
				Продолжить;
			КонецЕсли;
			НачалоУсловия = ПозПо + 2;
			КонецУсловия = БлижайшаяГраницаПослеСоединения(ТекстВРег, НачалоУсловия);
			Если КонецУсловия = 0 Тогда
				КонецУсловия = СтрДлина(Текст) + 1;
			КонецЕсли;
			Условие = СокрЛП(Сред(Текст, НачалоУсловия, КонецУсловия - НачалоУсловия));
			Если ЭтоТавтологияУсловияСоединения(Условие) Тогда
				Возврат Истина;
			КонецЕсли;
			Поз = НачалоПослеМаркера;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЕстьВыборкаВерхнегоУровняБезПервые(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		Поз = НайтиТокенЗапросаНаВерхнемУровне(ТекстВРег, "ВЫБРАТЬ", ПозицияПоиска);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Индекс = ПропуститьПробелыТекстаЗапроса(Текст, Поз + СтрДлина("ВЫБРАТЬ"));
		Если ВРег(Сред(Текст, Индекс, 6)) <> "ПЕРВЫЕ" Тогда
			Возврат Истина;
		КонецЕсли;
		ПозицияПоиска = Индекс + 6;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоТавтологияУсловияСоединения(Условие)
	Норм = ВРег(СокрЛП(Строка(Условие)));
	Норм = СтрЗаменить(Норм, " ", "");
	Норм = СтрЗаменить(Норм, Символы.ПС, "");
	Норм = СтрЗаменить(Норм, Символы.Таб, "");
	Возврат Норм = "1=1" Или Норм = "ИСТИНА" Или Норм = "TRUE";
КонецФункции

Функция НайтиКлючевоеСловоПослеСоединения(ТекстВРег, Слово, Начало)
	Поз = НайтиТокенЗапросаНаВерхнемУровне(ТекстВРег, Слово, Начало);
	Возврат Поз;
КонецФункции

Функция БлижайшаяГраницаПослеСоединения(ТекстВРег, Начало)
	Границы = СтрРазделить("ГДЕ,СГРУППИРОВАТЬ,ИМЕЮЩИЕ,ОБЪЕДИНИТЬ,УПОРЯДОЧИТЬ,ЛЕВОЕ СОЕДИНЕНИЕ,ПРАВОЕ СОЕДИНЕНИЕ,ВНУТРЕННЕЕ СОЕДИНЕНИЕ,ПОЛНОЕ СОЕДИНЕНИЕ", ",", Ложь);
	Ближайшая = 0;
	Для Каждого Граница Из Границы Цикл
		Поз = НайтиТокенЗапросаНаВерхнемУровне(ТекстВРег, СокрЛП(Граница), Начало);
		Если Поз > 0 И (Ближайшая = 0 Или Поз < Ближайшая) Тогда
			Ближайшая = Поз;
		КонецЕсли;
	КонецЦикла;
	Возврат Ближайшая;
КонецФункции

Функция НайтиТокенЗапросаНаВерхнемУровне(ТекстВРег, Слово, НачальныйИндекс)
	ДлинаСлова = СтрДлина(Слово);
	Если ДлинаСлова = 0 Или НачальныйИндекс < 1 Тогда
		Возврат 0;
	КонецЕсли;
	Глубина = 0;
	ВКавычках = Ложь;
	Для Индекс = НачальныйИндекс По СтрДлина(ТекстВРег) Цикл
		Символ = Сред(ТекстВРег, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Продолжить;
		КонецЕсли;
		Если ВКавычках Тогда
			Продолжить;
		КонецЕсли;
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
			Продолжить;
		КонецЕсли;
		Если Символ = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Глубина > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Сред(ТекстВРег, Индекс, ДлинаСлова) <> Слово Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоГраницаТокенаЗапроса(ТекстВРег, Индекс - 1) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоГраницаТокенаЗапроса(ТекстВРег, Индекс + ДлинаСлова) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Индекс;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ЭтоГраницаТокенаЗапроса(Текст, Индекс)
	Если Индекс < 1 Или Индекс > СтрДлина(Текст) Тогда
		Возврат Истина;
	КонецЕсли;
	Символ = Сред(Текст, Индекс, 1);
	Возврат СтрНайти(" " + Символы.ПС + Символы.ВК + Символы.Таб + ",;()=", Символ) > 0;
КонецФункции

Функция ПропуститьПробелыТекстаЗапроса(Текст, НачальныйИндекс)
	Индекс = НачальныйИндекс;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ <> " " И Символ <> Символы.ПС И Символ <> Символы.ВК И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Индекс;
КонецФункции

Функция ПолучитьПоследнийСегментПути(ПутьПоля)

	Результат = Строка(ПутьПоля);
	ПозицияТочки = СтрНайти(Результат, ".");
	Пока ПозицияТочки > 0 Цикл
		Результат = Сред(Результат, ПозицияТочки + 1);
		ПозицияТочки = СтрНайти(Результат, ".");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

Функция ПолучитьПервыйСегментПути(ПутьПоля)

	Результат = СокрЛП(Строка(ПутьПоля));
	ПозицияТочки = СтрНайти(Результат, ".");
	Если ПозицияТочки > 0 Тогда
		Возврат Лев(Результат, ПозицияТочки - 1);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НормализоватьТипОбъектаМетаданных(ТипОбъекта) Экспорт
	ТипВРег = ВРег(СокрЛП(Строка(ТипОбъекта)));
	Если ТипВРег = "DOCUMENT" Или ТипВРег = "ДОКУМЕНТ" Или ТипВРег = "ДОКУМЕНТЫ" Тогда
		Возврат "Документ";
	ИначеЕсли ТипВРег = "CATALOG" Или ТипВРег = "DIRECTORY" Или ТипВРег = "REFERENCE"
		Или ТипВРег = "СПРАВОЧНИК" Или ТипВРег = "СПРАВОЧНИКИ" Тогда
		Возврат "Справочник";
	ИначеЕсли ТипВРег = "ACCUMREG" Или ТипВРег = "ACCUMULATIONREGISTER"
		Или ТипВРег = "REGISTER_ACCUMULATION" Или ТипВРег = "REGISTERACCUMULATION"
		Или ТипВРег = "РЕГИСТРНАКОПЛЕНИЯ" Тогда
		Возврат "РегистрНакопления";
	ИначеЕсли ТипВРег = "INFOREG" Или ТипВРег = "INFORMATIONREGISTER"
		Или ТипВРег = "REGISTER_INFORMATION" Или ТипВРег = "REGISTERINFORMATION"
		Или ТипВРег = "РЕГИСТРСВЕДЕНИЙ" Тогда
		Возврат "РегистрСведений";
	ИначеЕсли ТипВРег = "ACCOUNTINGREGISTER" Или ТипВРег = "REGISTER_ACCOUNTING"
		Или ТипВРег = "REGISTERACCOUNTING" Или ТипВРег = "РЕГИСТРБУХГАЛТЕРИИ" Тогда
		Возврат "РегистрБухгалтерии";
	КонецЕсли;
	Возврат СокрЛП(Строка(ТипОбъекта));
КонецФункции

Процедура НормализоватьПоляОбъектаШага(Шаг) Экспорт
	Если Шаг = Неопределено Или ТипЗнч(Шаг) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ПолноеИмя = "";
	Если Шаг.Свойство("object_path") Тогда
		ПолноеИмя = СокрЛП(Строка(Шаг.object_path));
	КонецЕсли;
	Если ПустаяСтрока(ПолноеИмя) И Шаг.Свойство("object") Тогда
		ПолноеИмя = СокрЛП(Строка(Шаг.object));
	КонецЕсли;
	Если ПустаяСтрока(ПолноеИмя) И Шаг.Свойство("object_name") Тогда
		ПолноеИмя = СокрЛП(Строка(Шаг.object_name));
	КонецЕсли;
	ТипОбъекта = "";
	Если Шаг.Свойство("object_type") Тогда
		ТипОбъекта = НормализоватьТипОбъектаМетаданных(Шаг.object_type);
	КонецЕсли;
	Если НЕ ЭтоКаноническийКлассМетаданных(ТипОбъекта) И НЕ ПустаяСтрока(ТипОбъекта) Тогда
		ИмяКакТип = СокрЛП(Строка(ТипОбъекта));
		ИмяСправочника = РазрешитьИмяСправочника(ИмяКакТип);
		Если НЕ ПустаяСтрока(ИмяСправочника) Тогда
			ИмяЭлемента = ПолноеИмя;
			ТипОбъекта = "Справочник";
			ПолноеИмя = ИмяСправочника;
			Если НЕ ПустаяСтрока(ИмяЭлемента) И ВРег(ИмяЭлемента) <> ВРег(ИмяСправочника)
				И ВРег(ИмяЭлемента) <> ВРег(ИмяКакТип) Тогда
				Шаг.Вставить("name", ИмяЭлемента);
			КонецЕсли;
		ИначеЕсли ИИА_Метаданные.СуществуетДокумент(ИмяКакТип) Тогда
			ИмяЭлемента = ПолноеИмя;
			ТипОбъекта = "Документ";
			ПолноеИмя = ИмяКакТип;
			Если НЕ ПустаяСтрока(ИмяЭлемента) И ВРег(ИмяЭлемента) <> ВРег(ИмяКакТип) Тогда
				Шаг.Вставить("name", ИмяЭлемента);
			КонецЕсли;
		Иначе
			ИмяДокумента = ПодобратьИмяДокументаПоКороткомуТипу(ИмяКакТип);
			Если НЕ ПустаяСтрока(ИмяДокумента) Тогда
				ИмяЭлемента = ПолноеИмя;
				ТипОбъекта = "Документ";
				ПолноеИмя = ИмяДокумента;
				Если НЕ ПустаяСтрока(ИмяЭлемента) И ВРег(ИмяЭлемента) <> ВРег(ИмяДокумента)
					И ВРег(ИмяЭлемента) <> ВРег(ИмяКакТип) Тогда
					Шаг.Вставить("name", ИмяЭлемента);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ИмяОбъекта = НормализоватьИмяОбъектаМетаданных(ПолноеИмя, ТипОбъекта);
	Если СтрНайти(ПолноеИмя, ".") > 0 И ПустаяСтрока(ТипОбъекта) Тогда
		ТипОбъекта = НормализоватьТипОбъектаМетаданных(Лев(ПолноеИмя, СтрНайти(ПолноеИмя, ".") - 1));
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТипОбъекта) Тогда
		Шаг.Вставить("object_type", ТипОбъекта);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ИмяОбъекта) Тогда
		Шаг.Вставить("object_name", ИмяОбъекта);
	КонецЕсли;
КонецПроцедуры

Функция ЭтоКаноническийКлассМетаданных(ТипОбъекта)
	ТипВРег = ВРег(СокрЛП(Строка(ТипОбъекта)));
	Возврат ТипВРег = "ДОКУМЕНТ"
		Или ТипВРег = "СПРАВОЧНИК"
		Или ТипВРег = "РЕГИСТРНАКОПЛЕНИЯ"
		Или ТипВРег = "РЕГИСТРСВЕДЕНИЙ"
		Или ТипВРег = "РЕГИСТРБУХГАЛТЕРИИ";
КонецФункции

Функция ПодобратьИмяДокументаПоКороткомуТипу(КороткоеИмя)
	ИмяВРег = ВРег(СокрЛП(Строка(КороткоеИмя)));
	Если ПустаяСтрока(ИмяВРег) Или СтрДлина(ИмяВРег) < 3 Тогда
		Возврат "";
	КонецЕсли;
	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			ИмяДокумента = Строка(МетаданныеДокумента.Имя);
			Текст = ВРег(ИмяДокумента + " " + Строка(МетаданныеДокумента.Синоним));
			Если СтрНайти(Текст, ИмяВРег) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Оценка = 10;
			Если СтрНачинаетсяС(ВРег(ИмяДокумента), ИмяВРег) Тогда
				Оценка = Оценка + 40;
			КонецЕсли;
			Если СтрНайти(Текст, "ФАКТУР") > 0 Или СтрНайти(Текст, "КОРРЕКТИРОВКА") > 0 Тогда
				Оценка = Оценка - 20;
			КонецЕсли;
			Если СтрНайти(Текст, "ПОСТАВЩ") > 0 Или СтрНайти(Текст, "ПРИХОД") > 0 Тогда
				Оценка = Оценка + 10;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = ИмяДокумента;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ЛучшееИмя;
КонецФункции

Функция НормализоватьИмяОбъектаМетаданных(ИмяОбъекта, ТипОжидаемый = "") Экспорт
	Имя = СокрЛП(Строка(ИмяОбъекта));
	Если СтрНачинаетсяС(Имя, "Документы.") Тогда
		Имя = СокрЛП(Сред(Имя, 11));
	ИначеЕсли СтрНачинаетсяС(Имя, "Документ.") Тогда
		Имя = СокрЛП(Сред(Имя, 10));
	ИначеЕсли СтрНачинаетсяС(Имя, "Справочники.") Тогда
		Имя = СокрЛП(Сред(Имя, 13));
	ИначеЕсли СтрНачинаетсяС(Имя, "Справочник.") Тогда
		Имя = СокрЛП(Сред(Имя, 12));
	ИначеЕсли СтрНачинаетсяС(Имя, "РегистрНакопления.") Тогда
		Имя = СокрЛП(Сред(Имя, 19));
	ИначеЕсли СтрНачинаетсяС(Имя, "РегистрСведений.") Тогда
		Имя = СокрЛП(Сред(Имя, 17));
	ИначеЕсли СтрНачинаетсяС(Имя, "РегистрБухгалтерии.") Тогда
		Имя = СокрЛП(Сред(Имя, 20));
	КонецЕсли;
	ИмяВРег = ВРег(Имя);
	Суффиксы = Новый Массив;
	Суффиксы.Добавить(".ОСТАТКИИОБОРОТЫ");
	Суффиксы.Добавить(".ОСТАТКИ");
	Суффиксы.Добавить(".ОБОРОТЫ");
	Для Каждого Суффикс Из Суффиксы Цикл
		Поз = СтрНайти(ИмяВРег, Суффикс);
		Если Поз > 0 Тогда
			Имя = Лев(Имя, Поз - 1);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;
КонецФункции

Функция РазрешитьИмяСправочника(ИсходноеИмяСправочника, КонтекстВыполнения = Неопределено) Экспорт
	ИмяСправочника = НормализоватьИмяОбъектаМетаданных(ИсходноеИмяСправочника, "Справочник");
	Если ИИА_Метаданные.СуществуетСправочник(ИмяСправочника) Тогда
		Возврат ИмяСправочника;
	КонецЕсли;
	
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(ИмяСправочника + "ы");
	Кандидаты.Добавить(ИмяСправочника + "и");
	Кандидаты.Добавить(ИмяСправочника + "а");
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ИИА_Метаданные.СуществуетСправочник(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	
	Похожие = ИИА_Метаданные.НайтиПохожиеОбъекты(ИмяСправочника, "Справочник");
	Для Каждого Похожий Из Похожие Цикл
		Если ИИА_Метаданные.СуществуетСправочник(Похожий) Тогда
			Возврат Похожий;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
