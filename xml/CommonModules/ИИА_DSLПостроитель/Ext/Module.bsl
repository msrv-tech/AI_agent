Функция СериализоватьJSONВСтроку(ЗначениеJSON) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ЗначениеJSON);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ПолучитьПараметрШагаПлана(ШагПлана, ИмяПараметра, ЗначениеПоУмолчанию = "")
	Если ШагПлана = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Вход = Неопределено;
	Если (ТипЗнч(ШагПлана) = Тип("Структура") Или ТипЗнч(ШагПлана) = Тип("ФиксированнаяСтруктура")) И ШагПлана.Свойство("input", Вход) Тогда
		Если (ТипЗнч(Вход) = Тип("Структура") Или ТипЗнч(Вход) = Тип("ФиксированнаяСтруктура")) И Вход.Свойство(ИмяПараметра) Тогда
			Возврат Вход[ИмяПараметра];
		ИначеЕсли ТипЗнч(Вход) = Тип("Соответствие") Или ТипЗнч(Вход) = Тип("ФиксированноеСоответствие") Тогда
			ЛокЗначение = Вход.Получить(ИмяПараметра);
			Если ЛокЗначение <> Неопределено Тогда
				Возврат ЛокЗначение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если (ТипЗнч(ШагПлана) = Тип("Структура") Или ТипЗнч(ШагПлана) = Тип("ФиксированнаяСтруктура")) И ШагПлана.Свойство(ИмяПараметра) Тогда
		Возврат ШагПлана[ИмяПараметра];
	ИначеЕсли ТипЗнч(ШагПлана) = Тип("Соответствие") Или ТипЗнч(ШагПлана) = Тип("ФиксированноеСоответствие") Тогда
		ЛокЗначение = ШагПлана.Получить(ИмяПараметра);
		Если ЛокЗначение <> Неопределено Тогда
			Возврат ЛокЗначение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ЗначениеФлагаНеограниченногоРежимаШагаПлана(ШагПлана)
	Флаги = Новый Структура;
	Флаги.Вставить("unlimited", ПолучитьПараметрШагаПлана(ШагПлана, "unlimited", Ложь));
	Флаги.Вставить("no_row_limit", ПолучитьПараметрШагаПлана(ШагПлана, "no_row_limit", Ложь));
	Флаги.Вставить("unlimited_rows", ПолучитьПараметрШагаПлана(ШагПлана, "unlimited_rows", Ложь));
	Флаги.Вставить("без_лимита", ПолучитьПараметрШагаПлана(ШагПлана, "без_лимита", Ложь));
	Возврат ИИА_DSLQuerySafety.ШагЗапрашиваетНеограниченныйРежим(Флаги);
КонецФункции

Функция ПолучитьСвойствоИзСтруктуры(Объект, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	Если Объект = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Попытка
		Если (ТипЗнч(Объект) = Тип("Структура") Или ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура")) И Объект.Свойство(ИмяСвойства) Тогда
			Возврат Объект[ИмяСвойства];
		КонецЕсли;
		Если ТипЗнч(Объект) = Тип("Соответствие") Или ТипЗнч(Объект) = Тип("ФиксированноеСоответствие") Тогда
			ЗначениеСвойства = Объект.Получить(ИмяСвойства);
			Если ЗначениеСвойства <> Неопределено Тогда
				Возврат ЗначениеСвойства;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ЭтоМассивоподобноеЗначение(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив");
КонецФункции

Функция ЭтоИстинноеЗначениеПлана(Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	ТекстЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат ТекстЗначения = "TRUE"
		ИЛИ ТекстЗначения = "ИСТИНА"
		ИЛИ ТекстЗначения = "YES"
		ИЛИ ТекстЗначения = "ДА"
		ИЛИ ТекстЗначения = "1";
КонецФункции

Функция ПолучитьЭлементМассиваУниверсально(Коллекция, Индекс)
	Если Коллекция = Неопределено Или НЕ ЭтоМассивоподобноеЗначение(Коллекция) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Индекс < 0 Или Индекс >= Коллекция.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Коллекция[Индекс];
КонецФункции

Функция ЭкранироватьСтрокуДляЗапроса(Значение)
	Возврат СтрЗаменить(Строка(Значение), """", """""");
КонецФункции

Функция ФорматироватьЦелоеДляЗапроса(Значение)
	Возврат Формат(Число(Значение), "ЧГ=0; ЧН=0");
КонецФункции

Функция СоздатьМассивСтрок(Значения) Экспорт
	Результат = Новый Массив;
	Если Значения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Результат.Добавить(Строка(Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПостроитьЛитералДаты1С(ДатаЗначение)
	Возврат "ДАТАВРЕМЯ(" 
		+ ФорматироватьЦелоеДляЗапроса(Год(ДатаЗначение)) + ","
		+ ФорматироватьЦелоеДляЗапроса(Месяц(ДатаЗначение)) + ","
		+ ФорматироватьЦелоеДляЗапроса(День(ДатаЗначение)) + ","
		+ ФорматироватьЦелоеДляЗапроса(Час(ДатаЗначение)) + ","
		+ ФорматироватьЦелоеДляЗапроса(Минута(ДатаЗначение)) + ","
		+ ФорматироватьЦелоеДляЗапроса(Секунда(ДатаЗначение)) + ")";
КонецФункции

Функция ПолучитьНачалоКалендарнойНедели(МоментВремени)
	НомерДняНедели = ДеньНедели(МоментВремени);
	Если НомерДняНедели <= 0 Тогда
		НомерДняНедели = 7;
	КонецЕсли;
	Возврат НачалоДня(МоментВремени - (НомерДняНедели - 1) * 24 * 60 * 60);
КонецФункции

Функция ПолучитьНачалоМесяцаЛокально(МоментВремени)
	Возврат Дата(Год(МоментВремени), Месяц(МоментВремени), 1);
КонецФункции

Функция ПолучитьКонецМесяцаЛокально(МоментВремени)
	ГодЗнач = Год(МоментВремени);
	МесяцЗнач = Месяц(МоментВремени);
	Если МесяцЗнач = 12 Тогда
		СледующийМесяц = Дата(ГодЗнач + 1, 1, 1);
	Иначе
		СледующийМесяц = Дата(ГодЗнач, МесяцЗнач + 1, 1);
	КонецЕсли;
	Возврат КонецДня(СледующийМесяц - 24 * 60 * 60);
КонецФункции

Функция ОпределитьЕдиницуПериодаИзТекста(ПериодВРег)
	Если СтрНайти(ПериодВРег, "ДЕН") > 0 Тогда
		Возврат "DAY";
	КонецЕсли;
	Если СтрНайти(ПериодВРег, "НЕДЕЛ") > 0 Тогда
		Возврат "WEEK";
	КонецЕсли;
	Если СтрНайти(ПериодВРег, "МЕСЯЦ") > 0 Тогда
		Возврат "MONTH";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СодержитЛюбойМаркерПериода(ПериодВРег, Маркеры)
	Для Каждого Маркер Из Маркеры Цикл
		Если СтрНайти(ПериодВРег, ВРег(Строка(Маркер))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПопробоватьПолучитьГраницыСтандартногоПериода(ПериодВРег, Сейчас)
	Результат = Новый Структура("Начало,Конец", Неопределено, Неопределено);
	Единица = ОпределитьЕдиницуПериодаИзТекста(ПериодВРег);
	Если ПустаяСтрока(Единица) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МаркерыПрошлого = Новый Массив;
	МаркерыПрошлого.Добавить("ПРОШЛ");
	МаркерыПрошлого.Добавить("ПРЕДЫДУЩ");
	МаркерыТекущего = Новый Массив;
	МаркерыТекущего.Добавить("ТЕКУЩ");
	МаркерыСкользящего = Новый Массив;
	МаркерыСкользящего.Добавить("ЗА ");
	МаркерыСкользящего.Добавить("ПОСЛЕДН");
	ЭтоПрошлыйЗавершенный = СодержитЛюбойМаркерПериода(ПериодВРег, МаркерыПрошлого);
	ЭтоТекущий = СодержитЛюбойМаркерПериода(ПериодВРег, МаркерыТекущего);
	ЭтоСкользящий = СодержитЛюбойМаркерПериода(ПериодВРег, МаркерыСкользящего);
	
	Если ЭтоПрошлыйЗавершенный Тогда
		Если Единица = "WEEK" Тогда
			НачалоТекущейНедели = ПолучитьНачалоКалендарнойНедели(Сейчас);
			Результат.Начало = НачалоТекущейНедели - 7 * 24 * 60 * 60;
			Результат.Конец = КонецДня(НачалоТекущейНедели - 24 * 60 * 60);
			Возврат Результат;
		ИначеЕсли Единица = "MONTH" Тогда
			НачалоТекущегоМесяца = ПолучитьНачалоМесяцаЛокально(Сейчас);
			ПоследнийДеньПрошлогоМесяца = НачалоТекущегоМесяца - 24 * 60 * 60;
			Результат.Начало = ПолучитьНачалоМесяцаЛокально(ПоследнийДеньПрошлогоМесяца);
			Результат.Конец = КонецДня(ПоследнийДеньПрошлогоМесяца);
			Возврат Результат;
		ИначеЕсли Единица = "DAY" Тогда
			Вчера = Сейчас - 24 * 60 * 60;
			Результат.Начало = НачалоДня(Вчера);
			Результат.Конец = КонецДня(Вчера);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоТекущий Тогда
		Если Единица = "WEEK" Тогда
			Результат.Начало = ПолучитьНачалоКалендарнойНедели(Сейчас);
			Результат.Конец = КонецДня(Сейчас);
			Возврат Результат;
		ИначеЕсли Единица = "MONTH" Тогда
			Результат.Начало = ПолучитьНачалоМесяцаЛокально(Сейчас);
			Результат.Конец = КонецДня(Сейчас);
			Возврат Результат;
		ИначеЕсли Единица = "DAY" Тогда
			Результат.Начало = НачалоДня(Сейчас);
			Результат.Конец = КонецДня(Сейчас);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоСкользящий Тогда
		Если Единица = "WEEK" Тогда
			Результат.Начало = НачалоДня(Сейчас - 7 * 24 * 60 * 60);
			Результат.Конец = КонецДня(Сейчас);
			Возврат Результат;
		ИначеЕсли Единица = "MONTH" Тогда
			Результат.Начало = НачалоДня(Сейчас - 30 * 24 * 60 * 60);
			Результат.Конец = КонецДня(Сейчас);
			Возврат Результат;
		ИначеЕсли Единица = "DAY" Тогда
			Результат.Начало = НачалоДня(Сейчас);
			Результат.Конец = КонецДня(Сейчас);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ИзвлечьДатыДеньМесяцГодИзТекста(Текст)
	Даты = Новый Массив;
	СтрокаТекста = Строка(Текст);
	Буфер = "";
	Для Индекс = 1 По СтрДлина(СтрокаТекста) Цикл
		Символ = Сред(СтрокаТекста, Индекс, 1);
		Если СтрНайти("0123456789.", Символ) > 0 Тогда
			Буфер = Буфер + Символ;
		Иначе
			Если СтрДлина(Буфер) = 10 И Сред(Буфер, 3, 1) = "." И Сред(Буфер, 6, 1) = "." Тогда
				Попытка
					Даты.Добавить(Дата(Число(Сред(Буфер, 7, 4)), Число(Сред(Буфер, 4, 2)), Число(Лев(Буфер, 2))));
				Исключение
				КонецПопытки;
			КонецЕсли;
			Буфер = "";
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Буфер) = 10 И Сред(Буфер, 3, 1) = "." И Сред(Буфер, 6, 1) = "." Тогда
		Попытка
			Даты.Добавить(Дата(Число(Сред(Буфер, 7, 4)), Число(Сред(Буфер, 4, 2)), Число(Лев(Буфер, 2))));
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Даты;
КонецФункции

Функция ПолучитьГраницыПериодаИзТекста(ТекстПериода)
	Результат = Новый Структура("Начало,Конец", Неопределено, Неопределено);
	ПериодВРег = ВРег(СокрЛП(Строка(ТекстПериода)));
	Сейчас = ТекущаяДата();
	ЯвныеДаты = ИзвлечьДатыДеньМесяцГодИзТекста(ТекстПериода);
	Если ЯвныеДаты.Количество() >= 2 Тогда
		Результат.Начало = НачалоДня(ЯвныеДаты[0]);
		Результат.Конец = КонецДня(ЯвныеДаты[1]);
		Возврат Результат;
	ИначеЕсли ЯвныеДаты.Количество() = 1 Тогда
		Результат.Начало = НачалоДня(ЯвныеДаты[0]);
		Результат.Конец = КонецДня(ЯвныеДаты[0]);
		Возврат Результат;
	КонецЕсли;
	
	Если ПериодВРег = "СЕГОДНЯ" Тогда
		Результат.Начало = НачалоДня(Сейчас);
		Результат.Конец = КонецДня(Сейчас);
		Возврат Результат;
	КонецЕсли;
	
	Если ПериодВРег = "ВЧЕРА" Тогда
		Вчера = Сейчас - 24 * 60 * 60;
		Результат.Начало = НачалоДня(Вчера);
		Результат.Конец = КонецДня(Вчера);
		Возврат Результат;
	КонецЕсли;
	
	Результат = ПопробоватьПолучитьГраницыСтандартногоПериода(ПериодВРег, Сейчас);
	Если Результат.Начало <> Неопределено ИЛИ Результат.Конец <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭтоРазделительТокенаПериода(Символ)
	Если ПустаяСтрока(Символ) Тогда
		Возврат Истина;
	КонецЕсли;
	Разделители = " ,.;:()[]{}=<>+-*/\""'%" + Символы.ПС + Символы.Таб;
	Возврат СтрНайти(Разделители, Символ) > 0;
КонецФункции

Функция НормализоватьТокенПериода(Токен)
	ИсходныйТокен = Строка(Токен);
	ТокенВРег = ВРег(СокрЛП(ИсходныйТокен));
	Если ПустаяСтрока(ТокенВРег) Тогда
		Возврат ИсходныйТокен;
	КонецЕсли;
	
	ТипГраницы = "";
	ИмяПериода = "";
	Если СтрНайти(ТокенВРег, "НАЧАЛО_") = 1 Тогда
		ТипГраницы = "НАЧАЛО";
		ИмяПериода = Сред(ТокенВРег, СтрДлина("НАЧАЛО_") + 1);
	ИначеЕсли СтрНайти(ТокенВРег, "КОНЕЦ_") = 1 Тогда
		ТипГраницы = "КОНЕЦ";
		ИмяПериода = Сред(ТокенВРег, СтрДлина("КОНЕЦ_") + 1);
	Иначе
		Возврат ИсходныйТокен;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяПериода) Тогда
		Возврат ИсходныйТокен;
	КонецЕсли;
	
	ИмяПериода = СтрЗаменить(ИмяПериода, "_", " ");
	Границы = ПолучитьГраницыПериодаИзТекста(ИмяПериода);
	Если ТипГраницы = "НАЧАЛО" И Границы.Начало <> Неопределено Тогда
		Возврат ПостроитьЛитералДаты1С(Границы.Начало);
	КонецЕсли;
	Если ТипГраницы = "КОНЕЦ" И Границы.Конец <> Неопределено Тогда
		Возврат ПостроитьЛитералДаты1С(Границы.Конец);
	КонецЕсли;
	
	Возврат ИсходныйТокен;
КонецФункции

Функция НормализоватьПлейсхолдерыПериодаВТекстеЗапроса(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Результат = "";
	ТекущийТокен = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЭтоРазделительТокенаПериода(Символ) Тогда
			Если НЕ ПустаяСтрока(ТекущийТокен) Тогда
				Результат = Результат + НормализоватьТокенПериода(ТекущийТокен);
				ТекущийТокен = "";
			КонецЕсли;
			Результат = Результат + Символ;
		Иначе
			ТекущийТокен = ТекущийТокен + Символ;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(ТекущийТокен) Тогда
		Результат = Результат + НормализоватьТокенПериода(ТекущийТокен);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция НормализоватьСокращенныйЯвныйRunQuery(ТекстЗапроса)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Если Лев(ТекстВРег, 8) <> "ВЫБРАТЬ " Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, " ИЗ ") > 0 Или СтрНайти(ТекстВРег, Символы.ПС + "ИЗ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозКак = СтрНайти(ТекстВРег, " КАК ");
	ПозГде = СтрНайти(ТекстВРег, " ГДЕ ");
	Если ПозКак = 0 Или ПозГде = 0 Или ПозКак <= 8 Или ПозГде <= ПозКак Тогда
		Возврат Текст;
	КонецЕсли;
	ПолноеИмяОбъекта = СокрЛП(Сред(Текст, 9, ПозКак - 8));
	Псевдоним = СокрЛП(Сред(Текст, ПозКак + 5, ПозГде - ПозКак - 5));
	Условие = СокрЛП(Сред(Текст, ПозГде + 5));
	Если ПустаяСтрока(ПолноеИмяОбъекта) Или ПустаяСтрока(Псевдоним) Или ПустаяСтрока(Условие) Тогда
		Возврат Текст;
	КонецЕсли;
	ПолноеИмяОбъектаВРег = ВРег(ПолноеИмяОбъекта);
	Если СтрНайти(ПолноеИмяОбъектаВРег, "СПРАВОЧНИК.") <> 1
		И СтрНайти(ПолноеИмяОбъектаВРег, "ДОКУМЕНТ.") <> 1
		И СтрНайти(ПолноеИмяОбъектаВРег, "РЕГИСТРНАКОПЛЕНИЯ.") <> 1
		И СтрНайти(ПолноеИмяОбъектаВРег, "РЕГИСТРСВЕДЕНИЙ.") <> 1 Тогда
		Возврат Текст;
	КонецЕсли;
	Если НЕ ЭтоКорректныйИдентификаторДляЗапроса(Псевдоним) Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат "ВЫБРАТЬ " + Псевдоним + ".Ссылка КАК Ссылка"
		+ Символы.ПС + "ИЗ " + ПолноеИмяОбъекта + " КАК " + Псевдоним
		+ Символы.ПС + "ГДЕ " + Условие;
КонецФункции

Функция ЭтоКорректныйИдентификаторДляЗапроса(ТекстИдентификатора)
	Идентификатор = СокрЛП(Строка(ТекстИдентификатора));
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Идентификатор) Цикл
		Символ = Сред(Идентификатор, Позиция, 1);
		КодСимвола = КодСимвола(Символ);
		Если НЕ ((КодСимвола >= 48 И КодСимвола <= 57)
			ИЛИ (КодСимвола >= 65 И КодСимвола <= 90)
			ИЛИ (КодСимвола >= 97 И КодСимвола <= 122)
			ИЛИ (КодСимвола >= 1040 И КодСимвола <= 1103)
			ИЛИ КодСимвола = 1025
			ИЛИ КодСимвола = 1105
			ИЛИ Символ = "_") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(ТекстЗапроса)
	Текст = НормализоватьСокращенныйЯвныйRunQuery(ТекстЗапроса);
	Текст = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозИз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = СокрЛП(Сред(Текст, ПозИз + 3));
	Если Лев(Остаток, 1) = Символы.ПС Тогда
		Остаток = СокрЛП(Сред(Остаток, 2));
	КонецЕсли;
	Если ПустаяСтрока(Остаток) Тогда
		Возврат "";
	КонецЕсли;
	Разделители = Новый Массив;
	Разделители.Добавить(" ");
	Разделители.Добавить(Символы.ПС);
	Разделители.Добавить(Символы.Таб);
	ПозКонца = 0;
	Для Каждого Разделитель Из Разделители Цикл
		ПозРазделителя = СтрНайти(Остаток, Разделитель);
		Если ПозРазделителя > 0 И (ПозКонца = 0 ИЛИ ПозРазделителя < ПозКонца) Тогда
			ПозКонца = ПозРазделителя;
		КонецЕсли;
	КонецЦикла;
	Если ПозКонца = 0 Тогда
		Возврат НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(СокрЛП(Остаток));
	КонецЕсли;
	Возврат НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(СокрЛП(Лев(Остаток, ПозКонца - 1)));
КонецФункции

Функция НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(ИмяИсточника)

	Имя = СокрЛП(Строка(ИмяИсточника));
	Если ПустаяСтрока(Имя) Или СтрНайти(Имя, ".") = 0 Тогда
		Возврат Имя;
	КонецЕсли;
	Части = СтрРазделить(Имя, ".");
	Если Части.Количество() >= 3 Тогда
		ТипИсточника = Строка(Части[0]);
		Если ТипИсточника = "РегистрНакопления"
			Или ТипИсточника = "РегистрСведений"
			Или ТипИсточника = "РегистрБухгалтерии" Тогда
			Возврат ТипИсточника + "." + Строка(Части[1]);
		КонецЕсли;
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(ТекстЗапроса) Экспорт
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозИз = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПозКак = СтрНайти(Сред(ТекстВРег, ПозИз + 3), " КАК ");
	Если ПозКак = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Текст, ПозИз + 3 + ПозКак + 4);
	Разделители = Новый Массив;
	Разделители.Добавить(" ");
	Разделители.Добавить(Символы.ПС);
	Разделители.Добавить(Символы.Таб);
	ПозицияКонца = 0;
	Для Каждого Разделитель Из Разделители Цикл
		ПозРазделителя = СтрНайти(Остаток, Разделитель);
		Если ПозРазделителя > 0 И (ПозицияКонца = 0 ИЛИ ПозРазделителя < ПозицияКонца) Тогда
			ПозицияКонца = ПозРазделителя;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияКонца = 0 Тогда
		Возврат СокрЛП(Остаток);
	КонецЕсли;
	Возврат СокрЛП(Лев(Остаток, ПозицияКонца - 1));
КонецФункции

Функция НормализоватьВидДвиженияНакопленияВТекстеЗапроса(ТекстЗапроса)
	Возврат НормализоватьОператорыСравненияИЗначенияВЗапросе(ТекстЗапроса);
КонецФункции

Функция НормализоватьОператорыСравненияИЗначенияВЗапросе(ТекстЗапроса) Экспорт
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНакопления.", "ЗНАЧЕНИЕ(ВидДвиженияНакопления.");
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Перечисление.ВидыДвиженияНакопления.", "ЗНАЧЕНИЕ(ВидДвиженияНакопления.");
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Перечисление.ВидДвиженияНакопления.", "ЗНАЧЕНИЕ(ВидДвиженияНакопления.");
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЮ(", "ЗНАЧЕНИЕ(");
	Текст = СтрЗаменить(Текст, " НЕ РАВНО ", " <> ");
	Текст = СтрЗаменить(Текст, " не равно ", " <> ");
	Текст = СтрЗаменить(Текст, " Не Равно ", " <> ");
	Текст = СтрЗаменить(Текст, " IS НЕ NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, " IS NOT NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, " IS NULL", " ЕСТЬ NULL");
	Текст = СтрЗаменить(Текст, " НЕ NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, " не NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, " ЕСТЬ ЕСТЬ НЕ NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, " IS ЕСТЬ НЕ NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, "УБЫВ.", "УБЫВ");
	Текст = СтрЗаменить(Текст, "Убыв.", "УБЫВ");
	Текст = СтрЗаменить(Текст, "ВОЗР.", "ВОЗР");
	Текст = СтрЗаменить(Текст, "Возр.", "ВОЗР");
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Справочник.ПустаяСсылка)", "НЕОПРЕДЕЛЕНО");
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Документ.ПустаяСсылка)", "НЕОПРЕДЕЛЕНО");
	Текст = СтрЗаменить(Текст, "ЗНАЧЕНИЕ(Перечисление.ПустаяСсылка)", "НЕОПРЕДЕЛЕНО");
	Текст = СтрЗаменить(Текст, "СГРУППИРОВАТЬ ПО", "___ИИА_GROUPBY___");
	Текст = СтрЗаменить(Текст, "сгруппировать по", "___ИИА_GROUPBY___");
	Текст = СтрЗаменить(Текст, "ГРУППИРОВАТЬ ПО", "СГРУППИРОВАТЬ ПО");
	Текст = СтрЗаменить(Текст, "группировать по", "СГРУППИРОВАТЬ ПО");
	Текст = СтрЗаменить(Текст, "___ИИА_GROUPBY___", "СГРУППИРОВАТЬ ПО");
	Пока СтрНайти(ВРег(Текст), "ССГРУППИРОВАТЬ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "ССГРУППИРОВАТЬ", "СГРУППИРОВАТЬ");
		Текст = СтрЗаменить(Текст, "ссгруппировать", "СГРУППИРОВАТЬ");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + "1", "");
	Текст = СтрЗаменить(Текст, Символы.ПС + "СГРУППИРОВАТЬ ПО 1", "");
	Текст = СтрЗаменить(Текст, " СГРУППИРОВАТЬ ПО 1", "");
	Текст = СтрЗаменить(Текст, Символы.ПС + "СГРУППИРОВАТЬ ПО" + Символы.ПС + Символы.Таб + "1", "");
	Текст = СтрЗаменить(Текст, Символы.ПС + "ИСТИНА" + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, " И ИСТИНА", "");
	Текст = СтрЗаменить(Текст, "ИСТИНА И ", "");
	Текст = СтрЗаменить(Текст, " НЕ ЕСТЬ NULL", " ЕСТЬ НЕ NULL");
	Текст = СтрЗаменить(Текст, " не есть NULL", " ЕСТЬ НЕ NULL");
	Возврат Текст;
КонецФункции

Функция НормализоватьТекстЗапросаПередИсполнением(ТекстЗапроса, КонтекстВыполнения = Неопределено) Экспорт
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Текст;
	КонецЕсли;
	ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	Если ПустаяСтрока(ПолноеИмяОбъекта) И КонтекстВыполнения <> Неопределено
		И ТипЗнч(КонтекстВыполнения) = Тип("Структура") Тогда
		ТипОбъектаКонтекста = "";
		ИмяОбъектаКонтекста = "";
		Если КонтекстВыполнения.Свойство("DSL_РазрешенныеПоляТипОбъекта") Тогда
			ТипОбъектаКонтекста = Строка(КонтекстВыполнения.DSL_РазрешенныеПоляТипОбъекта);
		КонецЕсли;
		Если КонтекстВыполнения.Свойство("DSL_РазрешенныеПоляИмяОбъекта") Тогда
			ИмяОбъектаКонтекста = Строка(КонтекстВыполнения.DSL_РазрешенныеПоляИмяОбъекта);
		КонецЕсли;
		Если НЕ ПустаяСтрока(ТипОбъектаКонтекста) И НЕ ПустаяСтрока(ИмяОбъектаКонтекста) Тогда
			ПолноеИмяОбъекта = ТипОбъектаКонтекста + "." + ИмяОбъектаКонтекста;
		КонецЕсли;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "АВТОПРОДОЛЖЕНИЕ", "");
	Текст = СтрЗаменить(Текст, "Автопродолжение", "");
	Текст = СтрЗаменить(Текст, "АВТОУПОР", "");
	Текст = СтрЗаменить(Текст, "Автоупор", "");
	Текст = ЗаменитьПлейсхолдерИсточникаДанных(Текст, ПолноеИмяОбъекта);
	Текст = УбратьПробелыПослеТочкиКвалификатора(Текст);
	Текст = ЗаменитьПлохойИсточникПродажЕслиНужно(Текст, ПолноеИмяОбъекта);
	ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	Текст = НормализоватьСоединениеТабличнойЧастиДокумента(Текст, ПолноеИмяОбъекта);
	Текст = ДобавитьУсловиеСоединенияТабличнойЧастиЕслиОтсутствует(Текст, ПолноеИмяОбъекта);
	Текст = ПерестроитьЗапросОстатковЕслиИсточникНевалиден(Текст, ПолноеИмяОбъекта);
	ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	Текст = ЗаменитьПлейсхолдерТабличнойЧастиВЗапросе(Текст, ПолноеИмяОбъекта);
	ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	Текст = УдалитьКакВнутриВыраженийЗапроса(Текст);
	Текст = УдалитьУсловияСЛитеральнымКак(Текст);
	Текст = ЗаменитьКвалификаторПериодДата(Текст);
	Текст = УдалитьСоединенияБезПолногоИмениТаблицы(Текст);
	Текст = УдалитьИзбыточноеСоединениеСправочникаСИзмерением(Текст);
	Текст = ПрименитьСтруктурныйIRЗапроса(Текст, КонтекстВыполнения);
	Текст = НормализоватьПериодичностьВиртуальнойТаблицыОборотов(Текст);
	Текст = ДобавитьСкобкиВиртуальнойТаблицыЕслиОтсутствуют(Текст);
	Текст = НормализоватьПараметрыВиртуальнойТаблицыОстатков(Текст);
	Текст = НормализоватьПсевдоФункцииПериодаВЗапросе(Текст);
	Текст = НормализоватьГруппировкуПоДням(Текст);
	Текст = НормализоватьПсевдоФункцииПериодаВЗапросе(Текст);
	Текст = НормализоватьВиртуальныеТаблицыОстатковВЗапросе(Текст, ПолноеИмяОбъекта);
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	КонецЕсли;
	Текст = ДобавитьВиртуальнуюТаблицуОборотовЕслиНужно(Текст, ПолноеИмяОбъекта);
	Текст = ЗаменитьПериодНаДатуЕслиИсточникДокумент(Текст, ПолноеИмяОбъекта);
	Текст = НормализоватьЯвныйRunQueryПоМетаданным(Текст, ПолноеИмяОбъекта);
	Текст = ВынестиПервыеИзАргументовФункций(Текст);
	Текст = НормализоватьДатаВремяОтПоляВЗапросе(Текст);
	Текст = ЗаменитьПлейсхолдерыДатыВремяНаТекущийМесяц(Текст);
	Текст = ВосстановитьВиртуальнуюТаблицуОборотовЕслиСкобкиБезСуффикса(Текст);
	Текст = ДобавитьПериодичностьАвтоДляПоляПериод(Текст);
	Текст = ОбеспечитьПериодВиртуальнойТаблицыОборотов(Текст);
	Текст = ЗаменитьОграничитьНаПервые(Текст);
	Текст = ПереместитьПервыеВНачалоВыборки(Текст);
	Текст = ВынестиПервыеИзАргументовФункций(Текст);
	Если НЕ ИИА_DSLQuerySafety.ЭтоНеограниченныйРежимЗапроса(КонтекстВыполнения) Тогда
		Текст = ОбеспечитьПервыеВоВсехВыборкахВерхнегоУровня(Текст, 100, 500);
	КонецЕсли;
	Текст = УбратьПервыеИВисячийИИзСекцииГде(Текст);
	Whitelist = ПолучитьWhitelistПолейДляНормализации(ПолноеИмяОбъекта, КонтекстВыполнения);
	Если Whitelist.Количество() > 0 Тогда
		Текст = КанонизироватьРесурсыВиртуальнойТаблицы(Текст, Whitelist);
		Текст = КанонизироватьИменаПолейПоWhitelist(Текст, Whitelist);
		Текст = ЗаменитьИдентификаторВТекстеЗапросаПоСемантике(Текст, Whitelist);
		Текст = НормализоватьГруппировкуЗапросаПоWhitelist(Текст, Whitelist);
		Текст = УдалитьУсловияСПолямиВнеWhitelist(Текст, Whitelist);
	КонецЕсли;
	Текст = ПринудительноКанонизироватьРесурсыОборотов(Текст);
	Текст = ПринудительноКанонизироватьРесурсыОстатков(Текст);
	Текст = ОграничитьГодыДатаВремяВЗапросе(Текст);
	Текст = ЗаменитьSqlСортировкуDescAsc(Текст);
	Текст = УпроститьВыборПоВидуДвиженияЕслиПолеОтсутствует(Текст, Whitelist, ПолноеИмяОбъекта);
	Текст = НормализоватьПсевдоФункцииПериодаВЗапросе(Текст);
	Текст = СплющитьВложенныйНачалоПериода(Текст);
	Текст = НормализоватьПсевдонимИсточникаСТочкой(Текст);
	Текст = ЗаменитьГруппировкуПоАлиасуДняНаВыражение(Текст);
	Текст = НормализоватьУпорядочиваниеПоАлиасамВыборки(Текст);
	Текст = УдалитьФильтрДатЭпохиИзЗапроса(Текст);
	Текст = ДобавитьФильтрДатИзКонтекстаЕслиНужно(Текст, ПолноеИмяОбъекта, КонтекстВыполнения);
	Текст = СогласоватьГруппировкуСВыборкой(Текст);
	Текст = ДобавитьСкобкиВиртуальнойТаблицыЕслиОтсутствуют(Текст);
	Текст = ДобавитьПериодичностьАвтоДляПоляПериод(Текст);
	Текст = ПеренестиГраницыПериодаИзГдеВПараметрыОборотов(Текст);
	Текст = ИсправитьСдвигДатВПараметрахОборотов(Текст);
	Возврат Текст;
КонецФункции

Функция ЗаменитьИсточникВТекстеЗапроса(ТекстЗапроса, НовоеПолноеИмя) Экспорт
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(СокрЛП(Текст)) Или ПустаяСтрока(СокрЛП(Строка(НовоеПолноеИмя))) Тогда
		Возврат Текст;
	КонецЕсли;
	СтарыйТокен = ИзвлечьТокенИсточникаИзТекстаЗапроса(Текст);
	Если ПустаяСтрока(СтарыйТокен) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ТокенВРег = ВРег(СтарыйТокен);
	Поз = СтрНайти(ТекстВРег, ТокенВРег);
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = Лев(Текст, Поз - 1) + Строка(НовоеПолноеИмя) + Сред(Текст, Поз + СтрДлина(СтарыйТокен));
	Текст = СтрЗаменить(Текст, "РегистрНакопления.РегистрНакопления.", "РегистрНакопления.");
	Текст = СтрЗаменить(Текст, "РегистрБухгалтерии.РегистрБухгалтерии.", "РегистрБухгалтерии.");
	Текст = СтрЗаменить(Текст, "РегистрСведений.РегистрСведений.", "РегистрСведений.");
	Текст = СтрЗаменить(Текст, "Документ.Документ.", "Документ.");
	Текст = СтрЗаменить(Текст, "Справочник.Справочник.", "Справочник.");
	Возврат НормализоватьТекстЗапросаПередИсполнением(Текст, Неопределено);
КонецФункции

Функция НормализоватьЯвныйRunQueryПоМетаданным(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = НормализоватьПлейсхолдерыПериодаВТекстеЗапроса(Строка(ТекстЗапроса));
	Текст = НормализоватьВидДвиженияНакопленияВТекстеЗапроса(Текст);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Текст;
	КонецЕсли;
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	КонецЕсли;
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если Whitelist.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	WhitelistПути = ПолучитьWhitelistПутейОбъектаЛокально(ПолноеИмяОбъекта);
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	Текст = ЗаменитьSqlСтильПсевдонимовВыборки(Текст);
	ТекстВРег = ВРег(Текст);
	Если НЕ СтрНачинаетсяС(СокрЛП(ТекстВРег), "ВЫБРАТЬ") Тогда
		Возврат Текст;
	КонецЕсли;
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозИз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	НачалоПолей = НайтиНачалоСпискаПолейВыборки(Текст);
	Если НачалоПолей = 0 Или НачалоПолей >= ПозИз Тогда
		Возврат Текст;
	КонецЕсли;
	СекцияВыбрать = СокрЛП(Сред(Текст, НачалоПолей, ПозИз - НачалоПолей));
	Если ПустаяСтрока(СекцияВыбрать) Тогда
		Возврат Текст;
	КонецЕсли;
	ПсевдонимВРег = ВРег(Псевдоним);
	Если НЕ ПустаяСтрока(Псевдоним) И ВРег(СекцияВыбрать) = ПсевдонимВРег И ПолеЕстьВWhitelistЛокально(Whitelist, "Ссылка") Тогда
		Возврат Лев(Текст, НачалоПолей - 1) + Псевдоним + ".Ссылка КАК Ссылка" + Сред(Текст, ПозИз);
	КонецЕсли;
	НоваяСекцияВыбрать = НормализоватьСекциюВыбратьПоWhitelistЛокально(СекцияВыбрать, Псевдоним, Whitelist, РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта).ObjectName);
	Если НЕ ПустаяСтрока(НоваяСекцияВыбрать) И НоваяСекцияВыбрать <> СекцияВыбрать Тогда
		Текст = Лев(Текст, НачалоПолей - 1) + НоваяСекцияВыбрать + Сред(Текст, ПозИз);
	КонецЕсли;
	Текст = НормализоватьСтроковыйФильтрПоWhitelistПутямЛокально(Текст, WhitelistПути);
	Текст = НормализоватьГруппировкуЗапросаПоWhitelist(Текст, Whitelist);
	Текст = УдалитьСоединенияСПолямиВнеWhitelist(Текст, Whitelist, Псевдоним);
	Возврат Текст;
КонецФункции

Функция НайтиНачалоСпискаПолейВыборки(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если НЕ СтрНачинаетсяС(СокрЛП(ТекстВРег), "ВЫБРАТЬ") Тогда
		Возврат 0;
	КонецЕсли;
	Поз = СтрНайти(ТекстВРег, "ВЫБРАТЬ");
	Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Поз + СтрДлина("ВЫБРАТЬ"));
	Если ВРег(Сред(Текст, Индекс, СтрДлина("ПЕРВЫЕ"))) = "ПЕРВЫЕ" Тогда
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс + СтрДлина("ПЕРВЫЕ"));
		Пока Индекс <= СтрДлина(Текст) Цикл
			Символ = Сред(Текст, Индекс, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
	КонецЕсли;
	Если ВРег(Сред(Текст, Индекс, СтрДлина("РАЗРЕШЕННЫЕ"))) = "РАЗРЕШЕННЫЕ" Тогда
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс + СтрДлина("РАЗРЕШЕННЫЕ"));
	КонецЕсли;
	Если ВРег(Сред(Текст, Индекс, СтрДлина("РАЗЛИЧНЫЕ"))) = "РАЗЛИЧНЫЕ" Тогда
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс + СтрДлина("РАЗЛИЧНЫЕ"));
	КонецЕсли;
	Возврат Индекс;
КонецФункции

Функция ПропуститьПробелыВТекстеЗапроса(Текст, НачальныйИндекс)
	Индекс = НачальныйИндекс;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.Таб Или Символ = Символы.ВК Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Возврат Индекс;
КонецФункции

Функция ЗаменитьSqlСтильПсевдонимовВыборки(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозИз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	НачалоПолей = НайтиНачалоСпискаПолейВыборки(Текст);
	Если НачалоПолей = 0 Или НачалоПолей >= ПозИз Тогда
		Возврат Текст;
	КонецЕсли;
	Секция = Сред(Текст, НачалоПолей, ПозИз - НачалоПолей);
	НовыеЧасти = Новый Массив;
	Для Каждого Часть Из РазделитьВыраженияСпискаЗапроса(Секция) Цикл
		Выражение = СокрЛП(Строка(Часть));
		Если ПустаяСтрока(Выражение) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ВРег(Выражение), " КАК ") = 0 Тогда
			ПозРавно = СтрНайти(Выражение, "=");
			Если ПозРавно > 1 Тогда
				Левая = СокрЛП(Лев(Выражение, ПозРавно - 1));
				Правая = СокрЛП(Сред(Выражение, ПозРавно + 1));
				Если ЭтоПростойИдентификаторЗапроса(Левая) И НЕ ПустаяСтрока(Правая) Тогда
					Выражение = Правая + " КАК " + Левая;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		НовыеЧасти.Добавить(Выражение);
	КонецЦикла;
	Если НовыеЧасти.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, НачалоПолей - 1) + СтрСоединить(НовыеЧасти, ", ") + Сред(Текст, ПозИз);
КонецФункции

Функция ЭтоПростойИдентификаторЗапроса(Имя)
	Значение = СокрЛП(Строка(Имя));
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если НЕ ЭтоСимволИдентификатораЗапроса(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат НЕ ЭтоКлючевоеСловоЗапроса(Значение);
КонецФункции

Функция УдалитьСоединенияСПолямиВнеWhitelist(ТекстЗапроса, Whitelist, Псевдоним)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Или ПустаяСтрока(Псевдоним) Или Whitelist = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Маркеры = Новый Массив;
	Маркеры.Добавить(Символы.ПС + "ЛЕВОЕ ВНЕШНЕЕ СОЕДИНЕНИЕ");
	Маркеры.Добавить(Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ");
	Маркеры.Добавить(Символы.ПС + "ПРАВОЕ ВНЕШНЕЕ СОЕДИНЕНИЕ");
	Маркеры.Добавить(Символы.ПС + "ПРАВОЕ СОЕДИНЕНИЕ");
	Маркеры.Добавить(Символы.ПС + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ");
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		ПозСоединения = 0;
		ДлинаМаркера = 0;
		Для Каждого Маркер Из Маркеры Цикл
			Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), ВРег(Маркер));
			Если Поз = 0 Тогда
				Продолжить;
			КонецЕсли;
			Поз = ПозицияПоиска + Поз - 1;
			Если ПозСоединения = 0 Или Поз < ПозСоединения Тогда
				ПозСоединения = Поз;
				ДлинаМаркера = СтрДлина(Маркер);
			КонецЕсли;
		КонецЦикла;
		Если ПозСоединения = 0 Тогда
			Прервать;
		КонецЕсли;
		КонецСоединения = 0;
		Для Каждого МаркерКонца Из СтрРазделить(Символы.ПС + "ГДЕ|" + Символы.ПС + "СГРУППИРОВАТЬ|" + Символы.ПС + "УПОРЯДОЧИТЬ|" + Символы.ПС + "ИМЕЮЩИЕ|" + Символы.ПС + "ЛЕВОЕ|" + Символы.ПС + "ВНУТРЕННЕЕ|" + Символы.ПС + "ПРАВОЕ", "|") Цикл
			ПозКонца = СтрНайти(Сред(ТекстВРег, ПозСоединения + ДлинаМаркера), МаркерКонца);
			Если ПозКонца = 0 Тогда
				Продолжить;
			КонецЕсли;
			ПозКонца = ПозСоединения + ДлинаМаркера + ПозКонца - 1;
			Если КонецСоединения = 0 Или ПозКонца < КонецСоединения Тогда
				КонецСоединения = ПозКонца;
			КонецЕсли;
		КонецЦикла;
		Если КонецСоединения = 0 Тогда
			КонецСоединения = СтрДлина(Текст) + 1;
		КонецЕсли;
		Фрагмент = Сред(Текст, ПозСоединения, КонецСоединения - ПозСоединения);
		НужноУдалить = Ложь;
		Для Каждого Токен Из ИзвлечьИдентификаторыПолейИзТекстаЗапроса(Фрагмент) Цикл
			Если СтрНайти(Токен, ".") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ВРег(Лев(Токен, СтрДлина(Псевдоним) + 1)) <> ВРег(Псевдоним + ".") Тогда
				Продолжить;
			КонецЕсли;
			ИмяПоля = Сред(Токен, СтрДлина(Псевдоним) + 2);
			Если НЕ ПолеЕстьВWhitelistЛокально(Whitelist, ИмяПоля) Тогда
				НужноУдалить = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НужноУдалить Тогда
			Текст = Лев(Текст, ПозСоединения - 1) + Сред(Текст, КонецСоединения);
			ПозицияПоиска = ПозСоединения;
		Иначе
			ПозицияПоиска = ПозСоединения + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта)
	Результат = Новый Структура("ObjectType,ObjectName", "", "");
	Имя = СокрЛП(Строка(ПолноеИмяОбъекта));
	ПозТочки = СтрНайти(Имя, ".");
	Если ПозТочки > 0 Тогда
		Результат.ObjectType = Лев(Имя, ПозТочки - 1);
		Результат.ObjectName = Сред(Имя, ПозТочки + 1);
	Иначе
		Результат.ObjectName = Имя;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоИмяВиртуальнойТаблицыЗапроса(ИмяТаблицы)
	ИмяВРег = ВРег(СокрЛП(Строка(ИмяТаблицы)));
	Возврат ИмяВРег = "ОСТАТКИ"
		Или ИмяВРег = "ОБОРОТЫ"
		Или ИмяВРег = "ОСТАТКИИОБОРОТЫ"
		Или ИмяВРег = "СРЕЗПОСЛЕДНИХ"
		Или ИмяВРег = "СРЕЗПЕРВЫХ"
		Или ИмяВРег = "ОБОРОТЫДТКТ";
КонецФункции

Функция ПолучитьWhitelistПолейТабличнойЧасти(ТипОбъекта, ИмяОбъекта, ИмяТабличнойЧасти)
	Whitelist = Новый Массив;
	Если ПустаяСтрока(ТипОбъекта) Или ПустаяСтрока(ИмяОбъекта) Или ПустаяСтрока(ИмяТабличнойЧасти) Тогда
		Возврат Whitelist;
	КонецЕсли;
	ОбъектМетаданных = Неопределено;
	Если ТипОбъекта = "Документ" Тогда
		ОбъектМетаданных = Метаданные.Документы.Найти(ИмяОбъекта);
	ИначеЕсли ТипОбъекта = "Справочник" Тогда
		ОбъектМетаданных = Метаданные.Справочники.Найти(ИмяОбъекта);
	КонецЕсли;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Whitelist;
	КонецЕсли;
	ТабличнаяЧасть = ОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат Whitelist;
	КонецЕсли;
	Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
		ИмяРеквизита = СокрЛП(Строка(Реквизит.Имя));
		Если НЕ ПустаяСтрока(ИмяРеквизита) И Лев(ВРег(ИмяРеквизита), 6) <> "УДАЛИТ" Тогда
			Whitelist.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	Если Whitelist.Найти("НомерСтроки") = Неопределено Тогда
		Whitelist.Добавить("НомерСтроки");
	КонецЕсли;
	Если Whitelist.Найти("Ссылка") = Неопределено Тогда
		Whitelist.Добавить("Ссылка");
	КонецЕсли;
	Возврат Whitelist;
КонецФункции

Функция ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта)
	Whitelist = Новый Массив;
	Разбор = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
	Если ПустаяСтрока(Разбор.ObjectType) ИЛИ ПустаяСтрока(Разбор.ObjectName) Тогда
		Возврат Whitelist;
	КонецЕсли;
	Если Разбор.ObjectType = "Документ" Или Разбор.ObjectType = "Справочник" Тогда
		ЧастиИмени = СтрРазделить(Разбор.ObjectName, ".");
		Если ЧастиИмени.Количество() >= 2 Тогда
			ИмяВладельца = СокрЛП(Строка(ЧастиИмени[0]));
			ИмяТабличнойЧасти = СокрЛП(Строка(ЧастиИмени[1]));
			Если НЕ ПустаяСтрока(ИмяВладельца) И НЕ ПустаяСтрока(ИмяТабличнойЧасти)
				И НЕ ЭтоИмяВиртуальнойТаблицыЗапроса(ИмяТабличнойЧасти) Тогда
				WhitelistТабличнойЧасти = ПолучитьWhitelistПолейТабличнойЧасти(Разбор.ObjectType, ИмяВладельца, ИмяТабличнойЧасти);
				Если WhitelistТабличнойЧасти.Количество() > 0 Тогда
					Возврат WhitelistТабличнойЧасти;
				КонецЕсли;
				Разбор.ObjectName = ИмяВладельца;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ИнформацияОбОбъекте = Неопределено;
	Если Разбор.ObjectType = "Справочник" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыСправочника(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "Документ" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыДокумента(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "РегистрНакопления" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраНакопления(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "РегистрСведений" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраСведений(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "РегистрБухгалтерии" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраБухгалтерии(Разбор.ObjectName);
	КонецЕсли;
	Если ИнформацияОбОбъекте = Неопределено
		ИЛИ ТипЗнч(ИнформацияОбОбъекте) <> Тип("Структура")
		ИЛИ НЕ ИнформацияОбОбъекте.Свойство("Найден")
		ИЛИ НЕ ИнформацияОбОбъекте.Найден Тогда
		Возврат Whitelist;
	КонецЕсли;
	Если ИнформацияОбОбъекте.Свойство("Реквизиты") И ТипЗнч(ИнформацияОбОбъекте.Реквизиты) = Тип("Массив") Тогда
		Для Каждого Реквизит Из ИнформацияОбОбъекте.Реквизиты Цикл
			Если ТипЗнч(Реквизит) = Тип("Структура") И Реквизит.Свойство("Имя") Тогда
				ИмяРеквизита = СокрЛП(Строка(Реквизит.Имя));
				Если НЕ ПустаяСтрока(ИмяРеквизита) И Лев(ВРег(ИмяРеквизита), 6) <> "УДАЛИТ" И Whitelist.Найти(ИмяРеквизита) = Неопределено Тогда
					Whitelist.Добавить(ИмяРеквизита);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если (Разбор.ObjectType = "Документ" Или Разбор.ObjectType = "Справочник")
		И Whitelist.Найти("Ссылка") = Неопределено Тогда
		Whitelist.Добавить("Ссылка");
	КонецЕсли;
	Возврат Whitelist;
КонецФункции

Функция ПолучитьWhitelistПутейОбъектаЛокально(ПолноеИмяОбъекта)
	WhitelistПути = Новый Массив;
	Разбор = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
	Если ПустаяСтрока(Разбор.ObjectType) ИЛИ ПустаяСтрока(Разбор.ObjectName) Тогда
		Возврат WhitelistПути;
	КонецЕсли;
	ИнформацияОбОбъекте = Неопределено;
	Если Разбор.ObjectType = "Справочник" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыСправочника(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "Документ" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыДокумента(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "РегистрНакопления" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраНакопления(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "РегистрСведений" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраСведений(Разбор.ObjectName);
	ИначеЕсли Разбор.ObjectType = "РегистрБухгалтерии" Тогда
		ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраБухгалтерии(Разбор.ObjectName);
	КонецЕсли;
	Если ИнформацияОбОбъекте = Неопределено
		ИЛИ ТипЗнч(ИнформацияОбОбъекте) <> Тип("Структура")
		ИЛИ НЕ ИнформацияОбОбъекте.Свойство("Найден")
		ИЛИ НЕ ИнформацияОбОбъекте.Найден Тогда
		Возврат WhitelistПути;
	КонецЕсли;
	Если ИнформацияОбОбъекте.Свойство("Реквизиты") И ТипЗнч(ИнформацияОбОбъекте.Реквизиты) = Тип("Массив") Тогда
		Для Каждого Реквизит Из ИнформацияОбОбъекте.Реквизиты Цикл
			Если ТипЗнч(Реквизит) = Тип("Структура") И Реквизит.Свойство("Имя") Тогда
				ИмяРеквизита = СокрЛП(Строка(Реквизит.Имя));
				Если ПустаяСтрока(ИмяРеквизита) ИЛИ Лев(ВРег(ИмяРеквизита), 6) = "УДАЛИТ" Тогда
					Продолжить;
				КонецЕсли;
				Если Реквизит.Свойство("Тип") И ЭтоСсылочныйТипРеквизитаЛокально(Строка(Реквизит.Тип)) Тогда
					Если WhitelistПути.Найти(ИмяРеквизита + ".Наименование") = Неопределено Тогда
						WhitelistПути.Добавить(ИмяРеквизита + ".Наименование");
					КонецЕсли;
					Если WhitelistПути.Найти(ИмяРеквизита + ".Ссылка") = Неопределено Тогда
						WhitelistПути.Добавить(ИмяРеквизита + ".Ссылка");
					КонецЕсли;
					Если WhitelistПути.Найти(ИмяРеквизита + ".Код") = Неопределено Тогда
						WhitelistПути.Добавить(ИмяРеквизита + ".Код");
					КонецЕсли;
					Если WhitelistПути.Найти(ИмяРеквизита + ".Номер") = Неопределено Тогда
						WhitelistПути.Добавить(ИмяРеквизита + ".Номер");
					КонецЕсли;
					Если WhitelistПути.Найти(ИмяРеквизита + ".Дата") = Неопределено Тогда
						WhitelistПути.Добавить(ИмяРеквизита + ".Дата");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если WhitelistПути.Найти("Ссылка") = Неопределено Тогда
		WhitelistПути.Добавить("Ссылка");
	КонецЕсли;
	Возврат WhitelistПути;
КонецФункции

Функция ЭтоСсылочныйТипРеквизитаЛокально(СтрокаТипа)
	ТекстТипа = ВРег(СокрЛП(Строка(СтрокаТипа)));
	Возврат СтрНайти(ТекстТипа, "СПРАВОЧНИКССЫЛКА.") > 0
		ИЛИ СтрНайти(ТекстТипа, "ДОКУМЕНТССЫЛКА.") > 0
		ИЛИ СтрНайти(ТекстТипа, "ПЛАНВИДОВХАРАКТЕРИСТИКССЫЛКА.") > 0;
КонецФункции

Функция НайтиПутьДляСтроковогоСравненияЛокально(ИмяПоля, WhitelistПути)
	Если WhitelistПути = Неопределено ИЛИ WhitelistПути.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Префикс = ВРег(ПолучитьБазовоеИмяПоляЛокально(ИмяПоля)) + ".";
	ЛучшийПуть = "";
	Для Каждого Путь Из WhitelistПути Цикл
		ПутьСтрокой = СокрЛП(Строка(Путь));
		ПутьВРег = ВРег(ПутьСтрокой);
		Если Лев(ПутьВРег, СтрДлина(Префикс)) <> Префикс Тогда
			Продолжить;
		КонецЕсли;
		Если Прав(ПутьВРег, СтрДлина(".НАИМЕНОВАНИЕ")) = ".НАИМЕНОВАНИЕ" Тогда
			Возврат ПутьСтрокой;
		КонецЕсли;
		Если ПустаяСтрока(ЛучшийПуть) Тогда
			ЛучшийПуть = ПутьСтрокой;
		КонецЕсли;
	КонецЦикла;
	Возврат ЛучшийПуть;
КонецФункции

Функция НормализоватьСтроковыйФильтрПоWhitelistПутямЛокально(ТекстЗапроса, WhitelistПути)
	Результат = Строка(ТекстЗапроса);
	Если WhitelistПути = Неопределено ИЛИ WhitelistПути.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Путь Из WhitelistПути Цикл
		ПутьСтрокой = СокрЛП(Строка(Путь));
		ПозТочки = СтрНайти(ПутьСтрокой, ".");
		Если ПозТочки = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмяПоля = Лев(ПутьСтрокой, ПозТочки - 1);
		ПутьДляСтроки = НайтиПутьДляСтроковогоСравненияЛокально(ИмяПоля, WhitelistПути);
		Если ПустаяСтрока(ПутьДляСтроки) Тогда
			Продолжить;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, ИмяПоля + " = """, ПутьДляСтроки + " = """);
		Результат = СтрЗаменить(Результат, ИмяПоля + " = '", ПутьДляСтроки + " = '");
		Результат = СтрЗаменить(Результат, ИмяПоля + "='", ПутьДляСтроки + "='");
		Результат = СтрЗаменить(Результат, "(" + ИмяПоля + " = """, "(" + ПутьДляСтроки + " = """);
		Результат = СтрЗаменить(Результат, "(" + ИмяПоля + " = '", "(" + ПутьДляСтроки + " = '");
		Для Каждого Идентификатор Из ИзвлечьИдентификаторыИзСтрокиФильтраЛокально(Результат) Цикл
			Если ВРег(ПолучитьБазовоеИмяПоляЛокально(Идентификатор)) <> ВРег(ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			ПолныйПуть = ПолучитьПрефиксКвалификатораПоляЛокально(Идентификатор) + ПутьДляСтроки;
			Результат = СтрЗаменить(Результат, Идентификатор + " = """, ПолныйПуть + " = """);
			Результат = СтрЗаменить(Результат, Идентификатор + " = '", ПолныйПуть + " = '");
			Результат = СтрЗаменить(Результат, Идентификатор + "='", ПолныйПуть + "='");
			Результат = СтрЗаменить(Результат, "(" + Идентификатор + " = """, "(" + ПолныйПуть + " = """);
			Результат = СтрЗаменить(Результат, "(" + Идентификатор + " = '", "(" + ПолныйПуть + " = '");
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьБазовоеИмяПоляЛокально(ИмяПоля)
	Имя = СокрЛП(Строка(ИмяПоля));
	ПозицияТочки = 0;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Если Сред(Имя, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияТочки > 0 Тогда
		Имя = Сред(Имя, ПозицияТочки + 1);
	КонецЕсли;
	Результат = "";
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		Если НЕ ЭтоСимволИдентификатораЗапроса(Символ) Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьПрефиксКвалификатораПоляЛокально(ИмяПоля)
	Имя = СокрЛП(Строка(ИмяПоля));
	ПозицияТочки = 0;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Если Сред(Имя, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияТочки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Имя, ПозицияТочки);
КонецФункции

Функция ЭтоСистемныйПрефиксКвалификатораПоляЛокально(Префикс)
	ПрефиксВРег = ВРег(СокрЛП(Строка(Префикс)));
	Возврат ПрефиксВРег = "ДОКУМЕНТ."
		ИЛИ ПрефиксВРег = "СПРАВОЧНИК."
		ИЛИ ПрефиксВРег = "РЕГИСТРНАКОПЛЕНИЯ."
		ИЛИ ПрефиксВРег = "РЕГИСТРСВЕДЕНИЙ."
		ИЛИ ПрефиксВРег = "РЕГИСТРБУХГАЛТЕРИИ.";
КонецФункции

Функция ИзвлечьИдентификаторыИзСтрокиФильтраЛокально(ТекстФильтра)
	Результат = Новый Массив;
	Текст = СтрЗаменить(Строка(ТекстФильтра), Символы.ПС, " ");
	Разделители = Новый Массив;
	Разделители.Добавить("(");
	Разделители.Добавить(")");
	Разделители.Добавить("=");
	Разделители.Добавить("<");
	Разделители.Добавить(">");
	Разделители.Добавить(",");
	Для Каждого Разделитель Из Разделители Цикл
		Текст = СтрЗаменить(Текст, Строка(Разделитель), " ");
	КонецЦикла;
	Для Каждого Часть Из СтрРазделить(Текст, " ") Цикл
		Идентификатор = СокрЛП(Строка(Часть));
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если Идентификатор = "И" ИЛИ Идентификатор = "ИЛИ" ИЛИ Идентификатор = "НЕ" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Идентификатор, 1) = """" ИЛИ Лев(Идентификатор, 1) = "'" Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоПохожеНаЧислоЛокально(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.Найти(Идентификатор) = Неопределено Тогда
			Результат.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоПохожеНаЧислоЛокально(Текст)
	Значение = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если (Символ < "0" ИЛИ Символ > "9") И Символ <> "." И Символ <> "," И Символ <> "-" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция РазделитьВыраженияСпискаЗапроса(Секция)
	Результат = Новый Массив;
	Текст = Строка(Секция);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Результат;
	КонецЕсли;
	Буфер = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Буфер = Буфер + Символ;
			Продолжить;
		КонецЕсли;
		Если НЕ ВКавычках Тогда
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" И Глубина > 0 Тогда
				Глубина = Глубина - 1;
			ИначеЕсли Символ = "," И Глубина = 0 Тогда
				Если НЕ ПустаяСтрока(СокрЛП(Буфер)) Тогда
					Результат.Добавить(СокрЛП(Буфер));
				КонецЕсли;
				Буфер = "";
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Буфер = Буфер + Символ;
	КонецЦикла;
	Если НЕ ПустаяСтрока(СокрЛП(Буфер)) Тогда
		Результат.Добавить(СокрЛП(Буфер));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПодставитьСуммовоеПолеВоВыражениеЗапроса(Выражение, Whitelist)
	Текст = Строка(Выражение);
	Если СтрНайти(ВРег(Текст), "СУММА(") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПолеСуммы = ПодобратьКаноническоеСуммовоеПоле(Whitelist);
	Если ПустаяСтрока(ПолеСуммы) Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "СуммаПродаж", ПолеСуммы);
	Токены = ИзвлечьИдентификаторыПолейИзТекстаЗапроса(Текст);
	Для Каждого Токен Из Токены Цикл
		Если ЭтоКлючевоеСловоЗапроса(Токен) Тогда
			Продолжить;
		КонецЕсли;
		ТокенВРег = ВРег(Токен);
		ЭтоСуммоподобное = СтрНайти(ТокенВРег, "СУММ") > 0
			Или СтрНайти(ТокенВРег, "КОЛИЧЕСТВ") > 0
			Или СтрНайти(ТокенВРег, "ОБОРОТ") > 0
			Или СтрНайти(ТокенВРег, "ОСТАТ") > 0;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, Токен) И ЭтоСуммоподобное Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоСуммоподобное Или СтрНайти(ТокенВРег, "СУММ") > 0 Тогда
			Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, Токен, ПолеСуммы);
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПолеЕстьВWhitelistЛокально(Whitelist, "Сумма") Тогда
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Сумма", ПолеСуммы);
	ИначеЕсли ПолеСуммы <> "Сумма" Тогда
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Сумма", ПолеСуммы);
	КонецЕсли;
	ПозКак = СтрНайти(ВРег(Текст), " КАК ");
	Если ПозКак = 0 Тогда
		Текст = Текст + " КАК Сумма";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПодобратьКаноническоеСуммовоеПоле(Whitelist)
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаДокумента") Тогда
		Возврат "СуммаДокумента";
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "Сумма") Тогда
		Возврат "Сумма";
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаОборот") Тогда
		Возврат "СуммаОборот";
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаОстаток") Тогда
		Возврат "СуммаОстаток";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция НормализоватьДатаВремяОтПоляВЗапросе(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркер = "ДАТАВРЕМЯ(";
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Маркер);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, Поз + СтрДлина(Маркер) - 1);
		Если КонецСкобки = 0 Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		Внутри = СокрЛП(Сред(Текст, Поз + СтрДлина(Маркер), КонецСкобки - (Поз + СтрДлина(Маркер))));
		ПервыйАргумент = Внутри;
		ПозЗапятойВнутри = СтрНайти(Внутри, ",");
		Если ПозЗапятойВнутри > 0 Тогда
			ПервыйАргумент = СокрЛП(Лев(Внутри, ПозЗапятойВнутри - 1));
		КонецЕсли;
		ПервыйАргументЦифры = СтрЗаменить(СтрЗаменить(ПервыйАргумент, " ", ""), Символы.НПП, "");
		ЭтоЧисловойЛитерал = НЕ ПустаяСтрока(ПервыйАргументЦифры);
		Для ИндексСимвола = 1 По СтрДлина(ПервыйАргументЦифры) Цикл
			СимволАргумента = Сред(ПервыйАргументЦифры, ИндексСимвола, 1);
			Если СимволАргумента < "0" Или СимволАргумента > "9" Тогда
				ЭтоЧисловойЛитерал = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоЧисловойЛитерал И ПервыйАргументЦифры <> ПервыйАргумент Тогда
			Текст = Лев(Текст, Поз + СтрДлина(Маркер) - 1) + СтрЗаменить(СтрЗаменить(Внутри, " ", ""), Символы.НПП, "") + Сред(Текст, КонецСкобки);
			ПозицияПоиска = КонецСкобки + 1;
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(ПервыйАргумент) Или ЭтоКлючевоеСловоЗапроса(ПервыйАргумент)
			Или СтрНайти(ВРег(ПервыйАргумент), "ПЕРВЫЕ") > 0 Тогда
			Замена = "НАЧАЛОПЕРИОДА(Период, ДЕНЬ)";
			Текст = Лев(Текст, Поз - 1) + Замена + Сред(Текст, КонецСкобки + 1);
			ПозицияПоиска = Поз + СтрДлина(Замена);
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоЧисловойЛитерал И НЕ ПустаяСтрока(ПервыйАргумент) И СтрНайти(ПервыйАргумент, "(") = 0 Тогда
			Замена = "НАЧАЛОПЕРИОДА(" + ПервыйАргумент + ", ДЕНЬ)";
			Текст = Лев(Текст, Поз - 1) + Замена + Сред(Текст, КонецСкобки + 1);
			ПозицияПоиска = Поз + СтрДлина(Замена);
			Продолжить;
		КонецЕсли;
		ПозицияПоиска = КонецСкобки + 1;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьПлейсхолдерыДатыВремяНаТекущийМесяц(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, "ДАТАВРЕМЯ(ГГГГ") = 0 И СтрНайти(ТекстВРег, "КОНЕЦМЕСЯЦА") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Сейчас = ТекущаяДата();
	НачалоМесяца = Дата(Год(Сейчас), Месяц(Сейчас), 1);
	КонецМесяца = КонецМесяца(НачалоМесяца);
	ЛитералНачала = "ДАТАВРЕМЯ(" + Формат(Год(НачалоМесяца), "ЧГ=0") + ", " + Формат(Месяц(НачалоМесяца), "ЧГ=0") + ", 1, 0, 0, 0)";
	ЛитералКонца = "ДАТАВРЕМЯ(" + Формат(Год(КонецМесяца), "ЧГ=0") + ", " + Формат(Месяц(КонецМесяца), "ЧГ=0") + ", " + Формат(День(КонецМесяца), "ЧГ=0") + ", 23, 59, 59)";
	Текст = СтрЗаменить(Текст, "ДАТАВРЕМЯ(ГГГГ,ММ,1,0,0,0)", ЛитералНачала);
	Текст = СтрЗаменить(Текст, "ДАТАВРЕМЯ(ГГГГ, ММ, 1, 0, 0, 0)", ЛитералНачала);
	Текст = СтрЗаменить(Текст, "ДАТАВРЕМЯ(ГГГГ,ММ,КОНЕЦМЕСЯЦА,23,59,59)", ЛитералКонца);
	Текст = СтрЗаменить(Текст, "ДАТАВРЕМЯ(ГГГГ, ММ, КОНЕЦМЕСЯЦА, 23, 59, 59)", ЛитералКонца);
	Возврат Текст;
КонецФункции

Функция ВосстановитьВиртуальнуюТаблицуОборотовЕслиСкобкиБезСуффикса(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркеры = Новый Массив;
	Маркеры.Добавить("РегистрНакопления.");
	Маркеры.Добавить("РегистрБухгалтерии.");
	Маркеры.Добавить("РегистрСведений.");
	Для Каждого Маркер Из Маркеры Цикл
		ПозицияПоиска = 1;
		Пока Истина Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), ВРег(Маркер));
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = ПозицияПоиска + Поз - 1;
			Индекс = Поз + СтрДлина(Маркер);
			Пока Индекс <= СтрДлина(Текст) Цикл
				Символ = Сред(Текст, Индекс, 1);
				Если ЭтоСимволИдентификатораЗапроса(Символ) Тогда
					Индекс = Индекс + 1;
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЦикла;
			Пока Индекс <= СтрДлина(Текст) Цикл
				Символ = Сред(Текст, Индекс, 1);
				Если Символ = " " Или Символ = Символы.Таб Тогда
					Индекс = Индекс + 1;
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЦикла;
			Если Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) = "(" Тогда
				ХвостДоСкобки = ВРег(Сред(Текст, Поз, Индекс - Поз));
				Если СтрНайти(ХвостДоСкобки, ".ОБОРОТЫ") = 0
					И СтрНайти(ХвостДоСкобки, ".ОСТАТКИ") = 0
					И СтрНайти(ХвостДоСкобки, ".СРЕЗ") = 0 Тогда
					СуффиксОборотов = ".Обороты";
					Если СтрНайти(ВРег(Текст), "ПЕРИОД") > 0 Тогда
						СуффиксОборотов = ".Обороты";
					КонецЕсли;
					Текст = Лев(Текст, Индекс - 1) + СуффиксОборотов + Сред(Текст, Индекс);
					ПозицияПоиска = Индекс + СтрДлина(СуффиксОборотов);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ПозицияПоиска = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьОграничитьНаПервые(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Поз = СтрНайти(ТекстВРег, "ОГРАНИЧИТЬ ");
	Если Поз = 0 Тогда
		Поз = СтрНайти(ТекстВРег, Символы.ПС + "ОГРАНИЧИТЬ");
	КонецЕсли;
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Индекс = Поз;
	Пока Индекс <= СтрДлина(Текст) И НЕ (Сред(Текст, Индекс, 1) >= "0" И Сред(Текст, Индекс, 1) <= "9") Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
	ЧислоСтрокой = "";
	Пока Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) >= "0" И Сред(Текст, Индекс, 1) <= "9" Цикл
		ЧислоСтрокой = ЧислоСтрокой + Сред(Текст, Индекс, 1);
		Индекс = Индекс + 1;
	КонецЦикла;
	Текст = СокрП(Лев(Текст, Поз - 1)) + Сред(Текст, Индекс);
	Если ПустаяСтрока(ЧислоСтрокой) Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ВРег(Лев(Текст, 80)), "ПЕРВЫЕ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозВыбрать = СтрНайти(ВРег(Текст), "ВЫБРАТЬ");
	Если ПозВыбрать = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозВыбрать + СтрДлина("ВЫБРАТЬ") - 1) + " ПЕРВЫЕ " + ЧислоСтрокой + Сред(Текст, ПозВыбрать + СтрДлина("ВЫБРАТЬ"));
КонецФункции

Функция ДобавитьПервыеЕслиОтсутствуют(ТекстЗапроса)
	Возврат ОбеспечитьПервыеВоВсехВыборкахВерхнегоУровня(ТекстЗапроса, 100, 500);
КонецФункции

Функция ОграничитьПервыеВЗапросе(ТекстЗапроса, МаксСтрок)
	Возврат ОбеспечитьПервыеВоВсехВыборкахВерхнегоУровня(ТекстЗапроса, 100, МаксСтрок);
КонецФункции

Функция ОбеспечитьПервыеВоВсехВыборкахВерхнегоУровня(ТекстЗапроса, ПоУмолчанию, МаксСтрок)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Текст;
	КонецЕсли;
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ВЫБРАТЬ", ПозицияПоиска);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Поз + СтрДлина("ВЫБРАТЬ"));
		Если ВРег(Сред(Текст, Индекс, 6)) = "ПЕРВЫЕ" Тогда
			ИндексЧисла = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс + 6);
			ЧислоСтрокой = "";
			Курсор = ИндексЧисла;
			Пока Курсор <= СтрДлина(Текст) И Сред(Текст, Курсор, 1) >= "0" И Сред(Текст, Курсор, 1) <= "9" Цикл
				ЧислоСтрокой = ЧислоСтрокой + Сред(Текст, Курсор, 1);
				Курсор = Курсор + 1;
			КонецЦикла;
			Если НЕ ПустаяСтрока(ЧислоСтрокой) И Число(ЧислоСтрокой) > МаксСтрок Тогда
				Текст = Лев(Текст, ИндексЧисла - 1) + Формат(МаксСтрок, "ЧГ=0") + Сред(Текст, Курсор);
				ПозицияПоиска = ИндексЧисла + СтрДлина(Формат(МаксСтрок, "ЧГ=0"));
			Иначе
				ПозицияПоиска = ?(ПустаяСтрока(ЧислоСтрокой), Индекс + 6, Курсор);
			КонецЕсли;
		Иначе
			Вставка = " ПЕРВЫЕ " + Формат(ПоУмолчанию, "ЧГ=0") + " ";
			Текст = Лев(Текст, Поз + СтрДлина("ВЫБРАТЬ") - 1) + Вставка + Сред(Текст, Индекс);
			ПозицияПоиска = Поз + СтрДлина("ВЫБРАТЬ") + СтрДлина(Вставка);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция УбратьПервыеИВисячийИИзСекцииГде(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозГде = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ГДЕ", 1);
	Если ПозГде = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозКонца = СтрДлина(Текст) + 1;
	Для Каждого Маркер Из СтрРазделить("СГРУППИРОВАТЬ,УПОРЯДОЧИТЬ,ИМЕЮЩИЕ,ИТОГИ", ",") Цикл
		Поз = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, Маркер, ПозГде + 3);
		Если Поз > 0 И Поз < ПозКонца Тогда
			ПозКонца = Поз;
		КонецЕсли;
	КонецЦикла;
	Секция = Сред(Текст, ПозГде + 3, ПозКонца - ПозГде - 3);
	СекцияВРег = ВРег(Секция);
	ПозПервые = СтрНайти(СекцияВРег, "ПЕРВЫЕ ");
	Если ПозПервые > 0 Тогда
		Индекс = ПозПервые + СтрДлина("ПЕРВЫЕ ");
		Пока Индекс <= СтрДлина(Секция) И Сред(Секция, Индекс, 1) >= "0" И Сред(Секция, Индекс, 1) <= "9" Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
		Секция = СокрП(Лев(Секция, ПозПервые - 1)) + Сред(Секция, Индекс);
	КонецЕсли;
	Секция = СокрЛП(Секция);
	Пока ВРег(Лев(Секция, 2)) = "И " Или ВРег(Прав(Секция, 2)) = " И" Цикл
		Если ВРег(Лев(Секция, 2)) = "И " Тогда
			Секция = СокрЛП(Сред(Секция, 3));
		КонецЕсли;
		Если ВРег(Прав(Секция, 2)) = " И" Тогда
			Секция = СокрЛП(Лев(Секция, СтрДлина(Секция) - 2));
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Секция) Тогда
		Возврат СокрП(Лев(Текст, ПозГде - 1)) + Сред(Текст, ПозКонца);
	КонецЕсли;
	Возврат Лев(Текст, ПозГде + 2) + " " + Секция + Сред(Текст, ПозКонца);
КонецФункции

Функция ВынестиПервыеИзАргументовФункций(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ЛимитПервые = "";
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(ТекстВРег, "(ПЕРВЫЕ");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Индекс = Поз + СтрДлина("(ПЕРВЫЕ");
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		ЧислоСтрокой = "";
		Пока Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) >= "0" И Сред(Текст, Индекс, 1) <= "9" Цикл
			ЧислоСтрокой = ЧислоСтрокой + Сред(Текст, Индекс, 1);
			Индекс = Индекс + 1;
		КонецЦикла;
		Если ПустаяСтрока(ЧислоСтрокой) Тогда
			Прервать;
		КонецЕсли;
		ЛимитПервые = ЧислоСтрокой;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		Если Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) = "," Тогда
			Индекс = Индекс + 1;
			Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		КонецЕсли;
		Текст = Лев(Текст, Поз) + Сред(Текст, Индекс);
	КонецЦикла;
	Если ПустаяСтрока(ЛимитПервые) Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ВРег(Лев(Текст, 80)), "ПЕРВЫЕ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозВыбрать = СтрНайти(ВРег(Текст), "ВЫБРАТЬ");
	Если ПозВыбрать = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозВыбрать + СтрДлина("ВЫБРАТЬ") - 1) + " ПЕРВЫЕ " + ЛимитПервые + Сред(Текст, ПозВыбрать + СтрДлина("ВЫБРАТЬ"));
КонецФункции

Функция УпроститьВыборПоВидуДвиженияЕслиПолеОтсутствует(ТекстЗапроса, Whitelist, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Текст = УдалитьУсловиеВидаДвиженияЕслиПолеОтсутствует(Текст, Whitelist);
	Если СтрНайти(ВРег(Текст), "ВЫБОР") = 0 Или СтрНайти(ВРег(Текст), "ВИДДВИЖЕНИЯ") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ИсточникДокумент = СтрНайти(ВРег(Строка(ПолноеИмяОбъекта)), "ДОКУМЕНТ.") > 0
		Или СтрНайти(ТекстВРег, "ДОКУМЕНТ.") > 0;
	ИсточникОбороты = СтрНайти(ТекстВРег, ".ОБОРОТЫ") > 0;
	ВидДвиженияЕсть = ПолеЕстьВWhitelistЛокально(Whitelist, "ВидДвижения");
	Если ВидДвиженияЕсть И НЕ ИсточникДокумент И НЕ ИсточникОбороты Тогда
		Возврат Текст;
	КонецЕсли;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		ПозВыбор = СтрНайти(ТекстВРег, "ВЫБОР");
		Если ПозВыбор = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозКонец = СтрНайти(Сред(ТекстВРег, ПозВыбор), "КОНЕЦ");
		Если ПозКонец = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозКонец = ПозВыбор + ПозКонец - 1;
		Фрагмент = Сред(Текст, ПозВыбор, ПозКонец + 5 - ПозВыбор);
		Если СтрНайти(ВРег(Фрагмент), "ВИДДВИЖЕНИЯ") = 0 Тогда
			Прервать;
		КонецЕсли;
		Замена = "";
		ПозИначе = СтрНайти(ВРег(Фрагмент), "ИНАЧЕ");
		Если ПозИначе > 0 Тогда
			Замена = СокрЛП(Сред(Фрагмент, ПозИначе + 5));
			Если ВРег(Прав(Замена, 5)) = "КОНЕЦ" Тогда
				Замена = СокрЛП(Лев(Замена, СтрДлина(Замена) - 5));
			КонецЕсли;
		Иначе
			ПозТогда = СтрНайти(ВРег(Фрагмент), "ТОГДА");
			Если ПозТогда > 0 Тогда
				Замена = СокрЛП(Сред(Фрагмент, ПозТогда + 5));
				Если ВРег(Прав(Замена, 5)) = "КОНЕЦ" Тогда
					Замена = СокрЛП(Лев(Замена, СтрДлина(Замена) - 5));
				КонецЕсли;
				Если СтрНачинаетсяС(Замена, "-") Тогда
					Замена = СокрЛП(Сред(Замена, 2));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(Замена) Тогда
			Прервать;
		КонецЕсли;
		Текст = Лев(Текст, ПозВыбор - 1) + Замена + Сред(Текст, ПозКонец + 5);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция УдалитьУсловиеВидаДвиженияЕслиПолеОтсутствует(ТекстЗапроса, Whitelist)
	Текст = Строка(ТекстЗапроса);
	Если СтрНайти(ВРег(Текст), "ВИДДВИЖЕНИЯ") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "ВидДвижения") Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Оставшиеся = Новый Массив;
	Для Каждого СтрокаТекста Из Строки Цикл
		Если СтрНайти(ВРег(СтрокаТекста), "ВИДДВИЖЕНИЯ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Оставшиеся.Добавить(СтрокаТекста);
	КонецЦикла;
	Текст = СтрСоединить(Оставшиеся, Символы.ПС);
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		ПозГде = СтрНайти(ТекстВРег, "ГДЕ");
		Если ПозГде = 0 Тогда
			Прервать;
		КонецЕсли;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, ПозГде + 3);
		Если Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) = ")" Тогда
			Текст = Лев(Текст, ПозГде - 1) + Сред(Текст, Индекс);
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция УдалитьФильтрДатЭпохиИзЗапроса(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, "ДАТАВРЕМЯ(1,") = 0 И СтрНайти(ТекстВРег, "ДАТАВРЕМЯ(1 ,") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	МаркерыЭпохи = Новый Массив;
	МаркерыЭпохи.Добавить(" МЕЖДУ ДАТАВРЕМЯ(1,1,1,0,0,0) И ДАТАВРЕМЯ(1,1,1,0,0,0)");
	МаркерыЭпохи.Добавить(" МЕЖДУ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) И ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)");
	МаркерыЭпохи.Добавить(" МЕЖДУ ДАТАВРЕМЯ(1,1,1) И ДАТАВРЕМЯ(1,1,1)");
	МаркерыЭпохи.Добавить(" МЕЖДУ ДАТАВРЕМЯ(1, 1, 1) И ДАТАВРЕМЯ(1, 1, 1)");
	Для Каждого Маркер Из МаркерыЭпохи Цикл
		Пока СтрНайти(ВРег(Текст), ВРег(Маркер)) > 0 Цикл
			Текст = СтрЗаменить(Текст, Маркер, "");
			Текст = СтрЗаменить(Текст, ВРег(Маркер), "");
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ДобавитьПериодичностьАвтоДляПоляПериод(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	НуженПериод = ЗапросСодержитПолеПериод(Текст);
	Если СтрНайти(ТекстВРег, ".ОБОРОТЫ(") = 0 Тогда
		Если НуженПериод И (СтрНайти(ТекстВРег, ".ОБОРОТЫ") > 0 Или СтрНайти(ТекстВРег, ".ОСТАТКИИОБОРОТЫ") > 0) Тогда
			Текст = ДобавитьСкобкиВиртуальнойТаблицыЕслиОтсутствуют(Текст);
			ТекстВРег = ВРег(Текст);
		КонецЕсли;
		Если СтрНайти(ТекстВРег, ".ОБОРОТЫ(") = 0 Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЕсли;
	Маркер = ".ОБОРОТЫ(";
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Маркер);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		ПозОткр = Поз + СтрДлина(Маркер) - 1;
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозОткр);
		Если КонецСкобки = 0 Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		Внутри = Сред(Текст, ПозОткр + 1, КонецСкобки - ПозОткр - 1);
		Глубина = 0;
		ЧислоЗапятыхВерхнегоУровня = 0;
		Для Индекс = 1 По СтрДлина(Внутри) Цикл
			Символ = Сред(Внутри, Индекс, 1);
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" И Глубина > 0 Тогда
				Глубина = Глубина - 1;
			ИначеЕсли Символ = "," И Глубина = 0 Тогда
				ЧислоЗапятыхВерхнегоУровня = ЧислоЗапятыхВерхнегоУровня + 1;
			КонецЕсли;
		КонецЦикла;
		Если ЧислоЗапятыхВерхнегоУровня = 0 Тогда
			Если НЕ НуженПериод Тогда
				ПозицияПоиска = КонецСкобки + 1;
				Продолжить;
			КонецЕсли;
			Вставка = СокрП(Внутри);
			Если ПустаяСтрока(Вставка) Тогда
				Вставка = ", , День";
			Иначе
				Вставка = Вставка + ", , День";
			КонецЕсли;
			Текст = Лев(Текст, ПозОткр) + Вставка + Сред(Текст, КонецСкобки);
			ПозицияПоиска = ПозОткр + СтрДлина(Вставка) + 1;
			Продолжить;
		КонецЕсли;
		Если ЧислоЗапятыхВерхнегоУровня = 1 Тогда
			Вставка = СокрП(Внутри);
			Если Прав(Вставка, 1) = "," Тогда
				Вставка = Вставка + " День";
			Иначе
				Вставка = Вставка + ", День";
			КонецЕсли;
			Текст = Лев(Текст, ПозОткр) + Вставка + Сред(Текст, КонецСкобки);
			ПозицияПоиска = ПозОткр + СтрДлина(Вставка) + 1;
			Продолжить;
		КонецЕсли;
		Если ЧислоЗапятыхВерхнегоУровня >= 2 Тогда
			ТретийАргумент = "";
			ГлубинаАргумента = 0;
			НомерАргумента = 1;
			НачалоТретьего = 0;
			КонецТретьего = СтрДлина(Внутри) + 1;
			Для Индекс = 1 По СтрДлина(Внутри) Цикл
				Символ = Сред(Внутри, Индекс, 1);
				Если Символ = "(" Тогда
					ГлубинаАргумента = ГлубинаАргумента + 1;
				ИначеЕсли Символ = ")" И ГлубинаАргумента > 0 Тогда
					ГлубинаАргумента = ГлубинаАргумента - 1;
				ИначеЕсли Символ = "," И ГлубинаАргумента = 0 Тогда
					НомерАргумента = НомерАргумента + 1;
					Если НомерАргумента = 3 Тогда
						НачалоТретьего = Индекс + 1;
					ИначеЕсли НомерАргумента = 4 И КонецТретьего > Индекс Тогда
						КонецТретьего = Индекс;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НачалоТретьего > 0 Тогда
				ТретийАргумент = СокрЛП(Сред(Внутри, НачалоТретьего, КонецТретьего - НачалоТретьего));
			КонецЕсли;
			Если ПустаяСтрока(ТретийАргумент) Или ВРег(ТретийАргумент) = "АВТО" Тогда
				Вставка = СокрП(Лев(Внутри, НачалоТретьего - 1)) + " День";
				Текст = Лев(Текст, ПозОткр) + Вставка + Сред(Текст, КонецСкобки);
				ПозицияПоиска = ПозОткр + СтрДлина(Вставка) + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ПозицияПоиска = КонецСкобки + 1;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ОбеспечитьПериодВиртуальнойТаблицыОборотов(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Если НЕ ЗапросСодержитПолеПериод(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОСТАТКИ(") > 0 Или СтрНайти(ТекстВРег, ".ОСТАТКИ ") > 0 Тогда
		Текст = ЗаменитьВиртуальнуюТаблицуОстатковНаОбороты(Текст, ".ОСТАТКИИОБОРОТЫ");
		Текст = ЗаменитьВиртуальнуюТаблицуОстатковНаОбороты(Текст, ".ОСТАТКИ");
	КонецЕсли;
	Возврат ДобавитьПериодичностьАвтоДляПоляПериод(Текст);
КонецФункции

Функция ЗапросСодержитПолеПериод(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), "ПЕРИОД");
		Если Поз = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		Перед = ?(Поз > 1, Сред(ТекстВРег, Поз - 1, 1), " ");
		После = Сред(ТекстВРег, Поз + СтрДлина("ПЕРИОД"), 1);
		ЭтоИдентификаторПеред = ЭтоСимволИдентификатораЗапроса(Перед);
		ЭтоИдентификаторПосле = ЭтоСимволИдентификатораЗапроса(После);
		Если НЕ ЭтоИдентификаторПеред И НЕ ЭтоИдентификаторПосле Тогда
			Возврат Истина;
		КонецЕсли;
		ПозицияПоиска = Поз + СтрДлина("ПЕРИОД");
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция УдалитьУсловияСЛитеральнымКак(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозГде = СтрНайти(ТекстВРег, Символы.ПС + "ГДЕ");
	ДлинаМаркера = 4;
	Если ПозГде = 0 Тогда
		ПозГде = СтрНайти(ТекстВРег, " ГДЕ ");
		ДлинаМаркера = 5;
	КонецЕсли;
	Если ПозГде = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозКонец = СтрДлина(Текст) + 1;
	МаркерыКонца = Новый Массив;
	МаркерыКонца.Добавить(Символы.ПС + "СГРУППИРОВАТЬ ПО");
	МаркерыКонца.Добавить(Символы.ПС + "УПОРЯДОЧИТЬ ПО");
	МаркерыКонца.Добавить(Символы.ПС + "ИМЕЮЩИЕ");
	МаркерыКонца.Добавить(Символы.ПС + "ИТОГИ");
	Для Каждого МаркерКонца Из МаркерыКонца Цикл
		ПозКандидат = СтрНайти(Сред(ТекстВРег, ПозГде + ДлинаМаркера), МаркерКонца);
		Если ПозКандидат > 0 И (ПозГде + ДлинаМаркера + ПозКандидат - 1) < ПозКонец Тогда
			ПозКонец = ПозГде + ДлинаМаркера + ПозКандидат - 1;
		КонецЕсли;
	КонецЦикла;
	СекцияГде = Сред(Текст, ПозГде + ДлинаМаркера, ПозКонец - ПозГде - ДлинаМаркера);
	СтрокиУсловий = СтрРазделить(СекцияГде, Символы.ПС, Ложь);
	Оставшиеся = Новый Массив;
	БылиУдаления = Ложь;
	Для Каждого СтрокаУсловия Из СтрокиУсловий Цикл
		СтрокаВРег = ВРег(СтрокаУсловия);
		ПозКак = СтрНайти(СтрокаВРег, " КАК ");
		ЭтоПлохойКак = Ложь;
		Если ПозКак > 0 Тогда
			Хвост = СокрЛ(Сред(СтрокаУсловия, ПозКак + 5));
			ПервыйСимвол = Лев(Хвост, 1);
			ХвостВРег = ВРег(Хвост);
			ЭтоПриведениеТипа = СтрНачинаетсяС(ХвостВРег, "СПРАВОЧНИК.")
				Или СтрНачинаетсяС(ХвостВРег, "ДОКУМЕНТ.")
				Или СтрНачинаетсяС(ХвостВРег, "ПЕРЕЧИСЛЕНИЕ.")
				Или СтрНачинаетсяС(ХвостВРег, "РЕГИСТР");
			Если НЕ ЭтоПриведениеТипа И (ПервыйСимвол = "'" Или ПервыйСимвол = """") Тогда
				ЭтоПлохойКак = Истина;
			КонецЕсли;
		КонецЕсли;
		Если ЭтоПлохойКак Тогда
			БылиУдаления = Истина;
			Продолжить;
		КонецЕсли;
		Оставшиеся.Добавить(СтрокаУсловия);
	КонецЦикла;
	Если НЕ БылиУдаления Тогда
		Возврат Текст;
	КонецЕсли;
	Если Оставшиеся.Количество() = 0 Тогда
		Возврат СокрП(Лев(Текст, ПозГде - 1)) + Сред(Текст, ПозКонец);
	КонецЕсли;
	НоваяСекция = СтрСоединить(Оставшиеся, Символы.ПС);
	НоваяСекцияВРег = ВРег(СокрЛП(НоваяСекция));
	Пока СтрНачинаетсяС(НоваяСекцияВРег, "И ") Или СтрНачинаетсяС(НоваяСекцияВРег, "ИЛИ ") Цикл
		НоваяСекция = СокрЛП(Сред(СокрЛП(НоваяСекция), ?(СтрНачинаетсяС(НоваяСекцияВРег, "ИЛИ "), 4, 2)));
		НоваяСекцияВРег = ВРег(СокрЛП(НоваяСекция));
	КонецЦикла;
	Возврат Лев(Текст, ПозГде + ДлинаМаркера - 1) + " " + НоваяСекция + Сред(Текст, ПозКонец);
КонецФункции

Функция ПереместитьПервыеВНачалоВыборки(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(СокрЛП(Текст));
	Если НЕ СтрНачинаетсяС(ТекстВРег, "ВЫБРАТЬ") Тогда
		Возврат Текст;
	КонецЕсли;
	ПозВыбратьПроверка = СтрНайти(ВРег(Текст), "ВЫБРАТЬ");
	ИндексПослеВыбрать = ПропуститьПробелыВТекстеЗапроса(Текст, ПозВыбратьПроверка + СтрДлина("ВЫБРАТЬ"));
	Если ВРег(Сред(Текст, ИндексПослеВыбрать, СтрДлина("ПЕРВЫЕ"))) = "ПЕРВЫЕ" Тогда
		Возврат Текст;
	КонецЕсли;
	ХвостВРег = ВРег(Текст);
	ПозПервые = 0;
	МаркерПервые = "";
	Для Каждого Маркер Из СтрРазделить("ПЕРВЫЕ 1000,ПЕРВЫЕ 100,ПЕРВЫЕ 10,ПЕРВЫЕ 50,ПЕРВЫЕ 20,ПЕРВЫЕ 5,ПЕРВЫЕ 3", ",") Цикл
		Поз = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ХвостВРег, Маркер, 1);
		Если Поз > 0 И (ПозПервые = 0 Или Поз > ПозПервые) Тогда
			ПозПервые = Поз;
			МаркерПервые = Маркер;
		КонецЕсли;
	КонецЦикла;
	Если ПозПервые = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Если ПозПервые < СтрДлина(Текст) / 2 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = СокрП(Лев(Текст, ПозПервые - 1)) + Сред(Текст, ПозПервые + СтрДлина(МаркерПервые));
	ПозВыбрать = СтрНайти(ВРег(Текст), "ВЫБРАТЬ");
	Если ПозВыбрать = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозВыбрать + СтрДлина("ВЫБРАТЬ") - 1) + " " + МаркерПервые + Сред(Текст, ПозВыбрать + СтрДлина("ВЫБРАТЬ"));
КонецФункции

Функция НормализоватьСекциюВыбратьПоWhitelistЛокально(СекцияВыбрать, Псевдоним, Whitelist, ИмяОбъекта)
	НовыеВыражения = Новый Массив;
	Для Каждого ЧастьВыбора Из РазделитьВыраженияСпискаЗапроса(СекцияВыбрать) Цикл
		Выражение = СокрЛП(Строка(ЧастьВыбора));
		Если ПустаяСтрока(Выражение) Тогда
			Продолжить;
		КонецЕсли;
		ПозКак = СтрНайти(ВРег(Выражение), " КАК ");
		ИсходноеВыражение = Выражение;
		ПсевдонимПоля = "";
		Если ПозКак > 0 Тогда
			ИсходноеВыражение = СокрЛП(Лев(Выражение, ПозКак - 1));
			ПсевдонимПоля = СокрЛП(Сред(Выражение, ПозКак + 5));
		КонецЕсли;
		БазовоеИмяПоля = ПолучитьБазовоеИмяПоляЛокально(ИсходноеВыражение);
		ПрефиксКвалификатора = ПолучитьПрефиксКвалификатораПоляЛокально(ИсходноеВыражение);
		ЗаменаПоля = "";
		Если ПолеЕстьВWhitelistЛокально(Whitelist, БазовоеИмяПоля) Тогда
			ЗаменаПоля = КаноническоеИмяПоляИзWhitelist(Whitelist, БазовоеИмяПоля);
		ИначеЕсли НЕ ПустаяСтрока(ИмяОбъекта) И ВРег(БазовоеИмяПоля) = ВРег(ИмяОбъекта) И ПолеЕстьВWhitelistЛокально(Whitelist, "Ссылка") Тогда
			ЗаменаПоля = "Ссылка";
		ИначеЕсли БазовоеИмяПоля = Псевдоним И ПолеЕстьВWhitelistЛокально(Whitelist, "Ссылка") Тогда
			ЗаменаПоля = "Ссылка";
		ИначеЕсли ВРег(БазовоеИмяПоля) = "СУММА" Тогда
			Если ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаДокумента") Тогда
				ЗаменаПоля = "СуммаДокумента";
			ИначеЕсли ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаОборот") Тогда
				ЗаменаПоля = "СуммаОборот";
			ИначеЕсли ПолеЕстьВWhitelistЛокально(Whitelist, "Сумма") Тогда
				ЗаменаПоля = "Сумма";
			КонецЕсли;
		ИначеЕсли ВРег(БазовоеИмяПоля) = "ДЕНЬ" Или ВРег(БазовоеИмяПоля) = "ДАТА" Тогда
			ПолеДаты = "";
			Если ПолеЕстьВWhitelistЛокально(Whitelist, "Дата") Тогда
				ПолеДаты = "Дата";
			ИначеЕсли ПолеЕстьВWhitelistЛокально(Whitelist, "Период") Тогда
				ПолеДаты = "Период";
			КонецЕсли;
			Если НЕ ПустаяСтрока(ПолеДаты) Тогда
				ПрефиксДаты = ПрефиксКвалификатора;
				Если ЭтоСистемныйПрефиксКвалификатораПоляЛокально(ПрефиксДаты) Тогда
					ПрефиксДаты = ?(ПустаяСтрока(Псевдоним), "", Псевдоним + ".");
				ИначеЕсли ПустаяСтрока(ПрефиксДаты) И НЕ ПустаяСтрока(Псевдоним) Тогда
					ПрефиксДаты = Псевдоним + ".";
				КонецЕсли;
				АлиасДня = ?(ПустаяСтрока(ПсевдонимПоля), "День", ПсевдонимПоля);
				НовыеВыражения.Добавить("НАЧАЛОПЕРИОДА(" + ПрефиксДаты + ПолеДаты + ", ДЕНЬ) КАК " + АлиасДня);
				Продолжить;
			КонецЕсли;
		Иначе
			Семантика = ПодобратьСемантическуюЗаменуПоля(БазовоеИмяПоля, Whitelist);
			Если НЕ ПустаяСтрока(Семантика) Тогда
				ЗаменаПоля = Семантика;
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(ЗаменаПоля) Тогда
			Если СтрНайти(ИсходноеВыражение, "(") > 0 Тогда
				Выражение = ПодставитьСуммовоеПолеВоВыражениеЗапроса(Выражение, Whitelist);
				Если ВыражениеВыборкиСодержитПолеВнеWhitelist(Выражение, Whitelist) Тогда
					Продолжить;
				КонецЕсли;
				Если ВРег(ПсевдонимПоля) = "ДАТА" И (СтрНайти(ВРег(Выражение), "НАЧАЛОПЕРИОДА(") > 0 Или СтрНайти(ВРег(Выражение), ", ДЕНЬ)") > 0) Тогда
					ПозКакАлиас = СтрНайти(ВРег(Выражение), " КАК ");
					Если ПозКакАлиас > 0 Тогда
						Выражение = Лев(Выражение, ПозКакАлиас - 1) + " КАК День";
					КонецЕсли;
				КонецЕсли;
				НовыеВыражения.Добавить(Выражение);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ВРег(СокрЛП(ЗаменаПоля)) <> ВРег(СокрЛП(БазовоеИмяПоля))
			И СтрНайти(ИсходноеВыражение, "(") > 0 Тогда
			Выражение = ЗаменитьИдентификаторВТекстеЗапроса(Выражение, БазовоеИмяПоля, ЗаменаПоля);
			НовыеВыражения.Добавить(Выражение);
			Продолжить;
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, БазовоеИмяПоля)
			И ВРег(СокрЛП(ЗаменаПоля)) = ВРег(СокрЛП(БазовоеИмяПоля)) Тогда
			НовыеВыражения.Добавить(Выражение);
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(ПсевдонимПоля) Тогда
			ПсевдонимПоля = ЗаменаПоля;
		КонецЕсли;
		Если ЭтоСистемныйПрефиксКвалификатораПоляЛокально(ПрефиксКвалификатора) Тогда
			ПрефиксКвалификатора = "";
		КонецЕсли;
		НовыеВыражения.Добавить(ПрефиксКвалификатора + ЗаменаПоля + " КАК " + ПсевдонимПоля);
	КонецЦикла;
	Если НовыеВыражения.Количество() = 0 Тогда
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "Сумма") Тогда
			Возврат "СУММА(" + ?(ПустаяСтрока(Псевдоним), "", Псевдоним + ".") + "Сумма) КАК Сумма";
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаДокумента") Тогда
			Возврат ?(ПустаяСтрока(Псевдоним), "", Псевдоним + ".") + "СуммаДокумента КАК Сумма";
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "Ссылка") Тогда
			Если ПустаяСтрока(Псевдоним) Или ЭтоСистемныйПрефиксКвалификатораПоляЛокально(Псевдоним + ".") Тогда
				Возврат "Ссылка КАК Ссылка";
			КонецЕсли;
			Возврат Псевдоним + ".Ссылка КАК Ссылка";
		КонецЕсли;
		Возврат СекцияВыбрать;
	КонецЕсли;
	Возврат СтрСоединить(НовыеВыражения, ", ");
КонецФункции

Функция ОценитьПохожестьПоля(ИсходноеПоле, Кандидат)
	ИсходноеСырое = СокрЛП(Строка(ИсходноеПоле));
	КандидатСырой = СокрЛП(Строка(Кандидат));
	Исходное = ВРег(ИсходноеСырое);
	КандидатВРег = ВРег(КандидатСырой);
	Если ПустаяСтрока(Исходное) ИЛИ ПустаяСтрока(КандидатВРег) Тогда
		Возврат -1;
	КонецЕсли;
	Если Исходное = КандидатВРег Тогда
		Возврат 1000;
	КонецЕсли;
	Если СовпадаютТокеныCamelCaseПоля(ИсходноеСырое, КандидатСырой) Тогда
		Возврат 900;
	КонецЕсли;
	СемантикаИсходного = КаноническаяСемантикаПоля(ИсходноеСырое);
	СемантикаКандидата = КаноническаяСемантикаПоля(КандидатСырой);
	Если НЕ ПустаяСтрока(СемантикаИсходного) И СемантикаИсходного = СемантикаКандидата Тогда
		Возврат 850;
	КонецЕсли;
	Оценка = 0;
	Для Индекс = 1 По Мин(СтрДлина(Исходное), СтрДлина(КандидатВРег)) Цикл
		Если Сред(Исходное, Индекс, 1) <> Сред(КандидатВРег, Индекс, 1) Тогда
			Прервать;
		КонецЕсли;
		Оценка = Оценка + 5;
	КонецЦикла;
	Если СтрНайти(КандидатВРег, Исходное) > 0 Тогда
		Оценка = Оценка + 40;
	КонецЕсли;
	Если СтрНайти(Исходное, КандидатВРег) > 0 Тогда
		Оценка = Оценка + 20;
	КонецЕсли;
	Если СтрНайти(Исходное, "СУММА") > 0 И СтрНайти(КандидатВРег, "СУММА") > 0 Тогда
		Оценка = Оценка + 30;
	КонецЕсли;
	Возврат Оценка;
КонецФункции

Функция КаноническаяСемантикаПоля(ИмяПоля)
	НормИмя = ВРег(СокрЛП(Строка(ИмяПоля)));
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат "";
	КонецЕсли;
	СимволыДляУдаления = Новый Массив;
	СимволыДляУдаления.Добавить(" ");
	СимволыДляУдаления.Добавить(".");
	СимволыДляУдаления.Добавить(",");
	СимволыДляУдаления.Добавить(";");
	СимволыДляУдаления.Добавить(":");
	СимволыДляУдаления.Добавить("-");
	СимволыДляУдаления.Добавить("_");
	СимволыДляУдаления.Добавить("'");
	СимволыДляУдаления.Добавить("""");
	СимволыДляУдаления.Добавить("(");
	СимволыДляУдаления.Добавить(")");
	Для Каждого Символ Из СимволыДляУдаления Цикл
		НормИмя = СтрЗаменить(НормИмя, Символ, "");
	КонецЦикла;
	Если СтрДлина(НормИмя) > 4 Тогда
		Окончания = Новый Массив;
		Окончания.Добавить("АМИ");
		Окончания.Добавить("ЯМИ");
		Окончания.Добавить("ОВ");
		Окончания.Добавить("ЕВ");
		Окончания.Добавить("ОМ");
		Окончания.Добавить("ЕМ");
		Окончания.Добавить("ОЙ");
		Окончания.Добавить("ИЙ");
		Окончания.Добавить("ЫЙ");
		Окончания.Добавить("АЯ");
		Окончания.Добавить("ЯЯ");
		Окончания.Добавить("Ы");
		Окончания.Добавить("И");
		Окончания.Добавить("А");
		Окончания.Добавить("Я");
		Окончания.Добавить("Ь");
		Для Каждого Окончание Из Окончания Цикл
			Если Прав(НормИмя, СтрДлина(Окончание)) = Окончание Тогда
				НормИмя = Лев(НормИмя, СтрДлина(НормИмя) - СтрДлина(Окончание));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ПустаяСтрока(НормИмя) Тогда
		Возврат "";
	КонецЕсли;
	Если НормИмя = "КОНТРАГЕНТ"
		ИЛИ НормИмя = "ПОСТАВЩИК"
		ИЛИ НормИмя = "ПОКУПАТЕЛ"
		ИЛИ НормИмя = "КЛИЕНТ"
		ИЛИ НормИмя = "ЗАКАЗЧИК"
		ИЛИ НормИмя = "ПРОДАВЕЦ" Тогда
		Возврат "КОНТРАГЕНТ";
	КонецЕсли;
	Если НормИмя = "ПЕРИОД"
		ИЛИ НормИмя = "ДАТА"
		ИЛИ СтрНачинаетсяС(НормИмя, "ПЕРИОДРЕГИСТР") Тогда
		Возврат "ПЕРИОД";
	КонецЕсли;
	Если НормИмя = "ДОКУМЕНТ"
		ИЛИ НормИмя = "РЕГИСТРАТОР" Тогда
		Возврат "РЕГИСТРАТОР";
	КонецЕсли;
	Если НормИмя = "ДОКУМЕНТПОСТУПЛЕНИ"
		ИЛИ НормИмя = "ДОКУМЕНТОСНОВАНИ"
		ИЛИ НормИмя = "ОСНОВАНИ"
		ИЛИ НормИмя = "СЧЕТ"
		ИЛИ НормИмя = "СЧЕТНАОПЛАТ"
		ИЛИ НормИмя = "СЧЕТПОСТАВЩИК" Тогда
		Возврат "ДОКУМЕНТОСНОВАНИЕ";
	КонецЕсли;
	Возврат НормИмя;
КонецФункции

Функция ЭтоГраницаCamelCase(ПредыдущийСимвол, ТекущийСимвол)
	Если ПустаяСтрока(Строка(ПредыдущийСимвол)) Или ПустаяСтрока(Строка(ТекущийСимвол)) Тогда
		Возврат Ложь;
	КонецЕсли;
	КодПред = КодСимвола(ПредыдущийСимвол);
	КодТек = КодСимвола(ТекущийСимвол);
	ЭтоПредБуква = ((КодПред >= 65 И КодПред <= 90) Или (КодПред >= 97 И КодПред <= 122)
		Или (КодПред >= 1040 И КодПред <= 1103) Или КодПред = 1025 Или КодПред = 1105);
	ЭтоТекБуква = ((КодТек >= 65 И КодТек <= 90) Или (КодТек >= 97 И КодТек <= 122)
		Или (КодТек >= 1040 И КодТек <= 1103) Или КодТек = 1025 Или КодТек = 1105);
	Если НЕ ЭтоПредБуква Или НЕ ЭтоТекБуква Тогда
		Возврат Ложь;
	КонецЕсли;
	ЭтоПредСтрочная = ((КодПред >= 97 И КодПред <= 122) Или (КодПред >= 1072 И КодПред <= 1103) Или КодПред = 1105);
	ЭтоТекЗаглавная = ((КодТек >= 65 И КодТек <= 90) Или (КодТек >= 1040 И КодТек <= 1071) Или КодТек = 1025);
	Возврат ЭтоПредСтрочная И ЭтоТекЗаглавная;
КонецФункции

Функция РазбитьCamelCaseПолеНаТокены(ИмяПоля)
	Результат = Новый Массив;
	Текст = СокрЛП(Строка(ИмяПоля));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	ТекущийТокен = "";
	ПредыдущийСимвол = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если НЕ ПустаяСтрока(ТекущийТокен) И ЭтоГраницаCamelCase(ПредыдущийСимвол, Символ) Тогда
			Результат.Добавить(ВРег(ТекущийТокен));
			ТекущийТокен = Символ;
		Иначе
			ТекущийТокен = ТекущийТокен + Символ;
		КонецЕсли;
		ПредыдущийСимвол = Символ;
	КонецЦикла;
	Если НЕ ПустаяСтрока(ТекущийТокен) Тогда
		Результат.Добавить(ВРег(ТекущийТокен));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СовпадаютТокеныCamelCaseПоля(ИсходноеПоле, Кандидат)
	ТокеныИсходного = РазбитьCamelCaseПолеНаТокены(ИсходноеПоле);
	ТокеныКандидата = РазбитьCamelCaseПолеНаТокены(Кандидат);
	Если ТокеныИсходного.Количество() < 2 Или ТокеныИсходного.Количество() <> ТокеныКандидата.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Токен Из ТокеныИсходного Цикл
		Если ТокеныКандидата.Найти(Токен) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПолеЕстьВWhitelistЛокально(Whitelist, ИмяПоля)
	Для Каждого Кандидат Из Whitelist Цикл
		Если ВРег(Строка(Кандидат)) = ВРег(Строка(ИмяПоля)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция КаноническоеИмяПоляИзWhitelist(Whitelist, ИмяПоля)
	Для Каждого Кандидат Из Whitelist Цикл
		Если ВРег(Строка(Кандидат)) = ВРег(Строка(ИмяПоля)) Тогда
			Возврат Строка(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат Строка(ИмяПоля);
КонецФункции

Функция ПолучитьWhitelistПолейДляНормализации(ПолноеИмяОбъекта, КонтекстВыполнения)
	ЛокальныйWhitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если ЛокальныйWhitelist.Количество() > 0 Тогда
		Возврат ЛокальныйWhitelist;
	КонецЕсли;
	Если КонтекстВыполнения <> Неопределено И ТипЗнч(КонтекстВыполнения) = Тип("Структура")
		И КонтекстВыполнения.Свойство("DSL_РазрешенныеПоляОбъекта")
		И ТипЗнч(КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта) = Тип("Массив")
		И КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта.Количество() > 0 Тогда
		Возврат КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта;
	КонецЕсли;
	Возврат ЛокальныйWhitelist;
КонецФункции

Функция НормализоватьВиртуальныеТаблицыОстатковВЗапросе(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ИмяРегистра = ПолноеИмяОбъекта;
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ИмяРегистра = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	КонецЕсли;
	ИмяРегистра = НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(ИмяРегистра);
	Разбор = РазобратьПолноеИмяОбъекта(ИмяРегистра);
	Если Разбор.ObjectType <> "РегистрНакопления" Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ЗапросСПериодом = ЗапросСодержитПолеПериод(Текст);
	Если РегистрНакопленияПоддерживаетОстаткиПоПолномуИмени(ИмяРегистра) И НЕ ЗапросСПериодом Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ЗаменитьВиртуальнуюТаблицуОстатковНаОбороты(Текст, ".ОСТАТКИИОБОРОТЫ");
	Текст = ЗаменитьВиртуальнуюТаблицуОстатковНаОбороты(Текст, ".ОСТАТКИ");
	Возврат Текст;
КонецФункции

Функция ЗаменитьВиртуальнуюТаблицуОстатковНаОбороты(ТекстЗапроса, СуффиксВРег)
	Текст = Строка(ТекстЗапроса);
	Суффикс = ВРег(Строка(СуффиксВРег));
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Если ПозицияПоиска > СтрДлина(ТекстВРег) Тогда
			Прервать;
		КонецЕсли;
		ПозОтносительно = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Суффикс);
		Если ПозОтносительно = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + ПозОтносительно - 1;
		ПозПослеСуффикса = Поз + СтрДлина(Суффикс);
		Если Суффикс = ".ОСТАТКИ" И СтрНачинаетсяС(Сред(ТекстВРег, ПозПослеСуффикса), "ИОБОРОТЫ") Тогда
			ПозицияПоиска = ПозПослеСуффикса;
			Продолжить;
		КонецЕсли;
		КонецТокена = ПозПослеСуффикса - 1;
		ИндексПробела = ПозПослеСуффикса;
		Пока ИндексПробела <= СтрДлина(Текст) Цикл
			Символ = Сред(Текст, ИндексПробела, 1);
			Если Символ <> " " И Символ <> Символы.Таб Тогда
				Прервать;
			КонецЕсли;
			ИндексПробела = ИндексПробела + 1;
		КонецЦикла;
		АргументыОборотов = ", , День";
		Если ИндексПробела <= СтрДлина(Текст) И Сред(Текст, ИндексПробела, 1) = "(" Тогда
			КонецТокена = НайтиПозициюЗакрывающейСкобки(Текст, ИндексПробела);
			Если КонецТокена = 0 Тогда
				КонецТокена = ИндексПробела;
			Иначе
				Внутри = СокрЛП(Сред(Текст, ИндексПробела + 1, КонецТокена - ИндексПробела - 1));
				Если НЕ ПустаяСтрока(Внутри) Тогда
					ЧастиАргументов = РазделитьВыраженияСпискаЗапроса(Внутри);
					НачалоПериода = "";
					КонецПериода = "";
					Если ЧастиАргументов.Количество() > 0 Тогда
						НачалоПериода = СокрЛП(Строка(ЧастиАргументов[0]));
					КонецЕсли;
					Если ЧастиАргументов.Количество() > 1 Тогда
						КонецПериода = СокрЛП(Строка(ЧастиАргументов[1]));
					КонецЕсли;
					АргументыОборотов = НачалоПериода + ", " + КонецПериода + ", День";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ЗаменаОборотов = ".Обороты(" + АргументыОборотов + ")";
		Текст = Лев(Текст, Поз - 1) + ЗаменаОборотов + Сред(Текст, КонецТокена + 1);
		ПозицияПоиска = Поз + СтрДлина(ЗаменаОборотов);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьПлохойИсточникПродажЕслиНужно(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Источник = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(Источник) Тогда
		Источник = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	КонецЕсли;
	ИсточникВРег = ВРег(Источник);
	ЭтоПлохойИсточник = СтрНайти(ИсточникВРег, "НДС") > 0
		Или СтрНайти(ИсточникВРег, "КНИГ") > 0
		Или СтрНайти(ИсточникВРег, "ВЫПУСК") > 0
		Или СтрНайти(ИсточникВРег, "ПРОИЗВОДСТВ") > 0
		Или СтрНайти(ИсточникВРег, "ПОДАННЫМ") > 0;
	Если НЕ ЭтоПлохойИсточник Тогда
		Возврат Текст;
	КонецЕсли;
	Канон = НайтиИсточникПродаж();
	Если ПустаяСтрока(Канон) Или ВРег(Канон) = ВРег(Источник) Тогда
		Возврат Текст;
	КонецЕсли;
	СтарыйТокен = ИзвлечьТокенИсточникаИзТекстаЗапроса(Текст);
	Если ПустаяСтрока(СтарыйТокен) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Поз = СтрНайти(ТекстВРег, ВРег(СтарыйТокен));
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = Лев(Текст, Поз - 1) + Канон + Сред(Текст, Поз + СтрДлина(СтарыйТокен));
	Текст = СтрЗаменить(Текст, "РегистрНакопления.РегистрНакопления.", "РегистрНакопления.");
	Текст = СтрЗаменить(Текст, "Документ.Документ.", "Документ.");
	Текст = УдалитьСоединенияСтороннихРегистровПродаж(Текст);
	Возврат Текст;
КонецФункции

Функция УдалитьСоединенияСтороннихРегистровПродаж(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркеры = СтрРазделить("ЛЕВОЕ СОЕДИНЕНИЕ,ПРАВОЕ СОЕДИНЕНИЕ,ВНУТРЕННЕЕ СОЕДИНЕНИЕ,ПОЛНОЕ СОЕДИНЕНИЕ,СОЕДИНЕНИЕ", ",");
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		ПозСоединения = 0;
		ДлинаМаркера = 0;
		Для Каждого Маркер Из Маркеры Цикл
			Поз = СтрНайти(ТекстВРег, Маркер);
			Если Поз > 0 И (ПозСоединения = 0 Или Поз < ПозСоединения) Тогда
				ПозСоединения = Поз;
				ДлинаМаркера = СтрДлина(Маркер);
			КонецЕсли;
		КонецЦикла;
		Если ПозСоединения = 0 Тогда
			Прервать;
		КонецЕсли;
		ФрагментПосле = Лев(Сред(ТекстВРег, ПозСоединения + ДлинаМаркера), 120);
		ЭтоПлохой = СтрНайти(ФрагментПосле, "НДС") > 0
			Или СтрНайти(ФрагментПосле, "КНИГ") > 0
			Или СтрНайти(ФрагментПосле, "ВЫПУСК") > 0
			Или СтрНайти(ФрагментПосле, "ПРОИЗВОДСТВ") > 0
			Или СтрНайти(ФрагментПосле, "ПОДАННЫМ") > 0;
		Если НЕ ЭтоПлохой Тогда
			Прервать;
		КонецЕсли;
		ПозКонца = СтрДлина(Текст) + 1;
		МаркерыКонца = СтрРазделить(Символы.ПС + "ГДЕ," + Символы.ПС + "СГРУППИРОВАТЬ ПО," + Символы.ПС + "УПОРЯДОЧИТЬ ПО," + Символы.ПС + "ИМЕЮЩИЕ," + Символы.ПС + "ИТОГИ," + Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ," + Символы.ПС + "ПРАВОЕ СОЕДИНЕНИЕ," + Символы.ПС + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ", ",");
		Для Каждого МаркерКонца Из МаркерыКонца Цикл
			ПозКандидат = СтрНайти(Сред(ТекстВРег, ПозСоединения + ДлинаМаркера), МаркерКонца);
			Если ПозКандидат > 0 Тогда
				Абс = ПозСоединения + ДлинаМаркера + ПозКандидат - 1;
				Если Абс < ПозКонца Тогда
					ПозКонца = Абс;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Текст = СокрП(Лев(Текст, ПозСоединения - 1)) + Сред(Текст, ПозКонца);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьКвалификаторПериодДата(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОБОРОТЫ") = 0 И СтрНайти(ТекстВРег, ".ОСТАТКИИОБОРОТЫ") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Квалификаторы = Новый Массив;
	Квалификаторы.Добавить("ПЕРИОД.КАК ДАТА");
	Квалификаторы.Добавить("ПЕРИОД.КАКДАТА");
	Квалификаторы.Добавить("ПЕРИОД.ДАТА");
	Квалификаторы.Добавить("ПЕРИОД.ДЕНЬ");
	Для Каждого Квалификатор Из Квалификаторы Цикл
		Результат = "";
		Индекс = 1;
		ДлинаКвалификатора = СтрДлина(Квалификатор);
		Пока Индекс <= СтрДлина(Текст) Цикл
			Символ = Сред(Текст, Индекс, 1);
			Если ВРег(Сред(Текст, Индекс, ДлинаКвалификатора)) = Квалификатор Тогда
				СимволДо = ?(Индекс = 1, "", Сред(Текст, Индекс - 1, 1));
				СимволПосле = Сред(Текст, Индекс + ДлинаКвалификатора, 1);
				Если НЕ ЭтоСимволИдентификатораЗапроса(СимволДо) И НЕ ЭтоСимволИдентификатораЗапроса(СимволПосле) Тогда
					Результат = Результат + "Период";
					Индекс = Индекс + ДлинаКвалификатора;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
		КонецЦикла;
		Текст = Результат;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция УдалитьСоединенияБезПолногоИмениТаблицы(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	КороткоеИмяИсточника = ИзвлечьКороткоеИмяИсточникаЗапроса(Текст);
	Если ПустаяСтрока(КороткоеИмяИсточника) Тогда
		Возврат Текст;
	КонецЕсли;
	Маркеры = СтрРазделить("ЛЕВОЕ СОЕДИНЕНИЕ,ПРАВОЕ СОЕДИНЕНИЕ,ВНУТРЕННЕЕ СОЕДИНЕНИЕ,ПОЛНОЕ СОЕДИНЕНИЕ,СОЕДИНЕНИЕ", ",");
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		ПозСоединения = 0;
		ДлинаМаркера = 0;
		Для Каждого Маркер Из Маркеры Цикл
			Поз = СтрНайти(ТекстВРег, Маркер);
			Если Поз > 0 И (ПозСоединения = 0 Или Поз < ПозСоединения) Тогда
				ПозСоединения = Поз;
				ДлинаМаркера = СтрДлина(Маркер);
			КонецЕсли;
		КонецЦикла;
		Если ПозСоединения = 0 Тогда
			Прервать;
		КонецЕсли;
		ИндексТаблицы = ПропуститьПробелыВТекстеЗапроса(Текст, ПозСоединения + ДлинаМаркера);
		ИмяТаблицы = "";
		Пока ИндексТаблицы <= СтрДлина(Текст) Цикл
			Символ = Сред(Текст, ИндексТаблицы, 1);
			Если ЭтоСимволИдентификатораЗапроса(Символ) Или Символ = "." Тогда
				ИмяТаблицы = ИмяТаблицы + Символ;
				ИндексТаблицы = ИндексТаблицы + 1;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЭтоСамосоединениеПоКороткомуИмени = СтрНайти(ИмяТаблицы, ".") = 0
			И ВРег(ИмяТаблицы) = ВРег(КороткоеИмяИсточника);
		Если НЕ ЭтоСамосоединениеПоКороткомуИмени Тогда
			Прервать;
		КонецЕсли;
		ПозКонца = СтрДлина(Текст) + 1;
		МаркерыКонца = СтрРазделить(Символы.ПС + "ГДЕ," + Символы.ПС + "СГРУППИРОВАТЬ ПО," + Символы.ПС + "УПОРЯДОЧИТЬ ПО," + Символы.ПС + "ИМЕЮЩИЕ," + Символы.ПС + "ИТОГИ," + Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ," + Символы.ПС + "ПРАВОЕ СОЕДИНЕНИЕ," + Символы.ПС + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ", ",");
		Для Каждого МаркерКонца Из МаркерыКонца Цикл
			ПозКандидат = СтрНайти(Сред(ТекстВРег, ПозСоединения + ДлинаМаркера), МаркерКонца);
			Если ПозКандидат > 0 Тогда
				Абс = ПозСоединения + ДлинаМаркера + ПозКандидат - 1;
				Если Абс < ПозКонца Тогда
					ПозКонца = Абс;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Текст = СокрП(Лев(Текст, ПозСоединения - 1)) + Сред(Текст, ПозКонца);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ИзвлечьКороткоеИмяИсточникаЗапроса(ТекстЗапроса)
	ПолноеИмя = НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(
		ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(ТекстЗапроса));
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Части[Части.Количество() - 1]));
КонецФункции

Функция УдалитьИзбыточноеСоединениеСправочникаСИзмерением(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, "СОЕДИНЕНИЕ СПРАВОЧНИК.") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Маркеры = СтрРазделить("ЛЕВОЕ СОЕДИНЕНИЕ,ПРАВОЕ СОЕДИНЕНИЕ,ВНУТРЕННЕЕ СОЕДИНЕНИЕ,СОЕДИНЕНИЕ", ",");
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		ПозСоединения = 0;
		ДлинаМаркера = 0;
		Для Каждого Маркер Из Маркеры Цикл
			Поз = СтрНайти(ТекстВРег, Маркер + " СПРАВОЧНИК.");
			Если Поз > 0 И (ПозСоединения = 0 Или Поз < ПозСоединения) Тогда
				ПозСоединения = Поз;
				ДлинаМаркера = СтрДлина(Маркер);
			КонецЕсли;
		КонецЦикла;
		Если ПозСоединения = 0 Тогда
			Прервать;
		КонецЕсли;
		ФрагментПосле = Сред(ТекстВРег, ПозСоединения, 180);
		ЭтоСсылкаНаИзмерение = СтрНайти(ФрагментПосле, ".ССЫЛКА =") > 0 Или СтрНайти(ФрагментПосле, ".ССЫЛКА=") > 0;
		Если НЕ ЭтоСсылкаНаИзмерение Тогда
			Прервать;
		КонецЕсли;
		ПозКонца = СтрДлина(Текст) + 1;
		МаркерыКонца = СтрРазделить(Символы.ПС + "ГДЕ," + Символы.ПС + "СГРУППИРОВАТЬ ПО," + Символы.ПС + "УПОРЯДОЧИТЬ ПО," + Символы.ПС + "ИМЕЮЩИЕ," + Символы.ПС + "ИТОГИ," + Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ," + Символы.ПС + "ПРАВОЕ СОЕДИНЕНИЕ," + Символы.ПС + "ВНУТРЕННЕЕ СОЕДИНЕНИЕ", ",");
		Для Каждого МаркерКонца Из МаркерыКонца Цикл
			ПозКандидат = СтрНайти(Сред(ТекстВРег, ПозСоединения + ДлинаМаркера), МаркерКонца);
			Если ПозКандидат > 0 Тогда
				Абс = ПозСоединения + ДлинаМаркера + ПозКандидат - 1;
				Если Абс < ПозКонца Тогда
					ПозКонца = Абс;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Текст = СокрП(Лев(Текст, ПозСоединения - 1)) + Сред(Текст, ПозКонца);
		ПсевдонимОстатков = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
		Если НЕ ПустаяСтрока(ПсевдонимОстатков) Тогда
			Текст = СтрЗаменить(Текст, "Номенклатура.Ссылка", ПсевдонимОстатков + ".Номенклатура");
			Текст = СтрЗаменить(Текст, "Номенклатура.Наименование", ПсевдонимОстатков + ".Номенклатура");
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьПлейсхолдерИсточникаДанных(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, "ИСТОЧНИКДАННЫХ") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Канон = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(Канон) Или СтрНайти(ВРег(Канон), "ИСТОЧНИКДАННЫХ") > 0 Тогда
		Канон = НайтиИсточникПродаж();
	КонецЕсли;
	Если ПустаяСтрока(Канон) Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ВРег(Канон), "РЕГИСТРНАКОПЛЕНИЯ.") > 0 И СтрНайти(ВРег(Канон), ".ОБОРОТЫ") = 0 Тогда
		Канон = Канон + ".Обороты";
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "ИсточникДанных", Канон);
	Текст = СтрЗаменить(Текст, "ИСТОЧНИКДАННЫХ", Канон);
	Возврат Текст;
КонецФункции

Функция УбратьПробелыПослеТочкиКвалификатора(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Результат = "";
	Индекс = 1;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Результат = Результат + Символ;
		Если Символ = "." Тогда
			Индекс = Индекс + 1;
			Пока Индекс <= СтрДлина(Текст) Цикл
				Пробел = Сред(Текст, Индекс, 1);
				Если Пробел = " " Или Пробел = Символы.Таб Или Пробел = Символы.ПС Тогда
					Индекс = Индекс + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НормализоватьСоединениеТабличнойЧастиДокумента(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Или ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат Текст;
	КонецЕсли;
	Если ВРег(Лев(СокрЛП(Строка(ПолноеИмяОбъекта)), СтрДлина("Документ."))) <> "ДОКУМЕНТ." Тогда
		Возврат Текст;
	КонецЕсли;
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	Если ПустаяСтрока(Псевдоним) Тогда
		Возврат Текст;
	КонецЕсли;
	Маркер = "СОЕДИНЕНИЕ " + Псевдоним + ".";
	МаркерВРег = ВРег(Маркер);
	ТекстВРег = ВРег(Текст);
	Поз = СтрНайти(ТекстВРег, МаркерВРег);
	Пока Поз > 0 Цикл
		Текст = Лев(Текст, Поз - 1) + "СОЕДИНЕНИЕ " + ПолноеИмяОбъекта + "." + Сред(Текст, Поз + СтрДлина(Маркер));
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(ТекстВРег, МаркерВРег);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ДобавитьУсловиеСоединенияТабличнойЧастиЕслиОтсутствует(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Или ВРег(Лев(СокрЛП(Строка(ПолноеИмяОбъекта)), СтрДлина("Документ."))) <> "ДОКУМЕНТ." Тогда
		Возврат Текст;
	КонецЕсли;
	ПсевдонимДокумента = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	Если ПустаяСтрока(ПсевдонимДокумента) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозСоединения = СтрНайти(ТекстВРег, "СОЕДИНЕНИЕ ");
	СмещениеПоиска = 1;
	Пока ПозСоединения > 0 Цикл
		ПозКакОтносительно = СтрНайти(Сред(ТекстВРег, ПозСоединения), " КАК ");
		Если ПозКакОтносительно = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозКак = ПозСоединения + ПозКакОтносительно - 1;
		НачалоПсевдонима = ПозКак + 5;
		КонецПсевдонима = НачалоПсевдонима;
		Пока КонецПсевдонима <= СтрДлина(Текст) И ЭтоСимволИдентификатораЗапроса(Сред(Текст, КонецПсевдонима, 1)) Цикл
			КонецПсевдонима = КонецПсевдонима + 1;
		КонецЦикла;
		ПсевдонимТЧ = СокрЛП(Сред(Текст, НачалоПсевдонима, КонецПсевдонима - НачалоПсевдонима));
		Хвост = СокрЛП(Сред(ТекстВРег, КонецПсевдонима));
		Если НЕ ПустаяСтрока(ПсевдонимТЧ) И НЕ СтрНачинаетсяС(Хвост, "ПО") Тогда
			Вставка = " ПО " + ПсевдонимТЧ + ".Ссылка = " + ПсевдонимДокумента + ".Ссылка";
			Текст = Лев(Текст, КонецПсевдонима - 1) + Вставка + Сред(Текст, КонецПсевдонима);
			ТекстВРег = ВРег(Текст);
		КонецЕсли;
		СмещениеПоиска = ПозСоединения + 1;
		ПозОтносительно = СтрНайти(Сред(ТекстВРег, СмещениеПоиска), "СОЕДИНЕНИЕ ");
		Если ПозОтносительно = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозСоединения = СмещениеПоиска + ПозОтносительно - 1;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ПерестроитьЗапросОстатковЕслиИсточникНевалиден(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ЭтоЗапросОстатков = СтрНайти(ТекстВРег, ".ОСТАТКИ") > 0 Или ТекстЗапрашиваетОстатки(Текст);
	Если НЕ ЭтоЗапросОстатков Тогда
		Возврат Текст;
	КонецЕсли;
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	ЕстьСоединениеПсевдонима = Ложь;
	Если НЕ ПустаяСтрока(Псевдоним) Тогда
		ЕстьСоединениеПсевдонима = СтрНайти(ТекстВРег, "СОЕДИНЕНИЕ " + ВРег(Псевдоним) + ".") > 0;
	КонецЕсли;
	ИсточникСуществует = ИсточникЗапросаСуществуетВМетаданных(ПолноеИмяОбъекта);
	ЭтоОстаткиНаРегистреСведений = СтрНайти(ТекстВРег, "РЕГИСТРСВЕДЕНИЙ.") > 0
		И СтрНайти(ТекстВРег, ".ОСТАТКИ") > 0;
	ЭтоНесовместимыеПоляБухгалтерии = ЗапросОстатковНесовместимСРегистромБухгалтерии(Текст, ПолноеИмяОбъекта);
	Если НЕ ЕстьСоединениеПсевдонима И ИсточникСуществует
		И НЕ ЭтоОстаткиНаРегистреСведений И НЕ ЭтоНесовместимыеПоляБухгалтерии Тогда
		Возврат Текст;
	КонецЕсли;
	Если ЭтоНесовместимыеПоляБухгалтерии Тогда
		ИмяБухгалтерии = НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(Строка(ПолноеИмяОбъекта));
		Если ПустаяСтрока(ИмяБухгалтерии) Или НЕ ПолноеИмяОбъектаЭтоРегистрБухгалтерии(ИмяБухгалтерии) Тогда
			ИмяБухгалтерии = НайтиПодходящийРегистрБухгалтерииДляТоварныхОстатков();
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяБухгалтерии) Тогда
			ЗапросБухгалтерии = ПостроитьЗапросТоварныхОстатковРегистраБухгалтерии(ИмяБухгалтерии, Текст);
			Если НЕ ПустаяСтрока(ЗапросБухгалтерии) Тогда
				Возврат ЗапросБухгалтерии;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЭтоОстаткиНаРегистреСведений Тогда
		КанонНакопления = НайтиПодходящийРегистрНакопленияДляОстатков();
		Если НЕ ПустаяСтрока(КанонНакопления) Тогда
			ЗапросНакопления = ПостроитьЗапросОстатковРегистраНакопления(КанонНакопления, Неопределено, Неопределено, Текст);
			Если НЕ ПустаяСтрока(ЗапросНакопления) Тогда
				Возврат ЗапросНакопления;
			КонецЕсли;
		КонецЕсли;
		КанонБух = НайтиПодходящийРегистрБухгалтерииДляТоварныхОстатков();
		Если НЕ ПустаяСтрока(КанонБух) Тогда
			ЗапросБухгалтерии = ПостроитьЗапросТоварныхОстатковРегистраБухгалтерии(КанонБух, Текст);
			Если НЕ ПустаяСтрока(ЗапросБухгалтерии) Тогда
				Возврат ЗапросБухгалтерии;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Канон = НайтиИсточникТоварныхОстатков();
	Если ПустаяСтрока(Канон) Тогда
		Возврат Текст;
	КонецЕсли;
	ЗапросБухгалтерии = ПостроитьЗапросТоварныхОстатковРегистраБухгалтерии(Канон, Текст);
	Если НЕ ПустаяСтрока(ЗапросБухгалтерии) Тогда
		Возврат ЗапросБухгалтерии;
	КонецЕсли;
	ЗапросНакопления = ПостроитьЗапросОстатковРегистраНакопления(Канон, Неопределено, Неопределено, Текст);
	Если НЕ ПустаяСтрока(ЗапросНакопления) Тогда
		Возврат ЗапросНакопления;
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ИсточникЗапросаСуществуетВМетаданных(ПолноеИмяОбъекта)
	ИмяПолное = НормализоватьИмяИсточникаЗапросаБезВиртуальнойТаблицы(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(ИмяПолное) Или СтрНайти(ИмяПолное, ".") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Разбор = РазобратьПолноеИмяОбъекта(ИмяПолное);
	ТипОбъекта = ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(Разбор.ObjectType);
	ИмяОбъекта = Разбор.ObjectName;
	Если ПустаяСтрока(ТипОбъекта) Или ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипОбъекта = "Документ" Тогда
		Возврат ИИА_Метаданные.СуществуетДокумент(ИмяОбъекта);
	КонецЕсли;
	Если ТипОбъекта = "Справочник" Тогда
		Возврат ИИА_Метаданные.СуществуетСправочник(ИмяОбъекта);
	КонецЕсли;
	Если ТипОбъекта = "РегистрНакопления" Тогда
		Возврат ИИА_Метаданные.СуществуетРегистрНакопления(ИмяОбъекта);
	КонецЕсли;
	Если ТипОбъекта = "РегистрСведений" Тогда
		Возврат ИИА_Метаданные.СуществуетРегистрСведений(ИмяОбъекта);
	КонецЕсли;
	Если ТипОбъекта = "РегистрБухгалтерии" Тогда
		Возврат Метаданные.РегистрыБухгалтерии.Найти(ИмяОбъекта) <> Неопределено;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция УдалитьКакВнутриВыраженийЗапроса(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Результат = "";
	Глубина = 0;
	Индекс = 1;
	ДлинаТекста = СтрДлина(Текст);
	Пока Индекс <= ДлинаТекста Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если Символ = ")" Тогда
			Если Глубина > 0 Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если Глубина > 0 Тогда
			Фрагмент = ВРег(Сред(Текст, Индекс, 5));
			Если Фрагмент = " КАК " Или Фрагмент = " КАК" + Символы.ПС Или Фрагмент = " КАК" + Символы.Таб Тогда
				Если ЭтоПсевдонимИсточникаПослеИз(Текст, Индекс) Тогда
					Результат = Результат + Сред(Текст, Индекс, 5);
					Индекс = Индекс + 5;
					Продолжить;
				КонецЕсли;
				ХвостПослеКак = ВРег(СокрЛ(Сред(Текст, Индекс + 5)));
				ЭтоПриведениеТипа = СтрНачинаетсяС(ХвостПослеКак, "СПРАВОЧНИК.")
					Или СтрНачинаетсяС(ХвостПослеКак, "ДОКУМЕНТ.")
					Или СтрНачинаетсяС(ХвостПослеКак, "ПЕРЕЧИСЛЕНИЕ.")
					Или СтрНачинаетсяС(ХвостПослеКак, "РЕГИСТР");
				Если НЕ ЭтоПриведениеТипа Тогда
					Индекс = Индекс + 5;
					Пока Индекс <= ДлинаТекста Цикл
						СимволПропуска = Сред(Текст, Индекс, 1);
						Если (СимволПропуска >= "0" И СимволПропуска <= "9")
							Или (СимволПропуска >= "A" И СимволПропуска <= "Z")
							Или (СимволПропуска >= "a" И СимволПропуска <= "z")
							Или (СимволПропуска >= "А" И СимволПропуска <= "Я")
							Или (СимволПропуска >= "а" И СимволПропуска <= "я")
							Или СимволПропуска = "_" Или СимволПропуска = "Ё" Или СимволПропуска = "ё" Тогда
							Индекс = Индекс + 1;
							Продолжить;
						КонецЕсли;
						Прервать;
					КонецЦикла;
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоПсевдонимИсточникаПослеИз(Текст, ИндексКак)
	Индекс = ИндексКак - 1;
	Пока Индекс >= 1 Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.Таб Тогда
			Индекс = Индекс - 1;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Пока Индекс >= 1 Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ЭтоСимволИдентификатораЗапроса(Символ) Или Символ = "." Тогда
			Индекс = Индекс - 1;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Пока Индекс >= 1 Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.Таб Тогда
			Индекс = Индекс - 1;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Если Индекс < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	НачалоФрагмента = Макс(1, Индекс - 10);
	Фрагмент = СокрП(ВРег(Сред(Текст, НачалоФрагмента, Индекс - НачалоФрагмента + 1)));
	Возврат СтрЗаканчиваетсяНа(Фрагмент, "ИЗ")
		Или СтрЗаканчиваетсяНа(Фрагмент, "СОЕДИНЕНИЕ");
КонецФункции

Функция ЗаменитьПлейсхолдерТабличнойЧастиВЗапросе(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Пока Истина Цикл
		ПозНачала = СтрНайти(Текст, "{{");
		Если ПозНачала = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозКонца = СтрНайти(Сред(Текст, ПозНачала + 2), "}}");
		Если ПозКонца = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозКонца = ПозНачала + 1 + ПозКонца + 1;
		Фрагмент = Сред(Текст, ПозНачала, ПозКонца - ПозНачала + 1);
		ФрагментВРег = ВРег(Фрагмент);
		ИмяТЧ = "";
		ПозТЧ = СтрНайти(ФрагментВРег, "ТАБЛИЧНОЙ ЧАСТИ """);
		Если ПозТЧ > 0 Тогда
			НачалоИмени = ПозТЧ + СтрДлина("ТАБЛИЧНОЙ ЧАСТИ """);
			ПозКавычки = СтрНайти(Сред(Фрагмент, НачалоИмени), """");
			Если ПозКавычки > 0 Тогда
				ИмяТЧ = СокрЛП(Сред(Фрагмент, НачалоИмени, ПозКавычки - 1));
			КонецЕсли;
		КонецЕсли;
		ИмяДокумента = "";
		ПозДок = СтрНайти(ФрагментВРег, "ДОКУМЕНТА ");
		Если ПозДок > 0 Тогда
			НачалоДок = ПозДок + СтрДлина("ДОКУМЕНТА ");
			КонецДок = НачалоДок;
			Пока КонецДок <= СтрДлина(Фрагмент) И ЭтоСимволИдентификатораЗапроса(Сред(Фрагмент, КонецДок, 1)) Цикл
				КонецДок = КонецДок + 1;
			КонецЦикла;
			ИмяДокумента = СокрЛП(Сред(Фрагмент, НачалоДок, КонецДок - НачалоДок));
		КонецЕсли;
		Если ПустаяСтрока(ИмяДокумента) И ВРег(Лев(СокрЛП(Строка(ПолноеИмяОбъекта)), 9)) = "ДОКУМЕНТ." Тогда
			ИмяДокумента = Сред(СокрЛП(Строка(ПолноеИмяОбъекта)), 10);
		КонецЕсли;
		Если ПустаяСтрока(ИмяТЧ) Или ПустаяСтрока(ИмяДокумента) Тогда
			Текст = Лев(Текст, ПозНачала - 1) + Сред(Текст, ПозКонца + 1);
			Продолжить;
		КонецЕсли;
		Замена = "Документ." + ИмяДокумента + "." + ИмяТЧ + " КАК " + ИмяТЧ;
		Текст = Лев(Текст, ПозНачала - 1) + Замена + Сред(Текст, ПозКонца + 1);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ДобавитьСкобкиВиртуальнойТаблицыЕслиОтсутствуют(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Суффиксы = Новый Массив;
	Суффиксы.Добавить(".ОстаткиИОбороты");
	Суффиксы.Добавить(".Обороты");
	Суффиксы.Добавить(".Остатки");
	Для Каждого Суффикс Из Суффиксы Цикл
		ПозицияПоиска = 1;
		Пока Истина Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), ВРег(Суффикс));
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = ПозицияПоиска + Поз - 1;
			После = Поз + СтрДлина(Суффикс);
			Если Суффикс = ".Обороты" И СтрНачинаетсяС(Сред(ТекстВРег, После), "ИОБОРОТЫ") Тогда
				ПозицияПоиска = После;
				Продолжить;
			КонецЕсли;
			Если Суффикс = ".Остатки" И СтрНачинаетсяС(Сред(ТекстВРег, После), "ИОБОРОТЫ") Тогда
				ПозицияПоиска = После;
				Продолжить;
			КонецЕсли;
			Индекс = После;
			Пока Индекс <= СтрДлина(Текст) И ЭтоСимволИдентификатораЗапроса(Сред(Текст, Индекс, 1)) Цикл
				Индекс = Индекс + 1;
			КонецЦикла;
			Пока Индекс <= СтрДлина(Текст) Цикл
				Символ = Сред(Текст, Индекс, 1);
				Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.Таб Тогда
					Индекс = Индекс + 1;
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЦикла;
			Если Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) = "(" Тогда
				ПозицияПоиска = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Если Суффикс = ".Обороты" Или Суффикс = ".ОстаткиИОбороты" Тогда
				Вставка = "(, , День)";
			Иначе
				Вставка = "()";
			КонецЕсли;
			Текст = Лев(Текст, После - 1) + Вставка + Сред(Текст, После);
			ПозицияПоиска = После + СтрДлина(Вставка);
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НормализоватьПараметрыВиртуальнойТаблицыОстатков(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), ".ОСТАТКИ(");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		Если СтрНачинаетсяС(Сред(ТекстВРег, Поз), ".ОСТАТКИИОБОРОТЫ(") Тогда
			ПозицияПоиска = Поз + СтрДлина(".ОСТАТКИИОБОРОТЫ(");
			Продолжить;
		КонецЕсли;
		ПозСкобки = Поз + СтрДлина(".ОСТАТКИ(") - 1;
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозСкобки);
		Если КонецСкобки = 0 Тогда
			Прервать;
		КонецЕсли;
		Внутри = СокрЛП(Сред(Текст, ПозСкобки + 1, КонецСкобки - ПозСкобки - 1));
		Если ПустаяСтрока(Внутри) Тогда
			ПозицияПоиска = КонецСкобки + 1;
			Продолжить;
		КонецЕсли;
		ЧастиАргументов = РазделитьВыраженияСпискаЗапроса(Внутри);
		Непустые = Новый Массив;
		Для Каждого Часть Из ЧастиАргументов Цикл
			ЗначениеЧасти = СокрЛП(Строка(Часть));
			Если ПустаяСтрока(ЗначениеЧасти) Или ВРег(ЗначениеЧасти) = "АВТО" Тогда
				Продолжить;
			КонецЕсли;
			Если Лев(ЗначениеЧасти, 1) = "&" Тогда
				Продолжить;
			КонецЕсли;
			ЗначениеБезПробелов = СтрЗаменить(СтрЗаменить(ВРег(ЗначениеЧасти), " ", ""), Символ(160), "");
			Если СтрНачинаетсяС(ЗначениеБезПробелов, "ДАТАВРЕМЯ(1,1,1") Тогда
				Продолжить;
			КонецЕсли;
			Непустые.Добавить(ЗначениеЧасти);
		КонецЦикла;
		Если Непустые.Количество() > 2 Тогда
			ПозицияПоиска = КонецСкобки + 1;
			Продолжить;
		КонецЕсли;
		НовыеАргументы = СтрСоединить(Непустые, ", ");
		Текст = Лев(Текст, ПозСкобки) + НовыеАргументы + Сред(Текст, КонецСкобки);
		ПозицияПоиска = ПозСкобки + СтрДлина(НовыеАргументы) + 1;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НормализоватьПериодичностьВиртуальнойТаблицыОборотов(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Периодичности = Новый Массив;
	Периодичности.Добавить("Авто");
	Периодичности.Добавить("День");
	Периодичности.Добавить("Неделя");
	Периодичности.Добавить("Месяц");
	Периодичности.Добавить("Квартал");
	Периодичности.Добавить("Год");
	Периодичности.Добавить("Час");
	Периодичности.Добавить("Минута");
	Периодичности.Добавить("Секунда");
	Для Каждого Периодичность Из Периодичности Цикл
		Маркер = ".ОБОРОТЫ" + ВРег(Периодичность) + "(";
		Пока Истина Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(ТекстВРег, Маркер);
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			ПозСкобки = Поз + СтрДлина(Маркер) - 1;
			КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозСкобки);
			Если КонецСкобки = 0 Тогда
				Прервать;
			КонецЕсли;
			Внутри = СокрЛП(Сред(Текст, ПозСкобки + 1, КонецСкобки - ПозСкобки - 1));
			Если ПустаяСтрока(Внутри) Тогда
				НовыеАргументы = ", , " + Периодичность;
			ИначеЕсли Прав(СокрП(Внутри), 1) = "," Тогда
				НовыеАргументы = СокрП(Внутри) + " " + Периодичность;
			Иначе
				НовыеАргументы = Внутри + ", " + Периодичность;
			КонецЕсли;
			Текст = Лев(Текст, Поз - 1) + ".Обороты(" + НовыеАргументы + ")" + Сред(Текст, КонецСкобки + 1);
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НормализоватьПсевдоФункцииПериодаВЗапросе(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(ТекстВРег, "ДАТАВРЕМЯ(НАЧАЛОПЕРИОДА");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозОткр = Поз + СтрДлина("ДАТАВРЕМЯ");
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозОткр);
		Если КонецСкобки = 0 Тогда
			Прервать;
		КонецЕсли;
		Текст = Лев(Текст, Поз - 1) + "НАЧАЛОПЕРИОДА(Период, ДЕНЬ)" + Сред(Текст, КонецСкобки + 1);
	КонецЦикла;
	МаркерыПсевдо = Новый Массив;
	МаркерыПсевдо.Добавить("ПЕРИОДКАКНАЧАЛОПЕРИОДА(");
	МаркерыПсевдо.Добавить("ПЕРИОДКАКДАТАВРЕМЯ(");
	МаркерыПсевдо.Добавить("ПЕРИОДКАКДАТА(");
	Для Каждого Маркер Из МаркерыПсевдо Цикл
		Пока Истина Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(ТекстВРег, Маркер);
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			Текст = Лев(Текст, Поз - 1) + "НАЧАЛОПЕРИОДА(" + Сред(Текст, Поз + СтрДлина(Маркер));
		КонецЦикла;
	КонецЦикла;
	СуффиксыПромежуточных = Новый Массив;
	СуффиксыПромежуточных.Добавить(".ИТОГИ.");
	СуффиксыПромежуточных.Добавить(".СРЕЗПОСЛЕДНИХ.");
	СуффиксыПромежуточных.Добавить(".СРЕЗПЕРВЫХ.");
	Для Каждого Суффикс Из СуффиксыПромежуточных Цикл
		Пока СтрНайти(ВРег(Текст), Суффикс) > 0 Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(ТекстВРег, Суффикс);
			Текст = Лев(Текст, Поз) + Сред(Текст, Поз + СтрДлина(Суффикс));
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ПринудительноКанонизироватьРесурсыОборотов(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОБОРОТЫ") = 0 И СтрНайти(ТекстВРег, ".ОСТАТКИИОБОРОТЫ") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Сумма", "СуммаОборот");
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Количество", "КоличествоОборот");
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Оборот", "СуммаОборот");
	Текст = СтрЗаменить(Текст, ".Сумма)", ".СуммаОборот)");
	Текст = СтрЗаменить(Текст, ".Сумма,", ".СуммаОборот,");
	Текст = СтрЗаменить(Текст, ".Сумма ", ".СуммаОборот ");
	Текст = СтрЗаменить(Текст, ".СУММА)", ".СуммаОборот)");
	Текст = СтрЗаменить(Текст, ".СУММА,", ".СуммаОборот,");
	Текст = СтрЗаменить(Текст, ".СУММА ", ".СуммаОборот ");
	Текст = СтрЗаменить(Текст, ".Количество)", ".КоличествоОборот)");
	Текст = СтрЗаменить(Текст, ".Количество,", ".КоличествоОборот,");
	Текст = СтрЗаменить(Текст, ".Количество ", ".КоличествоОборот ");
	Возврат Текст;
КонецФункции

Функция ПринудительноКанонизироватьРесурсыОстатков(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОСТАТКИ") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Остаток", "КоличествоОстаток");
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "ТекущийОстаток", "КоличествоОстаток");
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "ОстатокКоличество", "КоличествоОстаток");
	Возврат Текст;
КонецФункции

Функция ЗапросОстатковНесовместимСРегистромБухгалтерии(ТекстЗапроса, ПолноеИмяОбъекта)
	Если НЕ ПолноеИмяОбъектаЭтоРегистрБухгалтерии(ПолноеИмяОбъекта)
		И СтрНайти(ВРег(Строка(ТекстЗапроса)), "РЕГИСТРБУХГАЛТЕРИИ.") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстВРег = ВРег(Строка(ТекстЗапроса));
	ЕстьНакопительныйОстаток = ЗапросСодержитИдентификатор(ТекстЗапроса, "КоличествоОстаток")
		И НЕ ЗапросСодержитИдентификатор(ТекстЗапроса, "КоличествоОстатокДт");
	ЕстьНоменклатураВместоСубконто = ЗапросСодержитИдентификатор(ТекстЗапроса, "Номенклатура")
		И НЕ ЗапросСодержитИдентификатор(ТекстЗапроса, "Субконто1");
	ЕстьПолеОстатокБезСубконто = ЗапросСодержитИдентификатор(ТекстЗапроса, "Остаток")
		И НЕ ЗапросСодержитИдентификатор(ТекстЗапроса, "Субконто1");
	Возврат ЕстьНакопительныйОстаток Или ЕстьНоменклатураВместоСубконто Или ЕстьПолеОстатокБезСубконто;
КонецФункции

Функция ЗапросСодержитИдентификатор(ТекстЗапроса, ИмяПоля)
	Текст = Строка(ТекстЗапроса);
	Имя = СокрЛП(Строка(ИмяПоля));
	Если ПустаяСтрока(Текст) Или ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Индекс = 1;
	ДлинаИмени = СтрДлина(Имя);
	Пока Индекс <= СтрДлина(Текст) Цикл
		Если ВРег(Сред(Текст, Индекс, ДлинаИмени)) = ВРег(Имя) Тогда
			СимволДо = ?(Индекс = 1, "", Сред(Текст, Индекс - 1, 1));
			СимволПосле = Сред(Текст, Индекс + ДлинаИмени, 1);
			Если НЕ ЭтоСимволИдентификатораЗапроса(СимволДо) И НЕ ЭтоСимволИдентификатораЗапроса(СимволПосле) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ВыражениеВыборкиСодержитПолеВнеWhitelist(Выражение, Whitelist)
	Текст = Строка(Выражение);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Индекс = 1;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если НЕ ЭтоСимволИдентификатораЗапроса(Символ) Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Токен = "";
		Пока Индекс <= СтрДлина(Текст) И ЭтоСимволИдентификатораЗапроса(Сред(Текст, Индекс, 1)) Цикл
			Токен = Токен + Сред(Текст, Индекс, 1);
			Индекс = Индекс + 1;
		КонецЦикла;
		СимволПосле = ?(Индекс > СтрДлина(Текст), "", Сред(Текст, Индекс, 1));
		Если СимволПосле = "(" Или СимволПосле = "." Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(Токен) = "КАК" Тогда
			Пока Индекс <= СтрДлина(Текст) И НЕ ЭтоСимволИдентификатораЗапроса(Сред(Текст, Индекс, 1)) Цикл
				Индекс = Индекс + 1;
			КонецЦикла;
			Пока Индекс <= СтрДлина(Текст) И ЭтоСимволИдентификатораЗапроса(Сред(Текст, Индекс, 1)) Цикл
				Индекс = Индекс + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если ЭтоКлючевоеСловоЗапроса(Токен) И ВРег(Токен) <> "КОЛИЧЕСТВО" И ВРег(Токен) <> "СУММА" Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, Токен) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПодобратьСемантическуюЗаменуПоля(Токен, Whitelist)) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОграничитьГодыДатаВремяВЗапросе(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркер = "ДАТАВРЕМЯ(";
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Маркер);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		ПозОткр = Поз + СтрДлина(Маркер) - 1;
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозОткр);
		Если КонецСкобки = 0 Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		Внутри = Сред(Текст, ПозОткр + 1, КонецСкобки - ПозОткр - 1);
		ПозЗапятой = СтрНайти(Внутри, ",");
		Если ПозЗапятой = 0 Тогда
			ПозицияПоиска = КонецСкобки + 1;
			Продолжить;
		КонецЕсли;
		ЧастиАргументов = СтрРазделить(Внутри, ",", Ложь);
		Если ЧастиАргументов.Количество() >= 3 Тогда
			ПервыйТекст = СтрЗаменить(СтрЗаменить(СокрЛП(ЧастиАргументов[0]), " ", ""), Символы.НПП, "");
			ТретийТекст = СтрЗаменить(СтрЗаменить(СокрЛП(ЧастиАргументов[2]), " ", ""), Символы.НПП, "");
			Попытка
				ПервоеЧисло = Число(ПервыйТекст);
				ТретьеЧисло = Число(ТретийТекст);
			Исключение
				ПервоеЧисло = 0;
				ТретьеЧисло = 0;
			КонецПопытки;
			Если ПервоеЧисло > 0 И ПервоеЧисло <= 31 И ТретьеЧисло >= 1000 Тогда
				ЧастиАргументов[0] = ТретийТекст;
				ЧастиАргументов[2] = ПервыйТекст;
				Внутри = СтрСоединить(ЧастиАргументов, ",");
				Текст = Лев(Текст, ПозОткр) + Внутри + Сред(Текст, КонецСкобки);
				ПозицияПоиска = ПозОткр + СтрДлина(Внутри) + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ГодТекст = СокрЛП(Лев(Внутри, ПозЗапятой - 1));
		ГодТекст = СтрЗаменить(ГодТекст, " ", "");
		ГодТекст = СтрЗаменить(ГодТекст, Символы.НПП, "");
		Попытка
			ГодЧисло = Число(ГодТекст);
		Исключение
			ПозицияПоиска = КонецСкобки + 1;
			Продолжить;
		КонецПопытки;
		Если ГодЧисло > 3999 Тогда
			Текст = Лев(Текст, ПозОткр) + "3999" + Сред(Текст, ПозОткр + ПозЗапятой);
			ПозицияПоиска = ПозОткр + 5;
		ИначеЕсли ГодЧисло < 1 Тогда
			Текст = Лев(Текст, ПозОткр) + "1" + Сред(Текст, ПозОткр + ПозЗапятой);
			ПозицияПоиска = ПозОткр + 2;
		Иначе
			ПозицияПоиска = КонецСкобки + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьSqlСортировкуDescAsc(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "DESC", "УБЫВ");
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "ASC", "ВОЗР");
	Возврат Текст;
КонецФункции

Функция СплющитьВложенныйНачалоПериода(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркер = "НАЧАЛОПЕРИОДА(НАЧАЛОПЕРИОДА(";
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(ТекстВРег, Маркер);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозВнешОткр = Поз + СтрДлина("НАЧАЛОПЕРИОДА");
		ПозВнутрОткр = Поз + СтрДлина("НАЧАЛОПЕРИОДА(") + СтрДлина("НАЧАЛОПЕРИОДА");
		КонецВнутр = НайтиПозициюЗакрывающейСкобки(Текст, ПозВнутрОткр);
		КонецВнеш = НайтиПозициюЗакрывающейСкобки(Текст, ПозВнешОткр);
		Если КонецВнутр = 0 Или КонецВнеш = 0 Или КонецВнеш <= КонецВнутр Тогда
			Прервать;
		КонецЕсли;
		ВнутрВыражение = Сред(Текст, Поз + СтрДлина("НАЧАЛОПЕРИОДА("), КонецВнутр - (Поз + СтрДлина("НАЧАЛОПЕРИОДА(")) + 1);
		ХвостАргументов = СокрЛП(Сред(Текст, КонецВнутр + 1, КонецВнеш - КонецВнутр - 1));
		Если СтрНачинаетсяС(ХвостАргументов, ",") Тогда
			ХвостАргументов = СокрЛП(Сред(ХвостАргументов, 2));
		КонецЕсли;
		ХвостВРег = ВРег(ХвостАргументов);
		ЭтоЕдиницаПериода = ХвостВРег = "ДЕНЬ" Или ХвостВРег = "МЕСЯЦ" Или ХвостВРег = "ГОД"
			Или ХвостВРег = "КВАРТАЛ" Или ХвостВРег = "НЕДЕЛЯ" Или ХвостВРег = "ЧАС"
			Или ХвостВРег = "МИНУТА" Или ХвостВРег = "СЕКУНДА";
		Если ЭтоЕдиницаПериода Или ПустаяСтрока(ХвостАргументов) Тогда
			Текст = Лев(Текст, Поз - 1) + ВнутрВыражение + Сред(Текст, КонецВнеш + 1);
		Иначе
			Текст = Лев(Текст, Поз - 1) + ВнутрВыражение + ", " + ХвостАргументов + Сред(Текст, КонецВнеш + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НормализоватьПсевдонимИсточникаСТочкой(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	Если ПустаяСтрока(Псевдоним) Или СтрНайти(Псевдоним, ".") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Части = СтрРазделить(Псевдоним, ".");
	НовыйПсевдоним = СокрЛП(Строка(Части[0]));
	Если ПустаяСтрока(НовыйПсевдоним) Или НовыйПсевдоним = Псевдоним Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, Псевдоним, НовыйПсевдоним);
	Текст = СтрЗаменить(Текст, " КАК " + Псевдоним, " КАК " + НовыйПсевдоним);
	Текст = СтрЗаменить(Текст, " как " + Псевдоним, " КАК " + НовыйПсевдоним);
	Возврат Текст;
КонецФункции

Функция НормализоватьГруппировкуПоДням(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ЗаменитьДеньПоляДатыНаНачалоПериода(Текст, "День(");
	Текст = ЗаменитьДеньПоляДатыНаНачалоПериода(Текст, "ДЕНЬ(");
	Текст = ЗаменитьДеньПоляДатыНаНачалоПериода(Текст, "ДАТА(");
	Текст = СтрЗаменить(Текст, ", ДЕНЬ) КАК Дата", ", ДЕНЬ) КАК День");
	Текст = РазвернутьДатаВремяВокругНачалаПериодаДня(Текст);
	Текст = ЗаменитьГруппировкуПоАлиасуДняНаВыражение(Текст);
	Возврат Текст;
КонецФункции

Функция РазвернутьДатаВремяВокругНачалаПериодаДня(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркер = "ДАТАВРЕМЯ(НАЧАЛОПЕРИОДА(";
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Маркер);
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		ПозВнутр = Поз + СтрДлина("ДАТАВРЕМЯ");
		КонецВнутр = НайтиПозициюЗакрывающейСкобки(Текст, ПозВнутр);
		Если КонецВнутр = 0 Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		Внутри = СокрЛП(Сред(Текст, ПозВнутр + 1, КонецВнутр - ПозВнутр - 1));
		Если СтрНачинаетсяС(ВРег(Внутри), "НАЧАЛОПЕРИОДА(") И СтрНайти(ВРег(Внутри), ", ДЕНЬ)") > 0 Тогда
			ПозЗапятой = СтрНайти(ВРег(Внутри), ", ДЕНЬ)");
			ВыражениеНачала = СокрЛП(Лев(Внутри, ПозЗапятой + СтрДлина(", ДЕНЬ)") - 1));
			Текст = Лев(Текст, Поз - 1) + ВыражениеНачала + Сред(Текст, КонецВнутр + 1);
			ПозицияПоиска = Поз + СтрДлина(ВыражениеНачала);
			Продолжить;
		КонецЕсли;
		ПозицияПоиска = КонецВнутр + 1;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ЗаменитьГруппировкуПоАлиасуДняНаВыражение(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	ПозГруппы = СтрНайти(ТекстВРег, Символы.ПС + "СГРУППИРОВАТЬ ПО");
	Если ПозГруппы = 0 Тогда
		ПозГруппы = СтрНайти(ТекстВРег, " СГРУППИРОВАТЬ ПО ");
	КонецЕсли;
	Если ПозИз = 0 Или ПозГруппы = 0 Или ПозГруппы < ПозИз Тогда
		Возврат Текст;
	КонецЕсли;
	СекцияВыбрать = Сред(Текст, 1, ПозИз - 1);
	ВыражениеДня = "";
	ПозКакДень = СтрНайти(ВРег(СекцияВыбрать), " КАК ДЕНЬ");
	Если ПозКакДень = 0 Тогда
		ПозКакДень = СтрНайти(ВРег(СекцияВыбрать), " КАК ДАТА");
	КонецЕсли;
	Если ПозКакДень = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	НачалоВыражения = ПозКакДень;
	Пока НачалоВыражения > 1 Цикл
		Символ = Сред(СекцияВыбрать, НачалоВыражения - 1, 1);
		Если Символ = "," Или Символ = Символы.ПС Тогда
			Прервать;
		КонецЕсли;
		НачалоВыражения = НачалоВыражения - 1;
	КонецЦикла;
	ВыражениеДня = СокрЛП(Сред(СекцияВыбрать, НачалоВыражения, ПозКакДень - НачалоВыражения));
	Если ПустаяСтрока(ВыражениеДня) Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ВРег(ВыражениеДня), "НАЧАЛОПЕРИОДА(") = 0 И СтрНайти(ВРег(ВыражениеДня), "ДЕНЬ(") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Хвост = Сред(Текст, ПозГруппы);
	Хвост = ЗаменитьИдентификаторВТекстеЗапроса(Хвост, "День", ВыражениеДня);
	Возврат Лев(Текст, ПозГруппы - 1) + Хвост;
КонецФункции

Функция ЗаменитьДеньПоляДатыНаНачалоПериода(ТекстЗапроса, ПрефиксФункции)
	Текст = Строка(ТекстЗапроса);
	Префикс = Строка(ПрефиксФункции);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), ВРег(Префикс));
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + Поз - 1;
		Если ВРег(Префикс) = "ДАТА(" И ВРег(Сред(Текст, Поз, СтрДлина("ДАТАВРЕМЯ("))) = "ДАТАВРЕМЯ(" Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		Если ВРег(Префикс) = "ДАТА(" И Поз > 1 И ЭтоСимволИдентификатораЗапроса(Сред(Текст, Поз - 1, 1)) Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		ПозСкобки = Поз + СтрДлина(Префикс) - 1;
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозСкобки);
		Если КонецСкобки = 0 Тогда
			ПозицияПоиска = Поз + 1;
			Продолжить;
		КонецЕсли;
		Аргумент = СокрЛП(Сред(Текст, ПозСкобки + 1, КонецСкобки - ПозСкобки - 1));
		АргументВРег = ВРег(Аргумент);
		Если СтрНайти(АргументВРег, "ПЕРИОД") = 0 И СтрНайти(АргументВРег, "ДАТА") = 0 Тогда
			ПозицияПоиска = КонецСкобки + 1;
			Продолжить;
		КонецЕсли;
		Замена = "НАЧАЛОПЕРИОДА(" + Аргумент + ", ДЕНЬ)";
		Текст = Лев(Текст, Поз - 1) + Замена + Сред(Текст, КонецСкобки + 1);
		ПозицияПоиска = Поз + СтрДлина(Замена);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ДобавитьВиртуальнуюТаблицуОборотовЕслиНужно(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОБОРОТЫ") > 0 Или СтрНайти(ТекстВРег, ".ОСТАТКИ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Источник = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(Источник) Тогда
		Источник = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	КонецЕсли;
	Если ВРег(Лев(Источник, СтрДлина("РегистрНакопления."))) <> "РЕГИСТРНАКОПЛЕНИЯ." Тогда
		Возврат Текст;
	КонецЕсли;
	ЕстьМаркерОборота = СтрНайти(Текст, "Оборот") > 0 Или СтрНайти(Текст, "оборот") > 0;
	Если НЕ ЕстьМаркерОборота Тогда
		Возврат Текст;
	КонецЕсли;
	СтарыйТокен = ИзвлечьТокенИсточникаИзТекстаЗапроса(Текст);
	Если ПустаяСтрока(СтарыйТокен) Или СтрНайти(ВРег(СтарыйТокен), ".ОБОРОТЫ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Поз = СтрНайти(ВРег(Текст), ВРег(СтарыйТокен));
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Поз - 1) + СтарыйТокен + ".Обороты(, , День)" + Сред(Текст, Поз + СтрДлина(СтарыйТокен));
КонецФункции

Функция НормализоватьУпорядочиваниеПоАлиасамВыборки(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозУпор = СтрНайти(ТекстВРег, Символы.ПС + "УПОРЯДОЧИТЬ ПО");
	Если ПозУпор = 0 Тогда
		ПозУпор = СтрНайти(ТекстВРег, " УПОРЯДОЧИТЬ ПО ");
		Если ПозУпор = 0 Тогда
			Возврат Текст;
		КонецЕсли;
		ДлинаМаркера = 16;
	Иначе
		ДлинаМаркера = 14;
	КонецЕсли;
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозИз = 0 Или ПозИз >= ПозУпор Тогда
		Возврат Текст;
	КонецЕсли;
	СекцияВыбрать = Сред(Текст, 1, ПозИз - 1);
	Алиасы = Новый Массив;
	ОстатокВыбора = СекцияВыбрать;
	Пока Истина Цикл
		ПозКак = СтрНайти(ВРег(ОстатокВыбора), " КАК ");
		Если ПозКак = 0 Тогда
			Прервать;
		КонецЕсли;
		Хвост = СокрЛП(Сред(ОстатокВыбора, ПозКак + 5));
		ИмяАлиаса = "";
		Для Индекс = 1 По СтрДлина(Хвост) Цикл
			Символ = Сред(Хвост, Индекс, 1);
			Если Символ = "," Или Символ = " " Или Символ = Символы.ПС Или Символ = Символы.Таб Тогда
				Прервать;
			КонецЕсли;
			ИмяАлиаса = ИмяАлиаса + Символ;
		КонецЦикла;
		Если НЕ ПустаяСтрока(ИмяАлиаса) Тогда
			Алиасы.Добавить(ИмяАлиаса);
		КонецЕсли;
		ОстатокВыбора = Сред(ОстатокВыбора, ПозКак + 5);
	КонецЦикла;
	Если Алиасы.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	МаркерУпор = ?(СтрНайти(ТекстВРег, Символы.ПС + "УПОРЯДОЧИТЬ ПО") > 0, Символы.ПС + "УПОРЯДОЧИТЬ ПО", " УПОРЯДОЧИТЬ ПО ");
	ДлинаМаркера = СтрДлина(МаркерУпор);
	СекцияУпор = Сред(Текст, ПозУпор + ДлинаМаркера);
	ПозКонецУпор = СтрДлина(СекцияУпор) + 1;
	Для Каждого МаркерКонца Из СтрРазделить("ИТОГИ,АВТОУПОРЯДОЧИВАНИЕ", ",", Ложь) Цикл
		ПозКандидат = СтрНайти(ВРег(СекцияУпор), Символы.ПС + МаркерКонца);
		Если ПозКандидат > 0 И ПозКандидат < ПозКонецУпор Тогда
			ПозКонецУпор = ПозКандидат;
		КонецЕсли;
	КонецЦикла;
	ПоляУпор = Лев(СекцияУпор, ПозКонецУпор - 1);
	ПоляУпорВРег = ВРег(ПоляУпор);
	Если (СтрНайти(ПоляУпорВРег, "ПРЕДСТАВЛЕНИЕ(") > 0 Или СтрНайти(ПоляУпорВРег, "СУММА(") > 0) И Алиасы.Количество() > 0 Тогда
		Направление = "";
		Если СтрНайти(ПоляУпорВРег, "УБЫВ") > 0 Тогда
			Направление = " УБЫВ";
		ИначеЕсли СтрНайти(ПоляУпорВРег, "ВОЗР") > 0 Тогда
			Направление = " ВОЗР";
		КонецЕсли;
		АлиасСортировки = Алиасы[Алиасы.Количество() - 1];
		Возврат Лев(Текст, ПозУпор + ДлинаМаркера - 1) + " " + АлиасСортировки + Направление + Сред(Текст, ПозУпор + ДлинаМаркера + ПозКонецУпор - 1);
	КонецЕсли;
	ТокеныУпор = ИзвлечьИдентификаторыПолейИзТекстаЗапроса(ПоляУпор);
	НужнаЗамена = Ложь;
	Для Каждого ТокенУпор Из ТокеныУпор Цикл
		Если ЭтоКлючевоеСловоЗапроса(ТокенУпор) Тогда
			Продолжить;
		КонецЕсли;
		ПозТокена = СтрНайти(ВРег(ПоляУпор), ВРег(ТокенУпор));
		Если ПозТокена > 0 И Сред(ПоляУпор, ПозТокена + СтрДлина(ТокенУпор), 1) = "." Тогда
			Продолжить;
		КонецЕсли;
		Найден = Ложь;
		Для Каждого Алиас Из Алиасы Цикл
			Если ВРег(Алиас) = ВРег(ТокенУпор) Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найден Тогда
			ПоляУпор = ЗаменитьИдентификаторВТекстеЗапроса(ПоляУпор, ТокенУпор, Алиасы[Алиасы.Количество() - 1]);
			НужнаЗамена = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ НужнаЗамена Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозУпор + ДлинаМаркера - 1) + ПоляУпор + Сред(Текст, ПозУпор + ДлинаМаркера + ПозКонецУпор - 1);
КонецФункции

Функция УдалитьВиртуальныйСуффиксИзТекстаЗапроса(ТекстЗапроса, СуффиксВРег)
	Текст = Строка(ТекстЗапроса);
	Суффикс = ВРег(Строка(СуффиксВРег));
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ТекстВРег = ВРег(Текст);
		Если ПозицияПоиска > СтрДлина(ТекстВРег) Тогда
			Прервать;
		КонецЕсли;
		ПозОтносительно = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Суффикс);
		Если ПозОтносительно = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = ПозицияПоиска + ПозОтносительно - 1;
		ПозПослеСуффикса = Поз + СтрДлина(Суффикс);
		Если Суффикс = ".ОСТАТКИ" И СтрНачинаетсяС(Сред(ТекстВРег, ПозПослеСуффикса), "ИОБОРОТЫ") Тогда
			ПозицияПоиска = ПозПослеСуффикса;
			Продолжить;
		КонецЕсли;
		КонецТокена = ПозПослеСуффикса - 1;
		ИндексПробела = ПозПослеСуффикса;
		Пока ИндексПробела <= СтрДлина(Текст) Цикл
			Символ = Сред(Текст, ИндексПробела, 1);
			Если Символ <> " " И Символ <> Символы.Таб Тогда
				Прервать;
			КонецЕсли;
			ИндексПробела = ИндексПробела + 1;
		КонецЦикла;
		Если ИндексПробела <= СтрДлина(Текст) И Сред(Текст, ИндексПробела, 1) = "(" Тогда
			КонецТокена = НайтиПозициюЗакрывающейСкобки(Текст, ИндексПробела);
			Если КонецТокена = 0 Тогда
				КонецТокена = ИндексПробела;
			КонецЕсли;
		КонецЕсли;
		Текст = Лев(Текст, Поз - 1) + Сред(Текст, КонецТокена + 1);
		ПозицияПоиска = Поз;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция НайтиПозициюЗакрывающейСкобки(Текст, ПозицияОткрывающей)
	Глубина = 0;
	Для Индекс = ПозицияОткрывающей По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ИзвлечьТокенИсточникаИзТекстаЗапроса(ТекстЗапроса)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	ДлинаИз = 3;
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
		ДлинаИз = 4;
	КонецЕсли;
	Если ПозИз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Индекс = ПозИз + ДлинаИз;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ <> " " И Символ <> Символы.ПС И Символ <> Символы.Таб И Символ <> Символы.ВК Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	НачалоТокена = Индекс;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.Таб Или Символ = Символы.ВК Тогда
			Прервать;
		КонецЕсли;
		Если Символ = "(" Тогда
			КонецСкобок = НайтиПозициюЗакрывающейСкобки(Текст, Индекс);
			Если КонецСкобок > 0 Тогда
				Возврат Сред(Текст, НачалоТокена, КонецСкобок - НачалоТокена + 1);
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Индекс <= НачалоТокена Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Сред(Текст, НачалоТокена, Индекс - НачалоТокена));
КонецФункции

Функция КанонизироватьИменаПолейПоWhitelist(ТекстЗапроса, Whitelist)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Или Whitelist = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого ИмяПоля Из Whitelist Цикл
		Канон = Строка(ИмяПоля);
		Если ПустаяСтрока(Канон) Или ЭтоКлючевоеСловоЗапроса(Канон) Тогда
			Продолжить;
		КонецЕсли;
		Имена.Добавить(Канон);
	КонецЦикла;
	Для Внешний = 0 По Имена.Количество() - 2 Цикл
		Для Внутренний = Внешний + 1 По Имена.Количество() - 1 Цикл
			Если СтрДлина(Имена[Внутренний]) > СтрДлина(Имена[Внешний]) Тогда
				Временное = Имена[Внешний];
				Имена[Внешний] = Имена[Внутренний];
				Имена[Внутренний] = Временное;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Канон Из Имена Цикл
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, Канон, Канон);
	КонецЦикла;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "Регистратор")
		И НЕ ПолеЕстьВWhitelistЛокально(Whitelist, "Документ") Тогда
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Документ", "Регистратор");
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "Период")
		И НЕ ПолеЕстьВWhitelistЛокально(Whitelist, "Дата") Тогда
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Дата", "Период");
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция КанонизироватьРесурсыВиртуальнойТаблицы(ТекстЗапроса, Whitelist)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Или Whitelist = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Суффикс = "";
	Если СтрНайти(ТекстВРег, ".ОСТАТКИИОБОРОТЫ") > 0 Или СтрНайти(ТекстВРег, ".ОБОРОТЫ") > 0 Тогда
		Суффикс = "Оборот";
	ИначеЕсли СтрНайти(ТекстВРег, ".ОСТАТКИ") > 0 Тогда
		Суффикс = "Остаток";
	Иначе
		Для Каждого ИмяПоля Из Whitelist Цикл
			Канон = Строка(ИмяПоля);
			Если Прав(Канон, 6) = "Оборот" И СтрДлина(Канон) > 6 Тогда
				База = Лев(Канон, СтрДлина(Канон) - 6);
				Если НЕ ПустаяСтрока(База) Тогда
					Текст = СтрЗаменить(Текст, "." + Канон + ")", "." + База + ")");
					Текст = СтрЗаменить(Текст, "(" + Канон + ")", "(" + База + ")");
					Текст = СтрЗаменить(Текст, "." + Канон + ",", "." + База + ",");
					Текст = СтрЗаменить(Текст, "." + Канон + " ", "." + База + " ");
					Если НЕ ЭтоКлючевоеСловоЗапроса(База) Тогда
						Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, Канон, База);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "ПЕРИОД") > 0 Или СтрНайти(ТекстВРег, "ДЕНЬ") > 0 Тогда
		Текст = СтрЗаменить(Текст, ".Обороты(, , )", ".Обороты(, , День)");
		Текст = СтрЗаменить(Текст, ".Обороты(,,)", ".Обороты(, , День)");
		Текст = СтрЗаменить(Текст, ".Обороты(, ,)", ".Обороты(, , День)");
	КонецЕсли;
	Для Каждого ИмяПоля Из Whitelist Цикл
		Канон = Строка(ИмяПоля);
		Если СтрДлина(Канон) <= СтрДлина(Суффикс) Тогда
			Продолжить;
		КонецЕсли;
		Если Прав(Канон, СтрДлина(Суффикс)) <> Суффикс Тогда
			Продолжить;
		КонецЕсли;
		База = Лев(Канон, СтрДлина(Канон) - СтрДлина(Суффикс));
		Если ПустаяСтрока(База) Тогда
			Продолжить;
		КонецЕсли;
		Текст = СтрЗаменить(Текст, "." + База + ")", "." + Канон + ")");
		Текст = СтрЗаменить(Текст, "(" + База + ")", "(" + Канон + ")");
		Текст = СтрЗаменить(Текст, "." + База + ",", "." + Канон + ",");
		Текст = СтрЗаменить(Текст, "." + База + " ", "." + Канон + " ");
		Текст = СтрЗаменить(Текст, "." + База + Символы.ПС, "." + Канон + Символы.ПС);
		Если НЕ ЭтоКлючевоеСловоЗапроса(База) Тогда
			Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, База, Канон);
		КонецЕсли;
	КонецЦикла;
	Если Суффикс = "Оборот" Тогда
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Сумма", "СуммаОборот");
	ИначеЕсли Суффикс = "Остаток" Тогда
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Сумма", "СуммаОстаток");
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ДобавитьФильтрДатИзКонтекстаЕслиНужно(ТекстЗапроса, ПолноеИмяОбъекта, КонтекстВыполнения)
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(Текст) Или КонтекстВыполнения = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстЗадачи = "";
	Если КонтекстВыполнения.Свойство("СсылкаДиалога") И ЗначениеЗаполнено(КонтекстВыполнения.СсылкаДиалога) Тогда
		ПоследняяЗадача = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(КонтекстВыполнения.СсылкаДиалога);
		Если ПоследняяЗадача <> Неопределено И ПоследняяЗадача.Свойство("Найдено") И ПоследняяЗадача.Найдено Тогда
			ТекстЗадачи = Строка(ПоследняяЗадача.Текст);
		КонецЕсли;
	КонецЕсли;
	Если КонтекстВыполнения.Свойство("DSL_ТекстЗадачи") И НЕ ПустаяСтрока(Строка(КонтекстВыполнения.DSL_ТекстЗадачи)) Тогда
		ТекстЗадачи = ТекстЗадачи + " " + Строка(КонтекстВыполнения.DSL_ТекстЗадачи);
	КонецЕсли;
	Границы = ИзвлечьГраницыДатИзТекста(ТекстЗадачи);
	Если Границы = Неопределено Тогда
		Границы = ИзвлечьГраницыДатИзТекста(Текст);
	КонецЕсли;
	Если Границы = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = ПодставитьДатыВПараметрыОборотов(Текст, Границы);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОБОРОТЫ(") > 0 Или СтрНайти(ТекстВРег, ".ОСТАТКИ(") > 0 Или СтрНайти(ТекстВРег, ".ОСТАТКИИОБОРОТЫ(") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, " ГДЕ") > 0 Или СтрНайти(ТекстВРег, Символы.ПС + "ГДЕ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ИмяПоляДаты = "Период";
	Если ВРег(Лев(СокрЛП(Строка(ПолноеИмяОбъекта)), СтрДлина("Документ."))) = "ДОКУМЕНТ." Тогда
		ИмяПоляДаты = "Дата";
	КонецЕсли;
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	ВыражениеПоля = ИмяПоляДаты;
	Если НЕ ПустаяСтрока(Псевдоним) Тогда
		ВыражениеПоля = Псевдоним + "." + ИмяПоляДаты;
	КонецЕсли;
	Условие = ВыражениеПоля + " МЕЖДУ " + Границы.Начало + " И " + Границы.Конец;
	МаркерыВставки = Новый Массив;
	МаркерыВставки.Добавить(Символы.ПС + "СГРУППИРОВАТЬ ПО");
	МаркерыВставки.Добавить(Символы.ПС + "УПОРЯДОЧИТЬ ПО");
	МаркерыВставки.Добавить(Символы.ПС + "ИТОГИ");
	ПозВставки = СтрДлина(Текст) + 1;
	Для Каждого Маркер Из МаркерыВставки Цикл
		Поз = СтрНайти(ТекстВРег, Маркер);
		Если Поз > 0 И Поз < ПозВставки Тогда
			ПозВставки = Поз;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрП(Лев(Текст, ПозВставки - 1)) + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + Условие + Сред(Текст, ПозВставки);
КонецФункции

Функция ПодставитьДатыВПараметрыОборотов(ТекстЗапроса, Границы)
	Текст = Строка(ТекстЗапроса);
	Если Границы = Неопределено Или ПустаяСтрока(Границы.Начало) Или ПустаяСтрока(Границы.Конец) Тогда
		Возврат Текст;
	КонецЕсли;
	Параметры = Границы.Начало + ", " + Границы.Конец + ", День";
	Текст = СтрЗаменить(Текст, ".Обороты(, , Авто)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(, , День)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(,,Авто)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(,,День)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(, ,Авто)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(, ,День)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(,, Авто)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(,, День)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(, Авто)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(, День)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты(,)", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, ".Обороты( , )", ".Обороты(" + Параметры + ")");
	Текст = СтрЗаменить(Текст, "&НачалоПериода", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&КонецПериода", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&ОкончаниеПериода", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&ДатаНач", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&ДатаКон", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&ДатаНачала", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&ДатаОкончания", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&НачПериода", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&КонПериода", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&НачалоПериода", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&КонецПериода", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&НачПериод", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&КонПериод", Границы.Конец);
	Текст = СтрЗаменить(Текст, "&Начало", Границы.Начало);
	Текст = СтрЗаменить(Текст, "&Конец", Границы.Конец);
	Возврат Текст;
КонецФункции

Функция ИзвлечьГраницыДатИзТекста(Текст)
	Даты = Новый Массив;
	Исходный = Строка(Текст);
	Индекс = 1;
	Пока Индекс <= СтрДлина(Исходный) - 9 Цикл
		Фрагмент = Сред(Исходный, Индекс, 10);
		Если ЭтоДатаДДММГГГГ(Фрагмент) Тогда
			Даты.Добавить(Фрагмент);
			Индекс = Индекс + 10;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	Если Даты.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Начало = РазобратьДатуДДММГГГГ(Даты[0], Ложь);
	КонецПериода = РазобратьДатуДДММГГГГ(Даты[1], Истина);
	Если ПустаяСтрока(Начало) Или ПустаяСтрока(КонецПериода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("Начало,Конец", Начало, КонецПериода);
	Возврат Результат;
КонецФункции

Функция ЭтоДатаДДММГГГГ(Фрагмент)
	Если СтрДлина(Фрагмент) <> 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сред(Фрагмент, 3, 1) <> "." Или Сред(Фрагмент, 6, 1) <> "." Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По 10 Цикл
		Если Индекс = 3 Или Индекс = 6 Тогда
			Продолжить;
		КонецЕсли;
		Символ = Сред(Фрагмент, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция РазобратьДатуДДММГГГГ(Фрагмент, КонецДня)
	День = Число(Лев(Фрагмент, 2));
	Месяц = Число(Сред(Фрагмент, 4, 2));
	Год = Число(Прав(Фрагмент, 4));
	Если День < 1 Или День > 31 Или Месяц < 1 Или Месяц > 12 Или Год < 1990 Тогда
		Возврат "";
	КонецЕсли;
	Если КонецДня Тогда
		Возврат "ДАТАВРЕМЯ(" + Формат(Год, "ЧГ=0") + ", " + Формат(Месяц, "ЧГ=0") + ", " + Формат(День, "ЧГ=0") + ", 23, 59, 59)";
	КонецЕсли;
	Возврат "ДАТАВРЕМЯ(" + Формат(Год, "ЧГ=0") + ", " + Формат(Месяц, "ЧГ=0") + ", " + Формат(День, "ЧГ=0") + ")";
КонецФункции

Функция ЗаменитьИдентификаторВТекстеЗапросаПоСемантике(ТекстЗапроса, Whitelist)
	Текст = Строка(ТекстЗапроса);
	Замены = Новый Соответствие;
	Токены = ИзвлечьИдентификаторыПолейИзТекстаЗапроса(Текст);
	Для Каждого Токен Из Токены Цикл
		Если ПолеЕстьВWhitelistЛокально(Whitelist, Токен) Тогда
			Канон = КаноническоеИмяПоляИзWhitelist(Whitelist, Токен);
			Если Канон <> Токен Тогда
				Замены.Вставить(Токен, Канон);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Семантика = ПодобратьСемантическуюЗаменуПоля(Токен, Whitelist);
		Если НЕ ПустаяСтрока(Семантика) Тогда
			Замены.Вставить(Токен, Семантика);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ПараЗамены Из Замены Цикл
		Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, ПараЗамены.Ключ, ПараЗамены.Значение);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ПодобратьСемантическуюЗаменуПоля(Токен, Whitelist)
	ТокенВРег = ВРег(СокрЛП(Строка(Токен)));
	Если ПустаяСтрока(ТокенВРег) Или ЭтоКлючевоеСловоЗапроса(Токен) Тогда
		Возврат "";
	КонецЕсли;
	Если ТокенВРег = "ВРЕМЯ" Тогда
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "Дата") Тогда
			Возврат "Дата";
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "Период") Тогда
			Возврат "Период";
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(ТокенВРег, "СУММ") > 0 Тогда
		Возврат ПодобратьКаноническоеСуммовоеПоле(Whitelist);
	КонецЕсли;
	Если ТокенВРег = "ОСТАТОК" Или ТокенВРег = "ТЕКУЩИЙОСТАТОК" Тогда
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "КоличествоОстаток") Тогда
			Возврат "КоличествоОстаток";
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "КоличествоОстатокДт") Тогда
			Возврат "КоличествоОстатокДт";
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(ТокенВРег, "НОМЕР") > 0 И ПолеЕстьВWhitelistЛокально(Whitelist, "Номер") Тогда
		Возврат КаноническоеИмяПоляИзWhitelist(Whitelist, "Номер");
	КонецЕсли;
	Если СтрДлина(ТокенВРег) <= 3 Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(ТокенВРег, "НАЧАЛ") > 0 Или СтрНайти(ТокенВРег, "ОКОНЧАН") > 0 Или СтрНайти(ТокенВРег, "РАБОТ") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ТокенВРег <> "ДАТАВРЕМЯ"
		И ТокенВРег <> "ДАТАНАЧАЛАРАБОТ"
		И (ТокенВРег = "ДАТА" Или (СтрДлина(ТокенВРег) <= 8 И (СтрНачинаетсяС(ТокенВРег, "ДАТА") Или Прав(ТокенВРег, 4) = "ДАТА")))
		И ПолеЕстьВWhitelistЛокально(Whitelist, "Дата") Тогда
		Возврат КаноническоеИмяПоляИзWhitelist(Whitelist, "Дата");
	КонецЕсли;
	ЛучшаяЗамена = "";
	ЛучшаяОценка = 80;
	Для Каждого ИмяПоля Из Whitelist Цикл
		Оценка = ОценитьПохожестьПоля(Токен, ИмяПоля);
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшаяЗамена = Строка(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(ЛучшаяЗамена) Тогда
		Возврат ЛучшаяЗамена;
	КонецЕсли;
	Если СтрНайти(ТокенВРег, "КАТЕГОР") > 0 Тогда
		Для Каждого ИмяПоля Из Whitelist Цикл
			ИмяВРег = ВРег(Строка(ИмяПоля));
			Если СтрНайти(ИмяВРег, "КАТЕГОР") > 0
				Или СтрНайти(ИмяВРег, "ВИДНОМЕНКЛАТ") > 0
				Или СтрНайти(ИмяВРег, "НОМЕНКЛАТУРНАЯГРУПП") > 0 Тогда
				Возврат Строка(ИмяПоля);
			КонецЕсли;
		КонецЦикла;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, "Номенклатура") Тогда
			Возврат "Номенклатура";
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ИзвлечьИдентификаторыПолейИзТекстаЗапроса(ТекстЗапроса)
	Результат = Новый Массив;
	Текст = Строка(ТекстЗапроса);
	Текущий = "";
	ВКавычках = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Текущий = "";
			Продолжить;
		КонецЕсли;
		Если ВКавычках Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоСимволИдентификатораЗапроса(Символ) Тогда
			Текущий = Текущий + Символ;
		Иначе
			Если СтрДлина(Текущий) > 1 И Результат.Найти(Текущий) = Неопределено Тогда
				Если НЕ ЭтоКлючевоеСловоЗапроса(Текущий) Тогда
					Результат.Добавить(Текущий);
				КонецЕсли;
			КонецЕсли;
			Текущий = "";
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Текущий) > 1 И Результат.Найти(Текущий) = Неопределено И НЕ ЭтоКлючевоеСловоЗапроса(Текущий) Тогда
		Результат.Добавить(Текущий);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоКлючевоеСловоЗапроса(Токен)
	ТокенВРег = ВРег(СокрЛП(Строка(Токен)));
	Возврат ТокенВРег = "ВЫБРАТЬ"
		Или ТокенВРег = "ПЕРВЫЕ"
		Или ТокенВРег = "РАЗЛИЧНЫЕ"
		Или ТокенВРег = "ИЗ"
		Или ТокенВРег = "КАК"
		Или ТокенВРег = "ГДЕ"
		Или ТокенВРег = "И"
		Или ТокенВРег = "ИЛИ"
		Или ТокенВРег = "НЕ"
		Или ТокенВРег = "В"
		Или ТокенВРег = "МЕЖДУ"
		Или ТокенВРег = "ПОДОБНО"
		Или ТокенВРег = "ЕСТЬ"
		Или ТокенВРег = "NULL"
		Или ТокенВРег = "СГРУППИРОВАТЬ"
		Или ТокенВРег = "ПО"
		Или ТокенВРег = "УПОРЯДОЧИТЬ"
		Или ТокенВРег = "ИМЕЮЩИЕ"
		Или ТокенВРег = "ВОЗР"
		Или ТокенВРег = "УБЫВ"
		Или ТокенВРег = "СУММА"
		Или ТокенВРег = "КОЛИЧЕСТВО"
		Или ТокенВРег = "МАКСИМУМ"
		Или ТокенВРег = "МИНИМУМ"
		Или ТокенВРег = "СРЕДНЕЕ"
		Или ТокенВРег = "ДАТАВРЕМЯ"
		Или ТокенВРег = "ДОБАВИТЬКДАТЕ"
		Или ТокенВРег = "НАЧАЛОПЕРИОДА"
		Или ТокенВРег = "КОНЕЦПЕРИОДА"
		Или ТокенВРег = "ЗНАЧЕНИЕ"
		Или ТокенВРег = "ДОКУМЕНТ"
		Или ТокенВРег = "СПРАВОЧНИК"
		Или ТокенВРег = "РЕГИСТРНАКОПЛЕНИЯ"
		Или ТокенВРег = "РЕГИСТРСВЕДЕНИЙ"
		Или ТокенВРег = "РЕГИСТРБУХГАЛТЕРИИ"
		Или ТокенВРег = "ОСТАТКИ"
		Или ТокенВРег = "ОБОРОТЫ"
		Или ТокенВРег = "ОСТАТКИИОБОРОТЫ"
		Или ТокенВРег = "АВТО"
		Или ТокенВРег = "ИСТИНА"
		Или ТокенВРег = "ЛОЖЬ"
		Или ТокенВРег = "ДЕНЬ"
		Или ТокенВРег = "НЕДЕЛЯ"
		Или ТокенВРег = "МЕСЯЦ"
		Или ТокенВРег = "КВАРТАЛ"
		Или ТокенВРег = "ГОД"
		Или ТокенВРег = "ЧАС"
		Или ТокенВРег = "МИНУТА"
		Или ТокенВРег = "СЕКУНДА";
КонецФункции

Функция НормализоватьГруппировкуЗапросаПоWhitelist(ТекстЗапроса, Whitelist)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Маркер = Символы.ПС + "СГРУППИРОВАТЬ ПО";
	Поз = СтрНайти(ТекстВРег, Маркер);
	Если Поз = 0 Тогда
		Маркер = " СГРУППИРОВАТЬ ПО ";
		Поз = СтрНайти(ТекстВРег, Маркер);
	КонецЕсли;
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	НачалоСекции = Поз + СтрДлина(Маркер);
	ПозКонец = СтрДлина(Текст) + 1;
	МаркерыКонца = Новый Массив;
	МаркерыКонца.Добавить(Символы.ПС + "УПОРЯДОЧИТЬ ПО");
	МаркерыКонца.Добавить(Символы.ПС + "ИМЕЮЩИЕ");
	МаркерыКонца.Добавить(Символы.ПС + "ИТОГИ");
	Для Каждого МаркерКонца Из МаркерыКонца Цикл
		ПозКандидат = СтрНайти(Сред(ТекстВРег, НачалоСекции), МаркерКонца);
		Если ПозКандидат > 0 И (НачалоСекции + ПозКандидат - 1) < ПозКонец Тогда
			ПозКонец = НачалоСекции + ПозКандидат - 1;
		КонецЕсли;
	КонецЦикла;
	Секция = СокрЛП(Сред(Текст, НачалоСекции, ПозКонец - НачалоСекции));
	НовыеПоля = Новый Массив;
	Для Каждого Часть Из РазделитьВыраженияСпискаЗапроса(Секция) Цикл
		Выражение = СокрЛП(Строка(Часть));
		Если ПустаяСтрока(Выражение) Тогда
			Продолжить;
		КонецЕсли;
		БазовоеИмя = ПолучитьБазовоеИмяПоляЛокально(Выражение);
		Префикс = ПолучитьПрефиксКвалификатораПоляЛокально(Выражение);
		ЗаменаПоля = "";
		Если ПолеЕстьВWhitelistЛокально(Whitelist, БазовоеИмя) Тогда
			ЗаменаПоля = КаноническоеИмяПоляИзWhitelist(Whitelist, БазовоеИмя);
		ИначеЕсли ВРег(БазовоеИмя) = "ДАТА" Или ВРег(БазовоеИмя) = "ДЕНЬ" Тогда
			Если ПолеЕстьВWhitelistЛокально(Whitelist, "Период") Тогда
				ЗаменаПоля = "Период";
			ИначеЕсли ПолеЕстьВWhitelistЛокально(Whitelist, "Дата") Тогда
				ЗаменаПоля = "Дата";
			КонецЕсли;
		Иначе
			ЗаменаПоля = ПодобратьСемантическуюЗаменуПоля(БазовоеИмя, Whitelist);
		КонецЕсли;
		Если ПустаяСтрока(ЗаменаПоля) Тогда
			Если СтрНайти(Выражение, "(") > 0 Тогда
				НовыеПоля.Добавить(Выражение);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, БазовоеИмя)
			И ВРег(СокрЛП(ЗаменаПоля)) = ВРег(СокрЛП(БазовоеИмя)) Тогда
			НовыеПоля.Добавить(Выражение);
			Продолжить;
		КонецЕсли;
		Если ЭтоСистемныйПрефиксКвалификатораПоляЛокально(Префикс) Тогда
			Префикс = "";
		КонецЕсли;
		НовыеПоля.Добавить(Префикс + ЗаменаПоля);
	КонецЦикла;
	Если НовыеПоля.Количество() = 0 Тогда
		Возврат СокрП(Лев(Текст, Поз - 1)) + Сред(Текст, ПозКонец);
	КонецЕсли;
	Возврат Лев(Текст, НачалоСекции - 1) + " " + СтрСоединить(НовыеПоля, ", ") + Сред(Текст, ПозКонец);
КонецФункции

Функция ЭтоАгрегатноеВыражениеЗапроса(Выражение)
	ВыражениеВРег = ВРег(Строка(Выражение));
	Возврат СтрНайти(ВыражениеВРег, "СУММА(") > 0
		Или СтрНайти(ВыражениеВРег, "КОЛИЧЕСТВО(") > 0
		Или СтрНайти(ВыражениеВРег, "СРЕДНЕЕ(") > 0
		Или СтрНайти(ВыражениеВРег, "МАКСИМУМ(") > 0
		Или СтрНайти(ВыражениеВРег, "МИНИМУМ(") > 0
		Или СтрНайти(ВыражениеВРег, "КОЛИЧЕСТВОРАЗЛИЧНЫХ(") > 0;
КонецФункции

Функция ЭтоРесурсоподобноеПолеЗапроса(ИмяПоля)
	ИмяВРег = ВРег(СокрЛП(Строка(ИмяПоля)));
	Если ПустаяСтрока(ИмяВРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ИмяВРег, "СУММ") > 0
		Или СтрНайти(ИмяВРег, "КОЛИЧЕСТВ") > 0
		Или СтрНайти(ИмяВРег, "СТОИМОСТ") > 0
		Или СтрНайти(ИмяВРег, "ОБОРОТ") > 0
		Или СтрНайти(ИмяВРег, "ОСТАТОК") > 0
		Или СтрНайти(ИмяВРег, "ЦЕНА") > 0;
КонецФункции

Функция НормализоватьКлючВыраженияГруппировки(Выражение)
	Текст = ВРег(СокрЛП(Строка(Выражение)));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символы.ПС, "");
	Текст = СтрЗаменить(Текст, Символы.Таб, "");
	Возврат Текст;
КонецФункции

Функция ВыражениеЕстьВГруппировке(Выражение, ПоляГруппировки)
	КлючВыражения = НормализоватьКлючВыраженияГруппировки(Выражение);
	База = ВРег(ПолучитьБазовоеИмяПоляЛокально(Выражение));
	Для Каждого ПолеГруппировки Из ПоляГруппировки Цикл
		КлючГруппы = НормализоватьКлючВыраженияГруппировки(ПолеГруппировки);
		Если КлючГруппы = КлючВыражения Тогда
			Возврат Истина;
		КонецЕсли;
		Если НЕ ПустаяСтрока(База) И ВРег(ПолучитьБазовоеИмяПоляЛокально(ПолеГруппировки)) = База Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОчиститьХвостСекцииГруппировки(СекцияГруппировки)
	Секция = СокрЛП(Строка(СекцияГруппировки));
	СекцияВРег = ВРег(Секция);
	ПозПервые = СтрНайти(СекцияВРег, "ПЕРВЫЕ ");
	Если ПозПервые > 0 Тогда
		Секция = СокрП(Лев(Секция, ПозПервые - 1));
	КонецЕсли;
	Секция = СокрП(СтрЗаменить(СтрЗаменить(Секция, "АВТОУПОР", ""), "Автоупор", ""));
	Пока Прав(Секция, 1) = "," Цикл
		Секция = СокрП(Лев(Секция, СтрДлина(Секция) - 1));
	КонецЦикла;
	Возврат Секция;
КонецФункции

Функция СогласоватьГруппировкуСВыборкой(ТекстЗапроса) Экспорт
	Текст = Строка(ТекстЗапроса);
	Если СтрЧислоВхождений(ВРег(Текст), "ВЫБРАТЬ") > 1 Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозИз = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИЗ", 1);
	НачалоПолей = НайтиНачалоСпискаПолейВыборки(Текст);
	Если ПозИз = 0 Или НачалоПолей = 0 Или НачалоПолей >= ПозИз Тогда
		Возврат Текст;
	КонецЕсли;
	СекцияВыбрать = СокрЛП(Сред(Текст, НачалоПолей, ПозИз - НачалоПолей));
	ПозГрупп = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "СГРУППИРОВАТЬ", 1);
	ПозИмеющие = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИМЕЮЩИЕ", Макс(ПозГрупп, ПозИз));
	ПозУпор = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "УПОРЯДОЧИТЬ", Макс(ПозГрупп, ПозИз));
	КонецГрупп = БлижайшаяГраницаСекцииЗапроса(ПозИмеющие, ПозУпор, 0, СтрДлина(Текст) + 1);
	ПоляГруппировки = Новый Массив;
	Если ПозГрупп > 0 Тогда
		Хвост = СокрЛП(Сред(Текст, ПозГрупп + СтрДлина("СГРУППИРОВАТЬ"), КонецГрупп - ПозГрупп - СтрДлина("СГРУППИРОВАТЬ")));
		Если ВРег(Лев(Хвост, 2)) = "ПО" Тогда
			Хвост = СокрЛП(Сред(Хвост, 3));
		КонецЕсли;
		Хвост = ОчиститьХвостСекцииГруппировки(Хвост);
	Для Каждого ЧастьГруппы Из РазделитьВыраженияСпискаЗапроса(Хвост) Цикл
		ВыражениеГруппы = СокрЛП(Строка(ЧастьГруппы));
		Если ПустаяСтрока(ВыражениеГруппы) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ВРег(ВыражениеГруппы), "ПЕРВЫЕ") Или ВРег(ВыражениеГруппы) = "АВТОУПОР" Тогда
			Продолжить;
		КонецЕсли;
		ПоляГруппировки.Добавить(ВыражениеГруппы);
	КонецЦикла;
	КонецЕсли;
	НовыеПоляВыборки = Новый Массив;
	Для Каждого ЧастьВыбора Из РазделитьВыраженияСпискаЗапроса(СекцияВыбрать) Цикл
		ВыражениеВыбора = СокрЛП(Строка(ЧастьВыбора));
		Если ПустаяСтрока(ВыражениеВыбора) Тогда
			Продолжить;
		КонецЕсли;
		ПозКак = СтрНайти(ВРег(ВыражениеВыбора), " КАК ");
		ИсходноеВыражение = ВыражениеВыбора;
		ПсевдонимПоля = "";
		Если ПозКак > 0 Тогда
			ИсходноеВыражение = СокрЛП(Лев(ВыражениеВыбора, ПозКак - 1));
			ПсевдонимПоля = СокрЛП(Сред(ВыражениеВыбора, ПозКак + 5));
		КонецЕсли;
		Если ЭтоАгрегатноеВыражениеЗапроса(ИсходноеВыражение) Тогда
			НовыеПоляВыборки.Добавить(ВыражениеВыбора);
			Продолжить;
		КонецЕсли;
		Если ВыражениеЕстьВГруппировке(ИсходноеВыражение, ПоляГруппировки) Тогда
			НовыеПоляВыборки.Добавить(ВыражениеВыбора);
			Продолжить;
		КонецЕсли;
		БазовоеИмя = ПолучитьБазовоеИмяПоляЛокально(ИсходноеВыражение);
		Если ЭтоРесурсоподобноеПолеЗапроса(БазовоеИмя) Или ЭтоРесурсоподобноеПолеЗапроса(ПсевдонимПоля) Тогда
			Обернутое = "СУММА(" + ИсходноеВыражение + ")";
			Если НЕ ПустаяСтрока(ПсевдонимПоля) Тогда
				Обернутое = Обернутое + " КАК " + ПсевдонимПоля;
			КонецЕсли;
			НовыеПоляВыборки.Добавить(Обернутое);
			Продолжить;
		КонецЕсли;
		ПоляГруппировки.Добавить(ИсходноеВыражение);
		НовыеПоляВыборки.Добавить(ВыражениеВыбора);
	КонецЦикла;
	Если НовыеПоляВыборки.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = Лев(Текст, НачалоПолей - 1) + СтрСоединить(НовыеПоляВыборки, ", ") + Символы.ПС + Сред(Текст, ПозИз);
	Если ПоляГруппировки.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозГрупп = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "СГРУППИРОВАТЬ", 1);
	ПозИмеющие = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИМЕЮЩИЕ", Макс(ПозГрупп, 1));
	ПозУпор = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "УПОРЯДОЧИТЬ", Макс(ПозГрупп, 1));
	Если ПозГрупп = 0 Тогда
		ПозВставки = БлижайшаяГраницаСекцииЗапроса(ПозИмеющие, ПозУпор, 0, СтрДлина(Текст) + 1);
		ХвостПослеГруппы = Сред(Текст, ПозВставки);
		Если НЕ ПустаяСтрока(ХвостПослеГруппы) И Лев(ХвостПослеГруппы, 1) <> Символы.ПС Тогда
			ХвостПослеГруппы = Символы.ПС + СокрЛ(ХвостПослеГруппы);
		КонецЕсли;
		Возврат СокрП(Лев(Текст, ПозВставки - 1)) + Символы.ПС + "СГРУППИРОВАТЬ ПО " + СтрСоединить(ПоляГруппировки, ", ") + ХвостПослеГруппы;
	КонецЕсли;
	КонецГрупп = БлижайшаяГраницаСекцииЗапроса(ПозИмеющие, ПозУпор, 0, СтрДлина(Текст) + 1);
	ХвостПослеГруппы = Сред(Текст, КонецГрупп);
	Если НЕ ПустаяСтрока(ХвостПослеГруппы) И Лев(ХвостПослеГруппы, 1) <> Символы.ПС Тогда
		ХвостПослеГруппы = Символы.ПС + СокрЛ(ХвостПослеГруппы);
	КонецЕсли;
	Возврат Лев(Текст, ПозГрупп - 1) + "СГРУППИРОВАТЬ ПО " + СтрСоединить(ПоляГруппировки, ", ") + ХвостПослеГруппы;
КонецФункции

Функция УдалитьУсловияСПолямиВнеWhitelist(ТекстЗапроса, Whitelist)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	ПозГде = СтрНайти(ТекстВРег, Символы.ПС + "ГДЕ");
	Если ПозГде = 0 Тогда
		ПозГде = СтрНайти(ТекстВРег, " ГДЕ ");
		Если ПозГде = 0 Тогда
			Возврат Текст;
		КонецЕсли;
		НачалоГде = ПозГде;
		ДлинаМаркера = 5;
	Иначе
		НачалоГде = ПозГде;
		ДлинаМаркера = 4;
	КонецЕсли;
	ПозКонец = СтрДлина(Текст) + 1;
	МаркерыКонца = Новый Массив;
	МаркерыКонца.Добавить(Символы.ПС + "СГРУППИРОВАТЬ ПО");
	МаркерыКонца.Добавить(Символы.ПС + "УПОРЯДОЧИТЬ ПО");
	МаркерыКонца.Добавить(Символы.ПС + "ИМЕЮЩИЕ");
	МаркерыКонца.Добавить(Символы.ПС + "ИТОГИ");
	Для Каждого МаркерКонца Из МаркерыКонца Цикл
		ПозКандидат = СтрНайти(Сред(ТекстВРег, НачалоГде + ДлинаМаркера), МаркерКонца);
		Если ПозКандидат > 0 И (НачалоГде + ДлинаМаркера + ПозКандидат - 1) < ПозКонец Тогда
			ПозКонец = НачалоГде + ДлинаМаркера + ПозКандидат - 1;
		КонецЕсли;
	КонецЦикла;
	СекцияГде = Сред(Текст, НачалоГде + ДлинаМаркера, ПозКонец - НачалоГде - ДлинаМаркера);
	СтрокиУсловий = СтрРазделить(СекцияГде, Символы.ПС, Ложь);
	Оставшиеся = Новый Массив;
	Для Каждого СтрокаУсловия Из СтрокиУсловий Цикл
		Если УсловиеСодержитПолеВнеWhitelist(СтрокаУсловия, Whitelist) Тогда
			Продолжить;
		КонецЕсли;
		Оставшиеся.Добавить(СтрокаУсловия);
	КонецЦикла;
	Если Оставшиеся.Количество() = СтрокиУсловий.Количество() Тогда
		Возврат Текст;
	КонецЕсли;
	Если Оставшиеся.Количество() = 0 Тогда
		Возврат СокрП(Лев(Текст, НачалоГде - 1)) + Сред(Текст, ПозКонец);
	КонецЕсли;
	НоваяСекция = СтрСоединить(Оставшиеся, Символы.ПС);
	НоваяСекцияВРег = ВРег(СокрЛП(НоваяСекция));
	Пока СтрНачинаетсяС(НоваяСекцияВРег, "И ") Или СтрНачинаетсяС(НоваяСекцияВРег, "ИЛИ ") Цикл
		НоваяСекция = СокрЛП(Сред(СокрЛП(НоваяСекция), ?(СтрНачинаетсяС(НоваяСекцияВРег, "ИЛИ "), 4, 2)));
		НоваяСекцияВРег = ВРег(СокрЛП(НоваяСекция));
	КонецЦикла;
	Возврат Лев(Текст, НачалоГде + ДлинаМаркера - 1) + " " + НоваяСекция + Сред(Текст, ПозКонец);
КонецФункции

Функция УсловиеСодержитПолеВнеWhitelist(СтрокаУсловия, Whitelist)
	Токены = ИзвлечьИдентификаторыПолейИзТекстаЗапроса(СтрокаУсловия);
	Для Каждого Токен Из Токены Цикл
		Если ЭтоКлючевоеСловоЗапроса(Токен) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоЧисловойТокенЗапроса(Токен) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(Токен) < 3 Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеЕстьВWhitelistЛокально(Whitelist, Токен) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоЧисловойТокенЗапроса(Токен)
	Значение = СокрЛП(Строка(Токен));
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЗаменитьПериодНаДатуЕслиИсточникДокумент(ТекстЗапроса, ПолноеИмяОбъекта)
	Текст = Строка(ТекстЗапроса);
	ИмяИсточника = ПолноеИмяОбъекта;
	Если ПустаяСтрока(ИмяИсточника) Тогда
		ИмяИсточника = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Текст);
	КонецЕсли;
	Если ВРег(Лев(СокрЛП(ИмяИсточника), СтрДлина("Документ."))) <> "ДОКУМЕНТ." Тогда
		Возврат Текст;
	КонецЕсли;
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаПровайдера(Текст);
	Если НЕ ПустаяСтрока(Псевдоним) Тогда
		Текст = СтрЗаменить(Текст, Псевдоним + ".Период", Псевдоним + ".Дата");
		Текст = СтрЗаменить(Текст, Псевдоним + ".период", Псевдоним + ".Дата");
		Текст = СтрЗаменить(Текст, Псевдоним + ".ПЕРИОД", Псевдоним + ".Дата");
	КонецЕсли;
	Текст = ЗаменитьНеквалифицированныйИдентификаторВТекстеЗапроса(Текст, "Период", "Дата");
	ЧастиИмени = СтрРазделить(СокрЛП(ИмяИсточника), ".");
	Если ЧастиИмени.Количество() >= 3 Тогда
		Если НЕ ПустаяСтрока(Псевдоним) Тогда
			Текст = СтрЗаменить(Текст, Псевдоним + ".Дата", Псевдоним + ".Ссылка.Дата");
		КонецЕсли;
		Текст = ЗаменитьНеквалифицированныйИдентификаторВТекстеЗапроса(Текст, "Дата", "Ссылка.Дата");
		Текст = СтрЗаменить(Текст, " КАК Ссылка.Дата", " КАК Дата");
		Текст = СтрЗаменить(Текст, " как Ссылка.Дата", " КАК Дата");
		WhitelistШапки = ПолучитьWhitelistПолейОбъектаЛокально(Строка(ЧастиИмени[0]) + "." + Строка(ЧастиИмени[1]));
		Для Каждого ИмяШапки Из WhitelistШапки Цикл
			ПолеШапки = СокрЛП(Строка(ИмяШапки));
			Если ПустаяСтрока(ПолеШапки) Или ВРег(ПолеШапки) = "ССЫЛКА" Или ВРег(ПолеШапки) = "ДАТА" Тогда
				Продолжить;
			КонецЕсли;
			Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, ПолеШапки, "Ссылка." + ПолеШапки);
			Текст = СтрЗаменить(Текст, " КАК Ссылка." + ПолеШапки, " КАК " + ПолеШапки);
		КонецЦикла;
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ЗаменитьНеквалифицированныйИдентификаторВТекстеЗапроса(ТекстЗапроса, СтароеИмя, НовоеИмя)
	Текст = Строка(ТекстЗапроса);
	ИмяСтарое = СокрЛП(Строка(СтароеИмя));
	ИмяНовое = СокрЛП(Строка(НовоеИмя));
	Если ПустаяСтрока(Текст) Или ПустаяСтрока(ИмяСтарое) Или ПустаяСтрока(ИмяНовое) Тогда
		Возврат Текст;
	КонецЕсли;
	Результат = "";
	ВКавычках = Ложь;
	Индекс = 1;
	ДлинаИмени = СтрДлина(ИмяСтарое);
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если НЕ ВКавычках И ВРег(Сред(Текст, Индекс, ДлинаИмени)) = ВРег(ИмяСтарое) Тогда
			СимволДо = ?(Индекс = 1, "", Сред(Текст, Индекс - 1, 1));
			СимволПосле = Сред(Текст, Индекс + ДлинаИмени, 1);
			Если СимволДо <> "." И СимволПосле <> "("
				И НЕ ЭтоСимволИдентификатораЗапроса(СимволДо) И НЕ ЭтоСимволИдентификатораЗапроса(СимволПосле) Тогда
				Результат = Результат + ИмяНовое;
				Индекс = Индекс + ДлинаИмени;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗаменитьИдентификаторВТекстеЗапроса(ТекстЗапроса, СтароеИмя, НовоеИмя)
	Текст = Строка(ТекстЗапроса);
	ИмяСтарое = СокрЛП(Строка(СтароеИмя));
	ИмяНовое = СокрЛП(Строка(НовоеИмя));
	Если ПустаяСтрока(Текст) Или ПустаяСтрока(ИмяСтарое) Или ПустаяСтрока(ИмяНовое) Тогда
		Возврат Текст;
	КонецЕсли;
	Результат = "";
	ВКавычках = Ложь;
	Индекс = 1;
	ДлинаИмени = СтрДлина(ИмяСтарое);
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если НЕ ВКавычках И ВРег(Сред(Текст, Индекс, ДлинаИмени)) = ВРег(ИмяСтарое) Тогда
			СимволДо = ?(Индекс = 1, "", Сред(Текст, Индекс - 1, 1));
			СимволПосле = Сред(Текст, Индекс + ДлинаИмени, 1);
			Если СимволПосле = "(" Тогда
				Результат = Результат + Символ;
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Если НЕ ЭтоСимволИдентификатораЗапроса(СимволДо) И НЕ ЭтоСимволИдентификатораЗапроса(СимволПосле) Тогда
				Результат = Результат + ИмяНовое;
				Индекс = Индекс + ДлинаИмени;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат = Результат + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоСимволИдентификатораЗапроса(Символ)
	Если ПустаяСтрока(Строка(Символ)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ);
	Если Код >= 48 И Код <= 57 Тогда
		Возврат Истина;
	КонецЕсли;
	Если (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122) Тогда
		Возврат Истина;
	КонецЕсли;
	Если (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Символ = "_";
КонецФункции

Функция ВыбратьЛучшееПолеПоWhitelistЛокально(ИсходноеПоле, Whitelist)
	ЛучшееПоле = "";
	ЛучшаяОценка = -1;
	Для Каждого Кандидат Из Whitelist Цикл
		Оценка = ОценитьПохожестьПоля(ИсходноеПоле, Кандидат);
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшееПоле = Строка(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат ЛучшееПоле;
КонецФункции

Функция НормализоватьПолеДляЗапросаПоWhitelist(ИмяПоля, Whitelist)
	Поле = СокрЛП(Строка(ИмяПоля));
	Если СтрДлина(Поле) > 3 И ВРег(Прав(Поле, 3)) = "ИНТ" Тогда
		БазовоеПоле = Лев(Поле, СтрДлина(Поле) - 3);
		Если ПолеЕстьВWhitelistЛокально(Whitelist, БазовоеПоле) Тогда
			Возврат БазовоеПоле;
		КонецЕсли;
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция НормализоватьИмяСправочникаПоРоли(ИмяОбъекта)
	Имя = СокрЛП(Строка(ИмяОбъекта));
	ИмяВРег = ВРег(Имя);
	Если (ИмяВРег = "ПОСТАВЩИКИ"
		ИЛИ ИмяВРег = "ПОКУПАТЕЛИ"
		ИЛИ ИмяВРег = "КЛИЕНТЫ"
		ИЛИ ИмяВРег = "ПОСТАВЩИК"
		ИЛИ ИмяВРег = "ПОКУПАТЕЛЬ"
		ИЛИ ИмяВРег = "КЛИЕНТ"
		ИЛИ СтрНайти(ИмяВРег, "ПОСТАВЩИК") > 0
		ИЛИ СтрНайти(ИмяВРег, "ПОКУПАТЕЛ") > 0
		ИЛИ СтрНайти(ИмяВРег, "КЛИЕНТ") > 0)
		И ИИА_Метаданные.СуществуетСправочник("Контрагенты") Тогда
		Возврат "Контрагенты";
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция ЭтоОбщееИмяТипаМетаданных(ИмяОбъекта)
	ИмяВРег = ВРег(СокрЛП(Строка(ИмяОбъекта)));
	Возврат ПустаяСтрока(ИмяВРег)
		ИЛИ ИмяВРег = "СПРАВОЧНИК"
		ИЛИ ИмяВРег = "ДОКУМЕНТ"
		ИЛИ ИмяВРег = "РЕГИСТРНАКОПЛЕНИЯ"
		ИЛИ ИмяВРег = "РЕГИСТРСВЕДЕНИЙ";
КонецФункции

Функция ОпределитьИмяСправочникаДляFindReference(ШагПлана, ИмяОбъекта)
	Имя = СокрЛП(Строка(ИмяОбъекта));
	Если НЕ ЭтоОбщееИмяТипаМетаданных(Имя) Тогда
		Возврат Имя;
	КонецЕсли;

	ТекстРоли = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "role", "")) + " "
		+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "title", "")) + " "
		+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "intent", "")) + " "
		+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "description", ""));

	ИмяПоРоли = НормализоватьИмяСправочникаПоРоли(ТекстРоли);
	Если НЕ ПустаяСтрока(ИмяПоРоли) И НЕ ЭтоОбщееИмяТипаМетаданных(ИмяПоРоли) Тогда
		Возврат ИмяПоРоли;
	КонецЕсли;

	Возврат Имя;
КонецФункции

Функция ПостроитьDSLПоискаДокументаПоНомеру(ПолноеИмяДокумента, НомерДокумента)
	Если ПустаяСтрока(ПолноеИмяДокумента) ИЛИ ПустаяСтрока(НомерДокумента) Тогда
		Возврат "";
	КонецЕсли;
	Если ВРег(Лев(СокрЛП(ПолноеИмяДокумента), СтрДлина("Документ."))) <> "ДОКУМЕНТ." Тогда
		Возврат "";
	КонецЕсли;

	Запрос = "ВЫБРАТЬ ПЕРВЫЕ 1" + Символы.ПС
		+ "Ссылка КАК Ссылка" + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ ПолноеИмяДокумента + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ "Номер = """ + ЭкранироватьСтрокуДляЗапроса(НомерДокумента) + """" + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО" + Символы.ПС
		+ "Дата УБЫВ";

	DSLСтруктура = Новый Структура;
	DSLСтруктура.Вставить("dsl_version", 2);
	ШагиDSL = Новый Массив;
	ШагЗапроса = Новый Структура;
	ШагЗапроса.Вставить("action", "RunQuery");
	ШагЗапроса.Вставить("query", Запрос);
	ШагиDSL.Добавить(ШагЗапроса);
	DSLСтруктура.Вставить("steps", ШагиDSL);
	Возврат СериализоватьJSONВСтроку(DSLСтруктура);
КонецФункции

Функция ПолеПохожеНаТехническийФлаг(ИмяПоля)
	ПолеВРег = ВРег(Строка(ИмяПоля));
	Возврат СтрНайти(ПолеВРег, "ВКЛЮЧАЕТ") > 0
		ИЛИ СтрНайти(ПолеВРег, "ПРИЗНАК") > 0
		ИЛИ СтрНайти(ПолеВРег, "ФЛАГ") > 0
		ИЛИ СтрНайти(ПолеВРег, "ИСПОЛЬЗОВАТЬ") > 0;
КонецФункции

Функция НормализоватьСемантическоеПолеПоWhitelist(ИсходноеПоле, ЛучшееПоле, Whitelist)
	ИсходноеВРег = ВРег(Строка(ИсходноеПоле));
	ЛучшееВРег = ВРег(Строка(ЛучшееПоле));
	Если СтрНайти(ИсходноеВРег, "СУММ") > 0
		И (ПустаяСтрока(ЛучшееПоле)
			ИЛИ ПолеПохожеНаТехническийФлаг(ЛучшееПоле)
			ИЛИ СтрНайти(ЛучшееВРег, "СУММ") = 0) Тогда
		СуммовоеПоле = ВыбратьСуммовоеПолеИзПолей(Whitelist);
		Если НЕ ПустаяСтрока(СуммовоеПоле)
			И СтрНайти(ВРег(СуммовоеПоле), "СУММ") > 0
			И НЕ ПолеПохожеНаТехническийФлаг(СуммовоеПоле) Тогда
			Возврат СуммовоеПоле;
		КонецЕсли;
	КонецЕсли;
	Возврат ЛучшееПоле;
КонецФункции

Функция НормализоватьПоляШагаПоМетаданным(ПолноеИмяОбъекта, Поля)
	Если НЕ ЭтоМассивоподобноеЗначение(Поля) Тогда
		Возврат Поля;
	КонецЕсли;
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если Whitelist.Количество() = 0 Тогда
		Возврат Поля;
	КонецЕсли;
	НовыеПоля = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ЛучшееПоле = ИмяПоля;
		ЛучшаяОценка = -1;
		Для Каждого Кандидат Из Whitelist Цикл
			Оценка = ОценитьПохожестьПоля(ИмяПоля, Кандидат);
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееПоле = Строка(Кандидат);
			КонецЕсли;
		КонецЦикла;
		ЛучшееПоле = НормализоватьПолеДляЗапросаПоWhitelist(ЛучшееПоле, Whitelist);
		ЛучшееПоле = НормализоватьСемантическоеПолеПоWhitelist(ИмяПоля, ЛучшееПоле, Whitelist);
		Если ЛучшаяОценка < 8 И НЕ ПолеЕстьВWhitelistЛокально(Whitelist, ЛучшееПоле) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ЛучшееПоле) И НовыеПоля.Найти(ЛучшееПоле) = Неопределено Тогда
			НовыеПоля.Добавить(ЛучшееПоле);
		КонецЕсли;
	КонецЦикла;
	Возврат НовыеПоля;
КонецФункции

Функция НормализоватьСтруктуруФильтраПоМетаданным(ПолноеИмяОбъекта, Фильтр)
	Если Фильтр = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если Whitelist.Количество() = 0 Тогда
		Возврат Фильтр;
	КонецЕсли;
	Если ТипЗнч(Фильтр) = Тип("Структура") ИЛИ ТипЗнч(Фильтр) = Тип("ФиксированнаяСтруктура") Тогда
		НовыйФильтр = Новый Структура;
		Для Каждого Пара Из Фильтр Цикл
			ИмяПоля = Строка(Пара.Ключ);
			ИмяПоляВРег = ВРег(ИмяПоля);
			Если ИмяПоляВРег = "CLIENT_NAME" ИЛИ ИмяПоляВРег = "CUSTOMER_NAME" Тогда
				ПолеКлиента = ?(ПолеЕстьВWhitelistЛокально(Whitelist, "Контрагент"), "Контрагент", "");
				Если ПустаяСтрока(ПолеКлиента) И ПолеЕстьВWhitelistЛокально(Whitelist, "Партнер") Тогда
					ПолеКлиента = "Партнер";
				КонецЕсли;
				Если НЕ ПустаяСтрока(ПолеКлиента) Тогда
					НовыйФильтр.Вставить(ПолеКлиента, Пара.Значение);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "DATE_RANGE" ИЛИ ИмяПоляВРег = "PERIOD_RANGE" Тогда
				ТекстПериода = Строка(Пара.Значение);
				Если ВРег(ТекстПериода) = "LAST_WEEK" Тогда
					ТекстПериода = "прошлая неделя";
				КонецЕсли;
				НовыйФильтр.Вставить("Период", ТекстПериода);
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "USE_DOCUMENT_DATE_FIELD" ИЛИ ИмяПоляВРег = "ONLY_POSTED" Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоСлужебныйКлючФильтраЗапроса(ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "ПЕРИОД" ИЛИ ИмяПоляВРег = "PERIOD" Тогда
				НовыйФильтр.Вставить("Период", Пара.Значение);
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "ДАТА" ИЛИ ИмяПоляВРег = "DATE" Тогда
				НовыйФильтр.Вставить("Дата", Пара.Значение);
				Продолжить;
			КонецЕсли;
			Если ПолеЕстьВWhitelistЛокально(Whitelist, ИмяПоля) Тогда
				НовыйФильтр.Вставить(ИмяПоля, Пара.Значение);
			Иначе
				ЗаменаПоля = ВыбратьЛучшееПолеПоWhitelistЛокально(ИмяПоля, Whitelist);
				Если ПустаяСтрока(ЗаменаПоля) Тогда
					НовыйФильтр.Вставить(ИмяПоля, Пара.Значение);
				Иначе
					НовыйФильтр.Вставить(ЗаменаПоля, Пара.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат НовыйФильтр;
	КонецЕсли;
	Если ТипЗнч(Фильтр) = Тип("Соответствие") Или ТипЗнч(Фильтр) = Тип("ФиксированноеСоответствие") Тогда
		НовыйФильтр = Новый Структура;
		Для Каждого Пара Из Фильтр Цикл
			ИмяПоля = Строка(Пара.Ключ);
			ИмяПоляВРег = ВРег(ИмяПоля);
			Если ИмяПоляВРег = "CLIENT_NAME" ИЛИ ИмяПоляВРег = "CUSTOMER_NAME" Тогда
				ПолеКлиента = ?(ПолеЕстьВWhitelistЛокально(Whitelist, "Контрагент"), "Контрагент", "");
				Если ПустаяСтрока(ПолеКлиента) И ПолеЕстьВWhitelistЛокально(Whitelist, "Партнер") Тогда
					ПолеКлиента = "Партнер";
				КонецЕсли;
				Если НЕ ПустаяСтрока(ПолеКлиента) Тогда
					НовыйФильтр.Вставить(ПолеКлиента, Пара.Значение);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "DATE_RANGE" ИЛИ ИмяПоляВРег = "PERIOD_RANGE" Тогда
				ТекстПериода = Строка(Пара.Значение);
				Если ВРег(ТекстПериода) = "LAST_WEEK" Тогда
					ТекстПериода = "прошлая неделя";
				КонецЕсли;
				НовыйФильтр.Вставить("Период", ТекстПериода);
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "USE_DOCUMENT_DATE_FIELD" ИЛИ ИмяПоляВРег = "ONLY_POSTED" Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоСлужебныйКлючФильтраЗапроса(ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "ПЕРИОД" ИЛИ ИмяПоляВРег = "PERIOD" Тогда
				НовыйФильтр.Вставить("Период", Пара.Значение);
				Продолжить;
			КонецЕсли;
			Если ИмяПоляВРег = "ДАТА" ИЛИ ИмяПоляВРег = "DATE" Тогда
				НовыйФильтр.Вставить("Дата", Пара.Значение);
				Продолжить;
			КонецЕсли;
			Если ПолеЕстьВWhitelistЛокально(Whitelist, ИмяПоля) Тогда
				НовыйФильтр.Вставить(ИмяПоля, Пара.Значение);
			Иначе
				ЗаменаПоля = ВыбратьЛучшееПолеПоWhitelistЛокально(ИмяПоля, Whitelist);
				Если ПустаяСтрока(ЗаменаПоля) Тогда
					НовыйФильтр.Вставить(ИмяПоля, Пара.Значение);
				Иначе
					НовыйФильтр.Вставить(ЗаменаПоля, Пара.Значение);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат НовыйФильтр;
	КонецЕсли;
	Если ТипЗнч(Фильтр) = Тип("Строка") Тогда
		Результат = Строка(Фильтр);
		Для Каждого Поле Из Whitelist Цикл
		КонецЦикла;
		Для Каждого Поле Из СтрРазделить(Результат, " ") Цикл
			ИмяПоля = СокрЛП(Строка(Поле));
			Если ПустаяСтрока(ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			Если ПолеЕстьВWhitelistЛокально(Whitelist, ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			ЗаменаПоля = ВыбратьЛучшееПолеПоWhitelistЛокально(ИмяПоля, Whitelist);
			Если ПустаяСтрока(ЗаменаПоля) ИЛИ ВРег(ЗаменаПоля) = ВРег(ИмяПоля) Тогда
				Продолжить;
			КонецЕсли;
			Результат = СтрЗаменить(Результат, ИмяПоля + " = ", ЗаменаПоля + " = ");
			Результат = СтрЗаменить(Результат, ИмяПоля + " < ", ЗаменаПоля + " < ");
			Результат = СтрЗаменить(Результат, ИмяПоля + " > ", ЗаменаПоля + " > ");
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Фильтр;
КонецФункции

Функция ВыбратьКоличественноеПолеИзПолей(Поля)
	Если НЕ ЭтоМассивоподобноеЗначение(Поля) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Поле Из Поля Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		ИмяПоляВРег = ВРег(ИмяПоля);
		Если СтрНайти(ИмяПоляВРег, "ОСТАТОК") > 0 ИЛИ СтрНайти(ИмяПоляВРег, "КОЛИЧЕСТВ") > 0 Тогда
			Возврат ИмяПоля;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ВыбратьСуммовоеПолеИзПолей(Поля)
	Если НЕ ЭтоМассивоподобноеЗначение(Поля) Тогда
		Возврат "";
	КонецЕсли;
	ЛучшееПоле = "";
	ЛучшаяОценка = -1;
	Для Каждого Поле Из Поля Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		ИмяПоляВРег = ВРег(ИмяПоля);
		Если СтрНайти(ИмяПоляВРег, "СУММА") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Оценка = 10;
		Если ИмяПоляВРег = "СУММАДОКУМЕНТА" ИЛИ ИмяПоляВРег = "СУММА" Тогда
			Оценка = Оценка + 100;
		КонецЕсли;
		Если СтрНайти(ИмяПоляВРег, "ДОКУМЕНТ") > 0 ИЛИ СтрНайти(ИмяПоляВРег, "ИТОГ") > 0 Тогда
			Оценка = Оценка + 40;
		КонецЕсли;
		Если СтрНайти(ИмяПоляВРег, "ВКЛЮЧАЕТ") > 0 ИЛИ СтрНайти(ИмяПоляВРег, "ПРИЗНАК") > 0 ИЛИ СтрНайти(ИмяПоляВРег, "ФЛАГ") > 0 Тогда
			Оценка = Оценка - 100;
		КонецЕсли;
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшееПоле = ИмяПоля;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(ЛучшееПоле) И ЛучшаяОценка >= 0 Тогда
		Возврат ЛучшееПоле;
	КонецЕсли;
	Возврат ВыбратьКоличественноеПолеИзПолей(Поля);
КонецФункции

Функция НужноГруппироватьЗапросПоДнямИСумме(ТекстУсловия, Поля)
	Текст = ВРег(Строка(ТекстУсловия));
	Если СтрНайти(Текст, "ПО ДН") = 0 И СтрНайти(Текст, "ДЕНЬ") = 0 И СтрНайти(Текст, "ДНЯМ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(Текст, "СУММ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ПустаяСтрока(ВыбратьСуммовоеПолеИзПолей(Поля));
КонецФункции

Процедура ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, ИмяПоля)
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ПолеЕстьВWhitelistЛокально(Whitelist, ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	Если Поля.Найти(ИмяПоля) = Неопределено Тогда
		Поля.Добавить(ИмяПоля);
	КонецЕсли;
КонецПроцедуры

Функция ДополнитьПоляИзТекста(ПолноеИмяОбъекта, Поля, ТекстУсловия)
	Если НЕ ЭтоМассивоподобноеЗначение(Поля) Тогда
		Поля = Новый Массив;
	КонецЕсли;
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если Whitelist.Количество() = 0 Тогда
		Возврат Поля;
	КонецЕсли;
	ТекстВРег = ВРег(Строка(ТекстУсловия));
	Если СтрНайти(ТекстВРег, "НОМЕНКЛАТ") > 0 ИЛИ СтрНайти(ТекстВРег, "ТОВАР") > 0 Тогда
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Номенклатура");
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "ОСТАТОК") > 0 ИЛИ СтрНайти(ТекстВРег, "КОЛИЧЕСТ") > 0 Тогда
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Количество");
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "СУММ") > 0 Тогда
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "СуммаДокумента");
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Сумма");
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "КОНТРАГЕНТ") > 0
		ИЛИ СтрНайти(ТекстВРег, "КЛИЕНТ") > 0
		ИЛИ СтрНайти(ТекстВРег, "ПОКУПАТЕЛ") > 0 Тогда
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Контрагент");
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Партнер");
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Покупатель");
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Клиент");
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "СКЛАД") > 0 Тогда
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "Склад");
		ДобавитьПолеЕслиЕстьВWhitelist(Поля, Whitelist, "СтруктурнаяЕдиница");
	КонецЕсли;
	Возврат Поля;
КонецФункции

Функция ПреобразоватьМассивПараметровВФильтр(Параметры)
	Если НЕ ЭтоМассивоподобноеЗначение(Параметры) Тогда
		Возврат Параметры;
	КонецЕсли;
	Фильтр = Новый Структура;
	Для Каждого Параметр Из Параметры Цикл
		Имя = Строка(ПолучитьСвойствоИзСтруктуры(Параметр, "name", ""));
		Если ПустаяСтрока(Имя) Тогда
			Имя = Строка(ПолучитьСвойствоИзСтруктуры(Параметр, "key", ""));
		КонецЕсли;
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Фильтр.Вставить(Имя, ПолучитьСвойствоИзСтруктуры(Параметр, "value", ""));
	КонецЦикла;
	Возврат Фильтр;
КонецФункции

Функция ПреобразоватьПараметрыПериодаВФильтр(Параметры)
	Если НЕ (ТипЗнч(Параметры) = Тип("Структура")
		ИЛИ ТипЗнч(Параметры) = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗнч(Параметры) = Тип("Соответствие")
		ИЛИ ТипЗнч(Параметры) = Тип("ФиксированноеСоответствие")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДатаНачала = ПолучитьСвойствоИзСтруктуры(Параметры, "ДатаНачала", Неопределено);
	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = ПолучитьСвойствоИзСтруктуры(Параметры, "date_from", Неопределено);
	КонецЕсли;
	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = ПолучитьСвойствоИзСтруктуры(Параметры, "from", Неопределено);
	КонецЕсли;
	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = ПолучитьСвойствоИзСтруктуры(Параметры, "ДатаНач", Неопределено);
	КонецЕсли;
	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = ПолучитьСвойствоИзСтруктуры(Параметры, "start", Неопределено);
	КонецЕсли;
	ДатаОкончания = ПолучитьСвойствоИзСтруктуры(Параметры, "ДатаОкончания", Неопределено);
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ПолучитьСвойствоИзСтруктуры(Параметры, "date_to", Неопределено);
	КонецЕсли;
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ПолучитьСвойствоИзСтруктуры(Параметры, "to", Неопределено);
	КонецЕсли;
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ПолучитьСвойствоИзСтруктуры(Параметры, "ДатаКон", Неопределено);
	КонецЕсли;
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = ПолучитьСвойствоИзСтруктуры(Параметры, "end", Неопределено);
	КонецЕсли;
	Если ДатаНачала = Неопределено ИЛИ ДатаОкончания = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Период", Новый Структура("from,to", ДатаНачала, ДатаОкончания));
КонецФункции

Функция ЭтоСлужебныйКлючФильтраЗапроса(ИмяПоля)
	ИмяВРег = ВРег(Строка(ИмяПоля));
	Возврат ИмяВРег = "GROUP_BY"
		ИЛИ ИмяВРег = "MEASURE"
		ИЛИ ИмяВРег = "SORT"
		ИЛИ ИмяВРег = "ORDER"
		ИЛИ ИмяВРег = "LIMIT";
КонецФункции

Функция ИзвлечьПервоеЧислоИзТекста(Текст)
	СтрокаТекста = Строка(Текст);
	Буфер = "";
	Для Индекс = 1 По СтрДлина(СтрокаТекста) Цикл
		Символ = Сред(СтрокаТекста, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Буфер = Буфер + Символ;
		ИначеЕсли НЕ ПустаяСтрока(Буфер) Тогда
			Возврат Буфер;
		КонецЕсли;
	КонецЦикла;
	Возврат Буфер;
КонецФункции

Функция ДополнитьФильтрПорогомИзТекста(Фильтр, ТекстУсловия, Поля)
	ТекстВРег = ВРег(Строка(ТекстУсловия));
	Если СтрНайти(ТекстВРег, "МЕНЬШ") = 0 И СтрНайти(ТекстВРег, "<") = 0 Тогда
		Возврат Фильтр;
	КонецЕсли;
	ИмяПоля = ВыбратьКоличественноеПолеИзПолей(Поля);
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Фильтр;
	КонецЕсли;
	ЧислоСтрокой = ИзвлечьПервоеЧислоИзТекста(ТекстУсловия);
	Если ПустаяСтрока(ЧислоСтрокой) Тогда
		Возврат Фильтр;
	КонецЕсли;
	Если Фильтр = Неопределено ИЛИ НЕ (ТипЗнч(Фильтр) = Тип("Структура") ИЛИ ТипЗнч(Фильтр) = Тип("ФиксированнаяСтруктура") ИЛИ ТипЗнч(Фильтр) = Тип("Соответствие") ИЛИ ТипЗнч(Фильтр) = Тип("ФиксированноеСоответствие")) Тогда
		НовыйФильтр = Новый Структура;
	Иначе
		НовыйФильтр = Фильтр;
	КонецЕсли;
	Если ПолучитьСвойствоИзСтруктуры(НовыйФильтр, ИмяПоля, Неопределено) = Неопределено Тогда
		НовыйФильтр.Вставить(ИмяПоля, "< " + ЧислоСтрокой);
	КонецЕсли;
	Возврат НовыйФильтр;
КонецФункции

Функция ПостроитьСписокПолейДляЗапроса(ПолноеИмяОбъекта, Поля)
	Если НЕ ЭтоМассивоподобноеЗначение(Поля) Или Поля.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(ИмяПоля + " КАК " + ИмяПоля);
	КонецЦикла;
	
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ПолучитьВсеПоляДляЗапросаПоМетаданным(ПолноеИмяОбъекта)
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Поля = Новый Массив;
	Для Каждого Поле Из Whitelist Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если Поля.Найти(ИмяПоля) = Неопределено Тогда
			Поля.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;
КонецФункции

Функция ИзвлечьПервуюСтрокуВКавычках(Текст)
	СтрокаТекста = Строка(Текст);
	Для Индекс = 1 По СтрДлина(СтрокаТекста) Цикл
		Символ = Сред(СтрокаТекста, Индекс, 1);
		Если Символ <> """" И Символ <> "'" И Символ <> "«" Тогда
			Продолжить;
		КонецЕсли;
		Закрывающий = ?(Символ = "«", "»", Символ);
		Буфер = "";
		Для Индекс2 = Индекс + 1 По СтрДлина(СтрокаТекста) Цикл
			Символ2 = Сред(СтрокаТекста, Индекс2, 1);
			Если Символ2 = Закрывающий Тогда
				Возврат Буфер;
			КонецЕсли;
			Буфер = Буфер + Символ2;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НормализоватьЛитералыДатаВЗапросе(ТекстЗапроса)
	Результат = Строка(ТекстЗапроса);
	ПозицияПоиска = 1;
	Пока Истина Цикл
		ХвостВРег = ВРег(Сред(Результат, ПозицияПоиска));
		ПозицияЛок = СтрНайти(ХвостВРег, "ДАТА(");
		Если ПозицияЛок = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = ПозицияПоиска + ПозицияЛок - 1;
		КонецСкобки = 0;
		Для Индекс = Позиция + 5 По СтрДлина(Результат) Цикл
			Если Сред(Результат, Индекс, 1) = ")" Тогда
				КонецСкобки = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если КонецСкобки = 0 Тогда
			Прервать;
		КонецЕсли;
		Аргументы = Сред(Результат, Позиция + 5, КонецСкобки - Позиция - 5);
		Части = СтрРазделить(Аргументы, ",");
		Если Части.Количество() = 3 Тогда
			Замена = "ДАТАВРЕМЯ(" + СокрЛП(Строка(Части[0])) + ","
				+ СокрЛП(Строка(Части[1])) + ","
				+ СокрЛП(Строка(Части[2])) + ",0,0,0)";
			Результат = Лев(Результат, Позиция - 1) + Замена + Сред(Результат, КонецСкобки + 1);
			ПозицияПоиска = Позиция + СтрДлина(Замена);
		Иначе
			ПозицияПоиска = КонецСкобки + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолноеИмяОбъектаЭтоРегистрНакопления(ПолноеИмяОбъекта)
	Возврат ВРег(Лев(СокрЛП(Строка(ПолноеИмяОбъекта)), СтрДлина("РегистрНакопления."))) = "РЕГИСТРНАКОПЛЕНИЯ.";
КонецФункции

Функция ПолноеИмяОбъектаЭтоРегистрБухгалтерии(ПолноеИмяОбъекта)
	Возврат Лев(ВРег(СокрЛП(Строка(ПолноеИмяОбъекта))), СтрДлина("РЕГИСТРБУХГАЛТЕРИИ.")) = "РЕГИСТРБУХГАЛТЕРИИ.";
КонецФункции

Функция ЭтоПодходящийИсточникТоварныхОстатков(ПолноеИмяОбъекта)
	Если ПолноеИмяОбъектаЭтоРегистрБухгалтерии(ПолноеИмяОбъекта) Тогда
		Возврат Истина;
	КонецЕсли;
	Если НЕ ПолноеИмяОбъектаЭтоРегистрНакопления(ПолноеИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяВРег = ВРег(Строка(ПолноеИмяОбъекта));
	Если ЭтоСлужебныйРегистрТоварныхОстатков(ИмяВРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ИмяВРег, "ЗАПАС") > 0
		ИЛИ СтрНайти(ИмяВРег, "СКЛАД") > 0
		ИЛИ СтрНайти(ИмяВРег, "СВОБОДНЫЕОСТАТКИ") > 0
		ИЛИ СтрНайти(ИмяВРег, "ТОВАР") > 0;
КонецФункции

Функция ПостроитьЗапросТоварныхОстатковРегистраБухгалтерии(ПолноеИмяОбъекта, ТекстУсловия)
	Если НЕ ПолноеИмяОбъектаЭтоРегистрБухгалтерии(ПолноеИмяОбъекта)
		ИЛИ НЕ ТекстЗапрашиваетОстатки(ТекстУсловия) Тогда
		Возврат "";
	КонецЕсли;
	Разбор = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
	МетаданныеРегистра = Метаданные.РегистрыБухгалтерии.Найти(Разбор.ObjectName);
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ЕстьКоличество = Ложь;
	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		Если Ресурс.Имя = "Количество" Тогда
			ЕстьКоличество = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьКоличество Тогда
		Возврат "";
	КонецЕсли;
	КоличествоСтрок = ИзвлечьПервоеЧислоИзТекста(ТекстУсловия);
	Первые = ?(ПустаяСтрока(КоличествоСтрок), "", "ПЕРВЫЕ " + КоличествоСтрок + " ");
	Возврат "ВЫБРАТЬ " + Первые + Символы.ПС
		+ "Остатки.Субконто1 КАК Номенклатура, " + Символы.ПС
		+ "Остатки.КоличествоОстатокДт - Остатки.КоличествоОстатокКт КАК Остаток" + Символы.ПС
		+ "ИЗ " + ПолноеИмяОбъекта + ".Остатки КАК Остатки" + Символы.ПС
		+ "ГДЕ Остатки.Субконто1 ССЫЛКА Справочник.Номенклатура" + Символы.ПС
		+ "И Остатки.КоличествоОстатокДт - Остатки.КоличествоОстатокКт <> 0";
КонецФункции

Функция НайтиПодходящийРегистрБухгалтерииДляТоварныхОстатков() Экспорт
	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеРегистра Из Метаданные.РегистрыБухгалтерии Цикл
			ЕстьКоличество = Ложь;
			Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
				Если Ресурс.Имя = "Количество" Тогда
					ЕстьКоличество = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ЕстьКоличество Тогда
				Продолжить;
			КонецЕсли;
			ТекстРегистра = ВРег(Строка(МетаданныеРегистра.Имя) + " " + Строка(МетаданныеРегистра.Синоним));
			Оценка = 10;
			Если СтрНайти(ТекстРегистра, "ХОЗРАСЧЕТ") > 0
				Или СтрНайти(ТекстРегистра, "БУХГАЛТЕР") > 0 Тогда
				Оценка = Оценка + 50;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = "РегистрБухгалтерии." + МетаданныеРегистра.Имя;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ЛучшееИмя;
КонецФункции

Функция ТекстЗапрашиваетОстатки(ТекстУсловия)
	Текст = ВРег(Строка(ТекстУсловия));
	Возврат СтрНайти(Текст, "ОСТАТОК") > 0
		ИЛИ СтрНайти(Текст, "ОСТАТК") > 0;
КонецФункции

Функция ПолучитьТекстПоследнейЗадачиДиалога(СсылкаДиалога)

	Если СсылкаДиалога = Неопределено Или НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ПоследняяЗадача = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(СсылкаДиалога);
		Если ПоследняяЗадача <> Неопределено
			И ПоследняяЗадача.Свойство("Найдено")
			И ПоследняяЗадача.Найдено
			И ПоследняяЗадача.Свойство("Текст") Тогда
			Возврат Строка(ПоследняяЗадача.Текст);
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

Функция ПостроитьЗапросОстатковРегистраНакопления(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловия)
	Если НЕ ПолноеИмяОбъектаЭтоРегистрНакопления(ПолноеИмяОбъекта)
		ИЛИ НЕ ТекстЗапрашиваетОстатки(ТекстУсловия) Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ РегистрНакопленияПоддерживаетОстаткиПоПолномуИмени(ПолноеИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если Whitelist.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ЕстьНоменклатура = ПолеЕстьВWhitelistЛокально(Whitelist, "Номенклатура");
	ЕстьКоличество = ПолеЕстьВWhitelistЛокально(Whitelist, "Количество");
	Если НЕ ЕстьКоличество Тогда
		Возврат "";
	КонецЕсли;
	Выборка = Новый Массив;
	Если ЕстьНоменклатура Тогда
		Выборка.Добавить("Номенклатура КАК Номенклатура");
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "СтруктурнаяЕдиница") Тогда
		Выборка.Добавить("СтруктурнаяЕдиница КАК СтруктурнаяЕдиница");
	КонецЕсли;
	Выборка.Добавить("КоличествоОстаток КАК Остаток");
	Условия = Новый Массив;
	КоличествоСтрок = ИзвлечьПервоеЧислоИзТекста(ТекстУсловия);
	ТекстУсловияВРег = ВРег(Строка(ТекстУсловия));
	Порог = КоличествоСтрок;
	ЕстьСравнениеМеньше = СтрНайти(ТекстУсловияВРег, "МЕНЬШ") > 0
		Или СтрНайти(ТекстУсловия, "<=") > 0
		Или (СтрНайти(ТекстУсловия, "<") > 0 И СтрНайти(ТекстУсловия, "<>") = 0);
	Если НЕ ПустаяСтрока(Порог) И ЕстьСравнениеМеньше Тогда
		Условия.Добавить("КоличествоОстаток < " + Порог);
	КонецЕсли;
	Если СтрНайти(ТекстУсловияВРег, "НЕНУЛ") > 0
		Или СтрНайти(ТекстУсловия, "<> 0") > 0
		Или СтрНайти(ТекстУсловия, "<>0") > 0 Тогда
		Условия.Добавить("КоличествоОстаток <> 0");
	КонецЕсли;
	Если ПолеЕстьВWhitelistЛокально(Whitelist, "СтруктурнаяЕдиница")
		И СтрНайти(ВРег(ТекстУсловия), "СКЛАД") > 0 Тогда
		ЗначениеСклада = ИзвлечьПервуюСтрокуВКавычках(ТекстУсловия);
		Если НЕ ПустаяСтрока(ЗначениеСклада) Тогда
			Условия.Добавить("СтруктурнаяЕдиница.Наименование ПОДОБНО ""%" + ЭкранироватьСтрокуДляЗапроса(ЗначениеСклада) + "%""");
		КонецЕсли;
	КонецЕсли;
	Первые = "";
	Если СтрНайти(ТекстУсловияВРег, "ПЕРВЫЕ") > 0 И НЕ ПустаяСтрока(КоличествоСтрок) Тогда
		Первые = "ПЕРВЫЕ " + КоличествоСтрок + " ";
	КонецЕсли;
	Текст = "ВЫБРАТЬ " + Первые + СтрСоединить(Выборка, ", ") + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ ПолноеИмяОбъекта + ".Остатки";
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + СтрСоединить(Условия, Символы.ПС + "И ");
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция НайтиИсточникТоварныхОстатков() Экспорт
	РегистрОстатков = НайтиПодходящийРегистрНакопленияДляОстатков();
	Если НЕ ПустаяСтрока(РегистрОстатков) Тогда
		Возврат РегистрОстатков;
	КонецЕсли;
	Возврат НайтиПодходящийРегистрБухгалтерииДляТоварныхОстатков();
КонецФункции

Функция НайтиИсточникПродаж() Экспорт
	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеРегистра Из Метаданные.РегистрыНакопления Цикл
			ИмяРегистра = МетаданныеРегистра.Имя;
			ТекстРегистра = ВРег(Строка(ИмяРегистра) + " " + Строка(МетаданныеРегистра.Синоним));
			Если СтрНайти(ТекстРегистра, "ПРОДАЖ") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(ТекстРегистра, "НДС") > 0
				Или СтрНайти(ТекстРегистра, "ПЛАН") > 0
				Или СтрНайти(ТекстРегистра, "КНИГ") > 0
				Или СтрНайти(ТекстРегистра, "МП") > 0
				Или СтрНайти(ТекстРегистра, "ВЫПУСК") > 0
				Или СтрНайти(ТекстРегистра, "ПРОИЗВОДСТВ") > 0
				Или СтрНайти(ТекстРегистра, "ПОДАННЫМ") > 0 Тогда
				Продолжить;
			КонецЕсли;
			ПолноеИмя = "РегистрНакопления." + ИмяРегистра;
			Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмя);
			ЕстьСумма = ПолеЕстьВWhitelistЛокально(Whitelist, "Сумма")
				Или ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаОборот")
				Или ПолеЕстьВWhitelistЛокально(Whitelist, "СуммаДокумента");
			ЕстьТовар = ПолеЕстьВWhitelistЛокально(Whitelist, "Номенклатура")
				Или ПолеЕстьВWhitelistЛокально(Whitelist, "НоменклатурнаяГруппа");
			Если НЕ ЕстьСумма Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЕстьТовар И ВРег(ИмяРегистра) <> "ПРОДАЖИ" Тогда
				Продолжить;
			КонецЕсли;
			Оценка = 20;
			Если ВРег(ИмяРегистра) = "ПРОДАЖИ" Тогда
				Оценка = Оценка + 40;
			КонецЕсли;
			Если ПолеЕстьВWhitelistЛокально(Whitelist, "Контрагент") Тогда
				Оценка = Оценка + 10;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = ПолноеИмя;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЛучшееИмя = "";
	КонецПопытки;
	Если НЕ ПустаяСтрока(ЛучшееИмя) Тогда
		Возврат ЛучшееИмя;
	КонецЕсли;
	Возврат НайтиДокументПродажПоМаркерам();
КонецФункции

Функция НайтиДокументПродажПоМаркерам() Экспорт
	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			Текст = ВРег(Строка(МетаданныеДокумента.Имя) + " " + Строка(МетаданныеДокумента.Синоним));
			Если СтрНайти(Текст, "КОРРЕКТИРОВКА") > 0
				Или СтрНайти(Текст, "ДОПЛИСТ") > 0
				Или СтрНайти(Текст, "КНИГА") > 0
				Или СтрНайти(Текст, "НДС") > 0
				Или СтрНайти(Текст, "СЧЕТФАКТУР") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Оценка = 0;
			Если СтрНайти(Текст, "РЕАЛИЗАЦ") > 0 Тогда
				Оценка = Оценка + 30;
			КонецЕсли;
			Если СтрНайти(Текст, "РАСХОДНАЯНАКЛАД") > 0 Или СтрНайти(Текст, "РАСХОДНАЯ НАКЛАД") > 0 Тогда
				Оценка = Оценка + 35;
			КонецЕсли;
			Если Оценка <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(Текст, "ОТГРУЖЕНН") > 0 Тогда
				Оценка = Оценка - 10;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = МетаданныеДокумента.ПолноеИмя();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ЛучшееИмя;
КонецФункции

Функция НайтиДокументПоступленияТоваров() Экспорт
	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			Текст = ВРег(Строка(МетаданныеДокумента.Имя) + " " + Строка(МетаданныеДокумента.Синоним));
			Если СтрНайти(Текст, "КОРРЕКТИРОВКА") > 0
				Или СтрНайти(Текст, "НДС") > 0
				Или СтрНайти(Текст, "СЧЕТФАКТУР") > 0
				Или СтрНайти(Текст, "РЕЕСТР") > 0
				Или СтрНайти(Текст, "КНИГА") > 0
				Или СтрНайти(Текст, "КАСС") > 0
				Или СтрНайти(Текст, "ОРДЕР") > 0
				Или СтрНайти(Текст, "ДЕНЕЖН") > 0
				Или СтрНайти(Текст, "БАНК") > 0
				Или СтрНайти(Текст, "ПЛАТЕЖ") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Оценка = 0;
			Если СтрНайти(Текст, "ПОСТУПЛЕН") > 0 Тогда
				Оценка = Оценка + 35;
			КонецЕсли;
			Если СтрНайти(Текст, "ПРИХОДН") > 0 И (СтрНайти(Текст, "НАКЛАД") > 0 Или СтрНайти(Текст, "ТОВАР") > 0) Тогда
				Оценка = Оценка + 40;
			КонецЕсли;
			Если СтрНайти(Текст, "НАКЛАД") > 0 И СтрНайти(Текст, "РАСХОДН") = 0 Тогда
				Оценка = Оценка + 15;
			КонецЕсли;
			Если Оценка <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = МетаданныеДокумента.ПолноеИмя();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ЛучшееИмя;
КонецФункции

Функция ЭтоСлужебныйРегистрТоварныхОстатков(ТекстРегистра)
	Текст = ВРег(Строка(ТекстРегистра));
	Возврат СтрНайти(Текст, "НДС") > 0
		Или СтрНайти(Текст, "ПРОСЛЕЖИВ") > 0
		Или СтрНайти(Текст, "ЕГАИС") > 0
		Или СтрНайти(Текст, "ЗЕРНО") > 0
		Или СтрНайти(Текст, "САТУРН") > 0
		Или СтрНайти(Текст, "МАРКИР") > 0
		Или СтрНайти(Текст, "КОМИТЕНТ") > 0;
КонецФункции

Функция НайтиПодходящийРегистрНакопленияДляОстатков() Экспорт

	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеРегистра Из Метаданные.РегистрыНакопления Цикл
			Если НЕ РегистрНакопленияПоддерживаетОстатки(МетаданныеРегистра) Тогда
				Продолжить;
			КонецЕсли;
			ИмяРегистра = МетаданныеРегистра.Имя;
			ТекстРегистра = ВРег(Строка(ИмяРегистра) + " " + Строка(МетаданныеРегистра.Синоним));
			Если ЭтоСлужебныйРегистрТоварныхОстатков(ТекстРегистра) Тогда
				Продолжить;
			КонецЕсли;
			ЕстьСкладскойПризнак = СтрНайти(ТекстРегистра, "ЗАПАС") > 0
				Или СтрНайти(ТекстРегистра, "СКЛАД") > 0
				Или СтрНайти(ТекстРегистра, "ТОВАР") > 0
				Или СтрНайти(ТекстРегистра, "ОСТАТ") > 0;
			Если НЕ ЕстьСкладскойПризнак Тогда
				Продолжить;
			КонецЕсли;
			ПолноеИмя = "РегистрНакопления." + ИмяРегистра;
			Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмя);
			Если Whitelist.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ЕстьНоменклатура = ПолеЕстьВWhitelistЛокально(Whitelist, "Номенклатура");
			ЕстьКоличество = ПолеЕстьВWhitelistЛокально(Whitelist, "Количество");
			Если НЕ ЕстьНоменклатура Или НЕ ЕстьКоличество Тогда
				Продолжить;
			КонецЕсли;
			Оценка = 10;
			Если СтрНайти(ТекстРегистра, "ЗАПАС") > 0 Тогда
				Оценка = Оценка + 15;
			КонецЕсли;
			Если СтрНайти(ТекстРегистра, "СКЛАД") > 0 Тогда
				Оценка = Оценка + 25;
			КонецЕсли;
			Если СтрНайти(ТекстРегистра, "ТОВАР") > 0 Тогда
				Оценка = Оценка + 10;
			КонецЕсли;
			Если СтрНайти(ТекстРегистра, "НАСКЛАДАХ") > 0
				Или СтрНайти(ТекстРегистра, "НА СКЛАДАХ") > 0 Тогда
				Оценка = Оценка + 30;
			КонецЕсли;
			Если СтрНайти(ТекстРегистра, "КПОСТУПЛЕНИ") > 0
				Или СтрНайти(ТекстРегистра, "КРАСХОД") > 0
				Или СтрНайти(ТекстРегистра, "ПЕРЕДАН") > 0
				Или СтрНайти(ТекстРегистра, "ПРИНЯТ") > 0
				Или СтрНайти(ТекстРегистра, "РЕМОНТ") > 0
				Или СтрНайти(ТекстРегистра, "РЕЗЕРВ") > 0
				Или СтрНайти(ТекстРегистра, "ПОТРЕБНОСТ") > 0
				Или СтрНайти(ТекстРегистра, "ГТД") > 0 Тогда
				Оценка = Оценка - 40;
			КонецЕсли;
			Если ПолеЕстьВWhitelistЛокально(Whitelist, "Склад")
				Или ПолеЕстьВWhitelistЛокально(Whitelist, "СтруктурнаяЕдиница") Тогда
				Оценка = Оценка + 20;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = ПолноеИмя;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ЛучшееИмя;

КонецФункции

Функция РегистрНакопленияПоддерживаетОстаткиПоПолномуИмени(ПолноеИмяОбъекта)

	Разбор = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
	Если Разбор.ObjectType <> "РегистрНакопления" Или ПустаяСтрока(Разбор.ObjectName) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Для Каждого МетаданныеРегистра Из Метаданные.РегистрыНакопления Цикл
			Если МетаданныеРегистра.Имя = Разбор.ObjectName Тогда
				Возврат РегистрНакопленияПоддерживаетОстатки(МетаданныеРегистра);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

Функция РегистрНакопленияПоддерживаетОстатки(МетаданныеРегистра)

	Если МетаданныеРегистра = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ВидРегистра = ВРег(Строка(МетаданныеРегистра.ВидРегистра));
		Возврат СтрНайти(ВидРегистра, "ОСТАТ") > 0;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция ПолеПохожеНаСтроковоеЗначение(ИмяПоля)
	ИмяПоляВРег = ВРег(Строка(ИмяПоля));
	Возврат ИмяПоляВРег = "НАИМЕНОВАНИЕ"
		ИЛИ ИмяПоляВРег = "НОМЕР"
		ИЛИ ИмяПоляВРег = "КОД"
		ИЛИ СтрНайти(ИмяПоляВРег, "КОММЕНТАР") > 0
		ИЛИ СтрНайти(ИмяПоляВРег, "ОПИСАН") > 0
		ИЛИ СтрНайти(ИмяПоляВРег, "ПРЕДСТАВЛЕН") > 0;
КонецФункции

Функция ПостроитьСтроковоеУсловиеЗапроса(ИмяПоля, ЗначениеФильтра)
	СтрокаФильтра = СокрЛП(Строка(ЗначениеФильтра));
	Если ПустаяСтрока(СтрокаФильтра) Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(СтрокаФильтра, 1) = "<" И НЕ ПустаяСтрока(СокрЛП(Сред(СтрокаФильтра, 2))) Тогда
		Возврат ИмяПоля + " < " + СокрЛП(Сред(СтрокаФильтра, 2));
	КонецЕсли;
	Если Лев(СтрокаФильтра, 1) = ">" И НЕ ПустаяСтрока(СокрЛП(Сред(СтрокаФильтра, 2))) Тогда
		Возврат ИмяПоля + " > " + СокрЛП(Сред(СтрокаФильтра, 2));
	КонецЕсли;
	Если ПолеПохожеНаСтроковоеЗначение(ИмяПоля) Тогда
		Возврат ИмяПоля + " ПОДОБНО ""%" + ЭкранироватьСтрокуДляЗапроса(СтрокаФильтра) + "%""";
	КонецЕсли;
	Если СтрНайти(ВРег(Строка(ИмяПоля)), "КОНТАКТНОЕЛИЦО") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИмяПоля + ".Наименование ПОДОБНО ""%" + ЭкранироватьСтрокуДляЗапроса(СтрокаФильтра) + "%""";
КонецФункции

Функция НормализоватьСтроковыйФильтрДляЗапроса(Знач ИсходныйФильтр)
	Фильтр = СокрЛП(Строка(ИсходныйФильтр));
	Если ПустаяСтрока(Фильтр) Тогда
		Возврат "";
	КонецЕсли;
	
	Фильтр = СтрЗаменить(Фильтр, "Объект.", "");
	Фильтр = СтрЗаменить(Фильтр, "объект.", "");
	Фильтр = СтрЗаменить(Фильтр, "'", """");
	Фильтр = СтрЗаменить(Фильтр, "по дате ", "");
	Фильтр = СтрЗаменить(Фильтр, "По дате ", "");
	Фильтр = СтрЗаменить(Фильтр, "ПО ДАТЕ ", "");
	Фильтр = НормализоватьПлейсхолдерыПериодаВТекстеЗапроса(Фильтр);
	ФильтрВРег = ВРег(СтрЗаменить(СтрЗаменить(Фильтр, Символы.ПС, " "), Символы.Таб, " "));
	Если СтрНайти(ФильтрВРег, "=") > 0 Тогда
		ЧастиРавенства = СтрРазделить(Фильтр, "=");
		Если ЧастиРавенства.Количество() = 2 Тогда
			ЛеваяЧасть = СокрЛП(Строка(ЧастиРавенства[0]));
			ПраваяЧасть = СокрЛП(Строка(ЧастиРавенства[1]));
			Если (ВРег(ЛеваяЧасть) = "ПЕРИОД" ИЛИ ВРег(ЛеваяЧасть) = "ДАТА") И НЕ ПустаяСтрока(ПраваяЧасть) Тогда
				ГраницыЯвногоПериода = ПолучитьГраницыПериодаИзТекста(ПраваяЧасть);
				Если ГраницыЯвногоПериода.Начало <> Неопределено И ГраницыЯвногоПериода.Конец <> Неопределено Тогда
					Возврат "Дата МЕЖДУ " + ПостроитьЛитералДаты1С(ГраницыЯвногоПериода.Начало) + " И " + ПостроитьЛитералДаты1С(ГраницыЯвногоПериода.Конец);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(Фильтр, "=") = 0
		И СтрНайти(Фильтр, ">") = 0
		И СтрНайти(Фильтр, "<") = 0
		И СтрНайти(ВРег(Фильтр), " МЕЖДУ ") = 0
		И СтрНайти(ВРег(Фильтр), " ПОДОБНО ") = 0 Тогда
		Границы = ПолучитьГраницыПериодаИзТекста(Фильтр);
		Если Границы.Начало <> Неопределено И Границы.Конец <> Неопределено Тогда
			Возврат "Дата МЕЖДУ " + ПостроитьЛитералДаты1С(Границы.Начало) + " И " + ПостроитьЛитералДаты1С(Границы.Конец);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Фильтр;
КонецФункции

Функция ВыбратьПолеПериодаПоWhitelist(ПолноеИмяОбъекта)
	Whitelist = ПолучитьWhitelistПолейОбъектаЛокально(ПолноеИмяОбъекта);
	Если Whitelist.Количество() = 0 Тогда
		Возврат "Дата";
	КонецЕсли;
	ЛучшееПоле = "";
	ЛучшаяОценка = -1;
	Для Каждого Поле Из Whitelist Цикл
		ИмяПоля = Строка(Поле);
		ИмяПоляВРег = ВРег(ИмяПоля);
		Оценка = 0;
		Если ИмяПоляВРег = "ДАТА" Тогда
			Оценка = Оценка + 100;
		КонецЕсли;
		Если ИмяПоляВРег = "ПЕРИОД" Тогда
			Оценка = Оценка + 95;
		КонецЕсли;
		Если СтрНайти(ИмяПоляВРег, "ДАТ") > 0 Тогда
			Оценка = Оценка + 40;
		КонецЕсли;
		Если СтрНайти(ИмяПоляВРег, "ПЕРИОД") > 0 Тогда
			Оценка = Оценка + 35;
		КонецЕсли;
		Если СтрНайти(ИмяПоляВРег, "МОМЕНТ") > 0 Тогда
			Оценка = Оценка + 20;
		КонецЕсли;
		Если СтрНайти(ИмяПоляВРег, "TIME") > 0 ИЛИ СтрНайти(ИмяПоляВРег, "DATE") > 0 Тогда
			Оценка = Оценка + 10;
		КонецЕсли;
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшееПоле = ИмяПоля;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ЛучшееПоле) ИЛИ ЛучшаяОценка <= 0 Тогда
		Возврат ?(ПолноеИмяОбъектаЭтоРегистрНакопления(ПолноеИмяОбъекта), "Период", "Дата");
	КонецЕсли;
	Возврат ЛучшееПоле;
КонецФункции

Функция НормализоватьПолноеИмяОбъектаПоМетаданным(ПолноеИмяОбъекта)
	ИмяПолное = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(ИмяПолное) Тогда
		Возврат ИмяПолное;
	КонецЕсли;
	ИмяВРег = ВРег(ИмяПолное);
	СуффиксыВиртуальныхТаблиц = Новый Массив;
	СуффиксыВиртуальныхТаблиц.Добавить(".ОСТАТКИИОБОРОТЫ");
	СуффиксыВиртуальныхТаблиц.Добавить(".ОСТАТКИ");
	СуффиксыВиртуальныхТаблиц.Добавить(".ОБОРОТЫ");
	Для Каждого Суффикс Из СуффиксыВиртуальныхТаблиц Цикл
		Поз = СтрНайти(ИмяВРег, Суффикс);
		Если Поз > 0 Тогда
			ИмяПолное = Лев(ИмяПолное, Поз - 1);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(ИмяПолное, ".") = 0 Тогда
		Возврат ИмяПолное;
	КонецЕсли;
	Разбор = РазобратьПолноеИмяОбъекта(ИмяПолное);
	ТипОбъекта = ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(Разбор.ObjectType);
	ИмяОбъекта = Разбор.ObjectName;
	Если ПустаяСтрока(ТипОбъекта) ИЛИ ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат ИмяПолное;
	КонецЕсли;
	Если ТипОбъекта = "Документ" И ИИА_Метаданные.СуществуетДокумент(ИмяОбъекта) Тогда
		Возврат ТипОбъекта + "." + ИмяОбъекта;
	КонецЕсли;
	Если ТипОбъекта = "Справочник" И ИИА_Метаданные.СуществуетСправочник(ИмяОбъекта) Тогда
		Возврат ТипОбъекта + "." + ИмяОбъекта;
	КонецЕсли;
	Если ТипОбъекта = "РегистрНакопления" И ИИА_Метаданные.СуществуетРегистрНакопления(ИмяОбъекта) Тогда
		Возврат ТипОбъекта + "." + ИмяОбъекта;
	КонецЕсли;
	Если ТипОбъекта = "РегистрСведений" И ИИА_Метаданные.СуществуетРегистрСведений(ИмяОбъекта) Тогда
		Возврат ТипОбъекта + "." + ИмяОбъекта;
	КонецЕсли;
	Если ТипОбъекта = "РегистрБухгалтерии" И Метаданные.РегистрыБухгалтерии.Найти(ИмяОбъекта) <> Неопределено Тогда
		Возврат ТипОбъекта + "." + ИмяОбъекта;
	КонецЕсли;
	Возврат ТипОбъекта + "." + ИмяОбъекта;
КонецФункции

Функция ПостроитьУсловияЗапросаИзФильтра(ПолноеИмяОбъекта, Фильтр)
	Если Фильтр = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ПолеПериода = ВыбратьПолеПериодаПоWhitelist(ПолноеИмяОбъекта);
	
	Если ТипЗнч(Фильтр) = Тип("Строка") Тогда
		ТекстУсловия = НормализоватьСтроковыйФильтрДляЗапроса(Фильтр);
		Если НЕ ПустаяСтрока(ПолеПериода) И ВРег(ПолеПериода) <> "ДАТА" Тогда
			ТекстУсловия = СтрЗаменить(ТекстУсловия, "Дата МЕЖДУ ", ПолеПериода + " МЕЖДУ ");
		КонецЕсли;
		Возврат ТекстУсловия;
	КонецЕсли;
	
	Если ТипЗнч(Фильтр) <> Тип("Структура") И ТипЗнч(Фильтр) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат "";
	КонецЕсли;
	
	Условия = Новый Массив;
	Для Каждого Пара Из Фильтр Цикл
		ИмяПоля = Строка(Пара.Ключ);
		ЗначениеФильтра = Пара.Значение;
		ИмяПоляВРег = ВРег(ИмяПоля);
		Если ЭтоСлужебныйКлючФильтраЗапроса(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Если (ИмяПоляВРег = "ДАТА" ИЛИ ИмяПоляВРег = "ПЕРИОД")
			И (ТипЗнч(ЗначениеФильтра) = Тип("Структура") ИЛИ ТипЗнч(ЗначениеФильтра) = Тип("ФиксированнаяСтруктура")
				ИЛИ ТипЗнч(ЗначениеФильтра) = Тип("Соответствие") ИЛИ ТипЗнч(ЗначениеФильтра) = Тип("ФиксированноеСоответствие")) Тогда
			ДатаС = ПолучитьСвойствоИзСтруктуры(ЗначениеФильтра, "from", Неопределено);
			ДатаПо = ПолучитьСвойствоИзСтруктуры(ЗначениеФильтра, "to", Неопределено);
			НачДата = ПопыткаПрочитатьДатуИзСтроки(ДатаС);
			КонДата = ПопыткаПрочитатьДатуИзСтроки(ДатаПо);
			Если НачДата <> Неопределено И КонДата <> Неопределено Тогда
				Условия.Добавить(ПолеПериода + " МЕЖДУ " + ПостроитьЛитералДаты1С(НачалоДня(НачДата)) + " И " + ПостроитьЛитералДаты1С(КонецДня(КонДата)));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ИмяПоляВРег = "ПЕРИОД" Тогда
			Границы = ПолучитьГраницыПериодаИзТекста(ЗначениеФильтра);
			Если Границы.Начало <> Неопределено И Границы.Конец <> Неопределено Тогда
				Условия.Добавить(ПолеПериода + " МЕЖДУ " + ПостроитьЛитералДаты1С(Границы.Начало) + " И " + ПостроитьЛитералДаты1С(Границы.Конец));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЗначениеФильтра) = Тип("Строка") Тогда
			УсловиеСтроки = ПостроитьСтроковоеУсловиеЗапроса(ИмяПоля, ЗначениеФильтра);
			Если НЕ ПустаяСтрока(УсловиеСтроки) Тогда
				Условия.Добавить(УсловиеСтроки);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ЗначениеФильтра) = Тип("Число") Тогда
			Условия.Добавить(ИмяПоля + " = " + Строка(ЗначениеФильтра));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Условия, Символы.ПС + " И ");
КонецФункции

Функция НормализоватьАгрегациюДляЗапроса(Знач Агрегация, Знач Поля)
	ТекстАгрегации = СокрЛП(Строка(Агрегация));
	Если ПустаяСтрока(ТекстАгрегации) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстАгрегации = СтрЗаменить(ТекстАгрегации, "Объект.", "");
	ТекстАгрегации = СтрЗаменить(ТекстАгрегации, "объект.", "");
	ТекстАгрегации = СтрЗаменить(ТекстАгрегации, " AS ", " КАК ");
	ТекстАгрегации = СтрЗаменить(ТекстАгрегации, " as ", " КАК ");
	Если СтрНайти(ВРег(ТекстАгрегации), "СУММА(") = 0 И СтрНайти(ВРег(ТекстАгрегации), "SUM(") > 0 Тогда
		ТекстАгрегации = СтрЗаменить(ТекстАгрегации, "SUM(", "СУММА(");
	КонецЕсли;

	ТекстАгрегацииВРег = ВРег(ТекстАгрегации);
	Если СтрНайти(ТекстАгрегацииВРег, "СУММА(") = 0
		И СтрНайти(ТекстАгрегацииВРег, "КОЛИЧЕСТВО(") = 0
		И СтрНайти(ТекстАгрегацииВРег, "МАКСИМУМ(") = 0
		И СтрНайти(ТекстАгрегацииВРег, "МИНИМУМ(") = 0
		И СтрНайти(ТекстАгрегацииВРег, "СРЕДНЕЕ(") = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстАгрегации;
КонецФункции

Функция ПопыткаПрочитатьДатуИзСтроки(Знач СтрокаДаты)
	СтрокаЗначения = СокрЛП(Строка(СтрокаДаты));
	Если ПустаяСтрока(СтрокаЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Если СтрДлина(СтрокаЗначения) >= 10 И Сред(СтрокаЗначения, 5, 1) = "-" И Сред(СтрокаЗначения, 8, 1) = "-" Тогда
			ГодЗнач = Число(Лев(СтрокаЗначения, 4));
			МесяцЗнач = Число(Сред(СтрокаЗначения, 6, 2));
			ДеньЗнач = Число(Сред(СтрокаЗначения, 9, 2));
			Возврат Дата(ГодЗнач, МесяцЗнач, ДеньЗнач);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
КонецФункции

Функция ЭтоПохожеНаВалидныйTypedPlanJSON(ТекстJSON)
	Текст = ВРег(СокрЛП(Строка(ТекстJSON)));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Текст, """PLAN_VERSION""") > 0
		И СтрНайти(Текст, """STEPS""") > 0
		И СтрНайти(Текст, "[{") > 0;
КонецФункции

Функция НужноГруппироватьЗапросПоИзмерениюИСумме(ТекстУсловия, Поля)
	Текст = ВРег(Строка(ТекстУсловия));
	Если СтрНайти(Текст, "СУММ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(Текст, "КОНТРАГЕНТ") = 0
		И СтрНайти(Текст, "КЛИЕНТ") = 0
		И СтрНайти(Текст, "ПОКУПАТЕЛ") = 0
		И СтрНайти(Текст, "ПОСТАВЩИК") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ПустаяСтрока(ВыбратьСуммовоеПолеИзПолей(Поля));
КонецФункции

Функция ИзвлечьЛимитТопИзТекста(ТекстУсловия)
	Текст = ВРег(Строка(ТекстУсловия));
	Если СтрНайти(Текст, "ТОП") = 0 И СтрНайти(Текст, "TOP") = 0 И СтрНайти(Текст, "ПЕРВЫ") = 0 Тогда
		Возврат "10";
	КонецЕсли;
	Лимит = ИзвлечьПервоеЧислоИзТекста(ТекстУсловия);
	Если ПустаяСтрока(Лимит) Тогда
		Возврат "10";
	КонецЕсли;
	Возврат Лимит;
КонецФункции

Функция ВыбратьПутьИзмеренияДляГруппировки(ПолноеИмяОбъекта, Поля, ТекстУсловия)
	WhitelistПути = ПолучитьWhitelistПутейОбъектаЛокально(ПолноеИмяОбъекта);
	Если WhitelistПути.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ТекстВРег = ВРег(Строка(ТекстУсловия));
	ЛучшийПуть = "";
	ЛучшаяОценка = -1;
	Для Каждого Путь Из WhitelistПути Цикл
		ПутьСтрокой = СокрЛП(Строка(Путь));
		ПутьВРег = ВРег(ПутьСтрокой);
		Если Прав(ПутьВРег, СтрДлина(".НАИМЕНОВАНИЕ")) <> ".НАИМЕНОВАНИЕ" Тогда
			Продолжить;
		КонецЕсли;
		ИмяРеквизита = Лев(ПутьСтрокой, СтрНайти(ПутьСтрокой, ".") - 1);
		Оценка = 0;
		Если СтрНайти(ВРег(ИмяРеквизита), "КОНТРАГЕНТ") > 0 Тогда
			Оценка = Оценка + 100;
		КонецЕсли;
		Если СтрНайти(ВРег(ИмяРеквизита), "ПАРТНЕР") > 0 Тогда
			Оценка = Оценка + 90;
		КонецЕсли;
		Если СтрНайти(ВРег(ИмяРеквизита), "КЛИЕНТ") > 0 И СтрНайти(ТекстВРег, "КЛИЕНТ") > 0 Тогда
			Оценка = Оценка + 80;
		КонецЕсли;
		Если СтрНайти(ВРег(ИмяРеквизита), "ПОКУПАТЕЛ") > 0 Тогда
			Оценка = Оценка + 70;
		КонецЕсли;
		Если СтрНайти(ВРег(ИмяРеквизита), "ПОСТАВЩИК") > 0 И СтрНайти(ТекстВРег, "ПОСТАВЩИК") > 0 Тогда
			Оценка = Оценка + 70;
		КонецЕсли;
		Если ЭтоМассивоподобноеЗначение(Поля) И Поля.Найти(ИмяРеквизита) <> Неопределено Тогда
			Оценка = Оценка + 30;
		КонецЕсли;
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшийПуть = ПутьСтрокой;
		КонецЕсли;
	КонецЦикла;
	Если ЛучшаяОценка <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ЛучшийПуть;
КонецФункции

Функция ПостроитьЗапросТопПоИзмерениюИСумме(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловия)
	Если НЕ НужноГруппироватьЗапросПоИзмерениюИСумме(ТекстУсловия, Поля) Тогда
		Возврат "";
	КонецЕсли;
	ПутьИзмерения = ВыбратьПутьИзмеренияДляГруппировки(ПолноеИмяОбъекта, Поля, ТекстУсловия);
	ПолеСуммы = ВыбратьСуммовоеПолеИзПолей(Поля);
	Если ПустаяСтрока(ПутьИзмерения) ИЛИ ПустаяСтрока(ПолеСуммы) Тогда
		Возврат "";
	КонецЕсли;
	Условия = ПостроитьУсловияЗапросаИзФильтра(ПолноеИмяОбъекта, Фильтр);
	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + ИзвлечьЛимитТопИзТекста(ТекстУсловия) + Символы.ПС
		+ ПутьИзмерения + " КАК Наименование," + Символы.ПС
		+ "СУММА(" + ПолеСуммы + ") КАК ИтоговаяСумма" + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ ПолноеИмяОбъекта;
	Если НЕ ПустаяСтрока(Условия) Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Условия;
	КонецЕсли;
	Текст = Текст + Символы.ПС
		+ "СГРУППИРОВАТЬ ПО" + Символы.ПС
		+ ПутьИзмерения + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО" + Символы.ПС
		+ "ИтоговаяСумма УБЫВ";
	Возврат Текст;
КонецФункции

Функция ПостроитьRunQueryПоМетаданным(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловияШага)
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	Поля = ДополнитьПоляИзТекста(ПолноеИмяОбъекта, Поля, ТекстУсловияШага);
	Фильтр = ДополнитьФильтрПорогомИзТекста(Фильтр, ТекстУсловияШага, Поля);
	Поля = НормализоватьПоляШагаПоМетаданным(ПолноеИмяОбъекта, Поля);
	Фильтр = НормализоватьСтруктуруФильтраПоМетаданным(ПолноеИмяОбъекта, Фильтр);
	ЗапросОстатков = ПостроитьЗапросОстатковРегистраНакопления(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловияШага);
	Если НЕ ПустаяСтрока(ЗапросОстатков) Тогда
		Возврат ЗапросОстатков;
	КонецЕсли;
	ЗапросТопПоИзмерению = ПостроитьЗапросТопПоИзмерениюИСумме(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловияШага);
	Если НЕ ПустаяСтрока(ЗапросТопПоИзмерению) Тогда
		Возврат ЗапросТопПоИзмерению;
	КонецЕсли;
	Если НужноГруппироватьЗапросПоДнямИСумме(ТекстУсловияШага, Поля) Тогда
		ПолеПериодаДляГруппировки = ВыбратьПолеПериодаПоWhitelist(ПолноеИмяОбъекта);
		ПолеСуммыДляГруппировки = ВыбратьСуммовоеПолеИзПолей(Поля);
		Если ПустаяСтрока(ПолеПериодаДляГруппировки) ИЛИ ПустаяСтрока(ПолеСуммыДляГруппировки) Тогда
			Возврат "";
		КонецЕсли;
		УсловияГруппировки = ПостроитьУсловияЗапросаИзФильтра(ПолноеИмяОбъекта, Фильтр);
		ТекстГруппировки = "ВЫБРАТЬ " + Символы.ПС
			+ ПолеПериодаДляГруппировки + " КАК День, " + Символы.ПС
			+ "СУММА(" + ПолеСуммыДляГруппировки + ") КАК Сумма" + Символы.ПС
			+ "ИЗ" + Символы.ПС
			+ ПолноеИмяОбъекта;
		Если НЕ ПустаяСтрока(УсловияГруппировки) Тогда
			ТекстГруппировки = ТекстГруппировки + Символы.ПС + "ГДЕ" + Символы.ПС + УсловияГруппировки;
		КонецЕсли;
		ТекстГруппировки = ТекстГруппировки + Символы.ПС
			+ "СГРУППИРОВАТЬ ПО" + Символы.ПС
			+ ПолеПериодаДляГруппировки + Символы.ПС
			+ "УПОРЯДОЧИТЬ ПО" + Символы.ПС
			+ "День";
		Возврат ТекстГруппировки;
	КонецЕсли;
	СписокПолей = ПостроитьСписокПолейДляЗапроса(ПолноеИмяОбъекта, Поля);
	Если ПустаяСтрока(СписокПолей) Тогда
		Возврат "";
	КонецЕсли;
	Условия = ПостроитьУсловияЗапросаИзФильтра(ПолноеИмяОбъекта, Фильтр);
	ТекстЗапроса = "ВЫБРАТЬ " + Символы.ПС + СписокПолей + Символы.ПС
		+ "ИЗ" + Символы.ПС + ПолноеИмяОбъекта;
	Если НЕ ПустаяСтрока(Условия) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ГДЕ" + Символы.ПС + Условия;
	КонецЕсли;
	Возврат ТекстЗапроса;
КонецФункции

Функция ПостроитьRunQueryИзШагаПлана(ШагПлана, СсылкаДиалога = Неопределено)
	ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
	КонецЕсли;
	ОбъектЗаданЯвно = НЕ ПустаяСтрока(ПолноеИмяОбъекта);
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = ПолучитьПервыйОбъектИзМассиваШагаПлана(ШагПлана);
	КонецЕсли;
	Если НЕ ОбъектЗаданЯвно И НЕ ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ОбъектЗаданЯвно = Истина;
	КонецЕсли;
	ПолноеИмяОбъекта = НормализоватьПолноеИмяОбъектаПоМетаданным(ПолноеИмяОбъекта);
	Намерение = ПолучитьПараметрШагаПлана(ШагПлана, "intent", Неопределено);
	ТекстНамерения = ИзвлечьТекстНамеренияШага(Намерение);
	Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
		ПолноеИмяИзНамерения = НормализоватьПолноеИмяОбъектаПоМетаданным(ИзвлечьИмяОбъектаИзНамерения(Намерение));
		Если ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяИзНамерения) Тогда
			ПолноеИмяОбъекта = ПолноеИмяИзНамерения;
			ОбъектЗаданЯвно = Истина;
		КонецЕсли;
	КонецЕсли;

	QueryТекст = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "query", ""));
	ТекстДляВыбораИсточника = ТекстНамерения + " "
		+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "title", "")) + " " + QueryТекст + " "
		+ ПолучитьТекстПоследнейЗадачиДиалога(СсылкаДиалога);
	Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = ПодобратьПолноеИмяОбъектаПоТекстуЗадачи(ТекстДляВыбораИсточника, СсылкаДиалога);
		Если ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
			ОбъектЗаданЯвно = Истина;
		КонецЕсли;
	КонецЕсли;
	ЭтоНевалидныеОстаткиРегистраСведений = СтрНайти(ВРег(QueryТекст), "РЕГИСТРСВЕДЕНИЙ.") > 0
		И СтрНайти(ВРег(QueryТекст), ".ОСТАТКИ") > 0;
	Если ТекстЗапрашиваетОстатки(ТекстДляВыбораИсточника)
		И (НЕ ЭтоПодходящийИсточникТоварныхОстатков(ПолноеИмяОбъекта) Или ЭтоНевалидныеОстаткиРегистраСведений)
		И (ПустаяСтрока(QueryТекст) Или Лев(ВРег(СокрЛП(QueryТекст)), 7) <> "ВЫБРАТЬ"
			Или ЭтоНевалидныеОстаткиРегистраСведений) Тогда
		РегистрОстатков = НайтиИсточникТоварныхОстатков();
		Если НЕ ПустаяСтрока(РегистрОстатков) Тогда
			ПолноеИмяОбъекта = РегистрОстатков;
			ОбъектЗаданЯвно = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ПустаяСтрока(QueryТекст) Тогда
		QueryТекст = НормализоватьСтроковыйФильтрДляЗапроса(QueryТекст);
		QueryТекст = НормализоватьЛитералыДатаВЗапросе(QueryТекст);
		QueryТекст = НормализоватьСокращенныйЯвныйRunQuery(QueryТекст);
		Если ПолучитьПараметрШагаПлана(ШагПлана, "preserve_query", Ложь) Тогда
			Если Лев(ВРег(СокрЛП(QueryТекст)), 7) <> "ВЫБРАТЬ" Тогда
				Возврат "";
			КонецЕсли;
			Возврат QueryТекст;
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = НормализоватьПолноеИмяОбъектаПоМетаданным(ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(QueryТекст));
		КонецЕсли;
		Если Лев(ВРег(СокрЛП(QueryТекст)), 7) = "ВЫБРАТЬ" Тогда
			ИсточникЯвногоЗапроса = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(QueryТекст);
			ИсточникЯвногоЗапросаСуществует = ЭтоКаноническоеПолноеИмяМетаданных(ИсточникЯвногоЗапроса)
				И ИсточникЗапросаСуществуетВМетаданных(ИсточникЯвногоЗапроса)
				И НЕ (СтрНайти(ВРег(QueryТекст), "РЕГИСТРСВЕДЕНИЙ.") > 0 И СтрНайти(ВРег(QueryТекст), ".ОСТАТКИ") > 0);
			Если ИсточникЯвногоЗапросаСуществует Тогда
				Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) Тогда
					QueryТекст = НормализоватьЯвныйRunQueryПоМетаданным(QueryТекст, ПолноеИмяОбъекта);
				КонецЕсли;
				Возврат QueryТекст;
			КонецЕсли;
			Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ИсточникЯвногоЗапроса) Тогда
				QueryТекст = "";
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) И ОбъектЗаданЯвно Тогда
			QueryТекст = НормализоватьЯвныйRunQueryПоМетаданным(QueryТекст, ПолноеИмяОбъекта);
			ЯвныйЗапросГотов = Лев(ВРег(СокрЛП(QueryТекст)), 7) = "ВЫБРАТЬ";
			ИсточникЯвногоЗапросаСуществует = ИсточникЗапросаСуществуетВМетаданных(ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(QueryТекст))
				И НЕ (СтрНайти(ВРег(QueryТекст), "РЕГИСТРСВЕДЕНИЙ.") > 0 И СтрНайти(ВРег(QueryТекст), ".ОСТАТКИ") > 0);
			Если НЕ ЯвныйЗапросГотов Или НЕ ИсточникЯвногоЗапросаСуществует Тогда
			ТекстУсловияЯвногоЗапроса = ТекстНамерения + " "
				+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "title", "")) + " "
				+ QueryТекст;
			ГруппировкаЯвногоЗапроса = ПолучитьПараметрШагаПлана(ШагПлана, "group_by", Неопределено);
			Если ЭтоМассивоподобноеЗначение(ГруппировкаЯвногоЗапроса) Тогда
				Для Каждого ПолеГруппировки Из ГруппировкаЯвногоЗапроса Цикл
					ТекстУсловияЯвногоЗапроса = ТекстУсловияЯвногоЗапроса + " " + Строка(ПолеГруппировки);
				КонецЦикла;
			ИначеЕсли ГруппировкаЯвногоЗапроса <> Неопределено Тогда
				ТекстУсловияЯвногоЗапроса = ТекстУсловияЯвногоЗапроса + " " + Строка(ГруппировкаЯвногоЗапроса);
			КонецЕсли;
			ПоляЯвногоЗапроса = ДополнитьПоляИзТекста(ПолноеИмяОбъекта, Неопределено, ТекстУсловияЯвногоЗапроса);
			ПоляИзШага = ПолучитьПараметрШагаПлана(ШагПлана, "fields", Неопределено);
			Если ПоляИзШага <> Неопределено Тогда
				ПоляЯвногоЗапроса = ПоляИзШага;
			КонецЕсли;
			ФильтрЯвногоЗапроса = Неопределено;
			ПараметрыЯвногоЗапроса = ПолучитьПараметрШагаПлана(ШагПлана, "parameters", Неопределено);
			Если ПараметрыЯвногоЗапроса <> Неопределено Тогда
				ФильтрЯвногоЗапроса = ПреобразоватьПараметрыПериодаВФильтр(ПараметрыЯвногоЗапроса);
			КонецЕсли;
			Если ФильтрЯвногоЗапроса = Неопределено Тогда
				ПериодЯвногоЗапроса = ПолучитьПараметрШагаПлана(ШагПлана, "period", Неопределено);
				Если ПериодЯвногоЗапроса <> Неопределено Тогда
					ФильтрЯвногоЗапроса = Новый Структура("Период", ПериодЯвногоЗапроса);
				КонецЕсли;
			КонецЕсли;
			ЗапросОстатковИзМетаданных = ПостроитьЗапросОстатковРегистраНакопления(ПолноеИмяОбъекта,
				ПоляЯвногоЗапроса, Неопределено, ТекстУсловияЯвногоЗапроса);
			Если НЕ ПустаяСтрока(ЗапросОстатковИзМетаданных) Тогда
				Возврат ЗапросОстатковИзМетаданных;
			КонецЕсли;
			ЗапросБухгалтерскихОстатков = ПостроитьЗапросТоварныхОстатковРегистраБухгалтерии(ПолноеИмяОбъекта, ТекстУсловияЯвногоЗапроса);
			Если НЕ ПустаяСтрока(ЗапросБухгалтерскихОстатков) Тогда
				Возврат ЗапросБухгалтерскихОстатков;
			КонецЕсли;
			ЗапросТопИзМетаданных = ПостроитьЗапросТопПоИзмерениюИСумме(ПолноеИмяОбъекта,
				ПоляЯвногоЗапроса, ФильтрЯвногоЗапроса, ТекстУсловияЯвногоЗапроса);
			Если НЕ ПустаяСтрока(ЗапросТопИзМетаданных) Тогда
				Возврат ЗапросТопИзМетаданных;
			КонецЕсли;
			Если СтрНайти(ВРег(QueryТекст), ".ОБОРОТЫ(") > 0
				ИЛИ (СтрНайти(QueryТекст, "&") > 0 И ФильтрЯвногоЗапроса <> Неопределено) Тогда
				ЗапросИзМетаданных = ПостроитьRunQueryПоМетаданным(ПолноеИмяОбъекта,
					ПоляЯвногоЗапроса, ФильтрЯвногоЗапроса, ТекстУсловияЯвногоЗапроса);
				Если НЕ ПустаяСтрока(ЗапросИзМетаданных) Тогда
					Возврат ЗапросИзМетаданных;
				КонецЕсли;
			КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Лев(ВРег(СокрЛП(QueryТекст)), 7) <> "ВЫБРАТЬ" Тогда
			Возврат "";
		КонецЕсли;
		Возврат QueryТекст;
	КонецЕсли;
	
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	
	Фильтр = ПолучитьПараметрШагаПлана(ШагПлана, "filter", Неопределено);
	Если Фильтр = Неопределено Тогда
		ПериодС = ПолучитьПараметрШагаПлана(ШагПлана, "period_from", Неопределено);
		ПериодПо = ПолучитьПараметрШагаПлана(ШагПлана, "period_to", Неопределено);
		Если ПериодС <> Неопределено И ПериодПо <> Неопределено Тогда
			Фильтр = Новый Структура("Период", Новый Структура("from,to", ПериодС, ПериодПо));
		КонецЕсли;
	КонецЕсли;
	Если Фильтр = Неопределено Тогда
		ДатаС = ПолучитьПараметрШагаПлана(ШагПлана, "date_from", Неопределено);
		ДатаПо = ПолучитьПараметрШагаПлана(ШагПлана, "date_to", Неопределено);
		Если ДатаС = Неопределено Тогда
			ДатаС = ПолучитьПараметрШагаПлана(ШагПлана, "date_start", Неопределено);
		КонецЕсли;
		Если ДатаПо = Неопределено Тогда
			ДатаПо = ПолучитьПараметрШагаПлана(ШагПлана, "date_end", Неопределено);
		КонецЕсли;
		Если ДатаС <> Неопределено И ДатаПо <> Неопределено Тогда
			ГраницыДат = ПолучитьГраницыПериодаИзТекста(Строка(ДатаС) + " " + Строка(ДатаПо));
			Если ГраницыДат.Начало <> Неопределено И ГраницыДат.Конец <> Неопределено Тогда
				Фильтр = Новый Структура("Период", Новый Структура("from,to", ГраницыДат.Начало, ГраницыДат.Конец));
			Иначе
				Фильтр = Новый Структура("Период", Новый Структура("from,to", ДатаС, ДатаПо));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Фильтр = Неопределено Тогда
		Период = ПолучитьПараметрШагаПлана(ШагПлана, "period", Неопределено);
		Если Период <> Неопределено Тогда
			Фильтр = Новый Структура("Период", Период);
		КонецЕсли;
	КонецЕсли;
	Если Фильтр = Неопределено Тогда
		ПараметрыЗапросаКакФильтр = ПолучитьПараметрШагаПлана(ШагПлана, "parameters", Неопределено);
		Если ПараметрыЗапросаКакФильтр <> Неопределено Тогда
			ФильтрПериодаИзПараметров = ПреобразоватьПараметрыПериодаВФильтр(ПараметрыЗапросаКакФильтр);
			Если ФильтрПериодаИзПараметров <> Неопределено Тогда
				Фильтр = ФильтрПериодаИзПараметров;
			Иначе
				Фильтр = ПреобразоватьМассивПараметровВФильтр(ПараметрыЗапросаКакФильтр);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Поля = ПолучитьПараметрШагаПлана(ШагПлана, "fields", Неопределено);
	Если ПолучитьПараметрШагаПлана(ШагПлана, "all_fields", Ложь) Тогда
		Поля = ПолучитьВсеПоляДляЗапросаПоМетаданным(ПолноеИмяОбъекта);
	КонецЕсли;
	Если Поля = Неопределено Тогда
		Поля = ПолучитьПараметрШагаПлана(ШагПлана, "select", Неопределено);
	КонецЕсли;
	Если Поля = Неопределено Тогда
		Поля = ПолучитьСвойствоИзСтруктуры(Намерение, "select", Неопределено);
	КонецЕсли;
	Если Поля = Неопределено Тогда
		Поля = ПолучитьПараметрШагаПлана(ШагПлана, "output", Неопределено);
	КонецЕсли;
	ТекстУсловияШага = ТекстНамерения + " "
		+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "title", "")) + " "
		+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "condition", "")) + " "
		+ ПолучитьТекстПоследнейЗадачиДиалога(СсылкаДиалога);
	ГруппировкаШага = ПолучитьПараметрШагаПлана(ШагПлана, "group_by", Неопределено);
	Если ГруппировкаШага = Неопределено Тогда
		ГруппировкаШага = ПолучитьСвойствоИзСтруктуры(Намерение, "group_by", Неопределено);
	КонецЕсли;
	Если ЭтоМассивоподобноеЗначение(ГруппировкаШага) Тогда
		Для Каждого ПолеГруппировки Из ГруппировкаШага Цикл
			ТекстУсловияШага = ТекстУсловияШага + " " + Строка(ПолеГруппировки);
		КонецЦикла;
	ИначеЕсли ГруппировкаШага <> Неопределено Тогда
		ТекстУсловияШага = ТекстУсловияШага + " " + Строка(ГруппировкаШага);
	КонецЕсли;
	Если ТекстЗапрашиваетОстатки(ТекстУсловияШага)
		И НЕ ЭтоПодходящийИсточникТоварныхОстатков(ПолноеИмяОбъекта) Тогда
		РегистрОстатков = НайтиИсточникТоварныхОстатков();
		Если НЕ ПустаяСтрока(РегистрОстатков) Тогда
			ПолноеИмяОбъекта = РегистрОстатков;
			ОбъектЗаданЯвно = Истина;
		КонецЕсли;
	КонецЕсли;
	Поля = ДополнитьПоляИзТекста(ПолноеИмяОбъекта, Поля, ТекстУсловияШага);
	Фильтр = ДополнитьФильтрПорогомИзТекста(Фильтр,
		ТекстУсловияШага, Поля);
	Поля = НормализоватьПоляШагаПоМетаданным(ПолноеИмяОбъекта, Поля);
	Фильтр = НормализоватьСтруктуруФильтраПоМетаданным(ПолноеИмяОбъекта, Фильтр);
	ЗапросОстатков = ПостроитьЗапросОстатковРегистраНакопления(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловияШага);
	Если НЕ ПустаяСтрока(ЗапросОстатков) Тогда
		Возврат ЗапросОстатков;
	КонецЕсли;
	ЗапросБухгалтерскихОстатков = ПостроитьЗапросТоварныхОстатковРегистраБухгалтерии(ПолноеИмяОбъекта, ТекстУсловияШага);
	Если НЕ ПустаяСтрока(ЗапросБухгалтерскихОстатков) Тогда
		Возврат ЗапросБухгалтерскихОстатков;
	КонецЕсли;
	ЗапросТопПоИзмерению = ПостроитьЗапросТопПоИзмерениюИСумме(ПолноеИмяОбъекта, Поля, Фильтр, ТекстУсловияШага);
	Если НЕ ПустаяСтрока(ЗапросТопПоИзмерению) Тогда
		Возврат ЗапросТопПоИзмерению;
	КонецЕсли;
	Если НужноГруппироватьЗапросПоДнямИСумме(ТекстУсловияШага, Поля) Тогда
		ПолеПериодаДляГруппировки = ВыбратьПолеПериодаПоWhitelist(ПолноеИмяОбъекта);
		ПолеСуммыДляГруппировки = ВыбратьСуммовоеПолеИзПолей(Поля);
		УсловияГруппировки = ПостроитьУсловияЗапросаИзФильтра(ПолноеИмяОбъекта, Фильтр);
		ТекстГруппировки = "ВЫБРАТЬ " + Символы.ПС
			+ ПолеПериодаДляГруппировки + " КАК День, " + Символы.ПС
			+ "СУММА(" + ПолеСуммыДляГруппировки + ") КАК Сумма" + Символы.ПС
			+ "ИЗ" + Символы.ПС
			+ ПолноеИмяОбъекта;
		Если НЕ ПустаяСтрока(УсловияГруппировки) Тогда
			ТекстГруппировки = ТекстГруппировки + Символы.ПС + "ГДЕ" + Символы.ПС + УсловияГруппировки;
		КонецЕсли;
		ТекстГруппировки = ТекстГруппировки + Символы.ПС
			+ "СГРУППИРОВАТЬ ПО" + Символы.ПС
			+ ПолеПериодаДляГруппировки + Символы.ПС
			+ "УПОРЯДОЧИТЬ ПО" + Символы.ПС
			+ "День";
		Возврат ТекстГруппировки;
	КонецЕсли;
	Агрегация = НормализоватьАгрегациюДляЗапроса(ПолучитьПараметрШагаПлана(ШагПлана, "aggregation", ""), Поля);
	СписокПолей = ПостроитьСписокПолейДляЗапроса(ПолноеИмяОбъекта, Поля);
	Если ПустаяСтрока(СписокПолей) И НЕ ПустаяСтрока(Агрегация) Тогда
		СписокПолей = Агрегация;
	ИначеЕсли НЕ ПустаяСтрока(СписокПолей) И НЕ ПустаяСтрока(Агрегация) Тогда
		СписокПолей = СписокПолей + ", " + Агрегация;
	ИначеЕсли ПустаяСтрока(СписокПолей) Тогда
		Возврат "";
	КонецЕсли;
	Условия = ПостроитьУсловияЗапросаИзФильтра(ПолноеИмяОбъекта, Фильтр);
	
	Текст = "ВЫБРАТЬ ";
	Текст = Текст + СписокПолей + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ ПолноеИмяОбъекта;
	Если НЕ ПустаяСтрока(Условия) Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Условия;
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПолучитьПервыйОбъектИзМассиваШагаПлана(ШагПлана)

	Объекты = ПолучитьПараметрШагаПлана(ШагПлана, "objects", Неопределено);
	Если Объекты = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ЭтоМассивоподобноеЗначение(Объекты) И Объекты.Количество() > 0 Тогда
		Возврат Строка(ПолучитьЭлементМассиваУниверсально(Объекты, 0));
	КонецЕсли;
	Возврат Строка(Объекты);

КонецФункции

Функция ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта)
	ИмяПолное = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(ИмяПолное) Или СтрНайти(ИмяПолное, ".") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ИсточникЗапросаСуществуетВМетаданных(ИмяПолное);
КонецФункции

Функция ИзвлечьТекстНамеренияШага(Намерение)
	Если Намерение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Намерение) = Тип("Строка") Тогда
		Возврат Строка(Намерение);
	КонецЕсли;
	Части = Новый Массив;
	ЗначениеОбъекта = ПолучитьСвойствоИзСтруктуры(Намерение, "object", "");
	Если НЕ ПустаяСтрока(Строка(ЗначениеОбъекта)) Тогда
		Части.Добавить(Строка(ЗначениеОбъекта));
	КонецЕсли;
	ЗначениеФильтра = ПолучитьСвойствоИзСтруктуры(Намерение, "date_filter", "");
	Если НЕ ПустаяСтрока(Строка(ЗначениеФильтра)) Тогда
		Части.Добавить(Строка(ЗначениеФильтра));
	КонецЕсли;
	Выборка = ПолучитьСвойствоИзСтруктуры(Намерение, "select", Неопределено);
	Если ЭтоМассивоподобноеЗначение(Выборка) Тогда
		Для Каждого ЭлементВыборки Из Выборка Цикл
			Части.Добавить(Строка(ЭлементВыборки));
		КонецЦикла;
	КонецЕсли;
	Группировка = ПолучитьСвойствоИзСтруктуры(Намерение, "group_by", Неопределено);
	Если ЭтоМассивоподобноеЗначение(Группировка) Тогда
		Для Каждого ЭлементГруппировки Из Группировка Цикл
			Части.Добавить(Строка(ЭлементГруппировки));
		КонецЦикла;
	ИначеЕсли Группировка <> Неопределено Тогда
		Части.Добавить(Строка(Группировка));
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");
КонецФункции

Функция ИзвлечьИмяОбъектаИзНамерения(Намерение)
	Если Намерение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Намерение) = Тип("Строка") Тогда
		Возврат Строка(Намерение);
	КонецЕсли;
	Возврат СтрокаИмениОбъектаИзЗначенияШага(ПолучитьСвойствоИзСтруктуры(Намерение, "object", Неопределено));
КонецФункции

Функция ПодобратьПолноеИмяОбъектаПоТекстуЗадачи(ТекстЗадачи, СсылкаДиалога)
	ТекстВРег = ВРег(Строка(ТекстЗадачи));
	Если СсылкаДиалога <> Неопределено Тогда
		ИмяИзПлана = НайтиПодтвержденныйОбъектИзПлана(СсылкаДиалога);
		Если ЭтоКаноническоеПолноеИмяМетаданных(ИмяИзПлана) Тогда
			Возврат ИмяИзПлана;
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "ПРОДАЖ") > 0 Или СтрНайти(ТекстВРег, "РЕАЛИЗАЦ") > 0 Тогда
		ИсточникПродаж = НайтиИсточникПродаж();
		Если ЭтоКаноническоеПолноеИмяМетаданных(ИсточникПродаж) Тогда
			Возврат ИсточникПродаж;
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "ПОСТУПЛЕН") > 0 Или СтрНайти(ТекстВРег, "ПРИХОДН") > 0 Или СтрНайти(ТекстВРег, "ПОСТАВЩ") > 0 Тогда
		ИсточникПоступления = НайтиДокументПоступленияТоваров();
		Если ЭтоКаноническоеПолноеИмяМетаданных(ИсточникПоступления) Тогда
			Возврат ИсточникПоступления;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПодобратьПолноеИмяОбъектаДляУточненияПолей(ШагПлана, СсылкаДиалога)
	Кандидаты = Новый Массив;
	Значения = Новый Массив;
	Значения.Добавить(ПолучитьПараметрШагаПлана(ШагПлана, "rag_candidates", Неопределено));
	Значения.Добавить(ПолучитьПараметрШагаПлана(ШагПлана, "object_candidates", Неопределено));
	Значения.Добавить(ПолучитьПараметрШагаПлана(ШагПлана, "object_url", Неопределено));
	Для Каждого Значение Из Значения Цикл
		Если ЭтоМассивоподобноеЗначение(Значение) Тогда
			Для Каждого Элемент Из Значение Цикл
				Кандидаты.Добавить(Строка(Элемент));
			КонецЦикла;
		ИначеЕсли Значение <> Неопределено Тогда
			Кандидаты.Добавить(Строка(Значение));
		КонецЕсли;
	КонецЦикла;
	Если СсылкаДиалога <> Неопределено Тогда
		План = ИИА_TypedPlan.ПолучитьTypedPlan(СсылкаДиалога);
		Если План <> Неопределено И План.Свойство("steps") И ТипЗнч(План.steps) = Тип("Массив") Тогда
			Для Каждого ШагПланаПлана Из План.steps Цикл
				КандидатыШага = ПолучитьПараметрШагаПлана(ШагПланаПлана, "rag_candidates", Неопределено);
				Если ЭтоМассивоподобноеЗначение(КандидатыШага) Тогда
					Для Каждого Элемент Из КандидатыШага Цикл
						Кандидаты.Добавить(Строка(Элемент));
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Для Каждого Кандидат Из Кандидаты Цикл
		Имя = НормализоватьПолноеИмяОбъектаПоМетаданным(Кандидат);
		Если ЭтоКаноническоеПолноеИмяМетаданных(Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Если СсылкаДиалога <> Неопределено Тогда
		ИмяИзПлана = НайтиПодтвержденныйОбъектИзПлана(СсылкаДиалога);
		Если ЭтоКаноническоеПолноеИмяМетаданных(ИмяИзПлана) Тогда
			Возврат ИмяИзПлана;
		КонецЕсли;
		ТекстЗадачи = ПолучитьТекстПоследнейЗадачиДиалога(СсылкаДиалога) + " "
			+ Строка(ПолучитьПараметрШагаПлана(ШагПлана, "title", ""));
		ИмяПоЗадаче = ПодобратьПолноеИмяОбъектаПоТекстуЗадачи(ТекстЗадачи, СсылкаДиалога);
		Если ЭтоКаноническоеПолноеИмяМетаданных(ИмяПоЗадаче) Тогда
			Возврат ИмяПоЗадаче;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция НайтиПодтвержденныйОбъектИзПлана(СсылкаДиалога)
	Если СсылкаДиалога = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	План = ИИА_TypedPlan.ПолучитьTypedPlan(СсылкаДиалога);
	Если План = Неопределено Или НЕ План.Свойство("steps") Или ТипЗнч(План.steps) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого ШагПлана Из План.steps Цикл
		KindШага = ВРег(Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "kind", "")));
		Если KindШага <> "GET_OBJECT_FIELDS" Тогда
			Продолжить;
		КонецЕсли;
		СтатусШага = ВРег(Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "status", "")));
		Если СтатусШага <> "DONE" И СтатусШага <> "SUCCESS" Тогда
			Продолжить;
		КонецЕсли;
		ТипОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_type", ""));
		ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		Если СтрНайти(ВРег(ИмяОбъекта), "AUTO_FROM") > 0 Тогда
			ИмяОбъекта = "";
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		КонецЕсли;
		Если СтрНайти(ВРег(ИмяОбъекта), "AUTO_FROM") > 0 Тогда
			ИмяОбъекта = "";
		КонецЕсли;
		Кандидат = "";
		Если НЕ ПустаяСтрока(ТипОбъекта) И НЕ ПустаяСтрока(ИмяОбъекта) И СтрНайти(ИмяОбъекта, ".") = 0 Тогда
			Кандидат = ТипОбъекта + "." + ИмяОбъекта;
		Иначе
			Кандидат = ИмяОбъекта;
		КонецЕсли;
		Кандидат = НормализоватьПолноеИмяОбъектаПоМетаданным(Кандидат);
		Если ЭтоКаноническоеПолноеИмяМетаданных(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
		Сводка = Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "result_summary", ""));
		ИмяИзСводки = ИзвлечьИмяОбъектаИзСводкиGetObjectFields(Сводка);
		Если ЭтоКаноническоеПолноеИмяМетаданных(ИмяИзСводки) Тогда
			Возврат ИмяИзСводки;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИзвлечьИмяОбъектаИзСводкиGetObjectFields(Сводка)
	Текст = Строка(Сводка);
	Маркеры = Новый Массив;
	Маркеры.Добавить("документа '");
	Маркеры.Добавить("справочника '");
	Маркеры.Добавить("регистра '");
	Для Каждого Маркер Из Маркеры Цикл
		Поз = СтрНайти(ВРег(Текст), ВРег(Маркер));
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		НачалоИмени = Поз + СтрДлина(Маркер);
		ПозКонца = СтрНайти(Сред(Текст, НачалоИмени), "'");
		Если ПозКонца = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмяОбъекта = СокрЛП(Сред(Текст, НачалоИмени, ПозКонца - 1));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ВРег(Маркер), "ДОКУМЕНТ") > 0 Тогда
			Возврат НормализоватьПолноеИмяОбъектаПоМетаданным("Документ." + ИмяОбъекта);
		КонецЕсли;
		Если СтрНайти(ВРег(Маркер), "СПРАВОЧНИК") > 0 Тогда
			Возврат НормализоватьПолноеИмяОбъектаПоМетаданным("Справочник." + ИмяОбъекта);
		КонецЕсли;
		Возврат ИмяОбъекта;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИзвлечьДанныеИзРезультатаШагаПлана(РезультатШага)
	Если РезультатШага = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "Данные", Неопределено);
	Если Данные = Неопределено Тогда
		Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "data", Неопределено);
	КонецЕсли;
	Если Данные <> Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	
	Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "ДанныеЗапроса", Неопределено);
	Если Данные = Неопределено Тогда
		Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "ДанныеЗапросаДляТаблицы", Неопределено);
	КонецЕсли;
	Если Данные = Неопределено Тогда
		Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "rows", Неопределено);
	КонецЕсли;
	Если Данные = Неопределено Тогда
		Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "СсылкиОбъектов", Неопределено);
	КонецЕсли;
	Если Данные = Неопределено Тогда
		Данные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "changed_objects", Неопределено);
	КонецЕсли;
	Если Данные <> Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	
	RunQueryДанные = ПолучитьСвойствоИзСтруктуры(РезультатШага, "run_query", Неопределено);
	Если ЭтоМассивоподобноеЗначение(RunQueryДанные) И RunQueryДанные.Количество() > 0 Тогда
		ПервыйRunQuery = ПолучитьЭлементМассиваУниверсально(RunQueryДанные, 0);
		Если ПервыйRunQuery <> Неопределено Тогда
			Данные = ПолучитьСвойствоИзСтруктуры(ПервыйRunQuery, "rows", Неопределено);
			Если Данные <> Неопределено Тогда
				Возврат Данные;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результаты = ПолучитьСвойствоИзСтруктуры(РезультатШага, "Результаты", Неопределено);
	Если ЭтоМассивоподобноеЗначение(Результаты) Тогда
		Для Индекс = 0 По Результаты.Количество() - 1 Цикл
			ЭлементРезультата = ПолучитьЭлементМассиваУниверсально(Результаты, Индекс);
			Если ЭлементРезультата = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДанныеЭлемента = ПолучитьСвойствоИзСтруктуры(ЭлементРезультата, "Данные", Неопределено);
			Если ДанныеЭлемента = Неопределено Тогда
				ДанныеЭлемента = ПолучитьСвойствоИзСтруктуры(ЭлементРезультата, "data", Неопределено);
			КонецЕсли;
			Если ДанныеЭлемента = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДанныеЗапроса = ПолучитьСвойствоИзСтруктуры(ДанныеЭлемента, "ДанныеЗапроса", Неопределено);
			Если ДанныеЗапроса = Неопределено Тогда
				ДанныеЗапроса = ПолучитьСвойствоИзСтруктуры(ДанныеЭлемента, "ДанныеЗапросаДляТаблицы", Неопределено);
			КонецЕсли;
			Если ДанныеЗапроса = Неопределено Тогда
				ДанныеЗапроса = ПолучитьСвойствоИзСтруктуры(ДанныеЭлемента, "rows", Неопределено);
			КонецЕсли;
			Если ДанныеЗапроса <> Неопределено Тогда
				Возврат ДанныеЗапроса;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

Функция ШагПланаСообщаетНайденныйОбъект(ШагПлана)
	Если ШагПлана = Неопределено ИЛИ ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстРезультата = ВРег(Строка(ПолучитьСвойствоИзСтруктуры(ШагПлана, "result_summary", "")));
	Возврат СтрНайти(ТекстРезультата, "НАЙДЕН") > 0
		ИЛИ СтрНайти(ТекстРезультата, "УЖЕ СУЩЕСТВУЕТ") > 0;
КонецФункции

Функция ПолучитьСообщениеИзУсловийShowInfo(ШагПлана, СсылкаДиалога)
	НайденоПоЗависимостям = Ложь;
	ЗависимостиShowInfo = ПолучитьСвойствоИзСтруктуры(ШагПлана, "depends_on", Неопределено);
	Если СсылкаДиалога <> Неопределено И ЭтоМассивоподобноеЗначение(ЗависимостиShowInfo) Тогда
		Для Каждого ИдЗависимостиShowInfo Из ЗависимостиShowInfo Цикл
			ШагЗависимости = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, Строка(ИдЗависимостиShowInfo));
			Если ШагПланаСообщаетНайденныйОбъект(ШагЗависимости) Тогда
				НайденоПоЗависимостям = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЖелаемоеУсловие = ?(НайденоПоЗависимостям, "FOUND", "NOT_FOUND");
	УсловиеОбъект = ПолучитьПараметрШагаПлана(ШагПлана, "condition", Неопределено);
	Если ТипЗнч(УсловиеОбъект) = Тип("Структура") ИЛИ ТипЗнч(УсловиеОбъект) = Тип("ФиксированнаяСтруктура") Тогда
		КлючВетки = ?(НайденоПоЗависимостям, "found", "not_found");
		Ветка = ПолучитьСвойствоИзСтруктуры(УсловиеОбъект, КлючВетки, Неопределено);
		Если Ветка <> Неопределено Тогда
			СообщениеВетки = Строка(ПолучитьСвойствоИзСтруктуры(Ветка, "message", ""));
			Если НЕ ПустаяСтрока(СообщениеВетки) Тогда
				Возврат СообщениеВетки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Условия = ПолучитьПараметрШагаПлана(ШагПлана, "conditions", Неопределено);
	Если НЕ ЭтоМассивоподобноеЗначение(Условия) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Условие Из Условия Цикл
		КлючУсловия = ВРег(Строка(ПолучитьСвойствоИзСтруктуры(Условие, "if", "")));
		Если КлючУсловия = ЖелаемоеУсловие Тогда
			Возврат Строка(ПолучитьСвойствоИзСтруктуры(Условие, "message", ""));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Условие Из Условия Цикл
		Сообщение = Строка(ПолучитьСвойствоИзСтруктуры(Условие, "message", ""));
		Если НЕ ПустаяСтрока(Сообщение) Тогда
			Возврат Сообщение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция РазрешитьЗначениеИзРезультатовПлана(СсылкаДиалога, ИсходноеЗначение)
	Если ТипЗнч(ИсходноеЗначение) <> Тип("Строка") Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;
	Выражение = СокрЛП(ИсходноеЗначение);
	Если СтрНайти(ВРег(Выражение), "STEP_") > 0 И Лев(ВРег(Выражение), 5) <> "STEP_" Тогда
		ИзвлеченныйStepId = ИзвлечьStepIdИзТекста(Выражение);
		Если НЕ ПустаяСтрока(ИзвлеченныйStepId) Тогда
			Выражение = ИзвлеченныйStepId;
		КонецЕсли;
	КонецЕсли;
	Если Лев(ВРег(Выражение), 9) = "РЕЗУЛЬТАТ " Тогда
		Выражение = СокрЛП(Сред(Выражение, 10));
	ИначеЕсли Лев(ВРег(Выражение), 12) = "РЕЗУЛЬТАТ ИЗ " Тогда
		Выражение = СокрЛП(Сред(Выражение, 13));
	КонецЕсли;
	ВыражениеВРег = ВРег(Выражение);
	Если Лев(ВыражениеВРег, 3) = "ИЗ " Тогда
		Выражение = СокрЛП(Сред(Выражение, 4));
		ВыражениеВРег = ВРег(Выражение);
	КонецЕсли;
	Если Лев(ВыражениеВРег, 5) <> "STEP_" Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;
	
	ПозТочки = СтрНайти(Выражение, ".");
	Если ПозТочки = 0 Тогда
		StepId = Выражение;
		Хвост = "";
	Иначе
		StepId = Лев(Выражение, ПозТочки - 1);
		Хвост = Сред(Выражение, ПозТочки + 1);
	КонецЕсли;
	
	ИмяПоля = "";
	Если Лев(ВРег(Хвост), 9) = "RESULT[0]" Тогда
		ПозПоля = СтрНайти(Хвост, "].");
		Если ПозПоля > 0 Тогда
			ИмяПоля = Сред(Хвост, ПозПоля + 2);
		КонецЕсли;
	Иначе
		ИмяПоля = Хвост;
	КонецЕсли;
	
	ШагПлана = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, StepId);
	Если ШагПлана = Неопределено Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;
	РезультатШага = ПолучитьСвойствоИзСтруктуры(ШагПлана, "result_data", Неопределено);
	Если РезультатШага = Неопределено Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;
	Данные = ИзвлечьДанныеИзРезультатаШагаПлана(РезультатШага);
	ПерваяСтрока = ПолучитьЭлементМассиваУниверсально(Данные, 0);
	Если ПерваяСтрока = Неопределено Тогда
		Возврат ИсходноеЗначение;
	КонецЕсли;
	Если ПустаяСтрока(ИмяПоля) Тогда
		СсылкаЗначение = ИзвлечьСсылочноеЗначениеИзРезультатаПлана(ПерваяСтрока);
		Если СсылкаЗначение <> Неопределено Тогда
			Возврат СсылкаЗначение;
		КонецЕсли;
		Возврат ПерваяСтрока;
	КонецЕсли;
	Возврат ПолучитьСвойствоИзСтруктуры(ПерваяСтрока, ИмяПоля, ИсходноеЗначение);
КонецФункции

Функция ИзвлечьСсылочноеЗначениеИзРезультатаПлана(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		СсылкаЗначение = ПолучитьСвойствоИзСтруктуры(Значение, "Ссылка", Неопределено);
		Если СсылкаЗначение <> Неопределено Тогда
			Возврат СсылкаЗначение;
		КонецЕсли;
		Для Каждого Пара Из Значение Цикл
			Кандидат = ИзвлечьСсылочноеЗначениеИзРезультатаПлана(Пара.Значение);
			Если Кандидат <> Неопределено Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Кандидат = ИзвлечьСсылочноеЗначениеИзРезультатаПлана(Элемент);
			Если Кандидат <> Неопределено Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗначения <> Тип("Строка")
		И ТипЗначения <> Тип("Число")
		И ТипЗначения <> Тип("Булево")
		И ТипЗначения <> Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОпределитьПолноеИмяОбъектаШагаПланаЛокально(ШагПлана)
	Если ШагПлана = Неопределено Или ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	KindКлюч = ВРег(Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "kind", "")));
	ПолноеИмяОбъекта = "";
	Если KindКлюч = "CREATE_DOCUMENT" Тогда
		ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "document_object", ""));
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "document_type", ""));
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "document", ""));
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = "Документ." + Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Или ПолноеИмяОбъекта = "Документ." Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "metadata_object", ""));
		КонецЕсли;
	ИначеЕсли KindКлюч = "CREATE_REFERENCE" Тогда
		ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = "Справочник." + Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Или ПолноеИмяОбъекта = "Справочник." Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "metadata_object", ""));
		КонецЕсли;
	ИначеЕсли KindКлюч = "RUN_QUERY" Тогда
		ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		КонецЕсли;
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(Строка(ПолучитьПараметрШагаПлана(ШагПлана, "query", "")));
		КонецЕсли;
	КонецЕсли;
	Возврат НормализоватьПолноеИмяОбъектаПоМетаданным(ПолноеИмяОбъекта);
КонецФункции

Функция ОпределитьЦелевойОбъектДляSetField(СсылкаДиалога, ШагПлана)
	Если СсылкаДиалога = Неопределено Или ШагПлана = Неопределено Или ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Зависимости = ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "depends_on", Неопределено);
	Если ТипЗнч(Зависимости) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Для Индекс = 0 По Зависимости.Количество() - 1 Цикл
		StepId = Строка(ПолучитьЭлементМассиваУниверсально(Зависимости, Индекс));
		Если ПустаяСтрока(StepId) Тогда
			Продолжить;
		КонецЕсли;
		ШагЗависимости = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, StepId);
		ПолноеИмяОбъекта = ОпределитьПолноеИмяОбъектаШагаПланаЛокально(ШагЗависимости);
		Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			Возврат ПолноеИмяОбъекта;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ОпределитьИсточникПолейДляSetField(СсылкаДиалога, ШагПлана)
	Если СсылкаДиалога = Неопределено Или ШагПлана = Неопределено Или ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	SourceStepId = ОпределитьSourceStepIdДляSetField(СсылкаДиалога, ШагПлана);
	Если ПустаяСтрока(SourceStepId) Тогда
		Возврат "";
	КонецЕсли;
	ШагИсточника = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, SourceStepId);
	Возврат ОпределитьПолноеИмяОбъектаШагаПланаЛокально(ШагИсточника);
КонецФункции

Функция ОпределитьSourceStepIdДляSetField(СсылкаДиалога, ШагПлана)
	Если СсылкаДиалога = Неопределено Или ШагПлана = Неопределено Или ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	SourceStepId = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "source_step", ""));
	Если НЕ ПустаяСтрока(SourceStepId) Тогда
		Возврат SourceStepId;
	КонецЕсли;
	Зависимости = ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "depends_on", Неопределено);
	Если ТипЗнч(Зависимости) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Для Индекс = 0 По Зависимости.Количество() - 1 Цикл
		КандидатStepId = Строка(ПолучитьЭлементМассиваУниверсально(Зависимости, Индекс));
		Если ПустаяСтрока(КандидатStepId) Тогда
			Продолжить;
		КонецЕсли;
		ШагЗависимости = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, КандидатStepId);
		Если ШагЗависимости = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		KindЗависимости = ВРег(Строка(ПолучитьСвойствоШагаПланаЛокально(ШагЗависимости, "kind", "")));
		Если KindЗависимости = "RUN_QUERY"
			ИЛИ KindЗависимости = "SELECT_OBJECT"
			ИЛИ KindЗависимости = "FIND_REFERENCE_BY_NAME"
			ИЛИ KindЗависимости = "FIND_REFERENCE_BY_GUID"
			ИЛИ KindЗависимости = "FIND_REFERENCE_BY_URL"
			ИЛИ KindЗависимости = "LOAD_FROM_STORAGE" Тогда
			Возврат КандидатStepId;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НормализоватьОдиночноеПолеПоМетаданным(ПолноеИмяОбъекта, ИмяПоля)
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат СокрЛП(Строка(ИмяПоля));
	КонецЕсли;
	Поля = Новый Массив;
	Поля.Добавить(ИмяПоля);
	НормПоля = НормализоватьПоляШагаПоМетаданным(ПолноеИмяОбъекта, Поля);
	Если ЭтоМассивоподобноеЗначение(НормПоля) И НормПоля.Количество() > 0 Тогда
		Возврат Строка(ПолучитьЭлементМассиваУниверсально(НормПоля, 0));
	КонецЕсли;
	Возврат СокрЛП(Строка(ИмяПоля));
КонецФункции

Функция ИзвлечьStepIdИзТекста(Текст)
	ТекстВРег = ВРег(Строка(Текст));
	ПозStep = СтрНайти(ТекстВРег, "STEP_");
	Если ПозStep = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(ТекстВРег, ПозStep);
	Результат = "";
	Для Позиция = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Позиция, 1);
		Если (Символ >= "A" И Символ <= "Z") ИЛИ (Символ >= "0" И Символ <= "9") ИЛИ Символ = "_" Тогда
			Результат = Результат + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НРег(Результат);
КонецФункции

Процедура ДобавитьШагВСценарийDSL(Шаги, Действие, Параметры = Неопределено)
	Если Шаги = Неопределено ИЛИ ТипЗнч(Шаги) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Шаг = Новый Структура;
	Шаг.Вставить("action", Действие);
	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из Параметры Цикл
				Шаг.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		ИначеЕсли ТипЗнч(Параметры) = Тип("Соответствие") Тогда
			Для Каждого КлючИЗначение Из Параметры Цикл
				Шаг.Вставить(Строка(КлючИЗначение.Ключ), КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Шаги.Добавить(Шаг);
КонецПроцедуры

Функция ПолучитьСледующийШагПланаДляВосстановления(СсылкаДиалога)
	Если СсылкаДиалога = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИИА_TypedPlan.ПолучитьСледующийШагПлана(СсылкаДиалога);
КонецФункции

Функция СобратьПолноеИмяОбъектаИзШагаПлана(ШагПлана)
	ЗначениеОбъекта = ПолучитьПараметрШагаПлана(ШагПлана, "object", Неопределено);
	Если ЗначениеОбъекта = Неопределено Тогда
		ЗначениеОбъекта = ПолучитьПараметрШагаПлана(ШагПлана, "document_object", Неопределено);
	КонецЕсли;
	Если ЗначениеОбъекта = Неопределено Тогда
		ЗначениеОбъекта = ПолучитьПараметрШагаПлана(ШагПлана, "object_path", Неопределено);
	КонецЕсли;
	ОбъектШага = СтрокаИмениОбъектаИзЗначенияШага(ЗначениеОбъекта);
	ТипОбъектаПлана = СтрокаИмениОбъектаИзЗначенияШага(ПолучитьПараметрШагаПлана(ШагПлана, "object_type", Неопределено));
	ИмяОбъектаПлана = СтрокаИмениОбъектаИзЗначенияШага(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", Неопределено));
	ТипНорм = ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(ТипОбъектаПлана);
	Если ПустаяСтрока(ТипНорм) Или (ТипНорм = СокрЛП(ТипОбъектаПлана) И СтрНайти(ТипНорм, ".") = 0
		И ВРег(ТипНорм) <> "ДОКУМЕНТ" И ВРег(ТипНорм) <> "СПРАВОЧНИК"
		И ВРег(ТипНорм) <> "РЕГИСТРНАКОПЛЕНИЯ" И ВРег(ТипНорм) <> "РЕГИСТРСВЕДЕНИЙ"
		И ВРег(ТипНорм) <> "РЕГИСТРБУХГАЛТЕРИИ") Тогда
		ТипИзОбъекта = ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(ОбъектШага);
		Если ТипИзОбъекта = "Документ" Или ТипИзОбъекта = "Справочник"
			Или ТипИзОбъекта = "РегистрНакопления" Или ТипИзОбъекта = "РегистрСведений"
			Или ТипИзОбъекта = "РегистрБухгалтерии" Тогда
			ТипНорм = ТипИзОбъекта;
			ОбъектШага = "";
		КонецЕсли;
	КонецЕсли;
	Если (ПустаяСтрока(ОбъектШага) Или СтрНайти(ОбъектШага, ".") = 0)
		И НЕ ПустаяСтрока(ТипНорм) И НЕ ПустаяСтрока(ИмяОбъектаПлана)
		И СтрНайти(ИмяОбъектаПлана, ".") = 0 Тогда
		ОбъектШага = ТипНорм + "." + ИмяОбъектаПлана;
	КонецЕсли;
	Если ПустаяСтрока(ОбъектШага) Тогда
		ОбъектШага = ИмяОбъектаПлана;
	КонецЕсли;
	Возврат НормализоватьПолноеИмяОбъектаПоМетаданным(ОбъектШага);
КонецФункции

Функция СтрокаИмениОбъектаИзЗначенияШага(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура")
		Или ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		ИмяОбъекта = СокрЛП(Строка(ПолучитьСвойствоИзСтруктуры(Значение, "name", "")));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = СокрЛП(Строка(ПолучитьСвойствоИзСтруктуры(Значение, "object_name", "")));
		КонецЕсли;
		ТипОбъекта = СокрЛП(Строка(ПолучитьСвойствоИзСтруктуры(Значение, "type", "")));
		Если ПустаяСтрока(ТипОбъекта) Тогда
			ТипОбъекта = СокрЛП(Строка(ПолучитьСвойствоИзСтруктуры(Значение, "object_type", "")));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			Возврат "";
		КонецЕсли;
		Если СтрНайти(ИмяОбъекта, ".") > 0 Или ПустаяСтрока(ТипОбъекта) Тогда
			Возврат ИмяОбъекта;
		КонецЕсли;
		ТипНорм = ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(ТипОбъекта);
		Если ПустаяСтрока(ТипНорм) Тогда
			Возврат ИмяОбъекта;
		КонецЕсли;
		Возврат ТипНорм + "." + ИмяОбъекта;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если ВРег(Текст) = "СООТВЕТСТВИЕ" Или ВРег(Текст) = "СТРУКТУРА" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПостроитьDSLИзШагаПлана(ШагПлана, НомерПункта = 1, СсылкаДиалога = Неопределено) Экспорт
	Если ШагПлана = Неопределено ИЛИ ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Kind = ?(ШагПлана.Свойство("kind"), Строка(ШагПлана.kind), "");
	Если ПустаяСтрока(Kind) Тогда
		QueryКандидат = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "query", ""));
		Если НЕ ПустаяСтрока(QueryКандидат) Тогда
			Kind = "RUN_QUERY";
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	KindКлюч = ВРег(Kind);

	Шаг = Новый Структура;
	ОперацияИД = "recovered_plan_step_" + Строка(НомерПункта) + "_" + Kind;

	Если KindКлюч = "DSL_TEMPLATE" Тогда
		DSLШаблон = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "dsl", ""));
		Если ПустаяСтрока(DSLШаблон) Тогда
			Возврат "";
		КонецЕсли;
		Возврат DSLШаблон;
	ИначеЕсли KindКлюч = "RUN_QUERY" Тогда
		ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		КонецЕсли;
		ПараметрыЗапроса = ПолучитьПараметрШагаПлана(ШагПлана, "parameters", Неопределено);
		ЯвныйQuery = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "query", ""));
		QueryТекст = ПостроитьRunQueryИзШагаПлана(ШагПлана, СсылкаДиалога);
		Если ПустаяСтрока(QueryТекст) Тогда
			Возврат "";
		КонецЕсли;
		ОбъектИзПостроенногоЗапроса = НормализоватьПолноеИмяОбъектаПоМетаданным(ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаПровайдера(QueryТекст));
		Если НЕ ПустаяСтрока(ОбъектИзПостроенногоЗапроса) Тогда
			ПолноеИмяОбъекта = ОбъектИзПостроенногоЗапроса;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) И (ПустаяСтрока(ЯвныйQuery) Или Лев(ВРег(СокрЛП(ЯвныйQuery)), 7) <> "ВЫБРАТЬ") Тогда
			РазборОбъекта = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
			DSLСтруктура = Новый Структура;
			DSLСтруктура.Вставить("dsl_version", 2);
			Шаги = Новый Массив;
			ПоляУжеПодтверждены = СсылкаДиалога <> Неопределено
				И (НЕ ПустаяСтрока(НайтиПодтвержденныйОбъектИзПлана(СсылкаДиалога))
					Или ИИА_Сервер.ПоляОбъектаЕстьВКэшеМетаданных(СсылкаДиалога, РазборОбъекта.ObjectType, РазборОбъекта.ObjectName));
			Если СсылкаДиалога = Неопределено Или НЕ ПоляУжеПодтверждены Тогда
				ШагУточнения = Новый Структура;
				ШагУточнения.Вставить("action", "GetObjectFields");
				ШагУточнения.Вставить("object_type", РазборОбъекта.ObjectType);
				ШагУточнения.Вставить("object_name", РазборОбъекта.ObjectName);
				Шаги.Добавить(ШагУточнения);
			КонецЕсли;
			ШагЗапроса = Новый Структура;
			ШагЗапроса.Вставить("action", "RunQuery");
			ШагЗапроса.Вставить("query", QueryТекст);
			Если ПараметрыЗапроса <> Неопределено Тогда
				ШагЗапроса.Вставить("parameters", ПараметрыЗапроса);
			КонецЕсли;
			Если ЗначениеФлагаНеограниченногоРежимаШагаПлана(ШагПлана) Тогда
				ШагЗапроса.Вставить("unlimited", Истина);
			КонецЕсли;
			Шаги.Добавить(ШагЗапроса);
			DSLСтруктура.Вставить("steps", Шаги);
			Возврат СериализоватьJSONВСтроку(DSLСтруктура);
		КонецЕсли;
		Шаг.Вставить("action", "RunQuery");
		Шаг.Вставить("query", QueryТекст);
		Если ПараметрыЗапроса <> Неопределено Тогда
			Шаг.Вставить("parameters", ПараметрыЗапроса);
		КонецЕсли;
		Если ЗначениеФлагаНеограниченногоРежимаШагаПлана(ШагПлана) Тогда
			Шаг.Вставить("unlimited", Истина);
		КонецЕсли;
	ИначеЕсли KindКлюч = "CREATE_REFERENCE" Тогда
		Шаг.Вставить("action", "CreateReference");
		ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_type", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "metadata_object", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "metadata", ""));
		КонецЕсли;
		ИмяОбъекта = НормализоватьПолноеИмяОбъектаПоМетаданным(ИмяОбъекта);
		Если СтрНайти(ИмяОбъекта, ".") > 0 Тогда
			ИмяОбъекта = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
		КонецЕсли;
		Шаг.Вставить("object_name", ИмяОбъекта);
		Имя = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "name", ""));
		Если ПустаяСтрока(Имя) Тогда
			Имя = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "fallback_name", ""));
		КонецЕсли;
		ДанныеСоздания = ПолучитьПараметрШагаПлана(ШагПлана, "data", Неопределено);
		Если ДанныеСоздания = Неопределено Тогда
			ДанныеСоздания = ПолучитьПараметрШагаПлана(ШагПлана, "fields", Неопределено);
		КонецЕсли;
		Если ПустаяСтрока(Имя) Тогда
			ИмяИзДанных = ПолучитьСвойствоИзСтруктуры(ДанныеСоздания, "Наименование", "");
			Если НЕ ПустаяСтрока(Строка(ИмяИзДанных)) Тогда
				Имя = Строка(ИмяИзДанных);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Имя) Тогда
			Шаг.Вставить("name", Имя);
		КонецЕсли;
		Если ДанныеСоздания <> Неопределено Тогда
			Шаг.Вставить("data", ДанныеСоздания);
		КонецЕсли;
		Шаг.Вставить("operation_id", ОперацияИД);
	ИначеЕсли KindКлюч = "CREATE_DOCUMENT" Тогда
		Шаг.Вставить("action", "CreateDocument");
		ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "document_object", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "document_type", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "document", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "metadata_object", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_path", ""));
		КонецЕсли;
		ИмяОбъекта = СтрокаИмениОбъектаИзЗначенияШага(ИмяОбъекта);
		ИмяОбъекта = НормализоватьПолноеИмяОбъектаПоМетаданным(ИмяОбъекта);
		Если СтрНайти(ИмяОбъекта, ".") > 0 Тогда
			ИмяОбъекта = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
		КонецЕсли;
		Шаг.Вставить("object_name", ИмяОбъекта);
		ДанныеСоздания = ПолучитьПараметрШагаПлана(ШагПлана, "data", Неопределено);
		Если ДанныеСоздания = Неопределено Тогда
			ДанныеСоздания = ПолучитьПараметрШагаПлана(ШагПлана, "fields", Неопределено);
		КонецЕсли;
		Если ДанныеСоздания <> Неопределено Тогда
			Шаг.Вставить("data", ДанныеСоздания);
		КонецЕсли;
		Шаг.Вставить("operation_id", ОперацияИД);
		ЗаписатьПослеСоздания = Истина;
		Если ЗаписатьПослеСоздания Тогда
			DSLСтруктура = Новый Структура;
			DSLСтруктура.Вставить("dsl_version", 2);
			ШагиDSL = Новый Массив;
			ШагиDSL.Добавить(Шаг);
			ШагиDSL.Добавить(Новый Структура("action,operation_id", "Write", ОперацияИД + "_write"));
			DSLСтруктура.Вставить("steps", ШагиDSL);
			Возврат СериализоватьJSONВСтроку(DSLСтруктура);
		КонецЕсли;
	ИначеЕсли KindКлюч = "SET_FIELD" Тогда
		ИмяПоля = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "field", ""));
		Если ПустаяСтрока(ИмяПоля) Тогда
			ИмяПоля = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "field_name", ""));
		КонецЕсли;
		ЗначениеПоля = ПолучитьПараметрШагаПлана(ШагПлана, "value", "");
		КартаПолей = ПолучитьПараметрШагаПлана(ШагПлана, "fields", Неопределено);
		Если КартаПолей = Неопределено Тогда
			КартаПолей = ПолучитьПараметрШагаПлана(ШагПлана, "fields_to_set", Неопределено);
		КонецЕсли;
		SourceStepId = ОпределитьSourceStepIdДляSetField(СсылкаДиалога, ШагПлана);
		ЦелевойОбъект = ОпределитьЦелевойОбъектДляSetField(СсылкаДиалога, ШагПлана);
		ИсточникПолей = ОпределитьИсточникПолейДляSetField(СсылкаДиалога, ШагПлана);
		Если КартаПолей <> Неопределено И (ТипЗнч(КартаПолей) = Тип("Структура") ИЛИ ТипЗнч(КартаПолей) = Тип("Соответствие")) Тогда
			DSLСтруктура = Новый Структура;
			DSLСтруктура.Вставить("dsl_version", 2);
			ШагиDSL = Новый Массив;
			СчетчикПоля = 0;
			Для Каждого Поле Из КартаПолей Цикл
				СчетчикПоля = СчетчикПоля + 1;
				ИмяПоляКарты = ?(ТипЗнч(КартаПолей) = Тип("Структура"), Поле.Ключ, Строка(Поле.Ключ));
				ИмяПоляКарты = НормализоватьОдиночноеПолеПоМетаданным(ЦелевойОбъект, ИмяПоляКарты);
				ЗначениеПоляКарты = Поле.Значение;
				Если СсылкаДиалога <> Неопределено Тогда
					ЗначениеПоляКарты = РазрешитьЗначениеИзРезультатовПлана(СсылкаДиалога, ЗначениеПоляКарты);
				КонецЕсли;
				ДобавитьШагВСценарийDSL(ШагиDSL, "SetField", Новый Структура("field,value,operation_id", ИмяПоляКарты, ЗначениеПоляКарты, ОперацияИД + "_" + Строка(СчетчикПоля)));
			КонецЦикла;
			Если ШагиDSL.Количество() = 0 Тогда
				Возврат "";
			КонецЕсли;
			DSLСтруктура.Вставить("steps", ШагиDSL);
			Возврат СериализоватьJSONВСтроку(DSLСтруктура);
		КонецЕсли;
		Если ЭтоМассивоподобноеЗначение(КартаПолей) Тогда
			DSLСтруктура = Новый Структура;
			DSLСтруктура.Вставить("dsl_version", 2);
			ШагиDSL = Новый Массив;
			СчетчикПоля = 0;
			Для ИндексПоля = 0 По КартаПолей.Количество() - 1 Цикл
				ИмяПоляИзМассива = Строка(ПолучитьЭлементМассиваУниверсально(КартаПолей, ИндексПоля));
				Если ПустаяСтрока(ИмяПоляИзМассива) Тогда
					Продолжить;
				КонецЕсли;
				СчетчикПоля = СчетчикПоля + 1;
				НормИмяПоля = НормализоватьОдиночноеПолеПоМетаданным(ЦелевойОбъект, ИмяПоляИзМассива);
				ИмяПоляИсточника = НормализоватьОдиночноеПолеПоМетаданным(ИсточникПолей, ИмяПоляИзМассива);
				ЗначениеПоляКарты = ?(НЕ ПустаяСтрока(SourceStepId), SourceStepId + "." + ИмяПоляИсточника, ИмяПоляИзМассива);
				Если СсылкаДиалога <> Неопределено Тогда
					ЗначениеПоляКарты = РазрешитьЗначениеИзРезультатовПлана(СсылкаДиалога, ЗначениеПоляКарты);
				КонецЕсли;
				ДобавитьШагВСценарийDSL(ШагиDSL, "SetField", Новый Структура("field,value,operation_id", НормИмяПоля, ЗначениеПоляКарты, ОперацияИД + "_" + Строка(СчетчикПоля)));
			КонецЦикла;
			Если ШагиDSL.Количество() = 0 Тогда
				Возврат "";
			КонецЕсли;
			DSLСтруктура.Вставить("steps", ШагиDSL);
			Возврат СериализоватьJSONВСтроку(DSLСтруктура);
		КонецЕсли;
		Если СсылкаДиалога <> Неопределено Тогда
			ЗначениеПоля = РазрешитьЗначениеИзРезультатовПлана(СсылкаДиалога, ЗначениеПоля);
		КонецЕсли;
		Шаг.Вставить("action", "SetField");
		Шаг.Вставить("field", НормализоватьОдиночноеПолеПоМетаданным(ЦелевойОбъект, ИмяПоля));
		Шаг.Вставить("value", ЗначениеПоля);
		Шаг.Вставить("operation_id", ОперацияИД);
	ИначеЕсли KindКлюч = "WRITE_OBJECT" Тогда
		Шаг.Вставить("action", "Write");
		Шаг.Вставить("operation_id", ОперацияИД);
	ИначеЕсли KindКлюч = "SHOW_INFO" Тогда
		Шаг.Вставить("action", "ShowInfo");
		Сообщение = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "message", ""));
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = ПолучитьСообщениеИзУсловийShowInfo(ШагПлана, СсылкаДиалога);
		КонецЕсли;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "message_found", ""));
		КонецЕсли;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "message_on_found", ""));
		КонецЕсли;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "message_not_found", ""));
		КонецЕсли;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "message_on_not_found", ""));
		КонецЕсли;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = ?(ШагПлана.Свойство("title"), Строка(ШагПлана.title), "Шаг плана выполнен.");
		КонецЕсли;
		ЗависимостиShowInfo = ПолучитьСвойствоИзСтруктуры(ШагПлана, "depends_on", Неопределено);
		Если СсылкаДиалога <> Неопределено И ЭтоМассивоподобноеЗначение(ЗависимостиShowInfo) Тогда
			Для Каждого ИдЗависимостиShowInfo Из ЗависимостиShowInfo Цикл
				ШагЗависимостиShowInfo = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, Строка(ИдЗависимостиShowInfo));
				Если ШагЗависимостиShowInfo = Неопределено
					ИЛИ ВРег(Строка(ПолучитьСвойствоИзСтруктуры(ШагЗависимостиShowInfo, "kind", ""))) <> "RUN_QUERY" Тогда
					Продолжить;
				КонецЕсли;
				ДанныеЗависимогоЗапроса = ИзвлечьДанныеИзРезультатаШагаПлана(ПолучитьСвойствоИзСтруктуры(ШагЗависимостиShowInfo, "result_data", Неопределено));
				Если ЭтоМассивоподобноеЗначение(ДанныеЗависимогоЗапроса) Тогда
					Сообщение = Сообщение + Символы.ПС + "Результат запроса: строк " + Строка(ДанныеЗависимогоЗапроса.Количество()) + ".";
					Если ДанныеЗависимогоЗапроса.Количество() > 0 Тогда
						ПерваяСтрокаЗапроса = ПолучитьЭлементМассиваУниверсально(ДанныеЗависимогоЗапроса, 0);
						Если ТипЗнч(ПерваяСтрокаЗапроса) = Тип("Структура") ИЛИ ТипЗнч(ПерваяСтрокаЗапроса) = Тип("ФиксированнаяСтруктура") Тогда
							ТекстПервойСтроки = "";
							Для Каждого ПараПервойСтроки Из ПерваяСтрокаЗапроса Цикл
								Если НЕ ПустаяСтрока(ТекстПервойСтроки) Тогда
									ТекстПервойСтроки = ТекстПервойСтроки + "; ";
								КонецЕсли;
								ТекстПервойСтроки = ТекстПервойСтроки + Строка(ПараПервойСтроки.Ключ) + ": " + Строка(ПараПервойСтроки.Значение);
							КонецЦикла;
							Если НЕ ПустаяСтрока(ТекстПервойСтроки) Тогда
								Сообщение = Сообщение + Символы.ПС + "1. " + ТекстПервойСтроки;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Шаг.Вставить("message", Сообщение);
	ИначеЕсли KindКлюч = "GET_METADATA" Тогда
		Шаг.Вставить("action", "GetMetadata");
		ФильтрШага = ПолучитьПараметрШагаПлана(ШагПлана, "filter", Неопределено);
		Фильтр = ИИА_Метаданные.СтрокаФильтраМетаданных(ФильтрШага);
		Если ПустаяСтрока(Фильтр) Тогда
			Фильтр = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "object_name", ""));
		КонецЕсли;
		Если НЕ ПустаяСтрока(Фильтр) Тогда
			Шаг.Вставить("filter", Фильтр);
		КонецЕсли;
	ИначеЕсли KindКлюч = "GET_OBJECT_FIELDS" Тогда
		Шаг.Вставить("action", "GetObjectFields");
		ПолноеИмяОбъекта = СобратьПолноеИмяОбъектаИзШагаПлана(ШагПлана);
		Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = ПодобратьПолноеИмяОбъектаДляУточненияПолей(ШагПлана, СсылкаДиалога);
		КонецЕсли;
		Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
			Возврат "";
		КонецЕсли;
		РазборОбъекта = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
		Шаг.Вставить("object_type", ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(РазборОбъекта.ObjectType));
		Шаг.Вставить("object_name", РазборОбъекта.ObjectName);
	ИначеЕсли KindКлюч = "CHECK_OBJECT_EXISTS" Тогда
		Шаг.Вставить("action", "CheckObjectExists");
		ПолноеИмяОбъекта = СобратьПолноеИмяОбъектаИзШагаПлана(ШагПлана);
		Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
			ПолноеИмяОбъекта = ПодобратьПолноеИмяОбъектаДляУточненияПолей(ШагПлана, СсылкаДиалога);
		КонецЕсли;
		Если НЕ ЭтоКаноническоеПолноеИмяМетаданных(ПолноеИмяОбъекта) Тогда
			Возврат "";
		КонецЕсли;
		РазборОбъекта = РазобратьПолноеИмяОбъекта(ПолноеИмяОбъекта);
		Шаг.Вставить("object_type", ИИА_DSLQuerySafety.НормализоватьТипОбъектаМетаданных(РазборОбъекта.ObjectType));
		Шаг.Вставить("object_name", РазборОбъекта.ObjectName);
	ИначеЕсли KindКлюч = "FIND_REFERENCE_BY_NAME" Тогда
		ИмяОбъекта = СобратьПолноеИмяОбъектаИзШагаПлана(ШагПлана);
		Имя = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "value", ""));
		Если ПустаяСтрока(Имя) Тогда
			Имя = Строка(ПолучитьПараметрШагаПлана(ШагПлана, "name", ""));
		КонецЕсли;
		Если ВРег(Лев(СокрЛП(ИмяОбъекта), СтрДлина("Документ."))) = "ДОКУМЕНТ." Тогда
			DSLПоискаДокумента = ПостроитьDSLПоискаДокументаПоНомеру(НормализоватьПолноеИмяОбъектаПоМетаданным(ИмяОбъекта), Имя);
			Если НЕ ПустаяСтрока(DSLПоискаДокумента) Тогда
				Возврат DSLПоискаДокумента;
			КонецЕсли;
		КонецЕсли;
		Шаг.Вставить("action", "FindReferenceByName");
		ИмяОбъекта = ОпределитьИмяСправочникаДляFindReference(ШагПлана, ИмяОбъекта);
		ИмяОбъекта = НормализоватьПолноеИмяОбъектаПоМетаданным(ИмяОбъекта);
		Если СтрНайти(ИмяОбъекта, ".") > 0 Тогда
			ИмяОбъекта = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
		КонецЕсли;
		ИмяОбъекта = ОпределитьИмяСправочникаДляFindReference(ШагПлана, ИмяОбъекта);
		ИмяОбъекта = НормализоватьИмяСправочникаПоРоли(ИмяОбъекта);
		Шаг.Вставить("object_name", ИмяОбъекта);
		Шаг.Вставить("name", Имя);
		Если ПолучитьПараметрШагаПлана(ШагПлана, "allow_not_found", Ложь) Тогда
			Шаг.Вставить("allow_not_found", Истина);
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;

	DSLСтруктура = Новый Структура;
	DSLСтруктура.Вставить("dsl_version", 2);
	Шаги = Новый Массив;
	Шаги.Добавить(Шаг);
	DSLСтруктура.Вставить("steps", Шаги);
	Возврат СериализоватьJSONВСтроку(DSLСтруктура);
КонецФункции

Функция ИзвлечьШагиИзDSLJSON(DSL_JSON)
	Если ПустаяСтрока(DSL_JSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ИИА_DSL.НормализоватьJSONТекст(DSL_JSON));
		DSLСтруктура = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Если ТипЗнч(DSLСтруктура) = Тип("Структура")
			И DSLСтруктура.Свойство("steps")
			И ТипЗнч(DSLСтруктура.steps) = Тип("Массив") Тогда
			Возврат DSLСтруктура.steps;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьСвойствоШагаПланаЛокально(Значение, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство(ИмяСвойства) Тогда
		Возврат Значение[ИмяСвойства];
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") И Значение.Свойство(ИмяСвойства) Тогда
		Возврат Значение[ИмяСвойства];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ЭтоСтартЦепочкиЗаписывающегоКонтекста(Kind)
	KindВРег = ВРег(СокрЛП(Строка(Kind)));
	Возврат KindВРег = "CREATE_DOCUMENT"
		ИЛИ KindВРег = "CREATE_REFERENCE"
		ИЛИ KindВРег = "FIND_REFERENCE_BY_NAME";
КонецФункции

Функция ЭтоПродолжениеЦепочкиЗаписывающегоКонтекста(Kind)
	KindВРег = ВРег(СокрЛП(Строка(Kind)));
	Возврат KindВРег = "SET_FIELD"
		ИЛИ KindВРег = "WRITE_OBJECT"
		ИЛИ KindВРег = "SHOW_INFO";
КонецФункции

Функция МожноВключитьШагВЦепочкуDSL(ШагПлана, УжеВключенныеШаги, СсылкаДиалога)
	Если ШагПлана = Неопределено ИЛИ ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ШагПлана.Свойство("status") И ВРег(Строка(ШагПлана.status)) = "DONE" Тогда
		Возврат Ложь;
	КонецЕсли;
	Зависимости = ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "depends_on", Неопределено);
	Если ТипЗнч(Зависимости) = Тип("Массив") Тогда
		Для Индекс = 0 По Зависимости.Количество() - 1 Цикл
			Зависимость = Строка(ПолучитьЭлементМассиваУниверсально(Зависимости, Индекс));
			Если ПустаяСтрока(Зависимость) Тогда
				Продолжить;
			КонецЕсли;
			Если УжеВключенныеШаги.Найти(ВРег(Зависимость)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ШагЗависимости = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, Зависимость);
			Если ШагЗависимости = Неопределено
				ИЛИ НЕ ШагЗависимости.Свойство("status")
				ИЛИ ВРег(Строка(ШагЗависимости.status)) <> "DONE" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "kind", ""))) = "SET_FIELD" Тогда
		КартаПолей = ПолучитьПараметрШагаПлана(ШагПлана, "fields", Неопределено);
		Если КартаПолей <> Неопределено И (ТипЗнч(КартаПолей) = Тип("Структура") ИЛИ ТипЗнч(КартаПолей) = Тип("Соответствие")) Тогда
			Для Каждого Поле Из КартаПолей Цикл
				ЗначениеПоляКарты = Поле.Значение;
				Если СсылкаДиалога <> Неопределено Тогда
					ЗначениеПоляКарты = РазрешитьЗначениеИзРезультатовПлана(СсылкаДиалога, ЗначениеПоляКарты);
				КонецЕсли;
				Если ТипЗнч(ЗначениеПоляКарты) = Тип("Строка") И Лев(ВРег(СокрЛП(ЗначениеПоляКарты)), 5) = "STEP_" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ЗначениеПоля = ПолучитьПараметрШагаПлана(ШагПлана, "value", "");
			Если СсылкаДиалога <> Неопределено Тогда
				ЗначениеПоля = РазрешитьЗначениеИзРезультатовПлана(СсылкаДиалога, ЗначениеПоля);
			КонецЕсли;
			Если ТипЗнч(ЗначениеПоля) = Тип("Строка") И Лев(ВРег(СокрЛП(ЗначениеПоля)), 5) = "STEP_" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПостроитьDSLИзЦепочкиШаговПлана(СсылкаДиалога, СтартовыйШаг) Экспорт
	Если СсылкаДиалога = Неопределено
		ИЛИ СтартовыйШаг = Неопределено
		ИЛИ ТипЗнч(СтартовыйШаг) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ ЭтоСтартЦепочкиЗаписывающегоКонтекста(ПолучитьСвойствоШагаПланаЛокально(СтартовыйШаг, "kind", "")) Тогда
		Возврат "";
	КонецЕсли;
	План = ИИА_TypedPlan.ПолучитьTypedPlan(СсылкаДиалога);
	Если План = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ План.Свойство("steps") ИЛИ ТипЗнч(План.steps) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	СтартStepId = Строка(ПолучитьСвойствоШагаПланаЛокально(СтартовыйШаг, "id", ""));
	Если ПустаяСтрока(СтартStepId) Тогда
		Возврат "";
	КонецЕсли;
	ШагиDSL = Новый Массив;
	УжеВключенныеШаги = Новый Массив;
	Начали = Ложь;
	НомерПункта = 0;
	Для Каждого ШагПлана Из План.steps Цикл
		НомерПункта = НомерПункта + 1;
		ТекущийStepId = Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "id", ""));
		Если НЕ Начали Тогда
			Если ВРег(ТекущийStepId) <> ВРег(СтартStepId) Тогда
				Продолжить;
			КонецЕсли;
			Начали = Истина;
		КонецЕсли;
		KindШага = Строка(ПолучитьСвойствоШагаПланаЛокально(ШагПлана, "kind", ""));
		Если ВРег(ТекущийStepId) <> ВРег(СтартStepId) И НЕ ЭтоПродолжениеЦепочкиЗаписывающегоКонтекста(KindШага) Тогда
			Прервать;
		КонецЕсли;
		Если НЕ МожноВключитьШагВЦепочкуDSL(ШагПлана, УжеВключенныеШаги, СсылкаДиалога) Тогда
			Прервать;
		КонецЕсли;
		DSLШага = ИИА_DSLПостроитель.ПостроитьDSLИзШагаПлана(ШагПлана, НомерПункта, СсылкаДиалога);
		ШагиDSLШага = ИзвлечьШагиИзDSLJSON(DSLШага);
		Если ШагиDSLШага = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ТипЗнч(ШагиDSLШага) <> Тип("Массив") ИЛИ ШагиDSLШага.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Для Каждого DSLШаг Из ШагиDSLШага Цикл
			ШагиDSL.Добавить(DSLШаг);
		КонецЦикла;
		УжеВключенныеШаги.Добавить(ВРег(ТекущийStepId));
	КонецЦикла;
	Если ШагиDSL.Количество() <= 1 Тогда
		Возврат "";
	КонецЕсли;
	DSLСтруктура = Новый Структура;
	DSLСтруктура.Вставить("dsl_version", 2);
	DSLСтруктура.Вставить("steps", ШагиDSL);
	Возврат СериализоватьJSONВСтроку(DSLСтруктура);
КонецФункции

Функция ПопыткаВосстановитьDSLИзТекущегоПлана(ПараметрыИИ) Экспорт
	Если ПараметрыИИ = Неопределено ИЛИ ТипЗнч(ПараметрыИИ) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ ПараметрыИИ.Свойство("СсылкаДиалога") ИЛИ ПараметрыИИ.СсылкаДиалога = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ШагПлана = ПолучитьСледующийШагПланаДляВосстановления(ПараметрыИИ.СсылкаДиалога);
	Если ШагПлана = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	НомерПункта = ?(ШагПлана.Свойство("seq_no"), Число(ШагПлана.seq_no), 1);
	DSL_JSON = ИИА_DSLПостроитель.ПостроитьDSLИзШагаПлана(ШагПлана, НомерПункта, ПараметрыИИ.СсылкаДиалога);
	Если ПустаяСтрока(DSL_JSON) Тогда
		Возврат "";
	КонецЕсли;
	
	РезультатПроверки = ИИА_DSL.ПроверитьDSL(DSL_JSON);
	Если НЕ РезультатПроверки.Успех Тогда
		Возврат "";
	КонецЕсли;
	
	ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(ПараметрыИИ.СсылкаДиалога, "[CONTRACT_RECOVERED] submit_dsl восстановлен из текущего шага typed plan");
	Возврат DSL_JSON;
КонецФункции

Функция ПопыткаВосстановитьNextStepDSLИзТекущегоПлана(ПараметрыИИ, StepId = "") Экспорт
	Если ПараметрыИИ = Неопределено ИЛИ ТипЗнч(ПараметрыИИ) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ПараметрыИИ.Свойство("СсылкаДиалога") ИЛИ ПараметрыИИ.СсылкаДиалога = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ШагПлана = Неопределено;
	Если НЕ ПустаяСтрока(Строка(StepId)) Тогда
		ШагПлана = ИИА_TypedPlan.ПолучитьШагПланаПоИдентификатору(ПараметрыИИ.СсылкаДиалога, StepId);
	КонецЕсли;
	Если ШагПлана = Неопределено Тогда
		ШагПлана = ПолучитьСледующийШагПланаДляВосстановления(ПараметрыИИ.СсылкаДиалога);
	КонецЕсли;
	Если ШагПлана = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НомерПункта = ?(ШагПлана.Свойство("seq_no"), Число(ШагПлана.seq_no), 1);
	DSL_JSON = ИИА_DSLПостроитель.ПостроитьDSLИзЦепочкиШаговПлана(ПараметрыИИ.СсылкаДиалога, ШагПлана);
	Если ПустаяСтрока(DSL_JSON) Тогда
		DSL_JSON = ИИА_DSLПостроитель.ПостроитьDSLИзШагаПлана(ШагПлана, НомерПункта, ПараметрыИИ.СсылкаДиалога);
	КонецЕсли;
	Если ПустаяСтрока(DSL_JSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПроверкаDSL = ИИА_DSL.ПроверитьDSL(DSL_JSON);
	Если НЕ ПроверкаDSL.Успех Тогда
		Возврат Неопределено;
	КонецЕсли;
	KindКлюч = ВРег(?(ШагПлана.Свойство("kind"), Строка(ШагПлана.kind), ""));
	Если ЭтоШагЗаписиПлана(KindКлюч) И ЛокальныйDSLСодержитЧужойRunQuery(DSL_JSON, KindКлюч) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = СоздатьБазовыйРезультатИИ();
	Результат.ТипОтвета = "DSL";
	Результат.DSL = DSL_JSON;
	Результат.ВыполнитьDSL = Истина;
	Результат.PlanStepId = ?(ШагПлана.Свойство("id"), Строка(ШагПлана.id), Строка(StepId));
	Результат.Текст = DSL_JSON;
	Результат.RawModelText = DSL_JSON;
	ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(ПараметрыИИ.СсылкаДиалога, "[CONTRACT_RECOVERED] submit_next_step восстановлен локально из typed step " + Результат.PlanStepId);
	Возврат Результат;
КонецФункции

Функция ПопыткаЛокальноСгенерироватьNextStepDSL(СсылкаДиалога, StepId = "") Экспорт
	ПараметрыИИ = Новый Структура("СсылкаДиалога", СсылкаДиалога);
	Возврат ИИА_DSLПостроитель.ПопыткаВосстановитьNextStepDSLИзТекущегоПлана(ПараметрыИИ, StepId);
КонецФункции

Функция ЭтоШагЗаписиПлана(KindКлюч)
	Ключ = ВРег(СокрЛП(Строка(KindКлюч)));
	Возврат Ключ = "CREATE_DOCUMENT"
		Или Ключ = "CREATE_REFERENCE"
		Или Ключ = "WRITE"
		Или Ключ = "SET_FIELD"
		Или Ключ = "ADD_TABLE_ROW"
		Или Ключ = "POST_DOCUMENT"
		Или Ключ = "DELETE_OBJECT";
КонецФункции

Функция ЛокальныйDSLСодержитЧужойRunQuery(DSL_JSON, KindКлюч)
	Текст = ВРег(Строка(DSL_JSON));
	Если СтрНайти(Текст, """ACTION"":""RUNQUERY""") = 0 И СтрНайти(Текст, """ACTION"": ""RUNQUERY""") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если KindКлюч = "RUN_QUERY" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПрименитьСтруктурныйIRЗапроса(ТекстЗапроса, КонтекстВыполнения = Неопределено) Экспорт
	Текст = Строка(ТекстЗапроса);
	Если ПустаяСтрока(СокрЛП(Текст)) Или Лев(ВРег(СокрЛП(Текст)), 7) <> "ВЫБРАТЬ" Тогда
		Возврат Текст;
	КонецЕсли;
	ТекстВРегПроверка = ВРег(Текст);
	Если СтрНайти(ТекстВРегПроверка, "ОБЪЕДИНИТЬ") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрЧислоВхождений(ТекстВРегПроверка, "ВЫБРАТЬ") > 1 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозИзПроверка = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРегПроверка, "ИЗ", 1);
	Если ПозИзПроверка > 0 Тогда
		ИндексПослеИз = ПропуститьПробелыВТекстеЗапроса(Текст, ПозИзПроверка + 2);
		Если ИндексПослеИз <= СтрДлина(Текст) И Сред(Текст, ИндексПослеИз, 1) = "(" Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЕсли;
	IR = РазобратьЗапросВIR(Текст);
	Если IR = Неопределено Или ПустаяСтрока(IR.Источник) Тогда
		Возврат Текст;
	КонецЕсли;
	ПрименитьПравилаIRЗапроса(IR, КонтекстВыполнения);
	ТекстВРегИсходный = ВРег(Текст);
	Если (СтрНайти(ТекстВРегИсходный, " ГДЕ ") > 0 Или СтрНайти(ТекстВРегИсходный, Символы.ПС + "ГДЕ") > 0)
		И ПустаяСтрока(IR.Где) Тогда
		Возврат Текст;
	КонецЕсли;
	Если СтрНайти(ТекстВРегИсходный, "СГРУППИРОВАТЬ") > 0 И ПустаяСтрока(IR.Группировка) Тогда
		Возврат Текст;
	КонецЕсли;
	Собранный = СобратьЗапросИзIR(IR);
	Если ПустаяСтрока(СокрЛП(Собранный)) Или Лев(ВРег(СокрЛП(Собранный)), 7) <> "ВЫБРАТЬ" Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Собранный;
КонецФункции

Функция НовыйIRЗапроса()
	IR = Новый Структура;
	IR.Вставить("Первые", 0);
	IR.Вставить("Выбор", "");
	IR.Вставить("Источник", "");
	IR.Вставить("ВиртуальнаяТаблица", "");
	IR.Вставить("ПараметрыВиртуальной", "");
	IR.Вставить("Псевдоним", "");
	IR.Вставить("Соединения", Новый Массив);
	IR.Вставить("Где", "");
	IR.Вставить("Группировка", "");
	IR.Вставить("Имеющие", "");
	IR.Вставить("Упорядочивание", "");
	Возврат IR;
КонецФункции

Функция РазобратьЗапросВIR(ТекстЗапроса)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	ТекстВРег = ВРег(Текст);
	ПозВыбрать = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ВЫБРАТЬ", 1);
	Если ПозВыбрать = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	IR = НовыйIRЗапроса();
	Индекс = ПозВыбрать + СтрДлина("ВЫБРАТЬ");
	Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
	Если ВРег(Сред(Текст, Индекс, 6)) = "ПЕРВЫЕ" Тогда
		Индекс = Индекс + 6;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		ЧислоСтрокой = "";
		Пока Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) >= "0" И Сред(Текст, Индекс, 1) <= "9" Цикл
			ЧислоСтрокой = ЧислоСтрокой + Сред(Текст, Индекс, 1);
			Индекс = Индекс + 1;
		КонецЦикла;
		Если НЕ ПустаяСтрока(ЧислоСтрокой) Тогда
			IR.Первые = Число(ЧислоСтрокой);
		КонецЕсли;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
	КонецЕсли;
	ПозИз = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИЗ", Индекс);
	Если ПозИз = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	IR.Выбор = СокрЛП(Сред(Текст, Индекс, ПозИз - Индекс));
	Индекс = ПозИз + 2;
	Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
	РазобратьИсточникIR(Текст, Индекс, IR);
	ПозГде = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ГДЕ", Индекс);
	ПозГрупп = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "СГРУППИРОВАТЬ", Индекс);
	ПозИмеющие = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИМЕЮЩИЕ", Индекс);
	ПозУпор = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "УПОРЯДОЧИТЬ", Индекс);
	ПозКонцаСоединений = СтрДлина(Текст) + 1;
	Для Каждого ПозСекции Из СтрРазделить(Строка(ПозГде) + "," + Строка(ПозГрупп) + "," + Строка(ПозИмеющие) + "," + Строка(ПозУпор), ",", Ложь) Цикл
		ЧислоПоз = Число(ПозСекции);
		Если ЧислоПоз > 0 И ЧислоПоз < ПозКонцаСоединений Тогда
			ПозКонцаСоединений = ЧислоПоз;
		КонецЕсли;
	КонецЦикла;
	РазобратьСоединенияIR(Текст, Индекс, ПозКонцаСоединений, IR);
	Если ПозГде > 0 Тогда
		КонецГде = БлижайшаяГраницаСекцииЗапроса(ПозГрупп, ПозИмеющие, ПозУпор, СтрДлина(Текст) + 1);
		IR.Где = СокрЛП(Сред(Текст, ПозГде + 3, КонецГде - ПозГде - 3));
	КонецЕсли;
	Если ПозГрупп > 0 Тогда
		КонецГрупп = БлижайшаяГраницаСекцииЗапроса(ПозИмеющие, ПозУпор, 0, СтрДлина(Текст) + 1);
		Хвост = СокрЛП(Сред(Текст, ПозГрупп + СтрДлина("СГРУППИРОВАТЬ"), КонецГрупп - ПозГрупп - СтрДлина("СГРУППИРОВАТЬ")));
		Если ВРег(Лев(Хвост, 2)) = "ПО" Тогда
			Хвост = СокрЛП(Сред(Хвост, 3));
		КонецЕсли;
		ХвостВРег = ВРег(Хвост);
		ПозПервыеВГруппе = СтрНайти(ХвостВРег, "ПЕРВЫЕ ");
		Если ПозПервыеВГруппе > 0 Тогда
			Если IR.Первые <= 0 Тогда
				ИндексЧисла = ПозПервыеВГруппе + СтрДлина("ПЕРВЫЕ ");
				ЧислоСтрокой = "";
				Пока ИндексЧисла <= СтрДлина(Хвост) И Сред(Хвост, ИндексЧисла, 1) >= "0" И Сред(Хвост, ИндексЧисла, 1) <= "9" Цикл
					ЧислоСтрокой = ЧислоСтрокой + Сред(Хвост, ИндексЧисла, 1);
					ИндексЧисла = ИндексЧисла + 1;
				КонецЦикла;
				Если НЕ ПустаяСтрока(ЧислоСтрокой) Тогда
					IR.Первые = Число(ЧислоСтрокой);
				КонецЕсли;
			КонецЕсли;
			Хвост = СокрП(Лев(Хвост, ПозПервыеВГруппе - 1));
		КонецЕсли;
		Хвост = СокрП(СтрЗаменить(СтрЗаменить(Хвост, "АВТОУПОР", ""), "Автоупор", ""));
		IR.Группировка = Хвост;
	КонецЕсли;
	Если ПозИмеющие > 0 Тогда
		КонецИмеющие = ?(ПозУпор > 0, ПозУпор, СтрДлина(Текст) + 1);
		IR.Имеющие = СокрЛП(Сред(Текст, ПозИмеющие + СтрДлина("ИМЕЮЩИЕ"), КонецИмеющие - ПозИмеющие - СтрДлина("ИМЕЮЩИЕ")));
	КонецЕсли;
	Если ПозУпор > 0 Тогда
		Хвост = СокрЛП(Сред(Текст, ПозУпор + СтрДлина("УПОРЯДОЧИТЬ")));
		Если ВРег(Лев(Хвост, 2)) = "ПО" Тогда
			Хвост = СокрЛП(Сред(Хвост, 3));
		КонецЕсли;
		IR.Упорядочивание = Хвост;
	КонецЕсли;
	Возврат IR;
КонецФункции

Функция БлижайшаяГраницаСекцииЗапроса(Поз1, Поз2, Поз3, ЗначениеПоУмолчанию)
	Граница = ЗначениеПоУмолчанию;
	Для Каждого Поз Из СтрРазделить(Строка(Поз1) + "," + Строка(Поз2) + "," + Строка(Поз3), ",", Ложь) Цикл
		ЧислоПоз = Число(Поз);
		Если ЧислоПоз > 0 И ЧислоПоз < Граница Тогда
			Граница = ЧислоПоз;
		КонецЕсли;
	КонецЦикла;
	Возврат Граница;
КонецФункции

Процедура РазобратьИсточникIR(Текст, Индекс, IR)
	Начало = Индекс;
	Пока Индекс <= СтрДлина(Текст) И Не ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс, 1)) И Сред(Текст, Индекс, 1) <> "(" Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
	ТокенИсточника = СокрЛП(Сред(Текст, Начало, Индекс - Начало));
	Части = СтрРазделить(ТокенИсточника, ".");
	Если Части.Количество() >= 3 Тогда
		ВозможнаяВиртуальная = ВРег(СокрЛП(Строка(Части[Части.Количество() - 1])));
		Если ВозможнаяВиртуальная = "ОСТАТКИ"
			Или ВозможнаяВиртуальная = "ОБОРОТЫ"
			Или ВозможнаяВиртуальная = "ОСТАТКИИОБОРОТЫ"
			Или ВозможнаяВиртуальная = "СРЕЗПОСЛЕДНИХ"
			Или ВозможнаяВиртуальная = "СРЕЗПЕРВЫХ"
			Или ВозможнаяВиртуальная = "ОБОРОТЫДТКТ" Тогда
			IR.ВиртуальнаяТаблица = СокрЛП(Строка(Части[Части.Количество() - 1]));
			IR.Источник = СокрЛП(Строка(Части[0])) + "." + СокрЛП(Строка(Части[1]));
		Иначе
			IR.Источник = ТокенИсточника;
		КонецЕсли;
	Иначе
		IR.Источник = ТокенИсточника;
	КонецЕсли;
	Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
	Если Индекс <= СтрДлина(Текст) И Сред(Текст, Индекс, 1) = "(" Тогда
		КонецСкобки = НайтиПарнуюСкобкуЗапроса(Текст, Индекс);
		Если КонецСкобки > Индекс Тогда
			IR.ПараметрыВиртуальной = СокрЛП(Сред(Текст, Индекс + 1, КонецСкобки - Индекс - 1));
			Индекс = КонецСкобки + 1;
		КонецЕсли;
	КонецЕсли;
	Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
	Если ВРег(Сред(Текст, Индекс, 3)) = "КАК" И ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс + 3, 1)) Тогда
		Индекс = Индекс + 3;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		НачалоПсевдонима = Индекс;
		Пока Индекс <= СтрДлина(Текст) И Не ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс, 1)) Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
		IR.Псевдоним = СокрЛП(Сред(Текст, НачалоПсевдонима, Индекс - НачалоПсевдонима));
	КонецЕсли;
КонецПроцедуры

Процедура РазобратьСоединенияIR(Текст, Индекс, ПозКонца, IR)
	ТекстВРег = ВРег(Текст);
	Пока Индекс < ПозКонца Цикл
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		Если Индекс >= ПозКонца Тогда
			Прервать;
		КонецЕсли;
		ТипСоединения = "";
		Если ВРег(Сред(Текст, Индекс, 16)) = "ЛЕВОЕ СОЕДИНЕНИЕ" Тогда
			ТипСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ";
			Индекс = Индекс + 16;
		ИначеЕсли ВРег(Сред(Текст, Индекс, 17)) = "ПРАВОЕ СОЕДИНЕНИЕ" Тогда
			ТипСоединения = "ПРАВОЕ СОЕДИНЕНИЕ";
			Индекс = Индекс + 17;
		ИначеЕсли ВРег(Сред(Текст, Индекс, 20)) = "ВНУТРЕННЕЕ СОЕДИНЕНИЕ" Тогда
			ТипСоединения = "ВНУТРЕННЕЕ СОЕДИНЕНИЕ";
			Индекс = Индекс + 20;
		ИначеЕсли ВРег(Сред(Текст, Индекс, 10)) = "СОЕДИНЕНИЕ" Тогда
			ТипСоединения = "СОЕДИНЕНИЕ";
			Индекс = Индекс + 10;
		Иначе
			Прервать;
		КонецЕсли;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		НачалоИсточника = Индекс;
		Пока Индекс < ПозКонца И Не ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс, 1)) И Сред(Текст, Индекс, 1) <> "(" Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
		ИсточникСоединения = СокрЛП(Сред(Текст, НачалоИсточника, Индекс - НачалоИсточника));
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		Если Индекс < ПозКонца И Сред(Текст, Индекс, 1) = "(" Тогда
			КонецСкобки = НайтиПарнуюСкобкуЗапроса(Текст, Индекс);
			Если КонецСкобки > Индекс Тогда
				Индекс = КонецСкобки + 1;
			КонецЕсли;
		КонецЕсли;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		ПсевдонимСоединения = "";
		Если ВРег(Сред(Текст, Индекс, 3)) = "КАК" И ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс + 3, 1)) Тогда
			Индекс = Индекс + 3;
			Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
			НачалоПсевдонима = Индекс;
			Пока Индекс < ПозКонца И Не ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс, 1)) Цикл
				Индекс = Индекс + 1;
			КонецЦикла;
			ПсевдонимСоединения = СокрЛП(Сред(Текст, НачалоПсевдонима, Индекс - НачалоПсевдонима));
		КонецЕсли;
		Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
		Условие = "";
		Если ВРег(Сред(Текст, Индекс, 2)) = "ПО" И ЭтоРазделительТокенаЗапроса(Сред(Текст, Индекс + 2, 1)) Тогда
			Индекс = Индекс + 2;
			Индекс = ПропуститьПробелыВТекстеЗапроса(Текст, Индекс);
			ПозСлед = НайтиСледующееСоединениеИлиСекцию(ТекстВРег, Индекс, ПозКонца);
			Условие = СокрЛП(Сред(Текст, Индекс, ПозСлед - Индекс));
			Индекс = ПозСлед;
		КонецЕсли;
		Соединение = Новый Структура("Тип,Источник,Псевдоним,Условие", ТипСоединения, ИсточникСоединения, ПсевдонимСоединения, Условие);
		IR.Соединения.Добавить(Соединение);
	КонецЦикла;
КонецПроцедуры

Функция НайтиСледующееСоединениеИлиСекцию(ТекстВРег, Индекс, ПозКонца)
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ЛЕВОЕ СОЕДИНЕНИЕ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ПРАВОЕ СОЕДИНЕНИЕ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ВНУТРЕННЕЕ СОЕДИНЕНИЕ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "СОЕДИНЕНИЕ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ГДЕ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "СГРУППИРОВАТЬ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИМЕЮЩИЕ", Индекс));
	Кандидаты.Добавить(НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "УПОРЯДОЧИТЬ", Индекс));
	Граница = ПозКонца;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат > 0 И Кандидат < Граница Тогда
			Граница = Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат Граница;
КонецФункции

Процедура ПрименитьПравилаIRЗапроса(IR, КонтекстВыполнения = Неопределено)
	Псевдоним = ?(ПустаяСтрока(IR.Псевдоним), ИмяИсточникаБезКласса(IR.Источник), IR.Псевдоним);
	Если ПустаяСтрока(IR.Псевдоним) Тогда
		IR.Псевдоним = Псевдоним;
	КонецЕсли;
	КлассИсточника = ВРег(Лев(IR.Источник, СтрНайти(IR.Источник, ".") - 1));
	Виртуальная = ВРег(IR.ВиртуальнаяТаблица);
	Если Виртуальная = "ОБОРОТЫ" Или Виртуальная = "ОСТАТКИИОБОРОТЫ" Тогда
		IR.Выбор = ЗаменитьКвалификаторПериодКакТаблицу(IR.Выбор, Псевдоним);
		IR.Где = ЗаменитьКвалификаторПериодКакТаблицу(IR.Где, Псевдоним);
		IR.Группировка = ЗаменитьКвалификаторПериодКакТаблицу(IR.Группировка, Псевдоним);
		IR.Упорядочивание = ЗаменитьКвалификаторПериодКакТаблицу(IR.Упорядочивание, Псевдоним);
		IR.Выбор = ЗаменитьИдентификаторВТекстеЗапроса(IR.Выбор, "Оборот", "СуммаОборот");
		Если ЗапросСодержитПолеПериод(IR.Выбор + " " + IR.Группировка + " " + IR.Где) Тогда
			IR.ПараметрыВиртуальной = ДополнитьПараметрыОборотовГраницамиПериода(IR.ПараметрыВиртуальной, IR.Где);
		КонецЕсли;
	КонецЕсли;
	Если КлассИсточника = "ДОКУМЕНТ" Тогда
		IR.Выбор = ЗаменитьПериодНаДатуВСекцииIR(IR.Выбор, Псевдоним);
		IR.Где = ЗаменитьПериодНаДатуВСекцииIR(IR.Где, Псевдоним);
		IR.Группировка = ЗаменитьПериодНаДатуВСекцииIR(IR.Группировка, Псевдоним);
		IR.Упорядочивание = ЗаменитьПериодНаДатуВСекцииIR(IR.Упорядочивание, Псевдоним);
		IR.Выбор = ЗаменитьИдентификаторВТекстеЗапроса(IR.Выбор, "Время", "Дата");
		IR.Где = ЗаменитьИдентификаторВТекстеЗапроса(IR.Где, "Время", "Дата");
		IR.Группировка = ЗаменитьИдентификаторВТекстеЗапроса(IR.Группировка, "Время", "Дата");
		IR.Упорядочивание = ЗаменитьИдентификаторВТекстеЗапроса(IR.Упорядочивание, "Время", "Дата");
		Если НЕ ПустаяСтрока(IR.ПараметрыВиртуальной) И СтрНайти(ВРег(IR.ПараметрыВиртуальной), "ДАТАВРЕМЯ") > 0 Тогда
			Если ПустаяСтрока(IR.Где) Или СтрНайти(ВРег(IR.Где), "ДАТАВРЕМЯ") = 0 Тогда
				АргументыДат = РазделитьВыраженияСпискаЗапроса(IR.ПараметрыВиртуальной);
				Если АргументыДат.Количество() >= 2
					И СтрНайти(ВРег(Строка(АргументыДат[0])), "ДАТАВРЕМЯ") > 0
					И СтрНайти(ВРег(Строка(АргументыДат[1])), "ДАТАВРЕМЯ") > 0 Тогда
					ПолеДаты = ?(ПустаяСтрока(IR.Псевдоним), "Дата", IR.Псевдоним + ".Дата");
					УсловиеДат = ПолеДаты + " МЕЖДУ " + СокрЛП(Строка(АргументыДат[0])) + " И " + СокрЛП(Строка(АргументыДат[1]));
					Если ПустаяСтрока(IR.Где) Или СокрЛП(IR.Где) = "1=1" Тогда
						IR.Где = УсловиеДат;
					Иначе
						IR.Где = IR.Где + " И " + УсловиеДат;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			IR.ПараметрыВиртуальной = "";
		КонецЕсли;
	КонецЕсли;
	ОставшиесяСоединения = Новый Массив;
	Для Каждого Соединение Из IR.Соединения Цикл
		Если ПустаяСтрока(СокрЛП(Соединение.Условие)) Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(Соединение.Псевдоним) = "ПЕРИОД" И СтрНайти(ВРег(Соединение.Источник), ".") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ОставшиесяСоединения.Добавить(Соединение);
	КонецЦикла;
	IR.Соединения = ОставшиесяСоединения;
	Если НЕ ИИА_DSLQuerySafety.ЭтоНеограниченныйРежимЗапроса(КонтекстВыполнения) Тогда
		Если IR.Первые <= 0 Тогда
			IR.Первые = 100;
		ИначеЕсли IR.Первые > 500 Тогда
			IR.Первые = 500;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ЗаменитьКвалификаторПериодКакТаблицу(ТекстСекции, Псевдоним)
	Текст = Строка(ТекстСекции);
	Если ПустаяСтрока(Текст) Или ПустаяСтрока(Псевдоним) Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "Период.Дата", Псевдоним + ".Период");
	Текст = СтрЗаменить(Текст, "ПЕРИОД.ДАТА", Псевдоним + ".Период");
	Текст = СтрЗаменить(Текст, "Период.дата", Псевдоним + ".Период");
	Возврат Текст;
КонецФункции

Функция УбратьУсловияПоляПериодИзСекцииГде(ТекстГде)
	Секция = СокрЛП(Строка(ТекстГде));
	Если ПустаяСтрока(Секция) Тогда
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(Секция, Символы.ПС, Ложь);
	Оставшиеся = Новый Массив;
	Для Каждого Часть Из Части Цикл
		СтрокаУсловия = СокрЛП(Строка(Часть));
		Если ПустаяСтрока(СтрокаУсловия) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаВРег = ВРег(СтрокаУсловия);
		Если ЗапросСодержитПолеПериод(СтрокаУсловия)
			И (СтрНайти(СтрокаВРег, "ДАТАВРЕМЯ") > 0 Или СтрНайти(СтрокаВРег, "МЕЖДУ") > 0) Тогда
			Продолжить;
		КонецЕсли;
		Оставшиеся.Добавить(СтрокаУсловия);
	КонецЦикла;
	Если Оставшиеся.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	НоваяСекция = СтрСоединить(Оставшиеся, " ");
	НоваяСекцияВРег = ВРег(СокрЛП(НоваяСекция));
	Пока СтрНачинаетсяС(НоваяСекцияВРег, "И ") Или СтрНачинаетсяС(НоваяСекцияВРег, "ИЛИ ") Цикл
		НоваяСекция = СокрЛП(Сред(СокрЛП(НоваяСекция), ?(СтрНачинаетсяС(НоваяСекцияВРег, "ИЛИ "), 4, 2)));
		НоваяСекцияВРег = ВРег(СокрЛП(НоваяСекция));
	КонецЦикла;
	Возврат НоваяСекция;
КонецФункции

Функция ЗаменитьПериодНаДатуВСекцииIR(ТекстСекции, Псевдоним)
	Текст = Строка(ТекстСекции);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Псевдоним) Тогда
		Текст = СтрЗаменить(Текст, Псевдоним + ".Период", Псевдоним + ".Дата");
		Текст = СтрЗаменить(Текст, Псевдоним + ".ПЕРИОД", Псевдоним + ".Дата");
	КонецЕсли;
	Текст = ЗаменитьИдентификаторВТекстеЗапроса(Текст, "Период", "Дата");
	Возврат Текст;
КонецФункции

Функция ОбеспечитьАвтоВПараметрахОборотов(ПараметрыВиртуальной)
	Текст = СокрЛП(Строка(ПараметрыВиртуальной));
	Если СтрНайти(ВРег(Текст), "ДЕНЬ") > 0 Или СтрНайти(ВРег(Текст), "МЕСЯЦ") > 0 Или СтрНайти(ВРег(Текст), "РЕГИСТРАТОР") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ЧислоЗапятых = 0;
	Глубина = 0;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" И Глубина > 0 Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			ЧислоЗапятых = ЧислоЗапятых + 1;
		КонецЕсли;
	КонецЦикла;
	Если ЧислоЗапятых = 0 Тогда
		Если ПустаяСтрока(Текст) Тогда
			Возврат ", , День";
		КонецЕсли;
		Возврат Текст + ", , День";
	КонецЕсли;
	Если ЧислоЗапятых = 1 Тогда
		Возврат Текст + ", День";
	КонецЕсли;
	Аргументы = РазделитьАргументыВиртуальнойТаблицы(Текст);
	Пока Аргументы.Количество() < 3 Цикл
		Аргументы.Добавить("");
	КонецЦикла;
	Третий = СокрЛП(Строка(Аргументы[2]));
	Если ПустаяСтрока(Третий) Или ВРег(Третий) = "АВТО" Тогда
		Аргументы[2] = "День";
	КонецЕсли;
	Возврат СтрСоединить(Аргументы, ", ");
КонецФункции

Функция ПеренестиГраницыПериодаИзГдеВПараметрыОборотов(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, ".ОБОРОТЫ(") = 0 И СтрНайти(ТекстВРег, ".ОСТАТКИИОБОРОТЫ(") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозГде = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ГДЕ", 1);
	Если ПозГде = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозГрупп = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "СГРУППИРОВАТЬ", ПозГде);
	ПозИмеющие = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "ИМЕЮЩИЕ", ПозГде);
	ПозУпор = НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, "УПОРЯДОЧИТЬ", ПозГде);
	КонецГде = БлижайшаяГраницаСекцииЗапроса(ПозГрупп, ПозИмеющие, ПозУпор, СтрДлина(Текст) + 1);
	СекцияГде = Сред(Текст, ПозГде, КонецГде - ПозГде);
	Границы = ИзвлечьЛитералыДатаВремяИзФильтраПериода(СекцияГде);
	Если ПустаяСтрока(Границы.Начало) Или ПустаяСтрока(Границы.Конец) Тогда
		Возврат Текст;
	КонецЕсли;
	Маркеры = Новый Массив;
	Маркеры.Добавить(".ОСТАТКИИОБОРОТЫ(");
	Маркеры.Добавить(".ОБОРОТЫ(");
	Для Каждого Маркер Из Маркеры Цикл
		ПозицияПоиска = 1;
		Пока Истина Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Маркер);
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = ПозицияПоиска + Поз - 1;
			Если Маркер = ".ОБОРОТЫ(" Тогда
				Префикс = "";
				Если Поз > 1 Тогда
					Префикс = Сред(ТекстВРег, Макс(1, Поз - 8), Мин(8, Поз - 1));
				КонецЕсли;
				Если СтрЗаканчиваетсяНа(Префикс, "ИО") Тогда
					ПозицияПоиска = Поз + СтрДлина(Маркер);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ПозОткр = Поз + СтрДлина(Маркер) - 1;
			КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозОткр);
			Если КонецСкобки = 0 Тогда
				ПозицияПоиска = Поз + 1;
				Продолжить;
			КонецЕсли;
			Внутри = Сред(Текст, ПозОткр + 1, КонецСкобки - ПозОткр - 1);
			НовыеПараметры = ДополнитьПараметрыОборотовГраницамиПериода(Внутри, СекцияГде);
			Если НовыеПараметры <> Внутри Тогда
				Текст = Лев(Текст, ПозОткр) + НовыеПараметры + Сред(Текст, КонецСкобки);
				ПозицияПоиска = ПозОткр + СтрДлина(НовыеПараметры) + 1;
			Иначе
				ПозицияПоиска = КонецСкобки + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ИзвлечьЛитералыДатаВремяИзФильтраПериода(ТекстСекции)
	Результат = Новый Структура("Начало,Конец", "", "");
	Текст = Строка(ТекстСекции);
	Если НЕ ЗапросСодержитПолеПериод(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Если СтрНайти(ТекстВРег, "ДАТАВРЕМЯ(") = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Литералы = Новый Массив;
	Позиция = 1;
	Пока Литералы.Количество() < 2 Цикл
		Поз = СтрНайти(Сред(ТекстВРег, Позиция), "ДАТАВРЕМЯ(");
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = Позиция + Поз - 1;
		ПозОткр = Поз + СтрДлина("ДАТАВРЕМЯ(") - 1;
		КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозОткр);
		Если КонецСкобки = 0 Тогда
			Прервать;
		КонецЕсли;
		Литералы.Добавить(Сред(Текст, Поз, КонецСкобки - Поз + 1));
		Позиция = КонецСкобки + 1;
	КонецЦикла;
	Если Литералы.Количество() >= 2 Тогда
		Результат.Начало = Литералы[0];
		Результат.Конец = Литералы[1];
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДополнитьПараметрыОборотовГраницамиПериода(ПараметрыВиртуальной, ТекстГде)
	Аргументы = РазделитьАргументыВиртуальнойТаблицы(ПараметрыВиртуальной);
	Пока Аргументы.Количество() < 3 Цикл
		Аргументы.Добавить("");
	КонецЦикла;
	Если Аргументы.Количество() >= 3 И ЭтоВыражениеДатыЗапроса(Аргументы[2])
		И ПустаяСтрока(СокрЛП(Строка(Аргументы[0]))) Тогда
		НачалоСдвинутое = СокрЛП(Строка(Аргументы[2]));
		КонецСдвинутый = "";
		Если Аргументы.Количество() > 3 Тогда
			КонецСдвинутый = СокрЛП(Строка(Аргументы[3]));
		КонецЕсли;
		Аргументы[0] = НачалоСдвинутое;
		Аргументы[1] = КонецСдвинутый;
		Аргументы[2] = "День";
		Пока Аргументы.Количество() > 3 Цикл
			Аргументы.Удалить(Аргументы.Количество() - 1);
		КонецЦикла;
	КонецЕсли;
	Границы = ИзвлечьЛитералыДатаВремяИзФильтраПериода(ТекстГде);
	Если НЕ ПустаяСтрока(Границы.Начало) И ПустаяСтрока(СокрЛП(Строка(Аргументы[0]))) Тогда
		Аргументы[0] = Границы.Начало;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Границы.Конец) И ПустаяСтрока(СокрЛП(Строка(Аргументы[1]))) Тогда
		Аргументы[1] = Границы.Конец;
	КонецЕсли;
	Третий = СокрЛП(Строка(Аргументы[2]));
	Если ПустаяСтрока(Третий) Или ВРег(Третий) = "АВТО" Тогда
		Аргументы[2] = "День";
	КонецЕсли;
	Пока Аргументы.Количество() > 3 И ПустаяСтрока(СокрЛП(Строка(Аргументы[Аргументы.Количество() - 1]))) Цикл
		Аргументы.Удалить(Аргументы.Количество() - 1);
	КонецЦикла;
	Возврат СтрСоединить(Аргументы, ", ");
КонецФункции

Функция ЭтоВыражениеДатыЗапроса(Выражение)
	Текст = ВРег(СокрЛП(Строка(Выражение)));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Текст, "ДАТАВРЕМЯ(") > 0
		Или СтрНайти(Текст, "НАЧАЛОПЕРИОДА(") > 0
		Или СтрНайти(Текст, "КОНЕЦПЕРИОДА(") > 0
		Или СтрНайти(Текст, "&НАЧАЛО") > 0
		Или СтрНайти(Текст, "&КОНЕЦ") > 0;
КонецФункции

Функция ИсправитьСдвигДатВПараметрахОборотов(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Маркеры = Новый Массив;
	Маркеры.Добавить(".ОСТАТКИИОБОРОТЫ(");
	Маркеры.Добавить(".ОБОРОТЫ(");
	Для Каждого Маркер Из Маркеры Цикл
		ПозицияПоиска = 1;
		Пока Истина Цикл
			ТекстВРег = ВРег(Текст);
			Поз = СтрНайти(Сред(ТекстВРег, ПозицияПоиска), Маркер);
			Если Поз = 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = ПозицияПоиска + Поз - 1;
			Если Маркер = ".ОБОРОТЫ(" Тогда
				Префикс = "";
				Если Поз > 1 Тогда
					Префикс = Сред(ТекстВРег, Макс(1, Поз - 8), Мин(8, Поз - 1));
				КонецЕсли;
				Если СтрЗаканчиваетсяНа(Префикс, "ИО") Тогда
					ПозицияПоиска = Поз + СтрДлина(Маркер);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ПозОткр = Поз + СтрДлина(Маркер) - 1;
			КонецСкобки = НайтиПозициюЗакрывающейСкобки(Текст, ПозОткр);
			Если КонецСкобки = 0 Тогда
				ПозицияПоиска = Поз + 1;
				Продолжить;
			КонецЕсли;
			Внутри = Сред(Текст, ПозОткр + 1, КонецСкобки - ПозОткр - 1);
			НовыеПараметры = ДополнитьПараметрыОборотовГраницамиПериода(Внутри, "");
			Если НовыеПараметры <> Внутри Тогда
				Текст = Лев(Текст, ПозОткр) + НовыеПараметры + Сред(Текст, КонецСкобки);
				ПозицияПоиска = ПозОткр + СтрДлина(НовыеПараметры) + 1;
			Иначе
				ПозицияПоиска = КонецСкобки + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция РазделитьАргументыВиртуальнойТаблицы(ТекстПараметров)
	Результат = Новый Массив;
	Текст = Строка(ТекстПараметров);
	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Результат;
	КонецЕсли;
	Буфер = "";
	Глубина = 0;
	ВКавычках = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Буфер = Буфер + Символ;
			Продолжить;
		КонецЕсли;
		Если НЕ ВКавычках Тогда
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" И Глубина > 0 Тогда
				Глубина = Глубина - 1;
			ИначеЕсли Символ = "," И Глубина = 0 Тогда
				Результат.Добавить(СокрЛП(Буфер));
				Буфер = "";
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Буфер = Буфер + Символ;
	КонецЦикла;
	Результат.Добавить(СокрЛП(Буфер));
	Возврат Результат;
КонецФункции

Функция СобратьЗапросИзIR(IR)
	Части = Новый Массив;
	Шапка = "ВЫБРАТЬ";
	Если IR.Первые > 0 Тогда
		Шапка = Шапка + " ПЕРВЫЕ " + Формат(IR.Первые, "ЧГ=0");
	КонецЕсли;
	Части.Добавить(Шапка);
	Части.Добавить(Символы.Таб + IR.Выбор);
	Источник = IR.Источник;
	Если НЕ ПустаяСтрока(IR.ВиртуальнаяТаблица) Тогда
		Источник = Источник + "." + IR.ВиртуальнаяТаблица;
		Источник = Источник + "(" + IR.ПараметрыВиртуальной + ")";
	КонецЕсли;
	Если НЕ ПустаяСтрока(IR.Псевдоним) Тогда
		Источник = Источник + " КАК " + IR.Псевдоним;
	КонецЕсли;
	Части.Добавить("ИЗ " + Источник);
	Для Каждого Соединение Из IR.Соединения Цикл
		СтрокаСоединения = Соединение.Тип + " " + Соединение.Источник;
		Если НЕ ПустаяСтрока(Соединение.Псевдоним) Тогда
			СтрокаСоединения = СтрокаСоединения + " КАК " + Соединение.Псевдоним;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Соединение.Условие) Тогда
			СтрокаСоединения = СтрокаСоединения + " ПО " + Соединение.Условие;
		КонецЕсли;
		Части.Добавить(СтрокаСоединения);
	КонецЦикла;
	Если НЕ ПустаяСтрока(IR.Где) Тогда
		Части.Добавить("ГДЕ " + IR.Где);
	КонецЕсли;
	Если НЕ ПустаяСтрока(IR.Группировка) Тогда
		Части.Добавить("СГРУППИРОВАТЬ ПО " + IR.Группировка);
	КонецЕсли;
	Если НЕ ПустаяСтрока(IR.Имеющие) Тогда
		Части.Добавить("ИМЕЮЩИЕ " + IR.Имеющие);
	КонецЕсли;
	Если НЕ ПустаяСтрока(IR.Упорядочивание) Тогда
		Части.Добавить("УПОРЯДОЧИТЬ ПО " + IR.Упорядочивание);
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

Функция НайтиКлючевоеСловоЗапросаНаВерхнемУровне(ТекстВРег, Слово, НачальныйИндекс = 1)
	ДлинаСлова = СтрДлина(Слово);
	Глубина = 0;
	ВКавычках = Ложь;
	Индекс = Макс(1, НачальныйИндекс);
	Пока Индекс <= СтрДлина(ТекстВРег) - ДлинаСлова + 1 Цикл
		Символ = Сред(ТекстВРег, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если НЕ ВКавычках Тогда
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" И Глубина > 0 Тогда
				Глубина = Глубина - 1;
			ИначеЕсли Глубина = 0 И Сред(ТекстВРег, Индекс, ДлинаСлова) = Слово Тогда
				Слева = ?(Индекс = 1, " ", Сред(ТекстВРег, Индекс - 1, 1));
				Справа = ?(Индекс + ДлинаСлова > СтрДлина(ТекстВРег), " ", Сред(ТекстВРег, Индекс + ДлинаСлова, 1));
				Если ЭтоРазделительТокенаЗапроса(Слева) И ЭтоРазделительТокенаЗапроса(Справа) Тогда
					Возврат Индекс;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ЭтоРазделительТокенаЗапроса(Символ)
	Если ПустаяСтрока(Символ) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Символ = " "
		Или Символ = Символы.ПС
		Или Символ = Символы.ВК
		Или Символ = Символы.Таб
		Или Символ = ","
		Или Символ = ")"
		Или Символ = "("
		Или Символ = Символы.НПП;
КонецФункции

Функция НайтиПарнуюСкобкуЗапроса(Текст, ПозОткрывающей)
	Глубина = 0;
	ВКавычках = Ложь;
	Для Индекс = ПозОткрывающей По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
			Продолжить;
		КонецЕсли;
		Если ВКавычках Тогда
			Продолжить;
		КонецЕсли;
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ИмяИсточникаБезКласса(ПолноеИмя)
	Части = СтрРазделить(Строка(ПолноеИмя), ".");
	Если Части.Количество() >= 2 Тогда
		Возврат СокрЛП(Строка(Части[1]));
	КонецЕсли;
	Возврат СокрЛП(Строка(ПолноеИмя));
КонецФункции

