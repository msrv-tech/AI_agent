#Область ПрограммныйИнтерфейс

Функция СжатьJSONДляЛога(ТекстJSON)
	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат "";
	КонецЕсли;
	Результат = СтрЗаменить(ТекстJSON, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВТаб, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);
КонецФункции

Процедура ВставитьПолеЕслиЕсть(Приемник, Источник, ИмяПоля)
	Если Источник <> Неопределено И ТипЗнч(Источник) = Тип("Структура") И Источник.Свойство(ИмяПоля) Тогда
		Приемник.Вставить(ИмяПоля, Источник[ИмяПоля]);
	КонецЕсли;
КонецПроцедуры

Функция СформироватьКраткийПланДляПромпта(План) Экспорт
	КраткийПлан = СоздатьПустойTypedPlan("");
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") Тогда
		Возврат КраткийПлан;
	КонецЕсли;
	ВставитьПолеЕслиЕсть(КраткийПлан, План, "plan_version");
	ВставитьПолеЕслиЕсть(КраткийПлан, План, "goal");
	ВставитьПолеЕслиЕсть(КраткийПлан, План, "last_user_text");
	КраткийПлан.steps = Новый Массив;
	Если НЕ План.Свойство("steps") ИЛИ ТипЗнч(План.steps) <> Тип("Массив") Тогда
		Возврат КраткийПлан;
	КонецЕсли;

	Для Каждого Шаг Из План.steps Цикл
		Если ТипЗнч(Шаг) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		КраткийШаг = Новый Структура;
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "id");
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "seq_no");
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "kind");
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "title");
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "depends_on");
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "status");
		ВставитьПолеЕслиЕсть(КраткийШаг, Шаг, "result_summary");
		Если Шаг.Свойство("input") И ТипЗнч(Шаг.input) = Тип("Структура") Тогда
			КраткийInput = Новый Структура;
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "object");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "object_name");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "fields");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "all_fields");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "query");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "parameters");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "source");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "filter");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "intent");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "name");
			ВставитьПолеЕслиЕсть(КраткийInput, Шаг.input, "value");
			КраткийШаг.Вставить("input", КраткийInput);
		КонецЕсли;
		КраткийПлан.steps.Добавить(КраткийШаг);
	КонецЦикла;
	Возврат КраткийПлан;
КонецФункции


Функция СериализоватьJSONЛокально(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ЭтоСсылка1СДляJSON(Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения);
КонецФункции

Функция НормализоватьЗначениеДляJSONЛокально(Значение, Глубина = 0)
	Если Глубина > 8 Тогда
		Попытка
			Возврат Строка(Значение);
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ЭтоJSONОбъект(Значение) Тогда
		РезультатОбъект = Новый Структура;
		ЛокальныйОбъект = ПреобразоватьJSONОбъектВСтруктуру(Значение);
		Для Каждого Пара Из ЛокальныйОбъект Цикл
			РезультатОбъект.Вставить(Строка(Пара.Ключ), НормализоватьЗначениеДляJSONЛокально(Пара.Значение, Глубина + 1));
		КонецЦикла;
		Возврат РезультатОбъект;
	КонецЕсли;
	
	Если ЭтоJSONArray(Значение) Тогда
		РезультатМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			РезультатМассив.Добавить(НормализоватьЗначениеДляJSONЛокально(Элемент, Глубина + 1));
		КонецЦикла;
		Возврат РезультатМассив;
	КонецЕсли;
	
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		РезультатТаблицы = Новый Массив;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			СтруктураСтроки = Новый Структура;
			Для Каждого Колонка Из Значение.Колонки Цикл
				СтруктураСтроки.Вставить(Колонка.Имя, НормализоватьЗначениеДляJSONЛокально(СтрокаТаблицы[Колонка.Имя], Глубина + 1));
			КонецЦикла;
			РезультатТаблицы.Добавить(СтруктураСтроки);
		КонецЦикла;
		Возврат РезультатТаблицы;
	КонецЕсли;
	
	Если ЭтоСсылка1СДляJSON(Значение) Тогда
		СтруктураСсылки = Новый Структура;
		Попытка
			СтруктураСсылки.Вставить("guid", Строка(Значение.УникальныйИдентификатор()));
		Исключение
			СтруктураСсылки.Вставить("guid", "");
		КонецПопытки;
		Попытка
			СтруктураСсылки.Вставить("presentation", Строка(Значение));
		Исключение
			СтруктураСсылки.Вставить("presentation", "");
		КонецПопытки;
		СтруктураСсылки.Вставить("type", Строка(ТипЗначения));
		Возврат СтруктураСсылки;
	КонецЕсли;
	
	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция НормализоватьРезультатШагаПланаДляХранения(ResultData)
	Если ResultData = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НормализоватьЗначениеДляJSONЛокально(ResultData);
КонецФункции

Функция ЭтоJSONОбъект(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Структура")
		ИЛИ ТипЗначения = Тип("Соответствие")
		ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура")
		ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие");
КонецФункции

Функция ЭтоJSONArray(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Массив") ИЛИ ТипЗначения = Тип("ФиксированныйМассив");
КонецФункции

Функция ПолучитьСвойствоJSONОбъекта(Значение, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Если Значение.Свойство(ИмяСвойства) Тогда
			Возврат Значение[ИмяСвойства];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Если Значение.Свойство(ИмяСвойства) Тогда
			Возврат Значение[ИмяСвойства];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		ЗначениеСвойства = Значение.Получить(ИмяСвойства);
		Если ЗначениеСвойства <> Неопределено Тогда
			Возврат ЗначениеСвойства;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		ЗначениеСвойства = Значение.Получить(ИмяСвойства);
		Если ЗначениеСвойства <> Неопределено Тогда
			Возврат ЗначениеСвойства;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ПреобразоватьJSONОбъектВСтруктуру(Значение)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;
	Результат = Новый Структура;
	Если ТипЗнч(Значение) = Тип("Соответствие") ИЛИ ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Результат.Вставить(Строка(Пара.Ключ), Пара.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Для Каждого ИмяСвойства Из Значение Цикл
			Результат.Вставить(Строка(ИмяСвойства), Значение[ИмяСвойства]);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СоздатьПустойTypedPlan(Цель = "")
	План = Новый Структура;
	План.Вставить("plan_version", 1);
	План.Вставить("goal", Цель);
	План.Вставить("last_user_text", Цель);
	План.Вставить("steps", Новый Массив);
	Возврат План;
КонецФункции

Функция ЭтоДиалогРаспознаванияДокументов(СсылкаДиалога)
	Если СсылкаДиалога = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат СтрНайти(ВРег(Строка(СсылкаДиалога.ТипДиалога)), "РАСПОЗНАВ") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЕстьВложениеДокументаВДиалоге(СсылкаДиалога)
	Если СсылкаДиалога = Неопределено Или НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Диалог = СсылкаДиалога.ПолучитьОбъект();
		Для Каждого Сообщение Из Диалог.Сообщения Цикл
			ТекстСообщения = НРег(Строка(Сообщение.Текст));
			Если СтрНайти(ТекстСообщения, "[вложение]") > 0
				ИЛИ СтрНайти(ТекстСообщения, "pdf зарегистрирован") > 0
				ИЛИ СтрНайти(ТекстСообщения, ".pdf") > 0
				ИЛИ СтрНайти(ТекстСообщения, ".png") > 0
				ИЛИ СтрНайти(ТекстСообщения, ".jpg") > 0
				ИЛИ СтрНайти(ТекстСообщения, ".jpeg") > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ЭтоНамерениеРаспознаванияПервичногоДокумента(ТекстЗадачи)
	Текст = НРег(Строка(ТекстЗадачи));
	Возврат СтрНайти(Текст, "распознай") > 0
		ИЛИ СтрНайти(Текст, "распознать") > 0
		ИЛИ СтрНайти(Текст, "скан") > 0
		ИЛИ СтрНайти(Текст, "pdf") > 0
		ИЛИ СтрНайти(Текст, "картин") > 0
		ИЛИ СтрНайти(Текст, "вложен") > 0
		ИЛИ СтрНайти(Текст, "счет поставщика") > 0
		ИЛИ СтрНайти(Текст, "счёт поставщика") > 0
		ИЛИ СтрНайти(Текст, "счет на оплату") > 0
		ИЛИ СтрНайти(Текст, "счёт на оплату") > 0
		ИЛИ СтрНайти(Текст, "упд") > 0
		ИЛИ СтрНайти(Текст, "торг-12") > 0
		ИЛИ СтрНайти(Текст, "торг12") > 0
		ИЛИ СтрНайти(Текст, "акт услуг") > 0
		ИЛИ СтрНайти(Текст, "счет-фактур") > 0
		ИЛИ СтрНайти(Текст, "счёт-фактур") > 0;
КонецФункции

Функция СоздатьDSLЧерновикаРаспознавания(ИмяДокумента, ПредставлениеДокумента, ТекстЗадачи, СсылкаДиалога = Неопределено, Скил = Неопределено)
	Шаги = Новый Массив;
	DocumentMapping = ПолучитьDocumentMappingИзСкила(Скил);
	ReferencePolicy = ПолучитьReferencePolicyИзСкила(Скил);
	ОтправитьПрогрессРаспознавания(СсылкаДиалога, "Подбираю skill и поля документа");

	ШагМетаданные = Новый Структура;
	ШагМетаданные.Вставить("action", "GetMetadata");
	ШагМетаданные.Вставить("filter", ИмяДокумента);
	Шаги.Добавить(ШагМетаданные);

	ШагПоля = Новый Структура;
	ШагПоля.Вставить("action", "GetObjectFields");
	ШагПоля.Вставить("object_type", "Документ");
	ШагПоля.Вставить("object_name", ИмяДокумента);
	Шаги.Добавить(ШагПоля);

	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Комментарий", Лев("ИИ распознавание: " + ТекстЗадачи, 240));
	РаспознанныеДанные = РаспознатьПервичныйДокументВJSON(СсылкаДиалога, ИмяДокумента, ТекстЗадачи, Скил);
	Если РаспознанныеДанные = Неопределено Тогда
		ОтправитьПрогрессРаспознавания(СсылкаДиалога, "Распознавание не дало надежных данных");
		ШагПоказа = Новый Структура;
		ШагПоказа.Вставить("action", "ShowInfo");
		ШагПоказа.Вставить("message", "Не удалось надежно распознать документ из вложения. Проверьте качество файла или попробуйте другой скан; черновик документа не создан.");
		Шаги.Добавить(ШагПоказа);
		DSL = Новый Структура;
		DSL.Вставить("dsl_version", 2);
		DSL.Вставить("steps", Шаги);
		Возврат СериализоватьJSONЛокально(DSL);
	КонецЕсли;
	Если РаспознанныеДанные <> Неопределено Тогда
		ОтправитьПрогрессРаспознавания(СсылкаДиалога, "Собираю черновик документа из распознанных данных");
		ЗаполнитьДанныеДокументаИзРаспознавания(ДанныеДокумента, ИмяДокумента, РаспознанныеДанные, DocumentMapping);
		ДобавитьШагиСозданияСправочниковИзРаспознавания(Шаги, ReferencePolicy, ИмяДокумента, РаспознанныеДанные, DocumentMapping);
	КонецЕсли;

	ШагСоздания = Новый Структура;
	ШагСоздания.Вставить("action", "CreateDocument");
	ШагСоздания.Вставить("object_name", ИмяДокумента);
	ШагСоздания.Вставить("data", ДанныеДокумента);
	Шаги.Добавить(ШагСоздания);

	Если РаспознанныеДанные <> Неопределено Тогда
		ДобавитьШагиТабличныхСтрокИзРаспознавания(Шаги, ИмяДокумента, РаспознанныеДанные, DocumentMapping);
	КонецЕсли;

	ШагЗаписи = Новый Структура;
	ШагЗаписи.Вставить("action", "Write");
	Шаги.Добавить(ШагЗаписи);

	ШагПоказа = Новый Структура;
	ШагПоказа.Вставить("action", "ShowInfo");
	ШагПоказа.Вставить("message", "Создан черновик документа " + ПредставлениеДокумента + ": {СсылкаОбъекта}. Проведение не выполнялось.");
	Шаги.Добавить(ШагПоказа);

	DSL = Новый Структура;
	DSL.Вставить("dsl_version", 2);
	DSL.Вставить("steps", Шаги);
	Возврат СериализоватьJSONЛокально(DSL);
КонецФункции

Функция РаспознатьПервичныйДокументВJSON(СсылкаДиалога, ИмяДокумента, ТекстЗадачи, Скил = Неопределено)
	Попытка
		ОтправитьПрогрессРаспознавания(СсылкаДиалога, "Распознаю PDF или изображение");
		ПараметрыИИ = ИИА_Сервер.ПолучитьНастройкиПользователя(ИИА_Сервер.ИмяТекущегоПользователя());
		Если ПараметрыИИ = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ПараметрыИИ.Вставить("ТипДиалога", Перечисления.ИИА_ТипДиалога.РаспознаваниеДокументов);
		ПараметрыИИ.Вставить("ExpectedResponseFormat", "text");
		ПараметрыИИ.Вставить("UseNativeAttachments", Истина);
		ПараметрыИИ.Вставить("max_tokens", 2000);
		Если СсылкаДиалога <> Неопределено Тогда
			ПараметрыИИ.Вставить("СсылкаДиалога", СсылкаДиалога);
		КонецЕсли;
		ДопКонтекстСкила = "";
		Если Скил <> Неопределено Тогда
			DocumentMapping = ИИА_Skills.ПолучитьDocumentMappingСкила(Скил);
			ReferencePolicy = ИИА_Skills.ПолучитьReferencePolicyСкила(Скил);
			Если DocumentMapping <> Неопределено Тогда
				ДопКонтекстСкила = ДопКонтекстСкила + "DOCUMENT_MAPPING_JSON: " + СериализоватьJSONЛокально(DocumentMapping) + Символы.ПС;
			КонецЕсли;
			Если ReferencePolicy <> Неопределено Тогда
				ДопКонтекстСкила = ДопКонтекстСкила + "REFERENCE_POLICY_JSON: " + СериализоватьJSONЛокально(ReferencePolicy) + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
		Промпт =
			"Распознай первичный B2B документ РФ из приложенного изображения/PDF и верни только JSON object." + Символы.ПС +
			"Целевой документ 1С: " + ИмяДокумента + "." + Символы.ПС +
			ДопКонтекстСкила +
			"Задача пользователя: " + ТекстЗадачи + Символы.ПС +
			"Схема JSON: document_type, number, date, supplier_name, supplier_inn, supplier_kpp, buyer_name, buyer_inn, buyer_kpp, contract_number, contract_date, contract_name, payment_due_date, total_amount, vat_amount, currency, vat_included, confidence, missing, items." + Символы.ПС +
			"items - массив объектов: name, article, barcode, unit, quantity, price, amount, vat_rate, vat_amount. vat_included возвращай boolean, vat_rate возвращай как строку вида 20%, 10%, 0% или Без НДС. Не выдумывай невидимые значения, пустые поля оставляй пустыми. Ответ должен начинаться с { и заканчиваться }.";
		История = Новый ТаблицаЗначений;
		ОтветИИ = ИИА_Провайдеры.ВызватьИИ("Чат", Промпт, История, ПараметрыИИ, "Верни строго JSON object без markdown.", 0.0);
		Если ОтветИИ = Неопределено ИЛИ НЕ ОтветИИ.Свойство("Текст") ИЛИ ПустаяСтрока(ОтветИИ.Текст) Тогда
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[DOC_RECOGNITION_JSON_EMPTY] Ответ модели пустой или без поля Текст");
			Возврат Неопределено;
		КонецЕсли;
		Норм = НормализоватьJSONObjectТекст(ОтветИИ.Текст);
		Если ПустаяСтрока(Норм) Тогда
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[DOC_RECOGNITION_JSON_EMPTY] JSON не найден в ответе: " + Лев(ОтветИИ.Текст, 500));
			Возврат Неопределено;
		КонецЕсли;
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Норм);
			Данные = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
		Исключение
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[DOC_RECOGNITION_JSON_PARSE_ERROR] " + ОписаниеОшибки() + "; raw=" + Лев(ОтветИИ.Текст, 700) + "; normalized=" + Лев(Норм, 700));
			Возврат Неопределено;
		КонецПопытки;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[DOC_RECOGNITION_JSON] " + СжатьJSONДляЛога(Норм));
			ОтправитьПрогрессРаспознавания(СсылкаДиалога, "Данные распознаны");
			Возврат Данные;
		КонецЕсли;
	Исключение
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[DOC_RECOGNITION_JSON_ERROR] " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НормализоватьJSONObjectТекст(ИсходныйТекст)

	Текст = ?(ИсходныйТекст = Неопределено, "", Строка(ИсходныйТекст));
	Текст = СокрЛП(Текст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "```json", "");
	Текст = СтрЗаменить(Текст, "```JSON", "");
	Текст = СтрЗаменить(Текст, "```", "");
	НачалоJSON = СтрНайти(Текст, "{");
	Если НачалоJSON = 0 Тогда
		Возврат "";
	КонецЕсли;
	СчетчикСкобок = 0;
	ВКавычках = Ложь;
	Для Позиция = НачалоJSON По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = """" Тогда
			Если Позиция = 1 ИЛИ Сред(Текст, Позиция - 1, 1) <> "\" Тогда
				ВКавычках = НЕ ВКавычках;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ВКавычках Тогда
			Если Символ = "{" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли Символ = "}" Тогда
				СчетчикСкобок = СчетчикСкобок - 1;
				Если СчетчикСкобок = 0 Тогда
					Результат = Сред(Текст, НачалоJSON, Позиция - НачалоJSON + 1);
					Результат = СтрЗаменить(Результат, Символ(65279), "");
					Для Код = 0 По 31 Цикл
						Если Код = 9 ИЛИ Код = 10 ИЛИ Код = 13 Тогда
							Продолжить;
						КонецЕсли;
						Результат = СтрЗаменить(Результат, Символ(Код), "");
					КонецЦикла;
					Возврат СокрЛП(Результат);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ОтправитьПрогрессРаспознавания(СсылкаДиалога, Текст)

	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) ИЛИ ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "Прогресс", Новый Структура("Текст", Текст));

КонецПроцедуры

Функция ПолучитьСвойствоРаспознавания(Данные, ИмяПоля)
	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Если Данные.Свойство(ИмяПоля) Тогда
		Возврат Данные[ИмяПоля];
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьЗначениеПоискаНоменклатурыИзРаспознавания(СтрокаРаспознавания)
	Для Каждого ИмяПоля Из СтрРазделить("barcode,article,name", ",", Ложь) Цикл
		ЗначениеПоля = ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, ИмяПоля);
		Если НЕ ПустаяСтрока(СокрЛП(Строка(ЗначениеПоля))) Тогда
			Возврат ЗначениеПоля;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ПодобратьРеквизитДокументаИзКандидатов(ИмяДокумента, Кандидаты)
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ИИА_Метаданные.СуществуетРеквизитДокумента(ИмяДокумента, Строка(Кандидат)) Тогда
			Возврат Строка(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ПолучитьDocumentMappingИзСкила(Скил)
	Если Скил = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИИА_Skills.ПолучитьDocumentMappingСкила(Скил);
КонецФункции

Функция ПолучитьReferencePolicyИзСкила(Скил)
	Если Скил = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИИА_Skills.ПолучитьReferencePolicyСкила(Скил);
КонецФункции

Функция ПолучитьКандидатыПолейИзМаппинга(Маппинг, Группа, ИмяПоля, Fallback)
	Если Маппинг <> Неопределено И ЭтоJSONОбъект(Маппинг) Тогда
		ГруппаПолей = ?(ПустаяСтрока(Группа), Маппинг, ПолучитьСвойствоJSONОбъекта(Маппинг, Группа, Неопределено));
		Если ЭтоJSONОбъект(ГруппаПолей) Тогда
			Кандидаты = ПолучитьСвойствоJSONОбъекта(ГруппаПолей, ИмяПоля, Неопределено);
			Если ЭтоJSONArray(Кандидаты) И Кандидаты.Количество() > 0 Тогда
				Возврат Кандидаты;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Fallback;
КонецФункции

Функция ПолучитьПервуюТабличнуюМаппинг(Маппинг)
	Если Маппинг = Неопределено ИЛИ НЕ ЭтоJSONОбъект(Маппинг) Тогда
		Возврат Неопределено;
	КонецЕсли;
	TableParts = ПолучитьСвойствоJSONОбъекта(Маппинг, "table_parts", Неопределено);
	Если ЭтоJSONArray(TableParts) И TableParts.Количество() > 0 И ЭтоJSONОбъект(TableParts[0]) Тогда
		Возврат TableParts[0];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПодобратьКолонкуТабличнойЧастиИзКандидатов(ИмяДокумента, ИмяТЧ, Кандидаты)
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТЧ = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТЧ);
	Если ТЧ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ТЧ.Реквизиты.Найти(Строка(Кандидат)) <> Неопределено Тогда
			Возврат Строка(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента, Кандидаты, Значение)
	Если ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
		Возврат;
	КонецЕсли;
	ИмяРеквизита = ПодобратьРеквизитДокументаИзКандидатов(ИмяДокумента, Кандидаты);
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ДанныеДокумента.Свойство(ИмяРеквизита) Тогда
		ДанныеДокумента.Вставить(ИмяРеквизита, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьДанныеДокументаИзРаспознавания(ДанныеДокумента, ИмяДокумента, Данные, DocumentMapping = Неопределено)
	ДобавитьРаспознанныеСтороныВКомментарий(ДанныеДокумента, Данные);
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "number", СтрРазделить("НомерВходящегоДокумента,НомерДокумента,ВходящийНомер,НомерСчетаФактуры", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "number"));
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "date", СтрРазделить("ДатаВходящегоДокумента,ДатаДокумента,ВходящаяДата,ДатаСчетаФактуры", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "date"));
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "total_amount", СтрРазделить("СуммаДокумента,Сумма,Всего,СуммаВключаетНДС", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "total_amount"));
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "vat_amount", СтрРазделить("СуммаНДС,НДС", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "vat_amount"));
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "currency", СтрРазделить("ВалютаДокумента,Валюта", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "currency"));
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "payment_due_date", СтрРазделить("ДатаОплаты,СрокОплаты,ОплатаДо", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "payment_due_date"));
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "vat_included", СтрРазделить("СуммаВключаетНДС,ЦенаВключаетНДС", ",", Ложь)),
		ПолучитьСвойствоРаспознавания(Данные, "vat_included"));
	ЗначениеПоставщика = ПолучитьСвойствоРаспознавания(Данные, "supplier_inn");
	Если ПустаяСтрока(СокрЛП(Строка(ЗначениеПоставщика))) Тогда
		ЗначениеПоставщика = ПолучитьСвойствоРаспознавания(Данные, "supplier_name");
	КонецЕсли;
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "supplier_name", СтрРазделить("Контрагент,Поставщик", ",", Ложь)),
		ЗначениеПоставщика);
	ЗначениеПокупателя = ПолучитьСвойствоРаспознавания(Данные, "buyer_inn");
	Если ПустаяСтрока(СокрЛП(Строка(ЗначениеПокупателя))) Тогда
		ЗначениеПокупателя = ПолучитьСвойствоРаспознавания(Данные, "buyer_name");
	КонецЕсли;
	ДобавитьРаспознанноеПолеДокумента(ДанныеДокумента, ИмяДокумента,
		ПолучитьКандидатыПолейИзМаппинга(DocumentMapping, "header_fields", "buyer_name", СтрРазделить("Организация,Покупатель", ",", Ложь)),
		ЗначениеПокупателя);
КонецПроцедуры

Процедура ДобавитьРаспознанныеСтороныВКомментарий(ДанныеДокумента, Данные)

	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Комментарий = ?(ДанныеДокумента.Свойство("Комментарий"), Строка(ДанныеДокумента.Комментарий), "");
	Поставщик = ПолучитьСвойствоРаспознавания(Данные, "supplier_name");
	ПоставщикИНН = ПолучитьСвойствоРаспознавания(Данные, "supplier_inn");
	Покупатель = ПолучитьСвойствоРаспознавания(Данные, "buyer_name");
	ПокупательИНН = ПолучитьСвойствоРаспознавания(Данные, "buyer_inn");
	Дополнение = "";
	Если НЕ ПустаяСтрока(СокрЛП(Строка(Поставщик))) Тогда
		Дополнение = Дополнение + " Поставщик: " + Строка(Поставщик);
		Если НЕ ПустаяСтрока(СокрЛП(Строка(ПоставщикИНН))) Тогда
			Дополнение = Дополнение + " ИНН " + Строка(ПоставщикИНН);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ПустаяСтрока(СокрЛП(Строка(Покупатель))) Тогда
		Дополнение = Дополнение + " Покупатель: " + Строка(Покупатель);
		Если НЕ ПустаяСтрока(СокрЛП(Строка(ПокупательИНН))) Тогда
			Дополнение = Дополнение + " ИНН " + Строка(ПокупательИНН);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Дополнение) Тогда
		ДанныеДокумента.Вставить("Комментарий", Лев(Комментарий + Дополнение, 240));
	КонецЕсли;

КонецПроцедуры

Функция ПодобратьТабличнуюЧастьДляРаспознавания(ИмяДокумента, DocumentMapping = Неопределено)
	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Кандидаты = СтрРазделить("Товары,Запасы,Услуги,ТоварыИУслуги,Состав,РасшифровкаПлатежа", ",", Ложь);
	TableMapping = ПолучитьПервуюТабличнуюМаппинг(DocumentMapping);
	Если TableMapping <> Неопределено Тогда
		MappedCandidates = ПолучитьСвойствоJSONОбъекта(TableMapping, "name_candidates", Неопределено);
		Если ЭтоJSONArray(MappedCandidates) И MappedCandidates.Количество() > 0 Тогда
			Кандидаты = MappedCandidates;
		КонецЕсли;
	КонецЕсли;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если МетаданныеДокумента.ТабличныеЧасти.Найти(Строка(Кандидат)) <> Неопределено Тогда
			Возврат Строка(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Если МетаданныеДокумента.ТабличныеЧасти.Количество() > 0 Тогда
		Возврат МетаданныеДокумента.ТабличныеЧасти[0].Имя;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьПравилоСправочника(ReferencePolicy, ИмяСправочника)
	Если ReferencePolicy = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ReferencePolicy) Тогда
		Возврат "ask";
	КонецЕсли;
	ПолитикиСправочников = ПолучитьСвойствоJSONОбъекта(ReferencePolicy, "catalogs", Неопределено);
	Если ЭтоJSONОбъект(ПолитикиСправочников) Тогда
		CatalogPolicy = ПолучитьСвойствоJSONОбъекта(ПолитикиСправочников, ИмяСправочника, Неопределено);
		Если ЭтоJSONОбъект(CatalogPolicy) Тогда
			Возврат НРег(Строка(ПолучитьСвойствоJSONОбъекта(CatalogPolicy, "on_missing", "ask")));
		КонецЕсли;
	КонецЕсли;
	Возврат НРег(Строка(ПолучитьСвойствоJSONОбъекта(ReferencePolicy, "default_on_missing", "ask")));
КонецФункции

Процедура ДобавитьШагиСозданияСправочниковИзРаспознавания(Шаги, ReferencePolicy, ИмяДокумента, Данные, DocumentMapping = Неопределено)
	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ПолучитьПравилоСправочника(ReferencePolicy, "Контрагенты") = "create" Тогда
		ИмяПоставщика = ПолучитьСвойствоРаспознавания(Данные, "supplier_name");
		Если НЕ ПустаяСтрока(СокрЛП(Строка(ИмяПоставщика))) Тогда
			ДанныеКонтрагента = Новый Структура;
			ДанныеКонтрагента.Вставить("Наименование", ИмяПоставщика);
			ИНН = ПолучитьСвойствоРаспознавания(Данные, "supplier_inn");
			Если НЕ ПустаяСтрока(СокрЛП(Строка(ИНН))) Тогда
				ДанныеКонтрагента.Вставить("ИНН", ИНН);
			КонецЕсли;
			КПП = ПолучитьСвойствоРаспознавания(Данные, "supplier_kpp");
			Если НЕ ПустаяСтрока(СокрЛП(Строка(КПП))) Тогда
				ДанныеКонтрагента.Вставить("КПП", КПП);
			КонецЕсли;
			ДобавитьШагCreateReferenceИWrite(Шаги, "Контрагенты", ДанныеКонтрагента);
		КонецЕсли;
	КонецЕсли;
	Если ПолучитьПравилоСправочника(ReferencePolicy, "Номенклатура") <> "create" Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Данные.Свойство("items") ИЛИ ТипЗнч(Данные.items) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	УжеДобавленные = Новый Массив;
	Индекс = 0;
	Для Каждого СтрокаРаспознавания Из Данные.items Цикл
		Если ТипЗнч(СтрокаРаспознавания) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
		Если Индекс > 20 Тогда
			Прервать;
		КонецЕсли;
		ИмяНоменклатуры = ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "name");
		Если ПустаяСтрока(СокрЛП(Строка(ИмяНоменклатуры))) Тогда
			Продолжить;
		КонецЕсли;
		КлючНоменклатуры = ВРег(СокрЛП(Строка(ИмяНоменклатуры)));
		Если УжеДобавленные.Найти(КлючНоменклатуры) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавленные.Добавить(КлючНоменклатуры);
		ДанныеНоменклатуры = Новый Структура;
		ДанныеНоменклатуры.Вставить("Наименование", ИмяНоменклатуры);
		Артикул = ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "article");
		Если НЕ ПустаяСтрока(СокрЛП(Строка(Артикул))) Тогда
			ДанныеНоменклатуры.Вставить("Артикул", Артикул);
		КонецЕсли;
		Штрихкод = ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "barcode");
		Если НЕ ПустаяСтрока(СокрЛП(Строка(Штрихкод))) Тогда
			ДанныеНоменклатуры.Вставить("Штрихкод", Штрихкод);
		КонецЕсли;
		ДобавитьШагCreateReferenceИWrite(Шаги, "Номенклатура", ДанныеНоменклатуры);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьШагCreateReferenceИWrite(Шаги, ИмяСправочника, ДанныеЭлемента)
	ШагСоздания = Новый Структура;
	ШагСоздания.Вставить("action", "CreateReference");
	ШагСоздания.Вставить("object_name", ИмяСправочника);
	ШагСоздания.Вставить("data", ДанныеЭлемента);
	Шаги.Добавить(ШагСоздания);
	ШагЗаписи = Новый Структура;
	ШагЗаписи.Вставить("action", "Write");
	Шаги.Добавить(ШагЗаписи);
КонецПроцедуры

Процедура ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ, Кандидаты, Значение)
	Если ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
		Возврат;
	КонецЕсли;
	Колонка = ПодобратьКолонкуТабличнойЧастиИзКандидатов(ИмяДокумента, ИмяТЧ, Кандидаты);
	Если ПустаяСтрока(Колонка) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ДанныеСтроки.Свойство(Колонка) Тогда
		ДанныеСтроки.Вставить(Колонка, Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьШагиТабличныхСтрокИзРаспознавания(Шаги, ИмяДокумента, Данные, DocumentMapping = Неопределено)
	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") ИЛИ НЕ Данные.Свойство("items") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Данные.items) <> Тип("Массив") ИЛИ Данные.items.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИмяТЧ = ПодобратьТабличнуюЧастьДляРаспознавания(ИмяДокумента, DocumentMapping);
	Если ПустаяСтрока(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	TableMapping = ПолучитьПервуюТабличнуюМаппинг(DocumentMapping);
	ItemFields = Неопределено;
	Если TableMapping <> Неопределено Тогда
		ItemFields = ПолучитьСвойствоJSONОбъекта(TableMapping, "item_fields", Неопределено);
	КонецЕсли;
	Индекс = 0;
	Для Каждого СтрокаРаспознавания Из Данные.items Цикл
		Если ТипЗнч(СтрокаРаспознавания) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
		Если Индекс > 20 Тогда
			Прервать;
		КонецЕсли;
		ДанныеСтроки = Новый Структура;
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "name", СтрРазделить("Номенклатура,Содержание,Наименование", ",", Ложь)),
			ПолучитьЗначениеПоискаНоменклатурыИзРаспознавания(СтрокаРаспознавания));
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "quantity", СтрРазделить("Количество,Кол", ",", Ложь)),
			ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "quantity"));
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "unit", СтрРазделить("ЕдиницаИзмерения,Единица,ЕдИзм", ",", Ложь)),
			ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "unit"));
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "price", СтрРазделить("Цена,ЦенаЗаЕдиницу", ",", Ложь)),
			ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "price"));
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "amount", СтрРазделить("Сумма,Всего,СуммаДокумента", ",", Ложь)),
			ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "amount"));
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "vat_amount", СтрРазделить("СуммаНДС,НДС", ",", Ложь)),
			ПолучитьСуммуНДССтрокиИзРаспознавания(СтрокаРаспознавания, Данные));
		ДобавитьЗначениеСтрокиЕслиЕстьКолонка(ДанныеСтроки, ИмяДокумента, ИмяТЧ,
			ПолучитьКандидатыПолейИзМаппинга(ItemFields, "", "vat_rate", СтрРазделить("СтавкаНДС,СтавкаНалога", ",", Ложь)),
			ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "vat_rate"));
		Если ДанныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ШагСтроки = Новый Структура;
		ШагСтроки.Вставить("action", "AddTableRow");
		ШагСтроки.Вставить("table", ИмяТЧ);
		ШагСтроки.Вставить("data", ДанныеСтроки);
		Шаги.Добавить(ШагСтроки);
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСуммуНДССтрокиИзРаспознавания(СтрокаРаспознавания, ДанныеДокумента)
	СуммаНДС = ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "vat_amount");
	Если НЕ ПустаяСтрока(СокрЛП(Строка(СуммаНДС))) Тогда
		Возврат СуммаНДС;
	КонецЕсли;
	СуммаСтроки = ЧислоРаспознавания(ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "amount"), Неопределено);
	СтавкаНДС = ПолучитьСтавкуНДСЧислом(ПолучитьСвойствоРаспознавания(СтрокаРаспознавания, "vat_rate"));
	Если СуммаСтроки = Неопределено ИЛИ СтавкаНДС = Неопределено ИЛИ СтавкаНДС = 0 Тогда
		Возврат "";
	КонецЕсли;
	НДСВключен = БулевоРаспознавания(ПолучитьСвойствоРаспознавания(ДанныеДокумента, "vat_included"), Истина);
	Если НДСВключен Тогда
		Возврат Окр(СуммаСтроки * СтавкаНДС / (100 + СтавкаНДС), 2);
	КонецЕсли;
	Возврат Окр(СуммаСтроки * СтавкаНДС / 100, 2);
КонецФункции

Функция ЧислоРаспознавания(Значение, ЗначениеПоУмолчанию = 0)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Текст) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, ".", ",");
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция ПолучитьСтавкуНДСЧислом(Значение)
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Текст) ИЛИ СтрНайти(Текст, "БЕЗ") > 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если СтрНайти(Текст, "20") > 0 Тогда
		Возврат 20;
	КонецЕсли;
	Если СтрНайти(Текст, "10") > 0 Тогда
		Возврат 10;
	КонецЕсли;
	Если СтрНайти(Текст, "0") > 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция БулевоРаспознавания(Значение, ЗначениеПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = ВРег(СокрЛП(Строка(Значение)));
	Если Текст = "TRUE" ИЛИ Текст = "ИСТИНА" ИЛИ Текст = "ДА" ИЛИ Текст = "1" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Текст = "FALSE" ИЛИ Текст = "ЛОЖЬ" ИЛИ Текст = "НЕТ" ИЛИ Текст = "0" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция СоздатьПланРаспознаванияПоСкилу(СсылкаДиалога, ТекстЗадачи)
	РежимРаспознавания = ЭтоДиалогРаспознаванияДокументов(СсылкаДиалога);
	Если НЕ РежимРаспознавания
		И НЕ (ЕстьВложениеДокументаВДиалоге(СсылкаДиалога)
			И ЭтоНамерениеРаспознаванияПервичногоДокумента(ТекстЗадачи)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипДиалогаДляСкилов = ?(РежимРаспознавания, СсылкаДиалога.ТипДиалога, Перечисления.ИИА_ТипДиалога.РаспознаваниеДокументов);
	Скилы = ИИА_Skills.ПодобратьСкилы(ТекстЗадачи, ТипДиалогаДляСкилов, Неопределено, 1);
	Если Скилы = Неопределено ИЛИ Скилы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Скил = Скилы[0];
	Если НЕ Скил.Свойство("target_object_name") ИЛИ ПустаяСтрока(Строка(Скил.target_object_name)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяДокумента = Строка(Скил.target_object_name);
	ПредставлениеДокумента = ?(Скил.Свойство("title") И НЕ ПустаяСтрока(Строка(Скил.title)), Строка(Скил.title), ИмяДокумента);
	DSLШаблон = СоздатьDSLЧерновикаРаспознавания(ИмяДокумента, ПредставлениеДокумента, ТекстЗадачи, СсылкаДиалога, Скил);

	План = СоздатьПустойTypedPlan(ТекстЗадачи);
	План.Вставить("source", "skill_dsl_template");
	План.Вставить("skill_name", Строка(Скил.name));
	План.Вставить("target_object_name", ИмяДокумента);

	Input = Новый Структура;
	Input.Вставить("dsl", DSLШаблон);
	Input.Вставить("skill_name", Строка(Скил.name));
	Input.Вставить("target_object_name", ИмяДокумента);
	Input.Вставить("reference_policy", ИИА_Skills.ПолучитьReferencePolicyСкила(Скил));
	Input.Вставить("document_mapping", ИИА_Skills.ПолучитьDocumentMappingСкила(Скил));

	Шаг = Новый Структура;
	Шаг.Вставить("id", "step_1");
	Шаг.Вставить("seq_no", 1);
	Шаг.Вставить("kind", "dsl_template");
	Шаг.Вставить("title", "Создать черновик документа по skill " + Строка(Скил.name));
	Шаг.Вставить("depends_on", Новый Массив);
	Шаг.Вставить("input", Input);
	Шаг.Вставить("status", "pending");
	Шаг.Вставить("result_summary", "");
	Шаг.Вставить("result_data", Неопределено);
	План.steps.Добавить(Шаг);

	Возврат План;
КонецФункции

Функция СтатусШагаЗавершен(ШагПлана)
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	Статус = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "status", "pending")));
	Возврат Статус = "DONE" ИЛИ Статус = "SKIPPED";
КонецФункции

Функция ИзвлечьЗначениеИзСтроковогоФильтра(Знач ТекстФильтра, Знач ИмяПоля)
	Фильтр = СокрЛП(Строка(ТекстФильтра));
	Если ПустаяСтрока(Фильтр) Тогда
		Возврат "";
	КонецЕсли;
	ФильтрВРег = ВРег(Фильтр);
	ИмяПоляВРег = ВРег(ИмяПоля);
	Префикс1 = ИмяПоляВРег + " = """;
	Префикс2 = ИмяПоляВРег + " = '";
	Поз = СтрНайти(ФильтрВРег, Префикс1);
	ДлинаПрефикса = СтрДлина(Префикс1);
	СимволЗакрытия = """";
	Если Поз = 0 Тогда
		Поз = СтрНайти(ФильтрВРег, Префикс2);
		ДлинаПрефикса = СтрДлина(Префикс2);
		СимволЗакрытия = "'";
	КонецЕсли;
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	НачалоЗначения = Поз + ДлинаПрефикса;
	Остаток = Сред(Фильтр, НачалоЗначения);
	ПозЗакрытия = СтрНайти(Остаток, СимволЗакрытия);
	Если ПозЗакрытия = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Остаток, ПозЗакрытия - 1);
КонецФункции

Функция ПостроитьЯвныйЗапросПоискаСсылки(ПолноеИмяОбъекта, ИмяПоля, ЗначениеПоля)
	Если ПустаяСтрока(Строка(ПолноеИмяОбъекта)) Или ПустаяСтрока(Строка(ИмяПоля)) Или ПустаяСтрока(Строка(ЗначениеПоля)) Тогда
		Возврат "";
	КонецЕсли;
	Экранированное = СтрЗаменить(Строка(ЗначениеПоля), """", """""");
	Запрос = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка" + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ ПолноеИмяОбъекта + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ ИмяПоля + " = """ + Экранированное + """";
	Если ВРег(ИмяПоля) = "НОМЕР" Тогда
		Запрос = Запрос + Символы.ПС + "УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	КонецЕсли;
	Возврат Запрос;
КонецФункции

Процедура НормализоватьСпецШагиTypedPlan(ШагПлана, Цель = "")
	Kind = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", "")));
	InputШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
	Если НЕ ЭтоJSONОбъект(InputШага) Тогда
		Возврат;
	КонецЕсли;
	
	Если Kind = "CREATE_DOCUMENT" Тогда
		ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "document_object_name", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "document_name", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "document_type", ""));
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяОбъекта) Тогда
			Если СтрНайти(ИмяОбъекта, ".") > 0 Тогда
				ИмяОбъекта = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
			КонецЕсли;
			InputШага.Вставить("object_name", ИмяОбъекта);
		КонецЕсли;
		Если ПолучитьСвойствоJSONОбъекта(InputШага, "data", Неопределено) = Неопределено
			И ПолучитьСвойствоJSONОбъекта(InputШага, "fields_to_set", Неопределено) <> Неопределено Тогда
			InputШага.Вставить("data", ПолучитьСвойствоJSONОбъекта(InputШага, "fields_to_set"));
		КонецЕсли;
	ИначеЕсли Kind = "CREATE_REFERENCE" Тогда
		ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "reference_object_name", ""));
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "reference_name", ""));
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяОбъекта) Тогда
			Если СтрНайти(ИмяОбъекта, ".") > 0 Тогда
				ИмяОбъекта = Сред(ИмяОбъекта, СтрНайти(ИмяОбъекта, ".") + 1);
			КонецЕсли;
			InputШага.Вставить("object_name", ИмяОбъекта);
		КонецЕсли;
		Если ПолучитьСвойствоJSONОбъекта(InputШага, "data", Неопределено) = Неопределено
			И ПолучитьСвойствоJSONОбъекта(InputШага, "fields_to_set", Неопределено) <> Неопределено Тогда
			InputШага.Вставить("data", ПолучитьСвойствоJSONОбъекта(InputШага, "fields_to_set"));
		КонецЕсли;
	ИначеЕсли Kind = "SET_FIELD" Тогда
		Если ПолучитьСвойствоJSONОбъекта(InputШага, "fields", Неопределено) = Неопределено
			И ПолучитьСвойствоJSONОбъекта(InputШага, "fields_to_set", Неопределено) <> Неопределено Тогда
			InputШага.Вставить("fields", ПолучитьСвойствоJSONОбъекта(InputШага, "fields_to_set"));
		КонецЕсли;
	ИначеЕсли Kind = "WRITE_OBJECT" Тогда
		OperationId = ПолучитьСвойствоJSONОбъекта(InputШага, "operation_id", Неопределено);
		Если OperationId = Неопределено ИЛИ ПустаяСтрока(Строка(OperationId)) Тогда
			InputШага.Вставить("operation_id", Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", "write_object")));
		КонецЕсли;
	ИначеЕсли Kind = "GET_OBJECT_FIELDS" Тогда
		ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяОбъекта) Тогда
			InputШага.Вставить("object", НормализоватьИмяОбъектаДляGetObjectFields(ИмяОбъекта));
		КонецЕсли;
	ИначеЕсли Kind = "GET_METADATA" Тогда
		Фильтр = ПолучитьСвойствоJSONОбъекта(InputШага, "filter", Неопределено);
		Если Фильтр = Неопределено Тогда
			КандидатФильтра = СобратьФильтрGetMetadataИзInput(InputШага);
			Если ПустаяСтрока(КандидатФильтра) Тогда
				КандидатФильтра = Цель;
			КонецЕсли;
			InputШага.Вставить("filter", КандидатФильтра);
		ИначеЕсли ТипЗнч(Фильтр) <> Тип("Строка") Тогда
			КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
			Если ПустаяСтрока(КандидатФильтра) Тогда
				КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
			КонецЕсли;
			Если ПустаяСтрока(КандидатФильтра) Тогда
				КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "name", ""));
			КонецЕсли;
			Если ПустаяСтрока(КандидатФильтра) И ЭтоJSONОбъект(Фильтр) Тогда
				КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(Фильтр, "object_name", ""));
				Если ПустаяСтрока(КандидатФильтра) Тогда
					КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(Фильтр, "object", ""));
				КонецЕсли;
				Если ПустаяСтрока(КандидатФильтра) Тогда
					КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(Фильтр, "name", ""));
				КонецЕсли;
				Если ПустаяСтрока(КандидатФильтра) Тогда
					КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(Фильтр, "value", ""));
				КонецЕсли;
			КонецЕсли;
			Если ПустаяСтрока(КандидатФильтра) Тогда
				КандидатФильтра = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "title", ""));
			КонецЕсли;
			Если ПустаяСтрока(КандидатФильтра) Тогда
				КандидатФильтра = Цель;
			КонецЕсли;
			InputШага.Вставить("filter", КандидатФильтра);
		КонецЕсли;
	ИначеЕсли Kind = "RUN_QUERY" Тогда
		СанитизироватьInputRunQuery(ШагПлана);
	КонецЕсли;
	
	ШагПлана.input = InputШага;
КонецПроцедуры

Функция СобратьФильтрGetMetadataИзInput(InputШага)
	Части = Новый Массив;
	ИменаСвойств = Новый Массив;
	ИменаСвойств.Добавить("object_names");
	ИменаСвойств.Добавить("name_contains");
	ИменаСвойств.Добавить("object_name");
	ИменаСвойств.Добавить("object");
	ИменаСвойств.Добавить("entity_hint");
	ИменаСвойств.Добавить("name");
	Для Каждого ИмяСвойства Из ИменаСвойств Цикл
		Значение = ПолучитьСвойствоJSONОбъекта(InputШага, ИмяСвойства, Неопределено);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоJSONArray(Значение) Тогда
			Для Каждого Элемент Из Значение Цикл
				ТекстЭлемента = СокрЛП(Строка(Элемент));
				Если НЕ ПустаяСтрока(ТекстЭлемента) Тогда
					Части.Добавить(ТекстЭлемента);
				КонецЕсли;
			КонецЦикла;
		Иначе
			ТекстЗначения = СокрЛП(Строка(Значение));
			Если НЕ ПустаяСтрока(ТекстЗначения) Тогда
				Части.Добавить(ТекстЗначения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");
КонецФункции

Функция НормализоватьШагTypedPlan(ШагПлана, Индекс, Цель = "")
	Результат = Новый Структура;
	Результат.Вставить("id", ?(НЕ ПустаяСтрока(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", ""))), Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", "")), "step_" + Строка(Индекс + 1)));
	Результат.Вставить("seq_no", Индекс + 1);
	Результат.Вставить("kind", Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", "")));
	Результат.Вставить("title", Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "title", "Шаг " + Строка(Индекс + 1))));
	Зависимости = ПолучитьСвойствоJSONОбъекта(ШагПлана, "depends_on", Неопределено);
	Если ЭтоJSONArray(Зависимости) Тогда
		Результат.Вставить("depends_on", Зависимости);
	Иначе
		Результат.Вставить("depends_on", Новый Массив);
	КонецЕсли;
	Input = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
	Если ТипЗнч(Input) = Тип("Структура") Тогда
		Результат.Вставить("input", Input);
	ИначеЕсли ТипЗнч(Input) = Тип("Соответствие") Тогда
		Результат.Вставить("input", ПреобразоватьJSONОбъектВСтруктуру(Input));
	Иначе
		Результат.Вставить("input", Новый Структура);
	КонецЕсли;
	Результат.Вставить("status", Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "status", "pending")));
	Результат.Вставить("result_summary", Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "result_summary", "")));
	Результат.Вставить("result_data", ПолучитьСвойствоJSONОбъекта(ШагПлана, "result_data", Неопределено));
	НормализоватьСпецШагиTypedPlan(Результат, Цель);
	Возврат Результат;
КонецФункции

Функция ПланСодержитShowInfoПослеRunQuery(План, ИдRunQuery)
	Для Каждого ШагПлана Из План.steps Цикл
		Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) <> "SHOW_INFO" Тогда
			Продолжить;
		КонецЕсли;
		Зависимости = ПолучитьСвойствоJSONОбъекта(ШагПлана, "depends_on", Неопределено);
		Если НЕ ЭтоJSONArray(Зависимости) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИдЗависимости Из Зависимости Цикл
			Если Строка(ИдЗависимости) = Строка(ИдRunQuery) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ДобавитьShowInfoПослеRunQueryЕслиНужно(План)
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") ИЛИ НЕ План.Свойство("steps") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ШагПлана Из План.steps Цикл
		Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) <> "RUN_QUERY" Тогда
			Продолжить;
		КонецЕсли;
		ИдШага = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", ""));
		Если ПустаяСтрока(ИдШага) ИЛИ ПланСодержитShowInfoПослеRunQuery(План, ИдШага) Тогда
			Продолжить;
		КонецЕсли;
		Зависимости = Новый Массив;
		Зависимости.Добавить(ИдШага);
		InputShowInfo = Новый Структура("source", ИдШага);
		НовыйШаг = Новый Структура;
		НовыйШаг.Вставить("id", ИдШага + "_show_info");
		НовыйШаг.Вставить("seq_no", План.steps.Количество() + 1);
		НовыйШаг.Вставить("kind", "show_info");
		НовыйШаг.Вставить("title", "Вывести результат запроса пользователю");
		НовыйШаг.Вставить("depends_on", Зависимости);
		НовыйШаг.Вставить("input", InputShowInfo);
		НовыйШаг.Вставить("status", "pending");
		НовыйШаг.Вставить("result_summary", "");
		НовыйШаг.Вставить("result_data", Неопределено);
		План.steps.Добавить(НовыйШаг);
	КонецЦикла;
КонецПроцедуры

Функция ЭтоWriteKindПлана(Kind)
	KindВРег = ВРег(Строка(Kind));
	Возврат KindВРег = "CREATE_DOCUMENT"
		ИЛИ KindВРег = "CREATE_REFERENCE"
		ИЛИ KindВРег = "SET_FIELD"
		ИЛИ KindВРег = "ADD_TABLE_ROW"
		ИЛИ KindВРег = "WRITE_OBJECT"
		ИЛИ KindВРег = "POST_DOCUMENT";
КонецФункции

Функция ШагЗависитОтИдентификатораРекурсивно(План, ШагПлана, ИдЗависимости, Просмотренные = Неопределено)
	Если План = Неопределено ИЛИ ШагПлана = Неопределено ИЛИ ПустаяСтрока(Строка(ИдЗависимости)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Просмотренные = Неопределено Тогда
		Просмотренные = Новый Соответствие;
	КонецЕсли;
	ИдШага = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", ""));
	Если НЕ ПустаяСтрока(ИдШага) Тогда
		Если Просмотренные.Получить(ИдШага) <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Просмотренные.Вставить(ИдШага, Истина);
	КонецЕсли;
	Зависимости = ПолучитьСвойствоJSONОбъекта(ШагПлана, "depends_on", Неопределено);
	Если НЕ ЭтоJSONArray(Зависимости) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ИдТекущейЗависимости Из Зависимости Цикл
		Если Строка(ИдТекущейЗависимости) = Строка(ИдЗависимости) Тогда
			Возврат Истина;
		КонецЕсли;
		ШагЗависимости = НайтиШагВПланеПоИдентификатору(План, Строка(ИдТекущейЗависимости));
		Если ШагЗависимости <> Неопределено
			И ШагЗависитОтИдентификатораРекурсивно(План, ШагЗависимости, ИдЗависимости, Просмотренные) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ПометитьМягкиеLookupДляWriteFlow(План)
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") ИЛИ НЕ План.Свойство("steps") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ШагПлана Из План.steps Цикл
		Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) <> "FIND_REFERENCE_BY_NAME" Тогда
			Продолжить;
		КонецЕсли;
		ИдLookup = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", ""));
		Если ПустаяСтрока(ИдLookup) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из План.steps Цикл
			Если НЕ ЭтоWriteKindПлана(ПолучитьСвойствоJSONОбъекта(Кандидат, "kind", "")) Тогда
				Продолжить;
			КонецЕсли;
			Если ШагЗависитОтИдентификатораРекурсивно(План, Кандидат, ИдLookup) Тогда
				InputLookup = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
				Если ЭтоJSONОбъект(InputLookup) Тогда
					InputLookup.Вставить("allow_not_found", Истина);
					ШагПлана.input = InputLookup;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ЕстьWriteНамерениеВТексте(ТекстЗадачи)
	Текст = НРег(Строка(ТекстЗадачи));
	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("создай");
	КлючевыеСлова.Добавить("создать");
	КлючевыеСлова.Добавить("запиши");
	КлючевыеСлова.Добавить("записать");
	КлючевыеСлова.Добавить("проведи");
	КлючевыеСлова.Добавить("провести");
	КлючевыеСлова.Добавить("измени");
	КлючевыеСлова.Добавить("изменить");
	КлючевыеСлова.Добавить("удали");
	КлючевыеСлова.Добавить("удалить");
	КлючевыеСлова.Добавить("добавь");
	КлючевыеСлова.Добавить("добавить");
	КлючевыеСлова.Добавить("create");
	КлючевыеСлова.Добавить("write");
	КлючевыеСлова.Добавить("save");
	КлючевыеСлова.Добавить("post");
	КлючевыеСлова.Добавить("delete");
	КлючевыеСлова.Добавить("update");
	Для Каждого Слово Из КлючевыеСлова Цикл
		Если СтрНайти(Текст, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СоздатьReadOnlyПланЗапретаЗаписи(Цель)
	План = СоздатьПустойTypedPlan(Цель);
	План.Вставить("source", "readonly_guard");
	План.Вставить("terminal_notice", Истина);
	Шаг = Новый Структура;
	Шаг.Вставить("id", "readonly_guard");
	Шаг.Вставить("seq_no", 1);
	Шаг.Вставить("kind", "show_info");
	Шаг.Вставить("title", "Сообщить, что режим не изменяет данные");
	Шаг.Вставить("depends_on", Новый Массив);
	Шаг.Вставить("input", Новый Структура("message", "Режим Запрос1С предназначен только для чтения данных. Для создания, изменения, записи или проведения объектов переключите диалог в режим агента с разрешенными действиями записи."));
	Шаг.Вставить("status", "pending");
	Шаг.Вставить("result_summary", "");
	Шаг.Вставить("result_data", Неопределено);
	План.steps.Добавить(Шаг);
	Возврат План;
КонецФункции

Функция ЭтоОпасноеМассовоеУдалениеБезПодтверждения(ТекстЗадачи)
	Текст = НРег(Строка(ТекстЗадачи));
	ЕстьУдаление = СтрНайти(Текст, "удали") > 0
		ИЛИ СтрНайти(Текст, "удалить") > 0
		ИЛИ СтрНайти(Текст, "delete") > 0;
	ЕстьМассовость = СтрНайти(Текст, "все") > 0
		ИЛИ СтрНайти(Текст, "всё") > 0
		ИЛИ СтрНайти(Текст, "массов") > 0
		ИЛИ СтрНайти(Текст, "all") > 0;
	ЕстьЯвноеПодтверждение = СтрНайти(Текст, "подтверждаю") > 0
		ИЛИ СтрНайти(Текст, "подтверждено") > 0
		ИЛИ СтрНайти(Текст, "confirm") > 0;
	Возврат ЕстьУдаление И ЕстьМассовость И НЕ ЕстьЯвноеПодтверждение;
КонецФункции

Функция СоздатьПланЗапретаОпасногоМассовогоУдаления(Цель)
	План = СоздатьПустойTypedPlan(Цель);
	План.Вставить("source", "destructive_guard");
	План.Вставить("terminal_notice", Истина);
	Шаг = Новый Структура;
	Шаг.Вставить("id", "destructive_guard");
	Шаг.Вставить("seq_no", 1);
	Шаг.Вставить("kind", "show_info");
	Шаг.Вставить("title", "Сообщить о блокировке массового удаления");
	Шаг.Вставить("depends_on", Новый Массив);
	Шаг.Вставить("input", Новый Структура("message", "Массовое удаление объектов без явного подтверждения и точного отбора заблокировано. Уточните список объектов, критерии отбора и подтвердите действие отдельной командой."));
	Шаг.Вставить("status", "pending");
	Шаг.Вставить("result_summary", "");
