	ШагПоля = Новый Структура;
	ШагПоля.Вставить("id", "step_2");
	ШагПоля.Вставить("seq_no", 2);
	ШагПоля.Вставить("kind", "get_object_fields");
	ШагПоля.Вставить("title", "Получить поля выбранного объекта");
	ШагПоля.Вставить("depends_on", ЗависимостиПолей);
	ШагПоля.Вставить("input", Новый Структура("object_name", ЦелевойОбъектЗаписи));
	ШагПоля.Вставить("status", "pending");
	ШагПоля.Вставить("result_summary", "");
	ШагПоля.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагПоля);

	ЗависимостиСоздания = Новый Массив;
	ЗависимостиСоздания.Добавить("step_2");
	ШагСоздания = Новый Структура;
	ШагСоздания.Вставить("id", "step_3");
	ШагСоздания.Вставить("seq_no", 3);
	Если ЭтоДокумент Тогда
		ШагСоздания.Вставить("kind", "create_document");
		ШагСоздания.Вставить("title", "Создать документ по уточненным метаданным");
	Иначе
		ШагСоздания.Вставить("kind", "create_reference");
		ШагСоздания.Вставить("title", "Создать элемент справочника по уточненным метаданным");
	КонецЕсли;
	ШагСоздания.Вставить("depends_on", ЗависимостиСоздания);
	ШагСоздания.Вставить("input", Новый Структура("object_name,operation_id", ЦелевойОбъектЗаписи, "step_3_create"));
	ШагСоздания.Вставить("status", "pending");
	ШагСоздания.Вставить("result_summary", "");
	ШагСоздания.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагСоздания);

	ЗависимостиЗаписи = Новый Массив;
	ЗависимостиЗаписи.Добавить("step_3");
	ШагЗаписи = Новый Структура;
	ШагЗаписи.Вставить("id", "step_4");
	ШагЗаписи.Вставить("seq_no", 4);
	ШагЗаписи.Вставить("kind", "write_object");
	ШагЗаписи.Вставить("title", "Записать созданный объект");
	ШагЗаписи.Вставить("depends_on", ЗависимостиЗаписи);
	ШагЗаписи.Вставить("input", Новый Структура("operation_id", "step_4_write"));
	ШагЗаписи.Вставить("status", "pending");
	ШагЗаписи.Вставить("result_summary", "");
	ШагЗаписи.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагЗаписи);

	ЗависимостиПоказа = Новый Массив;
	ЗависимостиПоказа.Добавить("step_4");
	ШагПоказ = Новый Структура;
	ШагПоказ.Вставить("id", "step_5");
	ШагПоказ.Вставить("seq_no", 5);
	ШагПоказ.Вставить("kind", "show_info");
	ШагПоказ.Вставить("title", "Показать результат записи");
	ШагПоказ.Вставить("depends_on", ЗависимостиПоказа);
	ШагПоказ.Вставить("input", Новый Структура("message", "Операция записи выполнена. Проверьте созданный объект по ссылке в результате."));
	ШагПоказ.Вставить("status", "pending");
	ШагПоказ.Вставить("result_summary", "");
	ШагПоказ.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагПоказ);
	
	Возврат План;
КонецФункции

Функция ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаДляПродолжения(ТекстЗапроса)
	Текст = СтрЗаменить(Строка(ТекстЗапроса), Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	ТекстВРег = ВРег(Текст);
	ТипыОбъектов = Новый Массив;
	ТипыОбъектов.Добавить("Справочник");
	ТипыОбъектов.Добавить("Документ");
	ТипыОбъектов.Добавить("РегистрНакопления");
	ТипыОбъектов.Добавить("РегистрСведений");
	Для Каждого ТипОбъекта Из ТипыОбъектов Цикл
		Маркер = ВРег(ТипОбъекта + ".");
		Позиция = СтрНайти(ТекстВРег, Маркер);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(Текст, Позиция);
		Имя = "";
		Для Индекс = 1 По СтрДлина(Остаток) Цикл
			Символ = Сред(Остаток, Индекс, 1);
			Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_.", Символ) = 0 Тогда
				Прервать;
			КонецЕсли;
			Имя = Имя + Символ;
		КонецЦикла;
		Если НЕ ПустаяСтрока(Имя) Тогда
			Если Прав(ВРег(Имя), СтрДлина(".ОСТАТКИ")) = ".ОСТАТКИ" Тогда
				Имя = Лев(Имя, СтрДлина(Имя) - СтрДлина(".Остатки"));
			КонецЕсли;
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция СоздатьFallbackПланПродолженияЗапроса(СсылкаДиалога, ТекстЗадачи, План)
	СостояниеЗапроса = ИИА_Сервер.ПолучитьСостояниеЗапроса1С(СсылкаДиалога);
	Если СостояниеЗапроса = Неопределено Или ПустаяСтрока(Строка(СостояниеЗапроса.ТекстЗапроса)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаДляПродолжения(СостояниеЗапроса.ТекстЗапроса);
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если План = Неопределено Или ТипЗнч(План) <> Тип("Структура") Или НЕ План.Свойство("steps") Тогда
		План = СоздатьПустойTypedPlan(ТекстЗадачи);
	КонецЕсли;
	БазаНомера = План.steps.Количество();
	Зависимости = Новый Массив;
	Если БазаНомера > 0 Тогда
		ПоследнийШаг = План.steps[БазаНомера - 1];
		Если ПоследнийШаг.Свойство("id") Тогда
			Зависимости.Добавить(Строка(ПоследнийШаг.id));
		КонецЕсли;
	КонецЕсли;

	ШагПоля = Новый Структура;
	ШагПоля.Вставить("id", "step_followup_fields_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	ШагПоля.Вставить("seq_no", БазаНомера + 1);
	ШагПоля.Вставить("kind", "get_object_fields");
	ШагПоля.Вставить("title", "Уточнить поля объекта для дополнения запроса");
	ШагПоля.Вставить("depends_on", Зависимости);
	ШагПоля.Вставить("input", Новый Структура("object", ПолноеИмяОбъекта));
	ШагПоля.Вставить("status", "pending");
	ШагПоля.Вставить("result_summary", "");
	ШагПоля.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагПоля);

	ЗависимостиЗапроса = Новый Массив;
	ЗависимостиЗапроса.Добавить(ШагПоля.id);
	InputЗапроса = Новый Структура;
	InputЗапроса.Вставить("object", ПолноеИмяОбъекта);
	InputЗапроса.Вставить("object_name", ПолноеИмяОбъекта);
	InputЗапроса.Вставить("intent", ТекстЗадачи);
	InputЗапроса.Вставить("query", "");
	InputЗапроса.Вставить("all_fields", Истина);
	ШагЗапрос = Новый Структура;
	ШагЗапрос.Вставить("id", "step_followup_query_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	ШагЗапрос.Вставить("seq_no", БазаНомера + 2);
	ШагЗапрос.Вставить("kind", "run_query");
	ШагЗапрос.Вставить("title", "Выполнить обновленный запрос с добавленными полями");
	ШагЗапрос.Вставить("depends_on", ЗависимостиЗапроса);
	ШагЗапрос.Вставить("input", InputЗапроса);
	ШагЗапрос.Вставить("status", "pending");
	ШагЗапрос.Вставить("result_summary", "");
	ШагЗапрос.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагЗапрос);

	ЗависимостиПоказа = Новый Массив;
	ЗависимостиПоказа.Добавить(ШагЗапрос.id);
	ШагПоказ = Новый Структура;
	ШагПоказ.Вставить("id", "step_followup_show_" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	ШагПоказ.Вставить("seq_no", БазаНомера + 3);
	ШагПоказ.Вставить("kind", "show_info");
	ШагПоказ.Вставить("title", "Показать обновленный результат запроса");
	ШагПоказ.Вставить("depends_on", ЗависимостиПоказа);
	ШагПоказ.Вставить("input", Новый Структура("source", ШагЗапрос.id));
	ШагПоказ.Вставить("status", "pending");
	ШагПоказ.Вставить("result_summary", "");
	ШагПоказ.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагПоказ);

	План.last_user_text = ТекстЗадачи;
	Возврат План;
КонецФункции

Функция НормализоватьTypedPlan(СырыеДанныеПлана, Цель = "") Экспорт
	План = СоздатьПустойTypedPlan(Цель);
	Если СырыеДанныеПлана = Неопределено Тогда
		Возврат План;
	КонецЕсли;
	Если ЭтоJSONArray(СырыеДанныеПлана) Тогда
		Для ИндексСтарогоПлана = 0 По СырыеДанныеПлана.Количество() - 1 Цикл
			ЭлементПлана = СырыеДанныеПлана[ИндексСтарогоПлана];
			Если ЭтоJSONОбъект(ЭлементПлана) Тогда
				План.steps.Добавить(НормализоватьШагTypedPlan(ЭлементПлана, ИндексСтарогоПлана, План.goal));
			Иначе
				Шаг = Новый Структура;
				Шаг.Вставить("id", "legacy_new_step_" + Строка(ИндексСтарогоПлана + 1));
				Шаг.Вставить("kind", "show_info");
				Шаг.Вставить("title", Строка(ЭлементПлана));
				Шаг.Вставить("depends_on", Новый Массив);
				Шаг.Вставить("input", Новый Структура("message", Строка(ЭлементПлана)));
				План.steps.Добавить(НормализоватьШагTypedPlan(Шаг, ИндексСтарогоПлана, План.goal));
			КонецЕсли;
		КонецЦикла;
		ПометитьМягкиеLookupДляWriteFlow(План);
		ДобавитьShowInfoПослеRunQueryЕслиНужно(План);
		Возврат План;
	КонецЕсли;
	Если НЕ ЭтоJSONОбъект(СырыеДанныеПлана) Тогда
		Возврат План;
	КонецЕсли;
	План.plan_version = ПолучитьСвойствоJSONОбъекта(СырыеДанныеПлана, "plan_version", 1);
	План.last_user_text = Строка(ПолучитьСвойствоJSONОбъекта(СырыеДанныеПлана, "last_user_text", План.goal));
	ЦельПлана = Строка(ПолучитьСвойствоJSONОбъекта(СырыеДанныеПлана, "goal", ""));
	Если НЕ ПустаяСтрока(ЦельПлана) Тогда
		План.goal = ЦельПлана;
	КонецЕсли;
	ВставитьПолеЕслиЕсть(План, СырыеДанныеПлана, "source");
	ВставитьПолеЕслиЕсть(План, СырыеДанныеПлана, "terminal_notice");
	ВставитьПолеЕслиЕсть(План, СырыеДанныеПлана, "skill_name");
	ВставитьПолеЕслиЕсть(План, СырыеДанныеПлана, "target_object_name");
	Если ПустаяСтрока(План.last_user_text) Тогда
		План.last_user_text = План.goal;
	КонецЕсли;
	ШагиСырые = ПолучитьСвойствоJSONОбъекта(СырыеДанныеПлана, "steps", Неопределено);
	Если НЕ ЭтоJSONArray(ШагиСырые) Тогда
		Возврат План;
	КонецЕсли;
	Для Индекс = 0 По ШагиСырые.Количество() - 1 Цикл
		Шаг = ШагиСырые[Индекс];
		Если ЭтоJSONОбъект(Шаг) Тогда
			План.steps.Добавить(НормализоватьШагTypedPlan(Шаг, Индекс, План.goal));
		КонецЕсли;
	КонецЦикла;
	ПометитьМягкиеLookupДляWriteFlow(План);
	ДобавитьShowInfoПослеRunQueryЕслиНужно(План);
	Возврат План;
КонецФункции

Процедура СинхронизироватьТабличнуюЧастьПлана(СсылкаДиалога, План)
	Диалог = СсылкаДиалога.ПолучитьОбъект();
	Диалог.План.Очистить();
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") ИЛИ НЕ План.Свойство("steps") Тогда
		Диалог.Записать();
		Возврат;
	КонецЕсли;
	Для Каждого ШагПлана Из План.steps Цикл
		НоваяСтрока = Диалог.План.Добавить();
		НоваяСтрока.Задача = ?(ШагПлана.Свойство("title"), Строка(ШагПлана.title), "");
		НоваяСтрока.Выполнена = СтатусШагаЗавершен(ШагПлана);
		НоваяСтрока.Результат = ?(ШагПлана.Свойство("result_summary"), Строка(ШагПлана.result_summary), "");
	КонецЦикла;
	Диалог.Записать();
КонецПроцедуры

Процедура СохранитьTypedPlan(СсылкаДиалога, План) Экспорт
	СтруктураДанных = ИИА_DialogStorage.ПолучитьДанныеДиалогаИзРегистра(СсылкаДиалога);
	Если СтруктураДанных = Неопределено ИЛИ ТипЗнч(СтруктураДанных) <> Тип("Структура") Тогда
		СтруктураДанных = Новый Структура;
	КонецЕсли;
	СтруктураДанных.Вставить("Planner_TypedPlan", План);
	ИИА_DialogStorage.ЗаписатьДанныеДиалогаВРегистр(СсылкаДиалога, СтруктураДанных);
	СинхронизироватьТабличнуюЧастьПлана(СсылкаДиалога, План);
	
	ДеталиЧекпоинта = Новый Структура;
	ДеталиЧекпоинта.Вставить("steps_total", План.steps.Количество());
	ДеталиЧекпоинта.Вставить("completed_steps", 0);
	ДеталиЧекпоинта.Вставить("pending_steps", 0);
	Для Каждого ШагПлана Из План.steps Цикл
		Если СтатусШагаЗавершен(ШагПлана) Тогда
			ДеталиЧекпоинта.completed_steps = ДеталиЧекпоинта.completed_steps + 1;
		Иначе
			ДеталиЧекпоинта.pending_steps = ДеталиЧекпоинта.pending_steps + 1;
		КонецЕсли;
	КонецЦикла;
	ИИА_Сервер.СохранитьЧекпоинтОркестратора(СсылкаДиалога, "typed_plan_saved", "Plan", ДеталиЧекпоинта);
КонецПроцедуры

Функция ПолучитьTypedPlan(СсылкаДиалога) Экспорт
	СтруктураДанных = ИИА_DialogStorage.ПолучитьДанныеДиалогаИзРегистра(СсылкаДиалога);
	Если СтруктураДанных <> Неопределено И ТипЗнч(СтруктураДанных) = Тип("Структура") И СтруктураДанных.Свойство("Planner_TypedPlan") Тогда
		Возврат НормализоватьTypedPlan(СтруктураДанных.Planner_TypedPlan);
	КонецЕсли;
	Попытка
		Диалог = СсылкаДиалога.ПолучитьОбъект();
		Если Диалог.План.Количество() > 0 Тогда
			План = СоздатьПустойTypedPlan();
			Индекс = 0;
			Для Каждого СтрокаПлана Из Диалог.План Цикл
				Шаг = Новый Структура;
				Шаг.Вставить("id", "legacy_step_" + Строка(Индекс + 1));
				Шаг.Вставить("seq_no", Индекс + 1);
				Шаг.Вставить("kind", "show_info");
				Шаг.Вставить("title", Строка(СтрокаПлана.Задача));
				Шаг.Вставить("depends_on", Новый Массив);
				Шаг.Вставить("input", Новый Структура("message", Строка(СтрокаПлана.Результат)));
				Шаг.Вставить("status", ?(СтрокаПлана.Выполнена, "done", "pending"));
				Шаг.Вставить("result_summary", Строка(СтрокаПлана.Результат));
				Шаг.Вставить("result_data", Неопределено);
				План.steps.Добавить(Шаг);
				Индекс = Индекс + 1;
			КонецЦикла;
			Возврат План;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат СоздатьПустойTypedPlan();
КонецФункции

Функция ВсеЗависимостиШагаВыполнены(ШагПлана, План)
	Если ШагПлана = Неопределено ИЛИ ТипЗнч(ШагПлана) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ШагПлана.Свойство("depends_on") ИЛИ ТипЗнч(ШагПлана.depends_on) <> Тип("Массив") ИЛИ ШагПлана.depends_on.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого ИдШага Из ШагПлана.depends_on Цикл
		Найден = Ложь;
		Для Каждого Кандидат Из План.steps Цикл
			Если Кандидат.Свойство("id") И Строка(Кандидат.id) = Строка(ИдШага) Тогда
				Найден = Истина;
				Если НЕ СтатусШагаЗавершен(Кандидат) Тогда
					Возврат Ложь;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найден Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция КлассифицироватьУсловиеВеткиПлана(ТекстУсловия)
	УсловиеВРег = ВРег(СокрЛП(Строка(ТекстУсловия)));
	Если ПустаяСтрока(УсловиеВРег) Тогда
		Возврат "";
	КонецЕсли;
	Если УсловиеВРег = "NOT_FOUND"
		ИЛИ УсловиеВРег = "EMPTY"
		ИЛИ СтрНайти(УсловиеВРег, "НЕ НАЙДЕН") > 0
		ИЛИ СтрНайти(УсловиеВРег, "НЕ НАЙДЕНО") > 0
		ИЛИ СтрНайти(УсловиеВРег, "НЕ СУЩЕСТВУЕТ") > 0 Тогда
		Возврат "empty";
	КонецЕсли;
	Если УсловиеВРег = "FOUND"
		ИЛИ УсловиеВРег = "NOT_EMPTY"
		ИЛИ СтрНайти(УсловиеВРег, "НАЙДЕН") > 0
		ИЛИ СтрНайти(УсловиеВРег, "НАЙДЕНО") > 0
		ИЛИ СтрНайти(УсловиеВРег, "УЖЕ СУЩЕСТВУЕТ") > 0
		ИЛИ СтрНайти(УсловиеВРег, "СУЩЕСТВУЕТ") > 0 Тогда
		Возврат "not_empty";
	КонецЕсли;
	Если СтрНайти(УсловиеВРег, "НЕ ПУСТ") > 0 ИЛИ СтрНайти(УсловиеВРег, "НЕПУСТ") > 0 Тогда
		Возврат "not_empty";
	КонецЕсли;
	Если СтрНайти(УсловиеВРег, "ПУСТ") > 0 Тогда
		Возврат "empty";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ШагПланаЗависитОтЛюбогоИдентификатора(ШагПлана, Идентификаторы)
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Идентификаторы = Неопределено ИЛИ ТипЗнч(Идентификаторы) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Зависимости = ПолучитьСвойствоJSONОбъекта(ШагПлана, "depends_on", Неопределено);
	Если НЕ ЭтоJSONArray(Зависимости) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ИдШага Из Зависимости Цикл
		Если Идентификаторы.Получить(Строка(ИдШага)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция РезультатШагаСодержитНепустойRunQuery(ШагПлана)
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	РезультатШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "result_data", Неопределено);
	Если НЕ ЭтоJSONОбъект(РезультатШага) Тогда
		Возврат Ложь;
	КонецЕсли;
	МассивРезультатов = ПолучитьСвойствоJSONОбъекта(РезультатШага, "Результаты", Неопределено);
	Если НЕ ЭтоJSONArray(МассивРезультатов) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ЭлементРезультата Из МассивРезультатов Цикл
		Если НЕ ЭтоJSONОбъект(ЭлементРезультата) Тогда
			Продолжить;
		КонецЕсли;
		ТипДействия = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ЭлементРезультата, "ТипДействия", "")));
		Если ТипДействия <> "RUNQUERY" Тогда
			Продолжить;
		КонецЕсли;
		Если ПолучитьСвойствоJSONОбъекта(ЭлементРезультата, "ЕстьРезультатЗапроса", Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		Если Число(ПолучитьСвойствоJSONОбъекта(ЭлементРезультата, "КоличествоСтрок", 0)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоЯвныйЗапрос1С(ТекстЗапроса)
	Текст = ВРег(СокрЛП(Строка(ТекстЗапроса)));
	Возврат НЕ ПустаяСтрока(Текст) И Лев(Текст, 7) = "ВЫБРАТЬ";
КонецФункции

Функция InputСодержитПараметрыЗапроса(Знач InputШага)
	Параметры = ПолучитьСвойствоJSONОбъекта(InputШага, "parameters", Неопределено);
	Если Параметры = Неопределено Тогда
		Параметры = ПолучитьСвойствоJSONОбъекта(InputШага, "params", Неопределено);
	КонецЕсли;
	Если Параметры = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Параметры) = Тип("Структура") ИЛИ ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Возврат Параметры.Количество() > 0;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ЯвныйЗапросТребуетПараметры(ТекстЗапроса)
	Текст = Строка(ТекстЗапроса);
	Возврат СтрНайти(Текст, "&") > 0;
КонецФункции

Функция ЯвныйЗапросСодержитЗапрещенныеКонструкции(ТекстЗапроса)
	Текст = ВРег(Строка(ТекстЗапроса));
	Возврат СтрНайти(Текст, "ТЕКУЩАЯДАТА(") > 0
		ИЛИ СтрНайти(Текст, "НАЧАЛОПЕРИОДА(") > 0
		ИЛИ СтрНайти(Текст, "КОНЕЦПЕРИОДА(") > 0
		ИЛИ СтрНайти(Текст, "CURRENT_DATE") > 0
		ИЛИ СтрНайти(Текст, "NOW()") > 0;
КонецФункции

Функция СанитизироватьInputRunQuery(ШагПлана)
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) <> "RUN_QUERY" Тогда
		Возврат Ложь;
	КонецЕсли;
	InputШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
	Если НЕ ЭтоJSONОбъект(InputШага) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстЗапроса = СокрЛП(Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "query", "")));
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;
	НужноОчиститьЗапрос = НЕ ЭтоЯвныйЗапрос1С(ТекстЗапроса);
	Если НЕ НужноОчиститьЗапрос И ЯвныйЗапросТребуетПараметры(ТекстЗапроса) И НЕ InputСодержитПараметрыЗапроса(InputШага) Тогда
		НужноОчиститьЗапрос = Истина;
	КонецЕсли;
	Если НЕ НужноОчиститьЗапрос И ЯвныйЗапросСодержитЗапрещенныеКонструкции(ТекстЗапроса) Тогда
		НужноОчиститьЗапрос = Истина;
	КонецЕсли;
	Если НЕ НужноОчиститьЗапрос Тогда
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
	КонецЕсли;
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		ПолноеИмяОбъекта = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаЛокально(ТекстЗапроса);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		InputШага.Вставить("object", ПолноеИмяОбъекта);
		InputШага.Вставить("object_name", ПолноеИмяОбъекта);
	КонецЕсли;
	InputШага.Вставить("query_intent", ТекстЗапроса);
	InputШага.Вставить("query", "");
	ШагПлана.input = InputШага;
	Возврат Истина;
КонецФункции

Функция ШагЯвляетсяМягкимLookupДляЗапроса(ШагПлана, План)
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) <> "FIND_REFERENCE_BY_NAME" Тогда
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторШага = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "id", ""));
	Если ПустаяСтрока(ИдентификаторШага) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Кандидат Из План.steps Цикл
		Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(Кандидат, "kind", ""))) <> "RUN_QUERY" Тогда
			Продолжить;
		КонецЕсли;
		Зависимости = ПолучитьСвойствоJSONОбъекта(Кандидат, "depends_on", Неопределено);
		Если НЕ ЭтоJSONArray(Зависимости) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИдЗависимости Из Зависимости Цикл
			Если Строка(ИдЗависимости) = ИдентификаторШага Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция РезультатШагаСодержитНайденныйОбъектИлиНепустойПоиск(ШагПлана)
	Если РезультатШагаСодержитНепустойRunQuery(ШагПлана) Тогда
		Возврат Истина;
	КонецЕсли;
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстРезультата = ВРег(ИзвлечьТекстИзРезультатаШагаПлана(ШагПлана));
	Если РезультатLookupЯвноНеНайден(ТекстРезультата) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) = "FIND_REFERENCE_BY_NAME"
		И СтатусШагаЗавершен(ШагПлана) Тогда
		Возврат СтрНайти(ТекстРезультата, "НАЙДЕН") > 0
			ИЛИ СтрНайти(ТекстРезультата, "УЖЕ СУЩЕСТВУЕТ") > 0
			ИЛИ СтрНайти(ТекстРезультата, "ССЫЛКА") > 0;
	КонецЕсли;
	Возврат СтрНайти(ТекстРезультата, "НАЙДЕН") > 0
		ИЛИ СтрНайти(ТекстРезультата, "УЖЕ СУЩЕСТВУЕТ") > 0;
КонецФункции

Функция РезультатLookupЯвноНеНайден(ТекстРезультата)
	Если ПустаяСтрока(ТекстРезультата) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстРезультата, " НЕ НАЙДЕН") > 0
		ИЛИ СтрНайти(ТекстРезультата, "НЕ НАЙДЕНО") > 0
		ИЛИ СтрНайти(ТекстРезультата, "НЕ ОБНАРУЖЕН") > 0
		ИЛИ СтрНайти(ТекстРезультата, "НЕ СУЩЕСТВУЕТ") > 0;
КонецФункции

Функция НужноПропуститьСозданиеПослеНайденногоОбъекта(ШагПлана, План)
	Kind = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", "")));
	Если Kind <> "CREATE_REFERENCE" И Kind <> "SET_FIELD" И Kind <> "WRITE_OBJECT" И Kind <> "SHOW_INFO" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Kind = "SHOW_INFO" Тогда
		InputШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
		Если ЭтоJSONОбъект(InputШага) Тогда
			ЗначениеУсловияShowInfo = ПолучитьСвойствоJSONОбъекта(InputШага, "condition", "");
			УсловиеShowInfo = ВРег(Строка(ЗначениеУсловияShowInfo));
			Если СтрНайти(УсловиеShowInfo, "FOUND_OR_NOT_FOUND") > 0
				ИЛИ ПолучитьСвойствоJSONОбъекта(InputШага, "message_found", Неопределено) <> Неопределено
				ИЛИ ПолучитьСвойствоJSONОбъекта(InputШага, "message_not_found", Неопределено) <> Неопределено
				ИЛИ ПолучитьСвойствоJSONОбъекта(InputШага, "message_on_found", Неопределено) <> Неопределено
				ИЛИ ПолучитьСвойствоJSONОбъекта(InputШага, "message_on_not_found", Неопределено) <> Неопределено
				ИЛИ ПолучитьСвойствоJSONОбъекта(InputШага, "conditions", Неопределено) <> Неопределено
				ИЛИ (ЭтоJSONОбъект(ЗначениеУсловияShowInfo)
					И (ПолучитьСвойствоJSONОбъекта(ЗначениеУсловияShowInfo, "found", Неопределено) <> Неопределено
						ИЛИ ПолучитьСвойствоJSONОбъекта(ЗначениеУсловияShowInfo, "not_found", Неопределено) <> Неопределено)) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Зависимости = ПолучитьСвойствоJSONОбъекта(ШагПлана, "depends_on", Неопределено);
	Если НЕ ЭтоJSONArray(Зависимости) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ИдЗависимости Из Зависимости Цикл
		ШагЗависимости = НайтиШагВПланеПоИдентификатору(План, Строка(ИдЗависимости));
		Если ШагЗависимости <> Неопределено
			И ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагЗависимости, "status", ""))) = "SKIPPED" Тогда
			Возврат Истина;
		КонецЕсли;
		Если Kind = "SHOW_INFO" Тогда
			InputШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
			КлассУсловия = "";
			Если ЭтоJSONОбъект(InputШага) Тогда
				КлассУсловия = КлассифицироватьУсловиеВеткиПлана(ПолучитьСвойствоJSONОбъекта(InputШага, "condition", ""));
			КонецЕсли;
			Если КлассУсловия = "empty" И РезультатШагаСодержитНайденныйОбъектИлиНепустойПоиск(ШагЗависимости) Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли РезультатШагаСодержитНайденныйОбъектИлиНепустойПоиск(ШагЗависимости) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция НайтиШагВПланеПоИдентификатору(План, StepId)
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ШагПлана Из План.steps Цикл
		Если ШагПлана.Свойство("id") И Строка(ШагПлана.id) = Строка(StepId) Тогда
			Возврат ШагПлана;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ИзвлечьТекстИзРезультатаШагаПлана(ШагПлана)
	Текст = ?(ШагПлана.Свойство("result_summary"), Строка(ШагПлана.result_summary), "");
	РезультатШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "result_data", Неопределено);
	Если ЭтоJSONОбъект(РезультатШага) Тогда
		Сообщение = Строка(ПолучитьСвойствоJSONОбъекта(РезультатШага, "Сообщение", ""));
		Если НЕ ПустаяСтрока(Сообщение) Тогда
			Текст = Текст + Символы.ПС + Сообщение;
		КонецЕсли;
		МассивРезультатов = ПолучитьСвойствоJSONОбъекта(РезультатШага, "Результаты", Неопределено);
		Если ЭтоJSONArray(МассивРезультатов) Тогда
			Для Каждого ЭлементРезультата Из МассивРезультатов Цикл
				Если ЭтоJSONОбъект(ЭлементРезультата) Тогда
					СообщениеЭлемента = Строка(ПолучитьСвойствоJSONОбъекта(ЭлементРезультата, "Сообщение", ""));
					Если НЕ ПустаяСтрока(СообщениеЭлемента) Тогда
						Текст = Текст + Символы.ПС + СообщениеЭлемента;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ЭтоСимволЛатиницыИлиКириллицыИлиЦифра(Символ)
	Если ПустаяСтрока(Символ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ);
	Возврат (Код >= 48 И Код <= 57)
		ИЛИ (Код >= 65 И Код <= 90)
		ИЛИ (Код >= 97 И Код <= 122)
		ИЛИ (Код >= 1040 И Код <= 1103)
		ИЛИ Код = 1025
		ИЛИ Код = 1105;
КонецФункции

Функция ИзвлечьПолныеИменаОбъектовИзТекстаМетаданных(Текст)
	Результат = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Префиксы = Новый Массив;
	Префиксы.Добавить("Документ.");
	Префиксы.Добавить("Справочник.");
	Префиксы.Добавить("РегистрНакопления.");
	Префиксы.Добавить("РегистрСведений.");
	Префиксы.Добавить("ПланВидовХарактеристик.");
	Префиксы.Добавить("ПланСчетов.");
	Для Каждого Префикс Из Префиксы Цикл
		ПозицияПоиска = 1;
		ПрефиксВРег = ВРег(Префикс);
		Пока Истина Цикл
			ПозицияЛок = СтрНайти(Сред(ВРег(Текст), ПозицияПоиска), ПрефиксВРег);
			Если ПозицияЛок = 0 Тогда
				Прервать;
			КонецЕсли;
			Позиция = ПозицияПоиска + ПозицияЛок - 1;
			Кандидат = "";
			Индекс = Позиция;
			Пока Индекс <= СтрДлина(Текст) Цикл
				Символ = Сред(Текст, Индекс, 1);
				Если НЕ ЭтоСимволЛатиницыИлиКириллицыИлиЦифра(Символ) И Символ <> "." И Символ <> "_" Тогда
					Прервать;
				КонецЕсли;
				Кандидат = Кандидат + Символ;
				Индекс = Индекс + 1;
			КонецЦикла;
			Если НЕ ПустаяСтрока(Кандидат) И Результат.Найти(Кандидат) = Неопределено Тогда
				Результат.Добавить(Кандидат);
			КонецЕсли;
			ПозицияПоиска = Позиция + СтрДлина(Префикс);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаЛокально(ТекстЗапроса)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозицияИЗ = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозицияИЗ = 0 Тогда
		ПозицияИЗ = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозицияИЗ > 0 Тогда
		ХвостЗапроса = СокрЛП(Сред(Текст, ПозицияИЗ + 3));
		КандидатыИсточника = ИзвлечьПолныеИменаОбъектовИзТекстаМетаданных(ХвостЗапроса);
		Если КандидатыИсточника.Количество() > 0 Тогда
			Возврат Строка(КандидатыИсточника[0]);
		КонецЕсли;
	КонецЕсли;
	Кандидаты = ИзвлечьПолныеИменаОбъектовИзТекстаМетаданных(Текст);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Кандидаты[0]);
КонецФункции

Функция НормализоватьИмяОбъектаДляGetObjectFields(ПолноеИмяОбъекта)
	Имя = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	ИмяВРег = ВРег(Имя);
	СуффиксыВиртуальныхТаблиц = Новый Массив;
	СуффиксыВиртуальныхТаблиц.Добавить("ОСТАТКИ");
	СуффиксыВиртуальныхТаблиц.Добавить("ОБОРОТЫ");
	СуффиксыВиртуальныхТаблиц.Добавить("ОСТАТКИИОБОРОТЫ");
	Для Каждого Суффикс Из СуффиксыВиртуальныхТаблиц Цикл
		Маркер = "." + Суффикс;
		Поз = СтрНайти(ИмяВРег, Маркер);
		Если Поз > 0 Тогда
			Возврат Лев(Имя, Поз - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;
КонецФункции

Функция РазбитьCamelCaseНаТокены(Имя)
	Токены = Новый Массив;
	Если ПустаяСтрока(Имя) Тогда
		Возврат Токены;
	КонецЕсли;
	ТекущееСлово = "";
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		ЭтоВерхний = Символ = ВРег(Символ) И Символ <> НРег(Символ);
		Если ЭтоВерхний И НЕ ПустаяСтрока(ТекущееСлово) Тогда
			Токены.Добавить(ТекущееСлово);
			ТекущееСлово = Символ;
		Иначе
			ТекущееСлово = ТекущееСлово + Символ;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ПустаяСтрока(ТекущееСлово) Тогда
		Токены.Добавить(ТекущееСлово);
	КонецЕсли;
	Возврат Токены;
КонецФункции

Функция СовпадаютТокеныCamelCase(ЛевоеИмя, ПравоеИмя)
	ЛевыеТокены = РазбитьCamelCaseНаТокены(СокрЛП(Строка(ЛевоеИмя)));
	ПравыеТокены = РазбитьCamelCaseНаТокены(СокрЛП(Строка(ПравоеИмя)));
	Если ЛевыеТокены.Количество() < 2 Или ЛевыеТокены.Количество() <> ПравыеТокены.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Токен Из ЛевыеТокены Цикл
		Если ПравыеТокены.Найти(Токен) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОценитьПохожестьИмениОбъекта(ИсходноеИмя, Кандидат)
	ИсходноеПростое = ИсходноеИмя;
	ПозТочки = СтрНайти(ИсходноеПростое, ".");
	Если ПозТочки > 0 Тогда
		ИсходноеПростое = Сред(ИсходноеПростое, ПозТочки + 1);
	КонецЕсли;
	КандидатПростой = Кандидат;
	ПозТочки = СтрНайти(КандидатПростой, ".");
	Если ПозТочки > 0 Тогда
		КандидатПростой = Сред(КандидатПростой, ПозТочки + 1);
	КонецЕсли;
	ИсходноеВРег = ВРег(ИсходноеПростое);
	КандидатВРег = ВРег(КандидатПростой);
	Если СовпадаютТокеныCamelCase(ИсходноеПростое, КандидатПростой) Тогда
		Возврат 100;
	КонецЕсли;
	Оценка = 0;
	Для Индекс = 1 По Мин(СтрДлина(ИсходноеВРег), СтрДлина(КандидатВРег)) Цикл
		Если Сред(ИсходноеВРег, Индекс, 1) <> Сред(КандидатВРег, Индекс, 1) Тогда
			Прервать;
		КонецЕсли;
		Оценка = Оценка + 1;
	КонецЦикла;
	Токены = РазбитьCamelCaseНаТокены(ИсходноеПростое);
	Для Каждого Токен Из Токены Цикл
		Если СтрДлина(Токен) < 4 Тогда
			Продолжить;
		КонецЕсли;
		Сигнатура = ВРег(Лев(Токен, Мин(5, СтрДлина(Токен))));
		Если СтрНайти(КандидатВРег, Сигнатура) > 0 Тогда
			Оценка = Оценка + 10;
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(КандидатВРег, ИсходноеВРег) > 0 Тогда
		Оценка = Оценка + 30;
	КонецЕсли;
	Если СтрНайти(ИсходноеВРег, "СУММ") > 0
		ИЛИ СтрНайти(ИсходноеВРег, "ПРОДАЖ") > 0
		ИЛИ СтрНайти(ИсходноеВРег, "ЗАКАЗ") > 0
		ИЛИ СтрНайти(ИсходноеВРег, "РЕАЛИЗАЦ") > 0 Тогда
		Если СтрНайти(ИсходноеВРег, "ЗАКАЗ") > 0 И СтрНайти(КандидатВРег, "ЗАКАЗ") > 0 Тогда
			Оценка = Оценка + 80;
		КонецЕсли;
		Если СтрНайти(КандидатВРег, "РЕАЛИЗАЦ") > 0 Тогда
			Оценка = Оценка + 60;
		КонецЕсли;
		Если СтрНайти(КандидатВРег, "РЕАЛИЗАЦИЯТОВАРОВУСЛУГ") > 0 Тогда
			Оценка = Оценка + 40;
		КонецЕсли;
		Если СтрНайти(КандидатВРег, "ПРОДАЖ") > 0 Тогда
			Оценка = Оценка + 45;
		КонецЕсли;
		Если СтрНайти(КандидатВРег, "ОТГРУЖ") > 0 Тогда
			Оценка = Оценка + 15;
		КонецЕсли;
		Если СтрНайти(КандидатВРег, "ВВОДНАЧАЛЬНЫХОСТАТКОВ") > 0
			ИЛИ СтрНайти(КандидатВРег, "ФОРМИРОВАНИЕЗАПИСЕЙ") > 0
			ИЛИ СтрНайти(КандидатВРег, "ТРЕБОВАНИЕНАКЛАДНАЯ") > 0
			ИЛИ СтрНайти(КандидатВРег, "КОРРЕКТИРОВКА") > 0 Тогда
			Оценка = Оценка - 70;
		КонецЕсли;
	КонецЕсли;
	Если (СтрНайти(ИсходноеВРег, "КЛИЕНТ") > 0
		ИЛИ СтрНайти(ИсходноеВРег, "КОНТРАГЕНТ") > 0
		ИЛИ СтрНайти(ИсходноеВРег, "ПОКУПАТЕЛ") > 0)
		И (СтрНайти(КандидатВРег, "РЕАЛИЗАЦ") > 0
			ИЛИ СтрНайти(КандидатВРег, "ЗАКАЗПОКУПАТ") > 0
			ИЛИ СтрНайти(КандидатВРег, "СЧЕТНАОПЛАТУПОКУПАТ") > 0) Тогда
		Оценка = Оценка + 25;
	КонецЕсли;
	Возврат Оценка;
КонецФункции

Функция ВыбратьЛучшийКандидатОбъекта(ИсходноеИмя, Кандидаты)
	ЛучшийКандидат = "";
	ЛучшаяОценка = -1;
	Для Каждого Кандидат Из Кандидаты Цикл
		Оценка = ОценитьПохожестьИмениОбъекта(ИсходноеИмя, Кандидат);
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшийКандидат = Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат ЛучшийКандидат;
КонецФункции

Процедура ПрименитьЭффектGetMetadataШагаПлана(План, ЗавершенныйШаг)
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ЗавершенныйШаг = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ЗавершенныйШаг) Тогда
		Возврат;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "kind", ""))) <> "GET_METADATA" Тогда
		Возврат;
	КонецЕсли;
	ТекстМетаданных = ИзвлечьТекстИзРезультатаШагаПлана(ЗавершенныйШаг);
	Кандидаты = ИзвлечьПолныеИменаОбъектовИзТекстаМетаданных(ТекстМетаданных);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИзмененияЕсть = Ложь;
	Для Индекс = 0 По План.steps.Количество() - 1 Цикл
		ШагКандидат = План.steps[Индекс];
		Если СтатусШагаЗавершен(ШагКандидат) Тогда
			Продолжить;
		КонецЕсли;
		KindШага = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагКандидат, "kind", "")));
		Если KindШага <> "RUN_QUERY" И KindШага <> "GET_OBJECT_FIELDS" И KindШага <> "CHECK_OBJECT_EXISTS"
			И KindШага <> "CREATE_DOCUMENT" И KindШага <> "CREATE_REFERENCE" Тогда
			Продолжить;
		КонецЕсли;
		InputШага = ПолучитьСвойствоJSONОбъекта(ШагКандидат, "input", Неопределено);
		Если НЕ ЭтоJSONОбъект(InputШага) Тогда
			Продолжить;
		КонецЕсли;
		ИсходноеИмя = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
		Если ПустаяСтрока(ИсходноеИмя) Тогда
			ИсходноеИмя = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
		КонецЕсли;
		ТекстЗапроса = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "query", ""));
		Если ПустаяСтрока(ИсходноеИмя) И НЕ ПустаяСтрока(ТекстЗапроса) Тогда
			ИсходноеИмя = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаЛокально(ТекстЗапроса);
		КонецЕсли;
		Если ПустаяСтрока(ИсходноеИмя) Тогда
			ИсходноеИмя = Строка(ПолучитьСвойствоJSONОбъекта(ШагКандидат, "title", ""));
			Если План.Свойство("goal") Тогда
				ИсходноеИмя = СокрЛП(Строка(План.goal) + " " + ИсходноеИмя);
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(ИсходноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если KindШага = "RUN_QUERY" И НЕ ПустаяСтрока(ТекстЗапроса) И ЭтоСуществующееПолноеИмяОбъектаЛокально(ИсходноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		ЛучшийКандидат = ВыбратьЛучшийКандидатОбъекта(ИсходноеИмя, Кандидаты);
		Если ПустаяСтрока(ЛучшийКандидат) Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(ЛучшийКандидат) = ВРег(ИсходноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		ИмяДляШага = ЛучшийКандидат;
		Если (KindШага = "CREATE_DOCUMENT" И ВРег(Лев(ИмяДляШага, СтрДлина("Документ."))) = "ДОКУМЕНТ.")
			ИЛИ (KindШага = "CREATE_REFERENCE" И ВРег(Лев(ИмяДляШага, СтрДлина("Справочник."))) = "СПРАВОЧНИК.") Тогда
			ИмяДляШага = Сред(ИмяДляШага, СтрНайти(ИмяДляШага, ".") + 1);
		КонецЕсли;
		Если KindШага <> "CREATE_DOCUMENT" И KindШага <> "CREATE_REFERENCE" Тогда
			InputШага.Вставить("object", ЛучшийКандидат);
		КонецЕсли;
		InputШага.Вставить("object_name", ИмяДляШага);
		Если НЕ ПустаяСтрока(ТекстЗапроса) Тогда
			InputШага.Вставить("query", СтрЗаменить(ТекстЗапроса, ИсходноеИмя, ЛучшийКандидат));
		Иначе
			InputШага.Вставить("query", "");
		КонецЕсли;
		ШагКандидат.input = InputШага;
		ШагКандидат.title = СтрЗаменить(Строка(ПолучитьСвойствоJSONОбъекта(ШагКандидат, "title", "")), ИсходноеИмя, ЛучшийКандидат);
		План.steps[Индекс] = ШагКандидат;
		ИзмененияЕсть = Истина;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоСуществующееПолноеИмяОбъектаЛокально(ПолноеИмяОбъекта)
	Имя = СокрЛП(Строка(ПолноеИмяОбъекта));
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	ПозТочки = СтрНайти(Имя, ".");
	Если ПозТочки = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипОбъекта = Лев(Имя, ПозТочки - 1);
	ИмяОбъекта = Сред(Имя, ПозТочки + 1);
	Если ТипОбъекта = "Справочник" Тогда
		Возврат Метаданные.Справочники.Найти(ИмяОбъекта) <> Неопределено;
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		Возврат Метаданные.Документы.Найти(ИмяОбъекта) <> Неопределено;
	ИначеЕсли ТипОбъекта = "РегистрНакопления" Тогда
		Возврат Метаданные.РегистрыНакопления.Найти(ИмяОбъекта) <> Неопределено;
	ИначеЕсли ТипОбъекта = "РегистрСведений" Тогда
		Возврат Метаданные.РегистрыСведений.Найти(ИмяОбъекта) <> Неопределено;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьWhitelistПолейИзРезультатаШага(ЗавершенныйШаг)
	Whitelist = Новый Массив;
	Если ЗавершенныйШаг = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ЗавершенныйШаг) Тогда
		Возврат Whitelist;
	КонецЕсли;
	РезультатШага = ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "result_data", Неопределено);
	Если НЕ ЭтоJSONОбъект(РезультатШага) Тогда
		Возврат Whitelist;
	КонецЕсли;
	ИсходныйWhitelist = ПолучитьСвойствоJSONОбъекта(РезультатШага, "whitelist_fields", Неопределено);
	Если НЕ ЭтоJSONArray(ИсходныйWhitelist) Тогда
		Возврат Whitelist;
	КонецЕсли;
	Для Каждого Поле Из ИсходныйWhitelist Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		Если НЕ ПустаяСтрока(ИмяПоля) И Whitelist.Найти(ИмяПоля) = Неопределено Тогда
			Whitelist.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Whitelist;
КонецФункции

Функция ПолучитьWhitelistПутейИзРезультатаШага(ЗавершенныйШаг)
	WhitelistПути = Новый Массив;
	Если ЗавершенныйШаг = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ЗавершенныйШаг) Тогда
		Возврат WhitelistПути;
	КонецЕсли;
	РезультатШага = ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "result_data", Неопределено);
	Если НЕ ЭтоJSONОбъект(РезультатШага) Тогда
		Возврат WhitelistПути;
	КонецЕсли;
	ИсходныеПути = ПолучитьСвойствоJSONОбъекта(РезультатШага, "whitelist_paths", Неопределено);
	Если НЕ ЭтоJSONArray(ИсходныеПути) Тогда
		Возврат WhitelistПути;
	КонецЕсли;
	Для Каждого Путь Из ИсходныеПути Цикл
		ИмяПути = СокрЛП(Строка(Путь));
		Если НЕ ПустаяСтрока(ИмяПути) И WhitelistПути.Найти(ИмяПути) = Неопределено Тогда
			WhitelistПути.Добавить(ИмяПути);
		КонецЕсли;
	КонецЦикла;
	Возврат WhitelistПути;
КонецФункции

Функция ПолеЕстьВWhitelist(Whitelist, ИмяПоля)
	Для Каждого Кандидат Из Whitelist Цикл
		Если ВРег(Строка(Кандидат)) = ВРег(Строка(ИмяПоля)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ВыбратьЛучшееПолеПоWhitelist(ИсходноеПоле, Whitelist)
	ЛучшееПоле = "";
	ЛучшаяОценка = -1;
	Для Каждого Кандидат Из Whitelist Цикл
		Оценка = ОценитьПохожестьИмениОбъекта(Строка(ИсходноеПоле), Строка(Кандидат));
		Если Оценка > ЛучшаяОценка Тогда
			ЛучшаяОценка = Оценка;
			ЛучшееПоле = Строка(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Если ЛучшаяОценка < 8 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ЛучшееПоле;
КонецФункции

Функция ИзвлечьИмяОтсутствующегоПоляИзОшибки(СообщениеОшибки)
	Текст = Строка(СообщениеОшибки);
	ТекстВРег = ВРег(Текст);
	ПозПоля = СтрНайти(ТекстВРег, "ПОЛЕ НЕ НАЙДЕНО");
	Если ПозПоля = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Текст, ПозПоля + СтрДлина("Поле не найдено"));
	ПозКавычки = СтрНайти(Остаток, """");
	Если ПозКавычки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Остаток, ПозКавычки + 1);
	ПозКонца = СтрНайти(Остаток, """");
	Если ПозКонца = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Остаток, ПозКонца - 1));
КонецФункции

Функция ПреобразоватьСтрокуРеквизитовВWhitelist(ТекстРеквизитов)
	Whitelist = Новый Массив;
	Текст = СтрЗаменить(Строка(ТекстРеквизитов), Символы.ПС, " ");
	Для Каждого Часть Из СтрРазделить(Текст, ",") Цикл
		ИмяПоля = СокрЛП(Строка(Часть));
		Если НЕ ПустаяСтрока(ИмяПоля) И Whitelist.Найти(ИмяПоля) = Неопределено Тогда
			Whitelist.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Whitelist;
КонецФункции

Функция ПопробоватьЛокальноИсправитьFieldNotFoundDSL(СообщениеОшибки, DSLИсходный, ТекстРеквизитов)
	Если ПустаяСтрока(DSLИсходный) Тогда
		Возврат "";
	КонецЕсли;
	ИмяПоля = ИзвлечьИмяОтсутствующегоПоляИзОшибки(СообщениеОшибки);
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;
	Whitelist = ПреобразоватьСтрокуРеквизитовВWhitelist(ТекстРеквизитов);
	Если Whitelist.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ЗаменаПоля = ВыбратьЛучшееПолеПоWhitelist(ИмяПоля, Whitelist);
	Если ПустаяСтрока(ЗаменаПоля) И Whitelist.Найти("Ссылка") <> Неопределено Тогда
		ЗаменаПоля = "Ссылка";
	КонецЕсли;
	Если ПустаяСтрока(ЗаменаПоля) ИЛИ ВРег(ЗаменаПоля) = ВРег(ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;
	ИсправленныйDSL = СтрЗаменить(DSLИсходный, ИмяПоля + " КАК " + ИмяПоля, ЗаменаПоля + " КАК " + ИмяПоля);
	Если ИсправленныйDSL = DSLИсходный Тогда
		ИсправленныйDSL = СтрЗаменить(DSLИсходный, ИмяПоля + " КАК ", ЗаменаПоля + " КАК ");
	КонецЕсли;
	Если ИсправленныйDSL = DSLИсходный Тогда
		ИсправленныйDSL = СтрЗаменить(DSLИсходный, Символы.ПС + ИмяПоля + " ", Символы.ПС + ЗаменаПоля + " ");
	КонецЕсли;
	Если ИсправленныйDSL = DSLИсходный Тогда
		ИсправленныйDSL = СтрЗаменить(DSLИсходный, " " + ИмяПоля + " ", " " + ЗаменаПоля + " ");
	КонецЕсли;
	Если ИсправленныйDSL = DSLИсходный Тогда
		ИсправленныйDSL = СтрЗаменить(DSLИсходный, "(" + ИмяПоля + ")", "(" + ЗаменаПоля + ")");
	КонецЕсли;
	Если ИсправленныйDSL = DSLИсходный Тогда
		ИсправленныйDSL = СтрЗаменить(DSLИсходный, Символы.ПС + ИмяПоля + "=", Символы.ПС + ЗаменаПоля + "=");
	КонецЕсли;
	Если ИсправленныйDSL = DSLИсходный Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИсправленныйDSL;
КонецФункции

Функция ИзвлечьПсевдонимИсточникаИзТекстаЗапросаЛокально(ТекстЗапроса)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	ПозКак = СтрНайти(ТекстВРег, " КАК ");
	Если ПозКак = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Текст, ПозКак + 5);
	Разделители = Новый Массив;
	Разделители.Добавить(" ");
	Разделители.Добавить(Символы.ПС);
	Разделители.Добавить(Символы.Таб);
	ПозицияКонца = 0;
	Для Каждого Разделитель Из Разделители Цикл
		ПозРазделителя = СтрНайти(Остаток, Разделитель);
		Если ПозРазделителя > 0 И (ПозицияКонца = 0 ИЛИ ПозРазделителя < ПозицияКонца) Тогда
			ПозицияКонца = ПозРазделителя;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияКонца = 0 Тогда
		Возврат СокрЛП(Остаток);
	КонецЕсли;
	Возврат СокрЛП(Лев(Остаток, ПозицияКонца - 1));
КонецФункции

Функция НормализоватьЯвныйRunQueryПоWhitelist(ТекстЗапроса, Whitelist, WhitelistПути = Неопределено)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Псевдоним = ИзвлечьПсевдонимИсточникаИзТекстаЗапросаЛокально(Текст);
	ТекстВРег = ВРег(Текст);
	Префикс = "ВЫБРАТЬ ";
	Если Лев(ТекстВРег, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Текст;
	КонецЕсли;
	ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	КонецЕсли;
	Если ПозИз = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	СекцияВыбрать = СокрЛП(Сред(Текст, СтрДлина(Префикс) + 1, ПозИз - СтрДлина(Префикс) - 1));
	Если ПустаяСтрока(СекцияВыбрать) Тогда
		Возврат Текст;
	КонецЕсли;
	ПсевдонимВРег = ВРег(Псевдоним);
	Если НЕ ПустаяСтрока(Псевдоним) И ВРег(СекцияВыбрать) = ПсевдонимВРег И ПолеЕстьВWhitelist(Whitelist, "Ссылка") Тогда
		Возврат СтрЗаменить(Текст, СекцияВыбрать, Псевдоним + ".Ссылка КАК Ссылка");
	КонецЕсли;
	Если СтрНайти(СекцияВыбрать, ",") = 0 И СтрНайти(ВРег(СекцияВыбрать), " КАК ") = 0 Тогда
		Выражение = СокрЛП(СекцияВыбрать);
		ИмяПоля = Выражение;
		Если СтрНайти(ИмяПоля, ".") > 0 Тогда
			ИмяПоля = Сред(ИмяПоля, СтрНайти(ИмяПоля, ".") + 1);
		КонецЕсли;
		Если НЕ ПолеЕстьВWhitelist(Whitelist, ИмяПоля) Тогда
			ЗаменаПоля = ?(ПолеЕстьВWhitelist(Whitelist, "Ссылка"), "Ссылка", ВыбратьЛучшееПолеПоWhitelist(ИмяПоля, Whitelist));
			Если НЕ ПустаяСтрока(ЗаменаПоля) Тогда
				Если НЕ ПустаяСтрока(Псевдоним) Тогда
					Возврат СтрЗаменить(Текст, СекцияВыбрать, Псевдоним + "." + ЗаменаПоля + " КАК " + ЗаменаПоля);
				Иначе
					Возврат СтрЗаменить(Текст, СекцияВыбрать, ЗаменаПоля);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Текст = НормализоватьСтроковыйФильтрПоWhitelist(Текст, Whitelist, WhitelistПути);
	Возврат Текст;
КонецФункции

Функция ИзвлечьИдентификаторыИзСтрокиФильтра(ТекстФильтра)
	Результат = Новый Массив;
	Текст = СтрЗаменить(Строка(ТекстФильтра), Символы.ПС, " ");
	Для Каждого Символ Из Новый Массив("(", ")", "=", "<", ">", ",") Цикл
		Текст = СтрЗаменить(Текст, Строка(Символ), " ");
	КонецЦикла;
	Для Каждого Часть Из СтрРазделить(Текст, " ") Цикл
		Идентификатор = СокрЛП(Строка(Часть));
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если Идентификатор = "И" ИЛИ Идентификатор = "ИЛИ" ИЛИ Идентификатор = "НЕ" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Идентификатор, 1) = """" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЧисловоеЗначение = Число(Идентификатор);
			Продолжить;
		Исключение
		КонецПопытки;
		Если Результат.Найти(Идентификатор) = Неопределено Тогда
			Результат.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиПутьДляСтроковогоСравнения(ИмяПоля, WhitelistПути)
	Если WhitelistПути = Неопределено ИЛИ WhitelistПути.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Префикс = ВРег(ПолучитьБазовоеИмяПоля(ИмяПоля)) + ".";
	ЛучшийПуть = "";
	Для Каждого Путь Из WhitelistПути Цикл
		ПутьСтрокой = СокрЛП(Строка(Путь));
		ПутьВРег = ВРег(ПутьСтрокой);
		Если Лев(ПутьВРег, СтрДлина(Префикс)) <> Префикс Тогда
			Продолжить;
		КонецЕсли;
		Если Прав(ПутьВРег, СтрДлина(".НАИМЕНОВАНИЕ")) = ".НАИМЕНОВАНИЕ" Тогда
			Возврат ПутьСтрокой;
		КонецЕсли;
		Если ПустаяСтрока(ЛучшийПуть) Тогда
			ЛучшийПуть = ПутьСтрокой;
		КонецЕсли;
	КонецЦикла;
	Возврат ЛучшийПуть;
КонецФункции

Функция НормализоватьСтроковыйФильтрПоWhitelist(ТекстФильтра, Whitelist, WhitelistПути = Неопределено)
	Фильтр = СокрЛП(Строка(ТекстФильтра));
	Если ПустаяСтрока(Фильтр) Тогда
		Возврат "";
	КонецЕсли;
	Если Whitelist = Неопределено ИЛИ Whitelist.Количество() = 0 Тогда
		Возврат Фильтр;
	КонецЕсли;
	Результат = Фильтр;
	Для Каждого Поле Из ИзвлечьИдентификаторыИзСтрокиФильтра(Фильтр) Цикл
		ИмяПоля = СокрЛП(Строка(Поле));
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ПутьДляСтроки = НайтиПутьДляСтроковогоСравнения(ИмяПоля, WhitelistПути);
		Если НЕ ПустаяСтрока(ПутьДляСтроки) Тогда
			ПолныйПуть = ПолучитьПрефиксКвалификатораПоля(ИмяПоля) + ПутьДляСтроки;
			Результат = СтрЗаменить(Результат, ИмяПоля + " = """, ПолныйПуть + " = """);
			Результат = СтрЗаменить(Результат, ИмяПоля + "='", ПолныйПуть + "='");
			Результат = СтрЗаменить(Результат, ИмяПоля + " = '", ПолныйПуть + " = '");
			Результат = СтрЗаменить(Результат, "(" + ИмяПоля + " = """, "(" + ПолныйПуть + " = """);
			Результат = СтрЗаменить(Результат, "(" + ИмяПоля + " = '", "(" + ПолныйПуть + " = '");
		КонецЕсли;
		Если ПолеЕстьВWhitelist(Whitelist, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ЗаменаПоля = ВыбратьЛучшееПолеПоWhitelist(ИмяПоля, Whitelist);
		Если ПустаяСтрока(ЗаменаПоля) ИЛИ ВРег(ЗаменаПоля) = ВРег(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, ИмяПоля + " = ", ЗаменаПоля + " = ");
		Результат = СтрЗаменить(Результат, ИмяПоля + " < ", ЗаменаПоля + " < ");
		Результат = СтрЗаменить(Результат, ИмяПоля + " > ", ЗаменаПоля + " > ");
		Результат = СтрЗаменить(Результат, ИмяПоля + " <= ", ЗаменаПоля + " <= ");
		Результат = СтрЗаменить(Результат, ИмяПоля + " >= ", ЗаменаПоля + " >= ");
		Результат = СтрЗаменить(Результат, ИмяПоля + " <> ", ЗаменаПоля + " <> ");
		Результат = СтрЗаменить(Результат, "(" + ИмяПоля + " ", "(" + ЗаменаПоля + " ");
		Результат = СтрЗаменить(Результат, Символы.ПС + ИмяПоля + " ", Символы.ПС + ЗаменаПоля + " ");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьБазовоеИмяПоля(ИмяПоля)
	Имя = СокрЛП(Строка(ИмяПоля));
	ПозицияТочки = 0;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Если Сред(Имя, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияТочки = 0 Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат Сред(Имя, ПозицияТочки + 1);
КонецФункции

Функция ПолучитьПрефиксКвалификатораПоля(ИмяПоля)
	Имя = СокрЛП(Строка(ИмяПоля));
	ПозицияТочки = 0;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Если Сред(Имя, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияТочки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Имя, ПозицияТочки);
КонецФункции

Процедура ПрименитьЭффектGetObjectFieldsШагаПлана(План, ЗавершенныйШаг)
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ЗавершенныйШаг = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ЗавершенныйШаг) Тогда
		Возврат;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "kind", ""))) <> "GET_OBJECT_FIELDS" Тогда
		Возврат;
	КонецЕсли;
	Whitelist = ПолучитьWhitelistПолейИзРезультатаШага(ЗавершенныйШаг);
	WhitelistПути = ПолучитьWhitelistПутейИзРезультатаШага(ЗавершенныйШаг);
	Если Whitelist.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	InputЗавершенного = ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "input", Неопределено);
	ПолноеИмяОбъекта = "";
	Если ЭтоJSONОбъект(InputЗавершенного) Тогда
		ТипОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputЗавершенного, "object_type", ""));
		ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputЗавершенного, "object_name", ""));
		Если НЕ ПустаяСтрока(ТипОбъекта) И НЕ ПустаяСтрока(ИмяОбъекта) Тогда
			ПолноеИмяОбъекта = ТипОбъекта + "." + ИмяОбъекта;
		КонецЕсли;
	КонецЕсли;
	Для Индекс = 0 По План.steps.Количество() - 1 Цикл
		ШагКандидат = План.steps[Индекс];
		Если СтатусШагаЗавершен(ШагКандидат) Тогда
			Продолжить;
		КонецЕсли;
		KindШага = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагКандидат, "kind", "")));
		Если KindШага <> "RUN_QUERY" Тогда
			Продолжить;
		КонецЕсли;
		InputШага = ПолучитьСвойствоJSONОбъекта(ШагКандидат, "input", Неопределено);
		Если НЕ ЭтоJSONОбъект(InputШага) Тогда
			Продолжить;
		КонецЕсли;
		ИмяОбъектаШага = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
		Если ПустаяСтрока(ИмяОбъектаШага) Тогда
			ИмяОбъектаШага = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
		КонецЕсли;
		ТекстЗапроса = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "query", ""));
		Если ПустаяСтрока(ИмяОбъектаШага) И НЕ ПустаяСтрока(ТекстЗапроса) Тогда
			ИмяОбъектаШага = ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаЛокально(ТекстЗапроса);
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) И НЕ ПустаяСтрока(ИмяОбъектаШага) И ВРег(ИмяОбъектаШага) <> ВРег(ПолноеИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		ПоляШага = ПолучитьСвойствоJSONОбъекта(InputШага, "fields", Неопределено);
		Если ЭтоJSONArray(ПоляШага) Тогда
			НовыеПоля = Новый Массив;
			Для Каждого Поле Из ПоляШага Цикл
				ИмяПоля = СокрЛП(Строка(Поле));
				Если ПустаяСтрока(ИмяПоля) Тогда
					Продолжить;
				КонецЕсли;
				Если ПолеЕстьВWhitelist(Whitelist, ИмяПоля) Тогда
					НовыеПоля.Добавить(ИмяПоля);
				Иначе
					ЗаменаПоля = ВыбратьЛучшееПолеПоWhitelist(ИмяПоля, Whitelist);
					Если НЕ ПустаяСтрока(ЗаменаПоля) И НовыеПоля.Найти(ЗаменаПоля) = Неопределено Тогда
						НовыеПоля.Добавить(ЗаменаПоля);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НовыеПоля.Количество() = 0 Тогда
				Если ПолеЕстьВWhitelist(Whitelist, "Ссылка") Тогда
					НовыеПоля.Добавить("Ссылка");
				КонецЕсли;
			КонецЕсли;
			InputШага.Вставить("fields", НовыеПоля);
			InputШага.Вставить("query", "");
		ИначеЕсли НЕ ПустаяСтрока(ТекстЗапроса)
			И НЕ ПолучитьСвойствоJSONОбъекта(InputШага, "preserve_query", Ложь) Тогда
			InputШага.Вставить("query", НормализоватьЯвныйRunQueryПоWhitelist(ТекстЗапроса, Whitelist, WhitelistПути));
		КонецЕсли;
		ФильтрШага = ПолучитьСвойствоJSONОбъекта(InputШага, "filter", Неопределено);
		Если ТипЗнч(ФильтрШага) = Тип("Строка") И НЕ ПустаяСтрока(Строка(ФильтрШага)) Тогда
			InputШага.Вставить("filter", НормализоватьСтроковыйФильтрПоWhitelist(Строка(ФильтрШага), Whitelist, WhitelistПути));
			InputШага.Вставить("query", "");
		КонецЕсли;
		Если НЕ ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			InputШага.Вставить("object", ПолноеИмяОбъекта);
			InputШага.Вставить("object_name", ПолноеИмяОбъекта);
		КонецЕсли;
		ШагКандидат.input = InputШага;
		План.steps[Индекс] = ШагКандидат;
		Прервать;
	КонецЦикла;
КонецПроцедуры

Процедура ПрименитьУсловныйТерминальныйЭффектШагаПлана(План, ЗавершенныйШаг)
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ЗавершенныйШаг = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ЗавершенныйШаг) Тогда
		Возврат;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "kind", ""))) <> "SHOW_INFO" Тогда
		Возврат;
	КонецЕсли;
	
	InputШага = ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "input", Неопределено);
	КлассУсловия = "";
	Если ЭтоJSONОбъект(InputШага) Тогда
		КлассУсловия = КлассифицироватьУсловиеВеткиПлана(ПолучитьСвойствоJSONОбъекта(InputШага, "condition", ""));
	КонецЕсли;
	
	ИндексЗавершенного = -1;
	Для Индекс = 0 По План.steps.Количество() - 1 Цикл
		Кандидат = План.steps[Индекс];
		Если Кандидат.Свойство("id") И Строка(Кандидат.id) = Строка(ЗавершенныйШаг.id) Тогда
			ИндексЗавершенного = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИндексЗавершенного < 0 Тогда
		Возврат;
	КонецЕсли;

	ТерминальныйНепустойПоиск = Ложь;
	ЗависимостиТерминальнойВетки = Новый Соответствие;
	Если ПустаяСтрока(КлассУсловия) Тогда
		ЗависимостиЗавершенного = ПолучитьСвойствоJSONОбъекта(ЗавершенныйШаг, "depends_on", Неопределено);
		Если ЭтоJSONArray(ЗависимостиЗавершенного) Тогда
			Для Каждого ИдЗависимости Из ЗависимостиЗавершенного Цикл
				ЗависимостиТерминальнойВетки.Вставить(Строка(ИдЗависимости), Истина);
				ШагЗависимости = НайтиШагВПланеПоИдентификатору(План, Строка(ИдЗависимости));
				Если РезультатШагаСодержитНепустойRunQuery(ШагЗависимости) Тогда
					ТерминальныйНепустойПоиск = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если НЕ ТерминальныйНепустойПоиск Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПропущенныеШаги = Новый Соответствие;
	ИзмененияЕсть = Ложь;
	Для Индекс = ИндексЗавершенного + 1 По План.steps.Количество() - 1 Цикл
		ШагКандидат = План.steps[Индекс];
		Если СтатусШагаЗавершен(ШагКандидат) Тогда
			Продолжить;
		КонецЕсли;
		
		InputКандидата = ПолучитьСвойствоJSONОбъекта(ШагКандидат, "input", Неопределено);
		КлассКандидата = "";
		Если ЭтоJSONОбъект(InputКандидата) Тогда
			КлассКандидата = КлассифицироватьУсловиеВеткиПлана(ПолучитьСвойствоJSONОбъекта(InputКандидата, "condition", ""));
		КонецЕсли;
		
		НужноПропустить = Ложь;
		Если КлассУсловия = "not_empty" И КлассКандидата = "empty" Тогда
			НужноПропустить = Истина;
		ИначеЕсли КлассУсловия = "empty" И КлассКандидата = "not_empty" Тогда
			НужноПропустить = Истина;
		ИначеЕсли ТерминальныйНепустойПоиск
			И ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагКандидат, "kind", ""))) <> "SHOW_INFO"
			И ШагПланаЗависитОтЛюбогоИдентификатора(ШагКандидат, ЗависимостиТерминальнойВетки) Тогда
			НужноПропустить = Истина;
		ИначеЕсли ШагПланаЗависитОтЛюбогоИдентификатора(ШагКандидат, ПропущенныеШаги) Тогда
			НужноПропустить = Истина;
		КонецЕсли;
		
		Если НужноПропустить Тогда
			ШагКандидат.status = "skipped";
			ШагКандидат.result_summary = "Пропущено: альтернативная ветка уже завершена";
			ШагКандидат.result_data = Неопределено;
			План.steps[Индекс] = ШагКандидат;
			ПропущенныеШаги.Вставить(Строка(ШагКандидат.id), Истина);
			ИзмененияЕсть = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьШагПланаПоИдентификатору(СсылкаДиалога, StepId) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Для Каждого ШагПлана Из План.steps Цикл
		Если ШагПлана.Свойство("id") И Строка(ШагПлана.id) = Строка(StepId) Тогда
			Возврат ШагПлана;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЭтоТолькоКатегорияОбъектаМетаданных(ИмяОбъекта)
	Имя = СокрЛП(Строка(ИмяОбъекта));
	Если ПустаяСтрока(Имя) ИЛИ СтрНайти(Имя, ".") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяВРег = ВРег(Имя);
	Возврат ИмяВРег = "СПРАВОЧНИК"
		ИЛИ ИмяВРег = "ДОКУМЕНТ"
		ИЛИ ИмяВРег = "РЕГИСТРНАКОПЛЕНИЯ"
		ИЛИ ИмяВРег = "РЕГИСТРСВЕДЕНИЙ"
		ИЛИ ИмяВРег = "ПЛАНВИДОВХАРАКТЕРИСТИК"
		ИЛИ ИмяВРег = "ПЛАНСЧЕТОВ";
КонецФункции

Функция НормализоватьНеполныйШагПолейВПоискМетаданных(ШагПлана, План)
	Если ШагПлана = Неопределено ИЛИ НЕ ЭтоJSONОбъект(ШагПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	Kind = ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", "")));
	Если Kind <> "GET_OBJECT_FIELDS" Тогда
		Возврат Ложь;
	КонецЕсли;
	InputШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
	Если НЕ ЭтоJSONОбъект(InputШага) Тогда
		Возврат Ложь;
	КонецЕсли;
	Объект = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
	ТипОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_type", ""));
	ИмяОбъекта = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
	Если НЕ ПустаяСтрока(Объект)
		И НЕ ЭтоТолькоКатегорияОбъектаМетаданных(Объект)
		И НЕ (НЕ ПустаяСтрока(ТипОбъекта) И ПустаяСтрока(ИмяОбъекта)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(Объект) И НЕ ПустаяСтрока(ТипОбъекта) И НЕ ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Фильтр = "";
	Если План <> Неопределено И ТипЗнч(План) = Тип("Структура") И План.Свойство("goal") Тогда
		Фильтр = Строка(План.goal);
	КонецЕсли;
	Если ШагПлана.Свойство("title") Тогда
		Фильтр = СокрЛП(Фильтр + " " + Строка(ШагПлана.title));
	КонецЕсли;
	ШагПлана.kind = "get_metadata";
	ШагПлана.title = "Уточнить объект метаданных для запроса";
	ШагПлана.input = Новый Структура("filter", Фильтр);
	Возврат Истина;
КонецФункции

Функция ПолучитьСледующийШагПлана(СсылкаДиалога) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Для Каждого ШагПлана Из План.steps Цикл
		Если СтатусШагаЗавершен(ШагПлана) Тогда
			Продолжить;
		КонецЕсли;
		Если ВсеЗависимостиШагаВыполнены(ШагПлана, План) Тогда
			Если СанитизироватьInputRunQuery(ШагПлана) Тогда
				План.steps[План.steps.Найти(ШагПлана)] = ШагПлана;
				СохранитьTypedPlan(СсылкаДиалога, План);
				Возврат ПолучитьСледующийШагПлана(СсылкаДиалога);
			КонецЕсли;
			Если НормализоватьНеполныйШагПолейВПоискМетаданных(ШагПлана, План) Тогда
				План.steps[План.steps.Найти(ШагПлана)] = ШагПлана;
				СохранитьTypedPlan(СсылкаДиалога, План);
				Возврат ШагПлана;
			КонецЕсли;
			Если ШагЯвляетсяМягкимLookupДляЗапроса(ШагПлана, План) Тогда
				ШагПлана.status = "skipped";
				ШагПлана.result_summary = "Пропущено: lookup используется только как мягкая подсказка для последующего запроса";
				ШагПлана.result_data = Неопределено;
				План.steps[План.steps.Найти(ШагПлана)] = ШагПлана;
				СохранитьTypedPlan(СсылкаДиалога, План);
				Возврат ПолучитьСледующийШагПлана(СсылкаДиалога);
			КонецЕсли;
			Если НужноПропуститьСозданиеПослеНайденногоОбъекта(ШагПлана, План) Тогда
				ШагПлана.status = "skipped";
				ШагПлана.result_summary = "Пропущено: объект уже найден, дубль не создается";
				План.steps[План.steps.Найти(ШагПлана)] = ШагПлана;
				СохранитьTypedPlan(СсылкаДиалога, План);
				Возврат ПолучитьСледующийШагПлана(СсылкаДиалога);
			КонецЕсли;
			Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) = "RUN_QUERY" Тогда
				InputШага = ПолучитьСвойствоJSONОбъекта(ШагПлана, "input", Неопределено);
				Если ЭтоJSONОбъект(InputШага) Тогда
					ЯвныйЗапрос = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "query", ""));
					ИмяОбъектаШага = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object", ""));
					Если ПустаяСтрока(ИмяОбъектаШага) Тогда
						ИмяОбъектаШага = Строка(ПолучитьСвойствоJSONОбъекта(InputШага, "object_name", ""));
					КонецЕсли;
					Если ПустаяСтрока(ЯвныйЗапрос) И НЕ ПустаяСтрока(ИмяОбъектаШага) Тогда
						Если ИИА_Оркестратор.ДобавитьGetObjectFieldsВПланПередRunQuery(СсылкаДиалога, ИмяОбъектаШага) Тогда
							Возврат ПолучитьСледующийШагПлана(СсылкаДиалога);
						КонецЕсли;
					ИначеЕсли НЕ ПустаяСтрока(ЯвныйЗапрос) Тогда
						ИмяОбъектаИзЗапроса = НормализоватьИмяОбъектаДляGetObjectFields(ИзвлечьПолноеИмяОбъектаИзТекстаЗапросаЛокально(ЯвныйЗапрос));
						Если НЕ ПустаяСтрока(ИмяОбъектаИзЗапроса) Тогда
							InputШага.Вставить("object", ИмяОбъектаИзЗапроса);
							InputШага.Вставить("object_name", ИмяОбъектаИзЗапроса);
							ШагПлана.input = InputШага;
							План.steps[План.steps.Найти(ШагПлана)] = ШагПлана;
							СохранитьTypedPlan(СсылкаДиалога, План);
							Если ИИА_Оркестратор.ДобавитьGetObjectFieldsВПланПередRunQuery(СсылкаДиалога, ИмяОбъектаИзЗапроса) Тогда
								Возврат ПолучитьСледующийШагПлана(СсылкаДиалога);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Возврат ШагПлана;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура ОбновитьШагПлана(СсылкаДиалога, StepId, Status, ResultSummary = "", ResultData = Неопределено) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	НормализованныйResultData = НормализоватьРезультатШагаПланаДляХранения(ResultData);
	ОбновленныйШаг = Неопределено;
	Для Индекс = 0 По План.steps.Количество() - 1 Цикл
		ШагПлана = План.steps[Индекс];
		Если ШагПлана.Свойство("id") И Строка(ШагПлана.id) = Строка(StepId) Тогда
			ШагПлана.status = Status;
			ШагПлана.result_summary = ResultSummary;
			ШагПлана.result_data = НормализованныйResultData;
			План.steps[Индекс] = ШагПлана;
			ОбновленныйШаг = ШагПлана;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ВРег(Строка(Status)) = "DONE" Тогда
		ПрименитьЭффектGetMetadataШагаПлана(План, ОбновленныйШаг);
		ПрименитьЭффектGetObjectFieldsШагаПлана(План, ОбновленныйШаг);
		ПрименитьУсловныйТерминальныйЭффектШагаПлана(План, ОбновленныйШаг);
	КонецЕсли;
	СохранитьTypedPlan(СсылкаДиалога, План);
	
	ДеталиЧекпоинта = Новый Структура;
	ДеталиЧекпоинта.Вставить("step_id", StepId);
	ДеталиЧекпоинта.Вставить("status", Status);
	Если НЕ ПустаяСтрока(ResultSummary) Тогда
		ДеталиЧекпоинта.Вставить("result_summary", Лев(ResultSummary, 500));
	КонецЕсли;
	ИИА_Сервер.СохранитьЧекпоинтОркестратора(СсылкаДиалога, "plan_step_updated", "Execute", ДеталиЧекпоинта);
КонецПроцедуры

Функция ИнициализироватьПлан(СсылкаДиалога) Экспорт
	
	// Получаем последнюю задачу пользователя (для последующих команд в диалоге)
	РезультатЗадачи = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(СсылкаДиалога);
	Если НЕ РезультатЗадачи.Найдено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстЗадачи = РезультатЗадачи.Текст;
	Если СсылкаДиалога.ТипДиалога = Перечисления.ИИА_ТипДиалога.Запрос1С
		И ЕстьWriteНамерениеВТексте(ТекстЗадачи) Тогда
		ПланReadOnly = СоздатьReadOnlyПланЗапретаЗаписи(ТекстЗадачи);
		ПланReadOnly.last_user_text = ТекстЗадачи;
		СохранитьTypedPlan(СсылкаДиалога, ПланReadOnly);
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Запрос записи остановлен режимом Запрос1С: режим доступен только для чтения.");
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
		Возврат Истина;
	КонецЕсли;

	Если ЭтоОпасноеМассовоеУдалениеБезПодтверждения(ТекстЗадачи) Тогда
		ПланDestructiveGuard = СоздатьПланЗапретаОпасногоМассовогоУдаления(ТекстЗадачи);
		ПланDestructiveGuard.last_user_text = ТекстЗадачи;
		СохранитьTypedPlan(СсылкаДиалога, ПланDestructiveGuard);
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Массовое удаление остановлено destructive_guard до RAG/LLM.");
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
		Возврат Истина;
	КонецЕсли;

	ПланРаспознавания = СоздатьПланРаспознаванияПоСкилу(СсылкаДиалога, ТекстЗадачи);
	Если ПланРаспознавания <> Неопределено Тогда
		ПланРаспознавания.last_user_text = ТекстЗадачи;
		СохранитьTypedPlan(СсылкаДиалога, ПланРаспознавания);
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Использован DSL template выбранного skill распознавания: " + ПланРаспознавания.skill_name);
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
		Возврат Истина;
	КонецЕсли;

	// Формируем промпт для создания плана
	ПромптПлана = ИИА_Промты.ПолучитьПромптСозданияПлана(ТекстЗадачи, СсылкаДиалога);
	Если ИИА_Оркестратор.ЭтоЗапросПодсчета(ТекстЗадачи) Тогда
		ПромптПлана = ПромптПлана + Символы.ПС +
		"Дополнительно: если задача содержит 'сколько/количество', план должен включать RunQuery с КОЛИЧЕСТВО(...) и ShowInfo.";
	КонецЕсли;
	
	// Вызываем ИИ (через системное сообщение)
	РезультатDiscovery = ИИА_Оркестратор.ВыполнитьDiscoverySubgraph(СсылкаДиалога, ТекстЗадачи, СсылкаДиалога.ТипДиалога);
	ПараметрыRAG = ?(РезультатDiscovery <> Неопределено И РезультатDiscovery.Свойство("Details"), РезультатDiscovery.Details, Новый Структура("ИспользоватьRAG,Причина", Ложь, ""));
	ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[RAG_DECISION] План: " + ?(ПараметрыRAG.ИспользоватьRAG, "включен", "выключен") + ". " + ПараметрыRAG.Причина);
	ОтветИИ = ИИА_Сервер.ВызватьИИССистемнымСообщением(СсылкаДиалога, "Чат", ПромптПлана, ИИА_Промты.ПолучитьТекстПромптаПланировщика(), "plan", , ПараметрыRAG.ИспользоватьRAG);
	
	Если ПустаяСтрока(ОтветИИ.Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Парсим typed plan JSON
	Попытка
		ТекстПланаJSON = НормализоватьJSONObjectТекст(ОтветИИ.Текст);
		Если ПустаяСтрока(ТекстПланаJSON) Тогда
			ТекстПланаJSON = ОтветИИ.Текст;
		КонецЕсли;
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстПланаJSON);
		СыройПлан = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		План = НормализоватьTypedPlan(СыройПлан, ТекстЗадачи);
		Если План.steps.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		План.last_user_text = ТекстЗадачи;
		
		СохранитьTypedPlan(СсылкаДиалога, План);
		
		// Отправляем уведомление клиенту о завершении планирования
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
		
		Возврат Истина;
		
	Исключение
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Ошибка инициализации typed-plan: " + ОписаниеОшибки());
		Если ЕстьWriteНамерениеВТексте(ТекстЗадачи) Тогда
			План = СоздатьFallbackПланЗаписиЧерезTools(ТекстЗадачи);
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Использован fallback typed-plan для задачи записи через GetMetadata -> GetObjectFields -> Create/Write -> ShowInfo.");
		Иначе
			План = СоздатьFallbackПланЧерезTools(ТекстЗадачи);
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Использован fallback typed-plan через GetMetadata -> RunQuery -> ShowInfo.");
		КонецЕсли;
		План.last_user_text = ТекстЗадачи;
		СохранитьTypedPlan(СсылкаДиалога, План);
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

// Дополняет план новыми задачами для последующей команды пользователя (режим продолжения диалога)
//
// Параметры:
//  СсылкаДиалога - СправочникСсылка.ИИА_Диалоги - ссылка на диалог
//
// Возвращаемое значение:
//  Булево - Истина при успехе, Ложь при ошибке (вызывающий код может очистить план и использовать ИнициализироватьПлан)
//
Функция ДополнитьПлан(СсылкаДиалога) Экспорт
	
	// Получаем последнюю задачу пользователя
	РезультатЗадачи = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(СсылкаДиалога);
	Если НЕ РезультатЗадачи.Найдено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстЗадачи = РезультатЗадачи.Текст;
	
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Если План.steps.Количество() = 0 Тогда
		// План пуст - дополнять нечего, используем обычную инициализацию
		Возврат Ложь;
	КонецЕсли;
	
	КраткийПлан = СформироватьКраткийПланДляПромпта(План);
	ПланJSON = СжатьJSONДляЛога(СериализоватьJSONЛокально(КраткийПлан));
	
	// Формируем промпт для дополнения плана
	ПромптДополнения = ИИА_Промты.ПолучитьПромптДополненияПлана(ТекстЗадачи, ПланJSON, СсылкаДиалога);
	
	// Вызываем ИИ
	ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Дополнение плана новой задачей...");
	РезультатDiscovery = ИИА_Оркестратор.ВыполнитьDiscoverySubgraph(СсылкаДиалога, ТекстЗадачи, СсылкаДиалога.ТипДиалога);
	ПараметрыRAG = ?(РезультатDiscovery <> Неопределено И РезультатDiscovery.Свойство("Details"), РезультатDiscovery.Details, Новый Структура("ИспользоватьRAG,Причина", Ложь, ""));
	ОтветИИ = ИИА_Сервер.ВызватьИИССистемнымСообщением(СсылкаДиалога, "Чат", ПромптДополнения, ИИА_Промты.ПолучитьТекстПромптаПланировщика(), "plan", , ПараметрыRAG.ИспользоватьRAG);
	
	Если ПустаяСтрока(ОтветИИ.Текст) Тогда
		ПланFallback = СоздатьFallbackПланПродолженияЗапроса(СсылкаДиалога, ТекстЗадачи, План);
		Если ПланFallback <> Неопределено Тогда
			СохранитьTypedPlan(СсылкаДиалога, ПланFallback);
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] План дополнен fallback-шагами по последнему запросу 1С.");
			ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ТекстНовогоПланаJSON = НормализоватьJSONObjectТекст(ОтветИИ.Текст);
		Если ПустаяСтрока(ТекстНовогоПланаJSON) Тогда
			ТекстНовогоПланаJSON = ОтветИИ.Текст;
		КонецЕсли;
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстНовогоПланаJSON);
		СыройНовыйПлан = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		НовыйПлан = НормализоватьTypedPlan(СыройНовыйПлан, ТекстЗадачи);
		Если НовыйПлан.steps.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Для Каждого НовыйШаг Из НовыйПлан.steps Цикл
			Если НовыйШаг.Свойство("depends_on") И НовыйШаг.depends_on.Количество() = 0 И План.steps.Количество() > 0 Тогда
				ПоследнийШаг = План.steps[План.steps.Количество() - 1];
				НовыйШаг.depends_on.Добавить(Строка(ПоследнийШаг.id));
			КонецЕсли;
			НовыйШаг.seq_no = План.steps.Количество() + 1;
			План.steps.Добавить(НовыйШаг);
		КонецЦикла;
		План.last_user_text = ТекстЗадачи;
		СохранитьTypedPlan(СсылкаДиалога, План);
		
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] План дополнен " + Строка(НовыйПлан.steps.Количество()) + " новыми шагами.");
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
		
		Возврат Истина;
		
	Исключение
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] Ошибка дополнения плана: " + ОписаниеОшибки());
		ПланFallback = СоздатьFallbackПланПродолженияЗапроса(СсылкаДиалога, ТекстЗадачи, План);
		Если ПланFallback <> Неопределено Тогда
			СохранитьTypedPlan(СсылкаДиалога, ПланFallback);
			ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[План] План дополнен fallback-шагами по последнему запросу 1С.");
			ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланИнициализирован");
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьПланДиалога(СсылкаДиалога) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Если План = Неопределено ИЛИ ТипЗнч(План) <> Тип("Структура") ИЛИ НЕ План.Свойство("steps") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат План.steps;
КонецФункции

Функция ОбновитьПланПоРезультатам(СсылкаДиалога) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	СинхронизироватьТабличнуюЧастьПлана(СсылкаДиалога, План);
	ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ПланОбновлен");
	Возврат Истина;
КонецФункции

Функция ПолучитьСледующийПунктПлана(СсылкаДиалога) Экспорт
	ШагПлана = ПолучитьСледующийШагПлана(СсылкаДиалога);
	Если ШагПлана = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(ШагПлана.Свойство("title"), Строка(ШагПлана.title), "");
КонецФункции

Функция ПланЗавершен(СсылкаДиалога) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Если План.steps.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ШагПлана Из План.steps Цикл
		Если НЕ СтатусШагаЗавершен(ШагПлана) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЕстьНоваяКомандаПослеОбработанногоПлана(СсылкаДиалога) Экспорт
	Если НЕ ПланЗавершен(СсылкаДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	РезультатЗадачи = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(СсылкаДиалога);
	Если НЕ РезультатЗадачи.Найдено Тогда
		Возврат Ложь;
	КонецЕсли;
	План = ПолучитьTypedPlan(СсылкаДиалога);
	ПоследнийОбработанныйТекст = ?(План.Свойство("last_user_text"), Строка(План.last_user_text), Строка(План.goal));
	Возврат СокрЛП(Строка(РезультатЗадачи.Текст)) <> СокрЛП(ПоследнийОбработанныйТекст);
КонецФункции

// Помечает все невыполненные шаги плана как выполненные с результатом "Пропущено (лимит итераций)"
Процедура ПропуститьНевыполненныеШагиПлана(СсылкаДиалога) Экспорт
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Для Индекс = 0 По План.steps.Количество() - 1 Цикл
		ШагПлана = План.steps[Индекс];
		Если НЕ СтатусШагаЗавершен(ШагПлана) Тогда
			ШагПлана.status = "skipped";
			ШагПлана.result_summary = "Пропущено (лимит итераций)";
			План.steps[Индекс] = ШагПлана;
		КонецЕсли;
	КонецЦикла;
	СохранитьTypedPlan(СсылкаДиалога, План);
КонецПроцедуры

// Пропускает шаги плана (ShowInfo об открытии формы), бессмысленные без GUI.
// SelectObject выполняется в режиме агента 1С (загрузка объекта в контекст) - НЕ пропускаем.
Функция ПропуститьПроблемныеШагиПлана(СсылкаДиалога) Экспорт
	ШагПлана = ПолучитьСледующийШагПлана(СсылкаДиалога);
	Если ШагПлана = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", ""))) = "SHOW_INFO" И СтрНайти(ВРег(Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "title", ""))), "ОТКРЫТ") > 0 Тогда
		ОбновитьШагПлана(СсылкаДиалога, ШагПлана.id, "skipped", "Пропущено (режим без GUI)");
		ИИА_Сервер.ДобавитьЗаписьВЛогДиалога(СсылкаДиалога, "[Система] Шаг """ + Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "title", "")) + """ пропущен (нет интерфейса).");
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьНевыполненныеЗадачиПользователя(СсылкаДиалога) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ЕстьНевыполненные", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Шаги", Новый Массив);
	
	План = ПолучитьTypedPlan(СсылкаДиалога);
	Если План = Неопределено Или НЕ План.Свойство("steps") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ШагПлана Из План.steps Цикл
		Если СтатусШагаЗавершен(ШагПлана) Тогда
			Продолжить;
		КонецЕсли;
		Результат.ЕстьНевыполненные = Истина;
		ЗаголовокШага = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "title", ""));
		Если ПустаяСтрока(ЗаголовокШага) Тогда
			ЗаголовокШага = Строка(ПолучитьСвойствоJSONОбъекта(ШагПлана, "kind", "pending_step"));
		КонецЕсли;
		Результат.Шаги.Добавить(ЗаголовокШага);
	КонецЦикла;
	
	Если Результат.Шаги.Количество() > 0 Тогда
		Результат.Текст = СтрСоединить(Результат.Шаги, Символы.ПС);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти

