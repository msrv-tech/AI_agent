	План.steps.Добавить(Шаг);
	Возврат План;
КонецФункции

Функция СоздатьШагFallback(Ид, Номер, Kind, Заголовок, Input, Зависимость = "")
	Шаг = Новый Структура;
	Шаг.Вставить("id", Ид);
	Шаг.Вставить("seq_no", Номер);
	Шаг.Вставить("kind", Kind);
	Шаг.Вставить("title", Заголовок);
	Зависимости = Новый Массив;
	Если НЕ ПустаяСтрока(Строка(Зависимость)) Тогда
		Зависимости.Добавить(Строка(Зависимость));
	КонецЕсли;
	Шаг.Вставить("depends_on", Зависимости);
	Шаг.Вставить("input", Input);
	Шаг.Вставить("status", "pending");
	Шаг.Вставить("result_summary", "");
	Шаг.Вставить("result_data", Неопределено);
	Возврат Шаг;
КонецФункции

Функция ДополнитьFallbackФильтрСемантикойЗапроса(Цель)
	Фильтр = СокрЛП(Строка(Цель));
	Текст = ВРег(Фильтр);
	Дополнения = Новый Массив;
	Если СтрНайти(Текст, "СУММ") > 0
		И (СтрНайти(Текст, "КЛИЕНТ") > 0
			ИЛИ СтрНайти(Текст, "КОНТРАГЕНТ") > 0
			ИЛИ СтрНайти(Текст, "ПОКУПАТЕЛ") > 0
			ИЛИ СтрНайти(Текст, "ПОСТАВЩИК") > 0) Тогда
		Дополнения.Добавить("продажи");
		Дополнения.Добавить("реализация");
		Дополнения.Добавить("контрагент");
		Дополнения.Добавить("сумма");
	КонецЕсли;
	Если СтрНайти(Текст, "ЗАКАЗ") > 0
		И (СтрНайти(Текст, "КЛИЕНТ") > 0 ИЛИ СтрНайти(Текст, "ПОКУПАТЕЛ") > 0) Тогда
		Дополнения.Добавить("покупатель");
		Дополнения.Добавить("реализация");
	КонецЕсли;
	Для Каждого Дополнение Из Дополнения Цикл
		Если СтрНайти(ВРег(Фильтр), ВРег(Строка(Дополнение))) = 0 Тогда
			Фильтр = Фильтр + " " + Строка(Дополнение);
		КонецЕсли;
	КонецЦикла;
	Возврат Фильтр;
КонецФункции

Функция СоздатьFallbackПланЧерезTools(Цель)
	План = СоздатьПустойTypedPlan(Цель);
	ФильтрМетаданных = ДополнитьFallbackФильтрСемантикойЗапроса(Цель);
	ПредпочтительныйОбъект = ОпределитьFallbackОбъектЗапроса(Цель);
	План.steps.Добавить(СоздатьШагFallback("step_1", 1, "get_metadata",
		"Уточнить объект метаданных для запроса", Новый Структура("filter", ФильтрМетаданных)));

	InputПолей = Новый Структура("object", Цель);
	Если НЕ ПустаяСтрока(ПредпочтительныйОбъект) Тогда
		InputПолей.Вставить("object", ПредпочтительныйОбъект);
		InputПолей.Вставить("object_name", ПредпочтительныйОбъект);
	КонецЕсли;
	План.steps.Добавить(СоздатьШагFallback("step_2", 2, "get_object_fields",
		"Уточнить поля выбранного объекта", InputПолей, "step_1"));

	ЗависимостиЗапроса = Новый Массив;
	ЗависимостиЗапроса.Добавить("step_2");
	InputЗапроса = Новый Структура;
	InputЗапроса.Вставить("intent", Цель);
	InputЗапроса.Вставить("filter", Цель);
	InputЗапроса.Вставить("query", "");
	Если НЕ ПустаяСтрока(ПредпочтительныйОбъект) Тогда
		InputЗапроса.Вставить("object", ПредпочтительныйОбъект);
		InputЗапроса.Вставить("object_name", ПредпочтительныйОбъект);
	КонецЕсли;
	ШагЗапрос = Новый Структура;
	ШагЗапрос.Вставить("id", "step_3");
	ШагЗапрос.Вставить("seq_no", 3);
	ШагЗапрос.Вставить("kind", "run_query");
	ШагЗапрос.Вставить("title", "Выполнить запрос по уточненным метаданным");
	ШагЗапрос.Вставить("depends_on", ЗависимостиЗапроса);
	ШагЗапрос.Вставить("input", InputЗапроса);
	ШагЗапрос.Вставить("status", "pending");
	ШагЗапрос.Вставить("result_summary", "");
	ШагЗапрос.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагЗапрос);

	ЗависимостиПоказа = Новый Массив;
	ЗависимостиПоказа.Добавить("step_3");
	ШагПоказ = Новый Структура;
	ШагПоказ.Вставить("id", "step_4");
	ШагПоказ.Вставить("seq_no", 4);
	ШагПоказ.Вставить("kind", "show_info");
	ШагПоказ.Вставить("title", "Показать результат запроса пользователю");
	ШагПоказ.Вставить("depends_on", ЗависимостиПоказа);
	ШагПоказ.Вставить("input", Новый Структура("source", "step_3"));
	ШагПоказ.Вставить("status", "pending");
	ШагПоказ.Вставить("result_summary", "");
	ШагПоказ.Вставить("result_data", Неопределено);
	План.steps.Добавить(ШагПоказ);
	Возврат План;
КонецФункции

Функция ОпределитьFallbackОбъектЗапроса(Цель)
	Текст = ВРег(Строка(Цель));
	ЕстьКлиент = СтрНайти(Текст, "КЛИЕНТ") > 0
		ИЛИ СтрНайти(Текст, "КОНТРАГЕНТ") > 0
		ИЛИ СтрНайти(Текст, "ПОКУПАТЕЛ") > 0;
	ЕстьСумма = СтрНайти(Текст, "СУММ") > 0
		ИЛИ СтрНайти(Текст, "ИТОГ") > 0;
	ЕстьПродажиИлиЗаказы = СтрНайти(Текст, "ПРОДАЖ") > 0
		ИЛИ СтрНайти(Текст, "РЕАЛИЗАЦ") > 0
		ИЛИ СтрНайти(Текст, "ЗАКАЗ") > 0;
	Если ЕстьКлиент И ЕстьСумма И ЕстьПродажиИлиЗаказы Тогда
		Возврат "Документ.РеализацияТоваровУслуг";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЭтоДокументноеWriteНамерение(ТекстЗадачи)
	Текст = НРег(Строка(ТекстЗадачи));
	Возврат СтрНайти(Текст, "документ") > 0
		ИЛИ СтрНайти(Текст, "накладн") > 0
		ИЛИ СтрНайти(Текст, "счет") > 0
		ИЛИ СтрНайти(Текст, "счёт") > 0
		ИЛИ СтрНайти(Текст, "акт") > 0
		ИЛИ СтрНайти(Текст, "упд") > 0
		ИЛИ СтрНайти(Текст, "invoice") > 0
		ИЛИ СтрНайти(Текст, "document") > 0;
КонецФункции

Функция ОпределитьFallbackОбъектЗаписи(ТекстЗадачи)
	Текст = ВРег(Строка(ТекстЗадачи));
	Если СтрНайти(Текст, "КОНТРАГЕНТ") > 0
		ИЛИ СтрНайти(Текст, "КЛИЕНТ") > 0
		ИЛИ СтрНайти(Текст, "ПОКУПАТЕЛ") > 0
		ИЛИ СтрНайти(Текст, "ПОСТАВЩИК") > 0 Тогда
		Возврат "Контрагенты";
	КонецЕсли;
	Возврат СокрЛП(Строка(ТекстЗадачи));
КонецФункции

Функция СоздатьFallbackПланЗаписиЧерезTools(Цель)
	План = СоздатьПустойTypedPlan(Цель);
	План.Вставить("source", "write_intent_fallback");
	ЦелевойОбъектЗаписи = ОпределитьFallbackОбъектЗаписи(Цель);
	ЭтоДокумент = ЭтоДокументноеWriteНамерение(Цель);
	ФильтрМетаданных = ?(ЭтоДокумент, Цель, ЦелевойОбъектЗаписи);
	
	ШагМетаданные = Новый Структура;
	ШагМетаданные.Вставить("id", "step_1");
	ШагМетаданные.Вставить("seq_no", 1);
	ШагМетаданные.Вставить("kind", "get_metadata");
	ШагМетаданные.Вставить("title", "Уточнить объект метаданных для записи");
	ШагМетаданные.Вставить("depends_on", Новый Массив);
	ШагМетаданные.Вставить("input", Новый Структура("filter", ФильтрМетаданных));
	ШагМетаданные.Вставить("status", "pending");
