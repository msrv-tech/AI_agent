Функция НормализоватьИмяОбъектаМетаданных(ИмяОбъекта, ТипОжидаемый = "")
	Возврат ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(ИмяОбъекта, ТипОжидаемый);
КонецФункции

Функция ОпределитьТипОбъектаМетаданных(ИмяОбъекта)

	Имя = Строка(ИмяОбъекта);
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Если ИИА_Метаданные.СуществуетДокумент(Имя) Тогда
			Возврат "Документ";
		КонецЕсли;
		Если ИИА_Метаданные.СуществуетСправочник(Имя) Тогда
			Возврат "Справочник";
		КонецЕсли;
		Если ИИА_Метаданные.СуществуетРегистрНакопления(Имя) Тогда
			Возврат "РегистрНакопления";
		КонецЕсли;
		Если ИИА_Метаданные.СуществуетРегистрСведений(Имя) Тогда
			Возврат "РегистрСведений";
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат "";

КонецФункции

Процедура ДобавитьВWhitelistПути(WhitelistПути, Путь)
	Если WhitelistПути = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛокПуть = СокрЛП(Строка(Путь));
	Если ПустаяСтрока(ЛокПуть) Тогда
		Возврат;
	КонецЕсли;
	Если WhitelistПути.Найти(ЛокПуть) = Неопределено Тогда
		WhitelistПути.Добавить(ЛокПуть);
	КонецЕсли;
КонецПроцедуры

Функция ЭтоСсылочныйТипРеквизита(СтрокаТипа)
	ТипВРег = ВРег(СокрЛП(СтрокаТипа));
	Возврат СтрНайти(ТипВРег, "СПРАВОЧНИКССЫЛКА.") > 0
		ИЛИ СтрНайти(ТипВРег, "ДОКУМЕНТССЫЛКА.") > 0
		ИЛИ СтрНайти(ТипВРег, "ПЕРЕЧИСЛЕНИЕССЫЛКА.") > 0;
КонецФункции

Функция СформироватьJSONСистемногоОтвета(Данные)
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Данные);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ТекстОшибки = СтрЗаменить(ТекстОшибки, """", "'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, Символы.ПС, " ");
		Возврат "{""kind"":""dsl_system_result"",""schema_version"":1,""success"":false,""error"":""Ошибка сериализации JSON: " + ТекстОшибки + """}";
	КонецПопытки;
	
КонецФункции

Функция РазрешитьИмяСправочника(ИсходноеИмяСправочника, КонтекстВыполнения = Неопределено) Экспорт
	Возврат ИИА_DSLQuerySafety.РазрешитьИмяСправочника(ИсходноеИмяСправочника, КонтекстВыполнения);
КонецФункции

Функция СериализоватьДляJSON(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка") Или 
	   ТипЗначения = Тип("Число") Или
	   ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;
	
	Если ТипЗначения = Тип("Массив") Тогда
		НовыйМассив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			НовыйМассив.Добавить(СериализоватьДляJSON(Элемент));
		КонецЦикла;
		Возврат НовыйМассив;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Структура") Тогда
		НоваяСтруктура = Новый Структура;
		Для Каждого ПараКлючЗначение Из Значение Цикл
			НоваяСтруктура.Вставить(ПараКлючЗначение.Ключ, СериализоватьДляJSON(ПараКлючЗначение.Значение));
		КонецЦикла;
		Возврат НоваяСтруктура;
	КонецЕсли;
	
	// Ссылочные типы
	Если (Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) 
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)) Тогда
		
		СтруктураСсылки = Новый Структура;
		СтруктураСсылки.Вставить("ref", Строка(Значение));
		
		Попытка
			СтруктураСсылки.Вставить("guid", Строка(Значение.УникальныйИдентификатор()));
		Исключение
			СтруктураСсылки.Вставить("guid", "");
		КонецПопытки;
		
		Попытка
			СтруктураСсылки.Вставить("meta_name", Значение.Метаданные().Имя);
		Исключение
			СтруктураСсылки.Вставить("meta_name", "");
		КонецПопытки;
		
		Возврат СтруктураСсылки;
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция СформироватьРезультатRunQuery(РезультатШага, ЛимитСтрок)
	
	ДанныеЗапроса = Новый Структура;
	Колонки = Новый Массив;
	Строки = Новый Массив;
	КоличествоСтрок = 0;
	
	Если РезультатШага.Свойство("КолонкиЗапроса") Тогда
		Колонки = РезультатШага.КолонкиЗапроса;
	КонецЕсли;
	
	Если РезультатШага.Свойство("Данные") И ТипЗнч(РезультатШага.Данные) = Тип("Массив") Тогда
		КоличествоСтрок = РезультатШага.Данные.Количество();
		
		МаксСтрок = ЛимитСтрок;
		Если КоличествоСтрок < МаксСтрок Тогда
			МаксСтрок = КоличествоСтрок;
		КонецЕсли;
		
		Для Индекс = 0 По МаксСтрок - 1 Цикл
			СтрокаДанных = РезультатШага.Данные[Индекс];
			Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
				СтруктураСтроки = Новый Структура;
				Для Каждого ПараКлючЗначение Из СтрокаДанных Цикл
					СтруктураСтроки.Вставить(ПараКлючЗначение.Ключ, СериализоватьДляJSON(ПараКлючЗначение.Значение));
				КонецЦикла;
				Строки.Добавить(СтруктураСтроки);
			Иначе
				Строки.Добавить(СериализоватьДляJSON(СтрокаДанных));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если РезультатШага.Свойство("КоличествоСтрок") Тогда
		Попытка
			КоличествоСтрок = Число(РезультатШага.КоличествоСтрок);
		Исключение
			// Оставляем количество по массиву данных, если значение пришло в неожиданном формате.
		КонецПопытки;
	КонецЕсли;
	
	ДанныеЗапроса.Вставить("row_count", КоличествоСтрок);
	ДанныеЗапроса.Вставить("truncated", КоличествоСтрок > ЛимитСтрок);
	ДанныеЗапроса.Вставить("rows_limit", ЛимитСтрок);
	ДанныеЗапроса.Вставить("columns", Колонки);
	ДанныеЗапроса.Вставить("rows", Строки);
	
	Возврат ДанныеЗапроса;
	
КонецФункции

Процедура УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, ТипОбъекта, ИмяОбъекта, ТекущийОбъект, ЭтоНовый = Неопределено)
	
	КонтекстВыполнения.Вставить("DSL_ТипОбъекта", ТипОбъекта);
	КонтекстВыполнения.Вставить("DSL_ИмяОбъекта", ИмяОбъекта);
	КонтекстВыполнения.Вставить("DSL_ТекущийОбъект", ТекущийОбъект);
	КонтекстВыполнения.Вставить("DSL_ИзмененныеПоля", Новый Структура);
	
	Если ЭтоНовый = Неопределено Тогда
		Попытка
			ЭтоНовый = НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка);
		Исключение
			ЭтоНовый = Истина;
		КонецПопытки;
	КонецЕсли;
	
	КонтекстВыполнения.Вставить("DSL_НовыйОбъект", ЭтоНовый);
	
КонецПроцедуры

Процедура ДобавитьИзмененноеПоле(КонтекстВыполнения, ИмяПоля, Значение)
	
	Если НЕ КонтекстВыполнения.Свойство("DSL_ИзмененныеПоля") Тогда
		КонтекстВыполнения.Вставить("DSL_ИзмененныеПоля", Новый Структура);
	КонецЕсли;
	
	КонтекстВыполнения.DSL_ИзмененныеПоля.Вставить(ИмяПоля, Значение);
	
КонецПроцедуры

Процедура ДобавитьЗаписьИзмененногоОбъекта(КонтекстВыполнения, МассивИзмененныхОбъектов, РежимЗаписи, РезультатЗаписи)
	
	Если НЕ КонтекстВыполнения.Свойство("DSL_ТекущийОбъект") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект = КонтекстВыполнения.DSL_ТекущийОбъект;
	
	ТипОбъекта = "Неизвестно";
	Если КонтекстВыполнения.Свойство("DSL_ТипОбъекта") Тогда
		ТипОбъекта = КонтекстВыполнения.DSL_ТипОбъекта;
	КонецЕсли;
	
	ИмяОбъекта = "";
	Если КонтекстВыполнения.Свойство("DSL_ИмяОбъекта") Тогда
		ИмяОбъекта = КонтекстВыполнения.DSL_ИмяОбъекта;
	КонецЕсли;
	
	ЭтоНовый = Ложь;
	Если КонтекстВыполнения.Свойство("DSL_НовыйОбъект") Тогда
		ЭтоНовый = КонтекстВыполнения.DSL_НовыйОбъект;
	КонецЕсли;
	
	СсылкаОбъекта = Неопределено;
	Попытка
		СсылкаОбъекта = ТекущийОбъект.Ссылка;
	Исключение
		// Игнорируем ошибки получения ссылки
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если (СсылкаОбъекта = Неопределено Или НЕ ЗначениеЗаполнено(СсылкаОбъекта)) И КонтекстВыполнения.Свойство("СсылкаОбъекта") Тогда
		СсылкаОбъекта = КонтекстВыполнения.СсылкаОбъекта;
	КонецЕсли;
	
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("object_type", ТипОбъекта);
	СтруктураОбъекта.Вставить("meta_name", ИмяОбъекта);
	СтруктураОбъекта.Вставить("ref", ?(ЗначениеЗаполнено(СсылкаОбъекта), Строка(СсылкаОбъекта), ""));
	
	Попытка
		Если ЗначениеЗаполнено(СсылкаОбъекта) Тогда
			СтруктураОбъекта.Вставить("guid", Строка(СсылкаОбъекта.УникальныйИдентификатор()));
		Иначе
			СтруктураОбъекта.Вставить("guid", "");
		КонецЕсли;
	Исключение
		СтруктураОбъекта.Вставить("guid", "");
	КонецПопытки;
	
	ИзмененныеПоля = Новый Структура;
	Если КонтекстВыполнения.Свойство("DSL_ИзмененныеПоля") Тогда
		Для Каждого ПараКлючЗначение Из КонтекстВыполнения.DSL_ИзмененныеПоля Цикл
			ИзмененныеПоля.Вставить(ПараКлючЗначение.Ключ, СериализоватьДляJSON(ПараКлючЗначение.Значение));
		КонецЦикла;
	КонецЕсли;
	
	ЗаписьИзменения = Новый Структура;
	ЗаписьИзменения.Вставить("operation", ?(ЭтоНовый, "create", "update"));
	ЗаписьИзменения.Вставить("write_mode", РежимЗаписи);
	ЗаписьИзменения.Вставить("object", СтруктураОбъекта);
	ЗаписьИзменения.Вставить("changed_fields", ИзмененныеПоля);
	ЗаписьИзменения.Вставить("write_result", Новый Структура("success, message", РезультатЗаписи.Успех, РезультатЗаписи.Сообщение));
	
	МассивИзмененныхОбъектов.Добавить(ЗаписьИзменения);
	
	Если РезультатЗаписи.Успех Тогда
		КонтекстВыполнения.Вставить("DSL_НовыйОбъект", Ложь);
		КонтекстВыполнения.Вставить("DSL_ИзмененныеПоля", Новый Структура);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает массив действий, которые только читают данные
//
// Возвращаемое значение:
//  Массив - массив строк с именами действий
//
// Валидирует шаг сценария
//
// Параметры:
//  Шаг - Структура - структура шага
//  НомерШага - Число - номер шага (для сообщений об ошибках)
//
// Возвращаемое значение:
//  Структура - структура результата валидации:
//   * Успех - Булево
//   * Сообщение - Строка
//
Функция ВалидироватьШаг(Шаг, НомерШага)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Сообщение", "");
	
	Действие = Шаг.action;
	
	Если Действие = "CreateReference" Тогда
		
		Если НЕ Шаг.Свойство("object_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": CreateReference требует поле object_name";
			Возврат Результат;
		КонецЕсли;
		
		ИмяСправочника = ИИА_DSLQuerySafety.РазрешитьИмяСправочника(Шаг.object_name);
		Если ПустаяСтрока(ИмяСправочника) Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": справочник '" + Шаг.object_name + "' не найден";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "CreateDocument" Тогда
		
		Если НЕ Шаг.Свойство("object_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": CreateDocument требует поле object_name";
			Возврат Результат;
		КонецЕсли;
		
		ИмяДокумента = ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(Шаг.object_name, "Документ");
		Если НЕ ИИА_Метаданные.СуществуетДокумент(ИмяДокумента) Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": документ '" + ИмяДокумента + "' не найден";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "FindReferenceByName" Тогда
		
		Если НЕ Шаг.Свойство("object_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": FindReferenceByName требует поле object_name";
			Возврат Результат;
		КонецЕсли;
		
		// Поддерживаем как name, так и value для обратной совместимости
		Если НЕ Шаг.Свойство("name") И НЕ Шаг.Свойство("value") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": FindReferenceByName требует поле name или value";
			Возврат Результат;
		КонецЕсли;
		
		ИмяСправочника = ИИА_DSLQuerySafety.РазрешитьИмяСправочника(Шаг.object_name);
		Если ПустаяСтрока(ИмяСправочника) Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": справочник '" + Шаг.object_name + "' не найден";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "FindReferenceByGUID" Тогда
		
		Если НЕ Шаг.Свойство("guid") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": FindReferenceByGUID требует поле guid";
			Возврат Результат;
		КонецЕсли;
		
		// object_name не обязателен, так как функция НайтиСсылкуПоУИД сама определяет тип объекта
		
	ИначеЕсли Действие = "FindReferenceByURL" Тогда
		
		Если НЕ Шаг.Свойство("url") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": FindReferenceByURL требует поле url";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "SetField" Тогда
		
		// Поддерживаем как field, так и field_name для обратной совместимости
		Если НЕ Шаг.Свойство("field") И НЕ Шаг.Свойство("field_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": SetField требует поле field или field_name";
			Возврат Результат;
		КонецЕсли;
		
		Если НЕ Шаг.Свойство("value") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": SetField требует поле value";
			Возврат Результат;
		КонецЕсли;

	ИначеЕсли Действие = "AddTableRow" Тогда

		Если НЕ Шаг.Свойство("table") И НЕ Шаг.Свойство("table_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": AddTableRow требует поле table или table_name";
			Возврат Результат;
		КонецЕсли;

		Если НЕ Шаг.Свойство("data") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": AddTableRow требует поле data";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "Write" Тогда
		
		// Write не требует дополнительных параметров
		// Записывает текущий объект, установленный через CreateReference, CreateDocument, FindReferenceByName, FindReferenceByGUID или FindReferenceByURL
		// Валидация успешна, если действие указано
		
	ИначеЕсли Действие = "RunQuery" Тогда
		
		Если НЕ Шаг.Свойство("query") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": RunQuery требует поле query";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "ShowInfo" Тогда
		
		Если НЕ Шаг.Свойство("message") Тогда
			Если Шаг.Свойство("title") И Шаг.Свойство("data") Тогда
				Шаг.Вставить("message", СокрЛП(Строка(Шаг.title)) + ": " + СокрЛП(Строка(Шаг.data)));
			ИначеЕсли Шаг.Свойство("title") Тогда
				Шаг.Вставить("message", СокрЛП(Строка(Шаг.title)));
			ИначеЕсли Шаг.Свойство("data") Тогда
				Шаг.Вставить("message", СокрЛП(Строка(Шаг.data)));
			Иначе
				Результат.Успех = Ложь;
				Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": ShowInfo требует поле message";
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Действие = "GetChangedObjects" Тогда
		
		// GetChangedObjects не требует дополнительных параметров
		// Получает ссылки из табличной части ИзмененныеОбъекты диалога
		// Валидация успешна, если действие указано
		
	ИначеЕсли Действие = "GetMetadata" Тогда
		
		// GetMetadata не требует дополнительных параметров
		// Получает списки всех объектов метаданных (справочники, документы, регистры)
		// Валидация успешна, если действие указано
		
	ИначеЕсли Действие = "GetObjectFields" Тогда
		
		Если НЕ Шаг.Свойство("object_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": GetObjectFields требует поле object_name";
			Возврат Результат;
		КонецЕсли;
		
		Если НЕ Шаг.Свойство("object_type") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": GetObjectFields требует поле object_type (Справочник, Документ, РегистрНакопления или РегистрСведений)";
			Возврат Результат;
		КонецЕсли;
		
		Если Шаг.object_type <> "Справочник" И Шаг.object_type <> "Документ" И Шаг.object_type <> "РегистрНакопления" И Шаг.object_type <> "РегистрСведений" Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": GetObjectFields.object_type должен быть 'Справочник', 'Документ', 'РегистрНакопления' или 'РегистрСведений'";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "CheckObjectExists" Тогда
		
		Если НЕ Шаг.Свойство("object_name") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": CheckObjectExists требует поле object_name";
			Возврат Результат;
		КонецЕсли;
		
		Если НЕ Шаг.Свойство("object_type") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": CheckObjectExists требует поле object_type (Справочник, Документ, РегистрНакопления или РегистрСведений)";
			Возврат Результат;
		КонецЕсли;
		
		Если Шаг.object_type <> "Справочник" И Шаг.object_type <> "Документ" И Шаг.object_type <> "РегистрНакопления" И Шаг.object_type <> "РегистрСведений" Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": CheckObjectExists.object_type должен быть 'Справочник', 'Документ', 'РегистрНакопления' или 'РегистрСведений'";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "SaveToStorage" Тогда
		
		Если НЕ Шаг.Свойство("key") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": SaveToStorage требует поле key";
			Возврат Результат;
		КонецЕсли;
		
		Если НЕ Шаг.Свойство("data") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": SaveToStorage требует поле data";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "LoadFromStorage" Тогда
		
		Если НЕ Шаг.Свойство("key") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": LoadFromStorage требует поле key";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли Действие = "ForEach" Тогда
		
		Если НЕ Шаг.Свойство("collection") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": ForEach требует поле collection";
			Возврат Результат;
		КонецЕсли;
		
		Если НЕ Шаг.Свойство("steps") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": ForEach требует поле steps (массив действий)";
			Возврат Результат;
		КонецЕсли;
		
		Если ТипЗнч(Шаг.steps) <> Тип("Массив") Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": поле steps в ForEach должно быть массивом";
			Возврат Результат;
		КонецЕсли;
		
		// Валидация вложенных шагов
		Для Индекс = 0 По Шаг.steps.Количество() - 1 Цикл
			ВнутреннийШаг = Шаг.steps[Индекс];
			ВнутреннийНомер = Строка(НомерШага) + "." + Формат(Индекс + 1, "ЧН=0");
			
			// Рекурсивная валидация, но с проверкой наличия поля action
			Если ТипЗнч(ВнутреннийШаг) <> Тип("Структура") Тогда
				Результат.Успех = Ложь;
				Результат.Сообщение = "Вложенный шаг " + ВнутреннийНомер + " должен быть объектом";
				Возврат Результат;
			КонецЕсли;
			
			Если НЕ ВнутреннийШаг.Свойство("action") Тогда
				Результат.Успех = Ложь;
				Результат.Сообщение = "Вложенный шаг " + ВнутреннийНомер + ": отсутствует поле action";
				Возврат Результат;
			КонецЕсли;
			
			РезультатВалидации = ВалидироватьШаг(ВнутреннийШаг, ВнутреннийНомер);
			Если НЕ РезультатВалидации.Успех Тогда
				Результат = РезультатВалидации;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Действие = "SelectObject" Тогда
		
		// Поддержка: reference/object ИЛИ object_type + object_name + name/value (для выбора по наименованию)
		Если Шаг.Свойство("reference") Или Шаг.Свойство("object") Тогда
			// Валидация пройдена
		ИначеЕсли Шаг.Свойство("object_type") И Шаг.Свойство("object_name") И (Шаг.Свойство("name") Или Шаг.Свойство("value")) Тогда
			// Альтернативный формат: поиск по наименованию (только для справочников)
			Если ВРег(Строка(Шаг.object_type)) <> "СПРАВОЧНИК" Тогда
				Результат.Успех = Ложь;
				Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": SelectObject с object_type+object_name+name поддерживает только object_type='Справочник'";
				Возврат Результат;
			КонецЕсли;
		ИмяСправочника = ИИА_DSLQuerySafety.РазрешитьИмяСправочника(Шаг.object_name);
		Если ПустаяСтрока(ИмяСправочника) Тогда
				Результат.Успех = Ложь;
				Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": справочник '" + Шаг.object_name + "' не найден";
				Возврат Результат;
			КонецЕсли;
		Иначе
			Результат.Успех = Ложь;
			Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": SelectObject требует поле reference, object или (object_type + object_name + name/value)";
			Возврат Результат;
		КонецЕсли;
		
	Иначе
		
		Результат.Успех = Ложь;
		Результат.Сообщение = "Шаг " + Формат(НомерШага, "ЧН=0") + ": неизвестное действие '" + Действие + "'";
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разрешает строковые параметры шага, содержащие шаблоны #(...)
//
// Параметры:
//  Шаг - Структура - исходный шаг
//  КонтекстВыполнения - Структура - контекст выполнения
//
// Возвращаемое значение:
//  Структура - шаг с разрешенными параметрами
//
Функция РазрешитьПараметрыШага(Шаг, КонтекстВыполнения)
	
	НовыйШаг = Новый Структура;
	
	Для Каждого КлючЗначение Из Шаг Цикл
		
		ИмяПараметра = КлючЗначение.Ключ;
		ЗначениеПараметра = КлючЗначение.Значение;
		
		// Пропускаем служебные поля и сложные структуры, которые обрабатываются отдельно
		Если ИмяПараметра = "action" 
			Или ИмяПараметра = "steps" // Для ForEach обрабатываем рекурсивно внутри ВыполнитьForEach
			Или ИмяПараметра = "parameters" // Для RunQuery обрабатывается внутри
			Тогда
			
			НовыйШаг.Вставить(ИмяПараметра, ЗначениеПараметра);
			
		ИначеЕсли ИмяПараметра = "data" И ТипЗнч(ЗначениеПараметра) = Тип("Структура") Тогда
			
			// Рекурсивно обрабатываем структуру data
			НоваяData = Новый Структура;
			Для Каждого КлючЗначениеData Из ЗначениеПараметра Цикл
				НоваяData.Вставить(КлючЗначениеData.Ключ, ОбработатьЗначениеПараметра(КлючЗначениеData.Значение, КонтекстВыполнения));
			КонецЦикла;
			НовыйШаг.Вставить("data", НоваяData);
			
		Иначе
			
			// Обрабатываем значение
			НовыйШаг.Вставить(ИмяПараметра, ОбработатьЗначениеПараметра(ЗначениеПараметра, КонтекстВыполнения));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НовыйШаг;
	
КонецФункции

// Выполняет один шаг сценария
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата выполнения:
//   * Успех - Булево
//   * Сообщение - Строка
//   * Данные - Произвольный - дополнительные данные результата
//
Функция ВыполнитьШаг(Шаг, КонтекстВыполнения) Экспорт
	
	ДействиеИсходное = ?(ТипЗнч(Шаг) = Тип("Структура") И Шаг.Свойство("action"), Строка(Шаг.action), "");
	Контракт = ИИА_DSLКонтракт.ПолучитьКонтрактДействия(ДействиеИсходное);
	Результат = СоздатьБазовыйРезультатШага(ДействиеИсходное, Контракт);
	
	// Разрешаем параметры перед выполнением (подстановка переменных контекста)
	ШагСПараметрами = РазрешитьПараметрыШага(Шаг, КонтекстВыполнения);
	Действие = ШагСПараметрами.action;
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(ШагСПараметрами);
	Если ПустаяСтрока(OperationId) И ИИА_DSLReplay.ЭтоWriteДействиеDSL(Действие) Тогда
		OperationId = ИИА_DSLReplay.СгенерироватьOperationIdДляDSL(Действие, КонтекстВыполнения);
		ШагСПараметрами.Вставить("operation_id", OperationId);
	КонецЕсли;
	Результат.operation_id = OperationId;
	
	Если Контракт = Неопределено Тогда
		Контракт = ИИА_DSLКонтракт.ПолучитьКонтрактДействия(Действие);
	КонецЕсли;
	
	Если Контракт <> Неопределено И НЕ Контракт.idempotent И НЕ Контракт.supports_safe_retries И ПустаяСтрока(OperationId) Тогда
		Результат.next_step_guidance = "Для безопасного повтора передай operation_id в этом шаге.";
		Результат.recommendation = "set_operation_id_for_safe_retries";
		Результат.suggested_action = "set_operation_id_for_safe_retries";
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(OperationId) Тогда
		ЗаписьОперации = ИИА_DSLReplay.ПолучитьРезультатОперации(КонтекстВыполнения, OperationId);
		Если ЗаписьОперации <> Неопределено И ТипЗнч(ЗаписьОперации) = Тип("Структура") И ЗаписьОперации.Свойство("result") Тогда
			Результат = ЗаписьОперации.result;
			ИИА_DSLReplay.НормализоватьРезультатШага(Результат, Действие, OperationId, Контракт);
			Результат.Вставить("deduplicated_retry", Истина);
			Если ПустаяСтрока(Результат.next_step_guidance) Тогда
				Результат.next_step_guidance = "Операция уже была выполнена ранее; использован сохранённый результат.";
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоРежимСимуляции(КонтекстВыполнения) Тогда
		Если ИИА_DSLКонтракт.ПолучитьДействияИзменения().Найти(Действие) <> Неопределено Тогда
			Результат.Успех = Истина;
			Результат.Сообщение = "SIMULATE: действие '" + Действие + "' валидировано без фиксации.";
			Результат.Вставить("ТипДействия", Действие);
			Результат.Вставить("Simulated", Истина);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		
		Если Действие = "CreateReference" Тогда
			
			Результат = ИИА_DSLActionWrite.ВыполнитьCreateReference(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "CreateDocument" Тогда
			
			Результат = ИИА_DSLActionWrite.ВыполнитьCreateDocument(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "FindReferenceByName" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьFindReferenceByName(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "FindReferenceByGUID" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьFindReferenceByGUID(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "FindReferenceByURL" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьFindReferenceByURL(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "SetField" Тогда
			
			Результат = ИИА_DSLActionWrite.ВыполнитьSetField(ШагСПараметрами, КонтекстВыполнения);

		ИначеЕсли Действие = "AddTableRow" Тогда

			Результат = ИИА_DSLActionWrite.ВыполнитьAddTableRow(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "Write" Тогда
			
			Результат = ИИА_DSLActionWrite.ВыполнитьWrite(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "RunQuery" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьRunQuery(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "ShowInfo" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьShowInfo(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "GetChangedObjects" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьGetChangedObjects(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "GetMetadata" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьGetMetadata(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "GetObjectFields" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьGetObjectFields(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "CheckObjectExists" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьCheckObjectExists(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "SaveToStorage" Тогда
			
			Результат = ИИА_DSLActionStorage.ВыполнитьSaveToStorage(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "LoadFromStorage" Тогда
			
			Результат = ИИА_DSLActionStorage.ВыполнитьLoadFromStorage(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "ForEach" Тогда
			
			Результат = ИИА_DSLActionStorage.ВыполнитьForEach(ШагСПараметрами, КонтекстВыполнения);
			
		ИначеЕсли Действие = "SelectObject" Тогда
			
			Результат = ИИА_DSLActionRead.ВыполнитьSelectObject(ШагСПараметрами, КонтекстВыполнения);
			
		Иначе
			
			Результат.Сообщение = "Неизвестное действие: " + Действие;
			
		КонецЕсли;
		
	Исключение
		
		Результат.Сообщение = "Ошибка выполнения шага '" + Действие + "': " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "step_runtime_error", "runtime", Истина, "retry_or_repair_dsl", Новый Структура("action", Действие));
		
	КонецПопытки;
	
	ИИА_DSLReplay.НормализоватьРезультатШага(Результат, Действие, OperationId, Контракт);
	
	Если Результат.Успех И НЕ ПустаяСтрока(OperationId) И Контракт <> Неопределено И (НЕ Контракт.idempotent ИЛИ НЕ Контракт.supports_safe_retries) Тогда
		ИИА_DSLReplay.ЗафиксироватьРезультатОперации(КонтекстВыполнения, OperationId, Действие, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие CreateReference
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьCreateReference(Шаг, КонтекстВыполнения)
	
	Результат = СоздатьБазовыйРезультатШага("CreateReference", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("CreateReference"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	
	ИмяСправочника = ИИА_DSLQuerySafety.РазрешитьИмяСправочника(Шаг.object_name, КонтекстВыполнения);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Результат.Сообщение = "Справочник '" + Шаг.object_name + "' не найден";
		УстановитьТипизированнуюОшибку(Результат, "object_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("object_type,object_name", "Справочник", Шаг.object_name));
		Возврат Результат;
	КонецЕсли;
	
	// Получаем менеджер справочника
	МенеджерСправочника = Справочники[ИмяСправочника];
	
	Если МенеджерСправочника = Неопределено Тогда
		Результат.Сообщение = "Не удалось получить менеджер справочника '" + ИмяСправочника + "'";
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_getmetadata", Новый Структура("object_type,object_name", "Справочник", ИмяСправочника));
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем, не указано ли наименование в data - если да, проверяем существование объекта в табличной части диалога
	НаименованиеДляПоиска = "";
	Если Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") И Шаг.data.Свойство("Наименование") Тогда
		НаименованиеДляПоиска = СокрЛП(Строка(Шаг.data.Наименование));
	КонецЕсли;
	
	// Если указано наименование и есть ссылка на диалог, проверяем наличие объекта в табличной части ИзмененныеОбъекты
	Если НЕ ПустаяСтрока(НаименованиеДляПоиска) И КонтекстВыполнения.Свойство("СсылкаДиалога") Тогда
		Попытка
			СсылкаДиалога = КонтекстВыполнения.СсылкаДиалога;
			Диалог = СсылкаДиалога.ПолучитьОбъект();
			
			// Ищем объект в табличной части ИзмененныеОбъекты с таким наименованием
			НайденОбъект = Ложь;
			Для Каждого СтрокаИзмененных Из Диалог.ИзмененныеОбъекты Цикл
				Попытка
					СсылкаОбъекта = СтрокаИзмененных.СсылкаНаОбъект;
					Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(СсылкаОбъекта)) Тогда
						МетаданныеОбъекта = СсылкаОбъекта.Метаданные();
						Если МетаданныеОбъекта.Имя = ИмяСправочника Тогда
							ОбъектДляПроверки = СсылкаОбъекта.ПолучитьОбъект();
							Если ОбъектДляПроверки <> Неопределено Тогда
								НаименованиеОбъекта = СокрЛП(Строка(ОбъектДляПроверки.Наименование));
								Если НаименованиеОбъекта = НаименованиеДляПоиска Тогда
									// Найден существующий элемент в диалоге
									НовыйЭлемент = ОбъектДляПроверки;
									Результат.Сообщение = "Найден существующий элемент справочника '" + ИмяСправочника + "' с наименованием '" + НаименованиеДляПоиска + "' в диалоге";
									НайденОбъект = Истина;
									Прервать;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				Исключение
					// Игнорируем ошибки при проверке
					ТекстОшибки = ОписаниеОшибки();
				КонецПопытки;
			КонецЦикла;
			
			Если НЕ НайденОбъект Тогда
				// Создаем новый элемент
				НовыйЭлемент = МенеджерСправочника.СоздатьЭлемент();
				Результат.Сообщение = "Создан элемент справочника '" + ИмяСправочника + "'";
			КонецЕсли;
		Исключение
			// Если не удалось проверить существование, создаем новый элемент
			НовыйЭлемент = МенеджерСправочника.СоздатьЭлемент();
			Результат.Сообщение = "Создан элемент справочника '" + ИмяСправочника + "'";
		КонецПопытки;
	Иначе
		// Создаем новый элемент
		НовыйЭлемент = МенеджерСправочника.СоздатьЭлемент();
		Результат.Сообщение = "Создан элемент справочника '" + ИмяСправочника + "'";
	КонецЕсли;
	
	// Сохраняем ссылку на созданный элемент в контексте выполнения
	// (для последующих шагов SetField)
	КонтекстВыполнения.Вставить("ТекущийОбъект", НовыйЭлемент);
	КонтекстВыполнения.Вставить("ТипОбъекта", "Справочник");
	КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяСправочника);
	УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Справочник", ИмяСправочника, НовыйЭлемент);
	
	// Если в шаге есть поле data, устанавливаем значения полей
	Если Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") Тогда
		
		Для Каждого ПараКлючЗначение Из Шаг.data Цикл
			
			ИмяПоля = ПараКлючЗначение.Ключ;
			ЗначениеПоля = ПараКлючЗначение.Значение;
			
			Попытка
				УстановитьЗначениеРеквизита(НовыйЭлемент, ИмяПоля, ЗначениеПоля);
				ДобавитьИзмененноеПоле(КонтекстВыполнения, ИмяПоля, ЗначениеПоля);
			Исключение
				Результат.Сообщение = "Ошибка установки поля '" + ИмяПоля + "': " + ОписаниеОшибки();
				УстановитьТипизированнуюОшибку(Результат, "field_write_error", "validation", Истина, "run_getobjectfields", Новый Структура("object_name,field", ИмяСправочника, ИмяПоля));
				Возврат Результат;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	// Сообщение уже установлено выше
	СсылкаОбъекта = НовыйЭлемент.Ссылка;
	Результат.Данные = СсылкаОбъекта;
	Результат.next_step_guidance = "Для безопасного повтора используй тот же operation_id; следующим шагом обычно идут SetField и Write.";
	// Сохраняем ссылку в контексте выполнения для последующего использования
	КонтекстВыполнения.Вставить("СсылкаОбъекта", СсылкаОбъекта);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "draft_created", "CreateReference", OperationId, Новый Структура("name", НаименованиеДляПоиска));
	// Добавляем ссылку в массив всех ссылок (будет добавлено в общий результат позже)
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие CreateDocument
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьCreateDocument(Шаг, КонтекстВыполнения)
	
	Результат = СоздатьБазовыйРезультатШага("CreateDocument", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("CreateDocument"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	
	ИмяДокумента = ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(Шаг.object_name, "Документ");
	
	// Получаем менеджер документа
	МенеджерДокумента = Документы[ИмяДокумента];
	
	Если МенеджерДокумента = Неопределено Тогда
		Результат.Сообщение = "Не удалось получить менеджер документа '" + ИмяДокумента + "'";
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_getmetadata", Новый Структура("object_type,object_name", "Документ", ИмяДокумента));
		Возврат Результат;
	КонецЕсли;
	
	// Создаем новый документ
	НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
	
	// Сохраняем ссылку на созданный документ в контексте выполнения
	КонтекстВыполнения.Вставить("ТекущийОбъект", НовыйДокумент);
	КонтекстВыполнения.Вставить("ТипОбъекта", "Документ");
	КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяДокумента);
	УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Документ", ИмяДокумента, НовыйДокумент);
	
	// Подготовка data: если в документе есть обязательный реквизит Дата и он не передан — подставляем ТекущаяДата()
	ДанныеДляУстановки = Новый Структура;
	Если Шаг.Свойство("data") И ТипЗнч(Шаг.data) = Тип("Структура") Тогда
		Для Каждого ПараКлючЗначение Из Шаг.data Цикл
			ДанныеДляУстановки.Вставить(ПараКлючЗначение.Ключ, ПараКлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Если НЕ ДанныеДляУстановки.Свойство("Дата") Тогда
		ИнформацияОДокументе = ИИА_Метаданные.ПолучитьРеквизитыДокумента(ИмяДокумента);
		Если ИнформацияОДокументе.Найден Тогда
			ЕстьДата = Ложь;
			Для Каждого Реквизит Из ИнформацияОДокументе.Реквизиты Цикл
				Если ТипЗнч(Реквизит) = Тип("Структура") И Реквизит.Свойство("Имя") И ВРег(Реквизит.Имя) = "ДАТА" Тогда
					ЕстьДата = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьДата Тогда
				ДанныеДляУстановки.Вставить("Дата", ТекущаяДата());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Устанавливаем значения полей
	Если ДанныеДляУстановки.Количество() > 0 Тогда
		
		Для Каждого ПараКлючЗначение Из ДанныеДляУстановки Цикл
			
			ИмяПоля = ПараКлючЗначение.Ключ;
			ЗначениеПоля = ПараКлючЗначение.Значение;
			
			Попытка
				УстановитьЗначениеРеквизита(НовыйДокумент, ИмяПоля, ЗначениеПоля);
				ДобавитьИзмененноеПоле(КонтекстВыполнения, ИмяПоля, ЗначениеПоля);
			Исключение
				Результат.Сообщение = "Ошибка установки поля '" + ИмяПоля + "': " + ОписаниеОшибки();
				УстановитьТипизированнуюОшибку(Результат, "field_write_error", "validation", Истина, "run_getobjectfields", Новый Структура("object_name,field", ИмяДокумента, ИмяПоля));
				Возврат Результат;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Сообщение = "Создан документ '" + ИмяДокумента + "'";
	СсылкаОбъекта = НовыйДокумент.Ссылка;
	Результат.Данные = СсылкаОбъекта;
	Результат.next_step_guidance = "Для безопасного повтора используй тот же operation_id; следующим шагом обычно идут SetField и Write.";
	// Сохраняем ссылку в контексте выполнения для последующего использования
	КонтекстВыполнения.Вставить("СсылкаОбъекта", СсылкаОбъекта);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "draft_created", "CreateDocument", OperationId, Новый Структура("data_fields_count", ДанныеДляУстановки.Количество()));
	// Добавляем ссылку в массив всех ссылок (будет добавлено в общий результат позже)
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие FindReferenceByName
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьFindReferenceByName(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	ИмяСправочника = ИИА_DSLQuerySafety.РазрешитьИмяСправочника(Шаг.object_name, КонтекстВыполнения);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Результат.Сообщение = "Справочник '" + Шаг.object_name + "' не найден";
		Возврат Результат;
	КонецЕсли;
	
	// Поддерживаем как name, так и value для обратной совместимости
	Если Шаг.Свойство("name") Тогда
		ИмяДляПоиска = Шаг.name;
	ИначеЕсли Шаг.Свойство("value") Тогда
		ИмяДляПоиска = Шаг.value;
	Иначе
		Результат.Сообщение = "Поле name или value не указано";
		Возврат Результат;
	КонецЕсли;
	
	// Получаем менеджер справочника
	МенеджерСправочника = Справочники[ИмяСправочника];
	
	Если МенеджерСправочника = Неопределено Тогда
		Результат.Сообщение = "Не удалось получить менеджер справочника '" + ИмяСправочника + "'";
		Возврат Результат;
	КонецЕсли;
	
	// Ищем по наименованию
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Элементы.Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Элементы
	|ГДЕ
	|	Элементы.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", ИмяДляПоиска);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат.Сообщение = "Элемент справочника '" + ИмяСправочника + "' с наименованием '" + ИмяДляПоиска + "' не найден";
		Возврат Результат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	НайденнаяСсылка = Выборка.Ссылка;
	
	// Сохраняем найденный элемент в контексте выполнения
	КонтекстВыполнения.Вставить("ТекущийОбъект", НайденнаяСсылка.ПолучитьОбъект());
	КонтекстВыполнения.Вставить("ТипОбъекта", "Справочник");
	КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяСправочника);
	УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, "Справочник", ИмяСправочника, КонтекстВыполнения.ТекущийОбъект, Ложь);
	
	Результат.Успех = Истина;
	Результат.Сообщение = "Найден элемент справочника '" + ИмяСправочника + "' с наименованием '" + ИмяДляПоиска + "'";
	Результат.Данные = НайденнаяСсылка;
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие FindReferenceByGUID
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьFindReferenceByGUID(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	УИДДляПоиска = Шаг.guid;
	
	// Используем функцию НайтиСсылкуПоУИД для поиска объекта
	НайденнаяСсылка = НайтиСсылкуПоУИД(УИДДляПоиска);
	
	Если НайденнаяСсылка = Неопределено Тогда
		Результат.Сообщение = "Объект с УИД '" + УИДДляПоиска + "' не найден";
		Возврат Результат;
	КонецЕсли;
	
	// Определяем тип объекта и его имя
	ТипОбъекта = "";
	ИмяОбъекта = "";
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НайденнаяСсылка)) Тогда
		ТипОбъекта = "Справочник";
		ИмяОбъекта = НайденнаяСсылка.Метаданные().Имя;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(НайденнаяСсылка)) Тогда
		ТипОбъекта = "Документ";
		ИмяОбъекта = НайденнаяСсылка.Метаданные().Имя;
	Иначе
		Результат.Сообщение = "Найден объект с УИД '" + УИДДляПоиска + "', но его тип не поддерживается";
		Возврат Результат;
	КонецЕсли;
	
	// Сохраняем найденный элемент в контексте выполнения
	КонтекстВыполнения.Вставить("ТекущийОбъект", НайденнаяСсылка.ПолучитьОбъект());
	КонтекстВыполнения.Вставить("ТипОбъекта", ТипОбъекта);
	КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяОбъекта);
	УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, ТипОбъекта, ИмяОбъекта, КонтекстВыполнения.ТекущийОбъект, Ложь);
	
	Результат.Успех = Истина;
	Результат.Сообщение = "Найден объект '" + ИмяОбъекта + "' (тип: " + ТипОбъекта + ") с УИД '" + УИДДляПоиска + "'";
	Результат.Данные = НайденнаяСсылка;
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие FindReferenceByURL
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьFindReferenceByURL(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	URLДляПоиска = Шаг.url;
	
	Попытка
		// Парсим навигационную ссылку
		// Формат: "e1cib/data/Справочник.Контрагенты?ref=УИД" или "e1cib/data/Документ.ЗаказКлиента?ref=УИД"
		
		ИмяОбъекта = "";
		ТипОбъекта = "";
		УИДОбъекта = "";
		
		// Определяем тип объекта (Справочник или Документ)
		Если СтрНайти(URLДляПоиска, "Справочник.") > 0 Тогда
			ТипОбъекта = "Справочник";
			НачалоИмени = СтрНайти(URLДляПоиска, "Справочник.") + 12;
			КонецИмени = СтрНайти(URLДляПоиска, "?", НаправлениеПоиска.СНачала, НачалоИмени);
			Если КонецИмени = 0 Тогда
				КонецИмени = СтрДлина(URLДляПоиска) + 1;
			КонецЕсли;
			ИмяОбъекта = Сред(URLДляПоиска, НачалоИмени, КонецИмени - НачалоИмени);
		ИначеЕсли СтрНайти(URLДляПоиска, "Документ.") > 0 Тогда
			ТипОбъекта = "Документ";
			НачалоИмени = СтрНайти(URLДляПоиска, "Документ.") + 9;
			КонецИмени = СтрНайти(URLДляПоиска, "?", НаправлениеПоиска.СНачала, НачалоИмени);
			Если КонецИмени = 0 Тогда
				КонецИмени = СтрДлина(URLДляПоиска) + 1;
			КонецЕсли;
			ИмяОбъекта = Сред(URLДляПоиска, НачалоИмени, КонецИмени - НачалоИмени);
		Иначе
			Результат.Сообщение = "Не удалось определить тип объекта из URL (ожидается Справочник. или Документ.)";
			Возврат Результат;
		КонецЕсли;
		
		// Извлекаем УИД из параметра ref=
		ПозицияRef = СтрНайти(URLДляПоиска, "ref=");
		Если ПозицияRef > 0 Тогда
			УИДОбъекта = Сред(URLДляПоиска, ПозицияRef + 4);
			// Убираем параметры после &
			ПозицияАмперсанда = СтрНайти(УИДОбъекта, "&");
			Если ПозицияАмперсанда > 0 Тогда
				УИДОбъекта = Лев(УИДОбъекта, ПозицияАмперсанда - 1);
			КонецЕсли;
			// Декодируем URL-кодирование
			УИДОбъекта = СтрЗаменить(УИДОбъекта, "%20", " ");
			УИДОбъекта = СтрЗаменить(УИДОбъекта, "%3D", "=");
		Иначе
			Результат.Сообщение = "Не найден параметр ref= в навигационной ссылке";
			Возврат Результат;
		КонецЕсли;
		
		// Ищем объект по УИД используя функцию НайтиСсылкуПоУИД
		НайденнаяСсылка = НайтиСсылкуПоУИД(УИДОбъекта);
		
		Если НайденнаяСсылка = Неопределено Тогда
			Результат.Сообщение = "Объект с УИД '" + УИДОбъекта + "' не найден";
			Возврат Результат;
		КонецЕсли;
		
		// Определяем тип объекта и его имя из найденной ссылки
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НайденнаяСсылка)) Тогда
			ТипОбъекта = "Справочник";
			ИмяОбъекта = НайденнаяСсылка.Метаданные().Имя;
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(НайденнаяСсылка)) Тогда
			ТипОбъекта = "Документ";
			ИмяОбъекта = НайденнаяСсылка.Метаданные().Имя;
		Иначе
			Результат.Сообщение = "Найден объект с УИД '" + УИДОбъекта + "', но его тип не поддерживается";
			Возврат Результат;
		КонецЕсли;
		
		// Сохраняем найденный элемент в контексте выполнения
		КонтекстВыполнения.Вставить("ТекущийОбъект", НайденнаяСсылка.ПолучитьОбъект());
		КонтекстВыполнения.Вставить("ТипОбъекта", ТипОбъекта);
		КонтекстВыполнения.Вставить("ИмяОбъекта", ИмяОбъекта);
		УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, ТипОбъекта, ИмяОбъекта, КонтекстВыполнения.ТекущийОбъект, Ложь);
		
		Результат.Успех = Истина;
		Результат.Сообщение = "Найден объект '" + ИмяОбъекта + "' по навигационной ссылке (УИД: " + УИДОбъекта + ")";
		Результат.Данные = НайденнаяСсылка;
		
	Исключение
		Результат.Сообщение = "Ошибка при поиске объекта по URL: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие SetField
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьSetField(Шаг, КонтекстВыполнения)
	
	Результат = СоздатьБазовыйРезультатШага("SetField", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("SetField"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	
	// Проверяем наличие текущего объекта в контексте
	Если НЕ КонтекстВыполнения.Свойство("ТекущийОбъект") Тогда
		Результат.Сообщение = "Нет текущего объекта для установки поля. Используйте CreateReference, CreateDocument или FindReferenceByName перед SetField";
		УстановитьТипизированнуюОшибку(Результат, "missing_object_context", "validation", Ложь, "select_or_create_object_first", Новый Структура("action", "SetField"));
		Возврат Результат;
	КонецЕсли;
	
	ТекущийОбъект = КонтекстВыполнения.ТекущийОбъект;
	ТипОбъекта = КонтекстВыполнения.ТипОбъекта;
	ИмяОбъекта = КонтекстВыполнения.ИмяОбъекта;
	
	// Поддерживаем как field, так и field_name для обратной совместимости
	Если Шаг.Свойство("field") Тогда
		ИмяПоля = Шаг.field;
	ИначеЕсли Шаг.Свойство("field_name") Тогда
		ИмяПоля = Шаг.field_name;
	Иначе
		Результат.Сообщение = "Поле field или field_name не указано";
		Результат.missing_parameters.Добавить("field");
		УстановитьТипизированнуюОшибку(Результат, "parameter_missing", "validation", Ложь, "provide_field_name", Новый Структура("action", "SetField"));
		Возврат Результат;
	КонецЕсли;
	
	// Автоматическое исправление распространенных ошибок в именах реквизитов
	Если ИмяПоля = "ПометкаНаУдаление" Тогда
		ИмяПоля = "ПометкаУдаления";
	ИначеЕсли ИмяПоля = "Description" Тогда
		ИмяПоля = "Наименование";
	КонецЕсли;
	
	Значение = Шаг.value;
	
	// Проверяем существование реквизита
	Если ТипОбъекта = "Справочник" Тогда
		
		Если НЕ ИИА_Метаданные.СуществуетРеквизитСправочника(ИмяОбъекта, ИмяПоля) Тогда
			Результат.Сообщение = "Реквизит '" + ИмяПоля + "' не найден в справочнике '" + ИмяОбъекта + "'";
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		
		Если НЕ ИИА_Метаданные.СуществуетРеквизитДокумента(ИмяОбъекта, ИмяПоля) Тогда
			Результат.Сообщение = "Реквизит '" + ИмяПоля + "' не найден в документе '" + ИмяОбъекта + "'";
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	// Устанавливаем значение поля
	Попытка
		
		УстановитьЗначениеРеквизита(ТекущийОбъект, ИмяПоля, Значение);
		ДобавитьИзмененноеПоле(КонтекстВыполнения, ИмяПоля, Значение);
		
	Исключение
		
		Результат.Сообщение = "Ошибка установки значения поля '" + ИмяПоля + "': " + ОписаниеОшибки();
		Возврат Результат;
		
	КонецПопытки;
	
	// Если устанавливается Наименование и объект еще не записан (новый), проверяем наличие в табличной части диалога
	Если ИмяПоля = "Наименование" И ТипОбъекта = "Справочник" И КонтекстВыполнения.Свойство("СсылкаДиалога") Тогда
		Попытка
			// Проверяем, записан ли объект (если ссылка пустая - объект новый)
			СсылкаТекущегоОбъекта = ТекущийОбъект.Ссылка;
			Если НЕ ЗначениеЗаполнено(СсылкаТекущегоОбъекта) Тогда
				// Объект еще не записан - проверяем наличие в табличной части диалога
				СсылкаДиалога = КонтекстВыполнения.СсылкаДиалога;
				Диалог = СсылкаДиалога.ПолучитьОбъект();
				
				НаименованиеДляПоиска = СокрЛП(Строка(Значение));
				
				// Ищем объект в табличной части ИзмененныеОбъекты с таким наименованием
				Для Каждого СтрокаИзмененных Из Диалог.ИзмененныеОбъекты Цикл
					Попытка
						СсылкаОбъекта = СтрокаИзмененных.СсылкаНаОбъект;
						Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(СсылкаОбъекта)) Тогда
							МетаданныеОбъекта = СсылкаОбъекта.Метаданные();
							Если МетаданныеОбъекта.Имя = ИмяОбъекта Тогда
								ОбъектДляПроверки = СсылкаОбъекта.ПолучитьОбъект();
								Если ОбъектДляПроверки <> Неопределено Тогда
									НаименованиеОбъекта = СокрЛП(Строка(ОбъектДляПроверки.Наименование));
									Если НаименованиеОбъекта = НаименованиеДляПоиска Тогда
										// Найден существующий элемент в диалоге - используем его
										КонтекстВыполнения.Вставить("ТекущийОбъект", ОбъектДляПроверки);
										Результат.Сообщение = "Найден существующий элемент справочника '" + ИмяОбъекта + "' с наименованием '" + НаименованиеДляПоиска + "' в диалоге. Используется существующий объект.";
										Прервать;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					Исключение
						// Игнорируем ошибки при проверке
						ТекстОшибки = ОписаниеОшибки();
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
		Исключение
			// Если не удалось проверить, продолжаем с текущим объектом
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Если ПустаяСтрока(Результат.Сообщение) Тогда
		Результат.Сообщение = "Установлено значение поля '" + ИмяПоля + "'";
	КонецЕсли;
	Результат.next_step_guidance = "Для фиксации изменения обычно выполни Write. Для безопасного повтора используй тот же operation_id.";
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "field_set", "SetField", OperationId, Новый Структура("field,value_preview", ИмяПоля, Лев(Строка(СериализоватьДляJSON(Значение)), 200)));
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие Write
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьWrite(Шаг, КонтекстВыполнения)
	
	Результат = СоздатьБазовыйРезультатШага("Write", ИИА_DSLКонтракт.ПолучитьКонтрактДействия("Write"));
	OperationId = ИИА_DSLReplay.ПолучитьOperationIdШага(Шаг);
	Результат.operation_id = OperationId;
	
	// Проверяем наличие текущего объекта в контексте
	Если НЕ КонтекстВыполнения.Свойство("ТекущийОбъект") Тогда
		Результат.Сообщение = "Нет текущего объекта для записи. Используйте CreateReference, CreateDocument или FindReferenceByName перед Write";
		УстановитьТипизированнуюОшибку(Результат, "missing_object_context", "validation", Ложь, "select_or_create_object_first", Новый Структура("action", "Write"));
		Возврат Результат;
	КонецЕсли;
	
	ТекущийОбъект = КонтекстВыполнения.ТекущийОбъект;
	
	// Записываем объект
	Попытка
		
		ТекущийОбъект.Записать();
		
	Исключение
		
		Результат.Сообщение = "Ошибка записи объекта: " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "write_failed", "runtime", Истина, "retry_write_with_same_operation_id", Новый Структура("action", "Write"));
		Возврат Результат;
		
	КонецПопытки;
	
	Результат.Успех = Истина;
	Результат.Сообщение = "Объект успешно записан";
	СсылкаОбъекта = ТекущийОбъект.Ссылка;
	Результат.Данные = СсылкаОбъекта;
	Результат.next_step_guidance = "Повторяй Write только с тем же operation_id. После успешной записи можно переходить к ShowInfo или следующему объекту.";
	// Сохраняем ссылку в контексте выполнения для последующего использования
	КонтекстВыполнения.Вставить("СсылкаОбъекта", СсылкаОбъекта);
	ИИА_DSLReplay.ДобавитьЗаписьВСайдЭффектЛогИзDSL(КонтекстВыполнения, "object_written", "Write", OperationId);
	// Добавляем ссылку в массив всех ссылок (будет добавлено в общий результат позже)
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие RunQuery
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьRunQuery(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	ТекстЗапроса = Шаг.query;
	ТекстЗапросаИсходный = ТекстЗапроса;
	
	// --- АВТОКОРРЕКЦИЯ И ВАЛИДАЦИЯ ЗАПРОСА ---
	
	// 1. Исправляем распространенную ошибку ИИ: использование &"Литерал" или &«Литерал»
	// Также нормализуем кавычки, превращая их в стандартные двойные
	
	// Заменяем все нестандартные кавычки на стандартные двойные
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "«", """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "»", """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "“", """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "”", """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символ(171), """"); // «
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символ(187), """"); // »
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "'", """");
	ТекстЗапроса = НормализоватьПробелыВТекстеЗапроса(ТекстЗапроса);
	
	// Удаляем амперсанд перед кавычками (теперь все кавычки стандартные)
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&""", """");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "& """, """");
	// Убираем часто навязанный ИИ alias Объект. Для Query Safety Gate и типовых запросов
	// достаточно простых имен полей, а alias приводит к ложным whitelist-ошибкам.
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Объект.", "");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "объект.", "");
	ТекстЗапроса = ИсправитьПоложениеПервыеВЗапросе(ТекстЗапроса);
	
	// 1.1. Исправляем попытки использования #(Value) для констант (галлюцинация ИИ)
	// Если внутри #(...) только цифры, заменяем на эти цифры
	ПозНачала = СтрНайти(ТекстЗапроса, "#(");
	Пока ПозНачала > 0 Цикл
		ПозКонца = СтрНайти(ТекстЗапроса, ")", НаправлениеПоиска.СНачала, ПозНачала);
		Если ПозКонца > ПозНачала Тогда
			Содержимое = Сред(ТекстЗапроса, ПозНачала + 2, ПозКонца - ПозНачала - 2);
			// Проверяем, является ли содержимое числом
			ЯвляетсяЧислом = Истина;
			Для ИндексСимвола = 1 По СтрДлина(Содержимое) Цикл
				Символ = Сред(Содержимое, ИндексСимвола, 1);
				Если СтрНайти("0123456789.,", Символ) = 0 Тогда
					ЯвляетсяЧислом = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЯвляетсяЧислом Тогда
				ТекстЗапроса = Лев(ТекстЗапроса, ПозНачала - 1) + Содержимое + Сред(ТекстЗапроса, ПозКонца + 1);
				// Ищем следующее с новой позиции
				ПозНачала = СтрНайти(ТекстЗапроса, "#(", НаправлениеПоиска.СНачала, ПозНачала);
			Иначе
				// Пропускаем, это может быть переменная
				ПозНачала = СтрНайти(ТекстЗапроса, "#(", НаправлениеПоиска.СНачала, ПозКонца);
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// 1.2. Автокоррекция ДОБАВИТЬКДАТЕ: LLM часто путает порядок параметров
	// Неправильно: ДОБАВИТЬКДАТЕ(Дата, -7, ДЕНЬ)  →  Правильно: ДОБАВИТЬКДАТЕ(Дата, ДЕНЬ, -7)
	ТекстЗапроса = ИсправитьПорядокДобавитьКДате(ТекстЗапроса);

	ТекстЗапросаВерхний = ВРег(ТекстЗапроса);
	ТекстБезПробелов = СтрЗаменить(ТекстЗапросаВерхний, " ", ""); // Для проверки функций без учета пробелов
	
	// 2. Проверка на использование недопустимых функций в запросе
	// Проверяем наличие скобки после имени функции, чтобы не реагировать на имена полей
	Если СтрНайти(ТекстБезПробелов, "СТРНАЙТИ(") > 0 
		ИЛИ СтрНайти(ТекстБезПробелов, "STRFIND(") > 0 
		ИЛИ СтрНайти(ТекстБезПробелов, "СТРНАЧИНАЕТСЯС(") > 0 
		ИЛИ СтрНайти(ТекстБезПробелов, "STRSTARTSWITH(") > 0 
		ИЛИ СтрНайти(ТекстБезПробелов, "ПОДОБИЕ(") > 0 
		ИЛИ СтрНайти(ТекстБезПробелов, "SIMILARITY(") > 0 
		ИЛИ СтрНайти(ТекстБезПробелов, "НАЙТИ(") > 0 Тогда 
		
		Результат.Сообщение = "Ошибка: Использована недопустимая функция в запросе (СтрНайти, СтрНачинаетсяС, Подобие и др.). В языке запросов 1С для поиска строк используйте ТОЛЬКО оператор ПОДОБНО (LIKE). Пример: ГДЕ Наименование ПОДОБНО ""%Сидоров%""";
		УстановитьТипизированнуюОшибку(Результат, "query_safety_violation", "safety", Истина, "rewrite_query_with_like", Новый Структура("reason", "forbidden_functions"));
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем, что запрос не содержит опасных операций
	// (только SELECT разрешен)
	ТекстЗапросаВерхний = ВРег(ТекстЗапроса);
	
	Если СтрНайти(ТекстЗапросаВерхний, "ИЗМЕНИТЬ") > 0 
		ИЛИ СтрНайти(ТекстЗапросаВерхний, "УДАЛИТЬ") > 0 
		ИЛИ СтрНайти(ТекстЗапросаВерхний, "ВСТАВИТЬ") > 0 
		ИЛИ СтрНайти(ТекстЗапросаВерхний, "ОБНОВИТЬ") > 0 Тогда
		
		Результат.Сообщение = "Запрос содержит операции модификации данных. Разрешены только SELECT запросы";
		УстановитьТипизированнуюОшибку(Результат, "query_safety_violation", "safety", Истина, "use_select_only", Новый Структура("reason", "mutating_operations"));
		Возврат Результат;
		
	КонецЕсли;
	
	// Сохраняем фактически выполняемый текст запроса для логов/контекста
	Результат.Вставить("ExecutedQuery", ТекстЗапроса);
	Результат.Вставить("QueryNormalized", (ТекстЗапросаИсходный <> ТекстЗапроса));
	
	// --- ВАЛИДАЦИЯ СУЩЕСТВОВАНИЯ ТАБЛИЦ ---
	// Извлекаем имена таблиц из запроса (упрощенно)
	// Ищем паттерны "ИЗ Справочник.Имя", "ИЗ Документ.Имя" и т.д.
	ПозИЗ = СтрНайти(ТекстЗапросаВерхний, " ИЗ ");
	Если ПозИЗ = 0 Тогда
		ПозИЗ = СтрНайти(ТекстЗапросаВерхний, Символы.ПС + "ИЗ ");
	КонецЕсли;
	
	Если ПозИЗ > 0 Тогда
		ЧастьПослеИЗ = Сред(ТекстЗапросаВерхний, ПозИЗ + 4);
		// Берем первое слово после ИЗ
		МассивСлов = СтрРазделить(ЧастьПослеИЗ, " " + Символы.ПС + Символы.Таб + ",", Ложь);
		Если МассивСлов.Количество() > 0 Тогда
			ИмяТаблицы = МассивСлов[0];
			Если СтрНайти(ИмяТаблицы, ".") > 0 Тогда
				МассивЧастей = СтрРазделить(ИмяТаблицы, ".");
				ТипОбъекта = МассивЧастей[0];
				ИмяОбъекта = МассивЧастей[1];
				
				// ПРОВЕРКА НА ПОВТОРНУЮ ОШИБКУ (Блокировка зацикливания)
				Ненайденные = "";
				Если КонтекстВыполнения.Свойство("НенайденныеОбъекты", Ненайденные) И НЕ ПустаяСтрока(Ненайденные) Тогда
					Если СтрНайти(ВРег(Ненайденные), ВРег(ИмяОбъекта)) > 0 Тогда
						Результат.Сообщение = "КРИТИЧЕСКАЯ ОШИБКА: Ты снова пытаешься использовать объект '" + ИмяОбъекта + "', хотя ранее было подтверждено, что его НЕТ в базе. " +
							"ПРЕКРАТИ использовать это имя. Посмотри результаты GetMetadata и выбери другое имя из списка!";
						Возврат Результат;
					КонецЕсли;
				КонецЕсли;
				
				ОбъектСуществует = Истина;
				Если ТипОбъекта = "СПРАВОЧНИК" Тогда
					ОбъектСуществует = ИИА_Метаданные.СуществуетСправочник(ИмяОбъекта);
				ИначеЕсли ТипОбъекта = "ДОКУМЕНТ" Тогда
					ОбъектСуществует = ИИА_Метаданные.СуществуетДокумент(ИмяОбъекта);
				КонецЕсли;
				
				Если НЕ ОбъектСуществует Тогда
					Результат.Сообщение = "Ошибка: Таблица '" + ИмяТаблицы + "' не найдена в метаданных. " + 
						"Пожалуйста, используйте действие GetMetadata с фильтром для поиска правильного имени объекта.";
					Результат.Вставить("table_name", ИмяТаблицы);
					Результат.Вставить("object_type", ТипОбъекта);
					Результат.Вставить("object_name", ИмяОбъекта);
					УстановитьТипизированнуюОшибку(Результат, "table_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("table_name,object_type,object_name", ИмяТаблицы, ТипОбъекта, ИмяОбъекта));
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// --- ВАЛИДАЦИЯ ПАРАМЕТРОВ: даты не должны передаваться через &Parameters ---
	ИменаДатовыхПараметров = ",ДАТАНАЧАЛА,ДАТАОКОНЧАНИЯ,ДАТАКОНЦА,НАЧАЛОПЕРИОДА,КОНЕЦПЕРИОДА,НАЧДАТА,КОНДАТА,ДАТАНАЧ,ДАТАКОН,STARTDATE,ENDDATE,";
	ПозАмперсанд = СтрНайти(ТекстЗапросаВерхний, "&");
	Пока ПозАмперсанд > 0 Цикл
		// Извлекаем имя параметра после &
		ИмяПараметра = "";
		Для ИндСим = ПозАмперсанд + 1 По СтрДлина(ТекстЗапросаВерхний) Цикл
			Сим = Сред(ТекстЗапросаВерхний, ИндСим, 1);
			Если СтрНайти("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789", Сим) > 0 Тогда
				ИмяПараметра = ИмяПараметра + Сим;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ИмяПараметра) И СтрНайти(ИменаДатовыхПараметров, "," + ВРег(ИмяПараметра) + ",") > 0 Тогда
			// Проверяем, задан ли этот параметр в Шаг.parameters
			ПараметрЗадан = Ложь;
			Если Шаг.Свойство("parameters") И Шаг.parameters <> Неопределено Тогда
				Если ТипЗнч(Шаг.parameters) = Тип("Структура") Тогда
					ПараметрЗадан = Шаг.parameters.Свойство(ИмяПараметра);
				ИначеЕсли ТипЗнч(Шаг.parameters) = Тип("Массив") Тогда
					Для Каждого Элемент Из Шаг.parameters Цикл
						Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство(ИмяПараметра) Тогда
							ПараметрЗадан = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ПараметрЗадан Тогда
				Результат.Сообщение = "Ошибка: Параметр &" + ИмяПараметра + " не задан. " +
					"ЗАПРЕЩЕНО передавать даты через parameters. " +
					"Используй ДАТАВРЕМЯ(год,месяц,день,час,минута,сек) прямо в тексте запроса. " +
					"Пример: ГДЕ Период >= ДАТАВРЕМЯ(2025,1,1,0,0,0)";
				УстановитьТипизированнуюОшибку(Результат, "parameter_missing", "validation", Истина, "use_datetime_literal", Новый Структура("parameter", ИмяПараметра));
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		ПозАмперсанд = СтрНайти(ТекстЗапросаВерхний, "&", НаправлениеПоиска.СНачала, ПозАмперсанд + 1);
	КонецЦикла;
	
	ПроверкаGate = ИИА_DSLQuerySafety.ПроверитьQuerySafetyGate(ТекстЗапроса, КонтекстВыполнения);
	Если НЕ ПроверкаGate.Успех Тогда
		Результат.Сообщение = ПроверкаGate.Сообщение;
		УстановитьТипизированнуюОшибку(Результат, ПроверкаGate.КодОшибки, "safety", Истина, "run_getobjectfields_then_retry", ПроверкаGate.Контекст);
		Возврат Результат;
	КонецЕсли;
	
	// Выполняем запрос
	Попытка
		
		Запрос = Новый Запрос(ТекстЗапроса);
		
		// Установка параметров запроса
		Если Шаг.Свойство("parameters") И Шаг.parameters <> Неопределено Тогда
			
			// Если parameters - массив (обычно массив структур с одним ключом), преобразуем его в одну структуру
			Если ТипЗнч(Шаг.parameters) = Тип("Массив") Тогда
				Для Каждого ПараметрСтруктура Из Шаг.parameters Цикл
					Если ТипЗнч(ПараметрСтруктура) = Тип("Структура") Тогда
						Для Каждого КлючЗначение Из ПараметрСтруктура Цикл
							ЗначениеПараметра = ОбработатьЗначениеПараметра(КлючЗначение.Значение, КонтекстВыполнения);
							Запрос.УстановитьПараметр(КлючЗначение.Ключ, ЗначениеПараметра);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			// Если parameters - структура
			ИначеЕсли ТипЗнч(Шаг.parameters) = Тип("Структура") Тогда
				Для Каждого КлючЗначение Из Шаг.parameters Цикл
					ЗначениеПараметра = ОбработатьЗначениеПараметра(КлючЗначение.Значение, КонтекстВыполнения);
					Запрос.УстановитьПараметр(КлючЗначение.Ключ, ЗначениеПараметра);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;

		РезультатЗапроса = Запрос.Выполнить();
		
		// Сохраняем результат запроса для создания табличного документа на клиенте
		// (табличный документ нельзя передать между клиентом и сервером)
		КонтекстВыполнения.Вставить("РезультатЗапросаДляТаблицы", РезультатЗапроса);
		
		// Преобразуем результат в таблицу значений для совместимости
		ТаблицаРезультатов = РезультатЗапроса.Выгрузить();
		
		МассивКолонок = Новый Массив;
		Для Каждого Колонка Из ТаблицаРезультатов.Колонки Цикл
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЦикла;
		
		// Преобразуем таблицу значений в массив структур для передачи между клиентом и сервером
		МассивРезультатов = Новый Массив;
		Для Каждого СтрокаТаблицы Из ТаблицаРезультатов Цикл
			СтруктураСтроки = Новый Структура;
			НайденаСсылка = Ложь;
			УИДИзСсылки = "";
			Для Каждого Колонка Из ТаблицаРезультатов.Колонки Цикл
				Попытка
					ЗначениеКолонки = СтрокаТаблицы[Колонка.Имя];
					
					// Преобразуем значения в сериализуемые типы
					Если ЗначениеКолонки = Неопределено Тогда
						СтруктураСтроки.Вставить(Колонка.Имя, Неопределено);
					ИначеЕсли ТипЗнч(ЗначениеКолонки) = Тип("Строка") Или 
					   ТипЗнч(ЗначениеКолонки) = Тип("Число") Или 
					   ТипЗнч(ЗначениеКолонки) = Тип("Булево") Или 
					   ТипЗнч(ЗначениеКолонки) = Тип("Дата") Тогда
						СтруктураСтроки.Вставить(Колонка.Имя, ЗначениеКолонки);
					Иначе
						// Проверяем, является ли значение ссылкой
					ТипЗначения = ТипЗнч(ЗначениеКолонки);
					ЭтоСсылка = Ложь;
					
					// Явная проверка на основные ссылочные типы
					Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
						ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
						ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
						ЭтоСсылка = Истина;
					КонецЕсли;
					
					// Если не определили явно, проверяем по строковому представлению (fallback)
					Если НЕ ЭтоСсылка Тогда
						СтрокаТипа = НРег(Строка(ТипЗначения));
						// Ищем "ссылка" (ref) регистронезависимо
						Если СтрНайти(СтрокаТипа, "ссылка") > 0 ИЛИ СтрНайти(СтрокаТипа, "ref") > 0 Тогда
							ЭтоСсылка = Истина;
						КонецЕсли;
					КонецЕсли;

					Если ЭтоСсылка Тогда
						// Сохраняем ссылку как есть (для возможности использования в ForEach -> SelectObject)
						СсылкаОбъекта = ЗначениеКолонки;
						СтруктураСтроки.Вставить(Колонка.Имя, СсылкаОбъекта);
							
							Попытка
								УИДИзСсылки = Строка(СсылкаОбъекта.УникальныйИдентификатор());
								НайденаСсылка = Истина;
							Исключение
								// Если не удалось получить УИД, продолжаем
								ТекстОшибки = ОписаниеОшибки();
							КонецПопытки;
						Иначе
							// Для других типов преобразуем в строку
							Попытка
								СтруктураСтроки.Вставить(Колонка.Имя, Строка(ЗначениеКолонки));
							Исключение
								СтруктураСтроки.Вставить(Колонка.Имя, "");
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				Исключение
					// Если возникла ошибка при обработке колонки, пропускаем её
					СтруктураСтроки.Вставить(Колонка.Имя, "");
				КонецПопытки;
			КонецЦикла;
			// Автоматически добавляем поле УИД, если в строке была найдена ссылка
			Если НайденаСсылка И НЕ ПустаяСтрока(УИДИзСсылки) И НЕ СтруктураСтроки.Свойство("УИД") Тогда
				СтруктураСтроки.Вставить("УИД", УИДИзСсылки);
			КонецЕсли;
			МассивРезультатов.Добавить(СтруктураСтроки);
		КонецЦикла;
		
		Результат.Успех = Истина;
		Результат.Сообщение = "Запрос выполнен успешно. Получено строк: " + Формат(ТаблицаРезультатов.Количество(), "ЧН=0");
		Результат.Данные = МассивРезультатов;
		Результат.Вставить("КолонкиЗапроса", МассивКолонок);
		Результат.Вставить("КоличествоСтрок", ТаблицаРезультатов.Количество());
		
		// Сохраняем результат запроса в контексте выполнения для использования в последующих шагах
		КонтекстВыполнения.Вставить("РезультатЗапроса", МассивРезультатов);
		КонтекстВыполнения.Вставить("QueryResult", МассивРезультатов); // Английский алиас для ИИ
		КонтекстВыполнения.Вставить("РезультатЗапросаДляТаблицы", МассивРезультатов);
		
		// Сохраняем данные запроса в результате для создания табличного документа на клиенте
		Результат.Вставить("ДанныеЗапросаДляТаблицы", МассивРезультатов);
		Результат.Вставить("ТипДействия", "RunQuery"); // Маркер для идентификации RunQuery
		Результат.Вставить("ЕстьРезультатЗапроса", Истина); // Флаг, что есть данные для табличного документа
		
		// Если результат простой (одна строка с одним значением), формируем удобное сообщение
		Если МассивРезультатов.Количество() = 1 Тогда
			ПерваяСтрока = МассивРезультатов[0];
			Если ПерваяСтрока.Количество() = 1 Тогда
				// Одно значение - формируем сообщение
				Для Каждого ПараКлючЗначение Из ПерваяСтрока Цикл
					ИмяКолонки = ПараКлючЗначение.Ключ;
					ЗначениеКолонки = ПараКлючЗначение.Значение;
					Результат.Сообщение = "Запрос выполнен. Результат: " + Строка(ЗначениеКолонки);
					// Сохраняем значение для использования в ShowInfo
					КонтекстВыполнения.Вставить(ИмяКолонки, ЗначениеКолонки);
					Прервать;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		
		ТекстОшибкиЗапроса = ОписаниеОшибки();
		Результат.Сообщение = "Ошибка выполнения запроса: " + ТекстОшибкиЗапроса;
		
		ТекстОшибкиВРег = ВРег(ТекстОшибкиЗапроса);
		Если СтрНайти(ТекстОшибкиВРег, "ПОЛЕ") > 0 И СтрНайти(ТекстОшибкиВРег, "НЕ НАЙДЕН") > 0 Тогда
			Результат.Сообщение = Результат.Сообщение + 
				" РЕКОМЕНДАЦИЯ: Используй GetObjectFields для получения списка полей объекта перед RunQuery. Не угадывай имена полей!";
			УстановитьТипизированнуюОшибку(Результат, "field_not_found", "query", Истина, "run_getobjectfields", Новый Структура("source", "query_engine"));
		ИначеЕсли СтрНайти(ТекстОшибкиВРег, "НЕ ЗАДАНО ЗНАЧЕНИЕ ПАРАМЕТРА") > 0 Тогда
			Результат.Сообщение = Результат.Сообщение + 
				" РЕКОМЕНДАЦИЯ: Не используй &Параметры для дат. Вместо этого пиши ДАТАВРЕМЯ(год,месяц,день,час,минута,сек) прямо в запросе.";
			УстановитьТипизированнуюОшибку(Результат, "parameter_missing", "query", Истина, "use_datetime_literal", Новый Структура("source", "query_engine"));
		ИначеЕсли СтрНайти(ТекстОшибкиВРег, "СИНТАКС") > 0 Тогда
			УстановитьТипизированнуюОшибку(Результат, "query_syntax_error", "query", Истина, "repair_dsl", Новый Структура("source", "query_engine"));
		Иначе
			УстановитьТипизированнуюОшибку(Результат, "query_execution_error", "runtime", Истина, "repair_dsl", Новый Структура("source", "query_engine"));
		КонецЕсли;
		
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

Функция НормализоватьПробелыВТекстеЗапроса(Знач ТекстЗапроса)
	Результат = Строка(ТекстЗапроса);
	Результат = СтрЗаменить(Результат, Символ(160), " ");
	Результат = СтрЗаменить(Результат, Символ(8239), " ");
	Результат = СтрЗаменить(Результат, Символ(8199), " ");
	Результат = СтрЗаменить(Результат, Символ(8201), " ");
	
	Нормализованный = "";
	ПредыдущийСимвол = "";
	Для Индекс = 1 По СтрДлина(Результат) Цикл
		ТекущийСимвол = Сред(Результат, Индекс, 1);
		СледующийСимвол = ?(Индекс < СтрДлина(Результат), Сред(Результат, Индекс + 1, 1), "");
		Если ТекущийСимвол = " " И ЭтоЦифровойСимволДляЗапроса(ПредыдущийСимвол) И ЭтоЦифровойСимволДляЗапроса(СледующийСимвол) Тогда
			Продолжить;
		КонецЕсли;
		Нормализованный = Нормализованный + ТекущийСимвол;
		ПредыдущийСимвол = ТекущийСимвол;
	КонецЦикла;
	
	Возврат Нормализованный;
КонецФункции

Функция ИсправитьПоложениеПервыеВЗапросе(ТекстЗапроса)
	Результат = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Результат);
	Префикс = "ВЫБРАТЬ";
	Если Лев(СокрЛП(ТекстВРег), СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Результат;
	КонецЕсли;
	ПозПервые = СтрНайти(ТекстВРег, "ПЕРВЫЕ ");
	Если ПозПервые = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ПозВыбрать = СтрНайти(ТекстВРег, Префикс);
	Если ПозПервые <= ПозВыбрать + СтрДлина(Префикс) + 2 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Остаток = Сред(Результат, ПозПервые + СтрДлина("ПЕРВЫЕ "));
	ЧислоСтрок = "";
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ЧислоСтрок = ЧислоСтрок + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ЧислоСтрок) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФрагментПервые = "ПЕРВЫЕ " + ЧислоСтрок;
	Результат = СтрЗаменить(Результат, Символы.ПС + ФрагментПервые, "");
	Результат = СтрЗаменить(Результат, Символы.ВК + ФрагментПервые, "");
	Результат = СтрЗаменить(Результат, Символы.Таб + ФрагментПервые, "");
	Результат = СтрЗаменить(Результат, " " + ФрагментПервые, "");
	ПозВыбрать = СтрНайти(ВРег(Результат), Префикс);
	Если ПозВыбрать > 0 Тогда
		Результат = Лев(Результат, ПозВыбрать + СтрДлина(Префикс) - 1)
			+ " ПЕРВЫЕ " + ЧислоСтрок
			+ Сред(Результат, ПозВыбрать + СтрДлина(Префикс));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоЦифровойСимволДляЗапроса(Знач СимволСтроки)
	Если ПустаяСтрока(Строка(СимволСтроки)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти("0123456789", Строка(СимволСтроки)) > 0;
КонецФункции

// Выполняет действие ShowInfo
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (для подстановки значений из предыдущих шагов)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьShowInfo(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	
	Сообщение = "";
	Если Шаг.Свойство("message") Тогда
		Сообщение = Строка(Шаг.message);
	ИначеЕсли Шаг.Свойство("title") И Шаг.Свойство("data") Тогда
		Сообщение = СокрЛП(Строка(Шаг.title)) + ": " + СокрЛП(Строка(Шаг.data));
	ИначеЕсли Шаг.Свойство("title") Тогда
		Сообщение = СокрЛП(Строка(Шаг.title));
	ИначеЕсли Шаг.Свойство("data") Тогда
		Сообщение = СокрЛП(Строка(Шаг.data));
	Иначе
		Результат.Успех = Ложь;
		Результат.Вставить("Сообщение", "ShowInfo: не передано ни message, ни совместимые поля title/data");
		Возврат Результат;
	КонецЕсли;
	
	// Проверяем, есть ли результат запроса для создания табличного документа
	// Проверяем наличие результата запроса в контексте
	ЕстьРезультатЗапроса = Ложь;
	Если КонтекстВыполнения.Свойство("РезультатЗапроса") И КонтекстВыполнения.РезультатЗапроса <> Неопределено Тогда
		РезультатЗапроса = КонтекстВыполнения.РезультатЗапроса;
		Если ТипЗнч(РезультатЗапроса) = Тип("Массив") И РезультатЗапроса.Количество() > 0 Тогда
			ЕстьРезультатЗапроса = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Подставляем значения из контекста выполнения (результаты запросов)
	Если КонтекстВыполнения.Свойство("РезультатЗапроса") И КонтекстВыполнения.РезультатЗапроса <> Неопределено Тогда
		РезультатЗапроса = КонтекстВыполнения.РезультатЗапроса;
		Если ТипЗнч(РезультатЗапроса) = Тип("Массив") И РезультатЗапроса.Количество() > 0 Тогда
			ПерваяСтрока = РезультатЗапроса[0];
			Если ТипЗнч(ПерваяСтрока) = Тип("Структура") Тогда
				// Подставляем значения из результата запроса в сообщение
				Для Каждого ПараКлючЗначение Из ПерваяСтрока Цикл
					ИмяКолонки = ПараКлючЗначение.Ключ;
					ЗначениеКолонки = ПараКлючЗначение.Значение;
					Плейсхолдер = "{" + ИмяКолонки + "}";
					Если СтрНайти(Сообщение, Плейсхолдер) > 0 Тогда
						Сообщение = СтрЗаменить(Сообщение, Плейсхолдер, Строка(ЗначениеКолонки));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Также подставляем значения, сохраненные напрямую в контексте
	Для Каждого ПараКлючЗначение Из КонтекстВыполнения Цикл
		ИмяПараметра = ПараКлючЗначение.Ключ;
		ЗначениеПараметра = ПараКлючЗначение.Значение;
		// Пропускаем служебные параметры
		Если ИмяПараметра = "ТекущийОбъект" Или 
		   ИмяПараметра = "ТипОбъекта" Или 
		   ИмяПараметра = "ИмяОбъекта" Или
		ИмяПараметра = "СсылкаДиалога" Или
		   ИмяПараметра = "РезультатЗапроса" Или
		   ИмяПараметра = "РезультатЗапросаДляТаблицы" Тогда
			Продолжить;
		КонецЕсли;
		Плейсхолдер = "{" + ИмяПараметра + "}";
		Если СтрНайти(Сообщение, Плейсхолдер) > 0 Тогда
			Сообщение = СтрЗаменить(Сообщение, Плейсхолдер, Строка(ЗначениеПараметра));
		КонецЕсли;
	КонецЦикла;
	
	Результат.Вставить("Сообщение", Сообщение);
	
	// ВАЛИДАЦИЯ: Проверяем, не остались ли нераспознанные плейсхолдеры
	Если СтрНайти(Сообщение, "{") > 0 И СтрНайти(Сообщение, "}") > 0 Тогда
		// Если в сообщении остались {Поле}, значит данные не были получены
		Результат.Успех = Ложь;
		Результат.Сообщение = "Ошибка: Сообщение содержит нераспознанные поля " + Сообщение + ". " + 
			"Это значит, что RunQuery не вернул данных или не был выполнен. Сначала получи данные!";
	КонецЕсли;
	
	// БЛОКИРОВКА "СДАЧИ" (если есть неиспользованные кандидаты из Discovery)
	Если (СтрНайти(ВРег(Сообщение), "ДАННЫЕ НЕ НАЙДЕНЫ") > 0 ИЛИ СтрНайти(ВРег(Сообщение), "НЕ УДАЛОСЬ") > 0) Тогда
		Рекомендованные = "";
		Если КонтекстВыполнения.Свойство("РекомендованныеОбъекты", Рекомендованные) И НЕ ПустаяСтрока(Строка(Рекомендованные)) Тогда
			Результат.Успех = Ложь;
			Результат.Сообщение = "КРИТИЧЕСКАЯ ОШИБКА: Ты пытаешься завершить работу с сообщением 'Данные не найдены', " +
				"хотя в базе есть похожие объекты: " + Строка(Рекомендованные) + ". " +
				"Ты ОБЯЗАН выполнить RunQuery к одному из этих объектов, прежде чем сдаваться!";
		КонецЕсли;
	КонецЕсли;
	
	Результат.Вставить("Данные", Сообщение); // Сохраняем сообщение в Данные для идентификации ShowInfo
	Результат.Вставить("ТипДействия", "ShowInfo"); // Маркер для идентификации ShowInfo
	
	// Сохраняем флаг наличия результата запроса для создания табличного документа на клиенте
	Результат.Вставить("ЕстьРезультатЗапроса", ЕстьРезультатЗапроса);
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие GetChangedObjects
// Получает ссылки на объекты из табличной части ИзмененныеОбъекты диалога
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (должен содержать СсылкаДиалога)
//
// Возвращаемое значение:
//  Структура - структура результата:
//   * Успех - Булево
//   * Сообщение - Строка
//   * Данные - Массив - массив ссылок на объекты
//
Функция ВыполнитьGetChangedObjects(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	Попытка
		
		// Проверяем наличие ссылки на диалог в контексте
		Если НЕ КонтекстВыполнения.Свойство("СсылкаДиалога") ИЛИ НЕ ЗначениеЗаполнено(КонтекстВыполнения.СсылкаДиалога) Тогда
			Результат.Сообщение = "Ссылка на диалог не передана в контекст выполнения";
			Возврат Результат;
		КонецЕсли;
		
		СсылкаДиалога = КонтекстВыполнения.СсылкаДиалога;
		Диалог = СсылкаДиалога.ПолучитьОбъект();
		
		// Получаем ссылки из табличной части ИзмененныеОбъекты
		МассивСсылок = Новый Массив;
		
		Для Каждого СтрокаИзмененныхОбъектов Из Диалог.ИзмененныеОбъекты Цикл
			Если ЗначениеЗаполнено(СтрокаИзмененныхОбъектов.СсылкаНаОбъект) Тогда
				МассивСсылок.Добавить(СтрокаИзмененныхОбъектов.СсылкаНаОбъект);
			КонецЕсли;
		КонецЦикла;
		
		Результат.Успех = Истина;
		Результат.Сообщение = "Получено объектов из табличной части: " + Формат(МассивСсылок.Количество(), "ЧН=0");
		Результат.Данные = МассивСсылок;
		
	Исключение
		Результат.Сообщение = "Ошибка получения объектов из табличной части: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает значение реквизита объекта
//
// Параметры:
//  Объект - Произвольный - объект справочника или документа
//  ИмяРеквизита - Строка - имя реквизита
//  Значение - Произвольный - значение для установки
//
Процедура УстановитьЗначениеРеквизита(Объект, ИмяРеквизита, Значение)
	
	// В 1С объекты справочников и документов имеют типы вида СправочникОбъект.ИмяСправочника или ДокументОбъект.ИмяДокумента
	// Проверяем тип через строковое представление
	ТипОбъекта = ТипЗнч(Объект);
	СтрокаТипа = Строка(ТипОбъекта);
	
	// Проверяем, является ли объект справочником или документом
	Если СтрНайти(СтрокаТипа, "Справочник объект") > 0 
		ИЛИ СтрНайти(СтрокаТипа, "Документ объект") > 0 Тогда
		
		// Устанавливаем значение через индексатор
		Объект[ИмяРеквизита] = Значение;
		
	Иначе
		
		ВызватьИсключение "Неподдерживаемый тип объекта для установки реквизита: " + СтрокаТипа;
		
	КонецЕсли;
	
КонецПроцедуры

// Выполняет действие GetMetadata
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьGetMetadata(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	Фильтр = "";
	Если Шаг.Свойство("filter") Тогда
		Фильтр = Шаг.filter;
	КонецЕсли;
	
	Попытка
		
		// Получаем метаданные через модуль ИИА_Метаданные
		// Используем другое имя переменной, чтобы избежать конфликта с глобальным объектом Метаданные
		РезультатМетаданных = Новый Структура;
		РезультатМетаданных.Вставить("Справочники", ИИА_Метаданные.ПолучитьСписокСправочников(Фильтр));
		РезультатМетаданных.Вставить("Документы", ИИА_Метаданные.ПолучитьСписокДокументов(Фильтр));
		РезультатМетаданных.Вставить("РегистрыСведений", ИИА_Метаданные.ПолучитьСписокРегистровСведений(Фильтр));
		РезультатМетаданных.Вставить("РегистрыНакопления", ИИА_Метаданные.ПолучитьСписокРегистровНакопления(Фильтр));
		РезультатМетаданных.Вставить("РегистрыБухгалтерии", ИИА_Метаданные.ПолучитьСписокРегистровБухгалтерии(Фильтр));
		
		Результат.Успех = Истина;
		
		// ФОРМИРУЕМ НАГЛЯДНОЕ СООБЩЕНИЕ ДЛЯ ИИ
		ТекстСообщения = "Получены метаданные конфигурации" + ?(ПустаяСтрока(Фильтр), "", " с фильтром '" + Фильтр + "'") + ":" + Символы.ПС;
		ВсегоОбъектов = 0;
		
		Для Каждого КлючЗначение Из РезультатМетаданных Цикл
			Коллекция = КлючЗначение.Значение;
			Если Коллекция.Количество() > 0 Тогда
				ТекстСообщения = ТекстСообщения + "- " + КлючЗначение.Ключ + ": ";
				МассивИмен = Новый Массив;
				Для Каждого Элемент Из Коллекция Цикл
					// ПолноеИмя (например Документ.НакладнаяНаРеализацию) — для GetObjectFields/RunQuery используй object_type и object_name из него
					ПолноеИмя = Элемент.ПолноеИмя;
					МассивИмен.Добавить(ПолноеИмя + ?(ПустаяСтрока(Элемент.Синоним), "", " — " + Элемент.Синоним));
				КонецЦикла;
				ТекстСообщения = ТекстСообщения + СтрСоединить(МассивИмен, ", ") + Символы.ПС;
				ВсегоОбъектов = ВсегоОбъектов + Коллекция.Количество();
			КонецЕсли;
		КонецЦикла;
		
		Если ВсегоОбъектов = 0 Тогда
			ТекстСообщения = ТекстСообщения + "ОБЪЕКТЫ НЕ НАЙДЕНЫ. Попробуй другой фильтр или поищи похожие имена.";
		ИначеЕсли ВсегоОбъектов < 10 Тогда
			ТекстСообщения = ТекстСообщения + "ИНСТРУКЦИЯ: Выбери объект из списка выше. Для GetObjectFields используй полное имя (например Документ.НакладнаяНаРеализацию): object_type=часть до точки, object_name=часть после точки.";
		КонецЕсли;
		
		Результат.Сообщение = ТекстСообщения;
		Результат.Данные = РезультатМетаданных;
		
	Исключение
		Результат.Сообщение = "Ошибка при получении метаданных: " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_getmetadata", Новый Структура("filter", Фильтр));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Подготавливает данные реквизитов для LLM: без синонимов, без префикса Удалить*, в одну строку.
//
// Параметры:
//  ИнформацияОбОбъекте - Структура - результат ПолучитьРеквизитыСправочника/Документа
//
// Возвращаемое значение:
//  Структура - копия с преобразованными Реквизитами
//
Функция ПодготовитьДанныеРеквизитовДляЛлм(ИнформацияОбОбъекте)
	ДанныеДляЛлм = Новый Структура;
	ДанныеДляЛлм.Вставить("Найден", ИнформацияОбОбъекте.Найден);
	ДанныеДляЛлм.Вставить("Имя", ИнформацияОбОбъекте.Имя);
	ДанныеДляЛлм.Вставить("Синоним", ИнформацияОбОбъекте.Синоним);
	Если ИнформацияОбОбъекте.Свойство("ТабличныеЧасти") Тогда
		ДанныеДляЛлм.Вставить("ТабличныеЧасти", ИнформацияОбОбъекте.ТабличныеЧасти);
	КонецЕсли;
	МассивИмен = Новый Массив;
	Для Каждого Реквизит Из ИнформацияОбОбъекте.Реквизиты Цикл
		Если ТипЗнч(Реквизит) = Тип("Структура") И Реквизит.Свойство("Имя")
			И Лев(ВРег(Реквизит.Имя), 6) <> "УДАЛИТ" Тогда
			МассивИмен.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	РеквизитыКратко = Новый Массив;
	РеквизитыКратко.Добавить(Новый Структура("Имя, Синоним", СтрСоединить(МассивИмен, ", "), ""));
	ДанныеДляЛлм.Вставить("Реквизиты", РеквизитыКратко);
	Возврат ДанныеДляЛлм;
КонецФункции

// Выполняет действие GetObjectFields
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьGetObjectFields(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("error_code", "");
	Результат.Вставить("error_context", Неопределено);
	
	ИмяОбъекта = ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(Шаг.object_name, Шаг.object_type);
	ТипОбъекта = Шаг.object_type;
	
	Попытка
		
		Если ТипОбъекта = "Справочник" Тогда
			
			ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыСправочника(ИмяОбъекта);
			
			Если НЕ ИнформацияОбОбъекте.Найден Тогда
				Результат.Сообщение = "Справочник '" + ИмяОбъекта + "' не найден";
				УстановитьТипизированнуюОшибку(Результат, "object_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("object_type,object_name", ТипОбъекта, ИмяОбъекта));
				Возврат Результат;
			КонецЕсли;
			
		ИначеЕсли ТипОбъекта = "Документ" Тогда
			
			ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыДокумента(ИмяОбъекта);
			
			Если НЕ ИнформацияОбОбъекте.Найден Тогда
				Результат.Сообщение = "Документ '" + ИмяОбъекта + "' не найден";
				УстановитьТипизированнуюОшибку(Результат, "object_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("object_type,object_name", ТипОбъекта, ИмяОбъекта));
				Возврат Результат;
			КонецЕсли;
			
		ИначеЕсли ТипОбъекта = "РегистрНакопления" Тогда
			
			ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраНакопления(ИмяОбъекта);
			
			Если НЕ ИнформацияОбОбъекте.Найден Тогда
				Результат.Сообщение = "Регистр накопления '" + ИмяОбъекта + "' не найден";
				УстановитьТипизированнуюОшибку(Результат, "object_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("object_type,object_name", ТипОбъекта, ИмяОбъекта));
				Возврат Результат;
			КонецЕсли;
			
		ИначеЕсли ТипОбъекта = "РегистрСведений" Тогда
			
			ИнформацияОбОбъекте = ИИА_Метаданные.ПолучитьРеквизитыРегистраСведений(ИмяОбъекта);
			
			Если НЕ ИнформацияОбОбъекте.Найден Тогда
				Результат.Сообщение = "Регистр сведений '" + ИмяОбъекта + "' не найден";
				УстановитьТипизированнуюОшибку(Результат, "object_not_found", "metadata", Истина, "run_getmetadata", Новый Структура("object_type,object_name", ТипОбъекта, ИмяОбъекта));
				Возврат Результат;
			КонецЕсли;
			
		Иначе
			Результат.Сообщение = "Неподдерживаемый тип объекта: " + ТипОбъекта;
			УстановитьТипизированнуюОшибку(Результат, "unsupported_object_type", "validation", Ложь, "fix_object_type", Новый Структура("object_type", ТипОбъекта));
			Возврат Результат;
		КонецЕсли;
		
		Результат.Успех = Истина;
		Результат.Сообщение = "Получены реквизиты " + НРег(Строка(ТипОбъекта)) + "а '" + ИмяОбъекта + "'";
		// Сокращённый формат для LLM: без синонимов, без Удалить*, одна строка
		Результат.Данные = ПодготовитьДанныеРеквизитовДляЛлм(ИнформацияОбОбъекте);
		WhitelistПоля = Новый Массив;
		WhitelistПути = Новый Массив;
		Для Каждого РеквизитОбъекта Из ИнформацияОбОбъекте.Реквизиты Цикл
			Если ТипЗнч(РеквизитОбъекта) = Тип("Структура") И РеквизитОбъекта.Свойство("Имя") Тогда
				ИмяРеквизита = Строка(РеквизитОбъекта.Имя);
				Если Лев(ВРег(ИмяРеквизита), 6) <> "УДАЛИТ" Тогда
					WhitelistПоля.Добавить(ИмяРеквизита);
					// Базовые безопасные вложенные пути: часто используются для ссылочных реквизитов.
					ДобавитьВWhitelistПути(WhitelistПути, ИмяРеквизита + ".Наименование");
					ДобавитьВWhitelistПути(WhitelistПути, ИмяРеквизита + ".Ссылка");
					Если РеквизитОбъекта.Свойство("Тип") И ЭтоСсылочныйТипРеквизита(Строка(РеквизитОбъекта.Тип)) Тогда
						ДобавитьВWhitelistПути(WhitelistПути, ИмяРеквизита + ".Код");
						ДобавитьВWhitelistПути(WhitelistПути, ИмяРеквизита + ".Номер");
						ДобавитьВWhitelistПути(WhitelistПути, ИмяРеквизита + ".Дата");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ДобавитьВWhitelistПути(WhitelistПути, "Ссылка");
		Если WhitelistПоля.Найти("Ссылка") = Неопределено Тогда
			WhitelistПоля.Добавить("Ссылка");
		КонецЕсли;
		КонтекстВыполнения.Вставить("DSL_РазрешенныеПоляОбъекта", WhitelistПоля);
		КонтекстВыполнения.Вставить("DSL_РазрешенныеПутиПолейОбъекта", WhitelistПути);
		Результат.Вставить("whitelist_fields", WhitelistПоля);
		Результат.Вставить("whitelist_paths", WhitelistПути);
		Результат.Вставить("ТипДействия", "GetObjectFields");
		
	Исключение
		Результат.Сообщение = "Ошибка при получении реквизитов: " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_getobjectfields", Новый Структура("object_type,object_name", ТипОбъекта, ИмяОбъекта));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие CheckObjectExists
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения (входной/выходной)
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьCheckObjectExists(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("error_code", "");
	Результат.Вставить("error_context", Неопределено);
	
	ИсходноеИмяОбъекта = Шаг.object_name;
	ИмяОбъекта = ИИА_DSLQuerySafety.НормализоватьИмяОбъектаМетаданных(Шаг.object_name, Шаг.object_type);
	ТипОбъекта = Шаг.object_type;
	
	Попытка
		
		Существует = Ложь;
		НайденоЧерезFuzzy = Ложь;
		
		Если ТипОбъекта = "Справочник" Тогда
			Существует = ИИА_Метаданные.СуществуетСправочник(ИмяОбъекта);
			Если НЕ Существует Тогда
				Похожие = ИИА_Метаданные.НайтиПохожиеОбъекты(ИмяОбъекта, "Справочник");
				Для Каждого Похожий Из Похожие Цикл
					Если ИИА_Метаданные.СуществуетСправочник(Похожий) Тогда
						Существует = Истина;
						НайденоЧерезFuzzy = (ВРег(Похожий) <> ВРег(ИмяОбъекта));
						ИмяОбъекта = Похожий;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли ТипОбъекта = "Документ" Тогда
			Существует = ИИА_Метаданные.СуществуетДокумент(ИмяОбъекта);
			Если НЕ Существует Тогда
				Похожие = ИИА_Метаданные.НайтиПохожиеОбъекты(ИмяОбъекта, "Документ");
				Для Каждого Похожий Из Похожие Цикл
					Если ИИА_Метаданные.СуществуетДокумент(Похожий) Тогда
						Существует = Истина;
						НайденоЧерезFuzzy = (ВРег(Похожий) <> ВРег(ИмяОбъекта));
						ИмяОбъекта = Похожий;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли ТипОбъекта = "РегистрНакопления" Тогда
			Существует = ИИА_Метаданные.СуществуетРегистрНакопления(ИмяОбъекта);
		ИначеЕсли ТипОбъекта = "РегистрСведений" Тогда
			Существует = ИИА_Метаданные.СуществуетРегистрСведений(ИмяОбъекта);
		Иначе
			Результат.Сообщение = "Неподдерживаемый тип объекта: " + ТипОбъекта;
			УстановитьТипизированнуюОшибку(Результат, "unsupported_object_type", "validation", Ложь, "fix_object_type", Новый Структура("object_type", ТипОбъекта));
			Возврат Результат;
		КонецЕсли;
		
		РезультатИнформации = Новый Структура;
		РезультатИнформации.Вставить("Существует", Существует);
		РезультатИнформации.Вставить("Имя", ИмяОбъекта);
		РезультатИнформации.Вставить("Тип", ТипОбъекта);
		РезультатИнформации.Вставить("ЗапрошенноеИмя", ИсходноеИмяОбъекта);
		
		Результат.Успех = Истина;
		Если Существует Тогда
			Если НайденоЧерезFuzzy Тогда
				Результат.Сообщение = "ВНИМАНИЕ: " + НРег(Строка(ТипОбъекта)) + " '" + ИсходноеИмяОбъекта + "' НЕ существует. " +
					"Найден похожий объект: '" + ИмяОбъекта + "'. Это НЕ тот объект, который ты искал! " +
					"Используй GetMetadata для поиска правильного имени объекта, а не повторяй CheckObjectExists.";
			Иначе
				Результат.Сообщение = НРег(Строка(ТипОбъекта)) + " '" + ИмяОбъекта + "' существует";
			КонецЕсли;
		Иначе
			Результат.Сообщение = НРег(Строка(ТипОбъекта)) + " '" + ИмяОбъекта + "' НЕ существует. " +
				"Используй GetMetadata с фильтром для поиска правильного имени. Не повторяй CheckObjectExists с тем же именем!";
		КонецЕсли;
		Результат.Данные = РезультатИнформации;
		
	Исключение
		Результат.Сообщение = "Ошибка при проверке существования объекта: " + ОписаниеОшибки();
		УстановитьТипизированнуюОшибку(Результат, "metadata_access_error", "metadata", Истина, "retry_check_object", Новый Структура("object_type,object_name", ТипОбъекта, ИмяОбъекта));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Выполняет действие SelectObject
//
// Параметры:
//  Шаг - Структура - структура шага
//  КонтекстВыполнения - Структура - контекст выполнения
//
// Возвращаемое значение:
//  Структура - структура результата
//
Функция ВыполнитьSelectObject(Шаг, КонтекстВыполнения)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Данные", Неопределено);
	
	Ссылка = Неопределено;
	Если Шаг.Свойство("reference") Тогда
		Ссылка = Шаг.reference;
	ИначеЕсли Шаг.Свойство("object") Тогда
		Ссылка = Шаг.object;
	ИначеЕсли Шаг.Свойство("object_type") И Шаг.Свойство("object_name") И (Шаг.Свойство("name") Или Шаг.Свойство("value")) Тогда
		// Альтернативный формат: поиск по наименованию через FindReferenceByName
		ШагПоиска = Новый Структура;
		ШагПоиска.Вставить("object_name", Шаг.object_name);
		ШагПоиска.Вставить("name", ?(Шаг.Свойство("name"), Шаг.name, Шаг.value));
		РезПоиска = ВыполнитьFindReferenceByName(ШагПоиска, КонтекстВыполнения);
		Если НЕ РезПоиска.Успех Тогда
			Результат.Сообщение = РезПоиска.Сообщение;
			Возврат Результат;
		КонецЕсли;
		Ссылка = РезПоиска.Данные;
		// FindReferenceByName уже установил ТекущийОбъект в контекст — SelectObject по сути выполнен
		Результат.Успех = Истина;
		Результат.Сообщение = "Выбран объект по наименованию: " + Строка(Ссылка);
		Результат.Данные = Ссылка;
		Возврат Результат;
	КонецЕсли;
	
	// Проверка типа (хотя 1С сама выбросит исключение при попытке ПолучитьОбъект(), если это не ссылочный тип)
	ТипЗнчСсылки = ТипЗнч(Ссылка);
	
	Попытка
		
		// Проверяем, что это ссылочный тип, поддерживающий ПолучитьОбъект
		Если НЕ (Справочники.ТипВсеСсылки().СодержитТип(ТипЗнчСсылки) 
			ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнчСсылки)
			ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнчСсылки)) Тогда
			
			Результат.Сообщение = "Ошибка выбора объекта: Значение типа '" + Строка(ТипЗнчСсылки) + "' не является ссылкой на объект. Значение: " + Строка(Ссылка);
			Возврат Результат;
		КонецЕсли;
		
		// Пытаемся получить объект. Это работает для СправочникСсылка и ДокументСсылка
		Объект = Ссылка.ПолучитьОбъект();
		
		Если Объект = Неопределено Тогда
			Результат.Сообщение = "Не удалось получить объект по ссылке (объект не найден)";
			Возврат Результат;
		КонецЕсли;
		
		КонтекстВыполнения.Вставить("ТекущийОбъект", Объект);
		КонтекстВыполнения.Вставить("СсылкаОбъекта", Ссылка);
		
		// Определяем тип для логики Write и ИмяОбъекта для SetField
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнчСсылки) Тогда
			КонтекстВыполнения.Вставить("ТипОбъекта", "Справочник");
			КонтекстВыполнения.Вставить("ИмяОбъекта", Ссылка.Метаданные().Имя);
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнчСсылки) Тогда
			КонтекстВыполнения.Вставить("ТипОбъекта", "Документ");
			КонтекстВыполнения.Вставить("ИмяОбъекта", Ссылка.Метаданные().Имя);
		Иначе
			КонтекстВыполнения.Вставить("ТипОбъекта", "Неизвестно");
			// Попытка получить имя метаданных для неизвестного типа
			Попытка
				КонтекстВыполнения.Вставить("ИмяОбъекта", Ссылка.Метаданные().Имя);
			Исключение
				КонтекстВыполнения.Вставить("ИмяОбъекта", "Неизвестно");
			КонецПопытки;
		КонецЕсли;
		
		УстановитьDSLКонтекстОбъекта(КонтекстВыполнения, КонтекстВыполнения.ТипОбъекта, КонтекстВыполнения.ИмяОбъекта, Объект, Ложь);
		
		Результат.Успех = Истина;
		Результат.Сообщение = "Выбран объект: " + Строка(Ссылка);
		Результат.Данные = Ссылка;
		
	Исключение
		Результат.Сообщение = "Ошибка выбора объекта (неверный тип ссылки?): " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Осуществляет поиск ссылки по УИД(GUID) или массиву УИДов(GUID)
//
// Параметры:
//   УИД - Строка - Идентификатор строкой.
//       - Массив - Массив идентификаторов строкой.
//
//Возвращаемое значение:
//	- Неопределено - Если не удалось определить ни одну ссылку по параметру УИД.
//	- ЛюбаяСсылка - Если в параметр "УИД" была передана строка.
//	- ТаблицаЗначений  - Если в параметр "УИД" был передан массив строк.
//		* УИД - Строка - Содержит идентифкатор строкой по которому удалось определить ссылку.
//		* Ссылка - ЛюбаяСсылка - Содержит ссылку на объект.
//
// Пример:
// РезультатПоиска = НайтиСсылкуПоУИД("31f35109-f60a-4777-a555-f8a46c5a165d") ...
//
Функция НайтиСсылкуПоУИД(знач УИД)
    
    ЭтоМассив = ТипЗнч(УИД) = Тип("Массив");
    
    МассивУидов = Новый Массив;
    Если ЭтоМассив Тогда
        МассивУидов = УИД;
    Иначе
        МассивУидов.Добавить(УИД);
    КонецЕсли;
    
	Результат = Неопределено;
    
    МассивМетаданных = Новый Массив;    
	МассивМетаданных.Добавить(Справочники);
	МассивМетаданных.Добавить(Документы);
	МассивМетаданных.Добавить(ПланыВидовХарактеристик);
	МассивМетаданных.Добавить(ПланыСчетов);
	МассивМетаданных.Добавить(ПланыВидовРасчета);
	МассивМетаданных.Добавить(ПланыОбмена);
	МассивМетаданных.Добавить(БизнесПроцессы);
	МассивМетаданных.Добавить(Задачи);
    
    МассивТипов = Новый Массив; 
    
    Для Каждого СтрМетаданное Из МассивМетаданных Цикл
        Для Каждого Стр Из СтрМетаданное.ТипВсеСсылки().Типы() Цикл
            МассивТипов.Добавить(Стр);
        КонецЦикла;
    КонецЦикла;
        
    ТаблицаСсылок = Новый ТаблицаЗначений;
    ТаблицаСсылок.Колонки.Добавить("УИД"    , Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
    ТаблицаСсылок.Колонки.Добавить("Ссылка" , Новый ОписаниеТипов(МассивТипов));
    
    Для Каждого СтрМетаданное Из МассивМетаданных Цикл
        Для Каждого Менеджер Из СтрМетаданное Цикл   
            Для Каждого СтрУИД Из МассивУидов Цикл
                Попытка
                    НовСтр = ТаблицаСсылок.Добавить();
                    НовСтр.Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрУИД));
                    НовСтр.УИД    = СтрУИД;
                Исключение
                    ТекстОшибки = ОписаниеОшибки();
                КонецПопытки;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
            
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ТаблицаСсылок.Ссылка КАК Ссылка,
        |   ТаблицаСсылок.УИД КАК УИД
        |ПОМЕСТИТЬ ВТ
        |ИЗ
        |   &ТаблицаСсылок КАК ТаблицаСсылок
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   ВТ.Ссылка КАК Ссылка,
        |   ВТ.УИД КАК УИД
        |ИЗ
        |   ВТ КАК ВТ
        |ГДЕ
        |   НЕ ВТ.Ссылка.ПометкаУдаления ЕСТЬ NULL";
    
    Запрос.УстановитьПараметр("ТаблицаСсылок",ТаблицаСсылок);
    РезультатЗапроса = Запрос.Выполнить();
    
    Если Не РезультатЗапроса.Пустой() Тогда
        Если ЭтоМассив Тогда
            Результат = РезультатЗапроса.Выгрузить(); 
        Иначе
            ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
            ВыборкаДетальныеЗаписи.Следующий();
            
            Результат = ВыборкаДетальныеЗаписи.Ссылка;
        КонецЕсли;
    КонецЕсли;
    
	Возврат Результат;
		
КонецФункции // НайтиСсылкуПоУИД

#КонецОбласти

// Проверяет, является ли строка допустимым именем свойства
Функция ЭтоДопустимоеИмяСвойства(Имя)
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Здесь можно добавить более сложную проверку, если нужно
	// Пока просто проверяем, что это не пустая строка
	
	Возврат Истина;
	
КонецФункции

// Обрабатывает значение параметра, поддерживая ссылки на другие шаги
//
// Параметры:
//  Значение - Произвольный - исходное значение параметра
//  КонтекстВыполнения - Структура - контекст выполнения
//
// Возвращаемое значение:
//  Произвольный - обработанное значение
//
Функция ОбработатьЗначениеПараметра(Значение, КонтекстВыполнения)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	
	// Проверяем наличие синтаксиса #(...)
	Если СтрНайти(Значение, "#(") = 1 И Прав(Значение, 1) = ")" Тогда
		
		ПутьКЗначению = Сред(Значение, 3, СтрДлина(Значение) - 3);
		
		// Если это прямая ссылка на переменную контекста (например, #(Хранилище_Ключ) или #(CurrentItem))
		// Проверяем наличие только если имя не составное (без точек)
		Если СтрНайти(ПутьКЗначению, ".") = 0 И КонтекстВыполнения.Свойство(ПутьКЗначению) Тогда
			Возврат КонтекстВыполнения[ПутьКЗначению];
		КонецЕсли;
		
		// Разбираем путь (например, ШАГ1.Данные.Поле или CurrentItem.Ссылка.Наименование)
		Части = СтрРазделить(ПутьКЗначению, ".");
		
		Если Части.Количество() >= 1 Тогда
			
			ИмяПеременной = Части[0]; // Например, ШАГ1 или CurrentItem
			
			Если КонтекстВыполнения.Свойство(ИмяПеременной) Тогда
				
				ТекущееЗначение = КонтекстВыполнения[ИмяПеременной];
				
				// Проходим по остальным частям пути
				Для Индекс = 1 По Части.Количество() - 1 Цикл
					
					ИмяСвойства = Части[Индекс];
					
					// Проверка валидности имени свойства
					Если ПустаяСтрока(ИмяСвойства) Или Не ЭтоДопустимоеИмяСвойства(ИмяСвойства) Тогда
						// Если имя свойства некорректное, считаем это ошибкой доступа к свойству
						// и возвращаем исходное значение
						Возврат Значение;
					КонецЕсли;
					
					Если ТипЗнч(ТекущееЗначение) = Тип("Структура") Тогда
						Если ТекущееЗначение.Свойство(ИмяСвойства) Тогда
							ТекущееЗначение = ТекущееЗначение[ИмяСвойства];
						Иначе
							Возврат Значение;
						КонецЕсли;
					ИначеЕсли (Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ТекущееЗначение)) Или Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ТекущееЗначение))) Тогда
						Попытка
							ТекущееЗначение = ТекущееЗначение[ИмяСвойства];
						Исключение
							// Если не удалось получить свойство, прерываем и возвращаем исходную строку
							Возврат Значение;
						КонецПопытки;
					ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("СправочникОбъект") Или ТипЗнч(ТекущееЗначение) = Тип("ДокументОбъект") Тогда
						Попытка
							ТекущееЗначение = ТекущееЗначение[ИмяСвойства];
						Исключение
							Возврат Значение;
						КонецПопытки;
					Иначе
						// Невозможно получить свойство от этого типа, возвращаем исходное значение (или можно вернуть Неопределено)
						Возврат Значение;
					КонецЕсли;
					
				КонецЦикла;
				
				Возврат ТекущееЗначение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Исправляет порядок параметров ДОБАВИТЬКДАТЕ в тексте запроса.
// LLM часто генерирует ДОБАВИТЬКДАТЕ(Дата, -7, ДЕНЬ) вместо ДОБАВИТЬКДАТЕ(Дата, ДЕНЬ, -7).
Функция ИсправитьПорядокДобавитьКДате(ТекстЗапроса)
	
	ВерхнийРегистр = ВРег(ТекстЗапроса);
	ПозФункции = СтрНайти(ВерхнийРегистр, "ДОБАВИТЬКДАТЕ(");
	Если ПозФункции = 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	ЕдиницыИзмерения = ",СЕКУНДА,МИНУТА,ЧАС,ДЕНЬ,НЕДЕЛЯ,МЕСЯЦ,КВАРТАЛ,ГОД,SECOND,MINUTE,HOUR,DAY,WEEK,MONTH,QUARTER,YEAR,";
	Результат = ТекстЗапроса;
	
	Пока ПозФункции > 0 Цикл
		
		ПозНачалаАрг = ПозФункции + СтрДлина("ДОБАВИТЬКДАТЕ(");
		
		// Пропускаем первый аргумент (может содержать вложенные вызовы функций)
		Глубина = 0;
		ПозТекущая = ПозНачалаАрг;
		ПозПервойЗапятой = 0;
		Пока ПозТекущая <= СтрДлина(Результат) Цикл
			Сим = Сред(Результат, ПозТекущая, 1);
			Если Сим = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Сим = ")" Тогда
				Если Глубина = 0 Тогда
					Прервать;
				КонецЕсли;
				Глубина = Глубина - 1;
			ИначеЕсли Сим = "," И Глубина = 0 Тогда
				ПозПервойЗапятой = ПозТекущая;
				Прервать;
			КонецЕсли;
			ПозТекущая = ПозТекущая + 1;
		КонецЦикла;
		
		Если ПозПервойЗапятой = 0 Тогда
			Прервать;
		КонецЕсли;
		
		// Ищем вторую запятую
		ПозВторойЗапятой = 0;
		Глубина = 0;
		ПозТекущая = ПозПервойЗапятой + 1;
		Пока ПозТекущая <= СтрДлина(Результат) Цикл
			Сим = Сред(Результат, ПозТекущая, 1);
			Если Сим = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Сим = ")" Тогда
				Если Глубина = 0 Тогда
					Прервать;
				КонецЕсли;
				Глубина = Глубина - 1;
			ИначеЕсли Сим = "," И Глубина = 0 Тогда
				ПозВторойЗапятой = ПозТекущая;
				Прервать;
			КонецЕсли;
			ПозТекущая = ПозТекущая + 1;
		КонецЦикла;
		
		Если ПозВторойЗапятой = 0 Тогда
			Прервать;
		КонецЕсли;
		
		// Ищем закрывающую скобку
		ПозЗакрытия = 0;
		Глубина = 0;
		ПозТекущая = ПозВторойЗапятой + 1;
		Пока ПозТекущая <= СтрДлина(Результат) Цикл
			Сим = Сред(Результат, ПозТекущая, 1);
			Если Сим = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Сим = ")" Тогда
				Если Глубина = 0 Тогда
					ПозЗакрытия = ПозТекущая;
					Прервать;
				КонецЕсли;
				Глубина = Глубина - 1;
			КонецЕсли;
			ПозТекущая = ПозТекущая + 1;
		КонецЦикла;
		
		Если ПозЗакрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ВторойАрг = СокрЛП(Сред(Результат, ПозПервойЗапятой + 1, ПозВторойЗапятой - ПозПервойЗапятой - 1));
		ТретийАрг = СокрЛП(Сред(Результат, ПозВторойЗапятой + 1, ПозЗакрытия - ПозВторойЗапятой - 1));
		
		// Проверяем: если 2-й аргумент — число, а 3-й — единица измерения, значит порядок неверный
		ВторойПохожНаЧисло = ЭтоЧисловойЛитерал(ВторойАрг);
		ТретийЭтоЕдиница = СтрНайти(ЕдиницыИзмерения, "," + ВРег(СокрЛП(ТретийАрг)) + ",") > 0;
		
		Если ВторойПохожНаЧисло И ТретийЭтоЕдиница Тогда
			ПервыйАрг = Сред(Результат, ПозНачалаАрг, ПозПервойЗапятой - ПозНачалаАрг);
			Исправленный = "ДОБАВИТЬКДАТЕ(" + ПервыйАрг + ", " + ТретийАрг + ", " + ВторойАрг + ")";
			Исходный = Сред(Результат, ПозФункции, ПозЗакрытия - ПозФункции + 1);
			Результат = Лев(Результат, ПозФункции - 1) + Исправленный + Сред(Результат, ПозЗакрытия + 1);
		КонецЕсли;
		
		ВерхнийРегистр = ВРег(Результат);
		ПозФункции = СтрНайти(ВерхнийРегистр, "ДОБАВИТЬКДАТЕ(", НаправлениеПоиска.СНачала, ПозФункции + 1);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли строка числовым литералом (включая отрицательные: -7, 30 и т.п.)
Функция ЭтоЧисловойЛитерал(Строка_)
	
	Текст = СокрЛП(Строка_);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Начало = 1;
	Если Сред(Текст, 1, 1) = "-" ИЛИ Сред(Текст, 1, 1) = "+" Тогда
		Начало = 2;
	КонецЕсли;
	
	Если Начало > СтрДлина(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Инд = Начало По СтрДлина(Текст) Цикл
		Сим = Сред(Текст, Инд, 1);
		Если СтрНайти("0123456789", Сим) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
