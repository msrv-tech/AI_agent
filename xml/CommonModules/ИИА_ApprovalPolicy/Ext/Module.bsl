#Область ПрограммныйИнтерфейс

Функция ОбработатьApprovalПередExecuteSubgraph(СсылкаДиалога, DSLДляИсполнения, АртефактПлана = Неопределено, ИмяПодграфа = "") Экспорт
	ОценкаРиска = ОценитьРискDSLДляПодтверждения(DSLДляИсполнения);
	Если ИИА_Сервер.ЭтоРежимБезПодтверждения(СсылкаДиалога) Тогда
		ОценкаРиска.requires_approval = Ложь;
		ОценкаРиска.reason = ОценкаРиска.reason + ?(ПустаяСтрока(ОценкаРиска.reason), "", " ") + "Для текущего диалога включен режим выполнения без подтверждения.";
	КонецЕсли;
	Если ЭтоДиалогРаспознаванияДокументов(СсылкаДиалога) Тогда
		ОценкаРиска.requires_approval = Ложь;
		ОценкаРиска.reason = ОценкаРиска.reason + ?(ПустаяСтрока(ОценкаРиска.reason), "", " ") + "Режим распознавания документов создает черновики по skill без отдельного runtime approval.";
	КонецЕсли;
	СостояниеПодтверждения = ИИА_Сервер.ПолучитьСостояниеПодтверждения(СсылкаДиалога);
	Если СостояниеПодтверждения <> Неопределено
		И СостояниеПодтверждения.Свойство("status")
		И ВРег(Строка(СостояниеПодтверждения.status)) = "APPROVED"
		И СостояниеПодтверждения.Свойство("planned_dsl")
		И СокрЛП(Строка(СостояниеПодтверждения.planned_dsl)) = СокрЛП(DSLДляИсполнения) Тогда
		СостояниеПодтверждения.status = "consumed";
		ИИА_Сервер.СохранитьСостояниеПодтверждения(СсылкаДиалога, СостояниеПодтверждения);
		ИИА_Сервер.СохранитьЧекпоинтОркестратора(СсылкаДиалога, "approval_consumed", "Execute", СостояниеПодтверждения, "approval_consumed");
		Возврат Ложь;
	КонецЕсли;
	Если ТребуетсяПодтверждениеПередИсполнением(ОценкаРиска) Тогда
		ЗапроситьПодтверждениеПользователя(СсылкаДиалога, DSLДляИсполнения, ОценкаРиска, АртефактПлана, ИмяПодграфа);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЭтоДиалогРаспознаванияДокументов(СсылкаДиалога)

	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат СсылкаДиалога.ТипДиалога = Перечисления.ИИА_ТипДиалога.РаспознаваниеДокументов;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ОценитьРискDSLДляПодтверждения(DSLСценарий) Экспорт
	Результат = Новый Структура("risk_level,reason,requires_approval,actions_preview", "read_safe", "", Ложь, "");
	Если ПустаяСтрока(DSLСценарий) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ТекстJSON = ИИА_DSL.НормализоватьJSONТекст(DSLСценарий);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Сценарий = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат.risk_level = "read_expensive";
		Результат.reason = "Невозможно надежно разобрать DSL до исполнения.";
		Результат.requires_approval = Истина;
		Возврат Результат;
	КонецПопытки;
	
	Шаги = Новый Массив;
	Если ТипЗнч(Сценарий) = Тип("Структура") И Сценарий.Свойство("steps") И ТипЗнч(Сценарий.steps) = Тип("Массив") Тогда
		Шаги = Сценарий.steps;
	ИначеЕсли ТипЗнч(Сценарий) = Тип("Структура") И Сценарий.Свойство("action") Тогда
		Шаги.Добавить(Сценарий);
	КонецЕсли;
	
	Действия = Новый Массив;
	ТяжелоеЧтение = Ложь;
	
	Для Каждого Шаг Из Шаги Цикл
		Если ТипЗнч(Шаг) <> Тип("Структура") И ТипЗнч(Шаг) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		Действие = "";
		Если ТипЗнч(Шаг) = Тип("Структура") И Шаг.Свойство("action") Тогда
			Действие = СокрЛП(Строка(Шаг.action));
		ИначеЕсли ТипЗнч(Шаг) = Тип("Соответствие") И Шаг.Получить("action") <> Неопределено Тогда
			Действие = СокрЛП(Строка(Шаг.Получить("action")));
		КонецЕсли;
		Если ПустаяСтрока(Действие) Тогда
			Продолжить;
		КонецЕсли;
		
		Действия.Добавить(Действие);
		Если ЭтоИзменяющееДействиеДляApproval(Действие) Тогда
			Результат.risk_level = "write_or_mutation";
			Результат.reason = "DSL содержит действия изменения данных: " + СтрСоединить(Действия, ", ");
			Результат.requires_approval = Истина;
		КонецЕсли;
		
		Если ВРег(Действие) = "RUNQUERY" Тогда
			ТекстЗапроса = "";
			Если ТипЗнч(Шаг) = Тип("Структура") И Шаг.Свойство("query") Тогда
				ТекстЗапроса = Строка(Шаг.query);
			ИначеЕсли ТипЗнч(Шаг) = Тип("Соответствие") И Шаг.Получить("query") <> Неопределено Тогда
				ТекстЗапроса = Строка(Шаг.Получить("query"));
			КонецЕсли;
			ТекстЗапросаВРег = ВРег(ТекстЗапроса);
			Если СтрДлина(ТекстЗапроса) > 400
				ИЛИ СтрНайти(ТекстЗапросаВРег, " СОЕДИНЕНИЕ ") > 0
				ИЛИ СтрНайти(ТекстЗапросаВРег, " JOIN ") > 0
				ИЛИ СтрНайти(ТекстЗапросаВРег, " ОБЪЕДИНИТЬ ") > 0
				ИЛИ (СтрНайти(ТекстЗапросаВРег, " ИЗ ") > 0
					И СтрНайти(ТекстЗапросаВРег, "ПЕРВЫЕ ") = 0
					И СтрНайти(ТекстЗапросаВРег, " ГДЕ ") = 0) Тогда
				ТяжелоеЧтение = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат.actions_preview = СтрСоединить(Действия, ", ");
	Если Результат.risk_level = "write_or_mutation" Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТяжелоеЧтение Тогда
		Результат.risk_level = "read_expensive";
		Результат.reason = "DSL содержит потенциально тяжелый RunQuery.";
		Результат.requires_approval = Истина;
	Иначе
		Результат.risk_level = "read_safe";
		Результат.reason = "DSL не содержит действий записи и не выглядит тяжелым.";
		Результат.requires_approval = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПодтвердитьОжидающееДействие(СсылкаДиалога, АвтоПродолжить = Истина) Экспорт
	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СостояниеПодтверждения = ИИА_Сервер.ПолучитьСостояниеПодтверждения(СсылкаДиалога);
	Если СостояниеПодтверждения = Неопределено
		ИЛИ НЕ СостояниеПодтверждения.Свойство("status")
		ИЛИ ВРег(Строка(СостояниеПодтверждения.status)) <> "PENDING" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СостояниеПодтверждения.status = "approved";
	СостояниеПодтверждения.decision = "approve";
	СостояниеПодтверждения.decision_at = ТекущаяДатаСеанса();
	ИИА_Сервер.СохранитьСостояниеПодтверждения(СсылкаДиалога, СостояниеПодтверждения);
	ЗафиксироватьApprovalDecision(СсылкаДиалога, "approved", СостояниеПодтверждения, ?(СостояниеПодтверждения.Свойство("subgraph_name"), Строка(СостояниеПодтверждения.subgraph_name), "ExecuteSubgraph"), "user_approved", "approval_approved", "Execute", "approval_approved", "Пользователь подтвердил выполнение рискованного DSL. Возобновляю оркестратор.");
	Если АвтоПродолжить Тогда
		ИИА_Оркестратор.Запустить(СсылкаДиалога, Истина);
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ОтклонитьОжидающееДействие(СсылкаДиалога, АвтоПродолжить = Истина) Экспорт
	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СостояниеПодтверждения = ИИА_Сервер.ПолучитьСостояниеПодтверждения(СсылкаДиалога);
	Если СостояниеПодтверждения = Неопределено
		ИЛИ НЕ СостояниеПодтверждения.Свойство("status")
		ИЛИ ВРег(Строка(СостояниеПодтверждения.status)) <> "PENDING" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СостояниеПодтверждения.status = "rejected";
	СостояниеПодтверждения.decision = "reject";
	СостояниеПодтверждения.decision_at = ТекущаяДатаСеанса();
	ИИА_Сервер.СохранитьСостояниеПодтверждения(СсылкаДиалога, СостояниеПодтверждения);
	ЗафиксироватьApprovalDecision(СсылкаДиалога, "rejected", СостояниеПодтверждения, ?(СостояниеПодтверждения.Свойство("subgraph_name"), Строка(СостояниеПодтверждения.subgraph_name), "ExecuteSubgraph"), "user_rejected", "approval_rejected", "Stopped", "approval_rejected", "Пользователь отклонил выполнение действия. Запуск остановлен.");
	
	Если СостояниеПодтверждения.Свойство("step_id") И НЕ ПустаяСтрока(Строка(СостояниеПодтверждения.step_id)) Тогда
		ИИА_TypedPlan.ОбновитьШагПлана(СсылкаДиалога, Строка(СостояниеПодтверждения.step_id), "rejected", "Отклонено пользователем");
	КонецЕсли;
	ИИА_Сервер.УстановитьСостояниеОркестратора(СсылкаДиалога, "Stopped", "approval_rejected", Ложь);
	ИИА_Сервер.УстановитьОркестраторВключен(СсылкаДиалога, Ложь);
	
	Если АвтоПродолжить Тогда
		ИИА_Сервер.УведомитьОбОбновленииДиалога(СсылкаДиалога, "ОстановленПользователем");
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ВключитьРежимБезПодтвержденияИПродолжить(СсылкаДиалога) Экспорт
	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИИА_Сервер.УстановитьРежимБезПодтверждения(СсылкаДиалога, Истина);
	ИИА_Сервер.ДобавитьСообщениеВДиалог(СсылкаДиалога, Перечисления.ИИА_АвторСообщения.Система, Перечисления.ИИА_ТипСообщения.Текст, "Для текущего диалога включен режим: выполнять без подтверждения.");
	Возврат ПодтвердитьОжидающееДействие(СсылкаДиалога);
КонецФункции

Функция ЭтоИзменяющееДействиеДляApproval(Действие) Экспорт
	ДействиеВРег = ВРег(СокрЛП(Действие));
	Возврат ДействиеВРег = "CREATEDOCUMENT"
		ИЛИ ДействиеВРег = "CREATEREFERENCE"
		ИЛИ ДействиеВРег = "SETFIELD"
		ИЛИ ДействиеВРег = "WRITE"
		ИЛИ ДействиеВРег = "POSTDOCUMENT"
		ИЛИ ДействиеВРег = "DELETEOBJECT"
		ИЛИ ДействиеВРег = "ADDTABLEROW";
КонецФункции

Функция ТребуетсяПодтверждениеПередИсполнением(ОценкаРиска) Экспорт
	Возврат ОценкаРиска <> Неопределено
		И ОценкаРиска.Свойство("requires_approval")
		И ОценкаРиска.requires_approval;
КонецФункции

Функция СформироватьPreviewПодтверждения(DSLСценарий, ОценкаРиска) Экспорт
	Текст = "Подтвердите выполнение действий:" + Символы.ПС;
	Если ОценкаРиска <> Неопределено Тогда
		Если ОценкаРиска.Свойство("risk_level") И НЕ ПустаяСтрока(Строка(ОценкаРиска.risk_level)) Тогда
			Текст = Текст + "Риск: " + Строка(ОценкаРиска.risk_level) + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	ЧеловекочитаемыеДействия = СформироватьЧеловекочитаемыйPreviewDSL(DSLСценарий);
	Если НЕ ПустаяСтрока(ЧеловекочитаемыеДействия) Тогда
		Текст = Текст + ЧеловекочитаемыеДействия;
	Иначе
		Если ОценкаРиска <> Неопределено И ОценкаРиска.Свойство("actions_preview") И НЕ ПустаяСтрока(Строка(ОценкаРиска.actions_preview)) Тогда
			Текст = Текст + "Действия: " + Строка(ОценкаРиска.actions_preview) + Символы.ПС;
		Иначе
			Текст = Текст + "Сценарий изменения данных." + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция СформироватьЧеловекочитаемыйPreviewDSL(DSLСценарий)
	Если ПустаяСтрока(DSLСценарий) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		ТекстJSON = ИИА_DSL.НормализоватьJSONТекст(DSLСценарий);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Сценарий = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;
	Шаги = Новый Массив;
	Если ТипЗнч(Сценарий) = Тип("Структура") И Сценарий.Свойство("steps") И ТипЗнч(Сценарий.steps) = Тип("Массив") Тогда
		Шаги = Сценарий.steps;
	ИначеЕсли ТипЗнч(Сценарий) = Тип("Структура") И Сценарий.Свойство("action") Тогда
		Шаги.Добавить(Сценарий);
	КонецЕсли;
	Если Шаги.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Строки = Новый Массив;
	Номер = 0;
	Для Каждого Шаг Из Шаги Цикл
		Если ТипЗнч(Шаг) <> Тип("Структура") И ТипЗнч(Шаг) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Описание = ОписаниеШагаДляPreview(Шаг);
		Если ПустаяСтрока(Описание) Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		Строки.Добавить(Формат(Номер, "ЧН=0") + ". " + Описание);
		Если Номер >= 12 Тогда
			Строки.Добавить("... еще действия в сценарии");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ОписаниеШагаДляPreview(Шаг)
	Действие = ПолучитьСвойствоШагаPreview(Шаг, "action", "");
	ДействиеВРег = ВРег(СокрЛП(Строка(Действие)));
	Если ПустаяСтрока(ДействиеВРег) Тогда
		Возврат "";
	КонецЕсли;
	Если ДействиеВРег = "CREATEREFERENCE" Тогда
		Данные = ПолучитьСвойствоШагаPreview(Шаг, "data", Неопределено);
		Возврат "Найти или создать элемент справочника " + ПолучитьСвойствоШагаPreview(Шаг, "object_name", "")
			+ СформироватьКраткиеДанныеPreview(Данные, Неопределено);
	ИначеЕсли ДействиеВРег = "CREATEDOCUMENT" Тогда
		Данные = ПолучитьСвойствоШагаPreview(Шаг, "data", Неопределено);
		Возврат "Создать документ " + ПолучитьСвойствоШагаPreview(Шаг, "object_name", "")
			+ СформироватьКраткиеДанныеPreview(Данные, Неопределено);
	ИначеЕсли ДействиеВРег = "ADDTABLEROW" Тогда
		Данные = ПолучитьСвойствоШагаPreview(Шаг, "data", Неопределено);
		Возврат "Добавить строку в табличную часть " + ПолучитьСвойствоШагаPreview(Шаг, "table", "")
			+ СформироватьКраткиеДанныеPreview(Данные, Неопределено);
	ИначеЕсли ДействиеВРег = "SETFIELD" Тогда
		ИмяПоля = ПолучитьСвойствоШагаPreview(Шаг, "field", ПолучитьСвойствоШагаPreview(Шаг, "field_name", ""));
		ЗначениеПоля = ПолучитьСвойствоШагаPreview(Шаг, "value", ПолучитьСвойствоШагаPreview(Шаг, "field_value", ""));
		Если ПустаяСтрока(СокрЛП(Строка(ЗначениеПоля))) Тогда
			Возврат "Заполнить поле " + ИмяПоля;
		КонецЕсли;
		Возврат "Заполнить поле " + ИмяПоля + "=" + Лев(Строка(ЗначениеПоля), 80);
	ИначеЕсли ДействиеВРег = "WRITE" Тогда
		РежимЗаписи = ВРег(СокрЛП(Строка(ПолучитьСвойствоШагаPreview(Шаг, "mode", ПолучитьСвойствоШагаPreview(Шаг, "write_mode", "")))));
		ИмяОбъекта = ПолучитьСвойствоШагаPreview(Шаг, "object_name", ПолучитьСвойствоШагаPreview(Шаг, "object", ""));
		СуффиксОбъекта = ?(ПустаяСтрока(СокрЛП(Строка(ИмяОбъекта))), "", " " + ИмяОбъекта);
		Если СтрНайти(РежимЗаписи, "POST") > 0 Или СтрНайти(РежимЗаписи, "ПРОВЕД") > 0 Тогда
			Возврат "Записать и провести документ" + СуффиксОбъекта + " (требуется подтверждение)";
		КонецЕсли;
		Возврат "Записать черновик без проведения" + СуффиксОбъекта;
	ИначеЕсли ДействиеВРег = "POSTDOCUMENT" Тогда
		Возврат "Провести документ";
	ИначеЕсли ДействиеВРег = "DELETEOBJECT" Тогда
		Возврат "Удалить или пометить объект на удаление";
	ИначеЕсли ДействиеВРег = "RUNQUERY" Тогда
		Возврат ОписаниеRunQueryДляPreview(ПолучитьСвойствоШагаPreview(Шаг, "query", ""));
	ИначеЕсли ДействиеВРег = "GETMETADATA" ИЛИ ДействиеВРег = "GETOBJECTFIELDS" ИЛИ ДействиеВРег = "SHOWINFO" Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Выполнить действие " + Действие;
КонецФункции

Функция СформироватьКраткиеДанныеPreview(Данные, Поля)
	Если Данные = Неопределено ИЛИ (ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие")) Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Если ТипЗнч(Поля) = Тип("Массив") Тогда
		Для Каждого ИмяПоля Из Поля Цикл
			Значение = ПолучитьСвойствоШагаPreview(Данные, Строка(ИмяПоля), "");
			Если НЕ ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
				Части.Добавить(Строка(ИмяПоля) + "=" + Лев(Строка(Значение), 80));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Для Каждого КлючЗначение Из Данные Цикл
				Если Части.Количество() >= 8 Тогда
					Прервать;
				КонецЕсли;
				Если ПустаяСтрока(СокрЛП(Строка(КлючЗначение.Значение))) Тогда
					Продолжить;
				КонецЕсли;
				Части.Добавить(Строка(КлючЗначение.Ключ) + "=" + Лев(Строка(КлючЗначение.Значение), 80));
			КонецЦикла;
		Иначе
			Для Каждого КлючЗначение Из Данные Цикл
				Если Части.Количество() >= 8 Тогда
					Прервать;
				КонецЕсли;
				Если ПустаяСтрока(СокрЛП(Строка(КлючЗначение.Значение))) Тогда
					Продолжить;
				КонецЕсли;
				Части.Добавить(Строка(КлючЗначение.Ключ) + "=" + Лев(Строка(КлючЗначение.Значение), 80));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат " (" + СтрСоединить(Части, "; ") + ")";
КонецФункции

Функция ОписаниеRunQueryДляPreview(ТекстЗапроса)
	Текст = СокрЛП(Строка(ТекстЗапроса));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "Выполнить запрос 1С";
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Источник = "";
	ПозИз = СтрНайти(ТекстВРег, " ИЗ ");
	Если ПозИз = 0 Тогда
		ПозИз = СтрНайти(ТекстВРег, Символы.ПС + "ИЗ ");
	КонецЕсли;
	Если ПозИз > 0 Тогда
		Хвост = СокрЛП(Сред(Текст, ПозИз + 4));
		Части = СтрРазделить(Хвост, " " + Символы.ПС + Символы.Таб, Ложь);
		Если Части.Количество() > 0 Тогда
			Источник = Строка(Части[0]);
		КонецЕсли;
	КонецЕсли;
	Лимит = "";
	ПозПервые = СтрНайти(ТекстВРег, "ПЕРВЫЕ ");
	Если ПозПервые > 0 Тогда
		Остаток = Сред(Текст, ПозПервые + СтрДлина("ПЕРВЫЕ "));
		Цифры = "";
		Для Индекс = 1 По СтрДлина(Остаток) Цикл
			Символ = Сред(Остаток, Индекс, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				Цифры = Цифры + Символ;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПустаяСтрока(Цифры) Тогда
			Лимит = "ПЕРВЫЕ " + Цифры;
		КонецЕсли;
	КонецЕсли;
	ЧастиОписания = Новый Массив;
	ЧастиОписания.Добавить("Выполнить запрос 1С");
	Если НЕ ПустаяСтрока(Источник) Тогда
		ЧастиОписания.Добавить(Источник);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Лимит) Тогда
		ЧастиОписания.Добавить(Лимит);
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "СОЕДИНЕНИЕ") > 0 Тогда
		ЧастиОписания.Добавить("есть соединения");
	КонецЕсли;
	Возврат СтрСоединить(ЧастиОписания, ", ");
КонецФункции

Функция ПолучитьСвойствоШагаPreview(Объект, ИмяСвойства, ЗначениеПоУмолчанию = "")
	Если ТипЗнч(Объект) = Тип("Структура") Тогда
		Если Объект.Свойство(ИмяСвойства) Тогда
			Возврат Объект[ИмяСвойства];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("Соответствие") Тогда
		Значение = Объект.Получить(ИмяСвойства);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Процедура ЗафиксироватьApprovalDecision(СсылкаДиалога, Decision, СостояниеПодтверждения, ИмяПодграфа, ПричинаРешения, ВидЧекпоинта, СледующаяСтадия = "", ПричинаСостояния = "", СообщениеВДиалог = "") Экспорт
	ЛокИмяПодграфа = ?(ПустаяСтрока(ИмяПодграфа), "ExecuteSubgraph", ИмяПодграфа);
	Детали = Новый Структура("source,step_id,reason", "approval", ?(СостояниеПодтверждения <> Неопределено И СостояниеПодтверждения.Свойство("step_id"), Строка(СостояниеПодтверждения.step_id), ""), ПричинаРешения);
	Если СостояниеПодтверждения <> Неопределено И СостояниеПодтверждения.Свойство("risk_level") Тогда
		Детали.Вставить("risk_level", Строка(СостояниеПодтверждения.risk_level));
	КонецЕсли;
	ИИА_Сервер.ДобавитьРешениеВDecisionLog(СсылкаДиалога, "approval", Decision, ЛокИмяПодграфа, Детали);
	ИИА_Сервер.СохранитьЧекпоинтОркестратора(СсылкаДиалога, ВидЧекпоинта, ?(ПустаяСтрока(СледующаяСтадия), "AwaitApproval", СледующаяСтадия), СостояниеПодтверждения, ПричинаСостояния);
	Если НЕ ПустаяСтрока(СообщениеВДиалог) Тогда
		ИИА_Сервер.ДобавитьСообщениеВДиалог(СсылкаДиалога, Перечисления.ИИА_АвторСообщения.Система, Перечисления.ИИА_ТипСообщения.Текст, СообщениеВДиалог);
	КонецЕсли;
	Если НЕ ПустаяСтрока(СледующаяСтадия) Тогда
		ИИА_Сервер.УстановитьСостояниеОркестратора(СсылкаДиалога, СледующаяСтадия, ПричинаСостояния, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ЗапроситьПодтверждениеПользователя(СсылкаДиалога, DSLСценарий, ОценкаРиска, АртефактПлана, ИмяПодграфа = "") Экспорт
	StepId = ?(АртефактПлана <> Неопределено И АртефактПлана.Свойство("PlanStepId"), Строка(АртефактПлана.PlanStepId), "");
	Preview = СформироватьPreviewПодтверждения(DSLСценарий, ОценкаРиска);
	СостояниеПодтверждения = Новый Структура;
	СостояниеПодтверждения.Вставить("status", "pending");
	СостояниеПодтверждения.Вставить("risk_level", ?(ОценкаРиска.Свойство("risk_level"), ОценкаРиска.risk_level, ""));
	СостояниеПодтверждения.Вставить("reason", ?(ОценкаРиска.Свойство("reason"), ОценкаРиска.reason, ""));
	СостояниеПодтверждения.Вставить("preview", Preview);
	СостояниеПодтверждения.Вставить("planned_dsl", DSLСценарий);
	СостояниеПодтверждения.Вставить("step_id", StepId);
	СостояниеПодтверждения.Вставить("requested_at", ТекущаяДатаСеанса());
	СостояниеПодтверждения.Вставить("decision_at", Неопределено);
	СостояниеПодтверждения.Вставить("decision", "");
	СостояниеПодтверждения.Вставить("subgraph_name", ?(ПустаяСтрока(ИмяПодграфа), "ExecuteSubgraph", ИмяПодграфа));
	ИИА_Сервер.СохранитьСостояниеПодтверждения(СсылкаДиалога, СостояниеПодтверждения);
	ЗафиксироватьApprovalDecision(СсылкаДиалога, "requested", СостояниеПодтверждения, ?(ПустаяСтрока(ИмяПодграфа), "ExecuteSubgraph", ИмяПодграфа), ?(ОценкаРиска.Свойство("reason"), Строка(ОценкаРиска.reason), ""), "approval_requested", "AwaitApproval", "approval_required", Preview);
	ИИА_Оркестратор.ОбновитьСтатусПоследнегоСообщения(СсылкаДиалога, "Ожидает подтверждения пользователя");
КонецПроцедуры

#КонецОбласти
