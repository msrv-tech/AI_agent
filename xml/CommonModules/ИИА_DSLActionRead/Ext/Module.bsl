	Результат = СтрЗаменить(Результат, "Документ.реализациятоварыуслуг", "Документ.РеализацияТоваровУслуг");
	Результат = СтрЗаменить(Результат, "РеализацияТоваровУсллуг", "РеализацияТоваровУслуг");
	Возврат Результат;

КонецФункции

Функция УдалитьНеисполняемыеПодсказкиЗапроса(ТекстЗапроса)

	Результат = Строка(ТекстЗапроса);
	ПозицияИтогиПоПолям = СтрНайти(ВРег(Результат), "ИТОГИ ПО ПОЛЯМ");
	Если ПозицияИтогиПоПолям > 0 Тогда
		Результат = Лев(Результат, ПозицияИтогиПоПолям - 1);
	КонецЕсли;
	ПозицияИтогиПодведение = СтрНайти(ВРег(Результат), "ИТОГИ ПОДВЕДЕНИЕ");
	Если ПозицияИтогиПодведение > 0 Тогда
		Результат = Лев(Результат, ПозицияИтогиПодведение - 1);
	КонецЕсли;
	Результат = УдалитьСтрокиОдинокихИтогов(Результат);
	Результат = СтрЗаменить(Результат, Символы.ПС + "АВТОГРУППИРОВАТЬ", "");
	Результат = СтрЗаменить(Результат, Символы.ПС + "Автогруппировать", "");
	Результат = СтрЗаменить(Результат, Символы.ПС + "автогруппировать", "");
	Результат = СтрЗаменить(Результат, " АВТОГРУППИРОВАТЬ", "");
	Результат = СтрЗаменить(Результат, " Автогруппировать", "");
	Результат = СтрЗаменить(Результат, " автогруппировать", "");
	Возврат Результат;

КонецФункции

Функция УдалитьСтрокиОдинокихИтогов(ТекстЗапроса)

	СтрокиЗапроса = СтрРазделить(Строка(ТекстЗапроса), Символы.ПС, Ложь);
	Результат = "";
	НомерСтрокиРезультата = 0;
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		Если ВРег(СокрЛП(СтрокаЗапроса)) = "ИТОГИ" Тогда
			Продолжить;
		КонецЕсли;
		НомерСтрокиРезультата = НомерСтрокиРезультата + 1;
		Если НомерСтрокиРезультата > 1 Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + СтрокаЗапроса;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

