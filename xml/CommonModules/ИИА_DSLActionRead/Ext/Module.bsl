Функция ИсправитьСоюзИВСпискеСортировкиЗапроса(ТекстЗапроса)

	СтрокиЗапроса = СтрРазделить(Строка(ТекстЗапроса), Символы.ПС, Ложь);
	Результат = "";
	ВСпискеСортировки = Ложь;
	ЕстьПредыдущееПолеСортировки = Ложь;
	НомерСтроки = 0;
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = СтрокаЗапроса;
		СтрокаБезЛевыхПробелов = СокрЛ(ТекущаяСтрока);
		СтрокаВРег = ВРег(СтрокаБезЛевыхПробелов);
		
		Если ВСпискеСортировки И ЭтоНачалоНовогоРазделаЗапроса(СтрокаВРег) Тогда
			ВСпискеСортировки = Ложь;
			ЕстьПредыдущееПолеСортировки = Ложь;
		КонецЕсли;
		
		Если СтрНайти(СтрокаВРег, "УПОРЯДОЧИТЬ ПО") = 1 Тогда
			ВСпискеСортировки = Истина;
			ЕстьПредыдущееПолеСортировки = СтрДлина(СокрЛ(Сред(СтрокаБезЛевыхПробелов, СтрДлина("УПОРЯДОЧИТЬ ПО") + 1))) > 0;
		ИначеЕсли ВСпискеСортировки Тогда
			Если ЕстьПредыдущееПолеСортировки И Лев(СтрокаВРег, 2) = "И " Тогда
				Отступ = Лев(ТекущаяСтрока, СтрДлина(ТекущаяСтрока) - СтрДлина(СтрокаБезЛевыхПробелов));
				ТекущаяСтрока = Отступ + ", " + Сред(СтрокаБезЛевыхПробелов, 3);
			КонецЕсли;
			Если НЕ ПустаяСтрока(СокрЛ(ТекущаяСтрока)) Тогда
				ЕстьПредыдущееПолеСортировки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если НомерСтроки > 1 Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ИсправитьTopВЗапросе(ТекстЗапроса)

	СтрокиЗапроса = СтрРазделить(Строка(ТекстЗапроса), Символы.ПС, Ложь);
	Результат = "";
	НомерСтроки = 0;
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = СтрокаЗапроса;
		СтрокаБезЛевыхПробелов = СокрЛ(ТекущаяСтрока);
		СтрокаВРег = ВРег(СтрокаБезЛевыхПробелов);
		Если СтрНайти(СтрокаВРег, "ТОП ") = 1 Тогда
			Отступ = Лев(ТекущаяСтрока, СтрДлина(ТекущаяСтрока) - СтрДлина(СтрокаБезЛевыхПробелов));
			ТекущаяСтрока = Отступ + "ПЕРВЫЕ " + СокрЛ(Сред(СтрокаБезЛевыхПробелов, СтрДлина("ТОП ") + 1));
		КонецЕсли;
		
		Если НомерСтроки > 1 Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ИсправитьПоискСсылкиПоНаименованиюВЗапросе(ТекстЗапроса)

	СтрокиЗапроса = СтрРазделить(Строка(ТекстЗапроса), Символы.ПС, Ложь);
	Результат = "";
	НомерСтроки = 0;
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		НомерСтроки = НомерСтроки + 1;
		ТекущаяСтрока = СтрокаЗапроса;
		СтрокаВРег = ВРег(ТекущаяСтрока);
		ПозицияФункции = СтрНайти(СтрокаВРег, "= ЗНАЧЕНИЕ(СПРАВОЧНИК.");
		ПозицияМетода = СтрНайти(СтрокаВРег, ".НАЙТИПОНАИМЕНОВАНИЮ(");
		Если ПозицияФункции > 0 И ПозицияМетода > ПозицияФункции Тогда
			ЛеваяЧасть = СокрП(Лев(ТекущаяСтрока, ПозицияФункции - 1));
			ХвостСтроки = Сред(ТекущаяСтрока, ПозицияМетода);
			ПозицияКавычкиНачало = СтрНайти(ХвостСтроки, """");
			Если ПозицияКавычкиНачало > 0 Тогда
				ХвостПослеПервойКавычки = Сред(ХвостСтроки, ПозицияКавычкиНачало + 1);
				ПозицияКавычкиКонец = СтрНайти(ХвостПослеПервойКавычки, """");
				Если ПозицияКавычкиКонец > 0 Тогда
					ЗначениеНаименования = Лев(ХвостПослеПервойКавычки, ПозицияКавычкиКонец - 1);
					ТекущаяСтрока = ЛеваяЧасть + ".Наименование = """ + ЗначениеНаименования + """";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НомерСтроки > 1 Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция УдалитьОборванныеКлючевыеСловаЗапроса(ТекстЗапроса)

	СтрокиЗапроса = СтрРазделить(Строка(ТекстЗапроса), Символы.ПС, Ложь);
	Результат = "";
	НомерСтрокиРезультата = 0;
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		СтрокаВРег = ВРег(СокрЛП(СтрокаЗапроса));
		Если (СтрНайти(СтрокаВРег, "УПОР") = 1 И СтрНайти(СтрокаВРег, "УПОРЯДОЧИТЬ") <> 1)
			Или (СтрНайти(СтрокаВРег, "СГРУП") = 1 И СтрНайти(СтрокаВРег, "СГРУППИРОВАТЬ") <> 1) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиРезультата = НомерСтрокиРезультата + 1;
		Если НомерСтрокиРезультата > 1 Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + СтрокаЗапроса;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ЭтоНачалоНовогоРазделаЗапроса(СтрокаВРег)

	Возврат СтрНайти(СтрокаВРег, "ГДЕ") = 1
		Или СтрНайти(СтрокаВРег, "СГРУППИРОВАТЬ") = 1
		Или СтрНайти(СтрокаВРег, "ИМЕЮЩИЕ") = 1
		Или СтрНайти(СтрокаВРег, "ИТОГИ") = 1
		Или СтрНайти(СтрокаВРег, "ОБЪЕДИНИТЬ") = 1
		Или СтрНайти(СтрокаВРег, "ДЛЯ ИЗМЕНЕНИЯ") = 1;

КонецФункции

Функция ИсправитьПолеСуммыПоПодтвержденнымРеквизитам(ТекстЗапроса, КонтекстВыполнения)

	Если КонтекстВыполнения = Неопределено
		Или НЕ КонтекстВыполнения.Свойство("DSL_РазрешенныеПоляОбъекта")
		Или ТипЗнч(КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта) <> Тип("Массив") Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	ПоляОбъекта = КонтекстВыполнения.DSL_РазрешенныеПоляОбъекта;
	Если ПоляОбъекта.Найти("Сумма") <> Неопределено Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	ПолеСуммы = ВыбратьПодтвержденноеПолеСуммы(ПоляОбъекта);
	Если ПустаяСтрока(ПолеСуммы) Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	Результат = Строка(ТекстЗапроса);
	Результат = СтрЗаменить(Результат, ".Сумма)", "." + ПолеСуммы + ")");
	Результат = СтрЗаменить(Результат, ".Сумма ", "." + ПолеСуммы + " ");
	Результат = СтрЗаменить(Результат, ".Сумма,", "." + ПолеСуммы + ",");
	Результат = СтрЗаменить(Результат, ".Сумма" + Символы.ПС, "." + ПолеСуммы + Символы.ПС);
	Результат = СтрЗаменить(Результат, "СУММА(Сумма)", "СУММА(" + ПолеСуммы + ")");
	Результат = СтрЗаменить(Результат, "СУММА( Сумма )", "СУММА(" + ПолеСуммы + ")");
	Возврат Результат;

КонецФункции

Функция ВыбратьПодтвержденноеПолеСуммы(ПоляОбъекта)

	ПриоритетныеПоля = Новый Массив;
	ПриоритетныеПоля.Добавить("СуммаДокумента");
	ПриоритетныеПоля.Добавить("СуммаВключаетНДС");
	ПриоритетныеПоля.Добавить("Всего");
	ПриоритетныеПоля.Добавить("Итого");
	ПриоритетныеПоля.Добавить("СуммаОборот");
	ПриоритетныеПоля.Добавить("Стоимость");
	ПриоритетныеПоля.Добавить("СуммаРегл");

	Для Каждого ИмяПоля Из ПриоритетныеПоля Цикл
		Если ПоляОбъекта.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяПоля Из ПоляОбъекта Цикл
		ИмяВРег = ВРег(Строка(ИмяПоля));
		Если СтрНайти(ИмяВРег, "СУММ") > 0
			ИЛИ СтрНайти(ИмяВРег, "СТОИМОСТ") > 0
			ИЛИ СтрНайти(ИмяВРег, "ИТОГО") > 0 Тогда
			Возврат Строка(ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИсправитьПоложениеПервыеВЗапросе(ТекстЗапроса)
	Результат = Строка(ТекстЗапроса);
	ТекстВРег = ВРег(Результат);
	Префикс = "ВЫБРАТЬ";
	Если Лев(СокрЛП(ТекстВРег), СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Результат;
	КонецЕсли;
	ПозПервые = СтрНайти(ТекстВРег, "ПЕРВЫЕ ");
	Если ПозПервые = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ПозВыбрать = СтрНайти(ТекстВРег, Префикс);
	Если ПозПервые <= ПозВыбрать + СтрДлина(Префикс) + 2 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Остаток = Сред(Результат, ПозПервые + СтрДлина("ПЕРВЫЕ "));
	ЧислоСтрок = "";
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			ЧислоСтрок = ЧислоСтрок + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ЧислоСтрок) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФрагментПервые = "ПЕРВЫЕ " + ЧислоСтрок;
	Результат = СтрЗаменить(Результат, Символы.ПС + ФрагментПервые, "");
	Результат = СтрЗаменить(Результат, Символы.ВК + ФрагментПервые, "");
	Результат = СтрЗаменить(Результат, Символы.Таб + ФрагментПервые, "");
	Результат = СтрЗаменить(Результат, " " + ФрагментПервые, "");
	ПозВыбрать = СтрНайти(ВРег(Результат), Префикс);
	Если ПозВыбрать > 0 Тогда
		Результат = Лев(Результат, ПозВыбрать + СтрДлина(Префикс) - 1)
			+ " ПЕРВЫЕ " + ЧислоСтрок
			+ Сред(Результат, ПозВыбрать + СтрДлина(Префикс));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ИсправитьПорядокДобавитьКДате(ТекстЗапроса, КонтекстВыполнения = Неопределено)

	Результат = Строка(ТекстЗапроса);
	Результат = ИсправитьКонструированиеДняЧерезДатаВремя(Результат);
	Если СтрНайти(ВРег(Результат), "ТЕКУЩАЯДАТА()") = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Сейчас = ТекущаяДата();
	НачалоТекущегоМесяца = Дата(Год(Сейчас), Месяц(Сейчас), 1);
	ПоследнийДеньПрошлогоМесяца = НачалоТекущегоМесяца - 24 * 60 * 60;
	НачалоПрошлогоМесяца = Дата(Год(ПоследнийДеньПрошлогоМесяца), Месяц(ПоследнийДеньПрошлогоМесяца), 1);
	КонецПрошлогоМесяца = КонецДня(ПоследнийДеньПрошлогоМесяца);

	ЛитералНачалоПрошлогоМесяца = ПостроитьЛитералДаты1СДляЗапроса(НачалоПрошлогоМесяца);
	ЛитералКонецПрошлогоМесяца = ПостроитьЛитералДаты1СДляЗапроса(КонецПрошлогоМесяца);
	ЛитералСейчас = ПостроитьЛитералДаты1СДляЗапроса(Сейчас);

	Если ЗадачаПользователяПроПрошлыйМесяц(КонтекстВыполнения) Тогда
		Результат = ИсправитьДинамическиеГраницыПрошлогоМесяца(Результат, ЛитералНачалоПрошлогоМесяца, ЛитералКонецПрошлогоМесяца);
	КонецЕсли;

	Если ЗадачаПользователяПроПрошлыйМесяц(КонтекстВыполнения) Тогда
		Результат = СтрЗаменить(Результат, "НАЧАЛОПЕРИОДА(ТЕКУЩАЯДАТА(), МЕСЯЦ)", ЛитералНачалоПрошлогоМесяца);
		Результат = СтрЗаменить(Результат, "КОНЕЦПЕРИОДА(ТЕКУЩАЯДАТА(), МЕСЯЦ)", ЛитералКонецПрошлогоМесяца);
		Результат = СтрЗаменить(Результат, "НАЧАЛОПЕРИОДА(ТекущаяДата(), МЕСЯЦ)", ЛитералНачалоПрошлогоМесяца);
		Результат = СтрЗаменить(Результат, "КОНЕЦПЕРИОДА(ТекущаяДата(), МЕСЯЦ)", ЛитералКонецПрошлогоМесяца);
	КонецЕсли;

	Результат = СтрЗаменить(Результат, "НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(ТЕКУЩАЯДАТА(), МЕСЯЦ, -1), МЕСЯЦ)", ЛитералНачалоПрошлогоМесяца);
	Результат = СтрЗаменить(Результат, "КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(ТЕКУЩАЯДАТА(), МЕСЯЦ, -1), МЕСЯЦ)", ЛитералКонецПрошлогоМесяца);
	Результат = СтрЗаменить(Результат, "НАЧАЛОПЕРИОДА(ТЕКУЩАЯДАТА(), МЕСЯЦ) - 1 МЕСЯЦ", ЛитералНачалоПрошлогоМесяца);
	Результат = СтрЗаменить(Результат, "КОНЕЦПЕРИОДА(ТЕКУЩАЯДАТА(), МЕСЯЦ) - 1 МЕСЯЦ", ЛитералКонецПрошлогоМесяца);
	Результат = СтрЗаменить(Результат, "НАЧАЛОПЕРИОДА(ТекущаяДата(), МЕСЯЦ) - 1 МЕСЯЦ", ЛитералНачалоПрошлогоМесяца);
	Результат = СтрЗаменить(Результат, "КОНЕЦПЕРИОДА(ТекущаяДата(), МЕСЯЦ) - 1 МЕСЯЦ", ЛитералКонецПрошлогоМесяца);
	Результат = СтрЗаменить(Результат, "ТЕКУЩАЯДАТА()", ЛитералСейчас);
	Результат = СтрЗаменить(Результат, "ТекущаяДата()", ЛитералСейчас);

	Возврат Результат;

КонецФункции

Функция ИсправитьПорядокАргументовДатаВремя(ТекстЗапроса)

	Результат = Строка(ТекстЗапроса);
	ПозицияПоиска = 1;
	
	Пока Истина Цикл
		ПозицияФункции = НайтиПодстрокуСПозиции(ВРег(Результат), "ДАТАВРЕМЯ(", ПозицияПоиска);
		Если ПозицияФункции = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозицияОткрывающейСкобки = ПозицияФункции + СтрДлина("ДАТАВРЕМЯ");
		ПозицияЗакрывающейСкобки = НайтиЗакрывающуюСкобкуБезВложенности(Результат, ПозицияОткрывающейСкобки);
		Если ПозицияЗакрывающейСкобки = 0 Тогда
			ПозицияПоиска = ПозицияФункции + 1;
			Продолжить;
		КонецЕсли;
		
		Аргументы = Сред(Результат, ПозицияОткрывающейСкобки + 1, ПозицияЗакрывающейСкобки - ПозицияОткрывающейСкобки - 1);
		Части = СтрРазделить(Аргументы, ",", Ложь);
		Если Части.Количество() < 3 Тогда
			ПозицияПоиска = ПозицияЗакрывающейСкобки + 1;
			Продолжить;
		КонецЕсли;
		
		ПервыйАргумент = ЧислоИзСтрокиИлиНеопределено(ПолучитьЭлементМассиваУниверсальноЛокально(Части, 0));
		ВторойАргумент = ЧислоИзСтрокиИлиНеопределено(ПолучитьЭлементМассиваУниверсальноЛокально(Части, 1));
		ТретийАргумент = ЧислоИзСтрокиИлиНеопределено(ПолучитьЭлементМассиваУниверсальноЛокально(Части, 2));
		Если ПервыйАргумент = Неопределено Или ВторойАргумент = Неопределено Или ТретийАргумент = Неопределено Тогда
			ПозицияПоиска = ПозицияЗакрывающейСкобки + 1;
			Продолжить;
		КонецЕсли;
		
		Если ПервыйАргумент >= 1 И ПервыйАргумент <= 31
			И ВторойАргумент >= 1 И ВторойАргумент <= 12
			И ТретийАргумент >= 1000 Тогда
			НовыеАргументы = Строка(ТретийАргумент) + "," + Строка(ВторойАргумент) + "," + Строка(ПервыйАргумент);
			Для ИндексАргумента = 3 По Части.Количество() - 1 Цикл
				НовыеАргументы = НовыеАргументы + "," + СокрЛП(Строка(ПолучитьЭлементМассиваУниверсальноЛокально(Части, ИндексАргумента)));
			КонецЦикла;
			Результат = Лев(Результат, ПозицияОткрывающейСкобки) + НовыеАргументы + Сред(Результат, ПозицияЗакрывающейСкобки);
			ПозицияПоиска = ПозицияОткрывающейСкобки + СтрДлина(НовыеАргументы) + 1;
		Иначе
			ПозицияПоиска = ПозицияЗакрывающейСкобки + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ИсправитьДатаВремяОтносительноТекущейДаты(ТекстЗапроса)

	Результат = Строка(ТекстЗапроса);
	ПозицияПоиска = 1;

	Пока Истина Цикл
		ТекстВРег = ВРег(Результат);
		ПозицияФункции = НайтиПодстрокуСПозиции(ТекстВРег, "ДАТАВРЕМЯ(", ПозицияПоиска);
		Если ПозицияФункции = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияОткрывающейСкобки = ПозицияФункции + СтрДлина("ДАТАВРЕМЯ");
		ПозицияЗакрывающейСкобки = НайтиЗакрывающуюСкобкуБезВложенности(Результат, ПозицияОткрывающейСкобки);
		Если ПозицияЗакрывающейСкобки = 0 Тогда
			ПозицияПоиска = ПозицияФункции + 1;
			Продолжить;
		КонецЕсли;

		Аргументы = Сред(Результат, ПозицияОткрывающейСкобки + 1, ПозицияЗакрывающейСкобки - ПозицияОткрывающейСкобки - 1);
		ЛитералДаты = ЛитералДатыОтносительноТекущейДаты(Аргументы);
		Если ПустаяСтрока(ЛитералДаты) Тогда
			ПозицияПоиска = ПозицияЗакрывающейСкобки + 1;
			Продолжить;
		КонецЕсли;

		Результат = Лев(Результат, ПозицияФункции - 1) + ЛитералДаты + Сред(Результат, ПозицияЗакрывающейСкобки + 1);
		ПозицияПоиска = ПозицияФункции + СтрДлина(ЛитералДаты);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛитералДатыОтносительноТекущейДаты(Аргументы)

	Попытка
		Выражение = ВРег(СокрЛП(СтрЗаменить(Строка(Аргументы), " ", "")));
		Если СтрНайти(Выражение, "ТЕКУЩАЯДАТА") <> 1 Тогда
			Возврат "";
		КонецЕсли;

		СмещениеДней = 0;
		Если Выражение = "ТЕКУЩАЯДАТА" Или Выражение = "ТЕКУЩАЯДАТА()" Тогда
			СмещениеДней = 0;
		ИначеЕсли СтрНайти(Выражение, "ТЕКУЩАЯДАТА-") = 1 Тогда
			СмещениеДней = -Число(Сред(Выражение, СтрДлина("ТЕКУЩАЯДАТА-") + 1));
		ИначеЕсли СтрНайти(Выражение, "ТЕКУЩАЯДАТА()+") = 1 Тогда
			СмещениеДней = Число(Сред(Выражение, СтрДлина("ТЕКУЩАЯДАТА()+") + 1));
		ИначеЕсли СтрНайти(Выражение, "ТЕКУЩАЯДАТА()-") = 1 Тогда
			СмещениеДней = -Число(Сред(Выражение, СтрДлина("ТЕКУЩАЯДАТА()-") + 1));
		ИначеЕсли СтрНайти(Выражение, "ТЕКУЩАЯДАТА+") = 1 Тогда
			СмещениеДней = Число(Сред(Выражение, СтрДлина("ТЕКУЩАЯДАТА+") + 1));
		Иначе
			Возврат "";
		КонецЕсли;

		Возврат ПостроитьЛитералДаты1СДляЗапроса(ТекущаяДата() + СмещениеДней * 24 * 60 * 60);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция НайтиЗакрывающуюСкобкуБезВложенности(Текст, ПозицияОткрывающейСкобки)

	Для Позиция = ПозицияОткрывающейСкобки + 1 По СтрДлина(Текст) Цикл
		Если Сред(Текст, Позиция, 1) = ")" Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция НайтиПодстрокуСПозиции(Текст, Подстрока, НачальнаяПозиция)

	Если НачальнаяПозиция <= 1 Тогда
		Возврат СтрНайти(Текст, Подстрока);
	КонецЕсли;

	Хвост = Сред(Текст, НачальнаяПозиция);
	ПозицияВХвосте = СтрНайти(Хвост, Подстрока);
	Если ПозицияВХвосте = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат НачальнаяПозиция + ПозицияВХвосте - 1;

КонецФункции

Функция ЧислоИзСтрокиИлиНеопределено(Значение)

	Попытка
		Возврат Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПолучитьЭлементМассиваУниверсальноЛокально(МассивЗначений, Индекс)

	Если МассивЗначений = Неопределено Или Индекс < 0 Или Индекс >= МассивЗначений.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат МассивЗначений[Индекс];

КонецФункции

Функция ИсправитьДинамическиеГраницыПрошлогоМесяца(ТекстЗапроса, ЛитералНачалоПрошлогоМесяца, ЛитералКонецПрошлогоМесяца)

	СтрокиЗапроса = СтрРазделить(Строка(ТекстЗапроса), Символы.ПС, Ложь);
	Результат = "";
	НомерСтрокиРезультата = 0;
	ПропуститьСледующуюДинамическуюГраницу = Ложь;
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		ТекущаяСтрока = СтрокаЗапроса;
		СтрокаВРег = ВРег(ТекущаяСтрока);
		СтрокаБезПробелов = СтрЗаменить(СтрокаВРег, " ", "");
		ЭтоДинамическаяДата = СтрНайти(СтрокаБезПробелов, "ДАТАВРЕМЯ(ГОД(") > 0 И СтрНайти(СтрокаБезПробелов, "МЕСЯЦ(") > 0;
		
		Если ПропуститьСледующуюДинамическуюГраницу И ЭтоДинамическаяДата И СтрНайти(ВРег(СокрЛ(ТекущаяСтрока)), "И ДАТАВРЕМЯ(") = 1 Тогда
			ПропуститьСледующуюДинамическуюГраницу = Ложь;
			Продолжить;
		КонецЕсли;
		ПропуститьСледующуюДинамическуюГраницу = Ложь;
		
		Если ЭтоДинамическаяДата Тогда
			ПозицияМежду = СтрНайти(СтрокаВРег, " МЕЖДУ ");
			ПозицияБольшеРавно = СтрНайти(СтрокаВРег, ">=");
			ПозицияМеньше = СтрНайти(СтрокаВРег, "<");
			Если ПозицияМежду > 0 Тогда
				ТекущаяСтрока = Лев(ТекущаяСтрока, ПозицияМежду + СтрДлина(" МЕЖДУ ") - 1)
					+ ЛитералНачалоПрошлогоМесяца + " И " + ЛитералКонецПрошлогоМесяца;
				ПропуститьСледующуюДинамическуюГраницу = Истина;
			ИначеЕсли ПозицияБольшеРавно > 0 Тогда
				ТекущаяСтрока = Лев(ТекущаяСтрока, ПозицияБольшеРавно + СтрДлина(">=") - 1)
					+ " " + ЛитералНачалоПрошлогоМесяца;
			ИначеЕсли ПозицияМеньше > 0 Тогда
				ТекущаяСтрока = Лев(ТекущаяСтрока, ПозицияМеньше - 1)
					+ "<= " + ЛитералКонецПрошлогоМесяца;
			КонецЕсли;
		КонецЕсли;
		
		НомерСтрокиРезультата = НомерСтрокиРезультата + 1;
		Если НомерСтрокиРезультата > 1 Тогда
			Результат = Результат + Символы.ПС;
		КонецЕсли;
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ЗадачаПользователяПроПрошлыйМесяц(КонтекстВыполнения)

	Если КонтекстВыполнения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(КонтекстВыполнения) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ КонтекстВыполнения.Свойство("СсылкаДиалога") Тогда
		Возврат Ложь;
	КонецЕсли;

	ПоследнееСообщение = ИИА_Сервер.ПолучитьПоследнееСообщениеПользователя(КонтекстВыполнения.СсылкаДиалога);
	Если ПоследнееСообщение = Неопределено Или НЕ ПоследнееСообщение.Свойство("Найдено") Или НЕ ПоследнееСообщение.Найдено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстВРег = ВРег(Строка(ПоследнееСообщение.Текст));
	Возврат СтрНайти(ТекстВРег, "ПРОШЛ") > 0 И СтрНайти(ТекстВРег, "МЕСЯЦ") > 0;

КонецФункции

Функция ИсправитьКонструированиеДняЧерезДатаВремя(ТекстЗапроса)

	Результат = Строка(ТекстЗапроса);
	Результат = ИсправитьКонструированиеДняДляПоля(Результат, "РасходнаяНакладная.Дата");
	Результат = ИсправитьКонструированиеДняДляПоля(Результат, "Отчет.Дата");
	Результат = ИсправитьКонструированиеДняДляПоля(Результат, "Документ.Дата");
	Результат = ИсправитьКонструированиеДняДляПоля(Результат, "Продажи.Период");
	Результат = ИсправитьКонструированиеДняДляПоля(Результат, "Период");
	Возврат Результат;

КонецФункции

Функция ИсправитьКонструированиеДняДляПоля(ТекстЗапроса, ПолеДаты)

	Шаблон = "ДАТАВРЕМЯ(ГОД(" + ПолеДаты + "), МЕСЯЦ(" + ПолеДаты + "), ДЕНЬ(" + ПолеДаты + "))";
	Замена = "НАЧАЛОПЕРИОДА(" + ПолеДаты + ", ДЕНЬ)";
	Результат = СтрЗаменить(ТекстЗапроса, Шаблон, Замена);

	ШаблонБезПробелов = "ДАТАВРЕМЯ(ГОД(" + ПолеДаты + "),МЕСЯЦ(" + ПолеДаты + "),ДЕНЬ(" + ПолеДаты + "))";
	Результат = СтрЗаменить(Результат, ШаблонБезПробелов, Замена);

	Возврат Результат;

КонецФункции

Функция ПостроитьЛитералДаты1СДляЗапроса(ДатаЗначение)

	Возврат "ДАТАВРЕМЯ("
		+ Формат(Год(ДатаЗначение), "ЧГ=0; ЧН=0") + ","
		+ Формат(Месяц(ДатаЗначение), "ЧГ=0; ЧН=0") + ","
		+ Формат(День(ДатаЗначение), "ЧГ=0; ЧН=0") + ","
		+ Формат(Час(ДатаЗначение), "ЧГ=0; ЧН=0") + ","
		+ Формат(Минута(ДатаЗначение), "ЧГ=0; ЧН=0") + ","
		+ Формат(Секунда(ДатаЗначение), "ЧГ=0; ЧН=0") + ")";

КонецФункции

