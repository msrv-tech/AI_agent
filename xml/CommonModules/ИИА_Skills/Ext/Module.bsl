Функция ПерваяСтрока(Текст)

	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Если Строки.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат СокрЛП(Строки[0]);

КонецФункции

Функция СформироватьЗаголовокИзОписания(Текст, ЦелевойОбъект = Неопределено)

	ТекстНРег = НРег(Текст);
	Если ЦелевойОбъект <> Неопределено И НЕ ПустаяСтрока(ЦелевойОбъект.Представление) Тогда
		Если СтрНайти(ТекстНРег, "созда") > 0
			ИЛИ СтрНайти(ТекстНРег, "оформ") > 0
			ИЛИ СтрНайти(ТекстНРег, "запис") > 0 Тогда
			Возврат СократитьСтроку("Создание: " + ЦелевойОбъект.Представление, 80);
		КонецЕсли;
		Если СтрНайти(ТекстНРег, "покаж") > 0
			ИЛИ СтрНайти(ТекстНРег, "отчет") > 0
			ИЛИ СтрНайти(ТекстНРег, "отчёт") > 0
			ИЛИ СтрНайти(ТекстНРег, "найд") > 0 Тогда
			Возврат СократитьСтроку("Анализ: " + ЦелевойОбъект.Представление, 80);
		КонецЕсли;
		Возврат СократитьСтроку(ЦелевойОбъект.Представление, 80);
	КонецЕсли;
	Возврат СократитьСтроку(ПерваяСтрока(Текст), 80);

КонецФункции

Функция ИзвлечьТриггерыИзОписания(Текст)

	ТекстНРег = НРег(Текст);
	Триггеры = Новый Массив;

	Если СтрНайти(ТекстНРег, "заказ") > 0 Тогда
		Триггеры.Добавить("оформи заказ");
		Триггеры.Добавить("создай заказ");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "заявк") > 0 Тогда
		Триггеры.Добавить("оформи заявку");
		Триггеры.Добавить("создай заявку");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "оплат") > 0 ИЛИ СтрНайти(ТекстНРег, "плат") > 0 Тогда
		Триггеры.Добавить("заявка на оплату");
		Триггеры.Добавить("подготовь платеж");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "документ") > 0 Тогда
		Триггеры.Добавить("создай документ");
		Триггеры.Добавить("оформи документ");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "контрагент") > 0 Тогда
		Триггеры.Добавить("создай контрагента");
		Триггеры.Добавить("добавь контрагента");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "справочник") > 0 Тогда
		Триггеры.Добавить("создай элемент справочника");
		Триггеры.Добавить("добавь элемент справочника");
	КонецЕсли;
	Если Триггеры.Количество() = 0 Тогда
		Триггеры.Добавить(СократитьСтроку(ПерваяСтрока(Текст), 80));
	КонецЕсли;

	Возврат СтрСоединить(Триггеры, ", ");

КонецФункции

Функция ОписаниеПроситНеТребоватьПодтверждение(Текст)

	ТекстНРег = НРег(Текст);
	Если (СтрНайти(ТекстНРег, "не запис") > 0
		ИЛИ СтрНайти(ТекстНРег, "не созда") > 0
		ИЛИ СтрНайти(ТекстНРег, "не провод") > 0)
		И СтрНайти(ТекстНРег, "без подтверж") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстНРег, "подтверждение не нужно") > 0
		ИЛИ СтрНайти(ТекстНРег, "без подтверждения") > 0
		ИЛИ СтрНайти(ТекстНРег, "не требуй подтверждение") > 0
		ИЛИ СтрНайти(ТекстНРег, "не требовать подтверждение") > 0;

КонецФункции

Функция ОписаниеПохожеНаЗапись(Текст)

	ТекстНРег = НРег(Текст);
	Возврат СтрНайти(ТекстНРег, "созда") > 0
		ИЛИ СтрНайти(ТекстНРег, "добав") > 0
		ИЛИ СтрНайти(ТекстНРег, "запис") > 0
		ИЛИ СтрНайти(ТекстНРег, "оформ") > 0
		ИЛИ СтрНайти(ТекстНРег, "заполн") > 0
		ИЛИ СтрНайти(ТекстНРег, "измен") > 0;

КонецФункции

Функция ОпределитьРискСкила(Текст, ЦелевойОбъект)

	Если ОписаниеПохожеНаЗапись(Текст) Тогда
		Возврат "write";
	КонецЕсли;
	Если ЦелевойОбъект <> Неопределено И ЦелевойОбъект.Тип = "Document" Тогда
		Возврат "write";
	КонецЕсли;
	Возврат "read";

КонецФункции

Функция ОпределитьТипОбъектаИзОписания(Текст)

	ЦелевойОбъект = НайтиЦелевойОбъектИзОписания(Текст);
	Если НЕ ПустаяСтрока(ЦелевойОбъект.Тип) Тогда
		Возврат ЦелевойОбъект.Тип;
	КонецЕсли;

	ТекстНРег = НРег(Текст);
	Если СтрНайти(ТекстНРег, "документ") > 0
		ИЛИ СтрНайти(ТекстНРег, "заказ") > 0
		ИЛИ СтрНайти(ТекстНРег, "заявк") > 0
		ИЛИ СтрНайти(ТекстНРег, "реализац") > 0 Тогда
		Возврат "Document";
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "справочник") > 0
		ИЛИ СтрНайти(ТекстНРег, "контрагент") > 0
		ИЛИ СтрНайти(ТекстНРег, "номенклатур") > 0 Тогда
		Возврат "Catalog";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ИзвлечьИмяОбъектаИзОписания(Текст)

	ЦелевойОбъект = НайтиЦелевойОбъектИзОписания(Текст);
	Если НЕ ПустаяСтрока(ЦелевойОбъект.Имя) Тогда
		Возврат ЦелевойОбъект.Имя;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Кандидаты.Добавить("ЗаявкаНаРасходованиеДенежныхСредств");
	Кандидаты.Добавить("ЗаказКлиента");
	Кандидаты.Добавить("ЗаказПокупателя");
	Кандидаты.Добавить("РеализацияТоваровУслуг");
	Кандидаты.Добавить("Контрагенты");
	Кандидаты.Добавить("Номенклатура");

	ТекстБезПробелов = СтрЗаменить(НРег(Текст), " ", "");
	Для Каждого Кандидат Из Кандидаты Цикл
		Если СтрНайти(ТекстБезПробелов, НРег(Кандидат)) > 0 Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти(НРег(Текст), "заявк") > 0 И СтрНайти(НРег(Текст), "оплат") > 0 Тогда
		Возврат "ЗаявкаНаРасходованиеДенежныхСредств";
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "заказ") > 0 Тогда
		Возврат "ЗаказКлиента";
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "контрагент") > 0 Тогда
		Возврат "Контрагенты";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция НайтиЦелевойОбъектИзОписания(Текст)

	Результат = Новый Структура("Тип,Имя,Представление", "", "", "");
	ТекстДляПоиска = НормализоватьТекстДляПоискаМетаданных(Текст);

	Найденный = НайтиДокументПоБизнесАлиасу(ТекстДляПоиска);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Найденный = НайтиОбъектВКоллекцииМетаданных(Метаданные.Документы, "Document", ТекстДляПоиска);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Найденный = НайтиОбъектВКоллекцииМетаданных(Метаданные.Справочники, "Catalog", ТекстДляПоиска);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Найденный = НайтиОбъектВКоллекцииМетаданных(Метаданные.РегистрыСведений, "InformationRegister", ТекстДляПоиска);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Возврат НайтиЦелевойОбъектЭвристикой(Текст);

КонецФункции

Функция НайтиДокументПоБизнесАлиасу(ТекстДляПоиска)

	Если СтрНайти(ТекстДляПоиска, "заказклиента") > 0
		ИЛИ СтрНайти(ТекстДляПоиска, "заказпокупателя") > 0 Тогда
		Найденный = НайтиОбъектМетаданныхПоИменам(Метаданные.Документы, "Document", СтрРазделить("ЗаказКлиента,ЗаказПокупателя", ",", Ложь));
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиОбъектМетаданныхПоИменам(КоллекцияМетаданных, ТипОбъекта, Имена)

	Для Каждого ИмяКандидата Из Имена Цикл
		Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
			Если ОбъектМетаданных.Имя = ИмяКандидата Тогда
				Возврат Новый Структура("Тип,Имя,Представление", ТипОбъекта, ОбъектМетаданных.Имя, ПредставлениеОбъектаМетаданных(ОбъектМетаданных));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция НайтиЦелевойОбъектЭвристикой(Текст)

	ТекстНРег = НРег(Текст);
	ТекстБезПробелов = СтрЗаменить(ТекстНРег, " ", "");

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Новый Структура("Тип,Имя,Представление", "Document", "ЗаявкаНаРасходованиеДенежныхСредств", "Заявка на расходование денежных средств"));
	Кандидаты.Добавить(Новый Структура("Тип,Имя,Представление", "Document", "ЗаказКлиента", "Заказ клиента"));
	Кандидаты.Добавить(Новый Структура("Тип,Имя,Представление", "Document", "ЗаказПокупателя", "Заказ покупателя"));
	Кандидаты.Добавить(Новый Структура("Тип,Имя,Представление", "Document", "РеализацияТоваровУслуг", "Реализация товаров и услуг"));
	Кандидаты.Добавить(Новый Структура("Тип,Имя,Представление", "Catalog", "Контрагенты", "Контрагенты"));
	Кандидаты.Добавить(Новый Структура("Тип,Имя,Представление", "Catalog", "Номенклатура", "Номенклатура"));

	Для Каждого Кандидат Из Кандидаты Цикл
		Если СтрНайти(ТекстБезПробелов, НРег(Кандидат.Имя)) > 0 Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

	Если СтрНайти(ТекстНРег, "заявк") > 0 И СтрНайти(ТекстНРег, "оплат") > 0 Тогда
		Возврат Новый Структура("Тип,Имя,Представление", "Document", "ЗаявкаНаРасходованиеДенежныхСредств", "Заявка на оплату");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "заказ") > 0 Тогда
		Возврат Новый Структура("Тип,Имя,Представление", "Document", "ЗаказКлиента", "Заказ клиента");
	КонецЕсли;
	Если СтрНайти(ТекстНРег, "контрагент") > 0 Тогда
		Возврат Новый Структура("Тип,Имя,Представление", "Catalog", "Контрагенты", "Контрагенты");
	КонецЕсли;

	Возврат Новый Структура("Тип,Имя,Представление", "", "", "");

КонецФункции

Функция НайтиОбъектВКоллекцииМетаданных(КоллекцияМетаданных, ТипОбъекта, ТекстДляПоиска)

	Лучший = Неопределено;
	ЛучшийВес = 0;

	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		ИмяНорм = НормализоватьТекстДляПоискаМетаданных(ОбъектМетаданных.Имя);
		Синоним = Строка(ОбъектМетаданных.Синоним);
		СинонимНорм = НормализоватьТекстДляПоискаМетаданных(Синоним);
		Если НЕ ПустаяСтрока(ИмяНорм) И СтрНайти(ТекстДляПоиска, ИмяНорм) > 0 Тогда
			Вес = 1000 + СтрДлина(ИмяНорм);
			Если Вес > ЛучшийВес Тогда
				ЛучшийВес = Вес;
				Лучший = Новый Структура("Тип,Имя,Представление", ТипОбъекта, ОбъектМетаданных.Имя, ПредставлениеОбъектаМетаданных(ОбъектМетаданных));
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПустаяСтрока(СинонимНорм) И СтрНайти(ТекстДляПоиска, СинонимНорм) > 0 Тогда
			Вес = 500 + СтрДлина(СинонимНорм);
			Если Вес > ЛучшийВес Тогда
				ЛучшийВес = Вес;
				Лучший = Новый Структура("Тип,Имя,Представление", ТипОбъекта, ОбъектМетаданных.Имя, ПредставлениеОбъектаМетаданных(ОбъектМетаданных));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Лучший;

КонецФункции

Функция ПредставлениеОбъектаМетаданных(ОбъектМетаданных)

	Синоним = СокрЛП(Строка(ОбъектМетаданных.Синоним));
	Если НЕ ПустаяСтрока(Синоним) Тогда
		Возврат Синоним;
	КонецЕсли;
	Возврат ОбъектМетаданных.Имя;

КонецФункции

Функция НормализоватьТекстДляПоискаМетаданных(Текст)

	Результат = НРег(СокрЛП(Строка(Текст)));
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, "_", "");
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, """", "");
	Результат = СтрЗаменить(Результат, "'", "");
	Результат = СтрЗаменить(Результат, ".", "");
	Результат = СтрЗаменить(Результат, ",", "");
	Возврат Результат;

КонецФункции

Функция СформироватьИнструкциюИзОписания(Текст, ТребоватьПодтверждение = Истина)

	СтрокаПодтверждения = ?(ТребоватьПодтверждение,
		"Перед записью показывай предварительный результат и запрашивай подтверждение, если skill связан с записью. ",
		"Перед записью показывай предварительный результат; дополнительное подтверждение не запрашивай, если пользователь явно его отключил. ");
	Инструкция = "Выполняй пользовательский skill по описанной процедуре. "
		+ "Перед изменением данных проверяй метаданные и поля. "
		+ СтрокаПодтверждения
		+ "Описание процедуры: " + Текст;
	Возврат Инструкция;

КонецФункции

Функция СформироватьБлокDSLШаблонаСкила(Скил)

	Если НЕ Скил.Свойство("dsl_template_json") И НЕ Скил.Свойство("template_vars_json") Тогда
		Возврат "";
	КонецЕсли;

	DSLTemplateJSON = ?(Скил.Свойство("dsl_template_json"), СокрЛП(Строка(Скил.dsl_template_json)), "");
	TemplateVarsJSON = ?(Скил.Свойство("template_vars_json"), СокрЛП(Строка(Скил.template_vars_json)), "");
	Если (ПустаяСтрока(DSLTemplateJSON) ИЛИ DSLTemplateJSON = "{}")
		И (ПустаяСтрока(TemplateVarsJSON) ИЛИ TemplateVarsJSON = "{}") Тогда
		Возврат "";
	КонецЕсли;

	Режим = ?(Скил.Свойство("dsl_template_mode"), НормализоватьРежимDSLШаблона(Скил.dsl_template_mode), "hint");
	Блок = "DSL_TEMPLATE_MODE: " + Режим + Символы.ПС;
	Если НЕ ПустаяСтрока(TemplateVarsJSON) И TemplateVarsJSON <> "{}" Тогда
		Блок = Блок + "TEMPLATE_VARS_JSON: " + СократитьСтроку(TemplateVarsJSON, 900) + Символы.ПС;
	КонецЕсли;
	Если НЕ ПустаяСтрока(DSLTemplateJSON) И DSLTemplateJSON <> "{}" Тогда
		Блок = Блок + "DSL_TEMPLATE_JSON: " + СократитьСтроку(DSLTemplateJSON, 1600) + Символы.ПС;
	КонецЕсли;
	Если Режим = "strict" Тогда
		Блок = Блок + "Требование: итоговый DSL должен строго следовать DSL_TEMPLATE_JSON; не добавляй действия вне шаблона без явной причины." + Символы.ПС;
	ИначеЕсли Режим = "validate" Тогда
		Блок = Блок + "Требование: используй DSL_TEMPLATE_JSON как проверяемый каркас; адаптируй только значения и безопасные уточняющие шаги." + Символы.ПС;
	Иначе
		Блок = Блок + "Подсказка: используй DSL_TEMPLATE_JSON как предпочтительный каркас, если он подходит к запросу пользователя." + Символы.ПС;
	КонецЕсли;
	Возврат Блок;

КонецФункции

Функция СформироватьБлокСекцийСкила(Скил)

	Блок = "";
	Applicability = ПолучитьApplicabilityСкила(Скил);
	Если Applicability <> Неопределено Тогда
		Блок = Блок + "APPLICABILITY_JSON: " + СократитьСтроку(ЗначениеВJSON(Applicability), 700) + Символы.ПС;
	КонецЕсли;
	ReferencePolicy = ПолучитьReferencePolicyСкила(Скил);
	Если ReferencePolicy <> Неопределено Тогда
		Блок = Блок + "REFERENCE_POLICY_JSON: " + СократитьСтроку(ЗначениеВJSON(ReferencePolicy), 700) + Символы.ПС;
	КонецЕсли;
	DocumentMapping = ПолучитьDocumentMappingСкила(Скил);
	Если DocumentMapping <> Неопределено Тогда
		Блок = Блок + "DOCUMENT_MAPPING_JSON: " + СократитьСтроку(ЗначениеВJSON(DocumentMapping), 1000) + Символы.ПС;
	КонецЕсли;
	Возврат Блок;

КонецФункции

Функция НормализоватьРежимDSLШаблона(Режим)

	Результат = НРег(СокрЛП(Строка(Режим)));
	Если Результат = "strict" ИЛИ Результат = "validate" ИЛИ Результат = "hint" Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат "hint";

КонецФункции

Функция СформироватьTemplateVarsJSONИзОписания(Текст, ЦелевойОбъект = Неопределено)

	ТекстНорм = НРег(Текст);
	Переменные = Новый Структура;
	Если СтрНайти(ТекстНорм, "контрагент") > 0 ИЛИ СтрНайти(ТекстНорм, "клиент") > 0 Тогда
		Переменные.Вставить("customer", СоздатьОписаниеПеременнойШаблона("CatalogRef.Контрагенты", Истина, "user_prompt"));
	КонецЕсли;
	Если СтрНайти(ТекстНорм, "номенклатур") > 0 ИЛИ СтрНайти(ТекстНорм, "товар") > 0 ИЛИ СтрНайти(ТекстНорм, "позици") > 0 Тогда
		Переменные.Вставить("items", СоздатьОписаниеПеременнойШаблона("array", Истина, "user_prompt"));
	КонецЕсли;
	Если СтрНайти(ТекстНорм, "сумм") > 0 ИЛИ СтрНайти(ТекстНорм, "цен") > 0 Тогда
		Переменные.Вставить("amount", СоздатьОписаниеПеременнойШаблона("number", Ложь, "user_prompt"));
	КонецЕсли;
	Если СтрНайти(ТекстНорм, "дат") > 0 Тогда
		Переменные.Вставить("date", СоздатьОписаниеПеременнойШаблона("date", Ложь, "user_prompt"));
	КонецЕсли;
	Если ЦелевойОбъект <> Неопределено И НЕ ПустаяСтрока(ЦелевойОбъект.Имя) Тогда
		Переменные.Вставить("target_object", СоздатьОписаниеПеременнойШаблона(ЦелевойОбъект.Тип + "." + ЦелевойОбъект.Имя, Истина, "skill"));
	КонецЕсли;
	Возврат ЗначениеВJSON(Переменные);

КонецФункции

Функция СоздатьОписаниеПеременнойШаблона(Тип, Обязательная, Источник)

	Описание = Новый Структура;
	Описание.Вставить("type", Тип);
	Описание.Вставить("required", Обязательная);
	Описание.Вставить("source", Источник);
	Возврат Описание;

КонецФункции

Функция СформироватьDSLTemplateJSONИзОписания(Текст, ЦелевойОбъект = Неопределено, ТребоватьПодтверждение = Истина)

	Шаги = Новый Массив;
	ИмяОбъекта = "";
	ТипОбъекта = "";
	Если ЦелевойОбъект <> Неопределено Тогда
		ИмяОбъекта = ЦелевойОбъект.Имя;
		ТипОбъекта = ЦелевойОбъект.Тип;
	КонецЕсли;

	ЦелевойОбъектDSL = ?(ПустаяСтрока(ТипОбъекта) ИЛИ ПустаяСтрока(ИмяОбъекта), "", ТипОбъекта + "." + ИмяОбъекта);
	Шаги.Добавить(СоздатьШагDSLШаблона("GetMetadata", ЦелевойОбъектDSL, "", "metadata"));
	Если СтрНайти(НРег(Текст), "контрагент") > 0 ИЛИ СтрНайти(НРег(Текст), "клиент") > 0 Тогда
		Шаги.Добавить(СоздатьШагDSLШаблона("FindReferenceByName", "Catalog.Контрагенты", "$customer", "customer_ref"));
	КонецЕсли;
	Если ТипОбъекта = "Document" Тогда
		Шаги.Добавить(СоздатьШагDSLШаблона("CreateDocument", ИмяОбъекта, "", "document_ref"));
		Если СтрНайти(НРег(Текст), "контрагент") > 0 ИЛИ СтрНайти(НРег(Текст), "клиент") > 0 Тогда
			Шаги.Добавить(СоздатьШагУстановкиПоляDSLШаблона("$document_ref", "Контрагент", "$customer_ref"));
		КонецЕсли;
		Если СтрНайти(НРег(Текст), "номенклатур") > 0 ИЛИ СтрНайти(НРег(Текст), "товар") > 0 Тогда
			Шаги.Добавить(СоздатьШагУстановкиПоляDSLШаблона("$document_ref", "Товары", "$items"));
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "Catalog" Тогда
		Шаги.Добавить(СоздатьШагDSLШаблона("CreateReference", ИмяОбъекта, "", "reference_ref"));
	КонецЕсли;
	СообщениеПредпросмотра = ?(ТребоватьПодтверждение,
		"Предварительный результат подготовлен. Запись только после подтверждения пользователя.",
		"Предварительный результат подготовлен. Подтверждение пользователем для этого skill отключено.");
	Шаги.Добавить(СоздатьШагDSLШаблона("ShowInfo", "", СообщениеПредпросмотра, ""));

	Шаблон = Новый Структура;
	Шаблон.Вставить("dsl_version", 1);
	Шаблон.Вставить("steps", Шаги);
	Возврат ЗначениеВJSON(Шаблон);

КонецФункции

Функция СоздатьШагDSLШаблона(Действие, Объект, Значение = "", SaveAs = "")

	Шаг = Новый Структура;
	Шаг.Вставить("action", Действие);
	Если НЕ ПустаяСтрока(Объект) Тогда
		Шаг.Вставить("object", Объект);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Значение) Тогда
		Если ВРег(Строка(Действие)) = "SHOWINFO" Тогда
			Шаг.Вставить("message", Значение);
		Иначе
			Шаг.Вставить("value", Значение);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ПустаяСтрока(SaveAs) Тогда
		Шаг.Вставить("save_as", SaveAs);
	КонецЕсли;
	Возврат Шаг;

КонецФункции

Функция СформироватьTemplateVarsJSONРаспознаванияДокумента(ИмяДокумента)

	Переменные = Новый Структура;
	Переменные.Вставить("source_attachment", СоздатьОписаниеПеременнойШаблона("attachment.image_or_pdf", Истина, "attachment"));
	Переменные.Вставить("document_number", СоздатьОписаниеПеременнойШаблона("string", Ложь, "ocr"));
	Переменные.Вставить("document_date", СоздатьОписаниеПеременнойШаблона("date", Ложь, "ocr"));
	Переменные.Вставить("supplier", СоздатьОписаниеПеременнойШаблона("CatalogRef.Контрагенты", Истина, "ocr"));
	Переменные.Вставить("buyer", СоздатьОписаниеПеременнойШаблона("CatalogRef.Контрагенты", Ложь, "ocr"));
	Переменные.Вставить("total", СоздатьОписаниеПеременнойШаблона("number", Ложь, "ocr"));
