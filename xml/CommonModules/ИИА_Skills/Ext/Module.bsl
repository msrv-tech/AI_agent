Функция СформироватьWorkflowJSONИзОписания(Текст, ЦелевойОбъект = Неопределено, ТребоватьПодтверждение = Истина)

	Шаги = Новый Массив;
	Шаги.Добавить("Понять параметры из сообщения пользователя");
	Шаги.Добавить("Проверить метаданные и доступные поля");
	Если СтрНайти(НРег(Текст), "контрагент") > 0 Тогда
		Шаги.Добавить("Найти контрагента");
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "договор") > 0 Тогда
		Шаги.Добавить("Найти договор");
	КонецЕсли;
	Если ЦелевойОбъект <> Неопределено И ЦелевойОбъект.Тип = "Document" Тогда
		Шаги.Добавить("Создать документ " + ЦелевойОбъект.Имя);
		Шаги.Добавить("Заполнить обязательные реквизиты документа");
	ИначеЕсли ЦелевойОбъект <> Неопределено И ЦелевойОбъект.Тип = "Catalog" Тогда
		Шаги.Добавить("Найти или создать элемент справочника " + ЦелевойОбъект.Имя);
		Шаги.Добавить("Заполнить обязательные реквизиты элемента");
	ИначеЕсли ЦелевойОбъект <> Неопределено И ЦелевойОбъект.Тип = "InformationRegister" Тогда
		Шаги.Добавить("Подготовить запись регистра сведений " + ЦелевойОбъект.Имя);
		Шаги.Добавить("Заполнить измерения и ресурсы регистра");
	ИначеЕсли СтрНайти(НРег(Текст), "документ") > 0 ИЛИ СтрНайти(НРег(Текст), "заказ") > 0 ИЛИ СтрНайти(НРег(Текст), "заявк") > 0 Тогда
		Шаги.Добавить("Создать документ");
		Шаги.Добавить("Заполнить обязательные реквизиты документа");
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "сумм") > 0 Тогда
		Шаги.Добавить("Заполнить сумму");
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "дат") > 0 И СтрНайти(НРег(Текст), "плат") > 0 Тогда
		Шаги.Добавить("Заполнить дату платежа");
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "назначен") > 0 Тогда
		Шаги.Добавить("Заполнить назначение платежа");
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "товар") > 0 ИЛИ СтрНайти(НРег(Текст), "номенклатур") > 0 Тогда
		Шаги.Добавить("Заполнить товары");
	КонецЕсли;
	Шаги.Добавить("Показать предварительный результат");
	Если ТребоватьПодтверждение Тогда
		Шаги.Добавить("Записать только после подтверждения");
	ИначеЕсли ОписаниеПохожеНаЗапись(Текст) Тогда
		Шаги.Добавить("Записать без дополнительного подтверждения");
	КонецЕсли;

	Возврат МассивВJSON(Шаги);

КонецФункции

Функция СформироватьPolicyJSON(Риск, Enforcement, ТребоватьПодтверждение)

	Allowed = ?(Риск = "read",
		"GetMetadata,GetObjectFields,CheckObjectExists,RunQuery,ShowInfo",
		"GetMetadata,GetObjectFields,CheckObjectExists,FindReferenceByName,CreateReference,CreateDocument,SetField,AddTableRow,RunQuery,Write,ShowInfo");
	RequiredChecks = Новый Массив;
	Если Риск = "write" Тогда
		RequiredChecks.Добавить("metadata_before_write");
		Если ТребоватьПодтверждение Тогда
			RequiredChecks.Добавить("approval_before_write");
		КонецЕсли;
	КонецЕсли;

	Policy = Новый Структура;
	Policy.Вставить("risk_level", Риск);
	Policy.Вставить("enforcement", Enforcement);
	Policy.Вставить("approval_required", ТребоватьПодтверждение);
	Policy.Вставить("allowed_actions", СтрРазделить(Allowed, ",", Ложь));
	Policy.Вставить("forbidden_actions", СтрРазделить("PostDocument,DeleteObject", ",", Ложь));
	Policy.Вставить("required_checks", RequiredChecks);
	Возврат ЗначениеВJSON(Policy);

КонецФункции

Функция ПолучитьAllowedActionsИзPolicy(PolicyJSON, Риск)

	Policy = JSONВЗначение(PolicyJSON);
	Если Policy <> Неопределено И Policy.Свойство("allowed_actions") Тогда
		Возврат СтрСоединить(Policy.allowed_actions, ",");
	КонецЕсли;
	Если Риск = "read" Тогда
		Возврат "GetMetadata,GetObjectFields,CheckObjectExists,RunQuery,ShowInfo";
	КонецЕсли;
	Возврат "GetMetadata,GetObjectFields,CheckObjectExists,FindReferenceByName,CreateReference,CreateDocument,SetField,AddTableRow,RunQuery,Write,ShowInfo";

КонецФункции

Функция ПолучитьForbiddenActionsИзPolicy(PolicyJSON)

	Policy = JSONВЗначение(PolicyJSON);
	Если Policy <> Неопределено И Policy.Свойство("forbidden_actions") Тогда
		Возврат СтрСоединить(Policy.forbidden_actions, ",");
	КонецЕсли;
	Возврат "PostDocument,DeleteObject";

КонецФункции

Функция МассивВJSON(МассивЗначений)

	Возврат ЗначениеВJSON(МассивЗначений);

КонецФункции

Функция ЗначениеВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция JSONВЗначение(ТекстJSON)

	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Значение = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Возврат Значение;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция JSONВЗначениеСтрого(ТекстJSON)

	Если ПустаяСтрока(ТекстJSON) Тогда
		ВызватьИсключение "Заполните JSON skill.";
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Значение = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Возврат Значение;
	Исключение
		ВызватьИсключение "Некорректный JSON skill: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

Процедура УстановитьПолеКарточкиИзJSON(Карточка, Данные, ИмяПоляКарточки, ИмяПоляJSON)

	ЗначениеПоля = Неопределено;
	Если Данные.Свойство(ИмяПоляJSON, ЗначениеПоля) Тогда
		Карточка.Вставить(ИмяПоляКарточки, Строка(ЗначениеПоля));
	КонецЕсли;

КонецПроцедуры

Функция JSONПолеВСтроку(ЗначениеПоля)

	Если ТипЗнч(ЗначениеПоля) = Тип("Массив") Тогда
		Значения = Новый Массив;
		Для Каждого Элемент Из ЗначениеПоля Цикл
			Значения.Добавить(Строка(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Значения, ", ");
	КонецЕсли;

	Возврат Строка(ЗначениеПоля);

КонецФункции

