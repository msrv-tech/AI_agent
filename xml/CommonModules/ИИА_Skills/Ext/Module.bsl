Функция ПолучитьАктивныеСкилы() Экспорт

	Результат = Новый Массив;
	Для Каждого Скил Из ПолучитьРеестрСкилов() Цикл
		Если Скил.enabled Тогда
			Результат.Добавить(Скил);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьСкил(ИмяСкила) Экспорт

	Для Каждого Скил Из ПолучитьРеестрСкилов() Цикл
		Если Скил.name = ИмяСкила Тогда
			Возврат Скил;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПодобратьСкилы(ТекстПользователя, ТипДиалога, Контекст = Неопределено, Максимум = 3) Экспорт

	Кандидаты = Новый Массив;
	НормТекст = НРег(СокрЛП(Строка(ТекстПользователя)));
	ИмяТипаДиалога = НормализоватьТипДиалога(ТипДиалога);
	Если ИмяТипаДиалога = "распознаваниедокументов" Тогда
		Максимум = 1;
	КонецЕсли;

	Для Каждого Скил Из ПолучитьАктивныеСкилы() Цикл
		Если НЕ СкилРазрешенДляТипаДиалога(Скил, ИмяТипаДиалога) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ СкилПрименимКТекущейКонфигурации(Скил) Тогда
			Продолжить;
		КонецЕсли;

		Score = ОценитьСкил(Скил, НормТекст);
		Если Score > 0 Тогда
			Кандидат = Новый Структура;
			Кандидат.Вставить("Скил", Скил);
			Кандидат.Вставить("Score", Score);
			Кандидаты.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Возврат ВыбратьЛучшиеСкилы(Кандидаты, Максимум);

КонецФункции

Функция СформироватьБлокСкилов(Скилы, МаксимумСимволов = 4000) Экспорт

	Если Скилы = Неопределено ИЛИ Скилы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Блок = "АКТИВНЫЕ SKILLS:" + Символы.ПС;
	Для Каждого Скил Из Скилы Цикл
		СтрокаЦелевогоОбъекта = "";
		Если Скил.Свойство("target_object_type") ИЛИ Скил.Свойство("target_object_name") Тогда
			СтрокаЦелевогоОбъекта = "target_object_type=" + ?(Скил.Свойство("target_object_type"), Строка(Скил.target_object_type), "")
				+ "; target_object_name=" + ?(Скил.Свойство("target_object_name"), Строка(Скил.target_object_name), "") + Символы.ПС;
		КонецЕсли;
		СтрокаСкила = Символы.ПС
			+ "[" + Скил.name + " v" + Строка(Скил.version) + "]" + Символы.ПС
			+ СтрокаЦелевогоОбъекта
			+ СократитьСтроку(Скил.prompt, Скил.max_prompt_chars) + Символы.ПС
			+ СформироватьБлокСекцийСкила(Скил)
			+ СформироватьБлокDSLШаблонаСкила(Скил)
			+ "Policy: risk_level=" + Скил.risk_level
			+ "; enforcement=" + Скил.enforcement
			+ "; approval_required=" + ?(Скил.approval_required, "true", "false") + "." + Символы.ПС;

		Если СтрДлина(Блок + СтрокаСкила) > МаксимумСимволов Тогда
			Прервать;
		КонецЕсли;
		Блок = Блок + СтрокаСкила;
	КонецЦикла;

	Возврат Блок;

КонецФункции

Функция ПолучитьИменаСкиловСтрокой(Скилы) Экспорт

	Имена = Новый Массив;
	Если Скилы <> Неопределено Тогда
		Для Каждого Скил Из Скилы Цикл
			Имена.Добавить(Скил.name);
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

Функция ПроверитьDSLПоСкилам(DSLJSON, Скилы, Режим = "warn") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("Нарушения", Новый Массив);
	Результат.Вставить("Режим", Режим);

	Если ПустаяСтрока(DSLJSON) ИЛИ Скилы = Неопределено ИЛИ Скилы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Сценарий = РазобратьDSL(DSLJSON);
	Если Сценарий = Неопределено ИЛИ НЕ Сценарий.Свойство("steps") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Шаг Из Сценарий.steps Цикл
		Если ТипЗнч(Шаг) <> Тип("Структура") ИЛИ НЕ Шаг.Свойство("action") Тогда
			Продолжить;
		КонецЕсли;
		Действие = Строка(Шаг.action);
		Для Каждого Скил Из Скилы Цикл
			ПроверитьДействиеПоСкилу(Результат, Скил, Действие);
		КонецЦикла;
	КонецЦикла;

	Если Результат.Нарушения.Количество() > 0 И НРег(Режим) = "strict" Тогда
		Результат.Успех = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПолучитьПользовательскиеСкилы() Экспорт

	Результат = Новый Массив;

	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Скилы.Имя КАК Имя,
		|	Скилы.Заголовок КАК Заголовок,
		|	Скилы.Описание КАК Описание,
		|	Скилы.Владелец КАК Владелец,
		|	Скилы.ОбластьВидимости КАК ОбластьВидимости,
		|	Скилы.Активен КАК Активен,
		|	Скилы.Версия КАК Версия,
		|	Скилы.Триггеры КАК Триггеры,
		|	Скилы.ТипыДиалогов КАК ТипыДиалогов,
		|	Скилы.ЦелевойОбъектТип КАК ЦелевойОбъектТип,
		|	Скилы.ЦелевойОбъектИмя КАК ЦелевойОбъектИмя,
		|	Скилы.Инструкция КАК Инструкция,
		|	Скилы.WorkflowJSON КАК WorkflowJSON,
		|	Скилы.PolicyJSON КАК PolicyJSON,
		|	Скилы.TemplateVarsJSON КАК TemplateVarsJSON,
		|	Скилы.DSLTemplateJSON КАК DSLTemplateJSON,
		|	Скилы.DSLTemplateMode КАК DSLTemplateMode,
		|	Скилы.Enforcement КАК Enforcement,
		|	Скилы.Риск КАК Риск,
		|	Скилы.ТребоватьПодтверждение КАК ТребоватьПодтверждение
		|ИЗ
		|	РегистрСведений.ИИА_Скилы КАК Скилы
		|ГДЕ
		|	Скилы.Активен = ИСТИНА");

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(СоздатьПользовательскийСкилИзВыборки(Выборка));
		КонецЦикла;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ПолучитьСписокСкиловДляФормы() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя");
	Таблица.Колонки.Добавить("Заголовок");
	Таблица.Колонки.Добавить("Активен");
	Таблица.Колонки.Добавить("Владелец");

	Для Каждого Скил Из ПолучитьРеестрСкилов() Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Имя = Скил.name;
		СтрокаТаблицы.Заголовок = Скил.title;
		СтрокаТаблицы.Активен = Скил.enabled;
		СтрокаТаблицы.Владелец = ?(Скил.Свойство("owner"), Скил.owner, "system");
	КонецЦикла;

	Возврат Таблица;

КонецФункции

