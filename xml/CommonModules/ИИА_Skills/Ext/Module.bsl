Функция СформироватьDocumentMappingРаспознаванияДокумента(ИдКонфигурации, ИмяДокумента)

	Mapping = Новый Структура;
	HeaderFields = Новый Структура;
	HeaderFields.Вставить("number", СтрРазделить("НомерВходящегоДокумента,НомерДокумента,ВходящийНомер,НомерСчетаФактуры,Номер", ",", Ложь));
	HeaderFields.Вставить("date", СтрРазделить("ДатаВходящегоДокумента,ДатаДокумента,ВходящаяДата,ДатаСчетаФактуры,Дата", ",", Ложь));
	HeaderFields.Вставить("total_amount", СтрРазделить("СуммаДокумента,Сумма,Всего,СуммаВключаетНДС", ",", Ложь));
	HeaderFields.Вставить("vat_amount", СтрРазделить("СуммаНДС,НДС", ",", Ложь));
	Mapping.Вставить("header_fields", HeaderFields);

	TableParts = Новый Массив;
	TablePart = Новый Структура;
	TablePart.Вставить("name_candidates", ПолучитьКандидатыТабличныхЧастейРаспознавания(ИдКонфигурации, ИмяДокумента));
	ItemFields = Новый Структура;
	ItemFields.Вставить("name", СтрРазделить("Номенклатура,Содержание,Наименование", ",", Ложь));
	ItemFields.Вставить("quantity", СтрРазделить("Количество,Кол", ",", Ложь));
	ItemFields.Вставить("price", СтрРазделить("Цена,ЦенаЗаЕдиницу", ",", Ложь));
	ItemFields.Вставить("amount", СтрРазделить("Сумма,Всего,СуммаДокумента", ",", Ложь));
	ItemFields.Вставить("vat_amount", СтрРазделить("СуммаНДС,НДС", ",", Ложь));
	ItemFields.Вставить("vat_rate", СтрРазделить("СтавкаНДС,СтавкаНалога", ",", Ложь));
	TablePart.Вставить("item_fields", ItemFields);
	TableParts.Добавить(TablePart);
	Mapping.Вставить("table_parts", TableParts);
	Возврат Mapping;

КонецФункции

Функция ПолучитьКандидатыТабличныхЧастейРаспознавания(ИдКонфигурации, ИмяДокумента)

	Если ИдКонфигурации = "UNF" И ИмяДокумента = "АктВыполненныхРабот" Тогда
		Возврат СтрРазделить("РаботыИУслуги,Услуги,ТоварыИУслуги,Состав", ",", Ложь);
	КонецЕсли;
	Если ИдКонфигурации = "UNF" И ИмяДокумента = "ПриходнаяНакладная" Тогда
		Возврат СтрРазделить("Запасы,Товары,ТоварыИУслуги,Состав", ",", Ложь);
	КонецЕсли;
	Если ИдКонфигурации = "BP" И ИмяДокумента = "ПоступлениеТоваровУслуг" Тогда
		Возврат СтрРазделить("Услуги,Товары,ВозвратнаяТара,АгентскиеУслуги", ",", Ложь);
	КонецЕсли;
	Возврат СтрРазделить("Товары,Запасы,Услуги,РаботыИУслуги,ТоварыИУслуги,Состав,РасшифровкаПлатежа", ",", Ложь);

КонецФункции

Функция СформироватьDSLTemplateJSONРаспознаванияДокумента(ИмяДокумента, ПредставлениеДокумента)

	Шаги = Новый Массив;
	Шаги.Добавить(СоздатьШагGetMetadataDSLШаблона(ИмяДокумента, "metadata"));
	Шаги.Добавить(СоздатьШагGetObjectFieldsDSLШаблона("Документ", ИмяДокумента, "fields"));
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Комментарий", "$user_task");
	Шаги.Добавить(СоздатьШагCreateDocumentDSLШаблона(ИмяДокумента, "document_ref", ДанныеДокумента));
	Шаги.Добавить(СоздатьШагЗаписиDSLШаблона("$document_ref"));
	Шаги.Добавить(СоздатьШагDSLШаблона("ShowInfo", "", "Создан черновик документа " + ПредставлениеДокумента + ": {СсылкаОбъекта}. Проведение не выполнялось.", ""));

	Шаблон = Новый Структура;
	Шаблон.Вставить("dsl_version", 1);
	Шаблон.Вставить("steps", Шаги);
	Возврат ЗначениеВJSON(Шаблон);

