Функция ЭтоСистемнаяКарточкаСкила(Карточка)

	Если Карточка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Карточка.Свойство("Имя") И ЭтоСистемныйСкил(Карточка.Имя) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Карточка.Свойство("Владелец") И НРег(СокрЛП(Строка(Карточка.Владелец))) = "system" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

