Функция ЭтоСистемныйСкил(ИмяСкила)

	ИмяНорм = НРег(СокрЛП(Строка(ИмяСкила)));
	Возврат ИмяНорм = "query-1c-safe"
		ИЛИ ИмяНорм = "metadata-discovery"
		ИЛИ ИмяНорм = "dsl-recovery"
		ИЛИ ИмяНорм = "create-reference-safe"
		ИЛИ ИмяНорм = "document-workflow";

