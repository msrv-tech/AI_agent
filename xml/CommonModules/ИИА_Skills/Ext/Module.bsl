	Карточка.Вставить("DSLTemplateJSON", "{}");
	Карточка.Вставить("DSLTemplateMode", "hint");
	Карточка.Вставить("Enforcement", "warn");
	Карточка.Вставить("Риск", "write");
	Карточка.Вставить("ТребоватьПодтверждение", Истина);
	Возврат Карточка;

КонецФункции

Функция КарточкаВJSON(Карточка) Экспорт

	Если Карточка = Неопределено Тогда
		Карточка = НоваяКарточкаСкила();
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("name", Карточка.Имя);
	Данные.Вставить("title", Карточка.Заголовок);
	Данные.Вставить("description", Карточка.Описание);
	Данные.Вставить("enabled", Карточка.Активен);
	Данные.Вставить("version", Карточка.Версия);
	Данные.Вставить("triggers", РазделитьСписокЗначений(Карточка.Триггеры));
	Данные.Вставить("dialog_types", РазделитьСписокЗначений(Карточка.ТипыДиалогов));
	Данные.Вставить("target_object_type", Карточка.ЦелевойОбъектТип);
	Данные.Вставить("target_object_name", Карточка.ЦелевойОбъектИмя);
	Данные.Вставить("prompt", Карточка.Инструкция);
	Данные.Вставить("risk_level", Карточка.Риск);
	Данные.Вставить("enforcement", Карточка.Enforcement);
	Данные.Вставить("approval_required", Карточка.ТребоватьПодтверждение);
	Данные.Вставить("owner", Карточка.Владелец);
	Данные.Вставить("scope", Карточка.ОбластьВидимости);

	Workflow = JSONВЗначение(Карточка.WorkflowJSON);
	Если Workflow = Неопределено Тогда
		Данные.Вставить("workflow_json", Карточка.WorkflowJSON);
	Иначе
		Данные.Вставить("workflow", Workflow);
	КонецЕсли;

	Policy = JSONВЗначение(Карточка.PolicyJSON);
	Если Policy = Неопределено Тогда
		Данные.Вставить("policy_json", Карточка.PolicyJSON);
	Иначе
		Данные.Вставить("policy", Policy);
		Если Policy.Свойство("applicability") Тогда
			Данные.Вставить("applicability", Policy.applicability);
		КонецЕсли;
		Если Policy.Свойство("reference_policy") Тогда
			Данные.Вставить("reference_policy", Policy.reference_policy);
		КонецЕсли;
	КонецЕсли;

	TemplateVars = JSONВЗначение(Карточка.TemplateVarsJSON);
	Если TemplateVars = Неопределено Тогда
		Данные.Вставить("template_vars_json", Карточка.TemplateVarsJSON);
	Иначе
		Данные.Вставить("template_vars", TemplateVars);
		Если TemplateVars.Свойство("document_mapping") Тогда
			Данные.Вставить("document_mapping", TemplateVars.document_mapping);
		КонецЕсли;
	КонецЕсли;

	DSLTemplate = JSONВЗначение(Карточка.DSLTemplateJSON);
	Если DSLTemplate = Неопределено Тогда
		Данные.Вставить("dsl_template_json", Карточка.DSLTemplateJSON);
	Иначе
		Данные.Вставить("dsl_template", DSLTemplate);
	КонецЕсли;
	Данные.Вставить("dsl_template_mode", ?(ПустаяСтрока(Карточка.DSLTemplateMode), "hint", Карточка.DSLTemplateMode));

	Возврат ЗначениеВJSON(Данные);

КонецФункции

Функция КарточкаИзJSON(ТекстJSON) Экспорт

	Данные = JSONВЗначениеСтрого(ТекстJSON);
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "JSON skill должен быть объектом.";
	КонецЕсли;

	Карточка = НоваяКарточкаСкила();
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Имя", "name");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Заголовок", "title");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Описание", "description");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "ЦелевойОбъектТип", "target_object_type");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "ЦелевойОбъектИмя", "target_object_name");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Инструкция", "prompt");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Риск", "risk_level");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Enforcement", "enforcement");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "Владелец", "owner");
	УстановитьПолеКарточкиИзJSON(Карточка, Данные, "ОбластьВидимости", "scope");

	ЗначениеПоля = Неопределено;
	Если Данные.Свойство("enabled", ЗначениеПоля) Тогда
		Карточка.Активен = ЗначениеПоля;
	КонецЕсли;
	Если Данные.Свойство("version", ЗначениеПоля) Тогда
		Карточка.Версия = ЗначениеПоля;
	КонецЕсли;
	Если Данные.Свойство("approval_required", ЗначениеПоля) Тогда
		Карточка.ТребоватьПодтверждение = ЗначениеПоля;
	КонецЕсли;
	Если Данные.Свойство("triggers", ЗначениеПоля) Тогда
		Карточка.Триггеры = JSONПолеВСтроку(ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("dialog_types", ЗначениеПоля) Тогда
		Карточка.ТипыДиалогов = JSONПолеВСтроку(ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("workflow", ЗначениеПоля) Тогда
		Карточка.WorkflowJSON = ЗначениеВJSON(ЗначениеПоля);
	ИначеЕсли Данные.Свойство("workflow_json", ЗначениеПоля) Тогда
		Карточка.WorkflowJSON = Строка(ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("policy", ЗначениеПоля) Тогда
		Карточка.PolicyJSON = ЗначениеВJSON(ЗначениеПоля);
	ИначеЕсли Данные.Свойство("policy_json", ЗначениеПоля) Тогда
		Карточка.PolicyJSON = Строка(ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("applicability", ЗначениеПоля) Тогда
		Карточка.PolicyJSON = УстановитьСекциюJSON(Карточка.PolicyJSON, "applicability", ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("reference_policy", ЗначениеПоля) Тогда
		Карточка.PolicyJSON = УстановитьСекциюJSON(Карточка.PolicyJSON, "reference_policy", ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("template_vars", ЗначениеПоля) Тогда
		Карточка.TemplateVarsJSON = ЗначениеВJSON(ЗначениеПоля);
	ИначеЕсли Данные.Свойство("template_vars_json", ЗначениеПоля) Тогда
		Карточка.TemplateVarsJSON = Строка(ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("document_mapping", ЗначениеПоля) Тогда
		Карточка.TemplateVarsJSON = УстановитьСекциюJSON(Карточка.TemplateVarsJSON, "document_mapping", ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("dsl_template", ЗначениеПоля) Тогда
		Карточка.DSLTemplateJSON = ЗначениеВJSON(ЗначениеПоля);
	ИначеЕсли Данные.Свойство("dsl_template_json", ЗначениеПоля) Тогда
		Карточка.DSLTemplateJSON = Строка(ЗначениеПоля);
	КонецЕсли;
	Если Данные.Свойство("dsl_template_mode", ЗначениеПоля) Тогда
		Карточка.DSLTemplateMode = НормализоватьРежимDSLШаблона(Строка(ЗначениеПоля));
	КонецЕсли;

	Возврат Карточка;

КонецФункции

Функция ПротестироватьJSONСкила(ТекстJSON, ТестовыйЗапрос) Экспорт

	Карточка = КарточкаИзJSON(ТекстJSON);
	Скил = СкилИзКарточки(Карточка);
	Score = ОценитьСкил(Скил, НРег(ТестовыйЗапрос));

	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("name", Скил.name);
	Результат.Вставить("title", Скил.title);
	Результат.Вставить("matched", Score > 0);
	Результат.Вставить("score", Score);
	Результат.Вставить("prompt", Скил.prompt);
	Результат.Вставить("has_dsl_template", Скил.Свойство("dsl_template_json") И НЕ ПустаяСтрока(Скил.dsl_template_json) И Скил.dsl_template_json <> "{}");
	Результат.Вставить("dsl_template_mode", ?(Скил.Свойство("dsl_template_mode"), Скил.dsl_template_mode, "hint"));
	Возврат Результат;

КонецФункции

Процедура СохранитьПользовательскийСкил(Карточка) Экспорт

	Если Карточка = Неопределено Тогда
		ВызватьИсключение "Карточка skill не передана.";
	КонецЕсли;
	Если НЕ Карточка.Свойство("Имя") ИЛИ ПустаяСтрока(Карточка.Имя) Тогда
		ВызватьИсключение "Заполните код skill.";
	КонецЕсли;
	Если НЕ Карточка.Свойство("Заголовок") ИЛИ ПустаяСтрока(Карточка.Заголовок) Тогда
		ВызватьИсключение "Заполните название skill.";
	КонецЕсли;
	Если ЭтоСистемныйСкил(Карточка.Имя) Тогда
		ВызватьИсключение "Системный skill нельзя перезаписать из пользовательской формы.";
	КонецЕсли;
	Карточка.Владелец = ИИА_Сервер.ИмяТекущегоПользователя();
	Карточка.ОбластьВидимости = "user";

	Набор = РегистрыСведений.ИИА_Скилы.СоздатьНаборЗаписей();
	Набор.Отбор.Имя.Установить(Карточка.Имя);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Запись = Набор.Добавить();
		Запись.Имя = Карточка.Имя;
		Запись.ДатаСоздания = ТекущаяДата();
	Иначе
		Запись = Набор[0];
	КонецЕсли;

	ЗаполнитьЗаписьСкила(Запись, Карточка);
	Запись.ДатаИзменения = ТекущаяДата();
	Набор.Записать();

КонецПроцедуры

Процедура УдалитьПользовательскийСкил(ИмяСкила) Экспорт

	Если ПустаяСтрока(ИмяСкила) Тогда
		Возврат;
	КонецЕсли;

	Набор = РегистрыСведений.ИИА_Скилы.СоздатьНаборЗаписей();
	Набор.Отбор.Имя.Установить(ИмяСкила);
	Набор.Прочитать();
	Набор.Очистить();
	Набор.Записать();

КонецПроцедуры

Функция СформироватьЧерновикСкилаИзОписания(ОписаниеПроцесса, ТекущаяКарточка = Неопределено) Экспорт

	Карточка = ?(ТекущаяКарточка = Неопределено, НоваяКарточкаСкила(), ТекущаяКарточка);
	Если ЭтоСистемнаяКарточкаСкила(Карточка) Тогда
		Карточка = НоваяКарточкаСкила();
	КонецЕсли;
	Текст = СокрЛП(ОписаниеПроцесса);

	Если ПустаяСтрока(Текст) Тогда
		Возврат Карточка;
	КонецЕсли;

	ЦелевойОбъект = НайтиЦелевойОбъектИзОписания(Текст);
	Если ПустаяСтрока(Карточка.Заголовок) ИЛИ Карточка.Заголовок = "Новый skill" Тогда
		Карточка.Заголовок = СформироватьЗаголовокИзОписания(Текст, ЦелевойОбъект);
	КонецЕсли;

	Если ПустаяСтрока(Карточка.Описание) Тогда
		Карточка.Описание = Текст;
	КонецЕсли;

	Карточка.Триггеры = ИзвлечьТриггерыИзОписания(Текст);
	Карточка.ЦелевойОбъектТип = ЦелевойОбъект.Тип;
	Карточка.ЦелевойОбъектИмя = ЦелевойОбъект.Имя;
	Карточка.Риск = ОпределитьРискСкила(Текст, ЦелевойОбъект);
	Карточка.ТребоватьПодтверждение = Карточка.Риск = "write" И НЕ ОписаниеПроситНеТребоватьПодтверждение(Текст);
	Карточка.Инструкция = СформироватьИнструкциюИзОписания(Текст, Карточка.ТребоватьПодтверждение);
	Карточка.WorkflowJSON = СформироватьWorkflowJSONИзОписания(Текст, ЦелевойОбъект, Карточка.ТребоватьПодтверждение);
	Карточка.TemplateVarsJSON = СформироватьTemplateVarsJSONИзОписания(Текст, ЦелевойОбъект);
	Карточка.DSLTemplateJSON = СформироватьDSLTemplateJSONИзОписания(Текст, ЦелевойОбъект, Карточка.ТребоватьПодтверждение);
	Карточка.DSLTemplateMode = "hint";
	Карточка.Enforcement = "warn";
	Карточка.PolicyJSON = СформироватьPolicyJSON(Карточка.Риск, Карточка.Enforcement, Карточка.ТребоватьПодтверждение);
	Карточка.Владелец = ИИА_Сервер.ИмяТекущегоПользователя();
	Карточка.ОбластьВидимости = "user";
	Карточка.Активен = Истина;

	Возврат Карточка;

КонецФункции

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

Функция РазделитьСписокЗначений(СтрокаСписка)

	Результат = Новый Массив;
	Для Каждого ЗначениеСписка Из СтрРазделить(Строка(СтрокаСписка), ",", Ложь) Цикл
		ЗначениеНорм = СокрЛП(Строка(ЗначениеСписка));
		Если НЕ ПустаяСтрока(ЗначениеНорм) Тогда
			Результат.Добавить(ЗначениеНорм);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СоздатьСкил(Имя, Заголовок, Описание, Триггеры, ТипыДиалогов, Приоритет, Инструкция, УровеньРиска, РазрешенныеДействия, ЗапрещенныеДействия, ОбязательныеПроверки, ТребоватьПодтверждение, МаксСимволовПромпта, Enforcement)

	Скил = Новый Структура;
	Скил.Вставить("name", Имя);
	Скил.Вставить("title", Заголовок);
	Скил.Вставить("version", 1);
	Скил.Вставить("description", Описание);
	Скил.Вставить("triggers", РазделитьСписокЗначений(Триггеры));
	Скил.Вставить("dialog_types", РазделитьСписокЗначений(ТипыДиалогов));
	Скил.Вставить("priority", Приоритет);
	Скил.Вставить("enabled", Истина);
	Скил.Вставить("prompt", Инструкция);
	Скил.Вставить("risk_level", УровеньРиска);
	Скил.Вставить("allowed_actions", СтрРазделить(РазрешенныеДействия, ",", Ложь));
	Скил.Вставить("forbidden_actions", СтрРазделить(ЗапрещенныеДействия, ",", Ложь));
	Скил.Вставить("required_checks", СтрРазделить(ОбязательныеПроверки, ",", Ложь));
	Скил.Вставить("approval_required", ТребоватьПодтверждение);
	Скил.Вставить("max_prompt_chars", МаксСимволовПромпта);
	Скил.Вставить("enforcement", Enforcement);
	Скил.Вставить("owner", "system");
	Скил.Вставить("template_vars_json", "{}");
	Скил.Вставить("dsl_template_json", "{}");
	Скил.Вставить("dsl_template_mode", "hint");
	Возврат Скил;

КонецФункции

Функция СоздатьСкилРаспознаванияДокумента(Имя, Заголовок, Описание, Триггеры, ИмяДокумента, ПредставлениеДокумента, ИдКонфигурации = "")

	Инструкция = "Используй этот skill только в режиме распознавания документов. "
		+ "На входе ожидается изображение или PDF первичного документа. "
		+ "Извлеки из вложения номер, дату, поставщика, покупателя, ИНН/КПП, сумму, НДС и строки товаров/услуг. "
		+ "Перед записью обязательно проверь метаданные Документ." + ИмяДокумента + " и доступные реквизиты. "
		+ "Если поставщик или обязательные поля не распознаны уверенно, сначала все равно выполни GetMetadata/GetObjectFields для целевого документа, затем не записывай документ, а покажи пользователю список недостающих данных через ShowInfo. "
		+ "Если данные достаточны, создай документ " + ИмяДокумента + ", заполни распознанные реквизиты и покажи предварительный результат перед записью. "
		+ "Проведение документа запрещено.";

	Скил = СоздатьСкил(
		Имя,
		Заголовок,
		Описание,
		Триггеры,
		"РаспознаваниеДокументов",
		85,
		Инструкция,
		"write",
		"GetMetadata,GetObjectFields,CheckObjectExists,FindReferenceByName,CreateReference,CreateDocument,SetField,AddTableRow,RunQuery,Write,ShowInfo",
		"PostDocument,DeleteObject",
		"metadata_before_write,approval_before_write",
		Истина,
		1900,
		"warn");

	Скил.Вставить("target_object_type", "Document");
	Скил.Вставить("target_object_name", ИмяДокумента);
	Скил.template_vars_json = СформироватьTemplateVarsJSONРаспознаванияДокумента(ИмяДокумента);
	Скил.template_vars_json = УстановитьСекциюJSON(Скил.template_vars_json, "document_mapping", СформироватьDocumentMappingРаспознаванияДокумента(ИдКонфигурации, ИмяДокумента));
	Скил.dsl_template_json = СформироватьDSLTemplateJSONРаспознаванияДокумента(ИмяДокумента, ПредставлениеДокумента);
	Скил.dsl_template_mode = "validate";
	Скил.Вставить("applicability_json", СформироватьApplicabilityJSONДокумента(ИдКонфигурации, ИмяДокумента));
	Скил.Вставить("reference_policy_json", СформироватьReferencePolicyJSONРаспознаванияДокумента());
	Скил.Вставить("document_mapping_json", СформироватьDocumentMappingJSONРаспознаванияДокумента(ИдКонфигурации, ИмяДокумента));
	Возврат Скил;

КонецФункции

Функция СоздатьПользовательскийСкилИзВыборки(Выборка)

	Скил = СоздатьСкил(
		Выборка.Имя,
		?(ПустаяСтрока(Выборка.Заголовок), Выборка.Имя, Выборка.Заголовок),
		Выборка.Описание,
		Выборка.Триггеры,
		?(ПустаяСтрока(Выборка.ТипыДиалогов), "Агент", Выборка.ТипыДиалогов),
		60,
		Выборка.Инструкция,
		?(ПустаяСтрока(Выборка.Риск), "write", Выборка.Риск),
		ПолучитьAllowedActionsИзPolicy(Выборка.PolicyJSON, Выборка.Риск),
		ПолучитьForbiddenActionsИзPolicy(Выборка.PolicyJSON),
		"approval_before_write",
		Выборка.ТребоватьПодтверждение,
		1600,
		?(ПустаяСтрока(Выборка.Enforcement), "warn", Выборка.Enforcement));

	Скил.owner = ?(ПустаяСтрока(Выборка.Владелец), "user", Выборка.Владелец);
	Скил.enabled = Выборка.Активен;
	Скил.version = ?(Выборка.Версия = 0, 1, Выборка.Версия);
	Скил.Вставить("target_object_type", Выборка.ЦелевойОбъектТип);
	Скил.Вставить("target_object_name", Выборка.ЦелевойОбъектИмя);
	Скил.Вставить("workflow_json", Выборка.WorkflowJSON);
	Скил.Вставить("policy_json", Выборка.PolicyJSON);
	Скил.Вставить("template_vars_json", Выборка.TemplateVarsJSON);
	Скил.Вставить("dsl_template_json", Выборка.DSLTemplateJSON);
	Скил.Вставить("dsl_template_mode", НормализоватьРежимDSLШаблона(Выборка.DSLTemplateMode));
	ОбогатитьСкилСекциямиJSON(Скил);
	Возврат Скил;

КонецФункции

Функция СкилИзКарточки(Карточка)

	Скил = СоздатьСкил(
		Карточка.Имя,
		?(ПустаяСтрока(Карточка.Заголовок), Карточка.Имя, Карточка.Заголовок),
		Карточка.Описание,
		Карточка.Триггеры,
		?(ПустаяСтрока(Карточка.ТипыДиалогов), "Агент", Карточка.ТипыДиалогов),
		60,
		Карточка.Инструкция,
		?(ПустаяСтрока(Карточка.Риск), "write", Карточка.Риск),
		ПолучитьAllowedActionsИзPolicy(Карточка.PolicyJSON, Карточка.Риск),
		ПолучитьForbiddenActionsИзPolicy(Карточка.PolicyJSON),
		"approval_before_write",
		Карточка.ТребоватьПодтверждение,
		1600,
		?(ПустаяСтрока(Карточка.Enforcement), "warn", Карточка.Enforcement));

	Скил.owner = ?(Карточка.Свойство("Владелец") И НЕ ПустаяСтрока(Карточка.Владелец), Карточка.Владелец, "user");
	Скил.enabled = Карточка.Активен;
	Скил.version = ?(Карточка.Свойство("Версия") И Карточка.Версия > 0, Карточка.Версия, 1);
	Скил.Вставить("target_object_type", Карточка.ЦелевойОбъектТип);
	Скил.Вставить("target_object_name", Карточка.ЦелевойОбъектИмя);
	Скил.Вставить("workflow_json", Карточка.WorkflowJSON);
	Скил.Вставить("policy_json", Карточка.PolicyJSON);
	Скил.Вставить("template_vars_json", Карточка.TemplateVarsJSON);
	Скил.Вставить("dsl_template_json", Карточка.DSLTemplateJSON);
	Скил.Вставить("dsl_template_mode", НормализоватьРежимDSLШаблона(Карточка.DSLTemplateMode));
	ОбогатитьСкилСекциямиJSON(Скил);
	Возврат Скил;

КонецФункции

Функция КарточкаИзСкила(Скил)

	Карточка = Новый Структура;
	Карточка.Вставить("Имя", Скил.name);
	Карточка.Вставить("Заголовок", Скил.title);
	Карточка.Вставить("Описание", Скил.description);
	Карточка.Вставить("Владелец", ?(Скил.Свойство("owner"), Скил.owner, "system"));
	Карточка.Вставить("ОбластьВидимости", "user");
	Карточка.Вставить("Активен", Скил.enabled);
	Карточка.Вставить("Версия", Скил.version);
	Карточка.Вставить("Триггеры", СтрСоединить(Скил.triggers, ", "));
	Карточка.Вставить("ТипыДиалогов", СтрСоединить(Скил.dialog_types, ", "));
	Карточка.Вставить("ЦелевойОбъектТип", ?(Скил.Свойство("target_object_type"), Скил.target_object_type, ""));
	Карточка.Вставить("ЦелевойОбъектИмя", ?(Скил.Свойство("target_object_name"), Скил.target_object_name, ""));
	Карточка.Вставить("Инструкция", Скил.prompt);
	Карточка.Вставить("WorkflowJSON", ?(Скил.Свойство("workflow_json"), Скил.workflow_json, "[]"));
	PolicyJSON = ?(Скил.Свойство("policy_json"), Скил.policy_json, СформироватьPolicyJSON(Скил.risk_level, Скил.enforcement, Скил.approval_required));
	Applicability = ПолучитьApplicabilityСкила(Скил);
	Если Applicability <> Неопределено Тогда
		PolicyJSON = УстановитьСекциюJSON(PolicyJSON, "applicability", Applicability);
	КонецЕсли;
	ReferencePolicy = ПолучитьReferencePolicyСкила(Скил);
	Если ReferencePolicy <> Неопределено Тогда
		PolicyJSON = УстановитьСекциюJSON(PolicyJSON, "reference_policy", ReferencePolicy);
	КонецЕсли;
	Карточка.Вставить("PolicyJSON", PolicyJSON);
	TemplateVarsJSON = ?(Скил.Свойство("template_vars_json"), Скил.template_vars_json, "{}");
	DocumentMapping = ПолучитьDocumentMappingСкила(Скил);
	Если DocumentMapping <> Неопределено Тогда
		TemplateVarsJSON = УстановитьСекциюJSON(TemplateVarsJSON, "document_mapping", DocumentMapping);
	КонецЕсли;
	Карточка.Вставить("TemplateVarsJSON", TemplateVarsJSON);
	Карточка.Вставить("DSLTemplateJSON", ?(Скил.Свойство("dsl_template_json"), Скил.dsl_template_json, "{}"));
	Карточка.Вставить("DSLTemplateMode", ?(Скил.Свойство("dsl_template_mode"), НормализоватьРежимDSLШаблона(Скил.dsl_template_mode), "hint"));
	Карточка.Вставить("Enforcement", Скил.enforcement);
	Карточка.Вставить("Риск", Скил.risk_level);
	Карточка.Вставить("ТребоватьПодтверждение", Скил.approval_required);
	Возврат Карточка;

КонецФункции

Процедура ЗаполнитьЗаписьСкила(Запись, Карточка)

	Запись.Заголовок = Карточка.Заголовок;
	Запись.Описание = Карточка.Описание;
	Запись.Владелец = ?(Карточка.Свойство("Владелец") И НЕ ПустаяСтрока(Карточка.Владелец), Карточка.Владелец, ИИА_Сервер.ИмяТекущегоПользователя());
	Запись.ОбластьВидимости = ?(Карточка.Свойство("ОбластьВидимости") И НЕ ПустаяСтрока(Карточка.ОбластьВидимости), Карточка.ОбластьВидимости, "user");
	Запись.Активен = Карточка.Активен;
	Запись.Версия = ?(Карточка.Свойство("Версия") И Карточка.Версия > 0, Карточка.Версия, 1);
	Запись.Триггеры = Карточка.Триггеры;
	Запись.ТипыДиалогов = ?(Карточка.Свойство("ТипыДиалогов") И НЕ ПустаяСтрока(Карточка.ТипыДиалогов), Карточка.ТипыДиалогов, "Агент");
	Запись.ЦелевойОбъектТип = Карточка.ЦелевойОбъектТип;
	Запись.ЦелевойОбъектИмя = Карточка.ЦелевойОбъектИмя;
	Запись.Инструкция = Карточка.Инструкция;
	Запись.WorkflowJSON = Карточка.WorkflowJSON;
	Запись.PolicyJSON = Карточка.PolicyJSON;
	Запись.TemplateVarsJSON = Карточка.TemplateVarsJSON;
	Запись.DSLTemplateJSON = Карточка.DSLTemplateJSON;
	Запись.DSLTemplateMode = НормализоватьРежимDSLШаблона(Карточка.DSLTemplateMode);
	Запись.Enforcement = ?(Карточка.Свойство("Enforcement") И НЕ ПустаяСтрока(Карточка.Enforcement), Карточка.Enforcement, "warn");
	Запись.Риск = ?(Карточка.Свойство("Риск") И НЕ ПустаяСтрока(Карточка.Риск), Карточка.Риск, "write");
	Запись.ТребоватьПодтверждение = Карточка.ТребоватьПодтверждение;

КонецПроцедуры

Функция НормализоватьТипДиалога(ТипДиалога)

	Представление = Строка(ТипДиалога);
	ПредставлениеВРег = ВРег(Представление);
	Если СтрНайти(ПредставлениеВРег, "ЗАПРОС") > 0 Тогда
		Возврат "запрос1с";
	КонецЕсли;
	Если СтрНайти(ПредставлениеВРег, "РАСПОЗНАВ") > 0 Тогда
		Возврат "распознаваниедокументов";
	КонецЕсли;
	Если СтрНайти(ПредставлениеВРег, "АГЕНТ") > 0 Тогда
		Возврат "агент";
	КонецЕсли;
	Возврат НРег(Представление);

КонецФункции

Функция СкилРазрешенДляТипаДиалога(Скил, ИмяТипаДиалога)

	Для Каждого ТипДиалога Из Скил.dialog_types Цикл
		ТипНорм = НРег(СтрЗаменить(СокрЛП(ТипДиалога), " ", ""));
		Если ТипНорм = ИмяТипаДиалога Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПолучитьПрофильТекущейКонфигурации() Экспорт

	Профиль = Новый Структура;
	ИмяКонфигурации = "";
	ВерсияКонфигурации = "";
	Попытка
		ИмяКонфигурации = Строка(Метаданные.Имя);
	Исключение
		ИмяКонфигурации = "";
	КонецПопытки;
	Попытка
		ВерсияКонфигурации = Строка(Метаданные.Версия);
	Исключение
		ВерсияКонфигурации = "";
	КонецПопытки;
	Профиль.Вставить("config_name", ИмяКонфигурации);
	Профиль.Вставить("config_version", ВерсияКонфигурации);
	Профиль.Вставить("config_id", ИИА_ЯдроМетаданных.ОпределитьИдКонфигурации(ИмяКонфигурации));
	Возврат Профиль;

КонецФункции

Функция ПолучитьApplicabilityСкила(Скил) Экспорт
	Возврат ПолучитьСекциюJSONСкила(Скил, "applicability");
КонецФункции

Функция ПолучитьReferencePolicyСкила(Скил) Экспорт
	Возврат ПолучитьСекциюJSONСкила(Скил, "reference_policy");
КонецФункции

Функция ПолучитьDocumentMappingСкила(Скил) Экспорт
	Возврат ПолучитьСекциюJSONСкила(Скил, "document_mapping");
КонецФункции

Функция СкилПрименимКТекущейКонфигурации(Скил) Экспорт

	Applicability = ПолучитьApplicabilityСкила(Скил);
	Если Applicability = Неопределено ИЛИ ТипЗнч(Applicability) <> Тип("Структура") Тогда
		Возврат Истина;
	КонецЕсли;

	Профиль = ПолучитьПрофильТекущейКонфигурации();
	ЗначениеПоля = Неопределено;
	Если Applicability.Свойство("config_ids", ЗначениеПоля) И ЭтоJSONArray(ЗначениеПоля) И ЗначениеПоля.Количество() > 0 Тогда
		Если НЕ МассивСодержитБезУчетаРегистра(ЗначениеПоля, Профиль.config_id) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Applicability.Свойство("config_name_patterns", ЗначениеПоля) И ЭтоJSONArray(ЗначениеПоля) И ЗначениеПоля.Количество() > 0 Тогда
		Если НЕ СтрокаСодержитОдинИзПаттернов(Профиль.config_name, ЗначениеПоля) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Applicability.Свойство("version_min", ЗначениеПоля) И НЕ ПустаяСтрока(Строка(ЗначениеПоля)) Тогда
		Если СравнитьВерсии(Профиль.config_version, Строка(ЗначениеПоля)) < 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Applicability.Свойство("version_max", ЗначениеПоля) И НЕ ПустаяСтрока(Строка(ЗначениеПоля)) Тогда
		Если СравнитьВерсии(Профиль.config_version, Строка(ЗначениеПоля)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Applicability.Свойство("objects_required", ЗначениеПоля) И ЭтоJSONArray(ЗначениеПоля) Тогда
		Если НЕ ВсеОбязательныеОбъектыСуществуют(ЗначениеПоля) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ПолучитьСекциюJSONСкила(Скил, ИмяСекции)

	ЗначениеПоля = Неопределено;
	ИмяПоляJSON = ИмяСекции + "_json";
	Если Скил.Свойство(ИмяПоляJSON, ЗначениеПоля) Тогда
		Секция = JSONВЗначение(Строка(ЗначениеПоля));
		Если Секция <> Неопределено Тогда
			Возврат Секция;
		КонецЕсли;
	КонецЕсли;

	Если ИмяСекции = "applicability" ИЛИ ИмяСекции = "reference_policy" Тогда
		Если Скил.Свойство("policy_json", ЗначениеПоля) Тогда
			Policy = JSONВЗначение(Строка(ЗначениеПоля));
			Если Policy <> Неопределено И ТипЗнч(Policy) = Тип("Структура") И Policy.Свойство(ИмяСекции, ЗначениеПоля) Тогда
				Возврат ЗначениеПоля;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ИмяСекции = "document_mapping" Тогда
		Если Скил.Свойство("template_vars_json", ЗначениеПоля) Тогда
			TemplateVars = JSONВЗначение(Строка(ЗначениеПоля));
			Если TemplateVars <> Неопределено И ТипЗнч(TemplateVars) = Тип("Структура") И TemplateVars.Свойство("document_mapping", ЗначениеПоля) Тогда
				Возврат ЗначениеПоля;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ОбогатитьСкилСекциямиJSON(Скил)

	Applicability = ПолучитьСекциюJSONСкила(Скил, "applicability");
	Если Applicability <> Неопределено Тогда
		Скил.Вставить("applicability_json", ЗначениеВJSON(Applicability));
	КонецЕсли;
	ReferencePolicy = ПолучитьСекциюJSONСкила(Скил, "reference_policy");
	Если ReferencePolicy <> Неопределено Тогда
		Скил.Вставить("reference_policy_json", ЗначениеВJSON(ReferencePolicy));
	КонецЕсли;
	DocumentMapping = ПолучитьСекциюJSONСкила(Скил, "document_mapping");
	Если DocumentMapping <> Неопределено Тогда
		Скил.Вставить("document_mapping_json", ЗначениеВJSON(DocumentMapping));
	КонецЕсли;

КонецПроцедуры

Функция УстановитьСекциюJSON(ТекстJSON, ИмяСекции, ЗначениеСекции)

	Данные = JSONВЗначение(ТекстJSON);
	Если Данные = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Данные = Новый Структура;
	КонецЕсли;
	Данные.Вставить(ИмяСекции, ЗначениеСекции);
	Возврат ЗначениеВJSON(Данные);

КонецФункции

Функция ЭтоJSONArray(Значение)
	Возврат ТипЗнч(Значение) = Тип("Массив");
КонецФункции

Функция МассивСодержитБезУчетаРегистра(МассивЗначений, ИскомоеЗначение)
	Искомое = ВРег(СокрЛП(Строка(ИскомоеЗначение)));
	Для Каждого Значение Из МассивЗначений Цикл
		Если ВРег(СокрЛП(Строка(Значение))) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СтрокаСодержитОдинИзПаттернов(Текст, Паттерны)
	ТекстВРег = ВРег(Строка(Текст));
	Для Каждого Паттерн Из Паттерны Цикл
		Если СтрНайти(ТекстВРег, ВРег(Строка(Паттерн))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ВсеОбязательныеОбъектыСуществуют(Объекты)
	Для Каждого ОписаниеОбъекта Из Объекты Цикл
		Если ТипЗнч(ОписаниеОбъекта) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		ТипОбъекта = "";
		ИмяОбъекта = "";
		ОписаниеОбъекта.Свойство("type", ТипОбъекта);
		ОписаниеОбъекта.Свойство("name", ИмяОбъекта);
		Если ПустаяСтрока(Строка(ИмяОбъекта)) Тогда
			Продолжить;
		КонецЕсли;
		ТипНорм = ВРег(Строка(ТипОбъекта));
		Если (ТипНорм = "DOCUMENT" ИЛИ ТипНорм = "ДОКУМЕНТ") И НЕ ИИА_Метаданные.СуществуетДокумент(Строка(ИмяОбъекта)) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ТипНорм = "CATALOG" ИЛИ ТипНорм = "СПРАВОЧНИК" Тогда
			Если Метаданные.Справочники.Найти(Строка(ИмяОбъекта)) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СравнитьВерсии(Версия1, Версия2)
	Если ПустаяСтрока(Строка(Версия1)) ИЛИ ПустаяСтрока(Строка(Версия2)) Тогда
		Возврат 0;
	КонецЕсли;
	Части1 = СтрРазделить(Строка(Версия1), ".", Ложь);
	Части2 = СтрРазделить(Строка(Версия2), ".", Ложь);
	КоличествоЧастей = Макс(Части1.Количество(), Части2.Количество());
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		Знач1 = ?(Индекс < Части1.Количество(), ЧислоИзСтрокиВерсии(Части1[Индекс]), 0);
		Знач2 = ?(Индекс < Части2.Количество(), ЧислоИзСтрокиВерсии(Части2[Индекс]), 0);
		Если Знач1 < Знач2 Тогда
			Возврат -1;
		ИначеЕсли Знач1 > Знач2 Тогда
			Возврат 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ЧислоИзСтрокиВерсии(Значение)
	СтрокаЗначения = СокрЛП(Строка(Значение));
	Цифры = "";
	Для Индекс = 1 По СтрДлина(СтрокаЗначения) Цикл
		Символ = Сред(СтрокаЗначения, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Цифры);
КонецФункции

Функция ОценитьСкил(Скил, НормТекст)

	Score = 0;
	Для Каждого Триггер Из Скил.triggers Цикл
		НормТриггер = НормализоватьФразуСкила(Триггер);
		Если ПустаяСтрока(НормТриггер) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(НормТекст, НормТриггер) > 0 Тогда
			Score = Score + 10 + Мин(5, СтрДлина(НормТриггер) / 10);
		ИначеЕсли ФразаСкилаВстречаетсяПоСловам(НормТекст, НормТриггер) Тогда
			Score = Score + 7 + Мин(3, СтрДлина(НормТриггер) / 20);
		КонецЕсли;
	КонецЦикла;

	Если Скил.Свойство("target_object_name") Тогда
		Score = Score + ОценитьСовпадениеЦелевогоОбъекта(НормТекст, Скил.target_object_name);
	КонецЕсли;
	Если Скил.Свойство("title") Тогда
		Score = Score + ОценитьСовпадениеЦелевогоОбъекта(НормТекст, Скил.title);
	КонецЕсли;
	Если Score > 0 И Скил.Свойство("owner") И НРег(СокрЛП(Строка(Скил.owner))) <> "system" Тогда
		Score = Score + 3;
	КонецЕсли;

	Если Score > 0 Тогда
		Score = Score + Скил.priority / 100;
	КонецЕсли;
	Возврат Score;

КонецФункции

Функция НормализоватьФразуСкила(Текст)

	Результат = НРег(СокрЛП(Строка(Текст)));
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Результат = СтрЗаменить(Результат, ".", " ");
	Результат = СтрЗаменить(Результат, ",", " ");
	Результат = СтрЗаменить(Результат, ";", " ");
	Результат = СтрЗаменить(Результат, ":", " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

Функция ФразаСкилаВстречаетсяПоСловам(НормТекст, НормФраза)

	Слова = РазделитьСписокЗначений(СтрЗаменить(НормФраза, " ", ","));
	Если Слова.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ПозицияПоиска = 1;
	Для Каждого Слово Из Слова Цикл
		Если СтрДлина(Слово) < 3 Тогда
			Продолжить;
		КонецЕсли;
		ХвостТекста = Сред(НормТекст, ПозицияПоиска);
		ПозицияВХвосте = СтрНайти(ХвостТекста, Слово);
		Позиция = ?(ПозицияВХвосте = 0, 0, ПозицияПоиска + ПозицияВХвосте - 1);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		ПозицияПоиска = Позиция + СтрДлина(Слово);
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ОценитьСовпадениеЦелевогоОбъекта(НормТекст, Представление)

	НормПредставление = НормализоватьФразуСкила(Представление);
	Если ПустаяСтрока(НормПредставление) Тогда
		Возврат 0;
	КонецЕсли;
	Если СтрНайти(НормТекст, НормПредставление) > 0 Тогда
		Возврат 5;
	КонецЕсли;
	Если СтрНайти(НормТекст, СтрЗаменить(НормПредставление, " ", "")) > 0 Тогда
		Возврат 4;
	КонецЕсли;
	Если ФразаСкилаВстречаетсяПоСловам(НормТекст, НормПредставление) Тогда
		Возврат 3;
	КонецЕсли;
	НормПредставлениеМетаданных = НормализоватьФразуСкила(ПредставлениеМетаданныхВФразу(Представление));
	Если НЕ ПустаяСтрока(НормПредставлениеМетаданных)
		И НормПредставлениеМетаданных <> НормПредставление
		И ФразаСкилаВстречаетсяПоСловам(НормТекст, НормПредставлениеМетаданных) Тогда
		Возврат 5;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ПредставлениеМетаданныхВФразу(Представление)

	Текст = СокрЛП(Строка(Представление));
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Индекс > 1 И Символ = ВРег(Символ) И Символ <> НРег(Символ) Тогда
			Результат = Результат + " ";
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВыбратьЛучшиеСкилы(Кандидаты, Максимум)

	Результат = Новый Массив;
	Если Максимум <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Пока Результат.Количество() < Максимум И Кандидаты.Количество() > 0 Цикл
		ЛучшийИндекс = 0;
		ЛучшийScore = Кандидаты[0].Score;
		Для Индекс = 1 По Кандидаты.Количество() - 1 Цикл
			Если Кандидаты[Индекс].Score > ЛучшийScore Тогда
				ЛучшийИндекс = Индекс;
				ЛучшийScore = Кандидаты[Индекс].Score;
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Кандидаты[ЛучшийИндекс].Скил);
		Кандидаты.Удалить(ЛучшийИндекс);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СократитьСтроку(Текст, Максимум)

	Если Максимум <= 0 ИЛИ СтрДлина(Текст) <= Максимум Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Максимум);

КонецФункции

Функция РазобратьDSL(DSLJSON)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ИИА_DSL.НормализоватьJSONТекст(DSLJSON));
		Сценарий = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Возврат Сценарий;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ПроверитьДействиеПоСкилу(Результат, Скил, Действие)

	Если СписокСодержит(Скил.forbidden_actions, Действие) Тогда
		ДобавитьНарушение(Результат, Скил.name, Действие, "forbidden_action");
		Возврат;
	КонецЕсли;

	Если Скил.allowed_actions.Количество() > 0 И НЕ СписокСодержит(Скил.allowed_actions, Действие) Тогда
		ДобавитьНарушение(Результат, Скил.name, Действие, "action_not_allowed");
		Возврат;
	КонецЕсли;

	Если Скил.risk_level = "read" И ЭтоWriteAction(Действие) Тогда
		ДобавитьНарушение(Результат, Скил.name, Действие, "write_action_in_read_skill");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьНарушение(Результат, ИмяСкила, Действие, Причина)

	Нарушение = Новый Структура;
	Нарушение.Вставить("skill", ИмяСкила);
	Нарушение.Вставить("action", Действие);
	Нарушение.Вставить("reason", Причина);
	Результат.Нарушения.Добавить(Нарушение);

КонецПроцедуры

Функция СписокСодержит(Список, Значение)

	ЗначениеНорм = НРег(СокрЛП(Значение));
	Для Каждого Элемент Из Список Цикл
		Если НРег(СокрЛП(Элемент)) = ЗначениеНорм Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоWriteAction(Действие)

	Возврат СписокСодержит(СтрРазделить("CreateReference,CreateDocument,SetField,Write,PostDocument,DeleteObject", ",", Ложь), Действие);

