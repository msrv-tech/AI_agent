Функция ВозобновитьДиалог(СсылкаДиалога, Знач ИндексЧекпоинта = -1, Знач АвтоЗапуск = Истина) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	ИндексЧекпоинта = ЧислоИзЗначения(ИндексЧекпоинта, -1);
	Если ТипЗнч(АвтоЗапуск) <> Тип("Булево") Тогда
		АвтоЗапуск = Истина;
	КонецЕсли;
	Если НЕ ИИА_Оркестратор.ВозобновитьСЧекпоинта(СсылкаДиалога, ИндексЧекпоинта, АвтоЗапуск) Тогда
		ВызватьИсключение "Не удалось возобновить диалог с чекпоинта.";
	КонецЕсли;
	Возврат ПолучитьСостояниеДиалога(СсылкаДиалога);
КонецФункции

Функция ПолучитьОбъектыДиалога(СсылкаДиалога) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзмененныеОбъекты.СсылкаНаОбъект КАК СсылкаНаОбъект
	|ИЗ
	|	Справочник.ИИА_Диалоги.ИзмененныеОбъекты КАК ИзмененныеОбъекты
	|ГДЕ
	|	ИзмененныеОбъекты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаДиалога);
	Выборка = Запрос.Выполнить().Выбрать();
	Объекты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.СсылкаНаОбъект) Тогда
			Продолжить;
		КонецЕсли;
		НавигационнаяСсылка = "";
		Попытка
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Выборка.СсылкаНаОбъект);
		Исключение
			НавигационнаяСсылка = "";
		КонецПопытки;
		Элемент = Новый Структура;
		Элемент.Вставить("presentation", Строка(Выборка.СсылкаНаОбъект));
		Элемент.Вставить("type", Строка(ТипЗнч(Выборка.СсылкаНаОбъект)));
		Элемент.Вставить("nav", НавигационнаяСсылка);
		Объекты.Добавить(Элемент);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("id", Строка(СсылкаДиалога.УникальныйИдентификатор()));
	Результат.Вставить("objects", Объекты);
	Возврат Результат;
КонецФункции

Функция ПолучитьРезультатЗапросаДиалога(СсылкаДиалога, Знач Лимит = 30) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	Лимит = НормализоватьЛимит(Лимит, 30, 50);
	ДанныеЗапроса = ИИА_Сервер.ПолучитьПоследниеДанныеЗапроса(СсылкаДиалога);
	Строки = Новый Массив;
	Всего = 0;
	Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
		Всего = ДанныеЗапроса.Количество();
		Граница = Мин(Всего, Лимит);
		Для Индекс = 0 По Граница - 1 Цикл
			Строки.Добавить(ЗначениеДляJSON(ДанныеЗапроса[Индекс]));
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("id", Строка(СсылкаДиалога.УникальныйИдентификатор()));
	Результат.Вставить("row_count", Всего);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("truncated", Всего > Строки.Количество());
	Возврат Результат;
КонецФункции

Функция ПолучитьСтатусRAG() Экспорт
	ИмяАвторизованногоПользователя();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Статус.ИмяКонфигурации КАК ИмяКонфигурации,
	|	Статус.ДатаСборки КАК ДатаСборки,
	|	Статус.ВерсияКонфигурации КАК ВерсияКонфигурации
	|ИЗ
	|	РегистрСведений.ИИА_СтатусИндексаRAG КАК Статус";
	Выборка = Запрос.Выполнить().Выбрать();
	Индексы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("configuration", Строка(Выборка.ИмяКонфигурации));
		Элемент.Вставить("built_at", Выборка.ДатаСборки);
		Элемент.Вставить("configuration_version", Строка(Выборка.ВерсияКонфигурации));
		Элемент.Вставить("indexed", ЗначениеЗаполнено(Выборка.ДатаСборки));
		Индексы.Добавить(Элемент);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("indexes", Индексы);
	Возврат Результат;
КонецФункции

Функция ПрочитатьЖурналРегистрацииАгента(Знач Минут = 30, Знач Лимит = 50, Знач УровеньСтрокой = "") Экспорт
	ИмяПользователя = ИмяАвторизованногоПользователя();
	Минут = НормализоватьЛимит(Минут, 30, 1440);
	Лимит = НормализоватьЛимит(Лимит, 50, 100);
	ДатаОкончания = ТекущаяДата();
	ДатаНачала = ДатаОкончания - Минут * 60;
	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	Отбор.Вставить("Пользователь", ИмяПользователя);
	УровеньЖурнала = УровеньЖурналаИзСтроки(УровеньСтрокой);
	Если УровеньЖурнала <> Неопределено Тогда
		Отбор.Вставить("Уровень", УровеньЖурнала);
	КонецЕсли;
	ТаблицаЖурнала = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, "Дата,Уровень,Событие,Пользователь,Комментарий,Метаданные", , Лимит);
	События = Новый Массив;
	Для Каждого СтрокаЖурнала Из ТаблицаЖурнала Цикл
		Комментарий = Строка(СтрокаЖурнала.Комментарий);
		Если СтрДлина(Комментарий) > 2000 Тогда
			Комментарий = Лев(Комментарий, 2000);
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("date", СтрокаЖурнала.Дата);
		Элемент.Вставить("level", Строка(СтрокаЖурнала.Уровень));
		Элемент.Вставить("event", Строка(СтрокаЖурнала.Событие));
		Элемент.Вставить("user", Строка(СтрокаЖурнала.Пользователь));
		Элемент.Вставить("metadata", Строка(СтрокаЖурнала.Метаданные));
		Элемент.Вставить("comment", Комментарий);
		События.Добавить(Элемент);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("from", ДатаНачала);
	Результат.Вставить("to", ДатаОкончания);
	Результат.Вставить("events", События);
	Возврат Результат;
КонецФункции

Функция ПолучитьДоступныйДиалог(ИдентификаторИлиСсылка) Экспорт
	СсылкаДиалога = НайтиДиалогПоИдентификатору(ИдентификаторИлиСсылка);
	ИмяПользователя = ИмяАвторизованногоПользователя();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Диалоги.Ссылка КАК Ссылка,
	|	Диалоги.Пользователь КАК Пользователь
	|ИЗ
	|	Справочник.ИИА_Диалоги КАК Диалоги
	|ГДЕ
	|	Диалоги.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаДиалога);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ВызватьИсключение "Диалог не найден.";
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Если Строка(Выборка.Пользователь) <> ИмяПользователя Тогда
		ВызватьИсключение "Нет доступа к диалогу.";
	КонецЕсли;
	Возврат Выборка.Ссылка;
КонецФункции

Функция ПрочитатьТелоJSON(ТекстТела) Экспорт
	Если ПустаяСтрока(СокрЛП(Строка(ТекстТела))) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстТела);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение "Тело запроса должно быть валидным JSON: " + ОписаниеОшибки();
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "Тело запроса должно быть JSON-объектом.";
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция ЗаписатьJSONСтроку(Значение) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

