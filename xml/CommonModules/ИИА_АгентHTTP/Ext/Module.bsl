#Область ПрограммныйИнтерфейс

// Описание закрытого HTTP API агента. Произвольный BSL и произвольные запросы не поддерживаются.
//
Функция ОписаниеСервиса() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("name", "iia-agent");
	Результат.Вставить("version", ВерсияРасширения());
	Результат.Вставить("safe_mode", Истина);
	Результат.Вставить("execute_bsl", Ложь);
	Результат.Вставить("endpoints", ДопустимыеМаршруты());
	Возврат Результат;
КонецФункции

Функция СведенияОТекущемПользователе() Экспорт
	ИмяПользователя = ИмяАвторизованногоПользователя();
	Настройки = ИИА_Сервер.ПолучитьНастройкиПользователя(ИмяПользователя);
	Результат = Новый Структура;
	Результат.Вставить("user", ИмяПользователя);
	Результат.Вставить("version", ВерсияРасширения());
	Результат.Вставить("model", Строка(Настройки.Модель));
	Результат.Вставить("provider_host", ХостИзURL(Строка(Настройки.Provider_BaseUrl)));
	Результат.Вставить("write_enabled", Настройки.ДоступнаЗапись);
	Возврат Результат;
КонецФункции

Функция СписокДиалогов(Знач Лимит = 20) Экспорт
	ИмяПользователя = ИмяАвторизованногоПользователя();
	Лимит = НормализоватьЛимит(Лимит, 20, 50);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
	|	Диалоги.Ссылка КАК Ссылка,
	|	Диалоги.Код КАК Код,
	|	Диалоги.Наименование КАК Наименование,
	|	Диалоги.ТипДиалога КАК ТипДиалога,
	|	Диалоги.ДатаСоздания КАК ДатаСоздания
	|ИЗ
	|	Справочник.ИИА_Диалоги КАК Диалоги
	|ГДЕ
	|	Диалоги.Пользователь = &Пользователь
	|УПОРЯДОЧИТЬ ПО
	|	Диалоги.ДатаСоздания УБЫВ";
	Запрос.УстановитьПараметр("Пользователь", ИмяПользователя);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("code", Строка(Выборка.Код));
		Элемент.Вставить("title", Строка(Выборка.Наименование));
		Элемент.Вставить("type", ИмяТипаДиалога(Выборка.ТипДиалога));
		Элемент.Вставить("created_at", Выборка.ДатаСоздания);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СоздатьДиалог(Знач ТипДиалогаСтрокой = "") Экспорт
	ИмяПользователя = ИмяАвторизованногоПользователя();
	ТипДиалога = ТипДиалогаИзСтроки(ТипДиалогаСтрокой);
	СсылкаДиалога = ИИА_Сервер.СоздатьНовыйДиалог(ИмяПользователя, ТипДиалога);
	Если НЕ ЗначениеЗаполнено(СсылкаДиалога) Тогда
		ВызватьИсключение "Не удалось создать диалог.";
	КонецЕсли;
	Возврат ПолучитьСостояниеДиалога(СсылкаДиалога);
КонецФункции

Функция ПолучитьСостояниеДиалога(СсылкаДиалога, Знач ЛимитСообщений = 50) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	ЛимитСообщений = НормализоватьЛимит(ЛимитСообщений, 50, 100);
	Результат = Новый Структура;
	Результат.Вставить("id", Строка(СсылкаДиалога.УникальныйИдентификатор()));
	Результат.Вставить("code", Строка(СсылкаДиалога.Код));
	Результат.Вставить("title", Строка(СсылкаДиалога.Наименование));
	Результат.Вставить("type", ИмяТипаДиалога(СсылкаДиалога.ТипДиалога));
	Результат.Вставить("created_at", СсылкаДиалога.ДатаСоздания);
	Результат.Вставить("orchestrator_running", ИИА_Сервер.ОркестраторВключенДляДиалога(СсылкаДиалога));
	Результат.Вставить("tokens", ИИА_Сервер.ПолучитьОбщееКоличествоТокенов(СсылкаДиалога));
	Результат.Вставить("why_stopped", ЗначениеДляJSON(ИИА_Сервер.ПочемуОстановилсяОркестратор(СсылкаДиалога)));
	Результат.Вставить("confirmation", СостояниеПодтвержденияДляAPI(СсылкаДиалога));
	Результат.Вставить("messages", ПрочитатьСообщенияДиалога(СсылкаДиалога, ЛимитСообщений));
	Возврат Результат;
КонецФункции

Функция ПолучитьЛогДиалога(СсылкаДиалога, Знач МаксимумСимволов = 200000, Знач Смещение = 0) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	МаксимумСимволов = НормализоватьЛимит(МаксимумСимволов, 200000, 200000);
	Смещение = НормализоватьЛимит(Смещение, 0, 10000000);
	Если Смещение < 0 Тогда
		Смещение = 0;
	КонецЕсли;
	ПолныйТекст = Строка(ИИА_Сервер.ПолучитьЛогДиалога(СсылкаДиалога));
	ПолнаяДлина = СтрДлина(ПолныйТекст);
	Если Смещение > ПолнаяДлина Тогда
		Смещение = ПолнаяДлина;
	КонецЕсли;
	Обрезан = Ложь;
	Если Смещение = 0 Тогда
		ТекстЛога = ПолныйТекст;
		Если СтрДлина(ТекстЛога) > МаксимумСимволов Тогда
			ТекстЛога = Прав(ТекстЛога, МаксимумСимволов);
			Обрезан = Истина;
		КонецЕсли;
	Иначе
		ТекстЛога = Сред(ПолныйТекст, Смещение + 1);
		Если СтрДлина(ТекстЛога) > МаксимумСимволов Тогда
			ТекстЛога = Лев(ТекстЛога, МаксимумСимволов);
			Обрезан = Истина;
		КонецЕсли;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("id", Строка(СсылкаДиалога.УникальныйИдентификатор()));
	Результат.Вставить("log", ТекстЛога);
	Результат.Вставить("offset", Смещение);
	Результат.Вставить("total_length", ПолнаяДлина);
	Результат.Вставить("truncated", Обрезан);
	Возврат Результат;
КонецФункции

Функция ОтправитьИЗапустить(СсылкаДиалога, Текст, Знач ТипДиалогаСтрокой = "") Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	Текст = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение "Текст сообщения пуст.";
	КонецЕсли;
	Если СтрДлина(Текст) > 20000 Тогда
		ВызватьИсключение "Текст сообщения длиннее 20000 символов.";
	КонецЕсли;
	ТипДиалога = СсылкаДиалога.ТипДиалога;
	Если НЕ ПустаяСтрока(СокрЛП(Строка(ТипДиалогаСтрокой))) Тогда
		ТипДиалога = ТипДиалогаИзСтроки(ТипДиалогаСтрокой);
	КонецЕсли;
	ИИА_Оркестратор.ОтправитьИЗапустить(СсылкаДиалога, Текст, ТипДиалога);
	Возврат ПолучитьСостояниеДиалога(СсылкаДиалога);
КонецФункции

Функция ПодтвердитьДействие(СсылкаДиалога, Знач Действие) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	КлючДействия = ВРег(СокрЛП(Строка(Действие)));
	Если КлючДействия = "APPROVE" ИЛИ КлючДействия = "ВЫПОЛНИТЬ" Тогда
		ИИА_ApprovalPolicy.ПодтвердитьОжидающееДействие(СсылкаДиалога);
	ИначеЕсли КлючДействия = "REJECT" ИЛИ КлючДействия = "ОТКЛОНИТЬ" Тогда
		ИИА_ApprovalPolicy.ОтклонитьОжидающееДействие(СсылкаДиалога);
	ИначеЕсли КлючДействия = "APPROVE_WITHOUT_CONFIRMATION" ИЛИ КлючДействия = "ВЫПОЛНЯТЬ_БЕЗ_ПОДТВЕРЖДЕНИЯ" Тогда
		ИИА_ApprovalPolicy.ВключитьРежимБезПодтвержденияИПродолжить(СсылкаДиалога);
	Иначе
		ВызватьИсключение "Неизвестное действие подтверждения: " + Строка(Действие);
	КонецЕсли;
	Возврат ПолучитьСостояниеДиалога(СсылкаДиалога);
КонецФункции

Функция ОстановитьДиалог(СсылкаДиалога) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	ИИА_Оркестратор.Остановить(СсылкаДиалога);
	Возврат ПолучитьСостояниеДиалога(СсылкаДиалога);
КонецФункции

Функция СписокВложенийДиалога(СсылкаДиалога) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	Вложения = ИИА_Вложения.ПолучитьВложенияДиалога(СсылкаДиалога);
	Результат = Новый Массив;
	Если Вложения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Вложение Из Вложения Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", ЗначениеСвойства(Вложение, "id", ""));
		Элемент.Вставить("file_name", ЗначениеСвойства(Вложение, "file_name", ""));
		Элемент.Вставить("kind", ЗначениеСвойства(Вложение, "kind", ""));
		Элемент.Вставить("mime_type", ЗначениеСвойства(Вложение, "mime_type", ""));
		Элемент.Вставить("size_bytes", ЗначениеСвойства(Вложение, "size_bytes", 0));
		Элемент.Вставить("native_transport", ЗначениеСвойства(Вложение, "native_transport", ""));
		Элемент.Вставить("summary", ЗначениеСвойства(Вложение, "summary", ""));
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДобавитьВложениеДиалога(СсылкаДиалога, ИмяФайла, СодержимоеBase64) Экспорт
	СсылкаДиалога = ПолучитьДоступныйДиалог(СсылкаДиалога);
	ИмяФайла = СокрЛП(Строка(ИмяФайла));
	Если ПустаяСтрока(ИмяФайла) Тогда
		ВызватьИсключение "Имя файла не указано.";
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Строка(СодержимоеBase64))) Тогда
		ВызватьИсключение "Содержимое файла не передано.";
	КонецЕсли;
	Попытка
		ДвоичныеДанныеФайла = Base64Значение(СодержимоеBase64);
	Исключение
		ВызватьИсключение "Не удалось декодировать content_base64: " + ОписаниеОшибки();
	КонецПопытки;
	Если ДвоичныеДанныеФайла = Неопределено ИЛИ ТипЗнч(ДвоичныеДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "content_base64 не содержит двоичные данные.";
	КонецЕсли;
	Если ДвоичныеДанныеФайла.Размер() = 0 Тогда
		ВызватьИсключение "Файл пуст.";
	КонецЕсли;
	Если ДвоичныеДанныеФайла.Размер() > 15 * 1024 * 1024 Тогда
		ВызватьИсключение "Размер файла больше 15 МБ.";
	КонецЕсли;
	Вложение = ИИА_Вложения.ДобавитьВложениеИзДвоичныхДанных(СсылкаДиалога, ИмяФайла, ДвоичныеДанныеФайла);
	Результат = Новый Структура;
	Результат.Вставить("id", Строка(СсылкаДиалога.УникальныйИдентификатор()));
	Результат.Вставить("attachment_id", ЗначениеСвойства(Вложение, "id", ""));
	Результат.Вставить("file_name", ЗначениеСвойства(Вложение, "file_name", ИмяФайла));
	Результат.Вставить("kind", ЗначениеСвойства(Вложение, "kind", ""));
	Результат.Вставить("size_bytes", ЗначениеСвойства(Вложение, "size_bytes", ДвоичныеДанныеФайла.Размер()));
	Возврат Результат;
КонецФункции

