Функция НайтиДиалогПоИдентификатору(ИдентификаторИлиСсылка)
	Если ТипЗнч(ИдентификаторИлиСсылка) = Тип("СправочникСсылка.ИИА_Диалоги") Тогда
		Если НЕ ЗначениеЗаполнено(ИдентификаторИлиСсылка) Тогда
			ВызватьИсключение "Диалог не указан.";
		КонецЕсли;
		Возврат ИдентификаторИлиСсылка;
	КонецЕсли;
	ТекстИдентификатора = СокрЛП(Строка(ИдентификаторИлиСсылка));
	Если ПустаяСтрока(ТекстИдентификатора) Тогда
		ВызватьИсключение "Идентификатор диалога не указан.";
	КонецЕсли;
	Попытка
		УникальныйИдентификаторДиалога = Новый УникальныйИдентификатор(ТекстИдентификатора);
	Исключение
		ВызватьИсключение "Некорректный идентификатор диалога.";
	КонецПопытки;
	Возврат Справочники.ИИА_Диалоги.ПолучитьСсылку(УникальныйИдентификаторДиалога);
КонецФункции

Функция ПрочитатьСообщенияДиалога(СсылкаДиалога, ЛимитСообщений)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.НомерСтроки КАК НомерСтроки,
	|	Сообщения.Время КАК Время,
	|	Сообщения.Автор КАК Автор,
	|	Сообщения.ТипСообщения КАК ТипСообщения,
	|	Сообщения.Текст КАК Текст,
	|	Сообщения.Статус КАК Статус,
	|	Сообщения.УИД КАК УИД
	|ИЗ
	|	Справочник.ИИА_Диалоги.Сообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.Ссылка = &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", СсылкаДиалога);
	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();
	ИндексНачала = 0;
	Если ЛимитСообщений > 0 И ТаблицаСообщений.Количество() > ЛимитСообщений Тогда
		ИндексНачала = ТаблицаСообщений.Количество() - ЛимитСообщений;
	КонецЕсли;
	Результат = Новый Массив;
	Для Индекс = ИндексНачала По ТаблицаСообщений.Количество() - 1 Цикл
		СтрокаСообщения = ТаблицаСообщений[Индекс];
		ТекстСообщения = Строка(СтрокаСообщения.Текст);
		Если СтрДлина(ТекстСообщения) > 4000 Тогда
			ТекстСообщения = Лев(ТекстСообщения, 4000);
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("id", Строка(СтрокаСообщения.УИД));
		Элемент.Вставить("time", СтрокаСообщения.Время);
		Элемент.Вставить("author", Строка(СтрокаСообщения.Автор));
		Элемент.Вставить("type", Строка(СтрокаСообщения.ТипСообщения));
		Элемент.Вставить("text", ТекстСообщения);
		Элемент.Вставить("status", Строка(СтрокаСообщения.Статус));
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СостояниеПодтвержденияДляAPI(СсылкаДиалога)
	Состояние = ИИА_Сервер.ПолучитьСостояниеПодтверждения(СсылкаДиалога);
	Результат = Новый Структура;
	Результат.Вставить("status", ЗначениеСвойства(Состояние, "status", ""));
	Результат.Вставить("risk_level", ЗначениеСвойства(Состояние, "risk_level", ""));
	Результат.Вставить("reason", ЗначениеСвойства(Состояние, "reason", ""));
	Результат.Вставить("preview", ЗначениеСвойства(Состояние, "preview", ""));
	Результат.Вставить("pending", ВРег(Строка(Результат.status)) = "PENDING");
	Возврат Результат;
КонецФункции

Функция ТипДиалогаИзСтроки(ТипДиалогаСтрокой)
	Ключ = ВРег(СокрЛП(Строка(ТипДиалогаСтрокой)));
	Если ПустаяСтрока(Ключ) ИЛИ Ключ = "AGENT" ИЛИ Ключ = "АГЕНТ" Тогда
		Возврат Перечисления.ИИА_ТипДиалога.Агент;
	КонецЕсли;
	Если Ключ = "QUERY1C" ИЛИ Ключ = "ЗАПРОС1С" Тогда
		Возврат Перечисления.ИИА_ТипДиалога.Запрос1С;
	КонецЕсли;
	Если Ключ = "DOCUMENT_RECOGNITION" ИЛИ Ключ = "РАСПОЗНАВАНИЕДОКУМЕНТОВ" Тогда
		Возврат Перечисления.ИИА_ТипДиалога.РаспознаваниеДокументов;
	КонецЕсли;
	ВызватьИсключение "Неизвестный тип диалога: " + Строка(ТипДиалогаСтрокой);
КонецФункции

Функция ИмяТипаДиалога(ТипДиалога)
	Если ТипДиалога = Перечисления.ИИА_ТипДиалога.Запрос1С Тогда
		Возврат "query1c";
	КонецЕсли;
	Если ТипДиалога = Перечисления.ИИА_ТипДиалога.РаспознаваниеДокументов Тогда
		Возврат "document_recognition";
	КонецЕсли;
	Возврат "agent";
КонецФункции

Функция УровеньЖурналаИзСтроки(УровеньСтрокой)
	Ключ = ВРег(СокрЛП(Строка(УровеньСтрокой)));
	Если ПустаяСтрока(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Ключ = "ERROR" ИЛИ Ключ = "ОШИБКА" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;
	Если Ключ = "WARNING" ИЛИ Ключ = "ПРЕДУПРЕЖДЕНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;
	Если Ключ = "INFORMATION" ИЛИ Ключ = "ИНФОРМАЦИЯ" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	ВызватьИсключение "Неизвестный уровень журнала: " + Строка(УровеньСтрокой);
КонецФункции

Функция НормализоватьЛимит(Значение, ЗначениеПоУмолчанию, Максимум)
	ЧисловоеЗначение = ЗначениеПоУмолчанию;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		ЧисловоеЗначение = Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(СокрЛП(Значение)) Тогда
		Попытка
			ЧисловоеЗначение = Число(СокрЛП(Значение));
		Исключение
			ВызватьИсключение "Некорректное числовое значение: " + Строка(Значение);
		КонецПопытки;
	КонецЕсли;
	Если ЧисловоеЗначение <= 0 Тогда
		ЧисловоеЗначение = ЗначениеПоУмолчанию;
	КонецЕсли;
	Если ЧисловоеЗначение > Максимум Тогда
		ЧисловоеЗначение = Максимум;
	КонецЕсли;
	Возврат Цел(ЧисловоеЗначение);
КонецФункции

Функция ХостИзURL(URL)
	ТекстURL = СокрЛП(Строка(URL));
	Если ПустаяСтрока(ТекстURL) Тогда
		Возврат "";
	КонецЕсли;
	БезСхемы = ТекстURL;
	ПозицияСхемы = СтрНайти(ТекстURL, "://");
	Если ПозицияСхемы > 0 Тогда
		БезСхемы = Сред(ТекстURL, ПозицияСхемы + 3);
	КонецЕсли;
	ПозицияПути = СтрНайти(БезСхемы, "/");
	Если ПозицияПути > 0 Тогда
		БезСхемы = Лев(БезСхемы, ПозицияПути - 1);
	КонецЕсли;
	Возврат БезСхемы;
КонецФункции

Функция ЧислоИзЗначения(Значение, ЗначениеПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(СокрЛП(Значение)) Тогда
		Попытка
			Возврат Цел(Число(СокрЛП(Значение)));
		Исключение
			ВызватьИсключение "Некорректное числовое значение: " + Строка(Значение);
		КонецПопытки;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция ЗначениеДляJSON(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ЗначениеДляJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ЗначениеДляJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Массив;
		Для Каждого КлючИЗначение Из Значение Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("key", Строка(КлючИЗначение.Ключ));
			Элемент.Вставить("value", ЗначениеДляJSON(КлючИЗначение.Значение));
			Результат.Добавить(Элемент);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

Функция ЗначениеСвойства(Коллекция, ИмяСвойства, ЗначениеПоУмолчанию)
	Если Коллекция = Неопределено ИЛИ ТипЗнч(Коллекция) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Значение = Неопределено;
	Если Коллекция.Свойство(ИмяСвойства, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти
