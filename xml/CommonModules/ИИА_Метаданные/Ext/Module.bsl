Функция ПолучитьРеквизитыРегистраБухгалтерии(ИмяРегистра) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("Имя", "");
	Результат.Вставить("Синоним", "");
	Результат.Вставить("Реквизиты", Новый Массив);
	
	МетаданныеРегистра = Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра);
	
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Найден = Истина;
	Результат.Имя = МетаданныеРегистра.Имя;
	Результат.Синоним = МетаданныеРегистра.Синоним;
	
	ДобавитьСтандартныйРеквизитРегистра(Результат.Реквизиты, "Период", "Период", "Дата");
	ДобавитьСтандартныйРеквизитРегистра(Результат.Реквизиты, "Регистратор", "Регистратор", "Документ");
	
	ЭлементСчет = Новый Структура;
	ЭлементСчет.Вставить("Имя", "Счет");
	ЭлементСчет.Вставить("Синоним", "Счет");
	ЭлементСчет.Вставить("Тип", "ПланСчетов");
	Результат.Реквизиты.Добавить(ЭлементСчет);
	Для ИндексСубконто = 1 По 3 Цикл
		ЭлементСубконто = Новый Структура;
		ЭлементСубконто.Вставить("Имя", "Субконто" + Строка(ИндексСубконто));
		ЭлементСубконто.Вставить("Синоним", "Субконто " + Строка(ИндексСубконто));
		ЭлементСубконто.Вставить("Тип", "Справочник");
		Результат.Реквизиты.Добавить(ЭлементСубконто);
	КонецЦикла;
	
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", Измерение.Имя);
		Элемент.Вставить("Синоним", Измерение.Синоним);
		Элемент.Вставить("Тип", ПолучитьСтроковоеПредставлениеТипа(Измерение.Тип));
		Результат.Реквизиты.Добавить(Элемент);
	КонецЦикла;
	
	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", Ресурс.Имя);
		Элемент.Вставить("Синоним", Ресурс.Синоним);
		Элемент.Вставить("Тип", ПолучитьСтроковоеПредставлениеТипа(Ресурс.Тип));
		Результат.Реквизиты.Добавить(Элемент);
		ЭлементОстаток = Новый Структура;
		ЭлементОстаток.Вставить("Имя", Ресурс.Имя + "Остаток");
		ЭлементОстаток.Вставить("Синоним", Ресурс.Синоним);
		ЭлементОстаток.Вставить("Тип", ПолучитьСтроковоеПредставлениеТипа(Ресурс.Тип));
		Результат.Реквизиты.Добавить(ЭлементОстаток);
		ЭлементОстатокДт = Новый Структура;
		ЭлементОстатокДт.Вставить("Имя", Ресурс.Имя + "ОстатокДт");
		ЭлементОстатокДт.Вставить("Синоним", Ресурс.Синоним);
		ЭлементОстатокДт.Вставить("Тип", ПолучитьСтроковоеПредставлениеТипа(Ресурс.Тип));
		Результат.Реквизиты.Добавить(ЭлементОстатокДт);
		ЭлементОстатокКт = Новый Структура;
		ЭлементОстатокКт.Вставить("Имя", Ресурс.Имя + "ОстатокКт");
		ЭлементОстатокКт.Вставить("Синоним", Ресурс.Синоним);
		ЭлементОстатокКт.Вставить("Тип", ПолучитьСтроковоеПредставлениеТипа(Ресурс.Тип));
		Результат.Реквизиты.Добавить(ЭлементОстатокКт);
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеРегистра.Реквизиты Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", Реквизит.Имя);
		Элемент.Вставить("Синоним", Реквизит.Синоним);
		Элемент.Вставить("Тип", ПолучитьСтроковоеПредставлениеТипа(Реквизит.Тип));
		Результат.Реквизиты.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтандартныйРеквизитРегистра(Реквизиты, Имя, Синоним, ТипРеквизита)
	Если Реквизиты = Неопределено Или ТипЗнч(Реквизиты) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	ИмяРеквизита = СокрЛП(Строка(Имя));
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Существующий Из Реквизиты Цикл
		Если ТипЗнч(Существующий) = Тип("Структура") И Существующий.Свойство("Имя")
			И ВРег(Строка(Существующий.Имя)) = ВРег(ИмяРеквизита) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Элемент = Новый Структура;
	Элемент.Вставить("Имя", ИмяРеквизита);
	Элемент.Вставить("Синоним", ?(ПустаяСтрока(Строка(Синоним)), ИмяРеквизита, Строка(Синоним)));
	Элемент.Вставить("Тип", Строка(ТипРеквизита));
	Реквизиты.Добавить(Элемент);
КонецПроцедуры

