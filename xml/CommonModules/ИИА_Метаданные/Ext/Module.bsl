// Получает строковое представление типа данных
//
// Параметры:
//  Тип - ОписаниеТипов - описание типа
//
// Возвращаемое значение:
//  Строка - строковое представление типа
//
Функция ПолучитьСтроковоеПредставлениеТипа(Тип)
	
	Если Тип.Типы().Количество() = 0 Тогда
		Возврат "Неопределено";
	КонецЕсли;
	
	ПервыйТип = Тип.Типы()[0];
	
	СтрокаТипа = Строка(ПервыйТип);
	
	Если СтрокаТипа = "Строка" Тогда
		Возврат "Строка";
	ИначеЕсли СтрокаТипа = "Число" Тогда
		Возврат "Число";
	ИначеЕсли СтрокаТипа = "Дата" Тогда
		Возврат "Дата";
	ИначеЕсли СтрокаТипа = "Булево" Тогда
		Возврат "Булево";
	ИначеЕсли СтрНачинаетсяС(СтрокаТипа, "СправочникСсылка.") Тогда
		Возврат СтрокаТипа;
	ИначеЕсли СтрНачинаетсяС(СтрокаТипа, "ДокументСсылка.") Тогда
		Возврат СтрокаТипа;
	ИначеЕсли СтрНачинаетсяС(СтрокаТипа, "ПеречислениеСсылка.") Тогда
		Возврат СтрокаТипа;
	Иначе
		Возврат СтрокаТипа;
	КонецЕсли;
	
КонецФункции

Функция СобратьСписокОбъектовМетаданных(КоллекцияМетаданных, Фильтр, ТипМетаданных)

	Результат = Новый Массив;
	ПустойФильтр = ПустаяСтрока(Фильтр);

	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Если НЕ ПустойФильтр И НЕ ОбъектПодходитПодФильтр(ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним, Фильтр) Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", ОбъектМетаданных.Имя);
		Элемент.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
		Элемент.Вставить("Синоним", ОбъектМетаданных.Синоним);
		Результат.Добавить(Элемент);
		Если Результат.Количество() >= 8 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустойФильтр Или Результат.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Похожие = НайтиПохожиеОбъекты(Фильтр, ТипМетаданных);
	Если Похожие.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		ИмяВРег = ВРег(ОбъектМетаданных.Имя);
		СинонимВРег = ВРег(ОбъектМетаданных.Синоним);
		Найдено = Ложь;
		Для Каждого Похожий Из Похожие Цикл
			ПохожийВРег = ВРег(Строка(Похожий));
			Если ПустаяСтрока(ПохожийВРег) Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяВРег = ПохожийВРег
				Или СтрНайти(ИмяВРег, ПохожийВРег) > 0
				Или СтрНайти(СинонимВРег, ПохожийВРег) > 0 Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Имя", ОбъектМетаданных.Имя);
		Элемент.Вставить("ПолноеИмя", ОбъектМетаданных.ПолноеИмя());
		Элемент.Вставить("Синоним", ОбъектМетаданных.Синоним);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОбъектПодходитПодФильтр(Имя, Синоним, Фильтр) Экспорт

	Если ПустаяСтрока(Фильтр) Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяВРег = ВРег(Строка(Имя));
	СинонимВРег = ВРег(Строка(Синоним));
	Если ЭтоСлужебныйОбъектМетаданных(ИмяВРег, СинонимВРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	ФильтрВРег = ВРег(СокрЛП(Строка(Фильтр)));
	Если СтрНайти(ИмяВРег, ФильтрВРег) > 0 Или СтрНайти(СинонимВРег, ФильтрВРег) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Текст = ИмяВРег + " " + СинонимВРег;
	Для Каждого Токен Из ЗначимыеТокеныФильтра(ФильтрВРег) Цикл
		Если СтрНайти(Текст, Токен) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоСлужебныйОбъектМетаданных(ИмяВРег, СинонимВРег)
	Текст = ИмяВРег + " " + СинонимВРег;
	Возврат СтрНайти(Текст, "ПРИСОЕДИНЕНН") > 0
		Или СтрНайти(Текст, "УДАЛИТЬ") > 0
		Или СтрНайти(Текст, "УДАЛИТ") = 1
		Или СтрНайти(ИмяВРег, "УДАЛИТЬ") > 0;
КонецФункции

Функция ТекстЗадачиПроТекущиеОстатки(Текст) Экспорт

	ТекстВРег = ВРег(Строка(Текст));
	Если СтрНайти(ТекстВРег, "НАЧАЛЬН") > 0 И СтрНайти(ТекстВРег, "ОСТАТ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстВРег, "ОСТАТ") > 0
		И (СтрНайти(ТекстВРег, "СКЛАД") > 0
			ИЛИ СтрНайти(ТекстВРег, "ТОВАР") > 0
			ИЛИ СтрНайти(ТекстВРег, "НОМЕНКЛАТУР") > 0
			ИЛИ СтрНайти(ТекстВРег, "НАЛИЧ") > 0);

КонецФункции

Функция ТекстЗадачиПроЗаказыКлиента(Текст) Экспорт

	ТекстВРег = ВРег(Строка(Текст));
	Если СтрНайти(ТекстВРег, "ЗАКАЗ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "ПОСТАВЩИК") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстВРег, "КЛИЕНТ") > 0
		ИЛИ СтрНайти(ТекстВРег, "ПОКУПАТЕЛ") > 0;

КонецФункции

Функция ТекстЗадачиПроПродажи(Текст) Экспорт

	ТекстВРег = ВРег(Строка(Текст));
	Если СтрНайти(ТекстВРег, "СОЗДАЙ") > 0
		Или СтрНайти(ТекстВРег, "СОЗДАТЬ") > 0
		Или СтрНайти(ТекстВРег, "ПРОВЕД") > 0
		Или СтрНайти(ТекстВРег, "ЗАПИШ") > 0
		Или СтрНайти(ТекстВРег, "УДАЛ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекстЗадачиПроТекущиеОстатки(ТекстВРег) Или ТекстЗадачиПроЗаказыКлиента(ТекстВРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстВРег, "ПРОДАЖ") > 0;

КонецФункции

Функция ТекстЗадачиПроСозданиеДокументаПродаж(Текст) Экспорт

	ТекстВРег = ВРег(Строка(Текст));
	Если СтрНайти(ТекстВРег, "СОЗДАЙ") = 0 И СтрНайти(ТекстВРег, "СОЗДАТЬ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстВРег, "РЕАЛИЗАЦ") > 0;

КонецФункции

Функция ТекстЗадачиПроСозданиеПоступленияТоваров(Текст) Экспорт

	ТекстВРег = ВРег(Строка(Текст));
	Если СтрНайти(ТекстВРег, "СОЗДАЙ") = 0 И СтрНайти(ТекстВРег, "СОЗДАТЬ") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(ТекстВРег, "РЕАЛИЗАЦ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(ТекстВРег, "ПРИХОДН") > 0
		Или СтрНайти(ТекстВРег, "ПОСТУПЛЕН") > 0
		Или (СтрНайти(ТекстВРег, "НАКЛАД") > 0 И СтрНайти(ТекстВРег, "ПОСТАВЩИК") > 0);

КонецФункции

Функция НайтиДокументЗаказаКлиента() Экспорт

	Обязательные = Новый Массив;
	Обязательные.Добавить("ЗАКАЗ");
	Желательные = Новый Массив;
	Желательные.Добавить("ПОКУПАТЕЛ");
	Желательные.Добавить("КЛИЕНТ");
	Исключаемые = Новый Массив;
	Исключаемые.Добавить("ПОСТАВЩИК");
	Исключаемые.Добавить("ЭМИССИ");
	Исключаемые.Добавить("МАРКИР");
	Исключаемые.Добавить("ПЕРЕМЕЩ");
	Исключаемые.Добавить("ПРОИЗВОДСТВ");
	Исключаемые.Добавить("УТОЧНЕН");
	Исключаемые.Добавить("ЭЛЕКТРОНН");
	Возврат НайтиДокументПоМаркерамИмени(Обязательные, Желательные, Исключаемые);

КонецФункции

Функция ПолучитьОсновныеСправочникиКонтрагентов() Экспорт

	Результат = Новый Массив;
	Для Каждого МетаданныеСправочника Из Метаданные.Справочники Цикл
		ИмяВРег = ВРег(МетаданныеСправочника.Имя);
		Если ИмяВРег = "КОНТРАГЕНТЫ"
			Или ИмяВРег = "КЛИЕНТЫ"
			Или ИмяВРег = "ПОКУПАТЕЛИ" Тогда
			Элемент = Новый Структура;
			Элемент.Вставить("Имя", МетаданныеСправочника.Имя);
			Элемент.Вставить("ПолноеИмя", МетаданныеСправочника.ПолноеИмя());
			Элемент.Вставить("Синоним", МетаданныеСправочника.Синоним);
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПолучитьМетаданныеДляНамерения(Фильтр) Экспорт

	ФильтрТекст = СтрокаФильтраМетаданных(Фильтр);
	Результат = Новый Структура;
	Если ТекстЗадачиПроТекущиеОстатки(ФильтрТекст) Тогда
		Результат.Вставить("Справочники", Новый Массив);
		Результат.Вставить("Документы", Новый Массив);
		Результат.Вставить("РегистрыСведений", Новый Массив);
		Результат.Вставить("РегистрыНакопления", Новый Массив);
		Результат.Вставить("РегистрыБухгалтерии", Новый Массив);
		Источник = ИИА_DSLПостроитель.НайтиИсточникТоварныхОстатков();
		ДобавитьОбъектМетаданныхВРезультатПоПолномуИмени(Результат, Источник);
		Возврат Результат;
	КонецЕсли;
	Если ТекстЗадачиПроЗаказыКлиента(ФильтрТекст) Тогда
		Результат.Вставить("Справочники", ПолучитьОсновныеСправочникиКонтрагентов());
		Результат.Вставить("Документы", Новый Массив);
		Результат.Вставить("РегистрыСведений", Новый Массив);
		Результат.Вставить("РегистрыНакопления", Новый Массив);
		Результат.Вставить("РегистрыБухгалтерии", Новый Массив);
		ДобавитьОбъектМетаданныхВРезультатПоПолномуИмени(Результат, НайтиДокументЗаказаКлиента());
		Возврат Результат;
	КонецЕсли;
	Если ТекстЗадачиПроПродажи(ФильтрТекст) Тогда
		Результат.Вставить("Справочники", Новый Массив);
		Результат.Вставить("Документы", Новый Массив);
		Результат.Вставить("РегистрыСведений", Новый Массив);
		Результат.Вставить("РегистрыНакопления", Новый Массив);
		Результат.Вставить("РегистрыБухгалтерии", Новый Массив);
		ДобавитьОбъектМетаданныхВРезультатПоПолномуИмени(Результат, ИИА_DSLПостроитель.НайтиИсточникПродаж());
		Возврат Результат;
	КонецЕсли;
	Если ТекстЗадачиПроСозданиеДокументаПродаж(ФильтрТекст) Тогда
		Результат.Вставить("Справочники", Новый Массив);
		Результат.Вставить("Документы", Новый Массив);
		Результат.Вставить("РегистрыСведений", Новый Массив);
		Результат.Вставить("РегистрыНакопления", Новый Массив);
		Результат.Вставить("РегистрыБухгалтерии", Новый Массив);
		ДобавитьОбъектМетаданныхВРезультатПоПолномуИмени(Результат, ИИА_DSLПостроитель.НайтиДокументПродажПоМаркерам());
		Возврат Результат;
	КонецЕсли;
	Если ТекстЗадачиПроСозданиеПоступленияТоваров(ФильтрТекст) Тогда
		Результат.Вставить("Справочники", Новый Массив);
		Результат.Вставить("Документы", Новый Массив);
		Результат.Вставить("РегистрыСведений", Новый Массив);
		Результат.Вставить("РегистрыНакопления", Новый Массив);
		Результат.Вставить("РегистрыБухгалтерии", Новый Массив);
		ДобавитьОбъектМетаданныхВРезультатПоПолномуИмени(Результат, ИИА_DSLПостроитель.НайтиДокументПоступленияТоваров());
		Возврат Результат;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СтрокаФильтраМетаданных(Фильтр) Экспорт

	Если ТипЗнч(Фильтр) = Тип("Строка") Тогда
		Возврат Строка(Фильтр);
	КонецЕсли;
	Если ТипЗнч(Фильтр) = Тип("Структура") Или ТипЗнч(Фильтр) = Тип("ФиксированнаяСтруктура") Тогда
		Части = Новый Массив;
		ДобавитьЧастьФильтраМетаданных(Части, Фильтр, "name");
		ДобавитьЧастьФильтраМетаданных(Части, Фильтр, "search_text");
		ДобавитьЧастьФильтраМетаданных(Части, Фильтр, "name_contains");
		ДобавитьЧастьФильтраМетаданных(Части, Фильтр, "filter");
		ДобавитьМассивФильтраМетаданных(Части, Фильтр, "name_in");
		ДобавитьМассивФильтраМетаданных(Части, Фильтр, "name_contains_any");
		ДобавитьМассивФильтраМетаданных(Части, Фильтр, "names");
		ДобавитьМассивФильтраМетаданных(Части, Фильтр, "name_candidates");
		ДобавитьМассивФильтраМетаданных(Части, Фильтр, "candidates");
		Если Части.Количество() > 0 Тогда
			Возврат СтрСоединить(Части, " ");
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция РазобратьФильтрКлассаМетаданных(Фильтр) Экспорт
	Результат = Новый Структура("Класс,Текст", "", СокрЛП(СтрокаФильтраМетаданных(Фильтр)));
	Текст = Результат.Текст;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	ТекстВРег = ВРег(Текст);
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("РЕГИСТРЫНАКОПЛЕНИЯ");
	Кандидаты.Добавить("РЕГИСТРНАКОПЛЕНИЯ");
	Кандидаты.Добавить("РЕГИСТРЫБУХГАЛТЕРИИ");
	Кандидаты.Добавить("РЕГИСТРБУХГАЛТЕРИИ");
	Кандидаты.Добавить("РЕГИСТРЫСВЕДЕНИЙ");
	Кандидаты.Добавить("РЕГИСТРСВЕДЕНИЙ");
	Кандидаты.Добавить("СПРАВОЧНИКИ");
	Кандидаты.Добавить("СПРАВОЧНИК");
	Кандидаты.Добавить("ДОКУМЕНТЫ");
	Кандидаты.Добавить("ДОКУМЕНТ");
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НЕ СтрНачинаетсяС(ТекстВРег, Кандидат) Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Текст, СтрДлина(Кандидат) + 1);
		Разделитель = ?(ПустаяСтрока(Хвост), "", Лев(Хвост, 1));
		Если НЕ ПустаяСтрока(Хвост) И Разделитель <> ":" И Разделитель <> "," И Разделитель <> " " И Разделитель <> Символы.ПС И Разделитель <> Символы.Таб Тогда
			Продолжить;
		КонецЕсли;
		После = СокрЛП(Хвост);
		Если Кандидат = "РЕГИСТРЫНАКОПЛЕНИЯ" Или Кандидат = "РЕГИСТРНАКОПЛЕНИЯ" Тогда
			Результат.Класс = "РегистрНакопления";
		ИначеЕсли Кандидат = "РЕГИСТРЫБУХГАЛТЕРИИ" Или Кандидат = "РЕГИСТРБУХГАЛТЕРИИ" Тогда
			Результат.Класс = "РегистрБухгалтерии";
		ИначеЕсли Кандидат = "РЕГИСТРЫСВЕДЕНИЙ" Или Кандидат = "РЕГИСТРСВЕДЕНИЙ" Тогда
			Результат.Класс = "РегистрСведений";
		ИначеЕсли Кандидат = "СПРАВОЧНИКИ" Или Кандидат = "СПРАВОЧНИК" Тогда
			Результат.Класс = "Справочник";
		Иначе
			Результат.Класс = "Документ";
		КонецЕсли;
		Если Разделитель = ":" Или Разделитель = "," Тогда
			После = СокрЛП(Сред(После, 2));
		КонецЕсли;
		Результат.Текст = После;
		Возврат Результат;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьЧастьФильтраМетаданных(Части, Фильтр, ИмяСвойства)
	Если Фильтр.Свойство(ИмяСвойства) И НЕ ПустаяСтрока(Строка(Фильтр[ИмяСвойства]))
		И ТипЗнч(Фильтр[ИмяСвойства]) <> Тип("Структура")
		И ТипЗнч(Фильтр[ИмяСвойства]) <> Тип("Массив") Тогда
		Части.Добавить(Строка(Фильтр[ИмяСвойства]));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьМассивФильтраМетаданных(Части, Фильтр, ИмяСвойства)
	Если НЕ Фильтр.Свойство(ИмяСвойства) Или ТипЗнч(Фильтр[ИмяСвойства]) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Фильтр[ИмяСвойства] Цикл
		Текст = СокрЛП(Строка(Элемент));
		Если НЕ ПустаяСтрока(Текст) Тогда
			Части.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьОбъектМетаданныхВРезультатПоПолномуИмени(Результат, ПолноеИмя)

	Если ПустаяСтрока(ПолноеИмя) Или СтрНайти(ПолноеИмя, ".") = 0 Тогда
		Возврат;
	КонецЕсли;
	ТипОбъекта = Лев(ПолноеИмя, СтрНайти(ПолноеИмя, ".") - 1);
	ИмяОбъекта = Сред(ПолноеИмя, СтрНайти(ПолноеИмя, ".") + 1);
	Элемент = Новый Структура("Имя, ПолноеИмя, Синоним", ИмяОбъекта, ПолноеИмя, ИмяОбъекта);
	Если ТипОбъекта = "РегистрНакопления" Тогда
		Результат.РегистрыНакопления.Добавить(Элемент);
	ИначеЕсли ТипОбъекта = "РегистрБухгалтерии" Тогда
		Результат.РегистрыБухгалтерии.Добавить(Элемент);
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		Результат.Документы.Добавить(Элемент);
	КонецЕсли;

КонецПроцедуры

Функция НайтиДокументПоМаркерамИмени(ОбязательныеМаркеры, ЖелательныеМаркеры = Неопределено, ИсключаемыеМаркеры = Неопределено) Экспорт

	ЛучшееИмя = "";
	ЛучшаяОценка = -1;
	Попытка
		Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
			Текст = ВРег(Строка(МетаданныеДокумента.Имя) + " " + Строка(МетаданныеДокумента.Синоним));
			Если МаркерыПрисутствуют(Текст, ИсключаемыеМаркеры) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ МаркерыПрисутствуют(Текст, ОбязательныеМаркеры, Истина) Тогда
				Продолжить;
			КонецЕсли;
			Оценка = 10;
			Если МаркерыПрисутствуют(Текст, ЖелательныеМаркеры) Тогда
				Оценка = Оценка + 40;
			ИначеЕсли ЖелательныеМаркеры <> Неопределено
				И ТипЗнч(ЖелательныеМаркеры) = Тип("Массив")
				И ЖелательныеМаркеры.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			ИмяВРег = ВРег(Строка(МетаданныеДокумента.Имя));
			Если СтрНайти(ИмяВРег, "ЗАКАЗ") = 1 Тогда
				Оценка = Оценка + 20;
			КонецЕсли;
			Если Оценка > ЛучшаяОценка Тогда
				ЛучшаяОценка = Оценка;
				ЛучшееИмя = МетаданныеДокумента.ПолноеИмя();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ЛучшееИмя;

КонецФункции

Функция ЗначимыеТокеныФильтра(Фильтр)

	Результат = Новый Массив;
	Норм = СтрЗаменить(ВРег(Строка(Фильтр)), ",", " ");
	Норм = СтрЗаменить(Норм, ".", " ");
	Норм = СтрЗаменить(Норм, ";", " ");
	Норм = СтрЗаменить(Норм, "'", " ");
	Норм = СтрЗаменить(Норм, """", " ");
	СтопСлова = " ПОКАЖИ ПЕРВЫЕ ПЕРВЫЙ ВЫВЕДИ НАЙДИ ВСЕ ДЛЯ ИЛИ ЭТОТ ЭТА ПРИ ЧТО КАК ЭТОМ ЭТОЙ ТЕКУЩИМ ТЕКУЩИЙ НЕНУЛЕВЫМ НЕНУЛЕВОЙ ПРОШЛУЮ ПРОШЛЫЙ НЕДЕЛЮ НЕДЕЛЯ ОБЩУЮ ОБЩИЙ СУММУ УТОЧНИТЬ МЕТАДАННЫЕ МЕТАДАННЫХ РЕГИСТРА РЕГИСТР ДОКУМЕНТ ДОКУМЕНТА ДОКУМЕНТЫ ПОЛЯ ПОЛЕЙ ОБЪЕКТ ОБЪЕКТА КОНФИГУРАЦИИ ФИЛЬТР ПЕРИОД ПЕРИОДА ЗАДАЧА ЗАПРОС ЗАПРОСА ПОЛУЧИТЬ ВЫБРАННЫЙ ";
	Для Каждого Часть Из СтрРазделить(Норм, " ", Ложь) Цикл
		Токен = СокрЛП(Часть);
		Если СтрДлина(Токен) < 4 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(СтопСлова, " " + Токен + " ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.Найти(Токен) = Неопределено Тогда
			Результат.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МаркерыПрисутствуют(Текст, Маркеры, ВсеОбязательны = Ложь)

	Если Маркеры = Неопределено Тогда
		Возврат НЕ ВсеОбязательны;
	КонецЕсли;
	Если ТипЗнч(Маркеры) <> Тип("Массив") Или Маркеры.Количество() = 0 Тогда
		Возврат НЕ ВсеОбязательны;
	КонецЕсли;
	Найдено = 0;
	Для Каждого Маркер Из Маркеры Цикл
		Если СтрНайти(Текст, ВРег(Строка(Маркер))) > 0 Тогда
			Найдено = Найдено + 1;
			Если НЕ ВсеОбязательны Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли ВсеОбязательны Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ВсеОбязательны И Найдено = Маркеры.Количество();

КонецФункции

#КонецОбласти

