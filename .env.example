# Строка подключения к базе 1С (скрипты сборки и run-com.ps1 / python -m com_1c)
# Скрипты сборки и COM-подключение запускайте от имени администратора.
# Скопируйте в .env и отредактируйте под свою базу.
# Файловая база:
1C_CONNECTION_STRING=File="D:\EDT_base\КонфигурацияТест";
# Серверная база (пример; кавычки как в 1С, в конце точка с запятой):
# 1C_CONNECTION_STRING=Srvr="имя_кластера_или_IP";Ref="имя_ИБ_в_кластере";Usr="ПользовательИБ";Pwd="";

# Пути к платформам 1С (build_extension_83.py, update_1c.py)
PLATFORM_83=C:\Program Files\1cv8\8.3.27.1859\bin\1cv8.exe
PLATFORM_85=C:\Program Files\1cv8\8.5.1.1150\bin\1cv8.exe

# Уведомления в Telegram (test_examples.py)
# Создайте бота через @BotFather, получите chat_id через @userinfobot
TELEGRAM_BOT_TOKEN=__PASTE_TELEGRAM_BOT_TOKEN__
TELEGRAM_CHAT_ID=__PASTE_TELEGRAM_CHAT_ID__
TELEGRAM_DEBUG=0

# Внешний LLM для scoring в test_examples.py (--score-mode llm|hybrid)
# OpenAI-compatible endpoint: облачный https://... или локальный http://...
# Примеры:
# SCORE_LLM_API_URL=https://api.openai.com/v1/chat/completions
# SCORE_LLM_API_URL=http://localhost:1234/v1/chat/completions
# SCORE_LLM_MODEL=qwen3-8b
SCORE_LLM_API_URL=__PASTE_SCORE_LLM_API_URL__
SCORE_LLM_API_KEY=__PASTE_SCORE_LLM_API_KEY__
SCORE_LLM_MODEL=__PASTE_SCORE_LLM_MODEL__
SCORE_LLM_TIMEOUT=30

# Внешний benchmark Tau-Bench (automation/run_tau_bench.py)
# Локальный checkout официального репозитория tau-bench / tau2-bench
TAU_BENCH_REPO=D:\EDTApps\AI_agent\vendor\tau2-bench
TAU_BENCH_AGENT_LLM=__PASTE_AGENT_MODEL__
TAU_BENCH_USER_LLM=__PASTE_USER_MODEL__
TAU_BENCH_NUM_TASKS=10
TAU_BENCH_NUM_TRIALS=1
TAU_BENCH_TASK_SPLIT=base
TAU_BENCH_COST_MODE=full

# Bridge-конфиг для запуска Tau-Bench с 1С-backed custom agent
TAU_BRIDGE_CONFIG_PATH=D:\EDTApps\AI_agent\automation\tau_bridge_config.example.json

# NL judge для Tau-Bench.
# Если ваш OpenAI-compatible endpoint нестабилен на дефолтной модели tau2,
# задайте отдельные переменные judge-а. Обычно удобно использовать те же
# значения, что и для SCORE_LLM_*.
TAU_NL_ASSERTIONS_MODEL=__PASTE_NL_JUDGE_MODEL__
TAU_NL_ASSERTIONS_API_BASE=__PASTE_NL_JUDGE_API_BASE__
TAU_NL_ASSERTIONS_API_KEY=__PASTE_NL_JUDGE_API_KEY__

# Учётные данные отдельной Windows VM для desktop UI-тестов.
# Не используйте значения по умолчанию и не коммитьте заполненный .env.
AI_AGENT_GUEST_PASSWORD=__PASTE_GUEST_VM_PASSWORD__
AI_AGENT_TASK_PASSWORD=__PASTE_GUEST_TASK_PASSWORD__
